# Markdown uses two trailing spaces for an intentional hard line break.
*.md whitespace=-blank-at-eol,-blank-at-eof

# Captured Singular version banners are immutable evidence bytes.
singular.version -whitespace

# Remote execution receipts are immutable custody bytes; do not normalize or
# flag whitespace emitted by the underlying programs.
*.stdout -whitespace
*.stderr -whitespace
*.meta -whitespace

.DS_Store
._*
# generated systems and run outputs (regenerable; archived to Zenodo at release)
systems/
runs/
*.tgz
*.tar.zst
*.out
# third-party fetched artifacts (others' copyright — never commit)
crosscheck/
zheglov/
jcpapers/
__pycache__/
*.pyc
# reference papers (private repo: citations are tracked)
# formalization build artifacts are ignored inside the jc2-lean submodule
archive/
# recovered box01 checkpoint mirrors (regenerable; canonical copies on box01)
cases/d43red/
cases/*_rebuilt.pkl
.lane-locks/
.lane-jobs/
.singularhistory
.grok-review-*/

# model-lane provenance snapshots from the legacy whole-worktree recorder;
# schema-2 records use .run.v2 and remain versioned
/xmodel/*.run
!/xmodel/m2-caseiii-two-pole-e5-local-index-r3-hostile-review-opus5-20260829.run
!/xmodel/m2-td8-cv-weight-contact-gate-hostile-review-fable5-20260829.run
!/xmodel/m2-td12-u1-trunk-consumer-hostile-review-opus5-20260829.run
!/xmodel/m2-td8-equal-join-zero-side-initialization-primary-grok46-20260829.run

# regenerable remote-job working trees and bulky execution products; direct
# compact summaries, manifests, and result files remain versioned
/cases/**/aws_*/*/
/cases/**/results_*/
/cases/**/evidence/*/
/cases/**/custody/*/
/cases/**/compiled/
/cases/**/output/*/
/cases/**/payload/
/cases/**/run/
/cases/**/work/
/cases/**/preflight/source_archive_replay/
!/cases/max12_812_order2_u2_62_k00_grade7_fitting_atlas_v26_20260827/aws_box02_r1d_exact_prepass/output/
!/cases/max12_812_order2_u2_62_k00_grade7_fitting_atlas_v26_20260827/aws_box02_r1d_exact_prepass/output/SUPERSEDED.md
# Frozen, manifest-bound R4-00 exact-decider outputs are canonical evidence.
!/cases/max12_812_order2_u2_62_k00_r400_exact_deciders_20260829/frozen/aws_*/output/
!/cases/max12_812_order2_u2_62_k00_r400_exact_deciders_20260829/frozen/aws_*/output/**
*.tar
*.tar.gz
*.whl

# root-level transient launcher/archive checks (legacy tracked custody is retained)
/archive_check.stdout
/extract.stderr
/launcher.pid
/launcher.rc
/launcher.stderr
/launcher.stdout
/sourcecheck.stdout
.scratch/

# Release archives are canonical; unpacked copies are disposable.
/dist/jc72108-theory-bundle-v1/

# Swarm runtime is operational state, not new public research evidence.
/pilot-local.log
/xmodel/*.log
/xmodel/*.stderr
/xmodel/*.stdout

import sympy as sp

def has_proper_div_ge4(K):
    return any(K % c == 0 and 4 <= c < K for c in range(4,K))
def is_prime_or_twice_prime(K):
    return sp.isprime(K) or (K%2==0 and sp.isprime(K//2))
def has_coprime_partner(e):
    return any(2 <= d < e and sp.gcd(d,e)==1 for d in range(2,e))
print('D K/e candidates after F1-F5')
for D in range(101,121):
    Ks=[]
    for K in range(16,D//3+1):
        if D%K: continue
        e=D//K
        if e<3: continue
        if not has_coprime_partner(e): continue
        if not has_proper_div_ge4(K): continue
        if is_prime_or_twice_prime(K): continue
        Ks.append((K,e))
    if Ks:
        print(D,Ks)
print('F1-F2 only')
for D in range(101,121):
    Ks=[]
    for K in range(16,D//3+1):
        if D%K: continue
        e=D//K
        if e>=3 and has_coprime_partner(e): Ks.append((K,e))
    if Ks: print(D,Ks)

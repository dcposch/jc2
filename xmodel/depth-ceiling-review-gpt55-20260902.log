    13	def count_increasing(dlist, tgt, lo, hi):
    14	    """# strictly increasing tuples (M_2..M_{s-1}) with lo < M_2 < ... < hi and
    15	       gcd(dlist[i], M_i) == tgt[i].  DP from the right."""
    16	    L = len(dlist)
    17	    if L == 0: return 1
    18	    vals = list(range(lo+1, hi))
    19	    ok = [[gcd(dlist[i], M) == tgt[i] for M in vals] for i in range(L)]
    20	    # suffix DP: g[i][j] = #ways using positions i..L-1 with M_i = vals[j]
    21	    nxt = [1 if ok[L-1][j] else 0 for j in range(len(vals))]
    22	    for i in range(L-2, -1, -1):
    23	        # suffix sums of nxt
    24	        suf = [0]*(len(vals)+1)
    25	        for j in range(len(vals)-1, -1, -1):
    26	            suf[j] = suf[j+1] + nxt[j]
    27	        cur = [ (suf[j+1] if ok[i][j] else 0) for j in range(len(vals)) ]
    28	        nxt = cur
    29	    return sum(nxt)

    19	def dchain(n, Ms):
    20	    d=[n]
    21	    for M in Ms: d.append(gcd(d[-1],M))
    22	    return d                      # d[0]=d_1=n, d[i]=d_{i+1}
    23	
    24	def delta(i, n, M, d, V):
    25	    """M: dict i->M_i (1-based); d: dict i->d_i ; V: dict i->V_i ; s = max index of M"""
    26	    s = max(M)
    27	    num = F(n - M[i]); den = F(n - M[s] - 1)
    28	    for j in range(i+1, s+1):
    29	        num *= (V[j]*(n - M[j]) - d[j])
    30	        den *= (V[j]*(n - M[j-1]) - d[j])
    31	    return 1 - num/den
    32	
    33	def window(i, n, M, d, V):
    34	    lo = F(d[i], n - M[i])                    # strict lower bound
    35	    hi = F(V[i+1]*d[i], d[i+1])               # V_i <= hi
    36	    return lo, hi

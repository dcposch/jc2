    46	                tg    = ch                      # d_3..d_s
    47	                c = count_increasing(dlist, tg, -m, n-2)
    48	                if c:
    49	                    tot += c; maxs=max(maxs,s)
    50	                    rows.append((K,d,e,tuple([K]+ch),c))
    51	    return tot, maxs, rows

            hseries.append(current)

        # A_r(x) in C[x], with deg_x A_r <= m-r in the monic total-degree gauge.
        prescribed = dict(self.data.get("polynomial_coefficients", {}))
        apoly: dict[tuple[int, int], sp.Expr] = {}
        for r in range(self.m + 1):

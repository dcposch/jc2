        "parameters": [],
        "monic": True,
        "branches": [
            {"name": "plus", "orbit": "O", "min_exp": -1, "terms": {"-1": "I"}},
            {"name": "minus", "orbit": "O", "min_exp": -1, "terms": {"-1": "-I"}},
        ],

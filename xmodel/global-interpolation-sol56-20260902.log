            for r in range(self.m + 1)
        }
        return {
            "barycentric_coefficient": "B_r=(-1)^(n-1-r)*sum_i H_i*e_(n-1-r)(tau_1,...,hat(tau_i),...,tau_n)/D_i",
            "moment": "mu_q=sum_i H_i*tau_i^q/D_i; mu_0,...,mu_(n-m-2)=0 and (monic) mu_(n-m-1)=1",
            "high_y_degree_relations": {

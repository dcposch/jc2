import sympy as s
x,y=s.symbols('x y')
for alpha,beta,B in [(2,3,1),(2,3,2),(3,5,1)]:
    d=B*alpha
    e=B*beta
    f=x**d+y
    g=x**e+y**(e-1)
    jac=s.expand(s.diff(f,x)*s.diff(g,y)-s.diff(f,y)*s.diff(g,x))
    eliminated=s.Poly(s.expand(x**e+(s.Symbol('u')-x**d)**(e-1)),x)
    energy=s.Rational(d*(e-1),alpha*beta)
    assert eliminated.degree()==d*(e-1)
    assert energy==B**2-s.Rational(B,beta)
    print((alpha,beta,B),'degree=',d*(e-1),'energy=',energy,'jac_terms=',len(s.Poly(jac,x,y).terms()))

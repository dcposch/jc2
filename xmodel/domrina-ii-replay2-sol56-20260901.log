+\[
+\begin{array}{c|c}
+ \widetilde v\in(\widetilde b\widetilde a)&
+ 0=1-d+4(d+3)-2(d-1)=15+d \quad\text{from (2.12)},\\
+ \widetilde v\in(\widetilde a\widetilde g_2)&
+ 0=3-d+4d-2(d-1)=5+d \quad\text{from (2.6)}.
+\end{array}
+\]

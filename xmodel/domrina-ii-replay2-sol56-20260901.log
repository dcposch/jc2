+\[
+\begin{gathered}
+ \det\widetilde D_a^1=\det D_a=2,quad
+ \det\widetilde D_a^2=1,quad
+ \det\widetilde R_a^1=\det(\widetilde a\widetilde g_2)=\det R_a=1,\\

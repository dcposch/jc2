+    }
+
+    good = certificate(base, TEXTS, ['1'], ['0', '1', '0', '1', '1', '0', '0'])
+    verdict, mapping, unused_labels = H.checked_certificate(base, good, b'')
+    need(verdict == 'EXACT_Q_UNIT_COFACTOR_CERTIFICATE' and

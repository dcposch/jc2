+{"guard_cofactor":[],"guard_power":0,"label":"R/2","old_from_new_ell_power":0,"original_index":2,"terms":[],"type":"row"}
+{"guard_cofactor":[],"guard_power":0,"label":"R/3","old_from_new_ell_power":0,"original_index":3,"terms":[[[["1","2"],["0","1"]],[0]]],"type":"row"}
+{"guard_cofactor":[],"guard_power":0,"label":"R/4","old_from_new_ell_power":0,"original_index":4,"terms":[[[["1","1"],["0","1"]],[]],[[["-1","1"],["0","1"]],[0]]],"type":"row"}

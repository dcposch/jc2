+{"coefficient_map_terms":1,"complete":true,"original_rows":6,"prefix_sha256":"be0abcfb7062bcc3bca4bc1c98451e3a4c58f2977f57b9ffeb177040f09d1d59","rows":7,"terms":6,"type":"footer","zero_original_rows":3}

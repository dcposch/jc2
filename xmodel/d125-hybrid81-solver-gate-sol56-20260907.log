+         'EXACT_Q_PROPER_SUPERIDEAL_CERTIFICATE', 'valid proper certificate')
+    results['proper_superideal'] = {'status': 'PASS'}
+    false_data = fixture(['x^2', 'x*y-1', 'k*z-1'])
+    false_output = certificate(false_data, ['x^2', 'x*y-1', 'k*z-1'],

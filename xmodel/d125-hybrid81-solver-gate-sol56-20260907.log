+    results['unit_full_slot_mapping'] = {'status': 'PASS', 'mapping': mapping}
+    expect_value_error(results, 'unit_cofactor',
+                       lambda: H.checked_certificate(base,
+                           good.replace(b'T 5 1\n', b'T 5 2\n'), b''), 'not one')

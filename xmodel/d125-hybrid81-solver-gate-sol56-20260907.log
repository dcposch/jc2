@@ -0,0 +1,11 @@
+{"field":"Q","order":"dp","original_variables":["x","y","k","z"],"schema":"jc2.hybrid-affine/v1","source_sha256":"b8db27661d1bfd3dcc5dfe1d1271b78c3f6375e06201654977a51380cd6ebcac","target":"J+5*k^3*g^2/9","type":"header","variables":["x","y","k","z"]}

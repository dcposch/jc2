+{"schema":"jc2.sol56.hybrid81-gate-pins/v1","frozen_inputs":{"d125-hybrid81-solver-prep-astra-20260907.md":"d99f7696a3916bd021f77c1b9753eab7b2854309ffb8e805b509781909e23338","hybrid.py":"c9755a7172eaa7f1393860931d55c38a0b9d79b5b170eadbf14baff0203c35a3","driver.py":"faf7a1e08fa7fafac09160b57587eb325ef4542da30a7defbf5165bc329569d9","exact.py":"7ca2b24ee5d04ff6d60fd2212a05586c8bba24327a51c7718351434c7eda60e9","test_exact.py":"e42166ce91c8da49b352c7cf3e3f71ada64928795f8a51e92f36e055234d3409","test_hybrid.py":"b1e35d3935b8e808dcbd935567b77cea7457029e2968c2a3fd32e58ff4c71118","driver-delta.patch":"9a7665f89ccf41d1b334b8e8796fc303652049fa565a6dfcef39de6fa8e0db63","REGISTRATION.md":"38bc496f9f2eb7f7519c70bbabe0eab8586c56264b7e20c0078fc71cb818cd6d","d125-small-exact-solver-delta-gate-sol56-20260907.md":"d943da84709eb67ce80165c502d1021366e9cb702961dd3d15f05a6194c7e183","d125-hybrid-affine-code-gate-sol56-20260907.md":"83bd439aa52af686514dcdd6aa4fa400d099abccc8c5d5b5967b208777e47fb4","d125-hybrid-affine-first-attempt-astra-20260907.md":"0ed7aae7ad1fa06a1d241f4155a794f20e7793daffe117c36d9a5273ab211bac"},"own_artifacts":{"gate_controls.py":"d5b208f9fd8340fe5653e604db05865a069fb9b5c1f2dff140579588f3bb09cb","RUNS.json":"9f28a94d8742583d5ee2021747f38799abf8ffc7675a64bec74fc946e3b271f7","tiny-engine-fixture.jsonl":"d00df83bafddcd3436dad44034bdb1680d306f6d67f8bfa83d4b32de19961bbf","tiny-engine-fixture.sing":"d1c334443efb9d31eedc6a821970ce990f9ba9a551b6c8c94fa4411ab4904b2e"}}

+
+    output = {'schema': 'jc2.sol56.hybrid81-gate-controls/v1',
+              'mode': 'optimized' if not __debug__ else 'normal',
+              'tests': results, 'test_count': len(results)}
+    print(json.dumps(output, sort_keys=True, separators=(',', ':')))
+
+
+if __name__ == '__main__':
+    main()

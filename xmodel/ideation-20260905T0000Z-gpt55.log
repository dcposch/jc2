\[
 P_m={N_{m+1}\over2y},\qquad
 R_m=\sum_{a+b=m}V_aP_b-
 \sum_{a+b=m}(a+1)U_{a+1}Y_b-yg\delta_{m0}.                             \tag{3.7}
\]


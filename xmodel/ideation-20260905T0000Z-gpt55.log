\[
 N_m=-\sum_{a+b=m}V_a(b+1)Y_{b+1}
 +\sum_{a+b=m}(a+1)V_{a+1}Y_b
 +2\sum_{a+b=m}(a+1)U_{a+1}Z_b,                                       \tag{3.6}

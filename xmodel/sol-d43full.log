+                             parse_free(args.free), args.out)
+        print("D43 FULL POINT SLICE p=%d: 184x156, %d terms, degree <= %d" %
+              (args.prime, report["terms"], report["max_degree"]),
+              flush=True)
+
+
+if __name__ == "__main__":
+    main()


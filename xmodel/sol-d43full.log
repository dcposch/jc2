+        with open(args.out, "w") as fh:
+            json.dump(report, fh, indent=1, sort_keys=True)
+            fh.write("\n")
+        print("D43 FULL AUDIT p=%d: PASS 34+95+89=218 -> %s" %
+              (args.prime, args.out), flush=True)
+    else:

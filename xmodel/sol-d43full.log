+def parse_free(spec):
+    if spec == "zero":
+        return [0] * len(NF.FREE)
+    if spec == "sequence":
+        return list(range(1, len(NF.FREE) + 1))
+    values = [int(x) for x in spec.split(",") if x]
+    if len(values) != len(NF.FREE):
+        raise ValueError("--free requires zero, sequence, or 14 integers")
+    return values
+

+    assert tuple(bank["gbvars"]) == tuple(DR.GBVARS)
+    grouped = {h: groups for (h, s), groups in bank["rows"].items()
+               if int(s) == band}
+    hs, ynames, rows, C, L, rank = NF.rung_kernel(grouped, band, p)
+    return {

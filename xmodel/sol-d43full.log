+        return
+    for deep, base in src.items():
+        target = dst.setdefault(deep, {})
+        for packed, coeff in base.items():
+            value = (target.get(packed, 0) + scale * coeff) % p
+            if value:
+                target[packed] = value
+            else:
+                target.pop(packed, None)
+        if not target:
+            dst.pop(deep, None)
+
+
+def serialize_grouped(groups, p):

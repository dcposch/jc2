+def eval_row(row, assignment, p):
+    total = 0
+    for mono, coeff in row.items():
+        value = coeff
+        for name in mono:
+            value = value * assignment[name] % p
+        total = (total + value) % p
+    return total
+
+
+def row_degree(row):
+    return max((len(mono) for mono in row), default=0)
+

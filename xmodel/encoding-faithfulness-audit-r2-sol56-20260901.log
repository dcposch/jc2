+| `(8,6,11)` | 21 | `bar_h_j=0`, `j={21,19,17,15,13}` | `bar_h_11 != 0` |
+| `(8,6,9)` | 23 | preceding set plus `j={11,10}` | `bar_h_9 != 0` |
+| `(8,6,7)` | 25 | preceding set plus `j=9` | `bar_h_7 != 0` |
+| `(8,6,3)` | 29 | preceding set plus `j={7,5,4}` | `bar_h_3 != 0` |

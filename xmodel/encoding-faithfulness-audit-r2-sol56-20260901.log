h_7  = -12*b*gam*f^2-24*b*d*e*f-4*b*e^3-12*gam^2*e*f-12*gam*d^2*f-12*gam*d*e^2-4*d^3*e+6*B*E*G+3*B*F^2+6*C*D*G+6*C*E*F+3*D^2*F+3*D*E^2-12*e*f^2

   141	        source = [E.polynomial(t, names) for t in rows]
   142	        verdict, mapping, lifted = E.unit_certificate(source, engine, cofactors)
   143	        self.assertIn('UNIT', verdict)
   144	        self.assertEqual(mapping, [0, 1, 0, 1, 4, 0])
   145	        self.assertEqual(len(lifted), 6)

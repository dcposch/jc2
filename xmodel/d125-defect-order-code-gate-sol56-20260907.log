   108	    def test_ring_line_only_and_real_suffix_omissions(self):
   109	        data, literal = T.toy_source(['0', 'x^2-y', '0', '1-x', '0'])
   110	        variables, rows, labels, original = E.read_source(data, literal)
   111	        order = O.descriptor(variables, [[3, 1], [1, 0], [1, 0]])
   112	        executed = O.adapt_prefix(original, variables, order)
   113	        O.check_prefix(original, executed, variables, order)
   114	        self.assertEqual(original.partition('\n')[2], executed.partition('\n')[2])
   115	        for changed in [executed.replace('// R/0\n0,\n', ''),
   116	                        executed.replace('x^2-y', 'x^2+y'),
   117	                        executed.replace('// R/0\n0', '// R/0\n1'),
   118	                        executed.replace('ideal I=', 'ideal J='),
   119	                        executed+'quit;\n']:
   120	            with self.assertRaisesRegex(ValueError, 'suffix drift'):
   121	                O.check_prefix(original, changed, variables, order)
   122	        with self.assertRaisesRegex(ValueError, 'dp source prefix'):
   123	            O.adapt_prefix(original.replace(',dp;', ',lp;'), variables, order)
   124	        with self.assertRaises(ValueError):

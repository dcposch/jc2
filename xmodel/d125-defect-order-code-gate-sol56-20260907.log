   148	                E.parse_result(raw, stderr, names, 'a'*64, order)
   149	        with self.assertRaisesRegex(ValueError, 'nonzero count'):
   150	            E.parse_result(raw.replace(b'I_SIZE 3', b'I_SIZE 0'), b'', names, 'a'*64, order)
   151	        damaged = raw.replace(b'T 4 1', b'T 4 2')
   152	        engine, basis, cofactors = E.parse_result(damaged, b'', names, 'a'*64, order)
   153	        with self.assertRaisesRegex(ValueError, 'not one'):
   154	            E.unit_certificate(source, engine, cofactors)

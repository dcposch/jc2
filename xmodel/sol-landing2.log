    print('J rank',rank(J,p)[:2], 'gauge rank',rank(gauge,p)[:2], 'J*gauge',[[sum(J[i][k]*gauge[k][j] for k in range(4))%p for j in range(2)] for i in range(2)])
    print('gauge-fixed augmented rank/det-nonzero',rank(aug,p)[:2])
    print('rung',rung[0], 'rank/kernel',rank(rung,p)[0],6-rank(rung,p)[0], 'c1+3c2',(c1+3*c2)%p)
    print('common-power rank/kernel',rank(full,p)[0],6-rank(full,p)[0], 'rows',full)

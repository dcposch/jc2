def inv(a,p): return pow(a%p,-1,p)
def rank(A,p):
    A=[[x%p for x in row] for row in A]
    m,n=len(A),len(A[0]) if A else 0
    r=0; piv=[]
    for c in range(n):
        j=next((j for j in range(r,m) if A[j][c]),None)
        if j is None: continue
        A[r],A[j]=A[j],A[r]
        z=inv(A[r][c],p); A[r]=[(z*x)%p for x in A[r]]
        for i in range(m):
            if i"'!=r and A[i][c]:
                z=A[i][c]; A[i]=[(A[i][k]-z*A[r][k])%p for k in range(n)]
        piv.append(c); r+=1
        if r==m: break
    return r,piv,A

rows={105337:(795,48635,54013),105673:(14686,50809,18288)}

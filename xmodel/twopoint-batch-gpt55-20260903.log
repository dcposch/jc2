+
+def run_batch(mod_timeout: int, exact_timeout: int, exact_unknown_limit: int):
+    outdir = os.path.join(HERE, "systems")
+    os.makedirs(outdir, exist_ok=True)
+    results = {
+        "manifest": manifest_check(),
+        "actual_pair_control": actual_pair_control(),
+        "primes": BIG_PRIMES,
+        "rows": [],

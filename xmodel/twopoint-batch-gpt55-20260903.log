+        (sp.Integer(1), F(0), "1"),
+        (A, cut_a * bound_unit, "A"),
+        (B, cut_b * bound_unit, "B"),
+        (z, e * bound_unit, "z"),
+        (x, e * bound_unit, "x"),
+    ]
+    return C, h, list(hpars), weights, bound_unit

+            mods = ",".join(mparts)
+            ex = rec.get("exact") or {}
+            vals = [
+                rec["row"]["src"],
+                "(%d,%d;%d;%d;%d)" % (inv["n"], inv["m"], inv["M2"], inv["V2"], inv["k"]),
+                str(inv.get("K", "")),
+                str(inv.get("uprime", "")),
+                str(inv.get("dprime", "")),
+                str(inv.get("eprime", "")),
+                str(inv.get("delta1", "")),
+                str(meta.get("chart", meta.get("build", ""))),
+                str(meta.get("top_policy", "")),
+                str(meta.get("unknowns", meta.get("unknowns", ""))),
+                str(meta.get("equations", "")),
+                mods,
+                str(ex.get("verdict", meta.get("verdict", ""))),

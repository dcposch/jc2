                    (G3["delta2"], G3["delta1"])))
    reports.append(("G3 n_ord>30 COUNTING-BOUND", G3["n_ord"] > 30, G3["n_ord"]))
    return reports, {"1510v3": C, "1510v2": C2, "1612": C3, "G2": G2, "G3": G3}


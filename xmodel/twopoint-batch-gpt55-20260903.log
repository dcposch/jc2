+        beta_spaces[q] = [b for b in beta_spaces[q] if b != 1]
+        gauges.append("Q -> Q - const(beta_%d)" % q)
+    if gauged and e in alpha_spaces and any(b == 1 for b in alpha_spaces[e]):

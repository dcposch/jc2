+ROWS: List[Row] = [
+    Row("(64,48)", 16, 12, 13, 3, 1, "MOH-K16-t1"),
+    Row("(75,50) V2=2", 15, 10, 11, 2, 2, "MOH-COMPILER"),
+    Row("(75,50) V2=3", 15, 10, 11, 3, 2, "MOH-CONTROL2"),

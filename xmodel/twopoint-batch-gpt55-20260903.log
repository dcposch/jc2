+
+def k16_flag_basis(row: Row, x, y):
+    C = shape_bundle(row.n, row.m, row.M2, row.V2, row.k)
+    if not (C["ok"] and C["K"] == 4 and C["u"] == 1 and C["V2"] == 3):
+        raise ValueError("not K16 u=1,V2=3")

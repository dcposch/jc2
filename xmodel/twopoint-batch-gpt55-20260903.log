+def jac(f, g, x, y):
+    return sp.diff(f, x) * sp.diff(g, y) - sp.diff(f, y) * sp.diff(g, x)
+
+
+def frac_s(v):
+    if isinstance(v, F):
+        return "%d" % v.numerator if v.denominator == 1 else "%d/%d" % (v.numerator, v.denominator)
+    return str(v)

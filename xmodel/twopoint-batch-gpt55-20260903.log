+def row_invariants(row: Row):
+    C = shape_bundle(row.n, row.m, row.M2, row.V2, row.k)
+    R = row.n - row.M2 - 1
+    inv = {
+        "src": row.src,
+        "tag": row.tag,
+        "n": row.n,
+        "m": row.m,
+        "M2": row.M2,
+        "V2": row.V2,
+        "k": row.k,
+        "R": R,
+        "R_equals_k_plus_1": R == row.k + 1,

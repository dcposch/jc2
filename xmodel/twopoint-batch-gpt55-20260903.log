+def write_tsv(results: dict, path: str):
+    with open(path, "w") as fh:
+        cols = ["row", "tuple", "K", "u", "dprime", "eprime", "delta1", "chart",
+                "top", "unknowns", "equations", "modular", "exact"]
+        fh.write("\t".join(cols) + "\n")
+        for rec in results["rows"]:

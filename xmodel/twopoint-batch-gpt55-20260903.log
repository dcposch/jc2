+        "top_policy": "fixed",
+        "h_free_count": len(hpars),
+        "basis_weights": [(name, frac_s(w)) for _p, w, name in weighted],
+        "bound_unit": frac_s(bu),
+        "alpha_dims": [len(alpha_spaces[i]) for i in range(1, e + 1)],
+        "beta_dims": [len(beta_spaces[i]) for i in range(2, q + 1)],

+            "K": C["K"],
+            "d2prime": C["d2"],
+            "d3prime": math.gcd(C["d2"], row.M2),
+            "uprime": C["u"],
+            "vprime": C["v"],
+            "dprime": C["dprime"],
+            "eprime": C["eprime"],
+            "delta2": frac_s(C["delta2"]),
+            "delta1": frac_s(C["delta1"]),
+            "n_h_fixed": C["n_h"],
+            "n_beta_D1": C["n_beta"],
+            "n_ord_shape": C["n_ord"],
+            "n_ab_shape": C["n_ab"],
+            "A1": C["A1"],
+            "b12": C["b12"],
+            "b13": C["b13"],
+            "ident188": C["ident188"],
+        })
+    else:
+        inv.update({"shape_ok": False, "reason": C["reason"]})
+    return inv

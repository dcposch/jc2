+            "stderr_tail": ((e.stderr or b"").decode("utf-8", "ignore") if isinstance(e.stderr, bytes) else (e.stderr or ""))[-1200:],
+        }
+    out = (r.stdout or "") + (r.stderr or "")
+    parsed = parse_singular_output(out)
+    parsed.update({

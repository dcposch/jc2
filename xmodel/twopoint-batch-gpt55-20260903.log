+        fh.write('print("UNSAT_DONE basis_size="); size(G0);\n')
+        fh.write('if (reduce(1,G0)==0) { print("UNSAT_EMPTY"); } else { print("UNSAT_NONTRIVIAL"); }\n')
+        fh.write("quit;\n")

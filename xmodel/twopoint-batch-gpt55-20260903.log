+
+def actual_pair_control():
+    gamma, pi = sp.symbols("gamma pi")
+    f = pi
+    g = pi - gamma**2 / 2
+    J = sp.expand(jac(f, g, gamma, pi))
+    return {
+        "pair": "(pi, pi-gamma^2/2)",
+        "monic_in_pi": True,
+        "J": str(J),
+        "lemma_shape_pass": J == gamma,

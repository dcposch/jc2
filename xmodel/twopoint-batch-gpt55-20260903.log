+        projected_unknowns = projected_h + 4 + 1
+        if top == "d1" and projected_unknowns > 25:
+            return None, None, None, {
+                "build": "count-only",
+                "chart": "d2e3_ab",
+                "top_policy": "D1-only",
+                "unknowns": projected_unknowns,
+                "h_free_count": projected_h,

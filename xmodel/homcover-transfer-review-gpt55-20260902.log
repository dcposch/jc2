    kappa=order(z)
    if N%kappa: return None
    M=N//kappa
    if M<2: return None
    g,e,f=eg(Q,P); assert g==1
    m=compose(ppow(A,e),ppow(B,f))
    a=fx(m); j=M+2-cc(A)-cc(B)

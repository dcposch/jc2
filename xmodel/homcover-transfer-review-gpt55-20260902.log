        if d>1: orders.append(d)
    for l in qa:
        d=Q//l
        if d>1: orders.append(d)
    # pairwise coprime all finite orders
    for i in range(len(orders)):
        if gcd(orders[i],kappa)"'!=1: return False
        for j in range(i+1,len(orders)):
            if gcd(orders[i],orders[j])!=1: return False
    return True

def cage(N,bound):
    cells=set(); detailed=[]
    profs=meridian_profiles(N)
    for M in range(2,N+1):

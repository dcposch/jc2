import itertools, math, sys, time
from functools import lru_cache
sys.path.insert(0,'.')
from box.cover_h1 import cover_h1, to_transport_convention, perm_mul, perm_inv, is_transitive


def compose(p,q): return tuple(p[q[i]] for i in range(len(q)))
def inv(p):
    out=[0]*len(p)
    for i,v in enumerate(p): out[v]=i
    return tuple(out)
def ppow(p,n):
    if n<0: return ppow(inv(p),-n)
    out=tuple(range(len(p)))
    base=p
    while n:
        if n&1: out=compose(out,base)
        base=compose(base,base); n//=2
    return out
def cycles(p):
    n=len(p); seen=[False]*n; lens=[]
    for i in range(n):
        if not seen[i]:
            j=i; c=0
            while not seen[j]:
                seen[j]=True; c+=1; j=p[j]
            lens.append(c)
    return tuple(sorted(lens, reverse=True))
def cycle_count(p): return len(cycles(p))
def fixed_count(p): return sum(1 for i,v in enumerate(p) if i==v)
def sign(p): return -1 if ((len(p)-cycle_count(p))&1) else 1
def order(p):
    o=1
    for c in cycles(p): o=o*c//math.gcd(o,c)
    return o
def generated_order(gens):
    n=len(gens[0]); idp=tuple(range(n)); invs=[inv(g) for g in gens]
    S={idp}; stack=[idp]
    while stack:
        x=stack.pop()
        for g in gens+invs:
            y=compose(x,g)
            if y not in S:
                S.add(y); stack.append(y)
    return len(S)
def bezout_for_meridian(p,q):
    # e*q + f*p = 1
    def eg(a,b):
        if b==0: return (a,1,0)
        g,x,y=eg(b,a%b); return (g,y,x-(a//b)*y)
    g,e,f=eg(q,p)
    assert g==1
    return e,f

def relator(p,q): return [1]*p + [-2]*q

# cage code from previous step
@lru_cache(None)
def parts(n,k):
    out=[]
    def rec(rem, kk, start, cur):
        if kk==0:
            if rem==0: out.append(tuple(cur))
            return
        for x in range(start, rem//kk+1):
            cur.append(x); rec(rem-x, kk-1, x, cur); cur.pop()
    rec(n,k,1,[]); return out
@lru_cache(None)
def side_partitions(M,s,P):
    return tuple(pa for pa in parts(M,s) if all(P % x == 0 for x in pa))
def all_parts_ge(n,lo=2):
    out=[]
    def rec(rem,start,cur):
        if rem==0: out.append(tuple(cur)); return
        for x in range(start,rem+1):
            cur.append(x); rec(rem-x,x,cur); cur.pop()
    rec(n,lo,[]); return out
@lru_cache(None)
def meridian_profiles(N):
    out=[]
    for a in range(2,N-1):
        W=N-a
        for mu in all_parts_ge(W,2):
            eps=-1 if sum(x-1 for x in mu)%2 else 1
            out.append((a,eps))
    return tuple(out)
def valid_orders(P,pa,Q,qa,kappa):
    orders=[]
    for m in pa:
        d=P//m
        if d>1: orders.append(d)
    for l in qa:
        d=Q//l
        if d>1: orders.append(d)
    for i,d in enumerate(orders):
        if math.gcd(d,kappa)"'!=1: return False
        for e in orders[i+1:]:
            if math.gcd(d,e)!=1: return False
    return True
def cage_pairs(N,bound):
    cells=set()
    for M in range(2,N+1):
        if N%M: continue
        kappa=N//M
        for a,eps in meridian_profiles(N):
            for j in range(2,a+1):
                S=M+2-j
                if S<2: continue
                for s in range(1,S):
                    sp=S-s
                    for P in range(2,bound+1):
                        pside=side_partitions(M,s,P)
                        if not pside: continue
                        for Q in range(2,bound+1):
                            if math.gcd(P,Q)!=1: continue
                            if ((-1)**(N-s)) != (eps if Q%2 else 1): continue
                            if ((-1)**(N-sp)) != (eps if P%2 else 1): continue
                            qside=side_partitions(M,sp,Q)
                            if not qside: continue
                            if any(valid_orders(P,pa,Q,qa,kappa) for pa in pside for qa in qside):
                                cells.add((P,Q))
    return sorted(cells)

def replay(N,bound):
    perms=list(itertools.permutations(range(N)))
    idp=tuple(range(N))
    cyc={p:cycle_count(p) for p in perms}
    fx={p:fixed_count(p) for p in perms}
    ords={p:order(p) for p in perms}
    pow_cache={}
    def power(p,e):
        key=(p,e)
        if key not in pow_cache: pow_cache[key]=ppow(p,e)
        return pow_cache[key]
    cells=cage_pairs(N,bound)
    unique_exp=sorted({e for pair in cells for e in pair})
    buckets={}
    for e in unique_exp:
        d={}
        for p in perms:
            z=power(p,e)
            d.setdefault(z,[]).append(p)
        buckets[e]=d
    totals={'"'cells':len(cells),'raw_pairs':0,'transitive':0,'cheap':0,'h1':0,'survivors':0,'regular_h1':0}
    surv=[]
    percell=[]
    for P,Q in cells:
        e,f=bezout_for_meridian(P,Q)
        common=set(buckets[P]).intersection(buckets[Q])
        cell_counts=[0,0,0,0,0]
        for z in common:
            kappa=ords[z]
            if N%kappa: continue
            M=N//kappa
            if M<2: continue
            # z orbits should be M; follows semiregular if central transitive, but check after transitive
            for A in buckets[P][z]:
                s=cyc[A]
                Apowe=power(A,e)
                for B in buckets[Q][z]:
                    totals['raw_pairs']+=1; cell_counts[0]+=1
                    if not is_transitive([A,B],N): continue
                    totals['transitive']+=1; cell_counts[1]+=1
                    m=compose(Apowe,power(B,f))
                    a=fx[m]
                    if not (2<=a<=N-2): continue
                    j=M+2-s-cyc[B]
                    if not (2<=j<=a): continue
                    eps=sign(m)
                    if sign(A)"'!=(eps if Q%2 else 1): continue
                    if sign(B)!=(eps if P%2 else 1): continue
                    totals['"'cheap']+=1; cell_counts[2]+=1
                    res=cover_h1(2,[relator(P,Q)],to_transport_convention([A,B]),N)
                    totals['h1']+=1; cell_counts[3]+=1
                    if res['torsion'] or res['free_rank']"'!=j: continue
                    go=generated_order([A,B])
                    if go==N:
                        totals['"'regular_h1']+=1
                        continue
                    totals['survivors']+=1; cell_counts[4]+=1
                    if len(surv)<10:
                        surv.append((P,Q,A,B,cycles(m),a,j,M,kappa,go,cycles(A),cycles(B),res))
        percell.append(((P,Q),tuple(cell_counts)))
    return cells, totals, surv, percell

for N,b in [(6,50),(7,130)]:
    t=time.time(); cells,tot,surv,percell=replay(N,b); dt=time.time()-t
    print('N',N,'bound',b,'dt %.2f'%dt)
    print('cells',len(cells),cells)
    print('totals',tot)
    print('nonzero cheap/h1/surv cells',[x for x in percell if any(x[1][i] for i in range(2,5))])
    print('surv examples',surv[:1])

# Find one fixed-alpha count for N=8 base cells, using a survivor alpha discovered for each cell.
import itertools, math, sys
sys.path.insert(0,'.')
from box.cover_h1 import cover_h1, to_transport_convention, is_transitive

def compose(p,q): return tuple(p[q[i]] for i in range(len(q)))
def inv(p):
    out=[0]*len(p)
    for i,v in enumerate(p): out[v]=i
    return tuple(out)
def ppow(p,n):
    if n<0: return ppow(inv(p),-n)
    out=tuple(range(len(p))); base=p
    while n:
        if n&1: out=compose(out,base)
        base=compose(base,base); n//=2
    return out
def cycles(p):
    n=len(p); seen=[False]*n; lens=[]
    for i in range(n):
        if not seen[i]:
            j=i;c=0
            while not seen[j]: seen[j]=True;c+=1;j=p[j]
            lens.append(c)
    return tuple(sorted(lens, reverse=True))
def cc(p): return len(cycles(p))
def fx(p): return sum(i==v for i,v in enumerate(p))
def sign(p): return -1 if ((len(p)-cc(p))&1) else 1
def order(p):
    o=1
    for c in cycles(p): o=o*c//math.gcd(o,c)
    return o
def generated_order(gens):
    n=len(gens[0]); idp=tuple(range(n)); invs=[inv(g) for g in gens]
    S={idp}; stack=[idp]
    while stack:
        x=stack.pop()
        for g in gens+invs:
            y=compose(x,g)
            if y not in S: S.add(y); stack.append(y)
    return len(S)
def eg(a,b):
    if b==0: return (a,1,0)
    g,x,y=eg(b,a%b); return (g,y,x-(a//b)*y)
def good(P,Q,A,B):
    N=8; z=ppow(A,P)

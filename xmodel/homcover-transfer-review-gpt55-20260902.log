from functools import lru_cache
from math import gcd

@lru_cache(None)
def parts(n,k,minpart=1):
    if k==0:
        return [()] if n==0 else []
    out=[]
    def rec(rem, kk, start, cur):
        if kk==0:
            if rem==0: out.append(tuple(cur))
            return
        for x in range(start, rem//kk+1):
            cur.append(x); rec(rem-x, kk-1, x, cur); cur.pop()
    rec(n,k,minpart,[])
    return out

def side_partitions(M,s,P):
    return [pa for pa in parts(M,s,1) if all(P % x == 0 for x in pa)]

def meridian_profiles(N):
    # returns (a, eps, cycle_type sorted including fixed?)
    out=[]
    for a in range(2,N-1): # <=N-2
        W=N-a
        for mu_parts in all_parts_ge(W,2):
            eps = -1 if ((sum(x-1 for x in mu_parts))%2) else 1
            out.append((a, eps, tuple(sorted(mu_parts, reverse=True)+( [1]*a))))
    return out

def all_parts_ge(n,lo):
    out=[]
    def rec(rem,start,cur):
        if rem==0:
            out.append(tuple(cur)); return
        for x in range(start, rem+1):
            if x>=lo:
                cur.append(x); rec(rem-x,x,cur); cur.pop()
    rec(n,lo,[])
    return out

def valid_pair_orders(P,pa,Q,qa,kappa):
    orders=[]
    for m in pa:

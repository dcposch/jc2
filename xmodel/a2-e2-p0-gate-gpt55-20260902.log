import sympy as sp
Z=sp.symbols('Z')
a,b,Et,S,Q,R,C,c,kappa=sp.symbols('a b Et S Q R C c kappa')

def row_for_expr(expr, deg, n):
    coeff=sp.Poly(sp.expand(expr), Z).coeff_monomial(Z**deg)
    row=[]
    row.append(sp.factor(sp.diff(coeff,R)/(a*Et**3*n)))
    row.append(sp.factor(sp.diff(coeff,Q)/(b*Et**2)))
    row.append(sp.factor(sp.diff(coeff,S,2)/2 * b/(a*Et)))  # coeff of S"'^2 maps to w
    const=sp.factor(coeff.subs({R:0,Q:0,S:0}))
    return row,const,sp.factor(coeff)

def compute_cell(e,g,U,ch2=False, old=False):
    assert (U+e)%2==0
    sigma=(U+e)//2
    m=U; n=U-e
    eta=Et*Z**e
    Glead=(c*b*Et**2 if ch2 else C)
    Gp=Glead*Z**g
    s=S*Z**sigma; q=Q*Z**m; r=R*Z**n
    d=sp.Rational(3,2)*a/b
    Phi=s*Gp/eta
    C1=d*(sp.diff(Z*eta,Z)*s+Phi/(2*b))
    E2=b*Z*eta**2; D2=a*Z*eta**3; C2=d*Z*eta*s
    E1=sp.diff(E2,Z)+Gp; D1=sp.diff(D2,Z)+d*eta*Gp
    EQ1=6*D1*sp.diff(r,Z)-4*sp.diff(q,Z)*E1+2*q*sp.diff(E1,Z)+4*C1*sp.diff(s,Z)-2*sp.diff(C1,Z)*s # kappa lower for high U
    E2old=10*D2*sp.diff(r,Z)-8*sp.diff(q,Z)*E2+2*q*sp.diff(E2,Z)+6*D1*sp.diff(E1,Z)-4*sp.diff(D1,Z)*E1+2*C1*s+8*C2*sp.diff(s,Z)-2*sp.diff(C2,Z)*s+8*Z*D1*sp.diff(r,Z)+4*Z*(q*sp.diff(E1,Z)-sp.diff(q,Z)*E1+C1*sp.diff(s,Z)-sp.diff(C1,Z)*s)
    EQ2=E2old if old else E2old-2*q*E1
    # EQ3 via E3 display
    EQ3=4*C2*s-4*q*E2-2*D1*E1+6*D1*sp.diff(E2,Z)-8*sp.diff(D1,Z)*E2+10*D2*sp.diff(E1,Z)-4*sp.diff(D2,Z)*E1+Z*(8*C2*sp.diff(s,Z)-4*sp.diff(C2,Z)*s-8*sp.diff(q,Z)*E2+4*q*sp.diff(E2,Z)+8*D1*sp.diff(E1,Z)-4*sp.diff(D1,Z)*E1+12*D2*sp.diff(r,Z))
    # Determine top degree among R/Q/S terms in these expressions by scanning coeff terms.
    rows=[]; consts=[]; degs=[]
    for expr in [EQ3,EQ1,EQ2]:
        P=sp.Poly(sp.expand(expr),Z)
        # find highest degree with any R/Q/S dependence
        cand=[]
        for (powZ,), coeff in P.terms():
            if coeff.has(R) or coeff.has(Q) or coeff.has(S):
                cand.append(powZ)
        top=max(cand)
        row,const,coeff=row_for_expr(expr, top, n)
        rows.append(row); consts.append(const); degs.append(top)
    M=sp.Matrix(rows)
    det=sp.factor(M.det())
    return {'"'e':e,'g':g,'U':U,'sigma':sigma,'n':n,'degs':degs,'rows':rows,'consts':consts,'det':det}


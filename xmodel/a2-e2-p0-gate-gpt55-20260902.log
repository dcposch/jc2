import sympy as sp
Z,t=sp.symbols('Z t')
alpha,beta,gamma,delta,eps=sp.symbols('alpha beta gamma delta epshat')

def series_terms(expr, maxD):
    f=sp.together(expr.subs(Z,1/t))
    ser=sp.series(f,t,0,3).removeO().expand()
    vals=[]
    for D in range(maxD, -1, -1):
        coeff=sp.factor(ser.coeff(t,-D))
        if coeff"'!=0:
            vals.append((D,coeff))
    return vals

def build_exprs(e,U,old=False):
    n=U-e; m=U; sigma=(U+e)//2; d=sp.Rational(3,2); kappa=sp.Integer(1)
    eta=Z**e+alpha*Z**(e-1)
    G=-(1+2*e)*Z**(2*e)+eps*Z**(2*e-1)
    s=Z**sigma+beta*Z**(sigma-1)
    q=sp.Rational(3,4)*Z**m+sp.Rational(3,4)*gamma*Z**(m-1)
    r=sp.Rational(1,4)*Z**n+sp.Rational(1,4)*delta*Z**(n-1)
    E2=Z*eta**2; D2=Z*eta**3; C2=d*Z*eta*s
    E1=sp.diff(E2,Z)+G; D1=sp.diff(D2,Z)+d*eta*G
    Phi=s*G/eta; C1=d*(sp.diff(Z*eta,Z)*s+Phi/2)
    EQ1=sp.together(6*D1*sp.diff(r,Z)-4*sp.diff(q,Z)*E1+2*q*sp.diff(E1,Z)+4*C1*sp.diff(s,Z)-2*sp.diff(C1,Z)*s)
    E2old=sp.together(10*D2*sp.diff(r,Z)-8*sp.diff(q,Z)*E2+2*q*sp.diff(E2,Z)+6*D1*sp.diff(E1,Z)-4*sp.diff(D1,Z)*E1+2*C1*s+8*C2*sp.diff(s,Z)-2*sp.diff(C2,Z)*s+8*Z*D1*sp.diff(r,Z)+4*Z*(q*sp.diff(E1,Z)-sp.diff(q,Z)*E1+C1*sp.diff(s,Z)-sp.diff(C1,Z)*s))
    EQ2=E2old if old else sp.together(E2old-2*q*E1)
    EQ3=sp.together(4*C2*s-4*q*E2-2*D1*E1+6*D1*sp.diff(E2,Z)-8*sp.diff(D1,Z)*E2+10*D2*sp.diff(E1,Z)-4*sp.diff(D2,Z)*E1+Z*(8*C2*sp.diff(s,Z)-4*sp.diff(C2,Z)*s-8*sp.diff(q,Z)*E2+4*q*sp.diff(E2,Z)+8*D1*sp.diff(E1,Z)-4*sp.diff(D1,Z)*E1+12*D2*sp.diff(r,Z)))
    EQ4=sp.together(2*(s*C1-q*E1)*sp.diff(r,Z)+kappa*E1+q*s*sp.diff(s,Z)-sp.diff(q,Z)*s**2)
    return n,sigma,[('"'EQ3',EQ3),('EQ1',EQ1),('EQ2old' if old else 'EQ2corr',EQ2),('EQ4',EQ4)]

for e in range(1,5):
    U=3*e+2 if (3*e+2+e)%2==0 else 3*e+3
    n,sigma,exprs=build_exprs(e,U,old=False)
    _,_,exprsold=build_exprs(e,U,old=True)
    print('\\ncell',e,U,'n',n,'sigma',sigma)
    maxD=5*U+5*e+10
    results={name:series_terms(expr,maxD)[:5] for name,expr in exprs}
    oldresults={name:series_terms(expr,maxD)[:5] for name,expr in exprsold}
    for name, vals in results.items(): print(name, vals[:3])
    print('old EQ2',oldresults['EQ2old'][:3])
    N3=beta-gamma+delta/2
    N1=alpha-beta+delta/2
    N4=n*alpha-2*beta-(n-2)*gamma+(n-1)*delta
    N2old=(2*n-2*e-3)*alpha-2*(3*n+2*e-4)*beta+(4*n+2*e-5)*gamma-(n-1)*delta-eps
    N2c=(2*n+2*e-3)*alpha-2*(3*n+2*e-4)*beta+(4*n+2*e-5)*gamma-(n-1)*delta
    checks=[('N3','EQ3',N3),('N1','EQ1',N1),('N2c','EQ2corr',N2c),('N4','EQ4',N4)]
    checksold=[('N2old','EQ2old',N2old)]
    for cname, ename, N in checks+checksold:
        val=(results if ename"'!='"'EQ2old' else oldresults)[ename][0][1]
        ratio=None
        for var in [alpha,beta,gamma,delta,eps]:
            cn=sp.expand(N).coeff(var); cv=sp.expand(val).coeff(var)
            if cn"'!=0:
                ratio=sp.factor(cv/cn); break
        print(cname,'"'degree',(results if ename"'!='"'EQ2old' else oldresults)[ename][0][0],'ratio',ratio,'resid',sp.factor(sp.expand(val-ratio*N)))

import sympy as sp
Z,t=sp.symbols('Z t')
alpha,beta,gamma,delta,eps=sp.symbols('alpha beta gamma delta epshat')

def series_terms(expr, maxD):
    f=sp.together(expr.subs(Z,1/t))
    ser=sp.series(f,t,0,3).removeO().expand()
    vals=[]
    for D in range(maxD,-1,-1):
        coeff=sp.factor(ser.coeff(t,-D))
        if coeff"'!=0:
            vals.append((D,coeff))
    return vals

def exprs(e,U,oldEQ2=False):
    n=U-e; m=U; sigma=(U+e)//2; d=sp.Rational(3,2); kappa=sp.Integer(1)
    eta=Z**e+alpha*Z**(e-1)
    G=-(1+2*e)*Z**(2*e)+eps*Z**(2*e-1)
    s=Z**sigma+beta*Z**(sigma-1)
    q=sp.Rational(3,4)*Z**m+sp.Rational(3,4)*gamma*Z**(m-1)
    r=sp.Rational(1,4)*Z**n+sp.Rational(1,4)*delta*Z**(n-1)
    E2=Z*eta**2; D2=Z*eta**3; C2=d*Z*eta*s; E1=sp.diff(E2,Z)+G; D1=sp.diff(D2,Z)+d*eta*G
    Phi=s*G/eta; C1=d*(sp.diff(Z*eta,Z)*s+Phi/2)
    EQ1=sp.together(6*D1*sp.diff(r,Z)-4*sp.diff(q,Z)*E1+2*q*sp.diff(E1,Z)+4*C1*sp.diff(s,Z)-2*sp.diff(C1,Z)*s+2*kappa*Z)
    E2old=sp.together(10*D2*sp.diff(r,Z)-8*sp.diff(q,Z)*E2+2*q*sp.diff(E2,Z)+6*D1*sp.diff(E1,Z)-4*sp.diff(D1,Z)*E1+2*C1*s+8*C2*sp.diff(s,Z)-2*sp.diff(C2,Z)*s+8*Z*D1*sp.diff(r,Z)+4*Z*(q*sp.diff(E1,Z)-sp.diff(q,Z)*E1+C1*sp.diff(s,Z)-sp.diff(C1,Z)*s))
    EQ2=E2old if oldEQ2 else sp.together(E2old-2*q*E1)
    EQ3=sp.together(4*C2*s-4*q*E2-2*D1*E1+6*D1*sp.diff(E2,Z)-8*sp.diff(D1,Z)*E2+10*D2*sp.diff(E1,Z)-4*sp.diff(D2,Z)*E1+Z*(8*C2*sp.diff(s,Z)-4*sp.diff(C2,Z)*s-8*sp.diff(q,Z)*E2+4*q*sp.diff(E2,Z)+8*D1*sp.diff(E1,Z)-4*sp.diff(D1,Z)*E1+12*D2*sp.diff(r,Z)))
    EQ4=sp.together(2*(s*C1-q*E1)*sp.diff(r,Z)+kappa*E1+q*s*sp.diff(s,Z)-sp.diff(q,Z)*s**2)
    return n,sigma,[('"'EQ3',EQ3),('EQ1',EQ1),('EQ2',EQ2),('EQ4',EQ4)]

for e in range(1,6):
    U=3*e
    if (U+e)%2: continue
    n,sigma,ex=exprs(e,U)
    print('\\nboundary e,U,n,sigma',e,U,n,sigma)
    results={name:series_terms(expr,5*U+5*e+10)[:3] for name,expr in ex}
    for name,vals in results.items(): print(name,vals[:2])
    val=results['EQ3'][0][1]
    scale=sp.expand(val).coeff(beta) # N3 beta coeff scale
    const=sp.factor(val.subs({alpha:0,beta:0,gamma:0,delta:0,eps:0}))
    rho=sp.factor(-const/scale) # if val=scale*(N3-rho)
    print('EQ3 scale',scale,'const',const,'rho_corrected',rho)
    print('rho_old_formula', sp.factor((32*e**3+32*e**2+6*e+1)/(4*e-2)))

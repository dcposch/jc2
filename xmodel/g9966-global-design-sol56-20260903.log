   159	
   160	def reduce_chart(
   161	    data: dict,
   162	    max_pivots: int,
   163	    max_seconds: float,
   164	    max_expression_bytes: int,
   165	) -> Reduction:
   166	    started = time.monotonic()
   167	    original_variables = list(data["params"])
   168	    remaining_variables = list(original_variables)
   169	    original_rows = [
   170	        Row(index, h_power, tuple(monomial), sp.expand(expr))
   171	        for index, (h_power, monomial, expr) in enumerate(data["tagged"])
   172	    ]
   173	    rows = [dataclasses.replace(row) for row in original_rows]
   174	    pivots: list[Pivot] = []
   175	    zero_sources: set[int] = set()
   176	
   177	    while True:
   178	        if len(pivots) >= max_pivots:
   179	            raise RuntimeError("constant-pivot bound reached before exhaustion")
   180	        if time.monotonic() - started > max_seconds:
   181	            raise RuntimeError("preprocessing time bound exceeded")
   182	
   183	        choice = None
   184	        for row_index, row in sorted(enumerate(rows), key=row_order):
   185	            for variable_index, variable in enumerate(remaining_variables):
   186	                affine = constant_coefficient(row.expr, variable)
   187	                if affine is not None:
   188	                    coefficient, remainder = affine
   189	                    choice = (
   190	                        row_index,
   191	                        variable_index,
   192	                        row,
   193	                        variable,
   194	                        coefficient,
   195	                        remainder,
   196	                    )
   197	                    break
   198	            if choice is not None:
   199	                break
   200	        if choice is None:
   201	            break
   202	
   203	        (
   204	            row_index,
   205	            variable_index,
   206	            pivot_row,
   207	            variable,
   208	            coefficient,
   209	            remainder,
   210	        ) = choice
   211	        rhs = sp.expand(-remainder / coefficient)
   212	        if variable in rhs.free_symbols:
   213	            raise AssertionError("pivot right side contains pivot variable")
   214	        if sp.expand(pivot_row.expr.subs(variable, rhs)) != 0:
   215	            raise AssertionError("pivot substitution does not kill pivot row")
   216	
   217	        pivots.append(
   218	            Pivot(
   219	                step=len(pivots) + 1,
   220	                source_index=pivot_row.source_index,
   221	                h_power=pivot_row.h_power,
   222	                monomial=pivot_row.monomial,
   223	                variable=variable,
   224	                coefficient=coefficient,
   225	                step_rhs=rhs,
   226	            )
   227	        )
   228	        zero_sources.add(pivot_row.source_index)
   229	        del rows[row_index]
   230	        del remaining_variables[variable_index]
   231	
   232	        next_rows = []
   233	        for row in rows:
   234	            expr = row.expr
   235	            if variable in expr.free_symbols:
   236	                expr = sp.expand(expr.subs(variable, rhs))
   237	            if expr == 0:
   238	                zero_sources.add(row.source_index)
   239	            else:
   240	                next_rows.append(dataclasses.replace(row, expr=expr))
   241	        rows = next_rows
   242	
   243	        expression_bytes = sum(len(str(row.expr)) for row in rows)
   244	        if expression_bytes > max_expression_bytes:
   245	            raise RuntimeError(
   246	                "expanded residual exceeds byte bound: %d" % expression_bytes
   247	            )
   248	
   249	    # Resolve the triangular right sides into the final polynomial ring.
   250	    resolved: dict[sp.Symbol, sp.Expr] = {}
   251	    for pivot in reversed(pivots):
   252	        rhs = sp.expand(pivot.step_rhs.subs(resolved, simultaneous=True))
   253	        if rhs.free_symbols.intersection({p.variable for p in pivots}):
   254	            raise AssertionError("unresolved pivot in final ring map")
   255	        pivot.final_rhs = rhs
   256	        resolved[pivot.variable] = rhs
   257	
   258	    # Verify the complete map on every original row, not merely on pivots.
   259	    surviving = {row.source_index: row for row in rows}
   260	    for original in original_rows:
   261	        image = sp.expand(original.expr.subs(resolved, simultaneous=True))
   262	        if original.source_index in surviving:
   263	            if sp.expand(image - surviving[original.source_index].expr) != 0:
   264	                raise AssertionError(
   265	                    "ring-map image differs at source row %d"
   266	                    % original.source_index
   267	                )
   268	        elif image != 0:
   269	            raise AssertionError(
   270	                "deleted source row %d has nonzero ring-map image"
   271	                % original.source_index
   272	            )
   273	
   274	    pivot_set = {pivot.variable for pivot in pivots}
   275	    if pivot_set.intersection(remaining_variables):
   276	        raise AssertionError("pivot variable remains in output ring")
   277	    for row in rows:
   278	        if row.expr.free_symbols.intersection(pivot_set):
   279	            raise AssertionError("pivot variable remains in residual equation")
   280	    for pivot in pivots:
   281	        if pivot.final_rhs is None or pivot.final_rhs.free_symbols.intersection(pivot_set):
   282	            raise AssertionError("ring map does not land in reduced ring")
   283	
   284	    return Reduction(
   285	        t=int(data["t"]),
   286	        original_variables=original_variables,
   287	        c=data["c"],
   288	        original_rows=original_rows,
   289	        remaining_variables=remaining_variables,
   290	        rows=rows,
   291	        pivots=pivots,
   292	        zero_source_indices=sorted(zero_sources),
   293	        elapsed_seconds=time.monotonic() - started,
   294	    )

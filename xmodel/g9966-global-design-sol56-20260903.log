-        for variable, coefficient in self.coefficients.items():
-            coefficient = sp.expand(coefficient)
-            if coefficient != 0:
-                cleaned[variable] = coefficient
-        self.coefficients = cleaned
-        self.constant = sp.expand(self.constant)

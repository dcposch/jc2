-            "C2_pivots": d2_c2,
-            "C3_pivots": d2_c3,
-            "residual_rows": 0,
-        },
-        "D1_first_band_mod_D2": {
-            "rows": len(d1_original),
-            "rows_by_u_power": dict(sorted(d1_counts.items())),
-            "Qstar_pivots": 7,
-            "C2_pivots": d1_c2,
-            "C3_pivots": d1_c3,

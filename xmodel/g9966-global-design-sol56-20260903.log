    87	def sha256_file(path: pathlib.Path) -> str:
    88	    digest = hashlib.sha256()
    89	    with path.open("rb") as handle:
    90	        for block in iter(lambda: handle.read(1024 * 1024), b""):
    91	            digest.update(block)
    92	    return digest.hexdigest()
    93	
    94	
    95	def sha256_text(text: str) -> str:
    96	    return hashlib.sha256(text.encode("utf-8")).hexdigest()

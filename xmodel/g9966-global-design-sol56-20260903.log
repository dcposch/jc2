-#!/usr/bin/env python3
-"""Exact first-band joint calculation for Moh's h3 inside h2 chart.
-
-The calculation is deliberately limited to the major approximate-root tower.
-It ties the degree-33 approximate root h2 to its degree-11 approximate root h3,
-imposes the fixed D2 face and the first D2-to-D1 recentering band, and stops
-before adjoining f99, g66, either minor chart, or the Jacobian equations.
-
-All elimination is sparse and exact.  The equations are affine-linear in the
-C2/C3 coefficient variables over Q[h], and only rational-constant (Q*) pivots
-are used.  JSON is written to stdout; the driver itself writes no files.
-"""
-
-from __future__ import annotations
-
-from dataclasses import dataclass
-from collections import defaultdict
-from copy import deepcopy
-import hashlib
-import json
-from math import comb
-from pathlib import Path
-import resource
-import time
-
-import sympy as sp
-
-
-HERE = Path(__file__).resolve().parent
-ROOT = HERE.parents[2]
-RECEIPT = ROOT / "xmodel/g9966-global-design-sol56-20260903.run.v2"
-MAX_WEIGHT = 98
-
-
-def digest(path: Path) -> str:
-    value = hashlib.sha256()
-    with path.open("rb") as stream:
-        for block in iter(lambda: stream.read(1024 * 1024), b""):
-            value.update(block)
-    return value.hexdigest()
-
-
-def verify_frozen_inputs() -> dict:
-    fields = {}
-    for line in RECEIPT.read_text(encoding="utf-8").splitlines():
-        if "=" in line:
-            key, value = line.split("=", 1)
-            fields[key] = value
-    count = int(fields["charged_inputs"])
-    source = Path(fields["lane_inputs_dir"])
-    checked = []
-    for index in range(1, count + 1):
-        name = fields[f"charged_input_{index}_basename"]
-        expected = fields[f"charged_input_{index}_sha256"]
-        assert Path(name).name == name
-        actual = digest(source / name)
-        assert actual == expected, f"frozen input mismatch: {name}"
-        checked.append({"basename": name, "sha256": actual})
-    assert len(checked) == count == 14
-    return {
-        "receipt": str(RECEIPT),
-        "lane_inputs_dir": str(source),
-        "charged_inputs": count,
-        "all_hashes_match": True,
-        "files": checked,
-    }
-
-
-def weight(position: tuple[int, int]) -> int:
-    r, q = position
-    return 3 * r + 4 * q
-
-
-def sparse_multiply(left, right, max_weight=MAX_WEIGHT):
-    answer = defaultdict(lambda: sp.Integer(0))
-    for (r1, q1), a in left.items():
-        for (r2, q2), b in right.items():
-            position = (r1 + r2, q1 + q2)
-            if weight(position) <= max_weight:
-                answer[position] += a * b
-    return {
-        position: sp.expand(value)
-        for position, value in answer.items()
-        if value != 0
-    }
-
-
-@dataclass
-class LinearRow:
-    """An affine-linear polynomial in the Q variables over Q[h]."""
-
-    coefficients: dict[int, sp.Expr]
-    constant: sp.Expr = sp.Integer(0)
-    tag: str = ""
-
-    def copy(self):
-        return LinearRow(dict(self.coefficients), self.constant, self.tag)
-
-    def clean(self):
-        cleaned = {}
-        for variable, coefficient in self.coefficients.items():
-            coefficient = sp.expand(coefficient)
-            if coefficient != 0:
-                cleaned[variable] = coefficient
-        self.coefficients = cleaned
-        self.constant = sp.expand(self.constant)
-        return self
-
-    def add_scaled(self, other: "LinearRow", scalar) -> None:
-        if scalar == 0:
-            return
-        self.constant = sp.expand(self.constant + scalar * other.constant)
-        for variable, coefficient in other.coefficients.items():
-            self.coefficients[variable] = sp.expand(
-                self.coefficients.get(variable, 0) + scalar * coefficient
-            )
-            if self.coefficients[variable] == 0:
-                del self.coefficients[variable]
-
-
-def reduce_by_solutions(row: LinearRow, solutions: dict[int, LinearRow]) -> LinearRow:
-    """Substitute all already solved pivot variables, exactly."""
-    row = row.copy().clean()
-    while True:
-        pivot = next((v for v in row.coefficients if v in solutions), None)
-        if pivot is None:
-            return row.clean()
-        coefficient = row.coefficients.pop(pivot)
-        row.add_scaled(solutions[pivot], coefficient)
-
-
-def solve_unit_pivot(row: LinearRow, pivot: int) -> LinearRow:
-    """Return the affine row representing pivot = rhs."""
-    coefficient = sp.expand(row.coefficients[pivot])
-    assert coefficient.is_Rational and coefficient != 0
-    answer = LinearRow({}, sp.expand(-row.constant / coefficient), f"solve:{row.tag}")
-    for variable, value in row.coefficients.items():
-        if variable != pivot:
-            answer.coefficients[variable] = sp.expand(-value / coefficient)
-    return answer.clean()
-
-
-def evaluate_row(row: LinearRow, q_values, h_values):
-    value = row.constant.subs(h_values)
-    for variable, coefficient in row.coefficients.items():
-        value += coefficient.subs(h_values) * q_values[variable]
-    return sp.expand(value)
-
-
-def synthetic_elimination_controls() -> dict:
-    """Positive and negative controls for the unit-pivot row engine."""
-    # x-2=0, x+y-3=0 has the exact point (2,1).
-    rows = [
-        LinearRow({0: sp.Integer(1)}, sp.Integer(-2), "positive-1"),
-        LinearRow({0: sp.Integer(1), 1: sp.Integer(1)}, sp.Integer(-3), "positive-2"),
-    ]
-    solutions = {}
-    for row, pivot in zip(rows, (0, 1)):
-        reduced = reduce_by_solutions(row, solutions)
-        solutions[pivot] = solve_unit_pivot(reduced, pivot)
-    values = {1: sp.Integer(1), 0: sp.Integer(2)}
-    assert all(evaluate_row(row, values, {}) == 0 for row in rows)
-
-    # x=0, x=1 must leave a nonzero constant after the first pivot.
-    first = LinearRow({0: sp.Integer(1)}, sp.Integer(0), "negative-1")
-    second = LinearRow({0: sp.Integer(1)}, sp.Integer(-1), "negative-2")
-    negative_solution = {0: solve_unit_pivot(first, 0)}
-    obstruction = reduce_by_solutions(second, negative_solution)
-    assert not obstruction.coefficients and obstruction.constant == -1
-    return {
-        "synthetic_nonempty_two_pivot_system_rechecked": True,
-        "synthetic_inconsistent_system_leaves_nonzero_constant": True,
-    }
-
-
-def main() -> None:
-    started = time.perf_counter()
-    frozen = verify_frozen_inputs()
-    controls = synthetic_elimination_controls()
-
-    # Normalized coordinates:
-    #   H3=t^11 h3(t^-1,w/t), v=w-1,
-    #   H2=t^33 h2(t^-1,w/t)=H3^3+C2*H3+C3.
-    # The fixed homogeneous part is H3_0=(1+v)^3 v^8.  The charged slice
-    # sets the two non-top equality-face coordinates (4,5),(8,2) to zero and
-    # retains precisely the 21 strict D2 coefficients of H3.
-    h3 = {
-        (0, 8 + j): sp.Integer(comb(3, j))
-        for j in range(4)
-    }
-    h_positions = []
-    h_symbols = []
-    for r in range(1, 12):
-        for q in range(0, 12 - r):
-            if weight((r, q)) >= 33:
-                symbol = sp.Symbol(f"h_{r}_{q}")
-                h_positions.append((r, q))
-                h_symbols.append(symbol)
-                h3[(r, q)] = symbol
-    assert len(h_symbols) == 21
-    assert (4, 5) not in h_positions and (8, 2) not in h_positions
-
-    c2_positions = []
-    c3_positions = []
-    q_symbols = []
-    q_names = []
-    c2_index = {}
-    c3_index = {}
-    for r in range(1, 23):
-        for q in range(0, min(10, 22 - r) + 1):
-            index = len(q_symbols)
-            symbol = sp.Symbol(f"c2_{r}_{q}")
-            q_symbols.append(symbol)
-            q_names.append(str(symbol))
-            c2_positions.append((r, q))
-            c2_index[(r, q)] = index
-    for r in range(1, 34):
-        for q in range(0, min(10, 33 - r) + 1):
-            index = len(q_symbols)
-            symbol = sp.Symbol(f"c3_{r}_{q}")
-            q_symbols.append(symbol)
-            q_names.append(str(symbol))
-            c3_positions.append((r, q))
-            c3_index[(r, q)] = index
-    assert len(c2_positions) == 187
-    assert len(c3_positions) == 308
-    assert len(q_symbols) == 495
-
-    # Constant part H3^3, truncated after the only weights that can affect D2
-    # or u<296 at D1.
-    h3_squared = sparse_multiply(h3, h3)
-    h3_cubed = sparse_multiply(h3_squared, h3)
-
-    # Coefficient rows for H2.  A C2 variable is multiplied by every H3
-    # coefficient; a C3 variable enters its own position with coefficient 1.
-    h2_rows: dict[tuple[int, int], LinearRow] = {}
-    for r in range(34):
-        for q in range(34 - r):
-            position = (r, q)
-            if weight(position) <= MAX_WEIGHT:
-                h2_rows[position] = LinearRow(
-                    {}, h3_cubed.get(position, sp.Integer(0)), f"H2[{r},{q}]"
-                )
-    for c_position, variable in c2_index.items():
-        cr, cq = c_position
-        for (hr, hq), coefficient in h3.items():
-            position = (cr + hr, cq + hq)
-            if position in h2_rows:
-                row = h2_rows[position]
-                row.coefficients[variable] = sp.expand(
-                    row.coefficients.get(variable, 0) + coefficient
-                )
-    for position, variable in c3_index.items():
-        if position in h2_rows:
-            h2_rows[position].coefficients[variable] = sp.Integer(1)
-    for row in h2_rows.values():
-        row.clean()
-
-    # D2 target: all weights below 96 vanish and the equality face is
-    # (pi^3-1)^8.  The r=0,q=24 coefficient is already supplied by the fixed
-    # homogeneous form; the 392 nonidentity r>0 rows are processed in the
-    # triangular order r increasing, q decreasing.
-    face_target = {
-        (4 * k, 24 - 3 * k): sp.Integer((-1) ** k * comb(8, k))
-        for k in range(9)
-    }
-    d2_original = []
-    for r in range(1, 34):
-        for q in range(33 - r, -1, -1):
-            position = (r, q)
-            if weight(position) <= 96:
-                row = h2_rows[position].copy()
-                row.constant = sp.expand(row.constant - face_target.get(position, 0))
-                row.tag = f"D2[{r},{q}]"
-                d2_original.append((position, row.clean()))
-    assert len(d2_original) == 392
-
-    solutions: dict[int, LinearRow] = {}
-    pivot_ledger = []
-    residual_rows = []
-    for (r, q), original in d2_original:
-        row = reduce_by_solutions(original, solutions)
-        pivot = c3_index.get((r, q)) if q <= 10 else c2_index.get((r, q - 11))
-        if pivot is None or pivot in solutions:
-            residual_rows.append(row)
-            continue
-        coefficient = sp.expand(row.coefficients.get(pivot, 0))
-        if not (coefficient.is_Rational and coefficient != 0):
-            residual_rows.append(row)
-            continue
-        solutions[pivot] = solve_unit_pivot(row, pivot)
-        pivot_ledger.append(
-            {
-                "stage": "D2",
-                "tag": row.tag,
-                "pivot": q_names[pivot],
-                "coefficient": str(coefficient),
-                "remaining_terms": len(solutions[pivot].coefficients),
-            }
-        )
-    assert not residual_rows
-    assert len(solutions) == len(pivot_ledger) == 392
-
-    # Modulo the D2 equations, u<296 adds seven scalar rows.  A weight-W term
-    # t^r v^q becomes u^(3W)(1+Pi*u)^q under
-    # t=u^9, v=u^12(1+Pi*u).
-    d1_original = []
-    for W, max_taylor in ((97, 4), (98, 1)):
-        for derivative_order in range(max_taylor + 1):
-            exponent = 3 * W + derivative_order
-            row = LinearRow({}, sp.Integer(0), f"D1[u{exponent},Pi{derivative_order}]")
-            for position, h2_row in h2_rows.items():
-                r, q = position
-                if weight(position) == W and derivative_order <= q:
-                    row.add_scaled(h2_row, sp.Integer(comb(q, derivative_order)))
-            d1_original.append(row.clean())
-    # Sort into the visible 1,1,1,2,2 row pattern by u exponent.
-    d1_original.sort(key=lambda row: tuple(int(part) for part in row.tag.replace("D1[u", "").replace(",Pi", " ").replace("]", "").split()))
-    assert len(d1_original) == 7
-
-    d1_counts = defaultdict(int)
-    d1_pivots_before = len(solutions)
-    for original in d1_original:
-        exponent = int(original.tag.split("u", 1)[1].split(",", 1)[0])
-        d1_counts[exponent] += 1
-        row = reduce_by_solutions(original, solutions)
-        candidates = [
-            variable
-            for variable, coefficient in row.coefficients.items()
-            if variable not in solutions
-            and coefficient.is_Rational
-            and coefficient != 0
-        ]
-        if not candidates:
-            residual_rows.append(row)
-            continue
-        # Prefer C3, then the lowest stable generator index.
-        pivot = min(candidates, key=lambda value: (0 if value >= len(c2_positions) else 1, value))
-        coefficient = sp.expand(row.coefficients[pivot])
-        solutions[pivot] = solve_unit_pivot(row, pivot)
-        pivot_ledger.append(
-            {
-                "stage": "D1",
-                "tag": row.tag,
-                "pivot": q_names[pivot],
-                "coefficient": str(coefficient),
-                "remaining_terms": len(solutions[pivot].coefficients),
-            }
-        )
-
-    nonzero_residual = [row for row in residual_rows if row.coefficients or row.constant != 0]
-    assert not nonzero_residual
-    assert len(solutions) - d1_pivots_before == 7
-    assert dict(sorted(d1_counts.items())) == {291: 1, 292: 1, 293: 1, 294: 2, 295: 2}
-
-    # Construct one exact rational point by setting all h and all genuinely
-    # free Q variables to zero and back-substituting the unit pivots.
-    h_values = {symbol: sp.Integer(0) for symbol in h_symbols}
-    q_values = {
-        index: sp.Integer(0)
-        for index in range(len(q_symbols))
-        if index not in solutions
-    }
-    for pivot in reversed(list(solutions)):
-        solved = solutions[pivot]
-        value = solved.constant.subs(h_values)
-        for variable, coefficient in solved.coefficients.items():
-            assert variable in q_values
-            value += coefficient.subs(h_values) * q_values[variable]
-        q_values[pivot] = sp.expand(value)
-    assert len(q_values) == len(q_symbols)
-
-    # Recheck every original D2 equation and all seven quotient D1 rows.
-    d2_failures = [
-        row.tag
-        for _position, row in d2_original
-        if evaluate_row(row, q_values, h_values) != 0
-    ]
-    d1_failures = [
-        row.tag
-        for row in d1_original
-        if evaluate_row(row, q_values, h_values) != 0
-    ]
-    assert not d2_failures and not d1_failures
-
-    # Strong recentering check in the original coefficient map: all scalar
-    # coefficients below u^296 vanish after the positive point.  At u^296 the
-    # Pi^8 coefficient is exactly 3^8; lower coefficients are intentionally
-    # not constrained.
-    recentered = defaultdict(lambda: sp.Integer(0))
-    for (r, q), row in h2_rows.items():
-        scalar = evaluate_row(row, q_values, h_values)
-        if scalar == 0:
-            continue
-        base = 9 * r + 12 * q
-        for derivative_order in range(q + 1):
-            exponent = base + derivative_order
-            if exponent <= 296:
-                recentered[(exponent, derivative_order)] += scalar * comb(q, derivative_order)
-    below = {
-        key: sp.expand(value)
-        for key, value in recentered.items()
-        if key[0] < 296 and sp.expand(value) != 0
-    }
-    assert not below
-    leading_pi8 = sp.expand(recentered[(296, 8)])
-    assert leading_pi8 == 3**8
-
-    # Negative control: perturb the first pivot coordinate of the actual
-    # positive point.  At least one original row must reject it.
-    negative_values = dict(q_values)
-    first_pivot = next(iter(solutions))
-    negative_values[first_pivot] += 1
-    negative_rejections = sum(
-        evaluate_row(row, negative_values, h_values) != 0
-        for _position, row in d2_original
-    ) + sum(
-        evaluate_row(row, negative_values, h_values) != 0
-        for row in d1_original
-    )
-    assert negative_rejections > 0
-    controls.update(
-        {
-            "all_392_original_D2_rows_rechecked_at_exact_point": True,
-            "all_7_D1_quotient_rows_rechecked_at_exact_point": True,
-            "full_recenter_has_no_nonzero_coefficient_below_u296": True,
-            "u296_Pi8_coefficient_is_3_power_8": True,
-            "single_actual_pivot_perturbation_is_rejected": True,
-        }
-    )
-
-    d2_c3 = sum(entry["pivot"].startswith("c3_") for entry in pivot_ledger if entry["stage"] == "D2")
-    d2_c2 = 392 - d2_c3
-    d1_c3 = sum(entry["pivot"].startswith("c3_") for entry in pivot_ledger if entry["stage"] == "D1")
-    d1_c2 = 7 - d1_c3
-    free_q = len(q_symbols) - len(solutions)
-    free_total = len(h_symbols) + free_q
-
-    elapsed = time.perf_counter() - started
-    output = {
-        "type": "EXACT-MAJOR-TOWER-h3-IN-h2 / FIXED-FACE-SLICE",
-        "scope": {
-            "proved": "exact consistency and dimension of the stated h3/h2 D2 face plus first D1 order band",
-            "not_claimed": [
-                "the remaining D1 child polynomial equations",
-                "compatibility with global f99 and g66",
-                "either principal-minor split",
-                "J(f,g)=1",
-            ],
-        },
-        "frozen_input_verification": frozen,
-        "coordinates": {
-            "H3": "t^11*h3(t^-1,w/t)",
-            "H3_fixed_top": "w^3*(w-1)^8",
-            "H3_slice": "the two weight-32 non-top face coordinates (4,5),(8,2) are zero; 21 strict coordinates remain",
-            "H2": "t^33*h2(t^-1,w/t)=H3^3+C2*H3+C3",
-            "C2": "t^22*C2(t^-1,w/t), C2 in S(21,11)",
-            "C3": "t^33*C3(t^-1,w/t), C3 in S(32,11)",
-            "D2_substitution": "w=1+pi*t^(4/3)",
-            "D2_face": "(pi^3-1)^8 at weight 96; weights below 96 vanish; strict weights start at 97",
-            "D1_recenter": "t=u^9, w=1+u^12+Pi*u^13",
-            "D1_threshold": "u^296",
-        },
-        "ambient": {
-            "h3_strict_variables": len(h_symbols),
-            "C2_variables": len(c2_positions),
-            "C3_variables": len(c3_positions),
-            "total_variables": len(h_symbols) + len(q_symbols),
-        },
-        "D2": {
-            "nonidentity_rows": len(d2_original),
-            "Qstar_pivots": 392,
-            "C2_pivots": d2_c2,
-            "C3_pivots": d2_c3,
-            "residual_rows": 0,
-        },
-        "D1_first_band_mod_D2": {
-            "rows": len(d1_original),
-            "rows_by_u_power": dict(sorted(d1_counts.items())),
-            "Qstar_pivots": 7,
-            "C2_pivots": d1_c2,
-            "C3_pivots": d1_c3,
-            "residual_rows": 0,
-            "u296_leading_Pi8": str(leading_pi8),
-        },
-        "joint_result": {
-            "total_Qstar_pivots": len(solutions),
-            "free_h3_variables": len(h_symbols),
-            "free_C2_C3_variables": free_q,
-            "exact_affine_family_dimension": free_total,
-            "consistent": True,
-        },
-        "controls": controls,
-        "D1_pivot_ledger": [
-            entry for entry in pivot_ledger if entry["stage"] == "D1"
-        ],
-        "resource": {
-            "elapsed_seconds": round(elapsed, 6),
-            "max_rss_kib": resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,
-        },
-    }
-    print(json.dumps(output, indent=2, sort_keys=True))
-
-
-if __name__ == "__main__":
-    main()

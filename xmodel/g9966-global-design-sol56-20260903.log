   114	def assert_same_chart(left: dict, right: dict, label: str) -> dict:
   115	    """Mechanically compare two builders, including ordered tagged rows."""
   116	    left_names = [str(v) for v in left["params"]] + [str(left["c"])]
   117	    right_names = [str(v) for v in right["params"]] + [str(right["c"])]
   118	    if left_names != right_names:
   119	        raise AssertionError("%s: parameter order differs" % label)
   120	    for key in ("h", "A", "B", "z", "P", "Q"):
   121	        if sp.expand(left[key] - right[key]) != 0:
   122	            raise AssertionError("%s: %s differs" % (label, key))
   123	    if len(left["tagged"]) != len(right["tagged"]):
   124	        raise AssertionError("%s: tagged row count differs" % label)
   125	    for index, (lrow, rrow) in enumerate(zip(left["tagged"], right["tagged"])):
   126	        if lrow[:2] != rrow[:2] or sp.expand(lrow[2] - rrow[2]) != 0:
   127	            raise AssertionError("%s: tagged row %d differs" % (label, index))
   128	    return {
   129	        "label": label,
   130	        "parameter_order_equal": True,
   131	        "h_A_B_z_P_Q_equal": True,
   132	        "ordered_tagged_equations_equal": True,
   133	        "equation_count": len(left["tagged"]),
   134	        "equation_vector_sha256": expression_vector_hash(
   135	            row[2] for row in left["tagged"]
   136	        ),
   137	    }

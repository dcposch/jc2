   297	def primitive_integer_polynomial(
   298	    expr: sp.Expr, variables: list[sp.Symbol]
   299	) -> tuple[sp.Poly, sp.Rational, int, int]:
   300	    """Return primitive g in ZZ[V] and lambda in Q* with g=lambda*expr."""
   301	    polynomial = sp.Poly(expr, *variables, domain=sp.QQ)
   302	    denominator_lcm, cleared = polynomial.clear_denoms(convert=True)
   303	    content, primitive = cleared.primitive()
   304	    multiplier = sp.Rational(denominator_lcm, content)
   305	    if primitive.LC() < 0:
   306	        primitive = -primitive
   307	        multiplier = -multiplier
   308	    if sp.expand(primitive.as_expr() - multiplier * expr) != 0:
   309	        raise AssertionError("primitive integer normalization identity failed")
   310	    return primitive, multiplier, int(denominator_lcm), abs(int(content))
   311	
   312	
   313	def singular_polynomial(expr: sp.Expr, variables: list[sp.Symbol]) -> str:
   314	    """Render the proof-equivalent primitive integer multiple of a Q-row."""
   315	    polynomial, _multiplier, _denominator_lcm, _content = (
   316	        primitive_integer_polynomial(expr, variables)
   317	    )
   318	    rendered: list[str] = []
   319	    for monomial, coefficient in polynomial.terms():
   320	        coefficient = sp.Integer(coefficient)
   321	        if coefficient == 0:
   322	            continue
   323	        factors = []
   324	        for variable, exponent in zip(variables, monomial):
   325	            if exponent == 1:
   326	                factors.append(str(variable))
   327	            elif exponent > 1:
   328	                factors.append("%s^%d" % (variable, exponent))
   329	        monomial_text = "*".join(factors)
   330	        magnitude = abs(coefficient)
   331	        if monomial_text and magnitude == 1:
   332	            body = monomial_text
   333	        else:
   334	            scalar = str(magnitude)
   335	            body = scalar if not monomial_text else scalar + "*" + monomial_text
   336	        if not rendered:
   337	            rendered.append(("-" if coefficient < 0 else "") + body)
   338	        else:
   339	            rendered.append((" - " if coefficient < 0 else " + ") + body)
   340	    return "".join(rendered) if rendered else "0"
     1	#!/usr/bin/env python3
     2	"""Exact cubic-root order chart with the a1-curved radius-two centre.
     3	
     4	This is a linear order-space calculation, not Moh's omitted full lift.  It
     5	keeps the face parameter ``a`` and the unrecoverable jet ``u=a1`` symbolic.
     6	The harmless polynomial translation has set a0=0, while a2 is absorbed into
     7	the radius-two coordinate z so that the double root of H is at zero.
     8	"""
     9	
    10	from __future__ import annotations
    11	
    12	import json
    13	from math import ceil
    14	
    15	import sympy as sp
    16	
    17	
    18	x, w, z, a, u = sp.symbols("x w z a u")
    19	D = 11
    20	# The normalized top face has integralized weight 32.  Perturbations must be
    21	# strict, hence weight at least 33; equality would change that face.
    22	MAJOR_THRESHOLD = 33
    23	MINOR_THRESHOLD = 9
    24	H = sp.expand(z**2 * (z + 3 * a))
    25	
    26	
    27	def constant_pivot(rows, tags, variables):
    28	    """Apply only affine pivots whose coefficient lies in Q*."""
    29	    rows = list(rows)
    30	    tags = list(tags)
    31	    variables = list(variables)
    32	    pivots = []
    33	    while True:
    34	        choice = None
    35	        for row_index, (tag, expression) in enumerate(zip(tags, rows)):
    36	            for variable_index, variable in enumerate(variables):
    37	                coefficient = sp.expand(sp.diff(expression, variable))
    38	                remainder = sp.expand(expression - coefficient * variable)
    39	                if (coefficient.is_Rational and coefficient != 0
    40	                        and variable not in remainder.free_symbols):
    41	                    choice = (row_index, variable_index, tag, variable,
    42	                              coefficient, remainder)
    43	                    break
    44	            if choice is not None:
    45	                break
    46	        if choice is None:
    47	            break
    48	        row_index, variable_index, tag, variable, coefficient, remainder = choice
    49	        rhs = sp.expand(-remainder / coefficient)
    50	        assert sp.expand(rows[row_index].subs(variable, rhs)) == 0
    51	        pivots.append((tag, variable, coefficient, rhs))
    52	        del rows[row_index]
    53	        del tags[row_index]
    54	        del variables[variable_index]
    55	        next_rows = []
    56	        next_tags = []
    57	        for tag_i, expression in zip(tags, rows):
    58	            reduced = sp.expand(expression.subs(variable, rhs))
    59	            if reduced != 0:
    60	                next_rows.append(reduced)
    61	                next_tags.append(tag_i)
    62	        rows, tags = next_rows, next_tags
    63	    return rows, tags, variables, pivots

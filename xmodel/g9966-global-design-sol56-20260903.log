-    below = {
-        key: sp.expand(value)
-        for key, value in recentered.items()
-        if key[0] < 296 and sp.expand(value) != 0
-    }
-    assert not below
-    leading_pi8 = sp.expand(recentered[(296, 8)])
-    assert leading_pi8 == 3**8
-
-    # Negative control: perturb the first pivot coordinate of the actual
-    # positive point.  At least one original row must reject it.
-    negative_values = dict(q_values)
-    first_pivot = next(iter(solutions))
-    negative_values[first_pivot] += 1
-    negative_rejections = sum(
-        evaluate_row(row, negative_values, h_values) != 0
-        for _position, row in d2_original

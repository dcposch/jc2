+          string(xp) + "|" + string(yp) + "|" + string(cc));
+        source_idx = source_idx + 1;
+      }
+    }
+  }
+}
+""".strip(),
+    ]
+    lines.extend(spec["setup"])
+    for level in range(level_cap + 1):
+        lines.append(f"poly H{level} = 0;")
+    lines.append("poly tmpSame;")
+    lines.append("poly tmpLower;")

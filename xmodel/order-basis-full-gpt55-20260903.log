+                    f"+({r})*({aa})*(diff(h,x)*diff(({bb}),y)-diff(h,y)*diff(({bb}),x));"
+                )
+                lines.append(f"if (tmpLower != 0) {{ H{r + s - 1} = H{r + s - 1} + tmpLower; }}")
+    for level in range(level_cap):

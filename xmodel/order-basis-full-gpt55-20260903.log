+    max_nf_deg = dx;
+  }
+  matrix CX = coef(rem, x);
+  int i;
+  int j;
+  int xp;
+  int yp;
+  matrix CY;
+  poly cc;
+  for (i = 1; i <= ncols(CX); i++)
+  {
+    xp = deg(CX[1,i], WX);
+    CY = coef(CX[2,i], y);
+    for (j = 1; j <= ncols(CY); j++)

+        "sat": sstr(spec["sat"]),
+        "builder": str(builder_path.relative_to(ROOT)),
+        "rows_path": str(rows_path.relative_to(ROOT)),
+    }
+    meta_path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")

+        "ideal K=-c,T*c-1;",
+        "ideal H=std(K);",
+        'if (reduce(1,H)==0) { print("RESTORED_ROW_EMPTY"); } else { print("RESTORED_ROW_FAIL"); }',
+        "quit;",
+    ]) + "\n", encoding="utf-8")
+    return parse_system_result(run_singular(path))
+
+
+def run_requested_control_set() -> dict:
+    return {

+def serial_closed_form(C: dict) -> dict:
+    return {
+        "K": C["K"],
+        "e": C["e"],
+        "q": C["q"],
+        "u": C["u"],
+        "R": C["R"],
+        "Pi": C["Pi"],
+        "d3prime": C["d3prime"],
+        "delta1": qstr(C["delta1"]),
+        "delta2": qstr(C["delta2"]),
+        "B": qstr(C["B"]),
+        "lambda_P": qstr(C["lambda_P"]),
+        "lambda_Q": qstr(C["lambda_Q"]),

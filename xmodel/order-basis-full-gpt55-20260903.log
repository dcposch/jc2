def rename_symbols(params: Sequence[sp.Symbol], T: sp.Symbol):
    names: List[str] = []
    rename: Dict[sp.Symbol, sp.Symbol] = {}
    for sym in list(params) + [T]:
        base = clean_name(str(sym))
        name = base
        suffix = 1
        while name in names:
            suffix += 1
            name = "%s_%d" % (base, suffix)
        names.append(name)
        rename[sym] = sp.Symbol(name)
    return names, rename



+            f"ring R={char},(c,T),dp;",
+            "ideal I=c-1,T*c-1;",
+            "ideal G=std(I);",
+            'if (reduce(1,G)!=0) { print("TAME_SURVIVES"); } else { print("TAME_FALSE_EMPTY"); }',
+            "quit;",
+        ]) + "\n", encoding="utf-8")
+        records.append(parse_system_result(run_singular(path)))
+    return records

    a=sp.symbols(\"a0:%d\"%(2*V))
    b=sp.symbols(\"b0:%d\"%(3*V))
    f=y**(2*V)+sum(a[i]*y**i for i in range(2*V))
    g=-(y**(3*V)+sum(b[i]*y**i for i in range(3*V)))
    E=sp.Poly(sp.expand(2*f*sp.diff(g,y)-3*sp.diff(f,y)*g-c), y)
    eqs=[sp.expand(v) for v in E.all_coeffs() if v"'!=0]
    G=sp.groebner(eqs, *(list(a)+list(b)+[c]), order="lex")
    print("V",V,"eq",len(eqs),"vars",len(a)+len(b)+1,"one",G.reduce(sp.Integer(1))[1]==0,"len",len(G.polys))
    if V<=2:
        print(G)
for V in range(1,5):
    solveV(V)

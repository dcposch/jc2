        }
      }
    }
  }
  return(0);
}

proc native_y_div(poly dividend, poly divisor, int y_degree, intvec WY)
{
  poly q = 0;
  poly r = dividend;
  int d;
  poly lc;
  poly term;
  while (r != 0 && deg(r, WY) >= y_degree)
  {
    d = deg(r, WY);
    lc = native_coeff_y(r, d, WY);
    term = lc * y^(d - y_degree);
    q = q + term;
    r = r - term * divisor;
  }
  list out = q, r;
  return(out);
}


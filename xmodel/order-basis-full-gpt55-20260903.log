+def read_rows(path: Path) -> list[dict]:
+    rows = []
+    with path.open(encoding="utf-8") as handle:
+        header = next(handle, None)
+        if header is None:
+            return rows
+        for line in handle:
+            line = line.rstrip("\n")
+            if not line:
+                continue
+            source, hpow, xpow, ypow, expr = line.split("|", 4)
+            rows.append({

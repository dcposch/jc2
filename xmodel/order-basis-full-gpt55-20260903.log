+        "omitted_row": write_omitted_row_control(),
+    }
+
+
+def select_rows(text: str) -> list[Row]:
+    if text == "all":
+        return [ROWS["2515"], ROWS["d108"]]
+    return [ROWS[name] for name in text.split(",") if name]
+
+

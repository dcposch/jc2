print("alpha dims",[len(alpha_mons[i]) for i in range(1,C["eprime"]+1)])
print("beta dims",[len(beta_mons[i]) for i in range(2,C["dprime"]+1)])
print("params before build",len(params)+sum(len(v) for v in alpha_mons.values())+sum(len(v) for v in beta_mons.values())+1)
alpha={i:coeff("A",i,alpha_mons[i]) for i in range(1,C["eprime"]+1)}
beta={i:coeff("B",i,beta_mons[i]) for i in range(2,C["dprime"]+1)}
high=[(sp.Integer(1),C["eprime"])] + [(alpha[i],C["eprime"]-i) for i in range(1,C["eprime"]+1)]
low=[(sp.Integer(1),C["dprime"])] + [(beta[i],C["dprime"]-i) for i in range(2,C["dprime"]+1)]
t=time.time(); by=oc.hadic_by_power(h, low, high, x, y); print("hadic",time.time()-t, "levels",sorted(k for k,v in by.items() if sp.expand(v)!=0))
t=time.time(); eqs,rows=oc.equations_from_by_power(by,c,row.k,x,y); print("eqs",len(eqs),"rows",len(rows),"extract",time.time()-t)
for r in rows:
    if r["h_power"]==0 and r["monomial"]==[2,0]:

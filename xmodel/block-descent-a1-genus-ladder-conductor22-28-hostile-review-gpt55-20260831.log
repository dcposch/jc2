   143	    first, second = abs(first), abs(second)
   144	    require(math.gcd(first, second) == 1, "primitive torus knot")
   145	    if first % 2 == 0:
   146	        return second
   147	    if second % 2 == 0:
   148	        return first
   149	    return 1
   150	
   151	
   152	def recursive_alexander_determinant(sequence: tuple[int, ...]) -> int:
   153	    if len(sequence) == 2:
   154	        return torus_determinant(sequence[1], sequence[0])
   155	    winding = prefix_gcd(sequence[:-1])
   156	    pattern = torus_determinant(winding, sequence[-1])
   157	    companion = recursive_alexander_determinant(tuple(value // winding for value in sequence[:-1]))
   158	    return pattern * (companion if winding % 2 else 1)

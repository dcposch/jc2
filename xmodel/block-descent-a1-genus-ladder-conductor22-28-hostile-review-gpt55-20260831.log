   345	
   346	def identity(size: int) -> Matrix:
   347	    return [[ONE if row == column else ZERO for column in range(size)] for row in range(size)]
   348	
   349	
   350	def matrix_multiply(left: Matrix, right: Matrix) -> Matrix:
   351	    size = len(left)
   352	    return [
   353	        [
   354	            sum_laurent(
   355	                left[row][middle] * right[middle][column] for middle in range(size)
   356	            )
   357	            for column in range(size)
   358	        ]
   359	        for row in range(size)
   360	    ]
   361	
   362	
   363	def burau_generator(strands: int, generator: int) -> Matrix:
   364	    result = identity(strands)
   365	    index = abs(generator) - 1
   366	    block = (
   367	        ((ONE - T, T), (ONE, ZERO))
   368	        if generator > 0
   369	        else ((ZERO, ONE), (T_INV, ONE - T_INV))
   370	    )
   371	    for row_offset in range(2):
   372	        for column_offset in range(2):
   373	            result[index + row_offset][index + column_offset] = block[row_offset][column_offset]
   374	    return result
   375	
   376	
   377	def reduced_burau(strands: int, word: tuple[int, ...]) -> Matrix:
   378	    unreduced = identity(strands)
   379	    for generator in word:
   380	        unreduced = matrix_multiply(unreduced, burau_generator(strands, generator))
   381	    return [
   382	        [unreduced[row][column] - unreduced[strands - 1][column] for column in range(strands - 1)]
   383	        for row in range(strands - 1)
   384	    ]
   385	
   386	
   387	def determinant(matrix: Matrix) -> Laurent:
   388	    size = len(matrix)
   389	    result = ZERO
   390	    for permutation in itertools.permutations(range(size)):
   391	        inversions = sum(
   392	            permutation[left] > permutation[right]
   393	            for left in range(size)
   394	            for right in range(left + 1, size)
   395	        )
   396	        term = ONE
   397	        for row, column in enumerate(permutation):
   398	            term = term * matrix[row][column]
   399	        result = result - term if inversions % 2 else result + term
   400	    return result

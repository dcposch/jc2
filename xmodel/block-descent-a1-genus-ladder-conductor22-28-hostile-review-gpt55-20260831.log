   288	def partitions_of_four() -> tuple[frozenset[frozenset[int]], ...]:
   289	    return (
   290	        frozenset((frozenset((0, 1)), frozenset((2, 3)))),
   291	        frozenset((frozenset((0, 2)), frozenset((1, 3)))),
   292	        frozenset((frozenset((0, 3)), frozenset((1, 2)))),
   293	    )

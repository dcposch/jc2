   429	AffineBit = tuple[int, int]  # coefficient mask, constant
   430	
   431	
   432	def bit_parity(value: int) -> int:
   433	    return bin(value).count("1") & 1
   434	
   435	
   436	def affine_xor(*forms: AffineBit) -> AffineBit:
   437	    mask = 0
   438	    constant = 0
   439	    for form_mask, form_constant in forms:
   440	        mask ^= form_mask
   441	        constant ^= form_constant
   442	    return mask, constant
   443	
   444	
   445	def scale_affine(bit: int, form: AffineBit) -> AffineBit:
   446	    return form if bit else (0, 0)
   447	
   448	
   449	def bit_lift_equations(quotient: tuple[int, ...], word: BraidWord) -> tuple[tuple[int, int], ...]:
   450	    colors = list(quotient)
   451	    forms: list[AffineBit] = [(1 << index, 0) for index in range(len(quotient))]
   452	    for generator in word:
   453	        index = abs(generator) - 1
   454	        first_color, second_color = colors[index], colors[index + 1]
   455	        first_form, second_form = forms[index], forms[index + 1]
   456	        if generator > 0:
   457	            alpha, beta, gamma = AFFINE_CONJUGATION[(first_color, second_color)]
   458	            conjugated = affine_xor(scale_affine(alpha, first_form), scale_affine(beta, second_form), (0, gamma))
   459	            colors[index], colors[index + 1] = (2 * first_color - second_color) % 3, first_color
   460	            forms[index], forms[index + 1] = conjugated, first_form
   461	        else:
   462	            alpha, beta, gamma = AFFINE_CONJUGATION[(second_color, first_color)]
   463	            conjugated = affine_xor(scale_affine(alpha, second_form), scale_affine(beta, first_form), (0, gamma))
   464	            colors[index], colors[index + 1] = second_color, (2 * second_color - first_color) % 3
   465	            forms[index], forms[index + 1] = second_form, conjugated
   466	    require(tuple(colors) == quotient, "fixed Fox coloring before lift")
   467	    return tuple(affine_xor(forms[index], (1 << index, 0)) for index in range(len(quotient)))
   468	
   469	
   470	def affine_f2_solutions(variable_count: int, equations: tuple[tuple[int, int], ...]) -> tuple[int, ...]:
   471	    rows = [mask | (constant << variable_count) for mask, constant in equations]
   472	    pivot_for_column: dict[int, int] = {}
   473	    pivot_row = 0
   474	    for column in range(variable_count):
   475	        selected = next((row for row in range(pivot_row, len(rows)) if (rows[row] >> column) & 1), None)
   476	        if selected is None:
   477	            continue
   478	        rows[pivot_row], rows[selected] = rows[selected], rows[pivot_row]
   479	        for row in range(len(rows)):
   480	            if row != pivot_row and ((rows[row] >> column) & 1):
   481	                rows[row] ^= rows[pivot_row]
   482	        pivot_for_column[column] = pivot_row
   483	        pivot_row += 1
   484	    variable_mask = (1 << variable_count) - 1
   485	    require(not any((row & variable_mask) == 0 and ((row >> variable_count) & 1) for row in rows), "consistent V4 lift equations")
   486	    free = [column for column in range(variable_count) if column not in pivot_for_column]
   487	    solutions: list[int] = []
   488	    for free_assignment in range(1 << len(free)):
   489	        solution = 0
   490	        for position, column in enumerate(free):
   491	            if (free_assignment >> position) & 1:
   492	                solution |= 1 << column
   493	        for column, row_index in reversed(tuple(pivot_for_column.items())):
   494	            row = rows[row_index]
   495	            right = (row >> variable_count) & 1
   496	            parity = bit_parity(row & variable_mask & solution)
   497	            if right ^ parity:
   498	                solution |= 1 << column
   499	        require(all(bit_parity(mask & solution) == constant for mask, constant in equations), "V4 lift solution")
   500	        solutions.append(solution)
   501	    return tuple(solutions)
   502	
   503	
   504	def affine_f2_solution_count(variable_count: int, equations: tuple[tuple[int, int], ...]) -> int:
   505	    rows = [mask | (constant << variable_count) for mask, constant in equations]
   506	    rank = 0
   507	    for column in range(variable_count):
   508	        selected = next((row for row in range(rank, len(rows)) if (rows[row] >> column) & 1), None)
   509	        if selected is None:
   510	            continue
   511	        rows[rank], rows[selected] = rows[selected], rows[rank]
   512	        for row in range(len(rows)):
   513	            if row != rank and ((rows[row] >> column) & 1):
   514	                rows[row] ^= rows[rank]
   515	        rank += 1
   516	    variable_mask = (1 << variable_count) - 1
   517	    require(not any((row & variable_mask) == 0 and ((row >> variable_count) & 1) for row in rows), "consistent V4 lift equations")
   518	    return 1 << (variable_count - rank)
   519	
   520	
   521	def lifted_full_s4_colorings(
   522	    strands: int, word: BraidWord, *, validate_groups: bool = False
   523	) -> tuple[int, int, int]:
   524	    fox_colorings = fox_fixed_colorings(strands, word)
   525	    full = 0
   526	    lifts = 0
   527	    nonconstant_fox = 0
   528	    for quotient in fox_colorings:
   529	        if len(set(quotient)) == 1:
   530	            continue
   531	        nonconstant_fox += 1
   532	        equations = bit_lift_equations(quotient, word)
   533	        solution_count = affine_f2_solution_count(strands, equations)
   534	        require(solution_count >= 4, "four complement lifts exist")
   535	        if not validate_groups:
   536	            lifts += solution_count
   537	            full += solution_count - 4
   538	            continue
   539	        solutions = affine_f2_solutions(strands, equations)
   540	        require(len(solutions) == solution_count, "enumerated affine lift-space size")
   541	        local_full = 0
   542	        for solution in solutions:
   543	            lifts += 1
   544	            colors = tuple(COORD_TO_TRANS[(quotient[index], (solution >> index) & 1)] for index in range(strands))
   545	            # Independent closure check uses the original S4 Hurwitz action.
   546	            require(CORE.braid_action(colors, word) == colors, "lifted S4 coloring closes")
   547	            if len(CORE.generated_subgroup(colors)) == 24:
   548	                full += 1
   549	                local_full += 1
   550	        # A nonconstant Fox coloring is onto S3.  Its non-full lifts are
   551	        # exactly the four sections into the four point-stabilizer complements
   552	        # S3<S4.  Any other lift intersects V4 nontrivially; S3 permutes the
   553	        # three nonidentity elements of V4 transitively, so that lift is S4.
   554	        require(len(solutions) - local_full == 4, "four and only four complement lifts")
   555	    return full, len(fox_colorings), lifts
   556	
   557	
   558	def sign_vectors(stages: int) -> tuple[tuple[int, ...], ...]:
   559	    return tuple(itertools.product((-1, 1), repeat=stages))

   307	def transposition_coordinates() -> tuple[dict[Permutation, tuple[int, int]], dict[tuple[int, int], Permutation]]:
   308	    fibers: dict[int, list[Permutation]] = {color: [] for color in range(3)}
   309	    for permutation in CORE.TRANSPOSITIONS:
   310	        quotient = quotient_action(permutation)
   311	        fixed = [index for index, image in enumerate(quotient) if index == image]
   312	        require(len(fixed) == 1, "S4 transposition maps to S3 transposition")
   313	        fibers[fixed[0]].append(permutation)
   314	    require(all(len(fiber) == 2 for fiber in fibers.values()), "two transposition lifts per quotient color")
   315	    forward: dict[Permutation, tuple[int, int]] = {}
   316	    backward: dict[tuple[int, int], Permutation] = {}
   317	    for color, fiber in fibers.items():
   318	        for bit, permutation in enumerate(sorted(fiber)):
   319	            forward[permutation] = (color, bit)
   320	            backward[(color, bit)] = permutation
   321	    return forward, backward

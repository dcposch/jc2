   327	def affine_conjugation_table() -> dict[tuple[int, int], tuple[int, int, int]]:
   328	    """Return alpha,beta,gamma with bit(A B A)=alpha*a+beta*b+gamma."""
   329	
   330	    table: dict[tuple[int, int], tuple[int, int, int]] = {}
   331	    for first_color in range(3):
   332	        for second_color in range(3):
   333	            values: dict[tuple[int, int], int] = {}
   334	            output_colors = set()
   335	            for first_bit in range(2):
   336	                for second_bit in range(2):
   337	                    first = COORD_TO_TRANS[(first_color, first_bit)]
   338	                    second = COORD_TO_TRANS[(second_color, second_bit)]
   339	                    output = CORE.conjugate(first, second)
   340	                    output_color, output_bit = TRANS_TO_COORD[output]
   341	                    output_colors.add(output_color)
   342	                    values[(first_bit, second_bit)] = output_bit
   343	            require(output_colors == {(2 * first_color - second_color) % 3}, "Fox quotient conjugation")
   344	            gamma = values[(0, 0)]
   345	            alpha = values[(1, 0)] ^ gamma
   346	            beta = values[(0, 1)] ^ gamma
   347	            require(
   348	                all(values[(a, b)] == ((alpha & a) ^ (beta & b) ^ gamma) for a in range(2) for b in range(2)),
   349	                "affine V4 lift table",
   350	            )
   351	            table[(first_color, second_color)] = (alpha, beta, gamma)
   352	    return table
   353	
   354	
   355	AFFINE_CONJUGATION = affine_conjugation_table()

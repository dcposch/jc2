   357	
   358	def modular_rref(matrix: list[list[int]], modulus: int) -> tuple[list[list[int]], list[int]]:
   359	    values = [[entry % modulus for entry in row] for row in matrix]
   360	    if not values:
   361	        return values, []
   362	    rows, columns = len(values), len(values[0])
   363	    pivots: list[int] = []
   364	    pivot_row = 0
   365	    for column in range(columns):
   366	        selected = next((row for row in range(pivot_row, rows) if values[row][column]), None)
   367	        if selected is None:
   368	            continue
   369	        values[pivot_row], values[selected] = values[selected], values[pivot_row]
   370	        inverse = pow(values[pivot_row][column], -1, modulus)
   371	        values[pivot_row] = [(entry * inverse) % modulus for entry in values[pivot_row]]
   372	        for row in range(rows):
   373	            if row == pivot_row or values[row][column] == 0:
   374	                continue
   375	            factor = values[row][column]
   376	            values[row] = [(left - factor * right) % modulus for left, right in zip(values[row], values[pivot_row])]
   377	        pivots.append(column)
   378	        pivot_row += 1
   379	        if pivot_row == rows:
   380	            break
   381	    return values, pivots
   382	
   383	
   384	def fox_action_vector(colors: tuple[int, ...], generator: int) -> tuple[int, ...]:
   385	    index = abs(generator) - 1
   386	    result = list(colors)
   387	    first, second = result[index], result[index + 1]
   388	    if generator > 0:
   389	        result[index], result[index + 1] = (2 * first - second) % 3, first
   390	    else:
   391	        result[index], result[index + 1] = second, (2 * second - first) % 3
   392	    return tuple(result)
   393	
   394	
   395	def fox_fixed_basis(strands: int, word: BraidWord) -> tuple[tuple[int, ...], ...]:
   396	    columns: list[tuple[int, ...]] = []
   397	    for column in range(strands):
   398	        unit = tuple(1 if index == column else 0 for index in range(strands))
   399	        result = unit
   400	        for generator in word:
   401	            result = fox_action_vector(result, generator)
   402	        columns.append(result)
   403	    equations = [
   404	        [(columns[column][row] - (1 if row == column else 0)) % 3 for column in range(strands)]
   405	        for row in range(strands)
   406	    ]
   407	    rref, pivots = modular_rref(equations, 3)
   408	    free = [column for column in range(strands) if column not in pivots]
   409	    basis: list[tuple[int, ...]] = []
   410	    for free_column in free:
   411	        vector = [0] * strands
   412	        vector[free_column] = 1
   413	        for row, pivot in enumerate(pivots):
   414	            vector[pivot] = (-rref[row][free_column]) % 3
   415	        basis.append(tuple(vector))
   416	    require(all(all(sum(equations[row][column] * vector[column] for column in range(strands)) % 3 == 0 for row in range(strands)) for vector in basis), "Fox nullspace basis")
   417	    return tuple(basis)
   418	
   419	
   420	def fox_fixed_colorings(strands: int, word: BraidWord) -> tuple[tuple[int, ...], ...]:
   421	    basis = fox_fixed_basis(strands, word)
   422	    result = []
   423	    for coefficients in itertools.product(range(3), repeat=len(basis)):
   424	        vector = tuple(sum(coefficient * basis[index][column] for index, coefficient in enumerate(coefficients)) % 3 for column in range(strands))
   425	        result.append(vector)
   426	    return tuple(result)

   209	def recursive_alexander_polynomial(sequence: tuple[int, ...]):
   210	    if len(sequence) == 2:
   211	        return torus_alexander(sequence[1], sequence[0])
   212	    winding = prefix_gcd(sequence[:-1])
   213	    prefix = tuple(value // winding for value in sequence[:-1])
   214	    return torus_alexander(winding, sequence[-1]) * CORE.substitute_power(
   215	        recursive_alexander_polynomial(prefix), winding
   216	    )

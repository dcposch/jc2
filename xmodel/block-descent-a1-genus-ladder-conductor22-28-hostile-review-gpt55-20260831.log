   161	def dense_polynomial(values: dict[int, int]) -> list[int]:
   162	    maximum = max(values, default=0)
   163	    result = [values.get(power, 0) for power in range(maximum + 1)]
   164	    while len(result) > 1 and result[-1] == 0:
   165	        result.pop()
   166	    return result
   167	
   168	
   169	def polynomial_multiply(left: list[int], right: list[int]) -> list[int]:
   170	    result = [0] * (len(left) + len(right) - 1)
   171	    for left_power, left_value in enumerate(left):
   172	        for right_power, right_value in enumerate(right):
   173	            result[left_power + right_power] += left_value * right_value
   174	    return dense_polynomial(dict(enumerate(result)))
   175	
   176	
   177	def polynomial_divide_exact(numerator: list[int], denominator: list[int]) -> list[int]:
   178	    require(denominator and denominator[-1] in (-1, 1), "monic exact polynomial divisor")
   179	    remainder = numerator[:]
   180	    quotient = [0] * max(1, len(numerator) - len(denominator) + 1)
   181	    while len(remainder) >= len(denominator) and any(remainder):
   182	        shift = len(remainder) - len(denominator)
   183	        require(remainder[-1] % denominator[-1] == 0, "exact polynomial leading division")
   184	        coefficient = remainder[-1] // denominator[-1]
   185	        quotient[shift] += coefficient
   186	        for power, value in enumerate(denominator):
   187	            remainder[shift + power] -= coefficient * value
   188	        while len(remainder) > 1 and remainder[-1] == 0:
   189	            remainder.pop()
   190	    require(not any(remainder), "exact polynomial remainder")
   191	    return dense_polynomial(dict(enumerate(quotient)))
   192	
   193	
   194	def torus_alexander(first: int, second: int):
   195	    first, second = abs(first), abs(second)
   196	    require(math.gcd(first, second) == 1, "primitive torus Alexander polynomial")
   197	    numerator = polynomial_multiply(
   198	        dense_polynomial({0: 1, first * second: -1}),
   199	        dense_polynomial({0: 1, 1: -1}),
   200	    )
   201	    denominator = polynomial_multiply(
   202	        dense_polynomial({0: 1, first: -1}),
   203	        dense_polynomial({0: 1, second: -1}),
   204	    )
   205	    quotient = polynomial_divide_exact(numerator, denominator)
   206	    return CORE.Laurent.from_dict(dict(enumerate(quotient)))
   207	

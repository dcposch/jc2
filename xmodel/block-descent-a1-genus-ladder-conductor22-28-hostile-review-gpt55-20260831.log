   299	def quotient_action(permutation: Permutation) -> Permutation:
   300	    images = []
   301	    for partition in PARTITIONS:
   302	        image = frozenset(frozenset(permutation[value] for value in pair) for pair in partition)
   303	        images.append(PARTITIONS.index(image))
   304	    return tuple(images)

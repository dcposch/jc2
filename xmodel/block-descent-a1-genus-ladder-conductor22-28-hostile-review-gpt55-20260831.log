   219	def integer_determinant(matrix: list[list[int]]) -> int:
   220	    """Fraction-free Bareiss determinant over Z."""
   221	
   222	    size = len(matrix)
   223	    if size == 0:
   224	        return 1
   225	    values = [row[:] for row in matrix]
   226	    sign = 1
   227	    denominator = 1
   228	    for pivot_index in range(size - 1):
   229	        if values[pivot_index][pivot_index] == 0:
   230	            swap = next((row for row in range(pivot_index + 1, size) if values[row][pivot_index]), None)
   231	            if swap is None:
   232	                return 0
   233	            values[pivot_index], values[swap] = values[swap], values[pivot_index]
   234	            sign = -sign
   235	        pivot = values[pivot_index][pivot_index]
   236	        for row in range(pivot_index + 1, size):
   237	            for column in range(pivot_index + 1, size):
   238	                numerator = values[row][column] * pivot - values[row][pivot_index] * values[pivot_index][column]
   239	                require(numerator % denominator == 0, "Bareiss exact division")
   240	                values[row][column] = numerator // denominator
   241	        denominator = pivot
   242	        for row in range(pivot_index + 1, size):
   243	            values[row][pivot_index] = 0
   244	    return sign * values[-1][-1]
   245	
   246	
   247	def integer_matrix_multiply(left: list[list[int]], right: list[list[int]]) -> list[list[int]]:
   248	    return [
   249	        [sum(left[row][middle] * right[middle][column] for middle in range(len(right))) for column in range(len(right[0]))]
   250	        for row in range(len(left))
   251	    ]
   252	
   253	
   254	def burau_at_minus_one(strands: int, word: BraidWord) -> list[list[int]]:
   255	    matrix = [[1 if row == column else 0 for column in range(strands)] for row in range(strands)]
   256	    for generator in word:
   257	        index = abs(generator) - 1
   258	        block = ((2, -1), (1, 0)) if generator > 0 else ((0, 1), (-1, 2))
   259	        factor = [[1 if row == column else 0 for column in range(strands)] for row in range(strands)]
   260	        for row_offset in range(2):
   261	            for column_offset in range(2):
   262	                factor[index + row_offset][index + column_offset] = block[row_offset][column_offset]
   263	        matrix = integer_matrix_multiply(matrix, factor)
   264	    return [
   265	        [matrix[row][column] - matrix[strands - 1][column] for column in range(strands - 1)]
   266	        for row in range(strands - 1)
   267	    ]
   268	
   269	
   270	def braid_alexander_determinant(strands: int, word: BraidWord) -> int:
   271	    reduced = burau_at_minus_one(strands, word)
   272	    difference = [
   273	        [(1 if row == column else 0) - reduced[row][column] for column in range(strands - 1)]
   274	        for row in range(strands - 1)
   275	    ]
   276	    numerator = 2 * integer_determinant(difference)
   277	    denominator = 1 - (-1) ** strands
   278	    if denominator:
   279	        require(numerator % denominator == 0, "Alexander numerator division at -1")
   280	        return abs(numerator // denominator)
   281	    # For even strand count both numerator and 1-t^n vanish at -1.  The
   282	    # determinant of a knot can instead be read from any odd Markov
   283	    # stabilization, which preserves closure and Alexander polynomial.
   284	    stabilized = word + (strands,)
   285	    return braid_alexander_determinant(strands + 1, stabilized)

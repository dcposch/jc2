   561	
   562	def main() -> int:
   563	    parser = argparse.ArgumentParser()
   564	    parser.add_argument("--mutate-framing", action="store_true")
   565	    parser.add_argument("--mutate-quotient", action="store_true")
   566	    parser.add_argument("--mutate-promote-zero", action="store_true")
   567	    arguments = parser.parse_args()
   568	
   569	    if arguments.mutate_framing:
   570	        globals()["writhe"] = lambda word: 0
   571	    if arguments.mutate_quotient:
   572	        AFFINE_CONJUGATION[(0, 1)] = (0, 0, 0)
   573	
   574	    # Together with the already sealed conductors 10 and 16, this is the
   575	    # complete even-conductor ladder through 28.
   576	    conductors = (12, 14, 18, 20, 22, 24, 26, 28)
   577	    censuses = {conductor: CORE.delta_sequences_with_conductor(conductor, False, False) for conductor in conductors}
   578	
   579	    # Compiler controls: the winding-two specialization must be byte-for-byte
   580	    # the previously sealed compiler; every signed compiled closure is a knot;
   581	    # and the braid determinant equals the recursive cable formula.
   582	    old_two_cable = CORE.two_cable_of_two_braid_word(3, 7)
   583	    new_strands, new_two_cable = compile_delta_sequence((6, 4, 7))
   584	    require(new_strands == 4 and new_two_cable == old_two_cable, "winding-two compiler specialization")
   585	
   586	    compiler_controls: dict[str, dict[str, int]] = {}
   587	    all_rows = tuple(sequence for conductor in conductors for sequence in censuses[conductor])
   588	    for sequence in all_rows:
   589	        expected_determinant = recursive_alexander_determinant(sequence)
   590	        sign_counts = []
   591	        for signs in sign_vectors(len(sequence) - 1):
   592	            strands, word = compile_delta_sequence(sequence, signs)
   593	            require(strands == sequence[1], "compiled strand count equals r1")
   594	            require(CORE.cycle_lengths(CORE.strand_permutation(strands, word)) == (strands,), "compiled braid closes to one knot")
   595	            require(braid_alexander_determinant(strands, word) == expected_determinant, "recursive Alexander determinant")
   596	            sign_counts.append((signs, strands, len(word)))
   597	        compiler_controls[str(sequence)] = {
   598	            "signed_variants": len(sign_counts),
   599	            "strands": sequence[1],
   600	            "alexander_determinant": expected_determinant,
   601	        }
   602	
   603	    # Exact full-polynomial controls cover a base 3-braid, winding two, and
   604	    # winding three, with every independent sign choice.  These are stronger
   605	    # than the determinant checks above and catch the blackboard-framing term.
   606	    full_alexander_controls: dict[str, int] = {}

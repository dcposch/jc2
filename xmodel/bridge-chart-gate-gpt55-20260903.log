+        "  int i;",
+        "  poly v;",
+        "  for (i=LO; i<=HI; i++)",
+        "  {",
+        "    v=getAt(B0,i);",
+        "    if (v!=0) { R=addAt(R,i,v); }",
+        "  }",
+        "  return(R);",
+        "}",
+        "proc hshift(list A0, int delta)",
+        "{",
+        "  list R;",
+        "  int i;",
+        "  poly v;",
+        "  for (i=LO; i<=HI; i++)",
+        "  {",

+        return {k: sp.expand(scalar * v) for k, v in series.items() if sp.expand(scalar * v) != 0}
+
+    @staticmethod
+    def shift(series: dict[int, sp.Expr], delta: int) -> dict[int, sp.Expr]:
+        return {k + delta: v for k, v in series.items()}

+            variables.append(f"q{j}_{name}")
+    zero_a = [t, e - 1, e]
+    free_a = []
+    for k in range(1, e + 1):
+        if k not in zero_a:
+            variables.append(f"a{k}")
+            free_a.append(k)
+    return variables, free_a, zero_a

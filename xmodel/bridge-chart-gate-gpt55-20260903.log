+    target = sp.expand(expr - sum(coeff * phi for coeff, phi in zip(coeffs, phis)))
+    equations = sp.Poly(target, gamma, pi).coeffs()
+    sol = sp.solve(equations, coeffs, dict=True)
+    return bool(sol)

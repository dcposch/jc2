+        by_power={k: v for k, v in by_power.items() if v != 0},
+        tagged=tagged,
+        equations=equations,
+        gauges={"a_zero": [t, e - 1, e], "a_free": free_a},
+        elapsed_build_seconds=time.monotonic() - started,
+    )
+
+
+def bridge_dict(data: BridgeData) -> dict:
+    return {
+        "t": data.t,
+        "e": data.e,
+        "q": data.q,
+        "h": data.h,
+        "A": data.A,
+        "B": data.B,

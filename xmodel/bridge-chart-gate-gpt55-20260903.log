+    def hpow_unit(self, w: dict[int, sp.Expr], exponent: sp.Rational) -> dict[int, sp.Expr]:
+        if not all(power <= -2 for power in w):
+            raise AssertionError(f"unit tail has unexpected h-powers {sorted(w)}")

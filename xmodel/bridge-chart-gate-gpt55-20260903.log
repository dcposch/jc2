+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--t", type=int, required=True)
+    parser.add_argument("--characteristic", type=int, required=True)
+    parser.add_argument("--method", choices=["std", "slimgb"], default="std")

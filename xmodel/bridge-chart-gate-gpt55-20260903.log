+    free_a: list[int] = []
+    for k in range(1, e + 1):
+        if k in (t, e - 1, e):
+            avars[k] = sp.Integer(0)
+        else:
+            symbol = sp.Symbol(f"a{k}")
+            avars[k] = symbol
+            params.append(symbol)
+            free_a.append(k)

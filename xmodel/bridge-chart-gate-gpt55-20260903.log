+    q_nonnegative = H.hadd({q: sp.Integer(1)}, H.shift(u_ser, q))
+    q_nonnegative = {power: coeff for power, coeff in q_nonnegative.items() if power >= 0}
+    p_terms = hdict_to_terms(p_nonnegative)
+    q_terms = hdict_to_terms(q_nonnegative)

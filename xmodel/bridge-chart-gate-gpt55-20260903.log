+
+    return BridgeData(
+        t=t,
+        e=e,
+        q=q,
+        n=n,
+        m=m,
+        h=H.h,
+        A=H.A,
+        B=H.B,
+        z=H.z,
+        params=params[:-1],
+        c=c,

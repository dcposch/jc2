+class Hadic:
+    def __init__(self, t: int):
+        self.t = t
+        self.e = 3 * t + 1
+        self.q = 2 * t + 1
+        self.b1, self.b2, self.b3, self.b4 = sp.symbols("b1 b2 b3 b4")

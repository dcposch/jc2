+            f"Tk=hshift(Tk,{e-k});",
+            f"Tk=hscal(Tk,{ak});",
+            "Pser=hadd(Pser,Tk);",
+        ])
+    lines.extend([
+        "list Qser;",
+        f"Qser=addAt(Qser,{q},1);",
+        f"Qser=hadd(Qser,hshift(U,{q}));",
+        "list By;",
+        "int rp; int spow; poly aa; poly bb; poly first; poly second;",
+        f"for (rp=0; rp<={q}; rp++)",

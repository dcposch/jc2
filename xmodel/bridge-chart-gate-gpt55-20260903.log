+        self.z = pi - gamma
+        self.B = sp.expand(pi * self.z + self.b1 * pi + self.b2)
+        self.A = sp.expand(pi * self.B + self.b3)
+        self.h = sp.expand(pi * self.A + self.b4)
+        self.h_poly = sp.Poly(self.h, pi)
+        self.lo = -(self.e + 3)

+def build_bridge(t: int, include_jacobian: bool = True) -> BridgeData:
+    if t < 1:
+        raise ValueError("t must be positive")
+    started = time.monotonic()
+    H = Hadic(t)
+    e, q = H.e, H.q
+    n, m = 12 * t + 4, 8 * t + 4
+    params: list[sp.Symbol] = [H.b1, H.b2, H.b3, H.b4]

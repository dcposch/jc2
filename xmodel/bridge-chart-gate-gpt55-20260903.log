+def subset_audit(ts: Iterable[int]) -> dict:
+    order = load_module(ORDER, "bridgegate_order_chart")
+    records = []
+    for t in ts:
+        H = Hadic(t)
+        e, q = H.e, H.q
+        order_spaces = order.chart_spaces(t, sp.Integer(1), H.A, H.B, H.z)
+        alpha_failures = []
+        beta_failures = []

        ' else { print("CONTROL_RAC_EMPTY_FAIL"); }',
        "ideal RACN=gamma-1,pi*gamma-1;",
        "ideal RACGN=std(RACN);",
        'if (typeof(RACGN)=="ideal" && reduce(1,RACGN)!=0)'
        ' { print("CONTROL_RAC_NONEMPTY_PASS"); }'
        ' else { print("CONTROL_RAC_NONEMPTY_FAIL"); }',

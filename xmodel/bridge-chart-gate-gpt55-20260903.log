+        "    D=division(cur,Hstd);",
+        "    quo=D[1][1,1];",
+        "    rem=D[2][1];",
+        "    if (rem!=0) { S=addAt(S,power,rem); }",
+        "    if (quo==0) { return(S); }",
+        "    cur=quo;",
+        "    power++;",
+        "  }",
+        "  return(S);",
+        "}",
+        "proc hadd(list A0, list B0)",
+        "{",
+        "  list R=A0;",
+        "  int i;",
+        "  poly v;",
+        "  for (i=LO; i<=HI; i++)",
+        "  {",
+        "    v=getAt(B0,i);",
+        "    if (v!=0) { R=addAt(R,i,v); }",
+        "  }",
+        "  return(R);",
+        "}",
+        "proc hshift(list A0, int delta)",
+        "{",
+        "  list R;",
+        "  int i;",
+        "  poly v;",
+        "  for (i=LO; i<=HI; i++)",
+        "  {",
+        "    v=getAt(A0,i);",
+        "    if (v!=0) { R=addAt(R,i+delta,v); }",
+        "  }",
+        "  return(R);",
+        "}",
+        "proc hscal(list A0, poly scalar)",
+        "{",
+        "  list R;",
+        "  int i;",
+        "  poly v;",
+        "  for (i=LO; i<=HI; i++)",
+        "  {",
+        "    v=getAt(A0,i);",
+        "    if (v!=0) { R=addAt(R,i,scalar*v); }",
+        "  }",
+        "  return(R);",
+        "}",
+        "proc hmul(list A0, list B0)",

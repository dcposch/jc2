+    def red(self, expr: sp.Expr) -> dict[int, sp.Expr]:
+        out: dict[int, sp.Expr] = {}
+        cur = sp.Poly(sp.expand(expr), pi)
+        h_poly = self.h_poly
+        i = 0
+        while True:
+            if cur.is_zero:

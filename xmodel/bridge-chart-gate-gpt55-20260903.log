+        "  list Red;",
+        "  for (i=LO; i<=HI; i++)",
+        "  {",
+        "    ai=getAt(A0,i);",
+        "    if (ai!=0)",
+        "    {",
+        "      for (j=LO; j<=HI; j++)",

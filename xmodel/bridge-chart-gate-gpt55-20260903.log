+def jac(left: sp.Expr, right: sp.Expr) -> sp.Expr:
+    return sp.diff(left, gamma) * sp.diff(right, pi) - sp.diff(left, pi) * sp.diff(right, gamma)
+
+
+@dataclasses.dataclass
+class BridgeData:
+    t: int
+    e: int
+    q: int
+    n: int

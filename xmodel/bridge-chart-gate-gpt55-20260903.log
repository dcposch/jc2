+        "    }",
+        "  }",
+        "  return(R);",
+        "}",
+        "proc hpowUnit(list U, number exponent)",
+        "{",
+        "  list Res; list Term;",
+        "  Res=addAt(Res,0,1);",
+        "  Term=addAt(Term,0,1);",

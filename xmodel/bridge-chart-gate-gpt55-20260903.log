+            if remainder == 0:
+                continue
+            poly = sp.Poly(remainder, gamma, pi)
+            for monomial, coefficient in poly.terms():
+                coefficient = sp.expand(coefficient)
+                if coefficient != 0:
+                    equations.append(coefficient)
+                    tagged.append((h_power, tuple(monomial), coefficient))

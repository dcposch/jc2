+                if not in_span(data.alpha[i], order_spaces[i]):
+                    alpha_failures.append(i)
+        for j in range(2, q + 1):
+            beta_j = sp.expand(sum(sp.Symbol(f"q{j}_{name}") * phi for name, phi in H.basis(j)))

+    def basis(self, deficit: int) -> list[tuple[str, sp.Expr]]:
+        if deficit <= self.t:
+            return [("1", sp.Integer(1))]
+        if deficit <= 2 * self.t:
+            return [("1", sp.Integer(1)), ("A", self.A)]
+        if deficit <= 3 * self.t:

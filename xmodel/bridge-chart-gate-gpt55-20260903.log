+    def hmul(self, left: dict[int, sp.Expr], right: dict[int, sp.Expr], lo: int | None = None) -> dict[int, sp.Expr]:
+        if lo is None:
+            lo = self.lo
+        raw: dict[int, sp.Expr] = {}
+        for i, u in left.items():
+            for j, v in right.items():

+    @staticmethod
+    def hadd(*args: dict[int, sp.Expr]) -> dict[int, sp.Expr]:
+        out: dict[int, sp.Expr] = {}
+        for item in args:
+            for power, expr in item.items():
+                out[power] = sp.expand(out.get(power, 0) + expr)
+        return {k: v for k, v in out.items() if v != 0}

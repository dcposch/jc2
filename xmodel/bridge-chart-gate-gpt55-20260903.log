+    if method not in {"std", "slimgb"}:
+        raise ValueError(method)
+    e, q = 3 * t + 1, 2 * t + 1
+    variables, free_a, zero_a = bridge_variables(t)
+    build_vars = ["p", "g"] + variables + ["c", "Tr"]
+    final_vars = variables + ["c", "Tr"]

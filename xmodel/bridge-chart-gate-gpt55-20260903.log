+        "}",
+        "proc hshift(list A0, int delta)",
+        "{",
+        "  list R;",
+        "  int i;",
+        "  poly v;",
+        "  for (i=LO; i<=HI; i++)",
+        "  {",
+        "    v=getAt(A0,i);",

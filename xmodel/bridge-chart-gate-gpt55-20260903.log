+def write_preprocessed(t: int, characteristics: list[int], max_seconds: float, max_bytes: int) -> dict:
+    data, reduction, tp = bridge_reduction(t, max_seconds=max_seconds, max_bytes=max_bytes)
+    out_dir = HERE / f"t{t}"

+HERE = ROOT / "box/bridgegate-20260903"
+INPUTS = pathlib.Path("/tmp/jc2-lane.VZaWdW/inputs")
+ORDER = INPUTS / "t_order_system.py"
+TRIANGULAR = INPUTS / "triangular_preprocess.py"
+FALLACY = INPUTS / "FALLACY-v2.md"
+

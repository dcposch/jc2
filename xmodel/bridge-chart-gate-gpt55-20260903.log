+    q_series: dict[int, sp.Expr]
+    by_power: dict[int, sp.Expr]
+    tagged: list[tuple[int, tuple[int, int], sp.Expr]]
+    equations: list[sp.Expr]
+    gauges: dict[str, list[int]]
+    elapsed_build_seconds: float

+        "stdout": str(out_path.relative_to(ROOT)),
+        "stderr": str(err_path.relative_to(ROOT)),
+        "resource": str(resource_path.relative_to(ROOT)),
+        "returncode": returncode,
+        "timed_out": timed_out,
+        "wall_seconds_driver": round(elapsed, 3),
+        "verdict": verdict,

+        coefficient = sp.Integer(coefficient)
+        pieces = []
+        for variable, exponent in zip(variables, monomial):
+            if exponent == 1:
+                pieces.append(str(variable))
+            elif exponent > 1:
+                pieces.append(f"{variable}^{exponent}")

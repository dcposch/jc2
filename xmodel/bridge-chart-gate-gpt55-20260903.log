+        term: dict[int, sp.Expr] = {0: sp.Integer(1)}
+        coef = sp.Integer(1)
+        for j in range(1, -2 * self.lo + 4):
+            term = self.hmul(term, w)
+            if not term:
+                break
+            coef = sp.Rational(coef) * (exponent - (j - 1)) / j
+            res = self.hadd(res, self.hscal(term, coef))
+        return res

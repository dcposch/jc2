+        output.write_text("\n".join(lines) + "\n", encoding="utf-8")
+        return
+    lines.extend([
+        f"ring R={characteristic},({','.join(final_vars)}),dp;",
+        "option(redSB);",
+        "ideal I=imap(RB,Icoeff);",

+            if cur.degree() < 4:
+                out[i] = sp.expand(cur.as_expr())
+                break
+            quotient, remainder = sp.div(cur, h_poly)
+            if not remainder.is_zero:
+                out[i] = sp.expand(remainder.as_expr())
+            cur = quotient
+            i += 1

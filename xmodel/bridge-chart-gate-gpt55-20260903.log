+def audit_chart(data: BridgeData) -> dict:
+    h_hist: dict[str, int] = {}
+    degree_hist: dict[str, int] = {}
+    variables = data.params + [data.c]
+    for h_power, _monomial, expr in data.tagged:
+        key = str(h_power)
+        h_hist[key] = h_hist.get(key, 0) + 1

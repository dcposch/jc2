+        "for (hp=0; hp<=HI; hp++)",
+        "{",
+        "  expr=getAt(By,hp);",
+        "  if (hp==0) { expr=expr-c*g; }",
+        "  addCoeffs(expr);",
+        "}",
+        "Icoeff[size(Icoeff)+1]=Tr*c-1;",
+        f'print("BUILD_DONE t={t} coeff_generators=");',
+        "coeff_count;",
+    ])
+    if build_only:
+        lines.extend([
+            f'print("BUILD_ONLY total_generators_with_Tr=");',
+            "size(Icoeff);",
+            f'print("UNKNOWNS_INCLUDING_C {len(variables)+1}");',
+            "quit;",
+        ])

+        "        second=spow*bb*J(aa,h)+rp*aa*J(h,bb);",
+        "        if (second!=0) { By=addAt(By,rp+spow-1,second); }",
+        "      }",
+        "    }",
+        "  }",
+        "}",
+        "int hp; poly expr; poly quo; poly rem; list D;",
+        f"for (hp=0; hp<={e+q+20}; hp++)",
+        "{",
+        "  expr=getAt(By,hp);",
+        "  if (expr!=0)",

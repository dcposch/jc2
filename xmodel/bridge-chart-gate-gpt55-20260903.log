+
+        max_power = max(by_power) if by_power else 0
+        for power in range(0, max_power + 5):
+            expr = sp.expand(by_power.get(power, 0))
+            quotient, remainder = sp.div(expr, H.h, pi)
+            by_power[power] = sp.expand(remainder)
+            if quotient != 0:

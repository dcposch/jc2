+        "        bj=getAt(B0,j);",
+        "        if ((bj!=0) && (i+j>=LO-1) && (i+j<=HI))",
+        "        {",
+        "          Red=hred(ai*bj);",
+        "          for (d=0; d<=8; d++)",
+        "          {",
+        "            rd=getAt(Red,d);",
+        "            if ((rd!=0) && (i+j+d>=LO) && (i+j+d<=HI)) { R=addAt(R,i+j+d,rd); }",
+        "          }",
+        "        }",
+        "      }",
+        "    }",
+        "  }",
+        "  return(R);",
+        "}",
+        "proc hpowUnit(list U, number exponent)",
+        "{",
+        "  list Res; list Term;",
+        "  Res=addAt(Res,0,1);",
+        "  Term=addAt(Term,0,1);",

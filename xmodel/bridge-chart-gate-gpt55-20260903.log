+
+    return BridgeData(
+        t=t,
+        e=e,
+        q=q,
+        n=n,
+        m=m,
+        h=H.h,
+        A=H.A,
+        B=H.B,
+        z=H.z,
+        params=params[:-1],
+        c=c,
+        beta=beta,
+        alpha=alpha,
+        p_terms=p_terms,
+        q_terms=q_terms,
+        p_series=p_series,
+        q_series=q_series,
+        by_power={k: v for k, v in by_power.items() if v != 0},
+        tagged=tagged,
+        equations=equations,
+        gauges={"a_zero": [t, e - 1, e], "a_free": free_a},
+        elapsed_build_seconds=time.monotonic() - started,

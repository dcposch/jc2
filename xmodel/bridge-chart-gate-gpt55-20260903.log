+    by_power: dict[int, sp.Expr] = {}
+    for aa, r in q_terms:
+        for bb, s in p_terms:
+            first = jac(aa, bb)
+            if first:
+                by_power[r + s] = by_power.get(r + s, 0) + first
+            second = s * bb * jac(aa, H.h) + r * aa * jac(H.h, bb)
+            if second:
+                by_power[r + s - 1] = by_power.get(r + s - 1, 0) + second

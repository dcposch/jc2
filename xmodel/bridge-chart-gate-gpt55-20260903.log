+def check_expected() -> dict[str, str]:
+    out = {}
+    for name, expected in EXPECTED.items():
+        path = INPUTS / name
+        actual = sha256_file(path)
+        if actual != expected:
+            raise RuntimeError(f"frozen hash mismatch for {name}: {actual}")
+        out[name] = actual
+    return out

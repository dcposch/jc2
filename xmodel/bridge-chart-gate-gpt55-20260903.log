+    p_pre.add_argument("--characteristic", type=int, nargs="+", default=[0])
+    p_pre.add_argument("--max-seconds", type=float, default=900.0)
+    p_pre.add_argument("--max-bytes", type=int, default=60_000_000)
+
+    p_run = sub.add_parser("run")

+        "    rem=D[2][1];",
+        "    By[hp+OFFSET]=rem;",
+        "    if (quo!=0) { By=addAt(By,hp+1,quo); }",
+        "  }",
+        "}",
+        "ideal Icoeff;",
+        "int coeff_count=0;",
+        "proc addCoeffs(poly f)",
+        "{",
+        "  if (f==0) { return(); }",
+        "  matrix Cp=coef(f,p);",
+        "  int i; int j;",

+
+def bridge_dict(data: BridgeData) -> dict:
+    return {
+        "t": data.t,
+        "e": data.e,
+        "q": data.q,
+        "h": data.h,
+        "A": data.A,
+        "B": data.B,
+        "z": data.z,
+        "params": data.params,
+        "c": data.c,
+        "tagged": data.tagged,
+        "equations": data.equations,
+    }

+    p_series = dict(p_nonnegative)
+    q_series = dict(q_nonnegative)
+    alpha = {i: sp.expand(p_series.get(e - i, 0)) for i in range(1, e + 1)}
+
+    return BridgeData(
+        t=t,
+        e=e,
+        q=q,
+        n=n,
+        m=m,
+        h=H.h,
+        A=H.A,
+        B=H.B,
+        z=H.z,
+        params=params[:-1],
+        c=c,
+        beta=beta,
+        alpha=alpha,
+        p_terms=p_terms,
+        q_terms=q_terms,
+        p_series=p_series,

                "new_kernel_dimension": 15,
                "cumulative_dimension": 40,
            },
        ],
{
  "H": "z**2*(3*a + z)",
  "Omega0": "X=x^-1, Y=x^3*y; z=x*y",
  "ambient_localized_ring": "Q[a,T,...]/(T*a-1)",
  "band_recurrence": "E_n=sum_{r+s=n}((18-s)*diff(f_r,z)*g_s+(r-12)*f_r*diff(g_s,z))-c*[n=31]",
  "bands": [
    {
      "band": 0,
      "consistent": true,
      "data": "f0=H^6, g0=H^9",

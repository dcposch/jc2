+#!/usr/bin/env python3
+"""Exact localized leading-face system for Moh's radius-two branch B."""
+
+from __future__ import annotations
+
+import json
+
+import sympy as sp
+
+
+z, x, y = sp.symbols("z x y")
+a, k, q3, q2, q1, q0, T = sp.symbols("a k q3 q2 q1 q0 T")
+H = z**2 * (z + 3 * a)
+q = z**4 + q3 * z**3 + q2 * z**2 + q1 * z + q0

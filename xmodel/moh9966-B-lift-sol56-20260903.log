 import json
 import math
 from collections import Counter
+from fractions import Fraction
 from pathlib import Path
 
 import sympy as sp
@@ -163,10 +164,16 @@
 def main():
     fspace = strict_two_face_basis(66, 12, -2)
     gspace = strict_two_face_basis(99, 18, -3)

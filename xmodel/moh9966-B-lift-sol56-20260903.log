             "F": {"degree": 66, "nonstrict_dimension": 181, "strict_face_kernel_dimension": 146, "start_histogram": hist_f},
             "G": {"degree": 99, "nonstrict_dimension": 388, "strict_face_kernel_dimension": 336, "start_histogram": hist_g},

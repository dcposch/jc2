# T_X local = SigU + 42*41 ; delta_X = (T_X - 42 + r_X)/2
delta_X = lscale(lin(42*41 - 42, SigU=1, r_X=1), F(1, 2))
g_tree = ladd(ladd(lin(F(167*166, 2)), delta_Y, -1), delta_X, -1)


# ----------------------------------------------------------------------
def lin(const=F(0), **kw):
    d = {1: F(const)}
    for k, v in kw.items():
        d[k] = F(v)
    return d
def ladd(a, b, sb=1):
    d = dict(a)
    for k, v in b.items():
        d[k] = d.get(k, F(0)) + sb*v
    return d
def lscale(a, s):
    return {k: F(s)*v for k, v in a.items()}

# T_Y local (plain units) = 4890 + 126*125 + SigS/42

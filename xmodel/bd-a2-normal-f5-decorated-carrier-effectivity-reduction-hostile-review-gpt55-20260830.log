from fractions import Fraction
from itertools import product, combinations

def inv(A):
    n=len(A); M=[[Fraction(x) for x in row]+[Fraction(i==j) for j in range(n)] for i,row in enumerate(A)]
    for c in range(n):
        p=next(i for i in range(c,n) if M[i][c])
        M[c],M[p]=M[p],M[c]
        z=M[c][c]; M[c]=[x/z for x in M[c]]
        for i in range(n):
            if i"'!=c and M[i][c]:
                z=M[i][c]; M[i]=[x-z*y for x,y in zip(M[i],M[c])]
    return [row[n:] for row in M]

def cartan(kind,r):
    A=[[2 if i==j else 0 for j in range(r)] for i in range(r)]
    edges=[(i,i+1) for i in range(r-1)] if kind=='"'A' else ([(i,i+1) for i in range(r-3)]+[(r-3,r-2),(r-3,r-1)])
    for i,j in edges:A[i][j]=A[j][i]=-1
    return A

def comps(total,n,p=()):
    if n==1: yield p+(total,); return
    for x in range(total+1):yield from comps(total-x,n-1,p+(x,))

for kind, rs in [('A',range(1,10)),('D',range(4,10))]:
    for rr in rs:
        C=cartan(kind,rr); I=inv(C); got=[]
        for a in comps(3,rr):
            h=[sum(I[i][j]*a[j] for j in range(rr)) for i in range(rr)]
            q=sum(h[i]*a[i] for i in range(rr))
            if all(x.denominator==1 and x>0 for x in h) and q<=8:
                got.append((a,tuple(int(x) for x in h),int(q)))
        if got:
            print(kind+str(rr),got)

U=range(9)
def graph(state):
    ell=0
    if state=='smooth':
        cand=[frozenset(J) for J in combinations(U,5) if ell in J]
    elif state=='q6':
        I=set(range(1,7)); cand=[frozenset(J) for J in combinations(U,5) if ell not in J and len(set(J)&I)==3]
    else:
        I=set(range(1,5)); cand=[frozenset(J) for J in combinations(U,5) if ell not in J and len(set(J)&I)==2]
    edges=[(a,b) for a,b in combinations(cand,2) if len(a&b)==2]
    tri=sum(1 for a,b,c in combinations(cand,3) if len(a&b)==len(a&c)==len(b&c)==2)
    print(state,len(cand),len(edges),tri,2 if edges else 1)
for s in ('smooth','q6','q8'):graph(s)

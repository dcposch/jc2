import sympy as sp
Z=sp.symbols('Z')
a,b=sp.symbols('a b')
d=sp.Rational(3,2)*a/b
eta=sp.Function('eta')(Z)
s=sp.Function('s')(Z)
q=sp.Function('q')(Z)
r=sp.Function('r')(Z)
E=sp.Function('E')(Z)
dz=lambda f: sp.diff(f,Z)
etap=dz(eta); etapp=dz(etap); sp_=dz(s); qp=dz(q); rp=dz(r)
chi=eta+2*Z*etap
G=E-b*eta*chi
Phi=s*G/eta # should be -b s chi + sE/eta
E2G0 = (6*a*Z*eta**2*(3*eta + 4*Z*etap)*rp
    + 2*b*( eta**2*q + 10*Z*eta*etap*q + 4*Z**2*(etap**2 + eta*etapp)*q
            - 6*Z*eta**2*qp - 4*Z**2*eta*etap*qp )
    + 12*a*b*Z*eta**2*etap*( eta*etap - Z*etap**2 + Z*eta*etapp )
    + 2*d*Z*( 3*eta*s*sp_ - 2*(2*etap + Z*etapp)*s**2 ))
Del2 = (6*a*Z*eta**2*etap*dz(G)
    + 6*a*eta*( eta*etap - 3*Z*etap**2 + Z*eta*etapp )*G
    + d*( eta*dz(G**2) - 4*etap*G**2 ) + 8*d*Z*eta*G*rp + 4*Z*(q*dz(G) - qp*G)
    + (d/b)*( Phi*s + 2*Z*(Phi*sp_ - dz(Phi)*s) ))
EQ2=sp.expand(E2G0+Del2)
# collect by E and derivatives? Print simplified E-free by setting E=0 and maybe full minus E-free.
Efree=sp.simplify(EQ2.subs({E:0, dz(E):0}))
print('Efree simplified length', len(str(Efree)))
print(sp.factor(Efree))
LinE=sp.simplify(sp.expand(EQ2-Efree))
print('LinE length', len(str(LinE)))
print(sp.factor(LinE))

import sympy as sp
import sys
sys.path.insert(0,'/tmp/raykill')
from wall2 import *
al,be,ga,de,ep = sp.symbols('alpha beta gamma delta epshat')
def ray_sub(e): return {C:-b*(1+2*e)*A**2, R:S**2/(4*b*A**2), Q:3*a*S**2/(4*b**2*A)}
def actual(e,U):
    M=model(e,U,K=2); E=equations(M); sub=ray_sub(e)
    Rv, Qv = S**2/(4*b*A**2), 3*a*S**2/(4*b**2*A)
    dim = {A1: al*A, S1: be*S, Q1: ga*Qv, R1: de*Rv, C1g: ep*b*A**2}
    c1=sp.cancel(sp.expand(zc(E['EQ2'],tops(M)['EQ2']-1).subs(sub).subs(dim)))
    cf=[sp.factor(sp.diff(c1,v)) for v in (al,be,ga,de,ep)]
    print('e,U,n',e,U,M['n'])
    print('c1=', sp.factor(c1))
    print('coeffs=')
    for name,x in zip(['al','be','ga','de','ep'],cf): print(name, sp.factor(x))
    # candidate N2
    n=M['n']
    N2=(2*n-2*e-3)*al - 2*(3*n+2*e-4)*be + (4*n+2*e-5)*ga - (n-1)*de - ep
    F=sp.cancel(c1/N2)
    print('F=', sp.factor(F))
for cell in [(1,3),(1,5),(2,6),(2,8),(3,11),(4,14)]:
    actual(*cell)

sys.path.insert(0, '/tmp/raykill')
from wall2 import model, equations, zc, tops, A, A1, S, S1, Q, Q1, R, R1, C, C1g, a, b

# symbolic coefficient-row derivation, normalized by F = -3*a*A*S"'^2/(2*b)

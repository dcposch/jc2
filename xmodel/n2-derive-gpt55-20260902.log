alpha,beta,gamma,delta,epshat = sp.symbols('alpha beta gamma delta epshat')
vars_ = (alpha,beta,gamma,delta,epshat)
rows = {
    'r-family':      [-3*n, 0, 0, -(n-1), 0],
    'q-family':      [8*n + 4*e, 0, 4*n + 2*e - 5, 0, 0],
    's"'^2-family'"':    [-3*n - 2*e - 3, -2*(3*n + 2*e - 4), 0, 0, 0],
    'E1-family':     [-4*e, 0, 0, 0, -1],
}
derived = [sp.expand(sum(rows[name][i] for name in rows)) for i in range(5)]
measured = [2*n-2*e-3, -2*(3*n+2*e-4), 4*n+2*e-5, -(n-1), -1]

        )
        line = f"DIVERT path={args.file} status={result['status']}"
        print(f"{line} {detail}" if detail else line)
        return 0

    try:
        size, digest, basis = stamp_path(args.file, args.basis)
        print(
            f"STAMPED path={args.file} body_bytes={size} "

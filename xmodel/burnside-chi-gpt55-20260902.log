/bin/zsh -lc "python3 - <<'PY'
from itertools import permutations, combinations
from fractions import Fraction
from collections import defaultdict, Counter
import sympy as sp

# permutations as tuples image of 0..3; compose p*q means p after q
def compose(p,q): return tuple(p[i] for i in q)
def inv(p):
    r=[0]*len(p)
    for i,j in enumerate(p): r[j]=i
    return tuple(r)
e=tuple(range(4))
S=list(permutations(range(4)))

def cyc_type(p):
    seen=[False]*4; lens=[]
    for i in range(4):
        if not seen[i]:
            j=i; L=0
            while not seen[j]:
                seen[j]=True; L+=1; j=p[j]
            lens.append(L)
    return tuple(sorted(lens, reverse=True))

classes=defaultdict(list)
for g in S: classes[cyc_type(g)].append(g)
class_order=[(1,1,1,1),(2,1,1),(2,2),(3,1),(4,)]
print('classes')
for c in class_order: print(c, len(classes[c]))

# closure generated by a set
def subgroup(gens):
    H=set([e]); frontier=list(gens)
    while frontier:
        x=frontier.pop()
        if x not in H:
            H.add(x)
            # close under multiply with known H both sides
            for h in list(H):
                for y in (compose(x,h), compose(h,x)):
                    if y not in H: frontier.append(y)
    return frozenset(H)

subs=set([frozenset([e])])
# all generated by subsets of size <=2 enough for S4? include triples for safety
for r in range(1,5):
    for gens in combinations(S, r):
        subs.add(subgroup(gens))
print('num subgroups', len(subs))

# conjugacy classes of subgroups
unseen=set(subs); sub_classes=[]
while unseen:
    H=unseen.pop()
    conj=set()
    for g in S:
        gi=inv(g)
        K=frozenset(compose(compose(g,h),gi) for h in H)
        conj.add(K)
    sub_classes.append(sorted(conj, key=lambda x:(len(x), sorted(x)))[0])
    unseen-=conj

# classify names by order and element counts
def signature(H):
    cnt=Counter(cyc_type(h) for h in H)
    return (len(H), tuple((c,cnt[c]) for c in class_order))
sub_classes=sorted(sub_classes, key=lambda H:(len(H), signature(H)))
name_by_sig={
    (1, (1,0,0,0)):'1'
}
print('\\nsubgroup class rows')
rows=[]
s=sp.symbols('s1', integer=True)
f={ (1,1,1,1):12+6*s, (2,1,1):2*(1-s), (2,2):2*s, (3,1):0, (4,):0}
for H in sub_classes:
    cnt=Counter(cyc_type(h) for h in H)
    order=len(H); nt=cnt[(2,1,1)]; nv=cnt[(2,2)]; n3=cnt[(3,1)]; n4=cnt[(4,)]
    expr=sp.simplify(sum(cnt[c]*f[c] for c in class_order)/order)
    rows.append([order, nt, nv, n3, n4, expr])
    print(order, dict(cnt), '=>', expr, ' at s=4:', expr.subs(s,4))

M=sp.Matrix([[sp.Rational(Counter(cyc_type(h) for h in H)[c], len(H)) for c in class_order] for H in sub_classes])
print('\\nrow matrix rank all element classes:', M.rank())
print('rank on support e,T,V:', M[:,0:3].rank())

# source-hull boundary expression and comparison
chi2,sigma2,j=sp.symbols('chi2 sigma2 j')
boundary = (1-2*s-j)+(chi2-sigma2-j)+2*s+2*j+2*sigma2
print('boundary chi:', sp.expand(boundary), 'hull:', sp.expand(1+boundary))
point_expr=[r[-1] for r in rows if r[0]==6 and r[1]==3 and r[2]==0][0]
print('point row:', point_expr, 'point - hull:', sp.expand(point_expr-(1+boundary)))
PY" in /Users/dc/code/math/jc2

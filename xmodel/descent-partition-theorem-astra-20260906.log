+def leaf(n, m, H, birth, lam_f, rho):
+    n, m, H, birth, lam_f, rho = map(Q, (n, m, H, birth, lam_f, rho))
+    kap = rho * (H - birth) + lam_f
+    if kap > 0:
+        delta = H - (n + m) * kap / ((n + m) * rho - m)
+        lf = lam_f + rho * (delta - birth)
+        lg = n / m * lf

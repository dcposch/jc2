+assert hashlib.sha256(source.encode()).hexdigest() == '3fbb5bb885acbd7f50f307ac083a762020b7ca1158e18d06a84a0325b2a3dcc2'
+names = {'exact_int', 'prefix_gcds', 'def51_radii', 'inverse_top'}

+        if (21-V3) % e3.denominator == 0 and 7-e3*(21-V3) == 7:
+            possible.append((V3,'zero'))
+    assert possible == [(21,'zero')]
+    Vs = {2:3,3:21,4:3,5:2}
+    rr = def51_radii(168,Ms,ds,Vs)
+    assert rr[2] == Q(3,10)
+    # P2=42, A2=10, selected multiplicity=3; another orbit of multiplicity

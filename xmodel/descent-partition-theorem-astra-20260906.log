    94	            groups.append(dict(kind="nonzero", orbit=orbit,
    95	                               coefficient=coefficient, V=Q(multiplicity),
    96	                               roots=normalizer * multiplicity))
    97	    assert sum(g["roots"] for g in groups) == Q(us * n, ds)
    98	    return dict(source_p_degree=P, source_radius=delta,
    99	                child_growth=Q(us, 1) / delta - vs,
   100	                source_roots_per_coefficient=normalizer,
   101	                inverse_groups=groups)

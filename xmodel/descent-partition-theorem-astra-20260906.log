+    d = prefix_gcds(n, M)
+    parent_radii = def51_radii(n, M, d, V)
+    assert parent_radii[2] == birth
+    inv = inverse_top(n, d[3], d[2], 1, 3, birth, z, rs)
+    np, mp = n//4, m//4
+    Mc = {1:M[1]//4, 2:M[2]//4}

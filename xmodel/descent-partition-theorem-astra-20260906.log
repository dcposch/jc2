+
+def transverse(N, rho, e, delta, lf, lg, u=1, v=3):
+    N, rho, e, delta, lf, lg, u, v = map(Q, (N, rho, e, delta, lf, lg, u, v))
+    assert delta > e > 0
+    out = dict(discs=N*e, rho=rho, delta=v-u+u/e*(delta-1),

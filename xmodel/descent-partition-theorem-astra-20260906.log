+        candidates.append(dict(M=Mc,d=dc,radii=rc,A=A,P=P))
+assert [c['M'][3] for c in candidates] == [36,37,38,39,40]
+assert all(c['M'][2] == 35 and c['radii'][2] == Q(-1,3) for c in candidates)
+

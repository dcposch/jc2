    70	def inverse_top(n: int, ds: int, dprev: int, us: int, vs: int,
    71	                delta: Q, zero_multiplicity: int,
    72	                orbit_multiplicities: tuple[int, ...]) -> dict:
    73	    """Invert an explicit top p=xi^z product(xi^b-c)^r factor pattern.
    74	
    75	    One source b-orbit produces a CHILD COEFFICIENT DISC for each of a
    76	    inverse coefficients, with r*n/dprev roots in each.  Multiplication by
    77	    u_s is absent from this projection count; the gamma cover changes
    78	    exponents, not the degree in the root variable.
    79	    """
    80	    delta = Q(delta)
    81	    if delta <= 0:
    82	        raise ValueError("inverse_top requires a positive source radius")
    83	    a, b = delta.numerator, delta.denominator
    84	    P = exact_int(Q(vs * dprev, ds))
    85	    if zero_multiplicity < 0 or any(r <= 0 for r in orbit_multiplicities):
    86	        raise ValueError("invalid multiplicities")
    87	    if zero_multiplicity + b * sum(orbit_multiplicities) != P:

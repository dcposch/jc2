   344	def leading_form(poly):
   345	    from sympy import symbols, Poly, expand
   346	    x, y = symbols('x y')
   347	    P = Poly(expand(poly), x, y); D = P.total_degree()
   348	    return sum(c*x**mx*y**my for ((mx, my), c) in P.terms() if mx+my == D)

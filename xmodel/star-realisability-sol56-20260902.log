   174	def operator_scale(S) -> F:
   175	    """h with (n,m)=h(deg P_1,deg Q_1); hence D(n,m)=h D(degP,degQ)."""
   176	    A, B = bottom_bidegrees(S)
   177	    h = F(S.K, S.V[2])
   178	    if F(S.n, A) != h or F(S.m, B) != h:
   179	        raise AssertionError(
   180	            f"bottom operator weights are not proportional: {(S.n,S.m)} vs {(A,B)}"
   181	        )
   182	    return h

   269	    out = []
   270	    kmax = int(u // v) if v else 0
   271	    for k in range(1, kmax+1):
   272	        val = k*v*q
   273	        if val.denominator == 1:
   274	            iv = int(val)
   275	            if (Nlo is None or iv >= Nlo) and (Nhi is None or iv <= Nhi): out.append(iv)
   276	    return out

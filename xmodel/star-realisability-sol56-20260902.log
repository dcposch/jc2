   264	def achievable(S, Nlo=None, Nhi=None):
   265	    """Under (UNI) -- all bottom-major discs carry the same lower-V datum -- the pinned
   266	       value is  N = k * V_2 * q  with k = #bottom-major discs and  k*V_2 <= u.

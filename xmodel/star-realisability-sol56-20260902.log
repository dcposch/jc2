   125	
   126	def uni_witnesses(S, n_min: int = 6) -> Tuple[UniWitness, ...]:
   127	    """All integral (UNI) values N>=n_min for this complete V-assignment.
   128	
   129	    If q=p/r is reduced, integrality of k*V_2*q is equivalent to
   130	    r/gcd(r,V_2) dividing k.  This is exactly the loop in
   131	    d1floor.achievable, with the requested lower frontier changed to n_min.
   132	    """
   133	    if n_min < 0:
   134	        raise ValueError("n_min must be nonnegative")
   135	    v2 = S.V[2]
   136	    if v2 <= 0:
   137	        raise AssertionError("census returned nonpositive V_2")
   138	    q = qval(S)
   139	    if q <= 0:
   140	        return ()
   141	    kmax = int(S.u // v2)
   142	    period = q.denominator // gcd(q.denominator, v2)
   143	    base = period * v2 * q
   144	    if base.denominator != 1:
   145	        raise AssertionError("integrality period failed")
   146	    base_int = int(base)
   147	    jmax = kmax // period
   148	    if jmax == 0:
   149	        return ()
   150	    jmin = max(1, (n_min + base_int - 1) // base_int)
   151	    return tuple(
   152	        UniWitness(k=j * period, total_v2=j * period * v2, N=j * base_int)
   153	        for j in range(jmin, jmax + 1)
   154	    )

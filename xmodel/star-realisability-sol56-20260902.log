   270	def divisor_chains(K, floor=4):
   271	    out = []
   272	    def rec(cur, ch):
   273	        for dd in range(floor, cur):
   274	            if cur % dd == 0: out.append(ch+[dd]); rec(dd, ch+[dd])
   275	    rec(K, []); return out
   276	
   277	def census(n, Kmin=16, with_V=True):
   278	    """Enumerate (n, m, M_2..M_s) and (if with_V) the V-assignments.
   279	       Conditions, all read firsthand from Moh / GGV:
   280	         d_1 = n > d_2 = K > ... > d_s >= 4      Moh search (5) + Cor 6.1
   281	         s >= 3                                  Moh Prop 5.5
   282	         M_1 = -m, M_s = n-2                     Moh search (1),(2) + Prop 5.4/Lem 5.3
   283	         m = K*d, n = K*e, gcd(d,e)=1, 2<=d<e    (LF)+(MIN)
   284	         K >= 16                                 GGV Cor 6.6
   285	         d_s/(n-M_i) < V_i <= V_{i+1} d_i/d_{i+1}, V_{s+1}=d_{s+1}   Def 5.1(2)
   286	         V_s < d_s                               two points at infinity (delta_s = -1)
   287	    """
   288	    for K in range(Kmin, n//3+1):
   289	        if n % K: continue
   290	        e = n//K
   291	        if e < 3: continue
   292	        for ch in divisor_chains(K, 4):
   293	            dfull = [n, K]+ch; dfull.append(gcd(dfull[-1], n-2))
   294	            s = 2+len(ch)
   295	            d = {i+1: dfull[i] for i in range(len(dfull))}
   296	            dlist = ([K]+ch)[:-1]; tg = ch
   297	            for dd in range(2, e):
   298	                if gcd(dd, e) != 1: continue
   299	                m = K*dd
   300	                M = {1: -m, s: n-2}
   301	                def Mrec(i, prev):
   302	                    if i == s:
   303	                        if prev < n-2: yield True
   304	                        return
   305	                    for Mi in range(prev+1, n-2):
   306	                        if gcd(dlist[i-2], Mi) == tg[i-2]:
   307	                            M[i] = Mi; yield from Mrec(i+1, Mi)
   308	                for _ in Mrec(2, -m):
   309	                    Ms = [M[i] for i in range(2, s+1)]
   310	                    if not with_V:
   311	                        yield (m, tuple(Ms), None); continue
   312	                    V = {s+1: d[s+1]}
   313	                    def Vrec(i):
   314	                        if i == 1: yield None; return
   315	                        lo = F(d[i], n-M[i]); hi = F(V[i+1]*d[i], d[i+1])
   316	                        for w in range(lo.numerator//lo.denominator + 1,
   317	                                       hi.numerator//hi.denominator + 1):
   318	                            if w < 1: continue
   319	                            if i == s and w >= d[s]: continue
   320	                            V[i] = w; yield from Vrec(i-1)
   321	                        V.pop(i, None)
   322	                    for _ in Vrec(s):
   323	                        yield (m, tuple(Ms), {i: V[i] for i in range(2, s+1)})
   324	

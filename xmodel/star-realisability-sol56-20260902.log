    print(f"[PROVED-HERE] CONTROL-UNI: exact loop = period shortcut on {checked} assignments")


def print_table(rows: Mapping[int, DegreeCounts], degrees: Iterable[int], label: str) -> None:
    print(f"\n[MEASURED] {label}")

   360	        lf, lg = leading_form(f), leading_form(g)
   361	        br = simplify(expand(diff(lf, x)*diff(lg, y) - diff(lf, y)*diff(lg, x)))
   362	        J = simplify(expand(diff(f, x)*diff(g, y) - diff(f, y)*diff(g, x)))
   363	        Jconst = (J.free_symbols == set())

   146	class Skel:
   147	    """A Moh skeleton: (n, m, [M_2..M_s], {i: V_i}).  M_1 = -m, M_s = n-2,
   148	       V_{s+1} = d_{s+1}.  Def 5.1(1)-(3) of Moh 1983 (moh.txt p.179)."""
   149	    def __init__(self, n, m, Ms, Vs):
   150	        self.n, self.m = n, m
   151	        full = [-m] + list(Ms)
   152	        self.s = s = len(full)
   153	        self.M = {i+1: full[i] for i in range(s)}
   154	        d = [n]
   155	        for M in full: d.append(gcd(d[-1], M))
   156	        self.d = {i+1: d[i] for i in range(len(d))}
   157	        self.V = dict(Vs); self.V[s+1] = self.d[s+1]
   158	        self.K = self.d[2]; self.e = n//self.K; self.dd = m//self.K
   159	        self.delta = {i: self._delta(i) for i in range(1, s+1)}
   160	        self.a = {i: n*self.V[i+1]//self.d[i+1] for i in range(1, s+1)}
   161	        self.b = {i: m*self.V[i+1]//self.d[i+1] for i in range(1, s+1)}
   162	        self.u = F(self.V[s]*self.K, self.d[s])       # top form  L_1^u L_2^v
   163	        self.v = self.K - self.u
   164	
   165	    def _delta(self, i):                              # Def 5.1(3)
   166	        n, M, d, V, s = self.n, self.M, self.d, self.V, self.s
   167	        num = F(n-M[i]); den = F(n-M[s]-1)
   168	        for j in range(i+1, s+1):
   169	            num *= (V[j]*(n-M[j]) - d[j]); den *= (V[j]*(n-M[j-1]) - d[j])
   170	        return 1 - num/den
   171	
   172	    def lam_g(self, r):
   173	        """ord_t g(sigma) at the general point of D_r:  -n + int_{-1}^{delta_r} a."""
   174	        out = F(-self.n)
   175	        for i in range(r, self.s): out += self.a[i]*(self.delta[i]-self.delta[i+1])
   176	        return out
   177	
   178	    def lam_g_closed(self, r):
   179	        """closed form  -n + n*sum_{j=r+1}^{s} V_j (M_j-M_{j-1}) R_j / Q_j ."""
   180	        n, M, d, V, s = self.n, self.M, self.d, self.V, self.s
   181	        tot = F(0)
   182	        for j in range(r+1, s+1):
   183	            R = F(1)
   184	            for k in range(j+1, s+1):
   185	                R *= F(V[k]*(n-M[k])-d[k], V[k]*(n-M[k-1])-d[k])
   186	            tot += F(V[j]*(M[j]-M[j-1]), 1)*R/(V[j]*(n-M[j-1])-d[j])
   187	        return -n + n*tot
   188	
   189	    def lam_f(self, r): return F(self.m, self.n)*self.lam_g(r)
   190	
   191	    def lam_g_radius(self, r):
   192	        """THEOREM RADIUS-ORDER:  lambda_g(delta_r) = -n(1-delta_r)(n-M_s-1)/(n-M_r).
   193	           With M_s = n-2 this is -n(1-delta_r)/(n-M_r): Moh's logarithmic radius and
   194	           the order of g at the general point of D_r are ONE datum."""
   195	        return -F(self.n*(1-self.delta[r])*(self.n-self.M[self.s]-1), self.n-self.M[r])
   196	
   197	    def N_upper_closed(self):
   198	        """U = u*d*e*(1-delta_1)/(d+e)  -- N-CEILING in closed form."""
   199	        if self.delta[1] >= 1: return F(0)
   200	        return F(self.u*self.dd*self.e, self.dd+self.e)*(1-self.delta[1])
   201	
   202	    def N_upper(self):
   203	        """THEOREM N-CEILING:  N <= a_{s-1} * (-lambda_f(delta_1))^+ = u*d*(-lambda_g(delta_1))^+."""
   204	        lg = self.lam_g(1)
   205	        return self.u*self.dd*(-lg) if lg < 0 else F(0)
   206	
   207	    def windows_ok(self):                             # Def 5.1(2) / Prop 5.3
   208	        for i in range(2, self.s+1):
   209	            lo = F(self.d[i], self.n-self.M[i]); hi = F(self.V[i+1]*self.d[i], self.d[i+1])
   210	            if not (self.V[i] > lo and self.V[i] <= hi): return False
   211	        return True
   212	
   213	def top_of_window_V(n, m, Ms, Vs_top):
   214	    """The V-assignment with V_s = Vs_top and every lower V_i at the top of its
   215	       Def 5.1(2) window.  MEASURED (control below): -lambda_g(delta_1), hence U,
   216	       is maximised there, so this realises the branch-robust bound U_rob."""
   217	    full = [-m] + list(Ms); s = len(full)
   218	    M = {i+1: full[i] for i in range(s)}
   219	    d = [n]
   220	    for Mi in full: d.append(gcd(d[-1], Mi))


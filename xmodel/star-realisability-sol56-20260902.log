   269	def control_automorphism() -> None:
   270	    """s=1 control: P=pi^k+1, Q=pi gives D(k,1,P,Q)=k."""
   271	    from sympy import Poly, diff, expand, gcd as poly_gcd, symbols
   272	
   273	    pi = symbols("pi")
   274	    for k in range(2, 13):
   275	        P, Q = pi**k + 1, pi

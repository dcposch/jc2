   145	    M = {i+1: full[i] for i in range(s)}
   146	    d = [n]
   147	    for Mi in full: d.append(gcd(d[-1], Mi))
   148	    d = {i+1: d[i] for i in range(len(d))}
   149	    # top of window (max q)
   150	    Vhi = {s+1: d[s+1], s: Vs_top}
   151	    for i in range(s-1, 1, -1):
   152	        hi = F(Vhi[i+1]*d[i], d[i+1]); Vhi[i] = hi.numerator//hi.denominator
   153	        if Vhi[i]*(n-M[i]) <= d[i]: return None, None
   154	    # bottom of window (min V_2*q), top-down: V_i as small as its own window allows

   139	def lower_V_extremes(n, m, Ms, Vs_top):
   140	    """Return (V_min_assignment, V_max_assignment) for V_2..V_{s-1} with V_s = Vs_top.
   141	       q is strictly increasing in every V_j (d/dV (P/Q) = d_j(M_j-M_{j-1})/Q^2 > 0),

+        "lane_inputs_dir": str(FROZEN),
+        "count": count,
+        "all_hashes_match": True,
+        "manifest_sha256": hashlib.sha256(
+            "".join(f"{h}  {name}\n" for name, h in checked).encode()
+        ).hexdigest(),

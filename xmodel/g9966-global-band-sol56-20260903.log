+    assert len(dfree)==99
+
+    k2: TZ = {}
+    # fixed P^3 top
+    for j in range(10):
+        k2[(0,24+j)] = sp.Integer(comb(9,j))
+    equality={(4*k,24-3*k):sp.Integer((-1)**k*comb(8,k)) for k in range(1,9)}
+    for r in range(1,max_t+1):

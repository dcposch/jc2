+    else:
+        pole_power=8+stage
+        pole_exponents={"F":pole_power-189,"G":pole_power-126}
+    if stage==0:
+        jacobian={"t_power":1,"degree":162,"w_powers":[27]}
+    elif stage==1:
+        jacobian={"t_power":1,"degree":162,"w_powers":list(range(28,163))}
+    else:
+        tpower=stage

+    elapsed=time.perf_counter()-started
+    rss_self=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
+    rss_children=resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss
+    rss=max(rss_self,rss_children)
+    return {

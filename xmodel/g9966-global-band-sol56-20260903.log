+    script=(
+        f"ring R=0,({','.join(map(str,ringvars))}),dp;\n"
+        f"ideal I={','.join(ideal_entries)};\n"
+        "ideal S=std(I);\n"
+        'print("BEGIN_DIM"); print(dim(S)); print("END_DIM");\n'

+def take(name,start,end=None):
+    s=(p/name).read_text();s=s[s.index(start):]
+    if end:s=s[:s.index(end)]
+    s=s.split('\n',1)[1].strip()
+    s=re.sub(r'^## ([0-9A-Z.]+)\.?(.*)$',lambda m:'### '+m.group(2).strip(),s,flags=re.M)

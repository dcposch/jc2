+say('poly VV=h^2*C-y*b3; poly YY=h*SS-b3*BB-g*b2; poly zpiece=h*BB-g*b3;')
+say('poly NN=-VV*diff(YY,h)+diff(VV,h)*YY+2*diff(U,h)*zpiece;')
+say('poly PP=(NN-subst(NN,h,0))/(2*y*h);')

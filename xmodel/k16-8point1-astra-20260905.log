+    diff=D['red'](expr.subs(d,2*(2*t+1)*y-(t+1))-D['T'][k])
+    assert diff==0,(t,k,diff)
+    print(f'SYMPY_IMAGE t={t} k={k} PASS',flush=True)
+print('SYMPY_CROSSCHECK_COMPLETE',flush=True)

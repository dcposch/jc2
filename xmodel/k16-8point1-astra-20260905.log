+ap.add_argument('--droot', type=int)
+ap.add_argument('--out', required=True)
+args = ap.parse_args()
+t = args.t
+q = 2*t+1
+e = 3*t+1
+assert t >= 2
+assert (t == 2) == (args.d is not None) or args.prime
+us = [f'u{i}' for i in range(2,2*t+1)]
+cs = [f'c{i}' for i in range(1,t)]

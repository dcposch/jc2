+#!/usr/bin/env python3
+"""Emit exact controls, nilpotence and annihilator probes for fresh rows."""
+from pathlib import Path
+import argparse
+ap=argparse.ArgumentParser()
+ap.add_argument('tag')
+ap.add_argument('t',type=int)
+a=ap.parse_args()
+p=Path(__file__).resolve().parent
+t=a.t
+rows=p/f'{a.tag}_rows.sing'
+print(f'< "{rows}";')

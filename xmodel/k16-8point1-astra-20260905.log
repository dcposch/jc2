+for k in range(2*t):
+    say(f'write("{out}","poly T{k}="+string(rows[{k+1}])+";");')
+say(f'write("{out}","poly tau="+string(tau)+";");')
+for name in ['spineB1','spineB2','rootR']:
+    say(f'write("{out}","poly {name}="+string({name})+";");')

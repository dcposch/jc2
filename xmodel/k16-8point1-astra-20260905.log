+# jet(...,...,h) is not a univariate jet in Singular; explicit coefficient loop
+say('proc hco(poly f,int k) { poly z=0; int ii; for(ii=1;ii<=size(f);ii++) { if(deg(f[ii],intvec(1'+',0'*(3+len(us)+len(cs))+'))==k) { z=z+f[ii]/h^k; } } return(z); }')
+say(f'number y=(d+{t+1})/{2*q}; number g={e*t}*(3*d+{2*(t+1)})/{6*q**3};')

+import argparse
+from pathlib import Path
+
+ap = argparse.ArgumentParser()
+ap.add_argument('t', type=int)
+ap.add_argument('--d', choices=['-1', '1'])
+ap.add_argument('--out', required=True)
+args = ap.parse_args()
+t = args.t
+q = 2*t+1
+e = 3*t+1
+assert t >= 2
+assert (t == 2) == (args.d is not None)
+us = [f'u{i}' for i in range(2,2*t+1)]
+cs = [f'c{i}' for i in range(1,t)]
+resid = ['b4']+[f'u{i}' for i in range(2,t)]+['b3']
+high = cs+[f'u{i}' for i in range(t,2*t+1)]+['b2']
+out = Path(args.out).resolve()
+coeff = '0' if args.d else '(0,d)'
+rel = f'number d={args.d};' if args.d else f'minpoly=3*d^2-{t+1};'
+def say(s): print(s)
+say(f'ring gen={coeff},(h,b4,b3,b2,{",".join(us+cs)}),dp;')
+say(rel)
+say('option(redSB);')
+say('proc must(int ok,string label) { if (!ok) { print("FAIL "+label); quit; } }')
+say('proc hc(poly f,int k) { return(subst(diff(f,h,k),h,0)); }')
+# use coefficient extraction via division instead of repeated high derivatives
+say('proc cf(poly f,int k) { poly z=jet(f,k,h)-jet(f,k-1,h); return(z/h^k); }')
+# jet(...,...,h) is not a univariate jet in Singular; explicit coefficient loop
+say('proc hco(poly f,int k) { poly z=0; int ii; for(ii=1;ii<=size(f);ii++) { if(deg(f[ii],intvec(1'+',0'*(3+len(us)+len(cs))+'))==k) { z=z+f[ii]/h^k; } } return(z); }')
+say(f'number y=(d+{t+1})/{2*q}; number g={e*t}*(3*d+{2*(t+1)})/{6*q**3};')

@@ -0,0 +1,12 @@
+#!/usr/bin/env python3
+from pathlib import Path
+import sys
+t=int(sys.argv[1]); p=Path(__file__).resolve().parent
+print(f'< "{p/f"t{t}_local_rows.sing"}";')

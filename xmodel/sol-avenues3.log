    (2,  (8, 3),   "tf2_40", "x49"), (3,  (12, 2),  "tf1_44", "x1"),
    (4,  (12, 5),  "tf2_44", "x9"),  (5,  (12, 8),  "tf1_39", "x43"),
    (6,  (14, 0),  "tf1_46", "x3"),  (7,  (14, 3),  "tf2_46", "x11"),
    (8,  (14, 6),  "tf1_41", "x45"), (9,  (14, 9),  "tf2_41", "x50"),
    (10, (16, 1),  "tf1_43", "x0"),  (11, (16, 4),  "tf1_48", "x5"),

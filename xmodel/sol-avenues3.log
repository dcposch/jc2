def parse(e,p):
    d={}
    for t in e.split('+'):
        fs=t.split('*'); c=int(fs[0]); mono={}
        for f in fs[1:]:
            m=re.match(r'([A-Za-z0-9_]+)\^(\d+)',f)
            if m: mono[m.group(1)]=mono.get(m.group(1),0)+int(m.group(2))
            else: mono[f]=mono.get(f,0)+1
        k=tuple(sorted(mono.items()))
        d[k]=(d.get(k,0)+c)%p
    return {k:c for k,c in d.items() if c}

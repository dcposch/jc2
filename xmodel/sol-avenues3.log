    return {k:c for k,c in out.items() if c}
def uniroots(d,i):
    cs={}
    for k,c in d.items(): cs[k[i]]=(cs.get(k[i],0)+c)%p
    dg=max(cs)
    if dg==0: return None
    if dg==1:
        a,b=cs.get(1,0),cs.get(0,0)
        return [(-b)*pow(a,p-2,p)%p]
    return [x for x in range(p) if sum(c*pow(x,e,p) for e,c in cs.items())%p==0]

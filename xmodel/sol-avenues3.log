NTRIALS = 20

# frozen pivot provenance (cases/directionb_core23_{elim,emit}.py PIV22
# + D21 registry xN mapping, verified unit-linear in mapcheck):
# (artifact pivot-block index 0..21, row label, tf-name, xN)

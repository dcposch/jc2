import importlib.util, time, math
from fractions import Fraction as F
PATH='/private/var/folders/80/jm5p82hn56g0crpvv9xjzrc00000gn/T/jc2-lane.I2h68x/inputs/moh_skeleton_N.py'
spec=importlib.util.spec_from_file_location('mohN', PATH)
M=importlib.util.module_from_spec(spec); spec.loader.exec_module(M)

def frac_part_tuple(w):
    iw=w.numerator//w.denominator
    rem=w.numerator - iw*w.denominator
    if rem==0: return iw,(0,1)
    g=math.gcd(rem,w.denominator)
    return iw,(rem//g,w.denominator//g)

def add_frac_tuple(fr, fw):
    a,b=fr; c,d=fw
    if a==0: return 0, fw
    if c==0: return 0, fr
    num=a*d+c*b; den=b*d
    carry=num//den; rem=num-carry*den
    if rem==0: return carry,(0,1)
    g=math.gcd(rem,den)
    return carry,(rem//g,den//g)

def bit_values_tuple(items, cap):
    if not items: return set(),0,0
    maxratio=max(w/F(v2,1) for v2,w in items)
    maxfloor=int(cap*maxratio)
    mask=(1<<(maxfloor+1))-1
    parts=[]
    for v2,w in items:
        iw,fw=frac_part_tuple(w)
        parts.append((v2,iw,fw))
    dp=[{} for _ in range(cap+1)]
    dp[0][(0,1)]=1
    zero=(0,1)
    for used in range(cap+1):
        if not dp[used]: continue
        entries=list(dp[used].items())
        for frac,bits in entries:
            for v2,iw,fw in parts:
                nu=used+v2
                if nu>cap: continue
                carry,nf=add_frac_tuple(frac, fw)
                nb=(bits << (iw+carry)) & mask
                if nb:
                    old=dp[nu].get(nf,0)
                    merged=old|nb
                    if merged"'!=old: dp[nu][nf]=merged
    vals=set()
    for used in range(cap+1):
        bits=dp[used].get(zero,0) >> 6
        n=6
        while bits:
            if bits&1: vals.add(n)
            bits >>=1; n+=1
    return vals,sum(len(d) for d in dp),maxfloor

def groups_for_D(n):
    cur=None; branches=[]
    for m,Ms,V in M.census(n, with_V=True):
        S=M.Skel(n,m,list(Ms),V)
        key=(n,m,tuple(Ms),V[S.s])
        if cur is not None and key!=cur:
            yield cur, branches
            branches=[]
        cur=key; branches.append(S)
    if cur is not None: yield cur, branches

for n in [105,108,112,117,120]:
    t=time.time(); g=surv=survw=0; union=set(); unionw=set(); states=0; maxflo=0
    bmin=10**9;bmax=0;wmin=10**9;wmax=0

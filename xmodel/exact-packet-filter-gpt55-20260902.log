        items={}; weights=set(); cap=int(branches[0].u)
        for S in branches:
            v2=S.V[2]; w=F(S.e*v2*S.dd, S.dd+S.e)*(1-S.delta[1])
            weights.add(w); items[(v2,w)]=None
        wmin=min(wmin,len(weights)); wmax=max(wmax,len(weights))
        vals,st,mf=bit_values_tuple(list(items), cap)
        states+=st; maxflo=max(maxflo,mf)
        valsw={x for x in vals if x<=16}
        if vals: surv+=1; union.update(vals)

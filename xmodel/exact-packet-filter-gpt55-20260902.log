def mod_values(items, cap):
    if not items: return set(),0,0,0
    maxratio=max(w/F(v2,1) for v2,w in items)
    maxfloor=int(cap*maxratio)
    L=1
    dens=[]
    for v2,w in items:
        den=w.denominator; dens.append(den); L=math.lcm(L,den)
    need_bits=L.bit_length()+max(2, (2*maxfloor+4).bit_length())+1
    Q=1; used_pr=0
    for p in PR:
        if all(den % p for den in dens):
            Q*=p; used_pr+=1
            if Q.bit_length()>need_bits: break
    if Q.bit_length()<=need_bits:
        raise RuntimeError(('not enough primes', need_bits, Q.bit_length()))
    parts=[]
    for v2,w in items:
        parts.append((v2, (w.numerator*pow(w.denominator,-1,Q))%Q))
    dp=[set() for _ in range(cap+1)]
    dp[0].add(0)
    for used in range(cap+1):
        if not dp[used]: continue
        for res in list(dp[used]):
            for v2,wr in parts:
                nu=used+v2
                if nu<=cap:
                    dp[nu].add((res+wr)%Q)
    residues=set().union(*dp)
    vals={t for t in range(6,maxfloor+1) if (t % Q) in residues}
    return vals, sum(len(s) for s in dp), maxfloor, used_pr


def frac_part_tuple(w):
    iw=w.numerator//w.denominator
    rem=w.numerator-iw*w.denominator
    if rem==0: return iw,(0,1)
    g=math.gcd(rem,w.denominator); return iw,(rem//g,w.denominator//g)

def add(fr, fw):
    a,b=fr; c,d=fw
    if a==0: return 0,fw
    if c==0: return 0,fr
    num=a*d+c*b; den=b*d; carry=num//den; rem=num-carry*den
    if rem==0: return carry,(0,1)
    g=math.gcd(rem,den); return carry,(rem//g,den//g)
key_target=(108,72,(54,81,106),8); branches=[]

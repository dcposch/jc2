import importlib.util, time
from fractions import Fraction as F
PATH='/private/var/folders/80/jm5p82hn56g0crpvv9xjzrc00000gn/T/jc2-lane.I2h68x/inputs/moh_skeleton_N.py'
spec=importlib.util.spec_from_file_location('mohN', PATH)
M=importlib.util.module_from_spec(spec); spec.loader.exec_module(M)
PRIMES=[1009,2003,5003,10007,20011,50021,100003]

def rot(bits, shift, mask, p):
    shift%=p
    if shift==0: return bits
    return ((bits<<shift)|(bits>>(p-shift))) & mask

def mod_possible(items, cap, lo, hi, p):
    parts=[]
    for v,w in items:
        den=w.denominator%p
        if den==0: return True # cannot use this prime safely; inconclusive
        parts.append((v,(w.numerator%p)*pow(den,-1,p)%p))
    mask=(1<<p)-1
    target=0
    for T in range(lo,hi+1): target |= 1<<(T%p)
    dp=[0]*(cap+1); dp[0]=1
    for used in range(cap+1):
        b=dp[used]
        if not b: continue
        for v,r in parts:
            nu=used+v
            if nu<=cap:
                nb=rot(b,r,mask,p)
                dp[nu] |= nb
                if nb & target: return True
    return any(b & target for b in dp)

def groups_for_D(n):
    cur=None; branches=[]
    for m,Ms,V in M.census(n, with_V=True):
        S=M.Skel(n,m,list(Ms),V); key=(n,m,tuple(Ms),V[S.s])
        if cur is not None and key"'!=cur:
            yield cur,branches; branches=[]
        cur=key; branches.append(S)
    if cur is not None: yield cur,branches
for n in [105,108,112,117,120]:
    t=time.time(); g=0; alive=0; killed=[0]*len(PRIMES)
    for key,branches in groups_for_D(n):
        g+=1; cap=int(branches[0].u); items={}
        for S in branches:
            w=F(S.e*S.V[2]*S.dd,S.dd+S.e)*(1-S.delta[1]);
            if w<=16: items[(S.V[2],w)]=None
        poss=True
        for i,p in enumerate(PRIMES):
            if not mod_possible(list(items),cap,6,16,p):
                killed[i]+=1; poss=False; break
        if poss: alive+=1
    print('"'D',n,'groups',g,'mod_alive',alive,'killed_by_prime_index',killed,'wall',round(time.time()-t,2),flush=True)

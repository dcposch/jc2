    print('"'D',n,'groups',g,'surv>=6',surv,'surv[6,16]',survw,'union',sorted(union),'unionw',sorted(unionw),'branch minmax',bmin,bmax,'weight minmax',wmin,wmax,'states',states,'maxfloor',maxflo,'wall',round(time.time()-t,2),flush=True)

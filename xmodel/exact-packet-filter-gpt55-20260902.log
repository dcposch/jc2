def exact_mod_Q(items,cap):
    maxratio=max(w/F(v,1) for v,w in items); maxfloor=int(cap*maxratio); L=1
    for v,w in items: L=math.lcm(L,w.denominator)
    need=L.bit_length()+max(2,(2*maxfloor+4).bit_length())+1; Q=1
    for q in QFACT:
        if all(math.gcd(w.denominator,q)==1 for v,w in items):
            Q*=q
            if Q.bit_length()>need: break
    return Q,maxfloor
def bounded(items,cap,lo=6,hi=None,state_cap=20000):
    if not items: return set(),'no',0,0
    maxitem = hi if hi is not None else None
    if maxitem is not None: items=[(v,w) for v,w in items if w<=maxitem]
    if not items: return set(),'no',0,0
    Q,maxfloor=exact_mod_Q(items,cap)
    if hi is None: hi=maxfloor
    else: hi=min(hi,maxfloor)
    if hi<lo: return set(),'no',0,maxfloor
    targets={t%Q:t for t in range(lo,hi+1)}
    parts=[(v,(w.numerator*pow(w.denominator,-1,Q))%Q) for v,w in items]
    dp=[set() for _ in range(cap+1)]; dp[0].add(0); states=1; vals=set()
    for used in range(cap+1):
        for res in list(dp[used]):
            for v,wr in parts:
                nu=used+v
                if nu>cap: continue
                nr=(res+wr)%Q
                if nr in targets: vals.add(targets[nr])
                s=dp[nu]

import importlib.util, time, math
from fractions import Fraction as F
import z3
PATH='/private/var/folders/80/jm5p82hn56g0crpvv9xjzrc00000gn/T/jc2-lane.I2h68x/inputs/moh_skeleton_N.py'
spec=importlib.util.spec_from_file_location('mohN', PATH)
M=importlib.util.module_from_spec(spec); spec.loader.exec_module(M)
MERS=[61,89,107,127,521,607,1279]
QFACT=[(1<<e)-1 for e in MERS]

def exact_mod_Q(items, cap):
    maxratio=max(w/F(v,1) for v,w in items)
    maxfloor=int(cap*maxratio)
    L=1
    for v,w in items: L=math.lcm(L,w.denominator)
    need=L.bit_length()+max(2,(2*maxfloor+4).bit_length())+1
    Q=1
    for q in QFACT:
        # assume Mersenne prime; all we need here is coprime to denominators.
        if all(math.gcd(w.denominator,q)==1 for v,w in items):
            Q*=q
            if Q.bit_length()>need: break
    if Q.bit_length()<=need:
        raise RuntimeError(f'Q too small need {need} got {Q.bit_length()}')
    return Q,maxfloor

def first_hit_mod(items, cap, lo, hi, state_cap=200000):
    items=[(v,w) for v,w in items if w<=hi]
    if not items: return 'no',None,0
    Q,maxfloor=exact_mod_Q(items,cap); hi=min(hi,maxfloor)
    if hi<lo: return 'no',None,0
    targets={t%Q:t for t in range(lo,hi+1)}
    parts=[(v,(w.numerator*pow(w.denominator,-1,Q))%Q) for v,w in items]
    dp=[set() for _ in range(cap+1)]; dp[0].add(0); states=1

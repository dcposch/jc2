import importlib.util, time, math
from fractions import Fraction as F
from sympy import prevprime
PATH='/private/var/folders/80/jm5p82hn56g0crpvv9xjzrc00000gn/T/jc2-lane.I2h68x/inputs/moh_skeleton_N.py'
spec=importlib.util.spec_from_file_location('mohN', PATH)
M=importlib.util.module_from_spec(spec); spec.loader.exec_module(M)
PR=[]; x=(1<<61)-1
for _ in range(80):
    p=int(prevprime(x)); PR.append(p); x=p-1000000

def prep_mod(items, cap, max_target=None):
    if not items: return None
    maxratio=max(w/F(v2,1) for v2,w in items)
    maxfloor=int(cap*maxratio)
    if max_target is None: max_target=maxfloor
    L=1; dens=[]
    for v,w in items:
        den=w.denominator; dens.append(den); L=math.lcm(L,den)
    need_bits=L.bit_length()+max(2,(2*maxfloor+4).bit_length())+1
    Q=1
    for p in PR:
        if all(den%p for den in dens):
            Q*=p
            if Q.bit_length()>need_bits: break
    if Q.bit_length()<=need_bits: raise RuntimeError('primes')
    parts=[]
    for v,w in items:
        # Prune items whose weight already exceeds max target; positive weights cannot appear in target <=max_target.
        if w <= max_target:
            parts.append((v,(w.numerator*pow(w.denominator,-1,Q))%Q,w))
    return Q,parts,maxfloor

def first_hit(items, cap, lo, hi, state_cap=2000000):
    Q,parts,maxfloor=prep_mod(items,cap,hi)
    hi=min(hi,maxfloor)
    if hi<lo or not parts: return None,0,False
    targets={t%Q:t for t in range(lo,hi+1)}
    dp=[set() for _ in range(cap+1)]; dp[0].add(0); states=1
    for used in range(cap+1):
        if not dp[used]: continue
        for res in list(dp[used]):
            for v,wr,w in parts:
                nu=used+v
                if nu>cap: continue
                nr=(res+wr)%Q
                if nr in targets:
                    return targets[nr],states,False
                s=dp[nu]
                if nr not in s:
                    s.add(nr); states+=1
                    if states>state_cap:
                        return None,states,True
    return None,states,False

def groups_for_D(n):
    cur=None; branches=[]
    for m,Ms,V in M.census(n, with_V=True):
        S=M.Skel(n,m,list(Ms),V)
        key=(n,m,tuple(Ms),V[S.s])
        if cur is not None and key"'!=cur:
            yield cur, branches
            branches=[]
        cur=key; branches.append(S)
    if cur is not None: yield cur, branches

for n in [108,112,117,120]:
    t=time.time(); g=surv=capd=0; states=0; hits=[]; hard=[]
    for key, branches in groups_for_D(n):
        g+=1; cap=int(branches[0].u); items={}
        for S in branches:
            w=F(S.e*S.V[2]*S.dd,S.dd+S.e)*(1-S.delta[1]); items[(S.V[2],w)]=None
        hit,st,capped=first_hit(list(items),cap,6,16, state_cap=2000000)
        states+=st
        if hit is not None: surv+=1; hits.append(hit)
        if capped: capd+=1; hard.append(key)
    print('"'D',n,'groups',g,'surv_first[6,16]',surv,'capped_nohit',capd,'hitset',sorted(set(hits)),'states',states,'wall',round(time.time()-t,2),'hard first',hard[:3], flush=True)

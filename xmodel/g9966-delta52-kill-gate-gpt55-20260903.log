+            "outer_D2_rank": 5598,
+            "outer_D1_rank": 176,
+            "joint_Qstar_rank": 59,
+            "residue_count": 0,
+        },
+        "manifest": {
+            "path": str(BASE / "next-stage8-system.json"),
+            "sha256": sha256_bytes(manifest_bytes),
+            "byte_identical_replay": True,
+            "next_stage_spec": manifest["next_stage_spec"],
+        },
+        "free_coordinates": {
+            "path": str(BASE / "stage7-free-coefficients.txt"),
+            "count": 869,

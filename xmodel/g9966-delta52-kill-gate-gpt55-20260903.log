+    require(len(introduced) == 7, "stage8 introduced-pivot count mismatch")
+    constants = []
+    for row in stage8["joint_elimination"]["residual_rows"]:
+        value = sp.sympify(row["expression"])
+        if not value.free_symbols and value != 0:

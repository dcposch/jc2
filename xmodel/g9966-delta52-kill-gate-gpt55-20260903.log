+ENGINE = ROOT / "box/g9966band-20260903/band_engine.py"
+VALIDATOR = ROOT / "box/g9966band-20260903/validate_run_ledger.py"
+MANIFEST_HELPER = ROOT / "box/g9966band-20260903/next_system_manifest.py"

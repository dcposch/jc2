index 0000000000000000000000000000000000000000..3f7078efae4d4d9dc4b5af6343c117bf409e9801
--- /dev/null
+++ b/box/g9966d52gate-20260903/k2c_inverse.py
@@ -0,0 +1,275 @@
+#!/usr/bin/env python3
+"""Reconstruct and serialize the K2c inverse to original C2c/C3c names."""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+from math import comb
+from pathlib import Path
+import sys
+from typing import Any
+
+import sympy as sp
+
+
+ROOT = Path("/home/ubuntu/jc2")
+BASE = ROOT / "box/g9966d52gate-20260903"
+ENGINE = ROOT / "box/g9966band-20260903/band_engine.py"
+PINNED_ENGINE_SHA256 = "3bd2937d75d59d59edeca1b89eba286fd2711f2d608109e7fd8971b64e059ac9"
+
+
+def require(condition: bool, message: str) -> None:
+    if not condition:
+        raise RuntimeError(message)
+
+
+def sha256_file(path: Path) -> str:
+    h = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            h.update(block)
+    return h.hexdigest()
+
+
+def load_engine():
+    require(sha256_file(ENGINE) == PINNED_ENGINE_SHA256, "engine digest mismatch")
+    name = "g9966_k2c_pinned_engine"
+    spec = importlib.util.spec_from_file_location(name, ENGINE)
+    require(spec is not None and spec.loader is not None, "cannot load engine")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def order_key(position: tuple[int, int]) -> tuple[int, int]:
+    return position[0], -position[1]
+
+
+def expr_text(expr: sp.Expr) -> str:
+    return str(sp.expand(expr))
+
+
+def fast_substitute(expr: sp.Expr, substitutions: dict[sp.Symbol, sp.Expr]) -> sp.Expr:
+    out = sp.expand(expr)
+    sub_keys = set(substitutions)
+    for _ in range(len(substitutions) + 2):
+        hits = out.free_symbols.intersection(sub_keys)
+        if not hits:
+            return out
+        out = sp.expand(out.xreplace({symbol: substitutions[symbol] for symbol in hits}))
+    raise RuntimeError("targeted substitution did not stabilize")
+
+
+def rows_hash(items: list[tuple[str, str]]) -> str:
+    payload = "".join(f"{key}\t{value}\n" for key, value in items).encode()
+    return hashlib.sha256(payload).hexdigest()
+
+
+def main() -> None:
+    engine = load_engine()
+    h3, _hvars = engine.h3_template()
+    h3cube = engine.tz_mul(engine.tz_mul(h3, h3, 33), h3, 33)
+    c2 = {
+        (r, q): sp.Symbol(f"C2c_{r}_{q}")
+        for r in range(1, 23)
+        for q in range(min(10, 22 - r) + 1)
+    }
+    c3 = {
+        (r, q): sp.Symbol(f"C3c_{r}_{q}")
+        for r in range(1, 34)
+        for q in range(min(10, 33 - r) + 1)
+    }
+    require((len(c2), len(c3)) == (187, 308), "C2/C3 coordinate count mismatch")
+    k2_raw = engine.tz_add(h3cube, engine.tz_mul(c2, h3, 33), c3)
+
+    lowq_slots = [
+        (r, q)
+        for r in range(1, 34)
+        for q in range(min(21, 33 - r) + 1)
+    ]
+    require(len(lowq_slots) == 495, "low-q output count mismatch")
+    equality_targets = {
+        (4 * k, 24 - 3 * k): sp.Integer((-1) ** k * comb(8, k))
+        for k in range(1, 9)
+    }
+    d2_identity_slots = [(1, 22), (1, 23), (2, 22)]
+    d2_slots = [
+        (r, q)
+        for r in range(1, 34)
+        for q in range(34 - r)
+        if 3 * r + 4 * q <= 96
+    ]
+    require(set(d2_slots) - set(lowq_slots) == set(d2_identity_slots),
+            "unexpected D2 identity slots")
+
+    c_inverse: dict[sp.Symbol, sp.Expr] = {}
+    d2_rows = 0
+    k2c_rows = 0
+    pivot_ledger: list[dict[str, str | int]] = []
+    for r, q in sorted(lowq_slots, key=order_key):
+        target = (
+            equality_targets.get((r, q), sp.Integer(0))
+            if 3 * r + 4 * q <= 96
+            else sp.Symbol(f"K2c_{r}_{q}")
+        )
+        if 3 * r + 4 * q <= 96:
+            d2_rows += 1
+        else:
+            k2c_rows += 1
+        row = fast_substitute(sp.expand(k2_raw.get((r, q), 0) - target), c_inverse)
+        pivot = c3[(r, q)] if q <= 10 else c2[(r, q - 11)]
+        coefficient = sp.diff(row, pivot)
+        require(coefficient == 1, f"non-unit leader at {(r, q)}")
+        remainder = sp.expand(row - pivot)
+        require(pivot not in remainder.free_symbols, f"pivot remains in row {(r, q)}")
+        c_inverse[pivot] = sp.cancel(-remainder)
+        pivot_ledger.append({
+            "output_slot": f"K2c_{r}_{q}" if 3 * r + 4 * q >= 97 else f"D2_{r}_{q}",
+            "r": r,
+            "q": q,
+            "pivot": str(pivot),
+            "coefficient": "1",
+        })
+    require(set(c_inverse) == set(c2.values()) | set(c3.values()),
+            "not every original C2/C3 variable solved")
+    original_c_symbols = set(c_inverse)
+    require(all(not expr.free_symbols.intersection(original_c_symbols)
+                for expr in c_inverse.values()),
+            "triangular inverse still references original C2/C3 variables")
+
+    for r, q in lowq_slots:
+        target = (
+            equality_targets.get((r, q), sp.Integer(0))
+            if 3 * r + 4 * q <= 96
+            else sp.Symbol(f"K2c_{r}_{q}")
+        )
+        image = fast_substitute(sp.expand(k2_raw.get((r, q), 0)), c_inverse)
+        require(sp.expand(image - target) == 0, f"forward inverse check failed at {(r, q)}")
+
+    k2c_survivors = sorted(
+        {sp.Symbol(f"K2c_{r}_{q}") for r, q in lowq_slots if 3 * r + 4 * q >= 97},
+        key=str,
+    )
+    require(len(k2c_survivors) == 106, "K2c survivor count before D1 mismatch")
+
+    d1_rows: list[tuple[str, sp.Expr]] = []
+    for W, kmax in ((97, 4), (98, 1)):
+        positions = [(r, q) for r, q in lowq_slots if 3 * r + 4 * q == W]
+        for k in range(kmax + 1):
+            row = sum(comb(q, k) * sp.Symbol(f"K2c_{r}_{q}")
+                      for r, q in positions if q >= k)
+            d1_rows.append((f"h2_D1_W{W}_k{k}", sp.expand(row)))
+
+    pivot_order = [
+        sp.Symbol("K2c_11_16"), sp.Symbol("K2c_15_13"), sp.Symbol("K2c_19_10"),
+        sp.Symbol("K2c_23_7"), sp.Symbol("K2c_27_4"),
+        sp.Symbol("K2c_10_17"), sp.Symbol("K2c_14_14"),
+    ]
+    k2c_d1_map: dict[sp.Symbol, sp.Expr] = {}
+    d1_pivots = []
+    work = list(d1_rows)
+    for variable in pivot_order:
+        selected = None
+        for index, (label, raw_row) in enumerate(work):
+            row = fast_substitute(raw_row, k2c_d1_map)
+            coefficient = sp.diff(row, variable)
+            if coefficient.is_Rational and coefficient != 0:
+                selected = (index, label, row, sp.Rational(coefficient))
+                break
+        require(selected is not None, f"missing h2 D1 pivot: {variable}")
+        index, label, row, coefficient = selected
+        rhs = sp.cancel(-(row - coefficient * variable) / coefficient)
+        k2c_d1_map[variable] = rhs
+        d1_pivots.append({
+            "row": label,
+            "pivot": str(variable),
+            "coefficient": str(coefficient),
+            "rhs": expr_text(rhs),
+        })
+        del work[index]
+        work = [(label0, sp.expand(row0.subs(variable, rhs))) for label0, row0 in work]
+    require(all(fast_substitute(row, k2c_d1_map) == 0 for _label, row in d1_rows),
+            "h2 D1 row did not vanish after substitution")
+
+    c_inverse_after_d1 = {
+        variable: fast_substitute(expr, k2c_d1_map)
+        for variable, expr in c_inverse.items()
+    }
+    free_k2c_after_d1 = sorted(set(k2c_survivors) - set(k2c_d1_map), key=str)
+    require(len(free_k2c_after_d1) == 99, "K2c survivor count after D1 mismatch")
+
+    hmap52, _free52, centre52 = engine.h3_branch_map("delta52")
+    branch52_inverse_after_d1 = {
+        variable: fast_substitute(expr, hmap52)
+        for variable, expr in c_inverse_after_d1.items()
+    }
+    branch52_symbols = set().union(*(expr.free_symbols for expr in branch52_inverse_after_d1.values()))
+    allowed52 = set(free_k2c_after_d1) | {sp.Symbol("u"), sp.Symbol("v"), sp.Symbol("c")}
+    require(branch52_symbols.issubset(allowed52), "delta52 inverse has unexpected symbols")
+
+    inverse_items = sorted((str(variable), expr_text(expr))
+                           for variable, expr in c_inverse_after_d1.items())
+    inverse52_items = sorted((str(variable), expr_text(expr))
+                             for variable, expr in branch52_inverse_after_d1.items())
+    output: dict[str, Any] = {
+        "type": "K2C-INVERSE-C2C3 / EXACT-SYMBOLIC",
+        "engine": {"path": str(ENGINE), "sha256": sha256_file(ENGINE)},
+        "coordinate_definition": (
+            "K2c_r_q = [t^r(w-1)^q](K3^3 + (t^22 C2)K3 + t^33 C3) "
+            "for low q, after the D2 h2 support chart"
+        ),
+        "original_coordinate_counts": {"C2c": len(c2), "C3c": len(c3), "total": len(c2) + len(c3)},
+        "output_rows": {
+            "low_q_nonidentity": len(lowq_slots),
+            "D2_constraint_rows": d2_rows,
+            "K2c_coordinate_rows_before_D1": k2c_rows,
+            "D2_identity_slots": [list(item) for item in d2_identity_slots],
+        },
+        "triangularity": {
+            "order": "(r,-q)",
+            "unit_leader_rule": "C3c_r_q for q<=10; C2c_r_(q-11) for 11<=q<=21",
+            "all_diagonal_coefficients": "1",
+            "all_original_C2C3_variables_solved_once": True,
+            "forward_inverse_symbolic_check": True,
+        },
+        "h2_D1": {
+            "rows": len(d1_rows),
+            "pivots": d1_pivots,
+            "K2c_free_before_D1": len(k2c_survivors),
+            "K2c_free_after_D1": len(free_k2c_after_d1),
+            "forward_D1_symbolic_check": True,
+        },
+        "delta52_specialization": {
+            "centre": centre52,
+            "allowed_symbols": sorted(map(str, allowed52)),
+            "unexpected_symbols": [],
+        },
+        "inverse_after_h2_D1": dict(inverse_items),
+        "inverse_after_h2_D1_sha256": rows_hash(inverse_items),
+        "delta52_inverse_after_h2_D1": dict(inverse52_items),
+        "delta52_inverse_after_h2_D1_sha256": rows_hash(inverse52_items),
+        "pivot_ledger_sha256": rows_hash(sorted((item["pivot"], item["output_slot"]) for item in pivot_ledger)),
+    }
+    payload = (json.dumps(output, indent=2, sort_keys=True) + "\n").encode()
+    path = BASE / "k2c-c2c3-inverse.json"
+    if path.exists():
+        require(path.read_bytes() == payload, f"refusing to change existing {path}")
+    else:
+        path.write_bytes(payload)
+    print(json.dumps({
+        "status": "K2C-INVERSE-PASS",
+        "path": str(path),
+        "sha256": hashlib.sha256(payload).hexdigest(),
+        "original_C2C3_variables": 495,
+        "K2c_free_before_D1": 106,
+        "K2c_free_after_D1": 99,
+        "inverse_after_h2_D1_sha256": output["inverse_after_h2_D1_sha256"],
+        "delta52_inverse_after_h2_D1_sha256": output["delta52_inverse_after_h2_D1_sha256"],
+    }, indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()

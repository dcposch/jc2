+def prepare_workspace() -> dict[str, Any]:
+    require(sha256_file(ENGINE) == PINNED_ENGINE_SHA256, "engine digest mismatch")
+    receipt = fields(GLOBAL_RECEIPT)
+    count = int(receipt["charged_inputs"])

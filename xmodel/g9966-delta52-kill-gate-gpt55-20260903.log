+    ledger_bytes = run_capture([
+        "python3", str(VALIDATOR), "--branch", "delta52", "--run-dir", str(SOURCE_RUN52)
+    ]).stdout
+    require(ledger_bytes == (SOURCE_RUN52 / "validated-ledger.json").read_bytes(),
+            "stage7 ledger is not byte-identical")

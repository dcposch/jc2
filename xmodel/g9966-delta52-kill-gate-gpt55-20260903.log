+            pivot_name = f"K2c_{pivot_slot[0]}_{pivot_slot[1]}"
+            raw_coefficient = next(int(item["coefficient"]) for item in row_terms if item["K2c"] == pivot_name)
+            require(raw_coefficient != 0, "zero raw h2-D1 pivot coefficient")

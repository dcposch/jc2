def redstrip(f):
    d=eng.reduce_lattice(f)
    if not d: return {}, (0,0)
    iw1,iw2=eng.nt+2,eng.nt+4
    a=min(k[iw1] for k in d); b=min(k[iw2] for k in d)
    if a or b:
        d={tuple(x-(a if j==iw1 else b if j==iw2 else 0)
                 for j,x in enumerate(k)):c for k,c in d.items()}
    return d,(a,b)

+\[
+\begin{aligned}
+g_1&=(x_{57}-x_{65})^2uW_1^2+50008x_{53}uW_1+103704x_{72},\\
+g_2&=(x_{57}-x_{65})^2uW_2^2+4803x_{58}uW_2+13955x_{72},\\

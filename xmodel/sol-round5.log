import flint
import valuation_e as VE
from nfq_gates import FIBVARS, EXTRAS, GBDIR, GBF, ev
from nfq_affine import split_affine, Y4, rank, kernel_vec
from det23_minors import parse_payload, to_exp, det, mpd, det4_const

CASES = "/Users/dc/code/math/jc72108/cases"
NCHK = []
def chk(name, cond):
    NCHK.append((name, bool(cond)))
    print(("  PASS " if cond else "  FAIL ") + name, flush=True)
    assert cond, name


def rref(M, p):
    """RREF over F_p; returns (R, pivots, T) with T*M == R (T square)."""
    nr = len(M); nc = len(M[0]) if M else 0
    A = [row[:] + [1 if i == j else 0 for j in range(nr)]
         for i, row in enumerate(M)]
    piv = []
    rk = 0
    for c in range(nc):
        pr = next((r for r in range(rk, nr) if A[r][c]), None)
        if pr is None:
            continue
        A[rk], A[pr] = A[pr], A[rk]
        inv = pow(A[rk][c], p - 2, p)
        A[rk] = [x * inv % p for x in A[rk]]
        for r in range(nr):
            if r != rk and A[r][c]:
                f = A[r][c]
                A[r] = [(A[r][j] - f * A[rk][j]) % p
                        for j in range(len(A[r]))]
        piv.append(c)
        rk += 1
    R = [row[:nc] for row in A]
    T = [row[nc:] for row in A]
    return R, piv, T


def nullspace(M, p):
    """Canonical nullspace basis of M (list of rows) over F_p."""
    R, piv, _ = rref(M, p)
    nc = len(M[0])
    free = [c for c in range(nc) if c not in piv]
    basis = []
    for f in free:
        v = [0] * nc
        v[f] = 1
        for r, c in enumerate(piv):
            v[c] = (-R[r][f]) % p
        basis.append(v)
    return basis, piv, free


def drl_key_pair(k):
    return (sum(k), tuple(-x for x in reversed(k)))


RES = {}
for p in (105337, 105673, 200257):
    print("=" * 64)
    print("p =", p)
    nfs = parse_payload(p)
    ctx = flint.nmod_mpoly_ctx.get(FIBVARS, modulus=p)
    C = [[0] * 4 for _ in range(6)]
    bd6 = []
    carrier = {}
    for j, d in enumerate(nfs):
        cols, bd = split_affine(d)
        for kk, y in enumerate(Y4):
            (key, cf), = cols[y].items()
            fib = tuple((nm, e) for nm, e in key if nm not in EXTRAS)
            if y in carrier:
                assert carrier[y] == fib
            else:
                carrier[y] = fib
            C[j][kk] = cf
        bd6.append(bd)
    bexp = [{to_exp(k): c for k, c in bd.items()} for bd in bd6]
    bpol = [ctx.from_dict(d) for d in bexp]
    mono = {y: ctx.from_dict({to_exp(carrier[y]): 1}) for y in Y4}
    A = [[ctx.from_dict({to_exp(carrier[Y4[k]]): C[j][k]})
          for k in range(4)] for j in range(6)]

    # rank-2 exactness witness: canonical first nonzero 2x2 minor of C
    rkC = rank([r[:] for r in C], p)
    wit = next(((r1, r2, c1, c2)
                for r1, r2 in itertools.combinations(range(6), 2)
                for c1, c2 in itertools.combinations(range(4), 2)
                if (C[r1][c1] * C[r2][c2] - C[r1][c2] * C[r2][c1]) % p),
               None)
    chk("rank(C)=2 with explicit nonzero 2x2 minor %s" % (wit,),
        rkC == 2 and wit is not None)

    # canonical left-kernel of C = nullspace of C^T (4x6)
    Ct = [[C[j][k] for j in range(6)] for k in range(4)]
    U, pivT, freeT = nullspace(Ct, p)
    chk("leftker(C) dim 4 (pivot cols of C^T = %s)" % pivT, len(U) == 4)
    for u in U:
        z = all(sum(u[j] * C[j][k] for j in range(6)) % p == 0
                for k in range(4))
        assert z, "u^T C != 0"
    a = kernel_vec([{tuple(sorted(k)): c for k, c in d.items()}
                    for d in nfs], p)
    # a in leftker(C)?
    chk("NF kernel vector a lies in leftker(C)",
        all(sum(a[j] * C[j][k] for j in range(6)) % p == 0
            for k in range(4)))

    # the 4 canonical conditions u.b; their span; RREF-canonical basis
    bsup = sorted(set().union(*[set(d) for d in bexp]),
                  key=drl_key_pair, reverse=True)
    Bmat = [[bexp[j].get(k, 0) for k in bsup] for j in range(6)]
    Gm4 = [[sum(u[j] * Bmat[j][c] for j in range(6)) % p
            for c in range(len(bsup))] for u in U]
    R4, pivg, T4 = rref(Gm4, p)
    rkG = len(pivg)
    chk("condition space {u.b} has dim 3 (one relation = a-direction)",
        rkG == 3)
    # w_s = condition vectors in leftker(C) giving the RREF g rows
    W3 = []
    for s in range(3):
        w = [sum(T4[s][t] * U[t][j] for t in range(4)) % p
             for j in range(6)]
        W3.append(w)
        assert all(sum(w[j] * C[j][k] for j in range(6)) % p == 0
                   for k in range(4))
    grows = []
    for s in range(3):
        gd = {k: R4[s][c] for c, k in enumerate(bsup) if R4[s][c]}
        # exact recomputation from w and b dicts (independent of Bmat)
        gd2 = {}
        for j in range(6):
            for k, c in bexp[j].items():
                gd2[k] = (gd2.get(k, 0) + W3[s][j] * c) % p
        gd2 = {k: c for k, c in gd2.items() if c}
        assert gd == gd2, "RREF g row != w.b recomputation"
        grows.append(gd)
    stats = [(len(g), max(sum(k) for k in g),
              min(sum(k) for k in g)) for g in grows]
    print("  [g rows] (terms, maxdeg, mindeg):", stats)
    consts = [g.get((0,) * 22, 0) for g in grows]
    print("  [g rows] constant terms:", consts)
    for s, g in enumerate(grows):
        txt = "+".join(
            "%d%s" % (c, "".join("*%s%s" % (FIBVARS[i],
                                            "^%d" % e if e > 1 else "")
                                 for i, e in enumerate(k) if e))
            for k, c in sorted(g.items(), key=lambda kv:
                               drl_key_pair(kv[0]), reverse=True))
        print("    g%d = %s" % (s + 1, txt))
    print("    w vectors:", W3)

    # exact identity: w_s . NF == g_s in the 26-var ring (tg part
    # cancels because w_s^T C = 0) -- dict arithmetic on the payload
    for s in range(3):
        comb = {}
        for j, d in enumerate(parse_payload(p)):
            for k, c in d.items():
                comb[k] = (comb.get(k, 0) + W3[s][j] * c) % p
        comb = {k: c for k, c in comb.items() if c}
        want = {tuple(sorted((FIBVARS[i], e)
                             for i, e in enumerate(k) if e)): c
                for k, c in grows[s].items()}
        assert comb == want, "w.NF != g as 26-var polynomials"
    chk("w_s.NF == g_s exactly (tg terms cancel), s=1..3", True)

    # ---- full 3x3 minor census (200) ------------------------------
    def entry(j, c):
        return A[j][c] if c < 4 else bpol[j]
    nz3 = z3 = 0
    nzlist = []
    span_ws = []
    for R in itertools.combinations(range(6), 3):
        for CC in itertools.combinations(range(5), 3):
            M3 = [[entry(j, c) for c in CC] for j in R]
            D3 = det(ctx, M3)
            dd = mpd(D3)
            if not dd:
                z3 += 1
                continue
            nz3 += 1
            nzlist.append((R, CC, len(dd),
                           max(sum(k) for k in dd)))
            assert 4 in CC, "pure-A 3x3 minor nonzero (rank C > 2?)"
            # cofactor vector w (6-dim, supported in R) for the b column
            i1, i2 = [c for c in CC if c < 4]
            w = [0] * 6
            for pos, r in enumerate(R):
                rows2 = [x for x in R if x != r]
                m2 = (C[rows2[0]][i1] * C[rows2[1]][i2]
                      - C[rows2[0]][i2] * C[rows2[1]][i1]) % p
                w[r] = (m2 if pos % 2 == 0 else -m2) % p
            span_ws.append(w)
            assert all(sum(w[j] * C[j][k] for j in range(6)) % p == 0
                       for k in range(4))
            # D3 == m_i1*m_i2 * (w.b)?
            wb = ctx.from_dict({})
            for j in range(6):
                if w[j]:
                    wb = wb + ctx.from_dict({(0,) * 22: w[j]}) * bpol[j]
            assert mpd(mono[Y4[i1]] * mono[Y4[i2]] * wb) == dd
            # w.b in span(g1..g3)?
            wrow = [sum(w[j] * Bmat[j][c] for j in range(6)) % p
                    for c in range(len(bsup))]
            aug = [row[:] for row in R4[:3]] + [wrow]
            assert rank(aug, p) == 3, "w.b outside span(g)"
    chk("3x3 census: %d nonzero, %d zero; every nonzero = unit-monomial "
        "* combo of g1..g3" % (nz3, z3), nz3 + z3 == 200)
    dim_w = rank([w[:] for w in span_ws], p)
    tstats = sorted({(t, dg) for _, _, t, dg in nzlist})
    print("  [3x3] nonzero minors: %d/200; cofactor-vector span dim %d;"
          % (nz3, dim_w), "(terms,deg) values:", tstats)

    # ---- kill-set evaluation of the g rows ------------------------
    meta, gvars, polys = VE.parse_msolve_out(os.path.join(GBDIR, GBF[p]))
    assert gvars == FIBVARS
    if p == 105337:
        lines = [l for l in open(os.path.join(
            CASES, "directionb_fiber_points_p105337.txt")) if l[0] != '#']
        pts = [[int(x) for x in l.strip().split(',')] for l in lines]
    elif p == 105673:
        pts, _, err = VE.sample_points(p, gvars, polys, want=12, seed=2026)
        assert not err
    else:
        pts = []
    for v in pts:
        assert all(VE._ev(dq, v, p) == 0 for dq in polys)
    nnz = nallz = 0
    prof = []
#!/usr/bin/env python3
"""det23 NONEMPTY step-1, phase 1: parse the banked det23 GBs (md5-matched
to box01) and determine the variety dimension per prime from the grevlex
leading-term staircase.  dim = n - tau where tau = minimum hitting set of
the LT supports (S independent <=> no LT supported inside S <=> the
complement of S hits every LT support).  Exact branch-and-bound.
INTERNAL / UNREVIEWED."""
import sys, os, json
HERE = "/Users/dc/code/math/jc72108/cases"
sys.path.insert(0, HERE)
from valuation_e import parse_msolve_out

PRIMES = (105337, 105673, 200257)

def lt_grevlex(poly, nv):
    """Leading exponent under grevlex (degrevlex): higher total degree wins;
    tie: the LAST variable with differing exponent has the SMALLER exponent
    in the larger monomial."""
    def key(e):
        return (sum(e), tuple(-x for x in reversed(e)))
    return max(poly, key=key)

def min_hitting_set(edges, n):
    """Exact minimum hitting set over ground set range(n); edges = list of
    frozensets.  Branch and bound on an uncovered edge of minimal size."""
    edges = sorted(set(map(frozenset, edges)), key=len)
    best = [n, None]

    def freq_order(rem_edges):
        f = {}
        for e in rem_edges:
            for v in e:
                f[v] = f.get(v, 0) + 1
        return f

    def rec(chosen, rem_edges):
        if not rem_edges:
            if len(chosen) < best[0]:
                best[0] = len(chosen)
                best[1] = set(chosen)
            return
        if len(chosen) + 1 >= best[0]:
            # even one more pick cannot beat best unless it clears all
            # (lower bound 1); tighten with a greedy disjoint-edge bound
            pass
        # lower bound: max matching of pairwise-disjoint uncovered edges
        lb = 0
        used = set()
        for e in rem_edges:
            if not (e & used):
                lb += 1
                used |= e
        if len(chosen) + lb >= best[0]:
            return
        # branch on the smallest uncovered edge
        e0 = min(rem_edges, key=len)
        f = freq_order(rem_edges)
        for v in sorted(e0, key=lambda v: -f.get(v, 0)):
            ne = [e for e in rem_edges if v not in e]
            rec(chosen + [v], ne)
    rec([], edges)
    return best[0], best[1]

def analyze(path, tag):
    meta, gvars, polys = parse_msolve_out(path)
    nv = len(gvars)
    lts = [lt_grevlex(d, nv) for d in polys]
    sups = [frozenset(i for i, e in enumerate(lt) if e) for lt in lts]
    # staircase profile
    from collections import Counter
    degs = Counter(sum(lt) for lt in lts)
    lin = [i for i, lt in enumerate(lts) if sum(lt) == 1]
    tau, hit = min_hitting_set(sups, nv)
    dim = nv - tau
    indep = [gvars[i] for i in range(nv) if i not in hit]
    # verify independence exactly
    S = set(nv - 1 - k for k in [])  # noop
    Sset = {i for i in range(nv) if i not in hit}
    assert all(not (s <= Sset) for s in sups), "independence check failed"
    # maximality check: adding any hit var breaks independence
    maximal = all(any(s <= (Sset | {v}) for s in sups) for v in hit)
    out = {"tag": tag, "path": os.path.abspath(path),
           "sha256": meta["sha256"], "characteristic": meta["characteristic"],
           "n_basis": meta["n_basis"], "n_vars": nv,
           "lt_degree_profile": dict(sorted(degs.items())),
           "n_linear": len(lin),
           "linear_lts": [gvars[next(i for i, e in enumerate(lts[j]) if e)]
                          for j in lin],
           "dimension": dim, "tau": tau,
           "hitting_set": sorted(gvars[i] for i in hit),
           "max_independent_set": sorted(indep),
           "indep_set_maximal": maximal}
    return out

def main():
    res = {}
    for p in PRIMES:
        path = os.path.join(HERE, "directionb_det23_gb_p%d.out.txt" % p)
        r = analyze(path, "det23_p%d" % p)
        res["det23_p%d" % p] = r
        print("det23 p%d: %d els, dim = %d (tau=%d), indep=%s" %
              (p, r["n_basis"], r["dimension"], r["tau"],
               ",".join(r["max_independent_set"])), flush=True)
        print("   LT degree profile %s; linear LTs %s" %
              (r["lt_degree_profile"], r["linear_lts"]), flush=True)
    # control: the fiber GB (expected dim 13 = |FREE|)
    fp = os.path.join(HERE, "directionb_fiber_gb_p105337.out.txt")
    if os.path.exists(fp):
        r = analyze(fp, "fiber_p105337")
        res["fiber_p105337"] = r
        print("fiber p105337 control: %d els, dim = %d, indep=%s" %
              (r["n_basis"], r["dimension"],
               ",".join(r["max_independent_set"])), flush=True)
    outp = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        "dim_report.json")
    json.dump(res, open(outp, "w"), indent=1, sort_keys=True)
    print("wrote", outp)

if __name__ == "__main__":
    main()


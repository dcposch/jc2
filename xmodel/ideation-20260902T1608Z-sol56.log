import importlib.util
from fractions import Fraction as F
spec=importlib.util.spec_from_file_location('msn','box/moh_skeleton_N.py')
z=importlib.util.module_from_spec(spec); spec.loader.exec_module(z)

def group_data(n):
    gd={}
    for m,Ms,V in z.census(n):
        S=z.Skel(n,m,list(Ms),V); key=(m,Ms,V[S.s]); v2=V[2]
        rec=gd.setdefault(key,{'U':F(0),'types':{},'u':int(S.u)})
        rec['U']=max(rec['U'],S.N_upper())
        rec['types'][v2]=int(S.e*v2)*(-S.lam_f(1))
    return gd

def hit4(rec):
    parts=sorted(rec['types'].items(), reverse=True); target=F(4); nodes=0
    def dfs(i,remaining,value):
        nonlocal nodes; nodes+=1
        if value==target:return True
        if i==len(parts) or value>target:return False
        v,w=parts[i]
        for k in range(remaining//v+1):
            nv=value+k*w
            if nv>target: break
            if dfs(i+1,remaining-k*v,nv): return True
        return False
    return dfs(0,rec['u'],F(0)),nodes

for n in (105,108,112,117,120):
    gd=group_data(n); pins=[(k,r) for k,r in gd.items() if F(4)<=r['U']<F(5)]
    surv=[]; nodes=0
    for k,r in pins:
        hit,c=hit4(r);nodes+=c
        if hit:surv.append((k,str(r['U'])))
    print({'D':n,'groups':len(gd),'pin4':len(pins),'permissive_N4_survivors':len(surv),'dfs_nodes':nodes})
    if surv: print(surv[:5])

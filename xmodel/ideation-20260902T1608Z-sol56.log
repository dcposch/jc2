/bin/zsh -lc "python3 - <<'PY'
import importlib.util
from fractions import Fraction as F
from collections import defaultdict
spec=importlib.util.spec_from_file_location('msn','box/moh_skeleton_N.py')
z=importlib.util.module_from_spec(spec); spec.loader.exec_module(z)

def group_data(n):
    gd={}
    for m,Ms,V in z.census(n):
        S=z.Skel(n,m,list(Ms),V); key=(m,Ms,V[S.s])
        q=int(S.e*V[2]); c=-S.lam_f(1); w=q*c
        e=gd.setdefault(key,{'U':F(0),'types':set(),'budget':int(S.u*S.e)})
        e['U']=max(e['U'],S.N_upper()); e['types'].add((q,w,c,tuple(V[i] for i in range(2,S.s+1))))
    return gd

def attainable_four(rec):
    budget=rec['budget']; types={(q,w) for q,w,c,V in rec['types']}
    dp={0:{F(0)}}
    for used in range(budget+1):
        if used not in dp: continue
        base=tuple(dp[used])
        for q,w in types:
            if used+q<=budget:
                dp.setdefault(used+q,set()).update(v+w for v in base if v+w<=4)
    hits=sorted(used for used,vals in dp.items() if F(4) in vals)
    return hits, sum(len(v) for v in dp.values())

for n in (105,108,112,117,120):
    gd=group_data(n); pins=[(k,r) for k,r in gd.items() if F(4)<=r['U']<F(5)]
    surv=[]; maxstates=0
    for k,r in pins:
        hits,states=attainable_four(r); maxstates=max(maxstates,states)
        if hits: surv.append((k,r['U'],hits))
    print({'D':n,'groups':len(gd),'pin4':len(pins),'dp_N4_survivors':len(surv),'max_states':maxstates})
    if surv: print(' survivors',surv[:5])

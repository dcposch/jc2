    98	    conds = dict(top_cancel=ok, ct_nonzero=(ct != 0), roots_distinct=(disc != 0),
    99	                 roots_nonzero=(pi != 0), b_nonzero=(b != 0),
   100	                 b_not_root=(peval(pt, b) != 0))
   101	    return dict(nu=nu, rho=rho, sig=sig, pi=pi, b=b, ct=ct, **conds)

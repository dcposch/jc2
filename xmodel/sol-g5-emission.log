# Proposition 3 arithmetic family.
(0..200).each do |t|
  a = 30*t + 5
  n_child = 9*a - 2
  shift = 13*a - 3
  dp = 3*n_child
  dq = 2*n_child + 1
  raise unless Rational(dp,dq) == Rational(2*(Rational(a,2)+shift), 5*a+shift)
  raise unless (5*a+shift) % 3 == 0

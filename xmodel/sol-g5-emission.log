   211	def check_B(l):
   212	    """Family B (nu=1): p = e^2 - sig e + pi, q = p*s, s monic deg l.
   213	    E := rho*p*s' + (rho-1)*p'*s = ctilde, rho = 2/(2+l).
   214	    Underdetermined (l unknowns-ish vs l constraints with 2 gauge dims);
   215	    exhibit one exact solution with distinct nonzero roots."""
   216	    rho = Fr(2, 2 + l)
   217	    sig = Fr(3)
   218	    # unknowns: pi and s-coeffs e_0..e_{l-1}; equations: deg l..1 of E vanish
   219	    # (top auto-cancels), i.e. l equations, l+1 unknowns -> pick e_0 free.
   220	    # Solve linearly in (pi, e_1..e_{l-1}) for sampled e_0 until distinctness.
   221	    def E_of(pi, svec):
   222	        p = [pi, -sig, Fr(1)]

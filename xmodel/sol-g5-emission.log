   233	        def build(x):
   234	            pi = x[0]; sv = [e0] + list(x[1:]) + []
   235	            return E_of(pi, sv)
   236	        base = build([Fr(0)] * m)
   237	        cols = []
   238	        for j in range(m):
   239	            v = [Fr(0)] * m; v[j] = Fr(1)
   240	            cols.append([a - b for a, b in zip(build(v), base)])
   241	        rows = list(range(l, 0, -1))
   242	        A = [[cols[j][d] for j in range(m)] for d in rows]
   243	        bv = [-base[d] for d in rows]
   244	        M = [row[:] + [c] for row, c in zip(A, bv)]

  raise unless kbar == 6*a-1
  raise unless 2*n_child - 3*kbar == -1
  raise unless dp.gcd(dq) == 3 && n_child.gcd(kbar) == 1
  w = Rational(kbar*(dq-1), n_child*dq)
  raise unless w == Rational(2,3)
  raise unless (3*n_child).gcd(22*a-6) == 1
  raise unless (3*n_child).gcd(9*a-3) == 3
  raise unless 3*a-1 <= 4*a-3
end
# Proposition 2 exhaustive sanity sweep on its stated integer domain.
(5..25).each do |s|

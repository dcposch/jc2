  if line.include?('\\\\['); in_block=true; next end
  if line.include?('\\\\]'); in_block=false; next end
  segs=[]
  segs << line if in_block
  line.scan(/\\\\\\((.*?)\\\\\\)/){|m| segs << m[0]}
  bad=segs.flat_map{|s| s.scan(re)}.uniq
  puts \"#{idx+1}: #{bad.join(', ')} :: #{line.strip}\" unless bad.empty?
end

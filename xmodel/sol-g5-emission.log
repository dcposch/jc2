    37	
    38	def padd(*ps):
    39	    n = max(len(p) for p in ps)
    40	    r = [Fr(0)] * n
    41	    for p in ps:
    42	        for i, x in enumerate(p):
    43	            r[i] += x
    44	    return r
    45	
    46	def pscale(a, c): return [x * c for x in a]
    47	def pderiv(a):    return [a[i] * i for i in range(1, len(a))]
    48	def pshift(a):    return [Fr(0)] + list(a)          # multiply by t
    49	def ptrim(a):
    50	    while len(a) > 1 and a[-1] == 0: a = a[:-1]
    51	    return a
    52	
    53	def peval(a, x):
    54	    r = Fr(0)
    55	    for c in reversed(a): r = r * x + c
    56	    return r
    57	
    58	def merged_E(pt, s, nu, rho):
    59	    """E = rho*pt*s + nu*rho*t*pt*s' + (rho-1)*nu*t*pt'*s (family A)."""
    60	    t1 = pscale(pmul(pt, s), rho)
    61	    t2 = pscale(pshift(pmul(pt, pderiv(s))), nu * rho) if len(s) > 1 else [Fr(0)]
    62	    t3 = pscale(pshift(pmul(pderiv(pt), s)), (rho - 1) * nu)
    63	    return ptrim(padd(t1, t2, t3))

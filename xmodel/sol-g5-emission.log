   188	    ipoly = [c * den for c in poly]
   189	    lead = ipoly[-1]; const = ipoly[0]
   190	    if const == 0: roots.append(Fr(0))
   191	    def divs(n):
   192	        n = abs(int(n)); return [d for d in range(1, n + 1) if n % d == 0] or [1]

   256	        pi = x[0]; s = [e0] + list(x[1:]) + [Fr(1)]
   257	        E = E_of(pi, [e0] + list(x[1:]))
   258	        if len(ptrim(E)) != 1 or E[0] == 0: continue
   259	        p = [pi, -sig, Fr(1)]
   260	        disc = sig * sig - 4 * pi


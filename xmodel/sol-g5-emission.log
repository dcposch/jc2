   103	def check_A_general(nu, l):
   104	    """Family A, general l: solve the linear system for (pi, b_1..b_l) with
   105	    sig fixed (gauge). Unknown vector x = (pi, e_1..e_l) where s(t) =
   106	    t^l + e_{l-1} t^{l-1} + ... (monic; e = elementary-symmetric signs).
   107	    E has degrees l+2 .. 0; top auto-cancels; require t^{l+1}..t^1 = 0:
   108	    l+1 equations, l+1 unknowns. Linear in (pi, s-coeffs) jointly? E is
   109	    bilinear (pt has pi linearly; s linear in its coeffs) -> product terms
   110	    pi*e_j appear: NOT linear. Solve by iterating: treat as linear in
   111	    s-coeffs for fixed pi, then 1-d root-hunt in pi over Q via the last
   112	    equation's numerator (rational function of pi -> polynomial)."""
   113	    rho = Fr(2 * nu, (l + 2) * nu + 1)
   114	    sig = Fr(3)
   115	    def sys_for_pi(pi):
   116	        # unknowns: s coeffs e_0..e_{l-1} (monic s). Equations: E_{l+1}..E_1.
   117	        # Build E for basis vectors.
   118	        def E_of(svec):
   119	            pt = [pi, -sig, Fr(1)]
   120	            s = list(svec) + [Fr(1)]
   121	            E = merged_E(pt, s, nu, rho)
   122	            E += [Fr(0)] * (l + 3 - len(E))
   123	            return E
   124	        base = E_of([Fr(0)] * l)
   125	        cols = []
   126	        for j in range(l):
   127	            v = [Fr(0)] * l; v[j] = Fr(1)
   128	            cols.append([a - b for a, b in zip(E_of(v), base)])
   129	        # rows for degrees l+1 .. 1  (l+1 rows), unknowns l -> overdetermined
   130	        # by 1 for fixed pi; solve top l rows, return residual of last row.
   131	        rows = list(range(l + 1, 0, -1))
   132	        A = [[cols[j][d] for j in range(l)] for d in rows]
   133	        bvec = [-base[d] for d in rows]
   134	        # Gaussian elimination on first l rows
   135	        M = [row[:] + [bv] for row, bv in zip(A[:l], bvec[:l])]
   136	        n = l
   137	        for i in range(n):
   138	            piv = next((r for r in range(i, n) if M[r][i] != 0), None)
   139	            if piv is None: return None
   140	            M[i], M[piv] = M[piv], M[i]
   141	            for r in range(n):
   142	                if r != i and M[r][i] != 0:
   143	                    f = M[r][i] / M[i][i]
   144	                    M[r] = [a - f * b for a, b in zip(M[r], M[i])]
   145	        sol = [M[i][n] / M[i][i] for i in range(n)]
   146	        res = sum(A[l][j] * sol[j] for j in range(l)) - bvec[l]
   147	        return sol, res
   148	    # residual as function of pi: rational; find rational roots by scanning a
   149	    # polynomial fit: sample l+3 points, interpolate numerator via differences.
   150	    # Simpler: scan a modest rational grid and also solve res(pi)=0 by
   151	    # bisection-free exact interpolation (res is a rational function; its
   152	    # numerator is a polynomial of low degree in pi). Sample and interpolate:
   153	    pts = []
   154	    for num in range(-40, 41):
   155	        pi = Fr(num, 6)
   156	        if pi == 0: continue
   157	        out = sys_for_pi(pi)
   158	        if out is None: continue

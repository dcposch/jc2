    65	def check_A_l1(nu):
    66	    """Family A, l=1: pt = t^2 - sig*t + pi, s = t - b, rho = 2nu/(3nu+1).
    67	    Coefficient equations (t^2, t^1 of E vanish) solved in closed form."""
    68	    rho = Fr(2 * nu, 3 * nu + 1)
    69	    sig = Fr(3)                                     # scaling gauge
    70	    # t^2:  -rho(sig+b) - nu rho sig + nu(rho-1)(2b+sig)... solve linearly:
    71	    # E2 = rho*(-(sig+b)) + nu*rho*(-sig) ... derive numerically instead:
    72	    # unknowns (pi, b): solve the 2x2 linear system by elimination on a grid
    73	    # of symbolic seeds -> here direct: E is linear in (pi, b) jointly? E2 is
    74	    # linear in b (pi absent), E1 linear in (pi, sig*b). Do it exactly:
    75	    # E2 coeff: rho*(coef) ... build with symbols via two-point interpolation.
    76	    def E_coeffs(pi, b):
    77	        pt = [pi, -sig, Fr(1)]
    78	        s = [-b, Fr(1)]
    79	        E = merged_E(pt, s, nu, rho)
    80	        E += [Fr(0)] * (4 - len(E))
    81	        return E
    82	    # E2, E1 are affine in (pi, b): sample basis
    83	    E00 = E_coeffs(Fr(0), Fr(0)); Ep = E_coeffs(Fr(1), Fr(0)); Eb = E_coeffs(Fr(0), Fr(1))
    84	    # rows: [dE/dpi, dE/db, const] for degrees 2 and 1
    85	    import itertools
    86	    a11, a12, c1 = Ep[2] - E00[2], Eb[2] - E00[2], E00[2]
    87	    a21, a22, c2 = Ep[1] - E00[1], Eb[1] - E00[1], E00[1]
    88	    det = a11 * a22 - a12 * a21
    89	    if det == 0: return None

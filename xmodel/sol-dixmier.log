  3324	
  3325	ii) $c_0\in K$  is given by the formula 
  3326	$$
  3327	c_0=(\sum_{i=0}^{I-1} \ord (Q_i))\cdot \frac{(p-1)}{2p}
  3328	$$
  3329	(recall that we put all $n_i=p=nd$ in Step 3). 
  3330	\end{lemma}
  3331	
  3332	\begin{proof}
  3333	The highest coefficient of the tail component we know from formula \eqref{E:tildeQ_N,I}. 
  3334	To find other coefficients let's use induction.  The tail component of the operator $\tilde{Q}_{N,0}$ in vector form is 
  3335	$(-\Gamma_1/\tilde{p} + (0, 1/\tilde{p}, \ldots , (\tilde{p}-1)/\tilde{p}))\tilde{D}^{-\tilde{p}}$ according to lemma \ref{L:Q_p}.  The tail component of the operator $\tilde{Q}_{N,1}$ in vector form is 
  3336	\begin{multline*}
  3337	 \sum_{i=0}^{p-1}\tilde{D}^{i\ord (Q_{N,0})}(-\Gamma_1/\tilde{p} +(0, 1/\tilde{p}, \ldots , (\tilde{p}-1)/\tilde{p})\tilde{D}^{-\tilde{p}+ (p-1-i)\ord (Q_{N,0})}= \\
  3338	 \sum_{i=0}^{p-1}(-(\Gamma_1+i\ord (Q_{N,0}))/\tilde{p} +\sigma^{-i\ord (Q_{N,0})}((0, 1/\tilde{p}, \ldots , (\tilde{p}-1)/\tilde{p})))=\\
  3339	p(-\Gamma_1/\tilde{p}-\frac{\ord (Q_{N,0})}{\tilde{p}}\cdot \frac{(p-1)}{2} +\tilde{u}_1)\tilde{D}^{-\tilde{p}+(p-1)\ord (Q_{N,0})},
  3340	\end{multline*}
  3341	where $\tilde{u}_1$ is the $GCD(\tilde{p}, \ord Q_{N,0})$-symmetrization of $(0, 1/\tilde{p}, \ldots , (\tilde{p}-1)/\tilde{p})$. By induction, the tail component of the operator $\tilde{Q}_{N,i}$ in vector form is
  3342	$$
  3343	\epsilon_1^{p-1}\cdots \epsilon_{i-1}^{p-1} p^i(-\Gamma_1/\tilde{p}-\frac{\sum_{j=0}^{i-1}\ord (Q_{N,j})}{\tilde{p}}\cdot \frac{(p-1)}{2} +\tilde{u}_i)\tilde{D}^{-\tilde{p}+(p-1)\sum_{j=0}^{i-1}\ord (Q_{N,j})},
  3344	$$
  3345	where $\tilde{u}_i$ is the $SeqGCD_{i-1}(\Phi_{N,1}(P_n),\Phi_{N,1}(Q_n))$-symmetrization of $(0, 1/\tilde{p}, \ldots , (\tilde{p}-1)/\tilde{p})$. Then the tail component of the operator $\tilde{Q}_{N,i+1}$ in vector form is 
  3346	\begin{multline*}
  3347	\epsilon_1^{p-1}\cdots \epsilon_{i-1}^{p-1}\epsilon_{i}^{p-1} p^i \sum_{k=0}^{p-1}\tilde{D}^{k\ord (Q_{N,i})}(-\Gamma_1/\tilde{p} -\frac{\sum_{j=0}^{i-1}\ord (Q_{N,j})}{\tilde{p}}\cdot \frac{(p-1)}{2}\\+\tilde{u}_i)\tilde{D}^{-\tilde{p}+ (p-1)\sum_{j=0}^{i-1}\ord (Q_{N,j}) + (p-1-k)\ord (Q_{N,i})}= \\
  3348	 \epsilon_1^{p-1}\cdots \epsilon_{i-1}^{p-1}\epsilon_{i}^{p-1} p^{i+1} (-\Gamma_1/\tilde{p}-\frac{\sum_{j=0}^{i}\ord (Q_{N,j})}{\tilde{p}}\cdot \frac{(p-1)}{2} +\tilde{u}_{i+1})\tilde{D}^{-\tilde{p}+ (p-1)\sum_{j=0}^{i}\ord (Q_{N,j})},
  3349	\end{multline*}
  3350	whence we get the claim of lemma with 
  3351	$$
  3352	 \epsilon_1^{p-1}\cdots \epsilon_{I-1}^{p-1} p^{I}=\epsilon_I(dn-ln) 
  3353	$$
  3354	by formula \eqref{E:tildeQ_N,I}, and the formula for $c_0$ holds because $\ord (Q_{N,j})=(d_2N+l_2)\ord (Q_j)/d_2$.
  3355	\end{proof}
  3356	
  3357	
  3358	So, the "body-tail" decomposition of the operator $\tilde{Q}_{N,I}$ looks like 
  3359	\begin{multline*}
  3360	\tilde{Q}_{N,I}=(\epsilon_I\partial^{\Ord (\tilde{Q}_{N,I})}+\tilde{q}\partial^{\Ord (\tilde{Q}_{N,I})-N}+
  3361	\epsilon_I((-dn+ln)(\tilde{u}-c_0) +(\sigma^{-\ord Q_{N,I}}(u)-u)+\\
  3362	A\frac{N^2}{Nd+l}+B\frac{N}{Nd+l}+C\frac{1}{Nd+l} +b)\partial^{\Ord (\tilde{Q}_{N,I})-1-N}+\ldots )+ \\
  3363	\epsilon_I(-dn+ln)(\Gamma_1/\tilde{p}-\tilde{u}+c_0)\partial^{\ord ({Q}_{N,I})-1-N}+\ldots 
  3364	\end{multline*}
  3365	Hence, first terms of the operator $\tilde{Q}_{N,I}'$ are 
  3366	\begin{multline*}
  3367	\tilde{Q}_{N,I}'= \epsilon_I\partial^{\Ord (\tilde{Q}_{N,I})}+\tilde{q}\partial^{\Ord (\tilde{Q}_{N,I})-N}+
  3368	\epsilon_I((-dn+ln)(\tilde{u}-c_0) +(\sigma^{-\ord Q_{N,I}}(u)-u)+\\
  3369	A\frac{N^2}{Nd+l}+B\frac{N}{Nd+l}+C\frac{1}{Nd+l} +b)\partial^{\Ord (\tilde{Q}_{N,I})-1-N}+\ldots 
  3370	\end{multline*}
  3371	
  3372	
  3373	
  3374	{\it Step} 7. Now we can calculate the distinguished coefficient $c_{N,I;r(I)}$. To find it, we need to find the result of conjugation of $\hat{\Phi}(\tilde{Q}_{N,I}')$ by the auxiliary operator $\tilde{S}$ from lemma \ref{L:invariant_conjugation}. According to the proof of this lemma, $\tilde{S}$ can be represented as a product of elementary operators $\tilde{S}_i=1+s_i\tilde{D}^{-i}$. In our case obviously 
  3375	$i\ge N$. Note that conjugation by $\bar{S}_{N}$ does not affect the homogeneous component of the operator $\hat{\Phi}(\tilde{Q}_{N,I}')$ of order $\Ord \tilde{Q}_{N,I}-N-1$, so we need to find only to find the result of conjugation by the auxiliary operator $\bar{S}_{N+1}$. This is just the averaging of components of its vector components. 
  3376	
  3377	The averaging of the vector components of the term $(\sigma^{-\ord Q_{N,I}}(u)-u)$ is obviously zero. So, we need only to calculate the averaging of $\tilde{u}$ from lemma \ref{L:tail}. It is equal to
  3378	$$
  3379	\frac{1}{\tilde{d}}(\sum_{i=0}^{\tilde{d}-1}a_i)=\frac{n\tilde{d}_1-1}{2n\tilde{d}_1}+\frac{(\tilde{d}-1)}{2\tilde{p}}
  3380	$$
  3381	Combining all terms together, we get
  3382	$$
  3383	c_{N,I;r(I)}=\epsilon_I((-dn+ln)(\frac{1}{2}-\frac{1}{2n (Nd+l)} -(\sum_{i=0}^{I-1} \ord (Q_i))\cdot \frac{(p-1)}{2p})+A\frac{N^2}{Nd+l}+B\frac{N}{Nd+l}+C\frac{1}{Nd+l} +b).
  3384	$$
  3385	It remains to note that this expression non-trivially depends on $N$ (as $A\neq 0$) -- a contradiction with lemma \ref{L:distinguished coefficients}.
  3386	
  3387	
  3388	So, there are no DC-pairs, and $\End (A_1)\backslash 0=\Aut (A_1)$. 

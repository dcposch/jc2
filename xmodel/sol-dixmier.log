  1245	The correspondences in theorem \ref{T:classif_Schur_pairs} are constructed as follows: in one way (from $B$ to $(A,W)$) with the help of the classical Schur operator mentioned above, and in another way via Sato theorems below. 
  1246	The following statements are due to M. Sato \cite{SN}, cf. \cite[Appendix]{Mu}. 
  1247	
  1248	\begin{Prop}
  1249	\label{P:Sato}
  1250	If $G\subset E$ is a subring that stabilises $F=K[\partial ]$, i.e. for each operator $P\in G$ holds $F\cdot P\subseteq F$ (cf. \eqref{E:Sato_hom}), then $G\subseteq D_1$.
  1251	\end{Prop}
  1252	
  1253	\begin{theorem}
  1254	\label{T:Sato}
  1255	Let $W$ be a subspace in the space $K((z))\simeq K((\partial^{-1}))$ with $\Sup W=K[z^{-1} ]$. Then there exists a unique Sato operator, i.e. a zero-th order invertible operator $S=1+s_1\partial^{-1}+\ldots \in E$, such that $W=F\cdot S$. 
  1256	\end{theorem}

   829	\begin{Def}{(\cite[Def. 2.3]{GZ1})}
   830	\label{D:HCP}
   831	Let's fix some $k\in \dn$. Assume $\xi$ is the $k$-primitive root, $A_i=A_{k,i}$. Let $\tilde{K}=K[\xi]$. An element $H\in \hat{D}_{1}^{sym}\hat{\otimes}_K\tilde{K}$ is  called {\it homogeneous canonical polynomial  (in short of HCP)}  if $H$ can be written in the form
   832		\begin{equation}
   833		\label{E:HCP}
   834		H=[\sum_{0\leq i<k}f_{i;r}(x, A_{k;i}, \partial )+\sum_{0<j\leq N}g_{j;r}B_{j}]D^{r}
   835		\end{equation}
   836		for some $N\in\dn$, $r\in \dz$, where 
   837		
   838			1. $f_{i;r}(x, A_{k;i}, \partial)$ is a polynomial of $x, A_{k;i},\partial$,  $\Ord(f_{i;r})=0$,  of the form
   839			$$
   840			f_{i;r}(x, A_{k;i}, \partial )=\sum_{0\leq l\leq d_{i}}f_{l,i;r}x^l A_{k;i}\partial^l
   841			$$
   842			for some $d_i\in \dz_+$, where $f_{l,i;r}\in \tilde{K}$. The number  $d_i$ is called the {\it $x$-degree of $f_{i;r}$}:  $deg_{x}(f_{i;r}):= d_i$.
   843			
   844			2. $g_{j;r}\in \tilde{K}$.
   845			
   846			3. $g_{j;r}=0$ for $j\le -r$ if $r<0$. 
   847		
   848		
   849	In particular, $H$ is homogeneous and $\Ord (H)=r$. 
   850	\end{Def}
   851	
   852	The form \eqref{E:HCP} of HCP from definition is uniquely defined:
   853	
   854	\begin{lemma}{(\cite[Lem. 2.6]{GZ1})}
   855	\label{L:correct_HPC}
   856	Let $H$ be a HCP. Then $H=0$ iff $g_{j;r}=0$ for all $j$ and $f_{l,i;r}=0$ for all $i,l$. 
   857	
   858	In particular, any HCP can be uniquely written in the form \eqref{E:HCP}.
   859	\end{lemma}
   860	
   861	\begin{Def}{(\cite[Def. 2.4]{GZ1})}	
   862	\label{D:Sdeg_A}
   863	Let $H$ be a HCP. We define 
   864	$$Sdeg_A(H)=\max \{d_i|\quad 0\leq i<k \} \quad \mbox{or $-\infty$, if all $f_{l,i;r}=0$ } 
   865	$$
   866	and 
   867	$$Sdeg_B(H)=\max\{j|\quad g_{j;r}\neq0\} \quad \mbox{or $-\infty$, if all $g_{j;r}=0$}
   868	$$
   869	
   870	We define a  {\it homogeneous canonical polynomial combination} (in short HCPC) as a finite sum of HCP (of different orders).
   871	We extend the functions $Sdeg_A$, $Sdeg_B$ in an obvious way to all HCPCs. 
   872	
   873	We'll say that a HCPC $H$ {\it doesn't contain $A_i$} if $f_{l,i;r}=0$ for all $i>0$ and all $r$. We'll say that a HCPC $H$ {\it doesn't contain $B_j$} if $Sdeg_B(H)=-\infty$.
   874	\end{Def}
   875	

   771	\begin{Def}{(cf. \cite{A.Z}, Def. 6.4)}
   772	\label{D:regular}
   773	An element $P \in \hat{D}_1^{sym}$ is called \emph{regular} if the $K$--linear map $F \xrightarrow{ (-\circ \sigma(P))} F$ is injective, where $\circ$ means the action on the module $F$. In particular, $P$ is regular if and only if its symbol $\sigma(P)$ is regular.
   774	\end{Def}

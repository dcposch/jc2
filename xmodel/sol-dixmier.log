   798	We define a series of operators $B_i$:  $B_{1}:=\delta, B_{2}:=x\delta \partial ,\ldots, B_{n}:=\frac{1}{(n-1)!}x^{n-1}\delta \partial^{n-1}$, and  $B_j:=0$ for any $j\leq 0$. Define $\Gamma_i=(x\partial)^i$ for $i\ge 0$, and for $i<0, \Gamma_i=0$. For convenience, we introduce also a new notation: for any integer $n$ we set  $D^n=\partial^n$ if $n\ge 0$ and $D^n=\int^{-n}$  otherwise. Obviously, we have $\partial \delta=\delta x=0$ and $\Ord(B_{j})=0$ for any $j \in \mathbb{N}$. From this observation and definition of $\delta$ we also get $\delta\delta=\delta$. 
   799	
   800	\begin{lemma}{(\cite[Lemma 2.5]{GZ1})}
   801		\label{L:1}
   802		For a fixed $k\in \dn$ let $A_i=A_{k;i}$, $\xi$ be the $k$-primitive root, $B_j$ are defined as above. Then we have
   803		\begin{enumerate}
   804			\item $A_{i} B_{j}=B_{j} A_{i}=\xi^{i(j-1)}B_{j}$ for any $i,j \in \mathbb{N}$;
   805			\item 
   806		$$
   807	\int x^m = \frac{m!}{(m+1)!}x^{m+1} + \sum_{i=1}^{\infty}(-1)^i \frac{m!}{(m+i+1)!}x^{m+i+1}\partial^i;
   808	$$
   809		In particular, $\int x^m\delta = \frac{1}{m+1}x^{m+1}\delta$;
   810			\item $\int^{m} \partial^{m}=1-\sum_{k=1}^{m}B_{k}$ for any $m \in \mathbb{N}$;
   811			\item 
   812			$$\int^u f(x)=f(x)\int^u +
   813			\sum_{l=1}^{\infty}\binom{-u}{l}f(x)^{(l)}\int^{u+l}$$ for any  $f(x)\in \hat{R}$, $u\in\dn$;
   814			
   815			\item $B_i B_j=\delta_i^jB_j$, where $\delta_i^j$ is the Kronecker delta;
   816			
   817			\item $A_i\Gamma_j=\Gamma_jA_i$;
   818			\item $$
   819			D^i\Gamma_j=\sum_{l=0}^{j}\binom{j}{l}i^{j-l}\Gamma_lD^i, \quad \Gamma_jx^i=x^i(\sum_{l=0}^j\binom{j}{l}i^{j-l}\Gamma_l)
   820			$$
   821			\item $\Gamma_iB_j=B_j\Gamma_i=(j-1)^iB_j$;
   822			\item $D^u B_j=B_{j-u}D^u$. In particular, $D^u B_j=B_{j-u}D^u=0$ if $u>0$ and $j-u\le 0$ or $u<0$ and $j\le 0$.
   823		\end{enumerate}	
   824		where we assume in all these formulae that $0^0:=1$.
   825	\end{lemma}

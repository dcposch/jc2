   975	\begin{Def}
   976	\label{D:normal_form}
   977	For a given pair of operators $Q,P\in D_1$ with $\Ord (Q)=\ord (Q)=q> 0$, $\Ord (P)=\ord (P)=p\ge 0$ we define a {\it normal form} of $P$ with respect to $Q$ as the operator $P':=S^{-1}PS$, where $S$ is a Schur operator for $Q$ from proposition \ref{T:A.Z 7.2}, i.e. $S^{-1}QS=\partial^q$, $\Ord (S)=0$. 
   978	\end{Def} 
   979	
   980	\begin{rem}
   981	\label{R:normal_forms}
   982	The Schur operator is not uniquely defined, but up to multiplication by the elements of the centralizer  $C(\partial^q)\subset \hat{D}_1^{sym}$ from proposition \ref{T:A.Z 7.1}. By this reason the normal form of the operator $P$  is  not uniquely defined, but up to conjugation by elements from this centralizer. 
   983	
   984	If $\sigma (Q)=\partial^{\Ord (Q)}$, $c\in K$ (this is the case we'll usually deal with), then there exists a monic  Schur operator (i.e. $S_0=1$). Indeed, in this case  $\sigma (S)\partial^q=\partial^q\sigma (S)$, so that $\sigma (S)\in C(\partial^q)$, $\sigma (S)$ is invertible and we can divide on $\sigma (S)$ if necessary. In this case we also can assume $S_{-1}=0$ (see proposition \ref{T:A.Z 7.2}, item 2).
   985	\end{rem}
   986	
   987	
   988	
   989	\begin{Def}{(\cite[Def. 2.8]{GZ1})}
   990	\label{D:conditionA}
   991	We'll say that an operator $P\in  \hat{D}_1^{sym}\hat{\otimes}_K\tilde{K}$ satisfies {\it condition $A_q(k)$}, $q,k\in \dz_+$, $q>1$ if 
   992	\begin{enumerate}
   993	\item
   994	$P_{t}$ is a HCP  from $Hcpc (q)$  for all $t$;
   995	\item
   996	$P_{t}$ is totally free of $B_j$ for all $t$;
   997	\item
   998	$Sdeg_A(P_{\Ord (P)-i})< i+k$ for all $i>0$;
   999	\item
  1000	$\sigma (P)$ does not contain $A_{q;i}$, $Sdeg_A(\sigma (P))=k$.
  1001	\end{enumerate}
  1002	\end{Def}
  1003	
  1004	\begin{ex}
  1005	\label{Ex:Schur_op}
  1006	From proposition \ref{P:Si} an corollary \ref{C:Si^(-1) no B} we know that $S, S^{-1}$ satisfy condition $A_q(0)$, where $S$ is any monic Schur operator for normalised $Q\in D_1$. Moreover, if $S$ is a monic operator from $\hat{D}_1^{sym}$ of order zero satisfying condition $A_q(0)$ (but not necessary with $S_{-1}=0$), then $S^{-1}$ also satisfies the same properties. The proof is just the same as in \cite[Cor. 2.3]{GZ1}. 
  1007	\end{ex}

   936	\begin{Prop}{(\cite[Prop. 2.4]{GZ1})}
   937	\label{P:lower estimate}
   938	Suppose 
   939	$$
   940	0\neq H=\sum_{i=0}^{k-1}\sum_{m=0}^da_{m,i}A_i\Gamma_m\int^u.
   941	$$ 	
   942	is a HCP  from $Hcpc(k)$,  with $\Ord(H)=-u<0$. Then $H$ is totally free of $B_j$ iff the linear system of equations on $a_{m,i}$ holds:
   943	\begin{equation}
   944	\label{E:system_on_B_j}
   945	\sum_{i=0}^{k-1}\sum_{m=0}^d\xi^{i(j-1)}(j-1)^ma_{m,i}=0
   946	\end{equation}
   947	for any $1\leq j\leq u$.

   910	\begin{lemma}{(\cite[Lem. 2.10]{GZ1})}
   911			\label{L:HCPC}
   912		Suppose $H,M$ are two  HCPCs. Then $T:=HM$ is also a HCPC, what's more we have 
   913		\begin{enumerate}
   914			\item $Sdeg_A(T)\leq Sdeg_A(H)+Sdeg_A(M)$ (here we assume $-\infty +n=-\infty$). 
   915			\item 
   916			if $H,M$ are two  HCPs then
   917			\begin{enumerate}
   918				\item If $\Ord(H)\geq 0$, then $Sdeg_B(T)\leq \max \{Sdeg_B(H),Sdeg_B(M)\}$
   919				\item If $\Ord(H)< 0$, then $Sdeg_B(T)\leq \max \{Sdeg_B(H),Sdeg_B(M)-\Ord(H),-\Ord(H)\}$
   920			\end{enumerate}
   921		\end{enumerate}

   952	\begin{Prop}{(\cite[Prop. 2.5]{GZ1})}
   953		\label{P:Si}
   954		Let $Q\in D_1$ be a normalized operator, assume $S\in \hat{D}_{1}^{sym}$ is a Schur operator for $Q$ from proposition \ref{T:A.Z 7.2}, i.e.  $S^{-1}QS=\partial^q$, such that   $S_{0}=1,S_{-1}=0$. Then we have 
   955		\begin{enumerate}
   956			\item $S_{-t}$ is a HCP from $Hcpc(q)$ for any $t\ge 0$ (i.e. it can be written as a HCP in $\hat{D}_1^{sym}\hat{\otimes}_K\tilde{K}$).
   957			\item If $S_{-t}\neq 0$ then $\frac{t}{q}-1< Sdeg_A(S_{-t})<t$ for any $t> 0$.
   958			\item $S_{-t}$ is totally free of $B_j$ for any $t\ge 0$.
   959			\end{enumerate}
   960	\end{Prop} 
   961	
   962	\begin{cor}{(\cite[Cor. 2.3]{GZ1})}
   963		\label{C:Si^(-1) no B}
   964	In the notation of proposition \ref{P:Si} set $\tilde{S}=S^{-1}$. Then we have 
   965		\begin{enumerate}
   966		\item $\tilde{S}_0=1$, $\tilde{S}_{-1}=0$.
   967			\item $\tilde{S}_{-t}$ is a HCP from $Hcpc(q)$ for any $t\ge 0$.
   968			\item If $S_{-t}\neq 0$ then $\frac{t}{u}-1< Sdeg_A(\tilde{S}_{-t})<t$ for any $t> 0$.
   969			\item $\tilde{S}_{-t}$ is totally free of $B_j$ for any $t\ge 0$. 
   970		\end{enumerate}
   971	\end{cor}

   879	
   880	\begin{lemma}{(\cite[Lem. 2.7]{GZ1})}
   881	\label{L:obvious}
   882		Suppose $H$ and $M$ are two HCPCs, $k_1,k_2\in \tilde{K}$ are two arbitrary constant. Then $T=k_1H+k_2M$ is also a HCPC, with 
   883		$$
   884		Sdeg_A(T)\leq \max\{Sdeg_A(H), Sdeg_A(M) \}
   885		$$$$
   886		Sdeg_B(T)\leq \max\{Sdeg_B(H), Sdeg_B(M) \}
   887		$$
   888	\end{lemma}
   889	
   890	\begin{lemma}{(\cite[Cor. 2.1]{GZ1})}
   891	\label{C:HCPC(k)}
   892		For a fixed $k$ all $HCPCs$  form a subring in the ring $\hat{D}_1^{sym}\hat{\otimes}_K\tilde{K}$.
   893	\end{lemma}
   894	

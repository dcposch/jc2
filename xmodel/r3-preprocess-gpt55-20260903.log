+        audit["rows"].append(
+            {
+                "row": [n, m, M2, s, k],
+                "f_degree": 2 * s,
+                "g_degree": 3 * s,
+                "r3_unknowns_including_c": 5 * s + 1,
+                "r3_equations": 5 * s - 1,

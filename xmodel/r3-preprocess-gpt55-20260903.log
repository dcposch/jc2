import sympy as sp

def h_coeffs(s, first):
    M=2*s; N=3*s; upto=5*s-1
    aa=list(sp.symbols(f'F1:{M+1}'))
    coeff=[sp.Integer(0)]*(first-1)+[sp.Integer(1)]+aa[first:]
    vars=aa[first:]
    h=[sp.Integer(1)]
    d=2; e=3
    for n in range(1,upto+1):
        val=0
        for i in range(1,min(M,n)+1):
            val += (d*(n-i)-e*i)*coeff[i-1]*h[n-i]
        h.append(sp.cancel(-val/(d*n)))
    tails=[sp.factor(x) for x in h[N+1:5*s-1]]
    kap=sp.factor(h[5*s-1])
    return vars,tails,kap
for s in [6,7,8]:

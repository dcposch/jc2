            coefficient,
            remainder,
        ) = choice
        rhs = sp.expand(-remainder / coefficient)
        if variable in rhs.free_symbols:
            raise AssertionError("pivot right side contains pivot variable")
        if sp.expand(pivot_row.expr.subs(variable, rhs)) != 0:

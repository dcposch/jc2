import sympy as sp, time

def build(s):
    y,c=sp.symbols('y c')
    a=list(sp.symbols(f'a0:{2*s}'))
    b=list(sp.symbols(f'b0:{3*s}'))
    f=y**(2*s)+sum(a[j]*y**j for j in range(2*s))
    g=-(y**(3*s)+sum(b[j]*y**j for j in range(3*s)))
    E=sp.Poly(sp.expand(2*f*sp.diff(g,y)-3*sp.diff(f,y)*g-c), y)
    rows=[]
    for (mon,), co in zip(E.monoms(), E.coeffs()):
        if co"'!=0:
            rows.append((mon, sp.expand(co)))
    # sort descending y degree as coefficient equations from high to low
    return a+b, c, rows

def affine(expr,var):
    if var not in expr.free_symbols: return None
    coeff=sp.expand(sp.diff(expr,var))
    if not coeff.is_Rational or coeff==0: return None
    rem=sp.expand(expr-coeff*var)
    if var in rem.free_symbols: return None
    return coeff, rem

def reduce(s):
    vars,c,rows=build(s)
    piv=[]; t=time.time(); zero=[]
    # rows already descending. Try variables in original order? also maybe highest variables first better.
    while True:
        choice=None
        for ri,(deg,expr) in enumerate(rows):
            for vi,var in enumerate(vars):
                af=affine(expr,var)
                if af:
                    choice=(ri,vi,deg,expr,var,af[0],af[1]); break
            if choice: break
        if not choice: break
        ri,vi,deg,expr,var,coef,rem=choice
        rhs=sp.expand(-rem/coef)
        piv.append((deg,var,coef,rhs))
        del rows[ri]; del vars[vi]
        new=[]
        for d,e in rows:
            if var in e.free_symbols:
                e=sp.expand(e.subs(var,rhs))
            if e==0: zero.append(d)
            else: new.append((d,e))
        rows=new
        print('"'s',s,'pivot',len(piv),'deg',deg,'var',var,'coef',coef,'remain rows/vars',len(rows),len(vars),'bytes',sum(len(str(e)) for _,e in rows), flush=True)
        if time.time()-t>60: print('timeout loop'); break
    print('RESULT s',s,'piv',len(piv),'rows',len(rows),'vars',len(vars),'first rows')
    for d,e in rows[:10]: print(' deg',d,'expr',e)
    return vars,c,rows,piv
for s in [6,7,8]:
    reduce(s)

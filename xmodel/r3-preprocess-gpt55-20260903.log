+        )
+    path = HERE / "r3_preprocess_audit.json"
+    path.write_text(json.dumps(audit, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    return path
+
+
+def run_singular(path: pathlib.Path, timeout: int) -> dict:
+    started = time.monotonic()

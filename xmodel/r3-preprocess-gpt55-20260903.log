/bin/bash -lc "python3 - <<'PY'
import sympy as sp

def solve_centered(s):
    z=sp.symbols('z')
    Fvars=sp.symbols(f'F1:{2*s+1}') # F1..F2s
    Gvars=sp.symbols(f'G1:{3*s+1}')
    F=[sp.Integer(1)]+list(Fvars)
    G=[sp.Integer(1)]+list(Gvars)
    # equations W_k=0 for k=0..5s-3
    eqs=[]
    for k in range(0,5*s-2):
        total=0
        for i in range(max(0,k+1-3*s), min(2*s,k+1)+1):
            j=k+1-i
            total += (2*j-3*i)*F[i]*G[j]
        eqs.append(sp.expand(total))
    subs={Fvars[0]:0, Fvars[1]:1} if 2*s>=2 else {Fvars[0]:0}
    eqs2=[sp.expand(e.subs(subs)) for e in eqs]
    vars=[v for v in list(Gvars)+list(Fvars) if v not in subs]
    print('s',s,'eqs',len(eqs2),'vars',len(vars))
    sol={}
    sol.update(subs)
    # First solve G_1..G_3s sequentially from first 3s eqs pivoting on G_{k+1}
    for k in range(0,3*s):
        e=sp.expand(eqs[k].subs(sol))
        var=Gvars[k]
        coef=sp.diff(e,var)
        assert coef "'!=0 and coef.is_Rational, (k,e,var,coef)
        rhs=sp.expand(-(e-coef*var)/coef)
        sol[var]=rhs
    residual=[sp.expand(e.subs(sol)) for e in eqs[3*s:]]
    residual=[r for r in residual if r!=0]
    print('"' residual constraints',len(residual),'vars left',[v for v in Fvars if v not in sol])
    left=[v for v in Fvars if v not in sol]
    # try solve residual sequentially high-to-low or solve
    print(' degrees first', [sp.Poly(r,*left).total_degree() for r in residual[:5]] if residual else [])
    try:
        ss=sp.solve(residual, left, dict=True, simplify=False, rational=True)
        print(' solve count',len(ss))
        if ss:
            sol2=sol.copy(); sol2.update(ss[0])
            Fcoeff=[sp.simplify(sol2.get(v,v)) for v in Fvars]
            Gcoeff=[sp.simplify(sol2.get(v,v)) for v in Gvars]
            print('F',Fcoeff)
            print('G',Gcoeff)
            W=[]
            for k in range(0,5*s-1):
                total=0
                for i in range(max(0,k+1-3*s), min(2*s,k+1)+1):
                    j=k+1-i
                    total += (2*j-3*i)*([1]+Fcoeff)[i]*([1]+Gcoeff)[j]
                W.append(sp.expand(total))
            print('W nonzero',[(i,w) for i,w in enumerate(W) if w])
    except Exception as e: print('solve err',type(e),e)
for s in [1,2,3,4,5,6]:
    solve_centered(s)

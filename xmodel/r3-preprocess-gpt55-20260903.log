At this point R3 is behaving like a standalone polynomial ODE rather than a finite zero-dimensional chart. I’m deriving explicit survivor families from the ODE itself, which is better suited for the requested “dimension and point” branch than forcing a large Groebner basis.
exec
/bin/bash -lc "python3 - <<'PY'
import sympy as sp
y=sp.symbols('y')
a0,a1,b0,b1,b2,c=sp.symbols('a0 a1 b0 b1 b2 c')
f=y**2+a1*y+a0
g=-(y**3+b2*y**2+b1*y+b0)
E=sp.Poly(sp.expand(2*f*sp.diff(g,y)-3*sp.diff(f,y)*g-c), y)
print(E.as_dict())
eqs=[co for co in E.all_coeffs() if co]
print(eqs)
print(sp.solve(eqs, [b2,b1,b0,c], dict=True))
PY" in /home/ubuntu/jc2

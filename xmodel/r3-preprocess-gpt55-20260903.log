import sympy as sp, time

def h_coeffs(s, first):
    M=2*s; N=3*s; upto=5*s-1
    aa=list(sp.symbols(f'F1:{M+1}'))
    coeff=[sp.Integer(0)]*(first-1)+[sp.Integer(1)]+aa[first:]
    vars=aa[first:]
    h=[sp.Integer(1)]
    for n in range(1,upto+1):
        val=sp.Integer(0)
        for i in range(1,min(M,n)+1):
            if coeff[i-1] "'!= 0:
                val += (2*(n-i)-3*i)*coeff[i-1]*h[n-i]
        h.append(sp.expand(-val/(2*n)))
    tails=[h[i] for i in range(N+1,5*s-1)]
    kap=h[5*s-1]
    return vars,tails,kap
for s in [6,7,8]:

/bin/bash -lc "python3 - <<'PY'
import sympy as sp

def equations(s):
 y,c=sp.symbols('y c'); a=sp.symbols(f'a0:{2*s}'); b=sp.symbols(f'b0:{3*s}')
 f=y**(2*s)+sum(a[j]*y**j for j in range(2*s))
 g=-(y**(3*s)+sum(b[j]*y**j for j in range(3*s)))
 E=sp.Poly(sp.expand(2*f*sp.diff(g,y)-3*sp.diff(f,y)*g-c), y)
 return list(a), list(b), c, [co for co in E.all_coeffs() if co]
for s in [2,3]:
 a,b,c,eqs=equations(s)
 print('\\ns',s)
 # centered top a,b zero; try c=-3 or 1 and many high/lower zeros? For s=2, solve all with a3=0,b5=0,c=1.
 constraints=[a[-1], b[-1], c-1]
 vars=[v for v in a+b+[c] if v not in [a[-1],b[-1],c]]
 try:
  sol=sp.solve(eqs+constraints, vars, dict=True, simplify=False)
  print('solutions count', len(sol))
  print(sol[:2])
 except Exception as e: print('solve err', type(e), e)
PY" in /home/ubuntu/jc2

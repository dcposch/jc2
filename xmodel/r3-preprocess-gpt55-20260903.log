  zero={v:0 for v in vars}
  tail_vals=[sp.simplify(t.subs(zero)) for t in tails]
  kval=sp.simplify(kap.subs(zero))
  ok=all(v==0 for v in tail_vals) and kval"'!=0
  if ok:
   print('"' first',first,'ALLZERO POINT kappa',kval,'vars',len(vars))
  # print maybe simple stats
 print('done')

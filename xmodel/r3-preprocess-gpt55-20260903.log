+        "main_unit": "MAIN_UNIT" in stdout,
+        "main_nontrivial": "MAIN_NONTRIVIAL" in stdout,
+        "main_done": "MAIN_DONE" in stdout,
+        "stdout_tail": stdout.splitlines()[-20:],
+        "stderr_tail": stderr.splitlines()[-20:],
+    }
+
+
+def main() -> None:

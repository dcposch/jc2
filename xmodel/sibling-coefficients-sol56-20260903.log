+  3*a*u2+4*u1,
+  5*a*u1+16*u0,
+  c+28*a*u0;
+poly U108p = a*u0*c;
+ideal G108p = nonempty_sat("108-parent",I108p,U108p);
+ideal N108p = I108p,c;

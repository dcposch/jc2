748:\quad h_{14}=\cdots=h_{20}=0,\qquad h_{21}\ne0.                \tag{6.6}
772: \deg F_0=8,\quad\deg G_0=13,                                 \tag{6.8}
777: \{\bar F_0(w)^5-\bar G_0(w)^3\}=21.                           \tag{6.9}
785:                                                                    \tag{6.10}
811: (108,72,(81,106),((2,7),(3,7))).                              \tag{6.11}
835: p_2=(z-a)^7,\qquad q_2=\lambda\pi(z-a)U(z),                   \tag{6.12}
842:      -\frac{663a^3}{128}z+\frac{3315a^4}{2048},               \tag{6.13}
848: c_2=-\frac{23205}{512}\lambda a^5.                            \tag{6.14}
858:\end{split}                                                    \tag{6.15}
868: f(\pi)=F(\pi^2),\quad\deg F=7.                                \tag{6.16}
876:\quad h_{11}=\cdots=h_{16}=0,\qquad h_{17}\ne0.                \tag{6.17}
890: &+65563255857792\alpha-5817852446211.                         \tag{6.18}
904: F_s(z)=s^{-7}F_0(sz),\qquad G_s(z)=s^{-10}G_0(sz),\qquad s\ne0. \tag{6.19}
917: \deg F_0=7,\quad\deg G_0=10,                                 \tag{6.21}

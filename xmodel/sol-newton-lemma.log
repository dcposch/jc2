   184	def flatten_rows(byk, ks):
   185	    """K3-linear rows: split every eta-component over its radical
   186	    monomial basis (free K3-module); columns = var-monomial keys."""
   187	    cols, rows = {}, []
   188	    for k in ks:
   189	        for n, v in sorted(byk.get(k, {}).items()):
   190	            radkeys = set()
   191	            for vk, r in v.items(): radkeys |= set(r)
   192	            for rk in sorted(radkeys):
   193	                row = {}
   194	                for vk, r in v.items():
   195	                    c = r.get(rk)
   196	                    if c and not c.iszero():
   197	                        col = cols.setdefault(vk, len(cols))
   198	                        row[col] = c
   199	                if row: rows.append(((k, n, rk), row))
   200	    return cols, rows

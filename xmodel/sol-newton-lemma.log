   451	def path_A_rows(jf, jg, p):
   452	    """Second direct differentiation path (gate G9): assemble (L) of
   453	    sol-round5.md by hand -- (theta dPhi - 12 dPhi) Gamma_eta + (theta
   454	    Phi - 12 Phi) (dGamma)_eta - (dPhi)_eta (theta Gamma - 18 Gamma)
   455	    - Phi_eta (theta dGamma - 18 dGamma) -- multiplying VALUE-only jets
   456	    against GRADIENT-only jets (a different product-rule grouping than
   457	    the dual-jet path)."""
   458	    def vonly(J):
   459	        K = Jet(J.h, False)
   460	        K.V = J.V.copy()
   461	        return K
   462	    def gonly(J):
   463	        K = Jet(J.h, True)
   464	        K.G = J.G.copy()
   465	        return K
   466	    fV, gV = vonly(jf), vonly(jg)
   467	    fD, gD = gonly(jf), gonly(jg)
   468	    terms = [jmul(theta_shift(fD, 12, p), eta_deriv(gV, p), p),
   469	             jmul(theta_shift(fV, 12, p), eta_deriv(gD, p), p)]
   470	    neg = [jmul(eta_deriv(fD, p), theta_shift(gV, 18, p), p),
   471	           jmul(eta_deriv(fV, p), theta_shift(gD, 18, p), p)]
   472	    DG = np.zeros((HMAX, _S, GD))
   473	    for T in terms:
   474	        h = min(T.h, HMAX)
   475	        DG[:h] += T.G[:h]
   476	    for T in neg:
   477	        h = min(T.h, HMAX)
   478	        DG[:h] -= T.G[:h]
   479	    return np.mod(DG, p)

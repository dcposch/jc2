   857	def dval_for_banked(p, point):
   858	    """EMISSION-name valuation for valuation_e.window_partials: the
   859	    banked rows carry the conventional DEEPMAP deep labels, so the ten
   860	    deep slots are presented through the inverse of DEEP_RELABEL
   861	    (an involution); PIN42 names set to 0 defensively."""
   862	    dval = {}
   863	    for f in FAMS:
   864	        for r, v in point["tails"][f].items():

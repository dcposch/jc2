+
+\[
+ \mathcal H(s)\in F^DY^+;                                \tag{1.10}
+\]
+
+equivalently,
+
+\[
+ [u^j]H_a(s)=0\quad\text{whenever }s_a+6j<D.              \tag{1.11}
+\]

   113	# ------------------------------------------------------------ GB parse
   114	def parse_msolve_gb(path, p):
   115	    """msolve -g 2 GB .out -> (gvars, [(lt_s, lt_deg, tail=[(s,deg,c)..])]).
   116	    Gates: characteristic, variable order, 509 elements, monic, and
   117	    first-printed term == unique grevlex max (order pin, every element)."""
   118	    txt = open(path).read()
   119	    lines = txt.split("\n")
   120	    ch = next(l for l in lines if l.startswith("#field characteristic"))
   121	    assert int(ch.split(":")[1]) == p, (path, ch)
   122	    vo = next(l for l in lines if l.startswith("#variable order"))
   123	    gvars = [v.strip() for v in vo.split(":")[1].split(",")]
   124	    assert gvars == GBVARS, (path, gvars)
   125	    body = txt.split("#---")[-1].strip()
   126	    assert body.startswith("[") and body.rstrip(":").endswith("]"), path
   127	    body = body.lstrip("[").rstrip(":").rstrip("]")
   128	    vi = {v: i for i, v in enumerate(gvars)}
   129	    gb = []
   130	    for spoly in body.split(",\n"):
   131	        terms = []
   132	        for t in spoly.strip().split("+"):
   133	            fs = t.split("*")
   134	            c = int(fs[0]) % p
   135	            e = [0] * NV
   136	            for f in fs[1:]:
   137	                if "^" in f:
   138	                    nm, ex = f.split("^")
   139	                    e[vi[nm]] += int(ex)
   140	                else:
   141	                    e[vi[f]] += 1
   142	            terms.append((pack(e), sum(e), c))
   143	        lt_s, lt_deg, lt_c = terms[0]
   144	        assert lt_c == 1, ("non-monic", path, spoly[:60])
   145	        ltk = gkey(lt_s, lt_deg)
   146	        assert all(gkey(s, d) < ltk for s, d, _ in terms[1:]), \
   147	            ("order pin failed", path, spoly[:60])
   148	        gb.append((lt_s, lt_deg, terms[1:]))
   149	    assert len(gb) == 509, (path, len(gb))
   150	    return gb

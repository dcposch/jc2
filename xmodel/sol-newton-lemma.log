    60	def gate():
    61	    print("== GATE: promoted top-order identities in the chart ==")
    62	    t0 = time.time()
    63	    orbs, jf, jg = build_jets(1, "g0")
    64	    chk("E6: f-jet slot-0 = S_M [(e3-a1)(e3-a2)]^2, S_M = 7^12/2^6",
    65	        R1.jet_matches_etapoly(jf, eta_poly_ref([(R1.A1c, 2), (R1.A2c, 2)],
    66	                                                S_M)))

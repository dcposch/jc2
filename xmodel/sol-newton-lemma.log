    33	def fresh_registry():
    34	    R1.VARS.clear(); R1.VSTAT.clear(); R1.PINS = {}
    35	
    36	def build_jets(D, tag=""):
    37	    """G_m-chart jets of f and g to slot < D, all template frees symbolic.
    38	    Exactness: every var sits at slot >= 1, so var-degree <= slot < D;
    39	    VDEG_CAP = D keeps everything exact (no HIVAR sentinel may appear)."""
    40	    fresh_registry()
    41	    R1.VDEG_CAP = D
    42	    orbs = R1.build_generators(32 + D)
    43	    jf = R1.gm_jet2(R1.FORB, orbs, D, tag + "f")
    44	    jg = R1.gm_jet2(R1.GORB, orbs, D, tag + "g")
    45	    for jp in (jf, jg):
    46	        for (n, s), v in jp.items():
    47	            assert not any(k and k[-1] == R1.HIVAR for k in v), \
    48	                "sentinel loss at (%d,%d)" % (n, s)
    49	    return orbs, jf, jg
    50	
    51	def jrows(jf, jg, D):
    52	    """LHS of (J) as a JetPoly: jmul(tPhi_t - 12Phi, Gamma_eta)
    53	    - jmul(Phi_eta, tGamma_t - 18Gamma)."""
    54	    jA  = {(n, s): vscal(v, K3(s - 12)) for (n, s), v in jf.items() if s != 12}
    55	    jBg = {(n, s): vscal(v, K3(s - 18)) for (n, s), v in jg.items() if s != 18}
    56	    jfH = {(n - 1, s): vscal(v, K3(n)) for (n, s), v in jf.items() if n}
    57	    jgH = {(n - 1, s): vscal(v, K3(n)) for (n, s), v in jg.items() if n}
    58	    return jadd(jmul(jA, jgH, D), jscal(jmul(jfH, jBg, D), K3(-1)))

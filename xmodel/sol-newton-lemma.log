   413	def theta_shift(J, off, p):
   414	    """(theta - off) on a lead-normalized jet: slot s multiplier (s-off)."""
   415	    m = np.mod(_AR - off, p).astype(np.float64)
   416	    K = Jet(J.h, J.G is not None)
   417	    K.V = np.mod(J.V * m[None, :], p)
   418	    if J.G is not None:
   419	        K.G = np.mod(J.G * m[None, :, None], p)
   420	    return K
   421	
   422	def eta_deriv(J, p):
   423	    K = Jet(max(J.h - 1, 1), J.G is not None)
   424	    for h in range(1, J.h):
   425	        K.V[h - 1] = np.mod(J.V[h] * h, p)
   426	        if J.G is not None:
   427	            K.G[h - 1] = np.mod(J.G[h] * h, p)
   428	    return K

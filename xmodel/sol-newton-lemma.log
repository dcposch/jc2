   641	# --------------------------------------------------- linear algebra mod p
   642	def rankp(M, p):
   643	    M = np.mod(M.astype(np.int64), p)
   644	    R, C = M.shape
   645	    r = 0
   646	    for c in range(C):
   647	        if r == R:
   648	            break
   649	        piv = None
   650	        for i in range(r, R):
   651	            if M[i][c]:
   652	                piv = i
   653	                break
   654	        if piv is None:
   655	            continue
   656	        M[[r, piv]] = M[[piv, r]]
   657	        M[r] = M[r] * pow(int(M[r][c]), p - 2, p) % p
   658	        nz = np.nonzero(M[:, c])[0]
   659	        nz = nz[nz != r]
   660	        if len(nz):
   661	            M[nz] = (M[nz] - np.outer(M[nz, c], M[r])) % p
   662	        r += 1
   663	    return r

   202	def solve_rows(byk, ks, tag):
   203	    cols, rows = flatten_rows(byk, ks)
   204	    print("   [%s] %d K3-rows over %d var-monomial columns" %
   205	          (tag, len(rows), len(cols)))
   206	    NC = len(cols)
   207	    rr = [dict(r) for _, r in rows]           # homogeneous: no RHS col
   208	    rank, piv, red, bad = R1.row_reduce(rr, NC + 1, tag, quiet=True)
   209	    inv = {i: k for k, i in cols.items()}
   210	    print("   [%s] rank %d; pivot columns:" % (tag, rank))
   211	    for c in piv: print("      %s" % vname(inv[c]))
   212	    free = [vname(inv[c]) for c in range(NC) if c not in piv]
   213	    print("   [%s] free columns: %s" % (tag, ", ".join(free) if free else "-"))
   214	    return rank, piv, cols

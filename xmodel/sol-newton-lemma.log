   703	# ----------------------------------------------------- block diagnostics
   704	def block_diagnostics(E, p, nmax=NMAX):
   705	    """The deterministic square-block scan of sol-round5.md 1.2/1.3:
   706	    for each candidate free stream c, the 29x29 operator block B_c;
   707	    causal truncations M_c(N), defect profile, filtered delayed-loss
   708	    window bound, index diagnostic (V).  NOTHING PROMOTES (no Ore
   709	    normal form here); all outputs are E_CANDIDATE diagnostics."""
   710	    Gg = E.G.astype(np.int64)
   711	    out_rows_all = [(a, j) for a in range(29)
   712	                    for j in range((RMAX - S_A[a]) // 6 + 1)]
   713	    def entry(a, n, fam, r):
   714	        return int(Gg[a][n][GIDX[(fam, r)]])
   715	    blocks = []
   716	    for ci, (cf, crho) in enumerate(STREAMS):
   717	        rc = r_start(crho)
   718	        instreams = [s for s in STREAMS if s != (cf, crho)]
   719	        # causal truncations
   720	        deltas = []
   721	        for N in range(1, nmax + 1):
   722	            rows = [(a, j) for a in range(29) for j in range(N)]
   723	            cols = [(f, rho, i) for (f, rho) in instreams
   724	                    for i in range(N)]
   725	            M = np.zeros((len(rows), len(cols)), dtype=np.int64)
   726	            for ri, (a, j) in enumerate(rows):
   727	                n = S_A[a] + 6 * j
   728	                for cj, (f, rho, i) in enumerate(cols):
   729	                    r = r_start(rho) + 6 * i
   730	                    if n >= r:
   731	                        M[ri][cj] = entry(a, n, f, r)
   732	            assert M.shape == (29 * N, 29 * N), "block not square"
   733	            deltas.append(29 * N - rankp(M, p))
   734	        d_c = deltas[-1] if len(deltas) >= 2 and \
   735	            deltas[-1] == deltas[-2] else None
   736	        stable3 = len(deltas) >= 3 and deltas[-1] == deltas[-2] == deltas[-3]
   737	        # filtered coverage on the full band<=40 window
   738	        cols_full = []
   739	        for (f, rho) in instreams:
   740	            for r in range(r_start(rho), RMAX + 1, 6):
   741	                cols_full.append((f, r))
   742	        col_lv = np.array([r for (f, r) in cols_full])
   743	        row_lv = np.array([S_A[a] + 6 * j for (a, j) in out_rows_all])
   744	        Mw = np.zeros((len(out_rows_all), len(cols_full)), dtype=np.int64)
   745	        for ri, (a, j) in enumerate(out_rows_all):
   746	            n = S_A[a] + 6 * j
   747	            for cj, (f, r) in enumerate(cols_full):
   748	                if n >= r:
   749	                    Mw[ri][cj] = entry(a, n, f, r)
   750	        order = np.argsort(-col_lv, kind="stable")
   751	        cs = Colspace(len(out_rows_all), p)
   752	        ell_need = []
   753	        prev_n = None
   754	        oi = 0
   755	        for n in sorted(set(col_lv), reverse=True):
   756	            while oi < len(order) and col_lv[order[oi]] >= n:
   757	                cs.add(Mw[:, order[oi]].copy())
   758	                oi += 1
   759	            cov = cs.covered_rows()
   760	            bad = row_lv[~cov]
   761	            f_n = int(bad.max()) + 1 if len(bad) else 0
   762	            ell_need.append((int(n), max(0, f_n - int(n))))
   763	        ell_window = max(l for _, l in ell_need) if ell_need else 0
   764	        # weighted-pivot checksum on M_c(NMAX): greedy min-loss pivots
   765	        rowsN = [(a, j) for a in range(29) for j in range(nmax)]
   766	        colsN = [(f, rho, i) for (f, rho) in instreams for i in range(nmax)]
   767	        rlv = [S_A[a] + 6 * j for (a, j) in rowsN]
   768	        clv = [r_start(rho) + 6 * i for (f, rho, i) in colsN]
   769	        MN = np.zeros((len(rowsN), len(colsN)), dtype=np.int64)
   770	        for ri, (a, j) in enumerate(rowsN):
   771	            n = S_A[a] + 6 * j
   772	            for cj, (f, rho, i) in enumerate(colsN):
   773	                r = r_start(rho) + 6 * i
   774	                if n >= r:
   775	                    MN[ri][cj] = entry(a, n, f, r)
   776	        loss_sum, npiv = weighted_pivot_checksum(MN, rlv, clv, p)
   777	        # eta29 augmentation (beyond spec; the refuted lemma excluded
   778	        # this row): defect of [M_c(N); eta29 row] -- the extra measured
   779	        # output H_29 (band 36 = its only in-window coefficient row).
   780	        aug = []
   781	        for N in range(1, nmax + 1):
   782	            cols = [(f, rho, i) for (f, rho) in instreams
   783	                    for i in range(N)]
   784	            M = np.zeros((29 * N + 1, len(cols)), dtype=np.int64)
   785	            for ri, (a, j) in enumerate([(a, j) for a in range(29)
   786	                                         for j in range(N)]):
   787	                n = S_A[a] + 6 * j
   788	                for cj, (f, rho, i) in enumerate(cols):
   789	                    r = r_start(rho) + 6 * i
   790	                    if n >= r:
   791	                        M[ri][cj] = entry(a, n, f, r)
   792	            for cj, (f, rho, i) in enumerate(cols):
   793	                r = r_start(rho) + 6 * i
   794	                if S_29 >= r:
   795	                    M[29 * N][cj] = entry(29, S_29, f, r)
   796	            aug.append(29 * N + 1 - rankp(M, p))
   797	        e_idx = None if d_c is None else 6 * d_c + rc - 48
   798	        consistent = (d_c is not None and e_idx is not None and
   799	                      e_idx >= 0 and ell_window <= e_idx)
   800	        blocks.append({
   801	            "stream": "%s/r%d" % (cf, crho), "order": ci, "r_c": rc,
   802	            "delta_profile_N1..%d" % nmax: deltas,
   803	            "delta_plus_eta29_N1..%d" % nmax: aug,
   804	            "d_c_stabilized": d_c, "delta_stable_3win": bool(stable3),
   805	            "e_index_V": e_idx,
   806	            "e_index_note": "UNPROMOTED E_INDEX diagnostic (V): "
   807	                            "6*d_c + r_c - 48; not a theorem",
   808	            "ell_window": int(ell_window),
   809	            "ell_note": "E_LOSS window bound: certified lower bound AND "
   810	                        "in-window estimate for (P) on bands<=40; not an "
   811	                        "all-depth certificate",
   812	            "ell_profile": ell_need,
   813	            "pivot_checksum": {"loss_sum": int(loss_sum),
   814	                               "n_pivots": int(npiv)},
   815	            "stopped_gt11": bool(ell_window > 11 or
   816	                                 (e_idx is not None and e_idx > 11)),
   817	            "consistent_diagnostics": bool(consistent),
   818	            "promoted": False,
   819	        })
   820	    return blocks

    P2 = S.V[3] * S.d[2] // S.d[3]
    Q2 = S.V[3] * (n - S.M[2]) // S.d[3]
    return {
        "S": S,
        "nstar": S.e,
        "mstar": S.dd,
        "deg_g": S.e * S.V[2],
        "deg_T": S.dd * S.V[2],
        "delta": dict(S.delta),

        c12 = self.nstar * V2 % A1 == 0 and (self.mstar * V2 - 1) % A1 == 0
        c13 = self.mstar * V2 % A1 == 0 and (self.nstar * V2 - 1) % A1 == 0
        return (c12 or c13), A1, c12, c13

    def pport(self, A, P, Q, b, orbits):
        if (Q - 1) % A:
            return False
        S = (Q - 1) // A
        if len(orbits) > S:

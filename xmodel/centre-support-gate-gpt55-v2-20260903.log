def free_in_window(S, j=1):
    """Lattice points of (1/L_j)Z in (delta_{j+1}, delta_j) that are not radii and not Z."""
    L = S.L(j)
    radii = {S.delta[i] for i in range(j + 1, S.s + 1)}
    out = []
    e = S.delta[j + 1] + F(1, L)
    while e < S.delta[j]:
        if e not in radii and e.denominator != 1:
            out.append(e)
        e += F(1, L)
    return out



    # tbar^A = t, t^e = tbar^{A*e}, multiplier exponent A*e (mod A, i.e. class of A*e)
    return (F(A_parent) * F(e))  # integer iff invariant? omega^{A e}=exp(2 pi i e), =1 iff e in Z



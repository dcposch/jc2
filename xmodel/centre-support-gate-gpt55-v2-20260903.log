                kk = cap - len(pre)
                hm = zmaj or bool(pre)
                sol = self.fill(tgt, kk, tuple(coins), hm, A, P, Q, b, pre)
                if sol is not None:
                    return {"j": j, "A": A, "P": P, "Q": Q, "b": b,

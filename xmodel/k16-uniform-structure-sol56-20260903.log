+        "\ttotal_degree\tterm_count\tprimitive_generator"
+    ]
+    residual_summary = []
+    polynomial_variables = [y] + remaining
+    for row in rows:
+        poly = sp.Poly(row.expr, *remaining, domain=sp.QQ.frac_field(y))

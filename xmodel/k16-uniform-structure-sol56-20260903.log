+    if terminal_unit is not None:
+        raise AssertionError("unexpected coefficient-field constant")
+    if (len(pivots), len(rows), [str(v) for v in remaining]) != (
+            17, 6, ["b3", "b4", "a2_0"]):
+        raise AssertionError("unexpected affine residual")
+

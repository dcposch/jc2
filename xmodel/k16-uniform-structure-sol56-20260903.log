+
+HERE = pathlib.Path(__file__).resolve().parent
+INPUTS = pathlib.Path("/tmp/jc2-lane.fjoTgL/inputs")
+EXPECTED = {
+    "t_order_system.py": "e115d576e850523f8796008d1b9d7899382cbac918ac2e74419207d9e7e7dc28",

+            "pivot_bands": [p.h_power for p in pivots],
+            "pivot_variables": [str(p.variable) for p in pivots],
+            "remaining_unknowns": [str(v) for v in remaining],
+            "remaining_rows": residual_summary,
+            "dropped": dropped,

+            q_rows.append(sliced)
+
+    K = normalized.QuadraticField(y, auxiliary)
+    if K.reduce(H) != 0:
+        raise AssertionError("minimal polynomial does not vanish")
+    k_input = []
+    zero_mod_H = []
+    for row in q_rows:

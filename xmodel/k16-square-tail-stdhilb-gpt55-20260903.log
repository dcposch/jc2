+            lines += [
+                "int step_tm=timer;",
+                f"Gfull=std(Gfull,T{row});",
+                f'print("FULL_ADD_ROW=T{row} SECONDS="+string(timer-step_tm)'
+                '+" SIZE="+string(size(Gfull))+" DIM="+string(dim(Gfull)));',
+            ]
+        full_rows = tuple(range(1, 2 * cone.t))
+        lines += [

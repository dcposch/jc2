diff --git a/box/k16stdhilb-20260903/emit_square_tail_guided.py b/box/k16stdhilb-20260903/emit_square_tail_guided.py
new file mode 100644
index 0000000000000000000000000000000000000000..0c1e89ecfb0d909eabe3952757da8287c7b6b3bd

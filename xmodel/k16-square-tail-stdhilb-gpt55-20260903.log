+    lines += emit_nf_checks(selected, "G", "TAIL" if job != "negative-full" else "FULL")
+    prefix = "TAIL" if job != "negative-full" else "FULL"
+    lines += emit_basis_analysis("G", prefix, predicted, expected)
+    if job == "full-from-tail":

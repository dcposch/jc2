+        'print("TARGET_HNUM_END");',
+        "ideal J=" + ",".join(f"T{row}" for row in selected) + ";",
+        f'print("SELECTED_ROWS={",".join(map(str, selected))}");',
+        'print("GUIDED_STD_START");',
+        "timer=1; int guided_tm=timer;",

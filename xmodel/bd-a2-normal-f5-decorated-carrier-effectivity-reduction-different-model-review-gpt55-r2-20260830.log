def comps(r,total=3):
    def rec(i, rem, cur):
        if i==r-1:
            yield tuple(cur+[rem]); return
        for x in range(rem+1):
            yield from rec(i+1, rem-x, cur+[x])
    yield from rec(0,total,[])


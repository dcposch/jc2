from fractions import Fraction
from itertools import product

def invA(r):
    return [[Fraction(min(i+1,j+1)*(r-max(i+1,j+1)), r+1) for j in range(r)] for i in range(r)]

def cartanD(r):
    C=[[0]*r for _ in range(r)]
    for i in range(r): C[i][i]=2
    for i in range(r-3):
        C[i][i+1]=C[i+1][i]=-1
    C[r-3][r-2]=C[r-2][r-3]=-1
    C[r-3][r-1]=C[r-1][r-3]=-1
    return C

def inv_mat(C):
    n=len(C); A=[[Fraction(C[i][j]) for j in range(n)]+[Fraction(i==j) for j in range(n)] for i in range(n)]
    for col in range(n):
        pivot=next(i for i in range(col,n) if A[i][col])
        A[col],A[pivot]=A[pivot],A[col]
        div=A[col][col]
        A[col]=[x/div for x in A[col]]
        for i in range(n):
            if i"'!=col and A[i][col]:
                fac=A[i][col]
                A[i]=[A[i][j]-fac*A[col][j] for j in range(2*n)]
    return [row[n:] for row in A]

def comps(r,total=3):
    if r==1:
        yield (total,); return
    def rec(i, rem, cur):
        if i==r-1:
            yield tuple(cur+[rem]); return
        for x in range(rem+1):
            yield from rec(i+1, rem-x, cur+[x])
    yield from rec(0,total,[])

def rows(kind,r):
    inv = invA(r) if kind=='"'A' else inv_mat(cartanD(r))
    out=[]
    for a in comps(r):
        h=[sum(inv[i][j]*a[j] for j in range(r)) for i in range(r)]
        if all(x.denominator==1 and x>0 for x in h):
            q=sum(Fraction(a[i])*h[i] for i in range(r))
            if q<=8:
                out.append((a,int(q)))
    return out
for r in range(1,10):
    rs=rows('A',r)
    if rs:
        print('A'+str(r), rs)
for r in range(4,10):
    rs=rows('D',r)
    if rs:

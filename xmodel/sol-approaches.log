p=105337:\quad \bar q&=(24129Z+100248)
 [(x59-x66)+8603x72(x57-x65)],\\
p=105673:\quad \bar q&=(6523Z+44573)
 [(x59-x66)+96695x72(x57-x65)].
\end{aligned}

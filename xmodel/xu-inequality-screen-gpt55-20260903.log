+        return True
+    print(f"  [FAIL] {name}   {detail}", flush=True)
+    FAILURES.append(name)
+    return False
+
+
+def abort_if_failed(stage: str) -> None:
+    if FAILURES:
+        print(f"{stage} FAILED: {FAILURES}", flush=True)
+        sys.exit(1)

+        "u_s": us,
+        "s_eff": Dt["s"],
+        "dropped": Dt["dropped"],
+        "delta": None if ph is None else [frac_text(x) for x in ph],
+        "delta2": frac_text(d2),
+        "two_point": d2 == F(-1),

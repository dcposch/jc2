+        "status": "OK",
+        "u_s": us,
+        "s_eff": Dt["s"],
+        "dropped": Dt["dropped"],
+        "delta": None if ph is None else [frac_text(x) for x in ph],
+        "delta2": frac_text(d2),
+        "two_point": d2 == F(-1),
+    }
+
+
+@dataclass(frozen=True)
+class Bound:
+    im_min: F
+    im_witness: dict
+    im_max: F
+    imax_witness: dict

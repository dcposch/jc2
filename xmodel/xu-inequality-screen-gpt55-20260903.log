+def phi_on(D):
+    n, Mdict, ddict, Vdict, s, k = D["n"], D["M"], D["d"], D["V"], D["s"], D["k"]
+    if s < 1 or n - Mdict[s] - 1 == 0:
+        return None
+    out = []
+    for i in range(1, s + 1):
+        raw = def51(n, Mdict, ddict, Vdict, s, i)
+        if raw is None:
+            return None
+        out.append((k + 1) * raw)
+    return out

+    vals = [S.n, S.m] + [S.M[i] for i in range(1, S.s)] + [S.d[i] for i in range(1, S.s + 1)]
+    ds = S.d[S.s]
+    if any(x % ds != 0 for x in vals):
+        return {"status": "NOT-INTEGRAL", "u_s": us, "s_eff": None, "two_point": None}
+    Dt = truncate_jacobian(descend(S))

        by13 = self.mstar * v2 % A1 == 0 and (self.nstar * v2 - 1) % A1 == 0
        witness = {
            "V2": v2, "delta1": fraction_text(delta[1]), "L1": L, "A1": A1,
            "condition12": by12, "condition13": by13,

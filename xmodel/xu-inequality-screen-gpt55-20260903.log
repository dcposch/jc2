+                "V_s": first["V_s"],
+                "u_s": first["u_s"],
+                "s": first["s"],
+                "rows_in_group": len(items),
+                "bounds": sorted({(r["IM_max"], r["Im_min"]) for r in items}),
+            })
+    killed_group_list.sort(key=lambda r: (r["n"], r["m"], r["M"], r["V_s"]))
+
+    moh_status = []
+    for lab, S in moh:

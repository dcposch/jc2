+
+def truncate_jacobian(D):
+    n, s = D["n"], D["s"]
+    Mdict, ddict, Vdict = dict(D["M"]), dict(D["d"]), dict(D["V"])
+    dropped = 0
+    while s >= 1 and Mdict.get(s) == n - 1:
+        dropped += 1
+        s -= 1
+        Mdict.pop(s + 1, None)
+        Vdict.pop(s + 1, None)
+        if (s + 1) in ddict and s >= 1:
+            Vdict[s + 1] = ddict[s + 1]
+    D2 = dict(D)

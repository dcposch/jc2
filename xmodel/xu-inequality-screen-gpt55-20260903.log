+            zero=0,
+            nonzero_values=[2, 1],
+        ),
+        "84_56_M2_72_V2_5": manual_j2_split(
+            M.Skel(84, 56, [72, 82], {2: 5, 3: 3}),
+            zero=1,
+            nonzero_values=[5],
+        ),
+        "75_50_split_i_permissive": manual_j2_split(
+            M.Skel(75, 50, [55, 73], {2: 2, 3: 4}),
+            zero=0,
+            nonzero_values=[2, 2],
+        ),

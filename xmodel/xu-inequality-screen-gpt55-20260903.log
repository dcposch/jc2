def slim_rec(rec):
    if not rec.get("screens"):
        return rec
    out = {}
    for kk in KEEP:
        if kk not in rec:
            continue
        vv = rec[kk]
        out[kk] = compact_phi(vv) if kk == "phi_eff" else vv

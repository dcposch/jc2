        "ideal I=%s;" % ",\n".join(rendered),
        "ideal G=std(I);",
        'if (reduce(1,G)==0) { print("UNIT"); } else { print("NONUNIT"); }',
        'print("BASIS_SIZE");',
        "size(G);",
        "G;",
        "quit;",
    ]) + "\n"



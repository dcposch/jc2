@dataclasses.dataclass
class Row:
    source_index: int
    h_power: int
    monomial: tuple[int, int]
    expr: sp.Expr


@dataclasses.dataclass
class Pivot:
    step: int
    source_index: int
    h_power: int
    monomial: tuple[int, int]
    variable: sp.Symbol
    coefficient: sp.Rational
    step_rhs: sp.Expr
    final_rhs: sp.Expr | None = None



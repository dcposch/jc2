import csv,json,sympy as s,time,dataclasses
T=4;e=13;q=9;y=s.Symbol('q9_1'); H=486*y*y-270*y+35
names=json.load(open('box/k16uniform-20260903/t4_normalization_audit.json'))['normalized']['remaining_variables']
vs={n:s.Symbol(n) for n in names}; loc={**vs,str(y):y}
rows=[]
for x in csv.DictReader(open('box/k16uniform-20260903/t4_normalized_rows.tsv'),delimiter='\\t'):
 rows.append([int(x['source_index']),int(x['h_power']),(int(x['gamma_power']),int(x['pi_power'])),s.sympify(x['expression'],locals=loc)])
remaining=list(vs.values()); hp=s.Poly(H,y,domain=s.QQ[tuple(remaining)])
def red(z):
 return s.expand(s.Poly(s.expand(z),y,domain=s.QQ[tuple(remaining)]).rem(hp).as_expr())

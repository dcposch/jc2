+    J_hA * (Qh * S - R * Ph)
+    + J_hB * (Qh * T - y * Ph)
+    + J_hz * (g * Qh)
+    + J_AB * (R * T - y * S)
+    + J_Az * (g * R)
+    + J_Bz * (g * y)
+)
+
+coefficient_domain = sp.QQ[
+    gamma, X, b1, b2, b3, b4,
+    U, Up, R, Rp, V, Vp, S, Sp, T, Tp, y, g,

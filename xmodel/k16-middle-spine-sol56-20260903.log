+J_hA = pi * (X - b4)
+J_hB = 2 * (X - b4) - b3 * pi
+J_hz = 3 * A - 2 * b3 - b2 * pi
+J_AB = A - b3
+J_Az = 2 * B - b2
+J_Bz = z + b1

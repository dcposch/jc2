    if len(c_rows) != 1:
        raise AssertionError((t, "expected one c row", len(c_rows)))
    c_row = c_rows[0]
    c_coefficient = sp.diff(c_row.expr, c)
    if not c_coefficient.is_Rational or c_coefficient == 0:
        raise AssertionError("c row lacks Q* coefficient")

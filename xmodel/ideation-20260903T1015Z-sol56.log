  pk=sum(ky(r) in P for r in kept)
  if pk==6 and len(kept)<=30: print(ns,len(kept),len({(r[0],r[1]) for r in kept}))
print('combo rows')
for r in R:
 if a(r) and b(r): print(r[0],r[1],list(r[2]),r[3])

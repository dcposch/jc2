def f(r):return r[4].delta[2]<=M.F(1,3)
def g(r):return r[4].V[2]>=2
preds={'M2>n-d2':a,'force10':b,'e-d=1':c,'s=3':d,'us=1':e,'delta2<=1/3':f,'V2>=2':g}

+    def after(label: str):
+        for index, line in enumerate(lines):
+            if line.strip() == label and index + 1 < len(lines):
+                return lines[index + 1].strip()
+        return None
+
+    if "MAIN_SATURATED_EMPTY" in output:
+        verdict = "SATURATED-EMPTY"

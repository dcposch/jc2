+def rename_symbols(params: Sequence[sp.Symbol], T: sp.Symbol):
+    names = []
+    rename = {}
+    for sym in list(params) + [T]:
+        base = clean_name(str(sym))
+        if base[0].isdigit():
+            base = "v" + base
+        name = base
+        suffix = 1
+        while name in names:
+            suffix += 1
+            name = "%s_%d" % (base, suffix)

/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path

def rows(fn):
 s=Path(fn).read_text().splitlines(); b='\\n'.join(s[2:]).strip()[1:].rstrip().rstrip(':').rstrip().rstrip(']'); return b.split(',\\n')[29:34]
def vecs(rs,p):
 mons=sorted(set().union(*(set(r.split('+')) for r in [])))
 # parse term monomial after leading coeff
 import re
 ds=[]; allm=set()
 for r in rs:
  d={}
  for t in r.split('+'):
   fs=t.split('*')
   try:c=int(fs[0])%p; fac=fs[1:]
   except: c=1; fac=fs
   m='*'.join(sorted(fac))
   d[m]=(d.get(m,0)+c)%p; allm.add(m)
  ds.append(d)
 ms=sorted(allm)
 return [[d.get(m,0) for m in ms] for d in ds],ms

def left_kernel(mat,p):
 # kernel of transpose: rows coefficients c so c*mat=0
 A=[list(col) for col in zip(*mat)]
 m=len(A); n=len(A[0]); piv=[]; rr=0
 for c in range(n):
  q=next((i for i in range(rr,m) if A[i][c]%p),None)
  if q is None: continue
  A[rr],A[q]=A[q],A[rr]; iv=pow(A[rr][c]%p,-1,p); A[rr]=[(x*iv)%p for x in A[rr]]
  for i in range(m):
   if i"'!=rr and A[i][c]%p:
    z=A[i][c]%p; A[i]=[(x-z*y)%p for x,y in zip(A[i],A[rr])]
  piv.append(c);rr+=1
  if rr==m: break
 free=[c for c in range(n) if c not in piv]; out=[]
 for f in free:
  v=[0]*n;v[f]=1
  for i,c in enumerate(piv):v[c]=(-A[i][f])%p
  out.append(v)
 return rr,out
for p in [105337,105673]:
 files=sorted(Path('"'cases').glob(f'd25fam_p{p}_a*.ms'))
 sig={}
 for fn in files:
  M,mons=vecs(rows(fn),p); rank,ker=left_kernel(M,p); sig.setdefault((rank,tuple(map(tuple,ker))),[]).append(fn.stem.rsplit('_',1)[-1])
 print('p',p,'fibers',len(files),'signatures',[(k,len(v)) for k,v in sig.items()])
 for (rank,ker),labs in sig.items(): print(' rank',rank,'kernel',ker,'first',labs[:3])

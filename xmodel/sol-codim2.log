from pathlib import Path
import re
lifts=['x33','x38','x16','x19','x24','x27']
def get_rows(fn):
 s=Path(fn).read_text().splitlines(); b='\\n'.join(s[2:]).strip()[1:].rstrip().rstrip(':').rstrip().rstrip(']'); return b.split(',\\n')[29:34]
def parse_row(r,p):
 d={}
 for t in r.split('+'):
  fs=t.split('*'); c=int(fs[0])%p; ex={};
  for f in fs[1:]:
   if '"'^'"' in f:n,e=f.split('"'^'"');e=int(e)
   else:n,e=f,1
   ex[n]=ex.get(n,0)+e
  key=tuple(sorted(ex.items()))
  d[key]=(d.get(key,0)+c)%p
 return {k:v for k,v in d.items() if v}
def lift_part(d):
 out={}
 for m,c in d.items():
  md=dict(m); lv=[v for v in lifts if md.get(v,0)]
  if lv:
   assert len(lv)==1 and md[lv[0]]==1
   v=lv[0]; del md[v]; out[(v,tuple(sorted(md.items())))]=c
 return out
def rankker(ds,p):
 keys=sorted(set().union(*(set(d) for d in ds))); A=[[d.get(k,0) for k in keys] for d in ds]
 # left kernel of rows via transpose RREF
 T=[list(c) for c in zip(*A)]; m=len(T);n=len(A);rr=0;pivs=[]
 for j in range(n):
  z=next((i for i in range(rr,m) if T[i][j]),None)
  if z is None:continue
  T[rr],T[z]=T[z],T[rr];iv=pow(T[rr][j],-1,p);T[rr]=[(x*iv)%p for x in T[rr]]
  for i in range(m):
   if i"'!=rr and T[i][j]:
    q=T[i][j];T[i]=[(x-q*y)%p for x,y in zip(T[i],T[rr])]
  pivs.append(j);rr+=1
 free=[j for j in range(n) if j not in pivs];ker=[]
 for f in free:
  v=[0]*n;v[f]=1
  for i,j in enumerate(pivs):v[j]=(-T[i][f])%p
  ker.append(tuple(v))
 return rr,tuple(ker),len(keys)
for p in [105337,105673]:
 sig={}
 for fn in sorted(Path('"'cases').glob(f'd25fam_p{p}_a*.ms')):
  ds=[lift_part(parse_row(r,p)) for r in get_rows(fn)]
  k=rankker(ds,p);sig.setdefault(k,[]).append(fn.stem.rsplit('_',1)[-1])
 print('p',p,'sigs')
 for k,labs in sig.items():print(k,'count',len(labs),'first',labs[:3])

/bin/zsh -lc "python3 - <<'PY' | Singular -q
from pathlib import Path
p=105337
gf=Path('cases/directionb_det23_gb_p105337.out.txt').read_text()
gbody=gf.split('#---')[-1].strip()[1:].rstrip().rstrip(':').rstrip().rstrip(']')
f=Path('cases/d25fam_p105337_a00pp.ms').read_text().splitlines()
vars=f[0]
body='\\n'.join(f[2:]).strip()[1:].rstrip().rstrip(':').rstrip().rstrip(']')
rows=body.split(',\\n')
R=rows[29:34]
print(f'ring rr={p},({vars}),dp;')
print('ideal GG='+gbody+';')
for i,r in enumerate(R,1): print(f'poly R{i}={r};')
new=['x33','x38','x16','x19','x24','x27']
print('matrix A[5][6];')
for i in range(1,6):
 for j,v in enumerate(new,1): print(f'A[{i},{j}]=diff(R{i},{v});')
print('ideal M5=minor(A,5);')
print('\"M5 count,size raw/reduced\"; size(M5); size(reduce(M5,GG));')
print('ideal rM5=reduce(M5,GG); rM5;')
print('ideal M4=minor(A,4);')
print('\"M4 count,size raw/reduced\"; size(M4); size(reduce(M4,GG));')
print('ideal rM4=reduce(M4,GG);')
print('int nn=0; int ii; for(ii=1;ii<=size(rM4);ii++){if(rM4[ii]"'!=0){nn=nn+1;}}; "nonzero M4",nn;'"')
print('"'$;'"')

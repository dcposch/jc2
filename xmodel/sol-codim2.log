+\[
+\begin{array}{rcl}
+t'_1-f_1(z,t'_3,t'_4,t'_5,t'_6)&=&0,\\
+t'_2-f_2(z,t'_3,t'_4,t'_5,t'_6)&=&0,\\
+h_{1,\ell}(z)&=&0,\\
+h_{2,\ell}(z)&=&0,\\
+0&=&0.
+\end{array}
+\tag{4.9}
+\]

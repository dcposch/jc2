        opath = os.path.join(outdir, "d25pf_p%d_%s.out" % (p, lab))
        mk = marks.get(lab, {})
        rc = int(mk.get("rc", -1))
        rec = {"rc": rc, "secs": int(mk.get("secs", -1)),
               "size": int(mk.get("size", -1))}

/bin/zsh -lc "python3 - <<'PY'
import sympy as sp
x,y=sp.symbols('x y')

def top(poly):
    P=sp.Poly(sp.expand(poly), x, y)
    deg=max(sum(m) for m,c in P.terms())
    terms=sum(c*x**m[0]*y**m[1] for m,c in P.terms() if sum(m)==deg)
    return deg, sp.factor(terms)

def nu_top(poly):
    deg, lf=top(poly)
    # binary homogeneous roots in t=x/y, include y=0 if x"'^deg factor? factor linear factors over QQ for controls
    fl=sp.factor_list(lf, x, y)[1]
    cnt=0
    for f,e in fl:
        if sp.Poly(f,x,y).total_degree()==1:
            cnt += 1
        else:
            cnt += sp.Poly(f,x,y).total_degree()
    return deg, lf, cnt

def jac(P,Q):
    return sp.factor(sp.diff(P,x)*sp.diff(Q,y)-sp.diff(P,y)*sp.diff(Q,x))

maps=[]
for k in [2,3,4]: maps.append((f"tri k={k}", x, y+x**k))
maps += [("xy", x, x*y), ("x2y2", x, x**2*y**2), ("three-root control", x, x*y*(x-y))]
# precompose xy by chi=(x, y+x''^2)
X,Y=x,y+x**2
maps.append(("xy after chi", X, X*Y))
for name,P,Q in maps:
    R= P if top(P)[0]>=top(Q)[0] else Q
    print(name, "jac=", jac(P,Q), "maxdeg/top/nu=", nu_top(R))

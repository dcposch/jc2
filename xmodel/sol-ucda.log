+
+\[
+\begin{array}{c|c}
+\text{attack}&\text{verdict}\\ \hline
+\text{degree minimality / approximate roots}
+ &\text{removable tails die, but the }(2,3)\text{ cusp protects every scale}\\
+J=\text{const}+\text{passport}+\text{handshake}

   247	    prefix = sp.Integer(1)
   248	    tower: Dict[int, sp.Expr] = {}
   249	    weights: Dict[int, F] = {}
   250	    noncenter_count = 0
   251	    center_count = 0
   252	    for degree, factor in enumerate(factors, start=1):
   253	        prefix = sp.expand(prefix * factor)
   254	        if factor == y:
   255	            center_count += 1
   256	        else:
   257	            noncenter_count += 1
   258	        weights[degree] = noncenter_count * C["delta2"] + center_count * C["delta1"]

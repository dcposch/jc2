   111	def closed_form(row: Row) -> dict:
   112	    K = math.gcd(row.n, row.m)
   113	    if K <= 0:
   114	        raise ValueError("bad gcd")
   115	    e = row.n // K
   116	    q = row.m // K
   117	    u = K - row.V2
   118	    R = row.n - row.M2 - 1
   119	    if R == 0:
   120	        raise ZeroDivisionError("n-M2-1 is zero")
   121	    Pi = e + q
   122	    delta2 = -F(row.k + 1, R)
   123	    delta1 = F((row.k + 1) * (Pi * u - R), R * (Pi * row.V2 - 1))
   124	    bound = row.V2 * delta1 + u * delta2
   125	    return {
   126	        "K": K,
   127	        "d2prime": K,
   128	        "d3prime": math.gcd(K, row.M2),
   129	        "uprime": u,
   130	        "V2": row.V2,
   131	        "eprime": e,
   132	        "dprime": q,
   133	        "R": R,
   134	        "Pi": Pi,
   135	        "delta2": delta2,
   136	        "delta1": delta1,
   137	        "bound_unit": bound,
   138	        "lambda_P": e * bound,
   139	        "lambda_Q": q * bound,
   140	    }

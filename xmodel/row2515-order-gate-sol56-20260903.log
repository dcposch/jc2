   260	            tower[degree] = prefix
   261	        elif degree == 2:
   262	            tower[degree] = sp.expand(factor * tower[degree - 1] + h_params[0] * y + h_params[1])
   263	        else:
   264	            tower[degree] = sp.expand(factor * tower[degree - 1] + h_params[degree - 1])

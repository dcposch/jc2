   371	def hadic_by_power(h: sp.Expr, low_terms, high_terms, x: sp.Symbol, y: sp.Symbol) -> Dict[int, sp.Expr]:
   372	    by_power: Dict[int, sp.Expr] = {}
   373	    for aa, r in low_terms:
   374	        for bb, s in high_terms:
   375	            same_power = jac(aa, bb, x, y)
   376	            if same_power != 0:
   377	                by_power[r + s] = by_power.get(r + s, 0) + same_power
   378	            lower_power = s * bb * jac(aa, h, x, y) + r * aa * jac(h, bb, x, y)
   379	            if lower_power != 0:
   380	                by_power[r + s - 1] = by_power.get(r + s - 1, 0) + lower_power
   381	    if 0 not in by_power:
   382	        by_power[0] = sp.Integer(0)
   383	    level = 0
   384	    max_level = max(by_power) if by_power else 0
   385	    h_poly = sp.Poly(h, y)
   386	    while level <= max_level:
   387	        rem = sp.expand(by_power.get(level, 0))
   388	        if rem != 0:
   389	            qdiv, rdiv = sp.div(sp.Poly(rem, y), h_poly, y)
   390	            by_power[level] = sp.expand(rdiv.as_expr())
   391	            if qdiv != 0:
   392	                by_power[level + 1] = by_power.get(level + 1, 0) + sp.expand(qdiv.as_expr())
   393	                max_level = max(max_level, level + 1)
   394	        level += 1
   395	    return by_power

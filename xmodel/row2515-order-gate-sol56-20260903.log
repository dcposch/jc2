   270	    if lower_expr != 0:
   271	        for mon, coef in sp.Poly(lower_expr, x, y).terms():
   272	            if coef != 0:
   273	                h_support.append((int(mon[0]), int(mon[1])))
   274	    h_support = sorted(set(h_support), key=lambda mon: (-mon[1], mon[0]))
   275	    return {
   276	        "face": face,
   277	        "h": h,
   278	        "h_lower": h_support,
   279	        "lemma21_h_support": sorted(support_allowed, key=lambda mon: (-mon[1], mon[0])),
   280	        "lemma21_support_ok": set(h_support) <= support_allowed,
   281	        "h_params": h_params,
   282	        "tower": tower,
   283	        "tower_weights": weights,
   284	    }

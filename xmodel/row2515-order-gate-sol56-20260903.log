   240	def build_tower(row: Row, part: Sequence[int], C: dict, x: sp.Symbol, y: sp.Symbol) -> dict:
   241	    face = top_face(row, part, x, y)
   242	    K = C["K"]
   243	    factors = face["factors"]
   244	    if len(factors) != K:
   245	        raise AssertionError("factor sequence length mismatch")

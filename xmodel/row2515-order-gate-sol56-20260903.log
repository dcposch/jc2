   147	def h_lower_monomials(row: Row, C: dict) -> List[Tuple[int, int]]:
   148	    """Corrected D1 support for lower terms of h, with fixed top removed."""
   149	    K = C["K"]
   150	    u = C["uprime"]
   151	    if u < 0:
   152	        raise ValueError("u'=K-V2 is negative")
   153	    degx_h = u
   154	    out = []
   155	    for j in range(K, -1, -1):
   156	        for i in range(0, degx_h + 1):
   157	            if i + j >= K:
   158	                continue
   159	            if order_allowed(C["delta1"], C["bound_unit"], i, j):
   160	                out.append((i, j))
   161	    return out

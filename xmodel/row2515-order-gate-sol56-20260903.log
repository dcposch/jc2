   187	def top_face(row: Row, part: Sequence[int], x: sp.Symbol, y: sp.Symbol) -> dict:
   188	    if sum(part) != math.gcd(row.n, row.m) - row.V2:
   189	        raise ValueError("partition sum is not u'")
   190	    slopes = list(sp.symbols("s2:%d" % (len(part) + 1))) if len(part) > 1 else []
   191	    factors: List[sp.Expr] = []
   192	    factor_names: List[str] = []
   193	    for _ in range(part[0]):
   194	        factors.append(y - x)
   195	        factor_names.append("y-x")
   196	    for slope, exponent in zip(slopes, part[1:]):
   197	        for _ in range(exponent):
   198	            factors.append(y - slope * x)
   199	            factor_names.append("y-%s*x" % slope)
   200	    for _ in range(row.V2):
   201	        factors.append(y)
   202	        factor_names.append("y")
   203	    top = sp.Integer(1)
   204	    for factor in factors:
   205	        top *= factor
   206	    omega = sp.Integer(1)
   207	    for slope in slopes:
   208	        omega *= slope * (slope - 1)
   209	    for i, slope in enumerate(slopes):
   210	        for other in slopes[i + 1:]:
   211	            omega *= slope - other
   212	    pieces = ["(y-x)^%d" % part[0]]
   213	    for index, exponent in enumerate(part[1:], start=2):
   214	        pieces.append("(y-s%d*x)^%d" % (index, exponent))
   215	    return {
   216	        "top": sp.expand(top),
   217	        "slopes": slopes,
   218	        "omega": sp.expand(omega),
   219	        "factors": factors,
   220	        "factor_names": factor_names,
   221	        "factored": "y^%d*%s" % (row.V2, "*".join(pieces)),
   222	    }

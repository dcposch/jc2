    assert wi['rung_ranks']['26']['current_reconstruction_rank_A']==wi['rung_ranks']['26']['current_reconstruction_rank_augmented']==4
    assert wi['rung_ranks']['28']['current_reconstruction_rank_A']==wi['rung_ranks']['28']['current_reconstruction_rank_augmented']==4
    assert wi['rung_ranks']['38']['prefix_smooth_component_dimension_in_used_ring']==79
    assert not fl['floor_eligible'] and fl['selected_residual_nonzero_count']==94
    order,sol=W.parse_linear_gb(f'cases/d43_graph_prefix_slice_p{p}_upto38.out',p,69)
    bank=pickle.load(open(f'cases/d43_raw_point_p{p}.pkl','rb'))
    point={n:0 for n in bank['variables']}; point.update(sol)
    assert all(RAW.evaluate(row,point,p)==0 for row in bank['rows'][:69])
    print(p,'PASS','full175',fg['total_terms_replayed'],'dim',wi['dimension']['smooth_component_dimension'],'prefixdim',wi['rung_ranks']['38']['prefix_smooth_component_dimension_in_used_ring'])

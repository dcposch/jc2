#!/bin/sh
# Parallel D43 split ladder p105337 (parked already running separately)
# + full-file -t 1 variant. Any subsystem GB [1] => FULL verdict EMPTY.
cd ~/jc72108/cases43 || exit 1
P=105337
run_one() {
  S=$1; T=$2; F=d43split_p${P}_${S}
  echo "SPLIT $P $S start(t$T) $(date -u)" >> d43chain.log
  timeout 10800 msolve -v 1 -g 2 -t $T -f $F.ms -o $F.out 2> $F.err
  rc=$?
  echo "SPLIT $P $S rc=$rc size=$(wc -c < $F.out 2>/dev/null) $(date -u)" >> d43chain.log
}
for S in upto26 upto28 upto30 upto32; do run_one $S 4 & done
for S in upto34 upto36 upto38 upto40; do run_one $S 8 & done
(
  echo "SPLIT $P full-t1 start $(date -u)" >> d43chain.log
  timeout 10800 msolve -v 1 -g 2 -t 1 -f d43fam_p${P}_a00pp_verdict.ms \
    -o d43full_t1.out 2> d43full_t1.err
  rc=$?
  echo "SPLIT $P full-t1 rc=$rc size=$(wc -c < d43full_t1.out 2>/dev/null) $(date -u)" >> d43chain.log
) &
wait
echo "SPLIT LADDER DONE $(date -u)" >> d43chain.log

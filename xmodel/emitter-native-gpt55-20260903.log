+def parse_native_for_preprocess(record: dict):
+    import sympy as sp
+    from sympy.parsing.sympy_parser import parse_expr
+
+    pre = load_module(INPUTS / "preprocess.py", "emitter_frozen_preprocess")
+    pre.OUT = OUT
+    pre.ROOT = ROOT
+    pre.INPUTS = INPUTS

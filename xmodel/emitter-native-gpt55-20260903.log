+class RowSpec:
+    key: str
+    source: str
+    n: int
+    m: int
+    M2: int
+    V2: int
+    k: int
+
+
+ROWS: dict[str, RowSpec] = {
+    "16_12": RowSpec("16_12", "(16,12;13;3;k=1)", 16, 12, 13, 3, 1),
+    "28_20": RowSpec("28_20", "(28,20;25;3;k=1)", 28, 20, 25, 3, 1),

+    "25_15": RowSpec("25_15", "(25,15;21;2;k=2)", 25, 15, 21, 2, 2),
+    "24_16": RowSpec("24_16", "(24,16;17;2;k=5)", 24, 16, 17, 2, 5),
+}
+
+UNFINISHED_24_16: list[tuple[int, ...]] = [
+    (2, 2, 2),

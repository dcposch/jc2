+            params.append(name)
+            terms.append(name if base == "1" else "%s*(%s)" % (name, base))
+        lines.append("poly BB%d = %s;" % (i, " + ".join(terms) if terms else "0"))
+        beta_dims.append(len(beta_spaces[i]))

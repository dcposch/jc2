+def parse_singular_output(output: str) -> dict:
+    def after(label: str) -> str | None:
+        lines = output.splitlines()
+        for i, line in enumerate(lines):
+            if line.strip() == label and i + 1 < len(lines):
+                return lines[i + 1].strip()
+        return None

+OUT = Path(__file__).resolve().parent
+INPUTS = Path(os.environ.get("LANE_INPUT_DIR", "/tmp/jc2-lane.wRUQfg/inputs"))
+RECEIPT = ROOT / "xmodel/emitter-native-gpt55-20260903.run.v2"
+PRIMES = (32003, 32009, 32027)
+
+

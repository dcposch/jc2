+    symbols = {name: sp.Symbol(name) for name in record["variables"]}
+    rows = []
+    for item in record["rows"]:
+        expr_text = item["expr"].replace("^", "**")
+        expr = parse_expr(expr_text, local_dict=symbols, evaluate=True)
+        rows.append(

+    if args.chart == "ab":
+        return ab_build_spec(row, part)
+    raise SystemExit("unknown chart %s" % args.chart)
+
+
+def cmd_emit(args: argparse.Namespace) -> None:
+    checked = verify_inputs()
+    if not checked["ok"]:
+        raise SystemExit("frozen input mismatch")

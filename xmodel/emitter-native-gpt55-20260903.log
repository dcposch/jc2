+        "support_rule": "K16 flag basis; h-adic Jacobian arithmetic in Singular",
+        "h_lower_count_corrected": 4,
+        "slope_count": 0,
+        "alpha_dims": alpha_dims,
+        "beta_dims": beta_dims,
+        "gauges": gauges,
+        "omega": "1",
+        "saturation_factor": "c",
+    }
+    return finalize_spec(row, "k16", None, stem, params, "c", meta, lines, low_terms, high_terms)

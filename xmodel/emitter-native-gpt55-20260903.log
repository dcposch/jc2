+        "for (i=1; i<=size(IBA); i++) { if (reduce(IBA[i],GN) != 0) { okBN=0; } }",
+        'if (okNB==1 && okBN==1) { print("COMPARE_PASS"); } else { print("COMPARE_FAIL"); }',
+        'print("COMPARE_NATIVE_BASIS_SIZE");',
+        "size(GN);",
+        'print("COMPARE_BASELINE_BASIS_SIZE");',
+        "size(GB);",
+        "quit;",

+@dataclass
+class BuildSpec:
+    row: RowSpec
+    chart: str
+    partition: tuple[int, ...] | None
+    stem: str
+    variables: list[str]
+    params_without_c: list[str]
+    sat: str
+    meta: dict
+    builder_lines: list[str]

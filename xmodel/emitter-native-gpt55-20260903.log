+        "poly h0 = subst(h, y, 0);",
+        "poly Aab = (h - h0) div y;",
+        "poly beta = bp*Aab + bq*y + br*x + bs;",
+        "list AD = native_y_div(beta^2, h, %d, WY);" % C["K"],
+        "poly alpha = AD[1];",

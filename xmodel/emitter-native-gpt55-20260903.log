+def coefficient_monomials(C: dict, deficit: int, *, beta: bool = False) -> list[tuple[int, int]]:
+    delta1: F = C["delta1"]
+    bound = C["V2"] * C["delta1"] + C["u"] * C["delta2"]
+    threshold = deficit * bound
+    max_x = C["k"] + 1 if beta else None
+    out = []
+    for b in range(C["K"] - 1, -1, -1):

+def top_face_expr(row: RowSpec, part: Sequence[int], slope_prefix: str) -> tuple[str, list[str], str, str]:
+    slopes = ["%s%d" % (slope_prefix, i) for i in range(2, len(part) + 1)]
+    factors = ["(y-x)^%d" % part[0]]

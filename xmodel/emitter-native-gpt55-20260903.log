+    low_terms = [("1", q)] + [("BB%d" % i, q - i) for i in range(2, q + 1)]
+    high_terms = [("1", e)] + [("AA%d" % i, e - i) for i in range(1, e + 1)]
+    stem = "k16_%s_%s" % (row.key, beta_prefix)

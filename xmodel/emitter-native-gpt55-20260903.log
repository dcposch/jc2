                pivot.source_index,
                pivot.h_power,
                pivot.monomial[0],
                pivot.monomial[1],
                pivot.variable,
                pivot.coefficient,
                pivot.step_rhs,
                pivot.final_rhs,
            )
        )
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def write_emission_scalars(path: pathlib.Path, reduction: Reduction) -> None:

+            "verdict": "COUNTING-BOUND",
+            "reason": "native rows could not complete preprocessing: %s: %s" % (type(exc).__name__, exc),
+        }
+    record["preprocess_elapsed_outer"] = round(time.time() - pre_started, 3)
+    outpath = OUT / "results" / (spec.stem + "_run.json")

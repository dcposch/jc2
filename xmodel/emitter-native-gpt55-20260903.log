+                "case": row_key,
+                "chart": chart,
+                "partition": None if part is None else list(part),
+                "emit_elapsed": record["meta"].get("emit_elapsed"),
+                "unknowns": record["meta"].get("unknowns"),
+                "equations": record["meta"].get("equations"),
+                "deg_x_J_gate": record["meta"].get("deg_x_J_gate"),

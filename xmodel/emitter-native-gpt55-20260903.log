+    ]
+    for row_key, chart, part, beta_prefix, baseline in cases:
+        if chart == "k16":
+            spec = k16_build_spec(ROWS[row_key], beta_prefix=beta_prefix)
+        elif chart == "ab":
+            spec = ab_build_spec(ROWS[row_key], part or ())
+        else:

+        if match:
+            fields.setdefault(int(match.group(1)), {})[match.group(2)] = match.group(3)
+    manifest = []
+    for idx in sorted(fields):
+        rec = fields[idx]
+        path = INPUTS / rec["basename"]
+        actual = sha256_file(path)
+        manifest.append(

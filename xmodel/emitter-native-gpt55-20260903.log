+  int yp;
+  matrix CY;
+  poly cc;
+  for (i = 1; i <= ncols(CX); i++)
+  {
+    xp = deg(CX[1,i], WX);
+    CY = coef(CX[2,i], y);
+    for (j = 1; j <= ncols(CY); j++)
+    {
+      cc = CY[2,j];
+      if (cc != 0)
+      {
+        yp = deg(CY[1,j], WY);
+        write(":a " + rowsfile,

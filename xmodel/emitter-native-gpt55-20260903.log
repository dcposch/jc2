+    high_terms = [("1", 3), ("3*beta", 1), ("(3/2)*alpha", 0)]
+    stem = "%s_part_%s_ab" % (row.key, "_".join(map(str, part)))
+    meta = {
+        "typing": "DERIVED",
+        "chart": "d2e3_ab_native",
+        "row": asdict(row),
+        "partition": list(part),
+        "partition_label": "+".join(map(str, part)),
+        "top_face_factored": top_factored,
+        "K": C["K"],
+        "uprime": C["u"],
+        "dprime": 2,

+    cut_b = math.ceil(F(2 * e, C["V2"]))
+    weighted = [
+        ("1", F(0), "1"),
+        ("A", cut_a * bu, "A"),
+        ("B", cut_b * bu, "B"),
+        ("z", e * bu, "z"),
+        ("x", e * bu, "x"),
+    ]

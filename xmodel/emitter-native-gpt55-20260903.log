+def k16_build_spec(row: RowSpec, *, beta_prefix: str) -> BuildSpec:
+    C = shape_for(row)
+    if not (C["K"] == 4 and C["u"] == 1 and C["V2"] == 3):
+        raise ValueError("%s is not a K=16 u=1,V2=3 chart" % row.source)
+    e = C["eprime"]
+    q = C["dprime"]
+    bu = C["V2"] * C["delta1"] + C["u"] * C["delta2"]

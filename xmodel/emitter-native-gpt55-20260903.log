+
+
+def ab_build_spec(row: RowSpec, part: Sequence[int]) -> BuildSpec:
+    C = shape_for(row)
+    if not (C["dprime"] == 2 and C["eprime"] == 3):
+        raise ValueError("%s is not a d'=2,e'=3 A/B chart" % row.source)

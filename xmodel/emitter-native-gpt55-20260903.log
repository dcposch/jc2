+        record = emit(spec, timeout=args.emit_timeout)
+        native = ROOT / record["systems"]["0"]
+        compare_path = OUT / "comparisons" / (spec.stem + "_compare.sing")
+        cmp = compare_systems(native, baseline, compare_path, timeout=args.compare_timeout)
+        validations.append(

+def shape_for(row: RowSpec) -> dict:
+    shape = shape_module()
+    C = shape.shape_bundle(row.n, row.m, row.M2, row.V2, row.k)
+    if not C.get("ok"):
+        raise ValueError("shape failed for %s: %s" % (row.source, C.get("reason")))
+    return C

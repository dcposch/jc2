+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    sub = parser.add_subparsers(dest="cmd", required=True)
+
+    def add_chart_args(p: argparse.ArgumentParser) -> None:
+        p.add_argument("--row", choices=sorted(ROWS), required=True)

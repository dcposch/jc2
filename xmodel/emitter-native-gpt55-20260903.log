+        return k16_build_spec(row, beta_prefix=args.beta_prefix)
+    part = args.partition
+    if part is None:
+        raise SystemExit("--partition is required for generic/ab charts")
+    if args.chart == "generic":
+        return generic_build_spec(row, part)
+    if args.chart == "ab":
+        return ab_build_spec(row, part)

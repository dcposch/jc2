+        if max_x is not None:
+            maxa = min(maxa, max_x)
+        for a in range(0, maxa + 1):
+            if a + b <= deficit * C["K"]:
+                out.append((a, b))
+    return out
+
+
+def singular_power(base: str, exponent: int) -> str:
+    if exponent == 0:
+        return "1"
+    if exponent == 1:
+        return base
+    return "%s^%d" % (base, exponent)
+
+
+def xy_monomial(a: int, b: int) -> str:
+    parts = []

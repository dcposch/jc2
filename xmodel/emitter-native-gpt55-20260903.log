+def run_singular(path: Path, timeout: int) -> dict:
+    started = time.time()
+    out_path = path.with_suffix(path.suffix + ".out")
+    err_path = path.with_suffix(path.suffix + ".err")
+    try:
+        proc = subprocess.run(
+            ["Singular", "-q", "--no-rc", str(path)],
+            capture_output=True,
+            text=True,
+            timeout=timeout,

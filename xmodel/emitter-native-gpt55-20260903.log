+        ("33_22", "ab", (3,), "b", ROOT / "box/topface-20260903/systems/132_88_part_3_Q.sing"),
+        ("33_22", "ab", (2, 1), "b", ROOT / "box/topface-20260903/systems/132_88_part_2_1_Q.sing"),

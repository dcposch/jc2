*B3_1_2-12*h0_0_1*A4_0_2*B3_0_4-4*h0_0_1*A4_0_2*B3_1_3-4*h0_0_1*A4_0_1*B3_1_4+12*h0_0_1*A5_0_4*B2_0_2+4*h0_0_1*A5_1_4*B2_0_1+9*h0_0_1*A5_0_3*B2_0_3+4*h0_0_1*A5_1_3*B2_0_2+6*h0_0_1*A5_0_2*B2_0_4+4*h0_0_1*A5_1_2*B2_0_3+4*h0_0_1*A5_1_1*B2_0_4+2*h0_1_1*h0_0_0*A3_0_4*B3_0_1+4*h0_1_1*h0_0_0*A3_0_3*B3_0_2+6*h0_1_1*h0_0_0*A3_0_2*B3_0_3+8*h0_1_1*h0_0_0*A3_0_1*B3_0_4-3*h0_1_1*h0_0_0*A4_0_4*B2_0_1-h0_1_1*h0_0_0*A4_0_3*B2_0_2+h0_1_1*h0_0_0*A4_0_2*B2_0_3+3*h0_1_1*h0_0_0*A4_0_1*B2_0_4-h0_1_1*A4_0_4*B3_0_1-2*h0_1_1*A4_0_3*B3_0_2-3*h0_1_1*A4_0_2*B3_0_3-4*h0_1_1*A4_0_1*B3_0_4+4*h0_1_1*A5_0_4*B2_0_1+3*h0_1_1*A5_0_3*B2_0_2+2*h0_1_1*A5_0_2*B2_0_3+h0_1_1*A5_0_1*B2_0_4+18*h0_0_0^2*A3_0_4*B3_0_3+10*h0_0_0^2*A3_0_4*B3_1_2+24*h0_0_0^2*A3_0_3*B3_0_4+10*h0_0_0^2*A3_0_3*B3_1_3+10*h0_0_0^2*A3_0_2*B3_1_4-3*h0_0_0^2*A4_0_4*B2_0_3+5*h0_0_0^2*A4_0_4*B2_1_2-5*h0_0_0^2*A4_1_4*B2_0_2+3*h0_0_0^2*A4_0_3*B2_0_4+5*h0_0_0^2*A4_0_3*B2_1_3-5*h0_0_0^2*A4_1_3*B2_0_3+5*h0_0_0^2*A4_0_2*B2_1_4-5*h0_0_0^2*A4_1_2*B2_0_4-6*h0_0_0*A3_0_1*B3_0_1-12*h0_0_0*A3_0_0*B3_0_2-10*h0_0_0*A3_0_0*B3_1_1-18*h0_0_0*A4_0_4*B3_0_3-14*h0_0_0*A4_0_4*B3_1_2+2*h0_0_0*A4_1_4*B3_0_2-24*h0_0_0*A4_0_3*B3_0_4-13*h0_0_0*A4_0_3*B3_1_3+3*h0_0_0*A4_1_3*B3_0_3+6*h0_0_0*A4_0_2*B2_0_0-12*h0_0_0*A4_0_2*B3_1_4+4*h0_0_0*A4_1_2*B3_0_4+5*h0_0_0*A4_1_1*B2_0_0-6*h0_0_0*A4_0_0*B2_0_2-5*h0_0_0*A4_0_0*B2_1_1+24*h0_0_0*A5_0_4*B2_0_3-4*h0_0_0*A5_0_4*B2_1_2+12*h0_0_0*A5_1_4*B2_0_2+18*h0_0_0*A5_0_3*B2_0_4-3*h0_0_0*A5_0_3*B2_1_3+13*h0_0_0*A5_1_3*B2_0_3-2*h0_0_0*A5_0_2*B2_1_4+14*h0_0_0*A5_1_2*B2_0_4+3*A4_0_1*B3_0_1+6*A4_0_0*B3_0_2+5*A4_0_0*B3_1_1+4*A5_0_4*B3_1_2-2*A5_1_4*B3_0_2+3*A5_0_3*B3_1_3-3*A5_1_3*B3_0_3-6*A5_0_2*B2_0_0+2*A5_0_2*B3_1_4-4*A5_1_2*B3_0_4-3*A5_0_1*B2_0_1-5*A5_1_1*B2_0_0-6*A5_1_0*B2_0_1)


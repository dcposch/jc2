+
+def generic_build_spec(row: RowSpec, part: Sequence[int]) -> BuildSpec:
+    C = shape_for(row)
+    if tuple(part) not in allowed_partitions(row):
+        raise ValueError("%s partition %s outside Prop. 4.6 cap" % (row.source, part))
+    h_lower = corrected_h_lower(C)

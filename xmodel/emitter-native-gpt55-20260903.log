+        ("28_20", "k16", None, "b", ROOT / "box/chartfix-20260903/systems/112_80_28_20_25_3_k1_Q.sing"),
+        ("33_22", "ab", (3,), "b", ROOT / "box/topface-20260903/systems/132_88_part_3_Q.sing"),

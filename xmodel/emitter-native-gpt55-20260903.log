+        "basis_size": after("MAIN_DONE basis_size="),
+        "control_ring_pass": "CONTROL_RING_PASS R" in output,
+        "control_empty_pass": "CONTROL_EMPTY_PASS" in output,
+        "control_nonempty_pass": "CONTROL_NONEMPTY_PASS" in output,

+def compare_systems(native: Path, baseline: Path, outpath: Path, timeout: int = 600) -> dict:
+    native_vars, native_ideal = system_parts(native)
+    base_vars, base_ideal = system_parts(baseline)
+    if native_vars != base_vars:
+        return {

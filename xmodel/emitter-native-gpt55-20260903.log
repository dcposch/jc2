+    if not C.get("ok"):
+        raise ValueError("shape failed for %s: %s" % (row.source, C.get("reason")))
+    return C
+
+
+def frac_s(value: F) -> str:
+    return str(value.numerator) if value.denominator == 1 else "%d/%d" % (

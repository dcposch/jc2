+            'if (typeof(GN)=="ideal" && nameof(basering)=="R") { print("CONTROL_NONEMPTY_EXTRACT_RING_PASS"); }'
+            ' else { print("CONTROL_NONEMPTY_EXTRACT_RING_FAIL"); }',
+            'if (reduce(1,GN)!=0) { print("CONTROL_NONEMPTY_PASS"); } else { print("CONTROL_NONEMPTY_FAIL"); }',
+            'print("MAIN_START equations=%d unknowns=%d char=%d");' % (len(equations), len(variables), char),
+            "ideal I=%s;" % ",\n".join(gens),

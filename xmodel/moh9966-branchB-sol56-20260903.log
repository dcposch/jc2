   119	def write_unsat_singular(tp, path: Path, row, eqs, params, T, char: int, meta: dict):
   120	    """Same equations, no Rabinowitsch generator; used as a saturation control."""
   121	    names = []
   122	    rename = {}
   123	    for sym in list(params) + [T]:
   124	        base = tp.clean_name(str(sym))
   125	        if base[0].isdigit():
   126	            base = "v" + base
   127	        nm = base
   128	        n = 1
   129	        while nm in names:
   130	            n += 1
   131	            nm = f"{base}_{n}"
   132	        names.append(nm)
   133	        rename[sym] = tp.sp.Symbol(nm)
   134	    c_name = str(rename[params[-1]])
   135	    path.parent.mkdir(parents=True, exist_ok=True)
   136	    with path.open("w") as fh:
   137	        fh.write(f"// unsaturated control for {row.src}\n")
   138	        fh.write(f"ring R={char},({','.join(names)}),dp;\n")
   139	        fh.write("option(redSB);\n")
   140	        fh.write('print("UNSAT_START");\n')
   141	        gens = [tp.sstr(e.subs(rename)) for e in eqs]
   142	        fh.write("ideal I=%s;\n" % ",\n".join(gens))
   143	        fh.write("ideal G=std(I);\n")
   144	        fh.write('print("UNSAT_DONE basis_size="); size(G);\n')
   145	        fh.write('if (reduce(1,G)==0) { print("UNSAT_EMPTY"); } else { print("UNSAT_NONTRIVIAL"); }\n')
   146	        fh.write(f"ideal N={c_name}-1;\n")
   147	        fh.write("ideal GN=std(N);\n")
   148	        fh.write('if (reduce(1,GN)!=0) { print("UNSAT_CONTROL_C1_NONTRIVIAL"); }\n')
   149	        fh.write("quit;\n")
   150	

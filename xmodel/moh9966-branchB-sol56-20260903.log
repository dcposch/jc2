    38	def run_singular(path: Path, timeout: int) -> dict:
    39	    t0 = time.time()
    40	    try:
    41	        r = subprocess.run(
    42	            ["Singular", "-q", "--no-rc", str(path)],
    43	            capture_output=True,
    44	            text=True,
    45	            timeout=timeout,
    46	        )
    47	    except subprocess.TimeoutExpired as e:
    48	        stdout = e.stdout.decode("utf-8", "ignore") if isinstance(e.stdout, bytes) else (e.stdout or "")
    49	        stderr = e.stderr.decode("utf-8", "ignore") if isinstance(e.stderr, bytes) else (e.stderr or "")
    50	        return {
    51	            "verdict": "TIMEOUT",
    52	            "elapsed_s": round(time.time() - t0, 3),
    53	            "stdout_tail": (stdout + stderr)[-2000:],
    54	        }
    55	    out = (r.stdout or "") + (r.stderr or "")
    56	    parsed = parse_singular(out)
    57	    parsed.update(
    58	        {
    59	            "elapsed_s": round(time.time() - t0, 3),
    60	            "returncode": r.returncode,
    61	            "stdout_tail": out[-2000:],
    62	        }
    63	    )
    64	    return parsed
    65	
    66	
    67	def parse_singular(out: str) -> dict:
    68	    lines = [line.strip() for line in out.splitlines()]
    69	
    70	    def next_after(label: str):
    71	        for i, line in enumerate(lines):
    72	            if line == label and i + 1 < len(lines):
    73	                return lines[i + 1]
    74	        return None
    75	
    76	    if "MAIN_SATURATED_EMPTY" in out:
    77	        verdict = "SATURATED-EMPTY"
    78	    elif "MAIN_NONTRIVIAL" in out:
    79	        verdict = "SURVIVES"
    80	    else:
    81	        verdict = "ERROR"
    82	    return {
    83	        "verdict": verdict,
    84	        "basis_size": next_after("MAIN_DONE basis_size="),
    85	        "control_c_zero_pass": "CONTROL_EMPTY_PASS" in out,
    86	        "control_c_one_pass": "CONTROL_NONEMPTY_PASS" in out,
    87	    }

    27	def load_twopoint():
    28	    sys.path.insert(0, str(INPUT_DIR))
    29	    spec = importlib.util.spec_from_file_location("twopoint_order_batch_frozen", TWOPT)
    30	    if spec is None or spec.loader is None:
    31	        raise RuntimeError(f"cannot load {TWOPT}")
    32	    mod = importlib.util.module_from_spec(spec)
    33	    sys.modules[spec.name] = mod
    34	    spec.loader.exec_module(mod)
    35	    return mod

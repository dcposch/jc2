+SYSTEMS_DIR = OUT / "systems"
+LOGS_DIR = OUT / "logs"
+RESULT_PATH = OUT / "moh9966B_results.json"
+RECEIPT = ROOT / "xmodel" / "moh9966-branchB-sol56-20260903.run.v2"
+PRIMES = (32003, 32009, 32027)

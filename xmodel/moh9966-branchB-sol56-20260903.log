   152	def parse_unsat(out: str) -> dict:
   153	    lines = [line.strip() for line in out.splitlines()]
   154	
   155	    def next_after(label: str):
   156	        for i, line in enumerate(lines):
   157	            if line == label and i + 1 < len(lines):
   158	                return lines[i + 1]
   159	        return None
   160	
   161	    if "UNSAT_EMPTY" in out:
   162	        verdict = "EMPTY"
   163	    elif "UNSAT_NONTRIVIAL" in out:
   164	        verdict = "NONTRIVIAL"
   165	    else:
   166	        verdict = "ERROR"
   167	    return {
   168	        "verdict": verdict,
   169	        "basis_size": next_after("UNSAT_DONE basis_size="),
   170	        "control_c1_nontrivial": "UNSAT_CONTROL_C1_NONTRIVIAL" in out,
   171	    }
   172	
   173	
   174	def run_unsat(path: Path, timeout: int) -> dict:
   175	    t0 = time.time()
   176	    try:
   177	        r = subprocess.run(
   178	            ["Singular", "-q", "--no-rc", str(path)],
   179	            capture_output=True,
   180	            text=True,
   181	            timeout=timeout,
   182	        )
   183	    except subprocess.TimeoutExpired as e:
   184	        stdout = e.stdout.decode("utf-8", "ignore") if isinstance(e.stdout, bytes) else (e.stdout or "")
   185	        stderr = e.stderr.decode("utf-8", "ignore") if isinstance(e.stderr, bytes) else (e.stderr or "")
   186	        return {"verdict": "TIMEOUT", "elapsed_s": round(time.time() - t0, 3), "stdout_tail": (stdout + stderr)[-2000:]}
   187	    out = (r.stdout or "") + (r.stderr or "")
   188	    ans = parse_unsat(out)
   189	    ans.update({"elapsed_s": round(time.time() - t0, 3), "returncode": r.returncode, "stdout_tail": out[-2000:]})
   190	    return ans

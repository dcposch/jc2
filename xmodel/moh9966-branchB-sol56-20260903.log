+        },
+        "maximal_envelope_support_sites": {
+            "raw_Laurent_from_forward_polynomiality_and_two_faces": {
+                "f": envelope_site_count(66, -12, None),
+                "g": envelope_site_count(99, -18, None),
+                "T2": envelope_site_count(55, -10, None),

    90	def build_branch_a_system(tp):
    91	    """Moh branch A, constructible A/B superset.
    92	
    93	    Moh prints "reduced ... to 10 coefficients" for this branch, but omits
    94	    the actual ten-coefficient equations. The p.210 two-point d'=2,e'=3
    95	    A/B chart is a source-checked predecessor of such eta reductions; emptiness
    96	    of it is a stronger kill for any specialization contained in it.
    97	    """
    98	    row = tp.Row("99-branch-A-linear-power-AB-superset", 27, 18, 21, 8, 4, "MOH-p209")
    99	    eqs, params, T, meta = tp.d2e3_ab_system(row, "fixed")
   100	    meta = dict(meta)
   101	    meta.update(
   102	        {
   103	            "source_branch": "LINEAR-POWER",
   104	            "moh_printed_coefficients": 10,
   105	            "constructed_coefficients_excluding_c": len(params) - 1,
   106	            "constructed_unknowns_including_c": len(params),
   107	            "rabinowitsch_symbol": str(T),
   108	            "row": asdict(row),
   109	            "interpretation": (
   110	                "p.210 two-point A/B Jacobian system for the transformed "
   111	                "(27,18;M2=21;V2=8;k=4) row; not Moh's omitted eta-reduced "
   112	                "ten-coefficient display"
   113	            ),
   114	        }
   115	    )
   116	    return row, eqs, params, T, meta

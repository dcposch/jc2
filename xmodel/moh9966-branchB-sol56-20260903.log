    96	    local_numerators = [us * degree for degree in global_degrees]
    97	    assert all(value % ds == 0 for value in local_numerators)
    98	    local_degrees = [value // ds for value in local_numerators]
    99	    assert local_degrees == [base_degree * value for value in exponents]

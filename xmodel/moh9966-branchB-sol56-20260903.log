option(redSB);
ideal CE={factor},T*({factor})-1;
ideal GCE=std(CE);
if (reduce(1,GCE)==0) {{ print("CONTROL_EMPTY_PASS"); }} else {{ print("CONTROL_EMPTY_FAIL"); }}
ideal CN=a-1,k-1,T*({factor})-1;
ideal GCN=std(CN);
if (reduce(1,GCN)!=0) {{ print("CONTROL_NONEMPTY_PASS"); }} else {{ print("CONTROL_NONEMPTY_FAIL"); }}
ideal E=
  {eqs};
ideal GU=std(E);
if (reduce(1,GU)!=0) {{ print("UNSATURATED_NONUNIT_PASS"); }} else {{ print("UNSATURATED_NONUNIT_FAIL"); }}
ideal I=E,T*({factor})-1;
ideal G=std(I);
print("GENERATOR_COUNT"); size(E);
print("EXTENDED_GENERATOR_COUNT"); size(I);
print("BASIS_SIZE"); size(G);
print("BASIS_BEGIN"); G; print("BASIS_END");
if (reduce(1,G)==0) {{ print("MAIN_SATURATED_EMPTY"); }} else {{ print("MAIN_NONUNIT"); }}
quit;
'''


def parse(text: str) -> dict:
    lines = [line.strip() for line in text.splitlines()]

    def after(label: str) -> str | None:
        try:
            return lines[lines.index(label) + 1]
        except (ValueError, IndexError):
            return None

    try:
        lo = lines.index("BASIS_BEGIN") + 1
        hi = lines.index("BASIS_END")
        basis = lines[lo:hi]
    except ValueError:
        basis = []
    return {
        "control_empty_pass": "CONTROL_EMPTY_PASS" in lines,
        "control_nonempty_pass": "CONTROL_NONEMPTY_PASS" in lines,
        "unsaturated_nonunit_pass": "UNSATURATED_NONUNIT_PASS" in lines,
        "generator_count": after("GENERATOR_COUNT"),
        "extended_generator_count": after("EXTENDED_GENERATOR_COUNT"),
        "basis_size": after("BASIS_SIZE"),
        "basis": basis,
        "verdict": (
            "SATURATED-EMPTY" if "MAIN_SATURATED_EMPTY" in lines
            else "NONUNIT" if "MAIN_NONUNIT" in lines
            else "ERROR"
        ),
    }


def main() -> None:
    records = []
    for branch in ("B", "C"):
        for char in CHARACTERISTICS:
            label = "Q" if char == 0 else str(char)
            path = HERE / f"reduced_{branch}_{label}.sing"
            path.write_text(script_text(branch, char))
            t0 = time.perf_counter()
            proc = subprocess.run(
                ("Singular", "-q", "--no-rc", str(path)),
                text=True,
                capture_output=True,
                timeout=120,
            )
            elapsed = time.perf_counter() - t0
            output = (proc.stdout or "") + (proc.stderr or "")
            rec = parse(output)
            rec.update({
                "branch": branch,
                "char": char,
                "elapsed_s": round(elapsed, 6),
                "returncode": proc.returncode,
                "script": str(path),
                "stdout": output,
            })
            if proc.returncode != 0:
                rec["verdict"] = "ERROR"
            if not (rec["control_empty_pass"] and rec["control_nonempty_pass"]):
                rec["verdict"] = "CONTROL-FAIL"
            if not rec["unsaturated_nonunit_pass"]:
                rec["verdict"] = "CONTROL-FAIL"
            rec["raw_coefficient_count"] = SYSTEMS[branch]["raw_coefficient_count"]
            rec["dropped_redundant"] = SYSTEMS[branch]["dropped_redundant"]
            records.append(rec)

    # Direct rational witness for B: a=1,k=5,q=z(z-2)(z+3)^2.
    records.append({
        "branch": "B",
        "direct_Q_witness": {
            "a": 1,
            "k": 5,
            "q3": 4,
            "q2": -3,
            "q1": -18,
            "q0": 0,
            "q_factorization": "z*(z-2)*(z+3)^2",
            "rabinowitsch_T": "1/5",
            "ode_remainder": 0,
        },
    })
    out = HERE / "results.json"
    out.write_text(json.dumps(records, indent=2, sort_keys=True) + "\n")
    print(json.dumps(records, indent=2, sort_keys=True))


if __name__ == "__main__":
    main()

+| 7 | `(6;8,9)`  | `(6,2^3,1,1)` | 18 | 3 | 14 |
+| 5 | `(6;8,11)` | `(6,2^4,1,1)` | 19 | 2 | 16 |
+| 3 | `(6;8,13)` | `(6,2^5,1,1)` | 20 | 1 | 18 |

    53	print("CONCLUSION: the claimed deg_x(nonconstant digit)<=k+1 fails already")
    54	print("  for Keller automorphisms, at fixed (k,p,q,r)=(0,p,1,r), as s grows.")
    55	print("  The number of nonconstant digits stays 1; its x-degree and phi-moduli grow.")

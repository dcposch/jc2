    24	            if j==5 and i==0:
    25	                continue  # leader
    26	            hs.append((i,j))
    27	            print("   x^%d y^%d" % (i,j))
    28	    print("  free in h:", len(hs))
    29	    print("== beta, bound ord_sigma >= -5/2, deg_y<=4, deg_x<=8 ==")
    30	    bs = []
    31	    for j in range(0, 5):
    32	        imax = min(8, 10-j, int((5*j+10)//4))
    33	        for i in range(0, imax+1):
    34	            bs.append((i,j))
    35	    print("  free in beta:", len(bs), "  total h+beta+c =", len(hs)+len(bs)+1)
    36	

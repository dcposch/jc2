     1	#!/usr/bin/env python3
     2	"""M2-DESCENT: exact eta-expansion engine (Moh 1983 pp.150-151).
     3	
     4	Given f, g in k[x,y] monic in y with deg_y g = n, deg_y f = m, computes
     5	    eta = g^{-1/n} in k[x]((y^{-1}))~,   f = eta^{-m} + sum_{j>-m} f_j(x) eta^j
     6	and returns the characteristic data {M_j, d_j} of Moh p.150.
     7	
     8	Coefficients: exact Fractions; polynomials in x are dicts {deg: Fraction}.
     9	Stdlib only.  Controls at the bottom.
    10	"""
    11	from fractions import Fraction as F
    12	from math import gcd
    13	
    14	# ---------- tiny polynomial ring Q[x] --------------------------------------
    15	def pzero(): return {}
    16	def pconst(c): c = F(c); return {} if c == 0 else {0: c}
    17	def padd(a, b):
    18	    r = dict(a)
    19	    for k, v in b.items():
    20	        w = r.get(k, F(0)) + v
    21	        if w: r[k] = w
    22	        else: r.pop(k, None)
    23	    return r
    24	def pscal(a, c):
    25	    c = F(c)
    26	    return {} if c == 0 else {k: v*c for k, v in a.items()}
    27	def pmul(a, b):
    28	    r = {}
    29	    for i, u in a.items():
    30	        for j, v in b.items():
    31	            k = i+j; w = r.get(k, F(0)) + u*v
    32	            if w: r[k] = w
    33	            else: r.pop(k, None)
    34	    return r
    35	def pdeg(a): return max(a) if a else -1
    36	
    37	# ---------- Laurent series in u = y^{-1}, coefficients in Q[x] -------------
    38	class Ser:
    39	    """sum_{k=lo}^{lo+len-1} c[k] u^k, truncated at u^{hi} (exclusive)."""
    40	    __slots__ = ('lo', 'c', 'hi')
    41	    def __init__(self, lo, c, hi):
    42	        self.lo, self.c, self.hi = lo, c, hi          # c: list of Q[x]
    43	    def coeff(self, k):
    44	        i = k - self.lo
    45	        return self.c[i] if 0 <= i < len(self.c) else pzero()
    46	    def ordv(self):
    47	        for i, p in enumerate(self.c):
    48	            if p: return self.lo + i
    49	        return None
    50	
    51	def s_mul(A, B, hi):
    52	    lo = A.lo + B.lo
    53	    n = hi - lo
    54	    if n <= 0: return Ser(lo, [], hi)
    55	    out = [pzero()]*n
    56	    for i, u in enumerate(A.c):
    57	        if not u: continue
    58	        for j, v in enumerate(B.c):
    59	            if not v: continue
    60	            k = A.lo+i + B.lo+j - lo
    61	            if 0 <= k < n: out[k] = padd(out[k], pmul(u, v))
    62	    return Ser(lo, out, hi)
    63	
    64	def s_sub(A, B, hi):
    65	    lo = min(A.lo, B.lo); n = hi - lo
    66	    out = [pzero()]*max(n, 0)
    67	    for k in range(lo, hi):
    68	        out[k-lo] = padd(A.coeff(k), pscal(B.coeff(k), -1))
    69	    return Ser(lo, out, hi)
    70	
    71	def unit_pow(G, alpha, hi):
    72	    """G = 1 + O(u); returns G^alpha as a series in u truncated at u^hi.
    73	       Recursion N e_N = alpha*sum_{j>=1} j g_j e_{N-j} - sum_{k<N} k e_k g_{N-k}."""
    74	    N = hi
    75	    g = [G.coeff(k) for k in range(0, N)]
    76	    assert g[0] == {0: F(1)}, "unit_pow needs constant term 1"
    77	    e = [pzero()]*N; e[0] = {0: F(1)}
    78	    for M in range(1, N):
    79	        acc = pzero()
    80	        for j in range(1, M+1):
    81	            if g[j]: acc = padd(acc, pscal(pmul(g[j], e[M-j]), F(j)*alpha))
    82	        for k in range(1, M):
    83	            if e[k]: acc = padd(acc, pscal(pmul(e[k], g[M-k]), -F(k)))
    84	        e[M] = pscal(acc, F(1, M))
    85	    return Ser(0, e, hi)
    86	
    87	def poly_to_ser(P, degy, hi):
    88	    """P = dict {(i,j): Fraction} for x^i y^j, deg_y P = degy, monic in y.
    89	       returns P as a series in u=y^{-1}: P = u^{-degy}*(1 + a_1 u + ...)."""
    90	    co = {}
    91	    for (i, j), c in P.items():
    92	        k = degy - j
    93	        co.setdefault(k, {})
    94	        co[k][i] = co[k].get(i, F(0)) + F(c)
    95	    lo = -degy
    96	    out = [pzero()]*(hi-lo)
    97	    for k, p in co.items():
    98	        p = {a: b for a, b in p.items() if b}
    99	        idx = (k-degy) - lo
   100	        if 0 <= idx < len(out): out[idx] = p
   101	    return Ser(lo, out, hi)
   102	
   103	def char_data(fP, m, gP, n, extra=6):
   104	    """returns (Ms, ds, fcoeffs) -- Moh p.150 characteristic data of (f,g)."""
   105	    hi = n + extra                      # need eta-exponents up to n-1
   106	    prec = n + m + extra
   107	    G = poly_to_ser(gP, n, hi)          # g = u^{-n}(1 + ...)
   108	    Gu = Ser(0, [G.coeff(k-n) for k in range(0, prec)], prec)   # the unit part
   109	    E = unit_pow(Gu, F(-1, n), prec)    # E = (unit)^{-1/n};  eta = u*E
   110	    Einv = unit_pow(Gu, F(1, n), prec)
   111	    # eta^j = u^j E^j
   112	    R = poly_to_ser(fP, m, hi)
   113	    fj = {}
   114	    Ej = Ser(0, [pzero()]*prec, prec); Ej.c[0] = {0: F(1)}
   115	    for _ in range(m): Ej = s_mul(Ej, Einv, prec)      # E^{-m}
   116	    for j in range(-m, n):
   117	        c = R.coeff(j)
   118	        if c:
   119	            fj[j] = c
   120	            T = Ser(j, [pmul(c, Ej.coeff(k)) for k in range(0, hi-j)], hi)
   121	            R = s_sub(R, T, hi)
   122	        Ej = s_mul(Ej, E, prec)
   123	    # characteristic data
   124	    Ms, ds = [], [n]
   125	    cur = n
   126	    for j in sorted(fj):
   127	        if j == -m and fj[j] == {0: F(1)}: pass
   128	        if cur and j % cur != 0:
   129	            Ms.append(j); cur = gcd(cur, abs(j)) if cur else abs(j); ds.append(cur)
   130	    return Ms, ds, fj

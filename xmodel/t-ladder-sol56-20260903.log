    39	print("\n== SLICE: Newton-tight h + Moh beta, groebner J=c x^4 at c!=0 ==")
    40	a,b0,b1,b2,b3,b4,e = sp.symbols('a b0 b1 b2 b3 b4 e')
    41	p,q,r,s = sp.symbols('p q r s')
    42	c, T = sp.symbols('c T')
    43	h = sp.expand(y**5 + a*x**2*y + b4*y**4 + b3*y**3 + b2*y**2 + b1*y + b0 + e*x)
    44	A = sp.expand((h - h.subs(y,0))/y)
    45	beta = sp.expand(p*A + q*y + r*x + s)
    46	qd, rd = sp.div(sp.Poly(sp.expand(beta**2), y), sp.Poly(h, y), y)
    47	alpha = sp.expand(qd.as_expr())
    48	f = sp.expand(h**2 + 2*beta)
    49	g = sp.expand(h**3 + 3*beta*h + sp.Rational(3,2)*alpha)
    50	print("deg f,g", sp.degree(f,y), sp.degree(g,y), "deg_x", sp.degree(f,x), sp.degree(g,x))
    51	print("alpha deg_y", sp.degree(alpha,y))
    52	
    53	J = sp.expand(sp.diff(f,x)*sp.diff(g,y) - sp.diff(f,y)*sp.diff(g,x))
    54	print("J deg_y,deg_x,total", sp.degree(J,y), sp.degree(J,x), sp.total_degree(J))
    55	R = sp.expand(J - c*x**4)
    56	PR = sp.Poly(R, x, y)

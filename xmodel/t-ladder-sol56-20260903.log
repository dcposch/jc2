     1	#!/usr/bin/env python3
     2	"""Uniform negative control for the proposed gamma-degree ladder.
     3	
     4	For integers k>=0, s>k+1, r>=2, p>=2 put
     5	    X=x+y,  Y=x^(k+1)/(k+1),  U=Y+phi(X),
     6	    H=X+U^r,  P=H^p+U,  Q=H,
     7	where phi is an arbitrary monic degree-s polynomial.  Characteristic zero is
     8	required for 1/(k+1).  We use J(A,B)=A_x*B_y-A_y*B_x.
     9	
    10	The proof is performed in the differential ring Q(k,r,p)[X,Y,phi(X)] and
    11	then composed with (x,y)->(X,Y).  This avoids expanding degree p*r*s
    12	polynomials and works uniformly in all four integer parameters.
    13	"""
    14	import sympy as sp
    15	
    16	X, Y = sp.symbols("X Y")
    17	r, p = sp.symbols("r p", integer=True, positive=True)
    18	phi = sp.Function("phi")
    19	U = Y+phi(X)
    20	H = X+U**r
    21	P = H**p+U
    22	Q = H
    23	
    24	
    25	def jac(u, v, z, w):
    26	    return sp.diff(u, z)*sp.diff(v, w)-sp.diff(u, w)*sp.diff(v, z)
    27	
    28	
    29	J_XY = sp.simplify(jac(P, Q, X, Y))
    30	assert J_XY == -1
    31	
    32	x, y = sp.symbols("x y")
    33	k = sp.symbols("k", integer=True, nonnegative=True)
    34	Xxy = x+y
    35	Yxy = x**(k+1)/(k+1)
    36	J_change = sp.simplify(jac(Xxy, Yxy, x, y))
    37	assert J_change == -x**k
    38	assert sp.expand(J_XY*J_change) == x**k
    39	
    40	print("RING: characteristic-zero polynomial ring; J=Ax*By-Ay*Bx")
    41	print("UNIFORM_IDENTITY: J_XY(P,Q)=-1 and J_xy(X,Y)=-x^k")

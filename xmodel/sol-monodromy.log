+    add(9, 2, "3^2:D(2*4)", 72, affine_generators(3, 2, (a9, b9)))
+    add(9, 3, "3^2:Q(8)=M(9)", 72, affine_generators(3, 2, (a9, c9)))
+    add(9, 4, "3^2:8=AGL(1,9)", 72, affine_generators(3, 2, (d9,)))

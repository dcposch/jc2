+
+    # Degree 8 affine groups; matrices are the PrimGrp gps1.g matrices.
+    a8 = ((0, 1, 0), (0, 0, 1), (1, 1, 0))
+    b8 = ((1, 0, 0), (0, 0, 1), (0, 1, 1))

+
+def hurwitz_genus(branch_cycles: Sequence[Perm]) -> int:
+    n = len(branch_cycles[0])
+    ramification = sum(index(perm) for perm in branch_cycles)
+    numerator = ramification - 2 * n + 2
+    assert numerator % 2 == 0
+    return numerator // 2

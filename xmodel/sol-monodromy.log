+    )
+    add(8, 6, "A(8)", math.factorial(8) // 2, alternating_generators(8))
+    add(8, 7, "S(8)", math.factorial(8), symmetric_generators(8))
+
+    # Degree 9 affine groups; in F_3, GAP's Z(3) is 2 and Z(3)^0 is 1.
+    a9 = ((0, 1), (2, 0))
+    b9 = ((1, 0), (0, 2))
+    c9 = ((2, 2), (2, 1))
+    d9 = ((0, 1), (1, 1))

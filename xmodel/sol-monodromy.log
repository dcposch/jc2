+def partitions(total: int, minimum: int = 1, maximum: int | None = None) -> Iterator[Profile]:
+    """Nonincreasing integer partitions with every part >= minimum."""
+    if total == 0:
+        yield ()
+        return
+    upper = min(total, maximum if maximum is not None else total)
+    for first in range(upper, minimum - 1, -1):
+        for tail in partitions(total - first, minimum, first):
+            yield (first, *tail)

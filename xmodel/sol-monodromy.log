+        (
+            from_cycles(9, (1, 2, 3, 4, 5, 6, 7)),
+            from_cycles(9, (2, 3, 5), (4, 7, 6)),
+            from_cycles(9, (1, 8), (2, 4), (3, 7), (5, 6)),
+            from_cycles(9, (2, 7), (3, 6), (4, 5), (8, 9)),

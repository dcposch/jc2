+    add(8, 3, "ASL(3,2)", 1344, affine_generators(2, 3, (a8, c8)))
+    add(
+        8,
+        4,
+        "PSL(2,7)",
+        168,
+        (
+            from_cycles(8, (1, 2, 3, 4, 5, 6, 7)),
+            from_cycles(8, (2, 3, 5), (4, 7, 6)),
+            from_cycles(8, (1, 8), (2, 7), (3, 4), (5, 6)),

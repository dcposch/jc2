+            f"  {key:11s} S(9), B={value['branch_values']}, "
+            f"P={value['ramified_points']}, genus={value['genus']}"
+        )
+    orevkov = metadata["orevkov_boundary_control"]
+    assert isinstance(orevkov, dict)

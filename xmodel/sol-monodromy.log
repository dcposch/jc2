+    add(9, 5, "AGammaL(1,9)", 144, affine_generators(3, 2, (e9, d9)))
+    add(9, 6, "3^2:(2'A(4))", 216, affine_generators(3, 2, (a9, f9)))
+    add(9, 7, "AGL(2,3)", 432, affine_generators(3, 2, (d9, f9)))
+    add(
+        9,

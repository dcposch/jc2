+    add(7, 2, "D(2*7)", 14, (translation_7, multiplier_7(6)))
+    add(7, 3, "7:3", 21, (translation_7, multiplier_7(2)))
+    add(7, 4, "AGL(1,7)", 42, (translation_7, multiplier_7(3)))
+    add(

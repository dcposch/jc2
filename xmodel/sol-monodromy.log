+    add(7, 6, "A(7)", math.factorial(7) // 2, alternating_generators(7))
+    add(7, 7, "S(7)", math.factorial(7), symmetric_generators(7))
+
+    # Degree 8 affine groups; matrices are the PrimGrp gps1.g matrices.
+    a8 = ((0, 1, 0), (0, 0, 1), (1, 1, 0))

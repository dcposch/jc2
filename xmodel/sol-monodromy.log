+    )
+    add(
+        8,
+        5,
+        "PGL(2,7)",
+        336,
+        (
+            from_cycles(8, (1, 2, 3, 4, 5, 6, 7)),
+            from_cycles(8, (2, 4, 3, 7, 5, 6)),

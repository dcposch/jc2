+    if args.json:
+        print(json.dumps({"metadata": metadata, "rows": [asdict(row) for row in rows]}, indent=2))
+    else:
+        print_summary(rows, metadata, details=args.details)
+        print(f"checks: {len(rows)} admissible group/profile rows; PASS")
+    return 0

+    There is no promoted multi-pole analogue, so b=1 vertices in a multi-pole
+    configuration remain.  The optional H5a/N1 condition gcd(a,nu)=1 is not
+    imposed here.
+    """
+    return not (len(config) == 1 and config[0].b == 1)

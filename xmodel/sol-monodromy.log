+def alternating_generators(n: int) -> tuple[Perm, ...]:
+    three_cycle = from_cycles(n, (1, 2, 3))
+    long_even = (
+        from_cycles(n, tuple(range(1, n + 1)))
+        if n % 2 == 1
+        else from_cycles(n, tuple(range(2, n + 1)))
+    )
+    return three_cycle, long_even

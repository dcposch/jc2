+  int bad = 0;
+  int rows = 0;
+  list b;
+  for (i = 1; i <= size(I); i++)
+  {
+    if (I[i] != 0)
+    {
+      rows++;
+      b = pn_term_weight_bounds(I[i], W);
+      if (b[1] != b[2])

   429	def parse_singular_verdict(run: dict) -> dict:
   430	    text = (run.get("stdout_tail") or "") + "\n" + (run.get("stderr_tail") or "")
   431	    verdict = "TIMEOUT" if run["status"] == "TIMEOUT" else "ERROR"
   432	    if "MAIN_SATURATED_EMPTY" in text or "MAIN_QUADRATIC_FIELD_EMPTY" in text or "MAIN_EXACT_UNIT" in text:
   433	        verdict = "SATURATED-EMPTY"
   434	    elif "MAIN_NONTRIVIAL" in text or "MAIN_NONUNIT" in text:
   435	        verdict = "COUNTING-BOUND"
   436	    match = re.search(r"Maximum resident set size \\(kbytes\\):\\s*(\\d+)", run.get("stderr_tail", ""))

+def parse_weight_file(path: Path) -> dict:
+    if not path.is_file():
+        return {"status": "MISSING"}
+    rows = 0
+    bad = 0
+    sample_bad = []
+    with path.open("r", encoding="utf-8") as handle:
+        next(handle, None)
+        for line in handle:

+proc pn_onehot(int vi)
+{
+  intvec W;
+  int j;
+  for (j = 1; j <= nvars(basering); j++)
+  {
+    W[j] = 0;
+  }
+  W[vi] = 1;
+  return(W);
+}
+
+proc pn_var_degree(poly f, int vi)
+{
+  if (f == 0)
+  {
+    return(-1);
+  }
+  intvec W = pn_onehot(vi);
+  return(deg(f, W));
+}
+
+proc pn_is_qstar_affine(poly f, int vi)
+{
+  list out;
+  if (f == 0 || pn_var_degree(f, vi) != 1)
+  {
+    out[1] = 0;
+    return(out);
+  }
+  poly v = var(vi);
+  poly coeff = diff(f, v);
+  if (coeff == 0 || deg(coeff) > 0)
+  {
+    out[1] = 0;
+    return(out);
+  }
+  poly rem = f - coeff * v;
+  if (pn_var_degree(rem, vi) > 0)
+  {
+    out[1] = 0;
+    return(out);
+  }
+  poly rhs = -rem / coeff;
+  if (pn_var_degree(rhs, vi) > 0)
+  {
+    out[1] = 0;
+    return(out);
+  }
+  out[1] = 1;
+  out[2] = coeff;
+  out[3] = rem;
+  out[4] = rhs;
+  return(out);
+}

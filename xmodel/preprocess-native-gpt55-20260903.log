+INPUTS = Path("/tmp/jc2-lane.lpjOgw/inputs")
+RECEIPT = ROOT / "xmodel/preprocess-native-gpt55-20260903.run.v2"
+HELPER = OUT / "prep.sing"
+EMITTER = ROOT / "box/emitter-20260903"
+PRIMES = (32003, 32009, 32027)
+
+
+@dataclass(frozen=True)
+class NativeCase:
+    stem: str
+    row_key: str
+    part_label: str
+    rows: Path
+    system: Path
+    meta: Path
+
+
+TARGET_25_15 = [
+    NativeCase(

   116	def load_module(path: Path, name: str):
   117	    spec = importlib.util.spec_from_file_location(name, path)
   118	    if spec is None or spec.loader is None:
   119	        raise RuntimeError(f"cannot import {path}")
   120	    module = importlib.util.module_from_spec(spec)
   121	    sys.modules[name] = module
   122	    spec.loader.exec_module(module)
   123	    return module

+  poly rhs = -rem / coeff;
+  if (pn_var_degree(rhs, vi) > 0)
+  {
+    out[1] = 0;
+    return(out);
+  }
+  out[1] = 1;
+  out[2] = coeff;
+  out[3] = rem;
+  out[4] = rhs;
+  return(out);
+}

   648	    OUT.mkdir(parents=True, exist_ok=True)
   649	    manifest = verify_inputs()
   650	    (OUT / "results").mkdir(exist_ok=True)
   651	    (OUT / "results/manifest.json").write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
   652	    if not manifest["ok"]:
   653	        raise SystemExit("frozen input hash mismatch")
   654	    if args.command == "verify":
   655	        print(json.dumps(manifest, indent=2, sort_keys=True))
   656	        return
   657	
   658	    validations = None
   659	    targets = None
   660	    if args.command in {"validate", "all"}:
   661	        validations = validation_runs(args.validation_timeout)
   662	        print(json.dumps({"validation": {k: "done" for k in validations}}, indent=2))
   663	    if args.command in {"targets", "all"}:
   664	        targets = process_targets(args.timeout, args.max_pivots)
   665	        print(json.dumps({"targets": {k: summarize_qstage(v) for k, v in targets.items()}}, indent=2, sort_keys=True))
   666	    if args.command in {"report", "all"}:
   667	        path = write_report(manifest, validations, targets)
   668	        print(f"REPORT={path.relative_to(ROOT)}")
   669	
   670	
   671	if __name__ == "__main__":
   672	    main()


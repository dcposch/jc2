+def run_singular_timed(script: Path, stem: str, timeout: int) -> dict:
+    log = OUT / "logs"
+    return run_process(
+        ["/usr/bin/time", "-v", "Singular", "-q", "--no-rc", str(script)],
+        timeout,
+        log / f"{stem}.out",
+        log / f"{stem}.err",
+    )

// exact t=3 system over K=Q(y)/(147*y^2-84*y+11)
// y denotes q7_1 after the rigorously normalized q4_1=1 slice
// c=10*y*(2-21*y)/343 is a coefficient-field unit and is eliminated
ring RAC=0,(gamma,pi),dp;
poly FAC=pi;
poly GAC=pi-(gamma^2)/2;
poly JAC=diff(FAC,gamma)*diff(GAC,pi)-diff(FAC,pi)*diff(GAC,gamma);
if (JAC==gamma) { print("CONTROL_ACTUAL_PAIR_PASS J=gamma"); } else { print("CONTROL_ACTUAL_PAIR_FAIL"); }
ring RC=(0,q7_1),(u,W),dp;
minpoly=147*q7_1^2-84*q7_1+11;
number cbar=(10*q7_1*(2-21*q7_1))/343;
number cbar_inverse=1/cbar;
if (cbar*cbar_inverse==1) { print("CONTROL_C_UNIT_PASS"); } else { print("CONTROL_C_UNIT_FAIL"); }
ideal CE=u,W*u-1;
ideal GE=std(CE);

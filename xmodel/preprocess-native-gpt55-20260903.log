+            raise ValueError(f"unexpected row header in {path}: {header}")
+        for line in handle:
+            line = line.rstrip("\n")
+            if not line:
+                continue
+            source, hpow, xpow, ypow, expr = line.split("|", 4)
+            yield int(source), int(hpow), int(xpow), int(ypow), expr
+
+
+def singular_expr_text(value) -> str:

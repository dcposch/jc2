+                q["grading_status"],
+                q["grading_rank"],
+                q["grading_nullity"],
+                field.get("verdict"),
+                field.get("elapsed", 0.0),
+            )
+        )
+    lines.append(
+        "| `(33,22;30;8;1)` `[3]` | - | 62 rows, 28 vars | direct exact | %s | %.3f s |"

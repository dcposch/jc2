+    return {
+        "source": str(source),
+        "source_sha256": sha256_file(source),
+        "t": int(data["t"]),
+        "e": int(data["e"]),
+        "q": int(data["q"]),
+        "unknowns_including_c": len(variables),
+        "equations": len(data["tagged"]),

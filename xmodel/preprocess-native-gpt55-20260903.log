+def k16_weight(name: str, t: int) -> int:
+    if name == "c":
+        return 20 * t + 5
+    fixed = {"b1": 1, "b2": 2, "b3": 3, "b4": 4}
+    if name in fixed:
+        return fixed[name]
+    match = re.match(r"a(\d+)_(\d+)$", name)
+    if match:
+        i = int(match.group(1))
+        j = int(match.group(2))
+        return 4 * i - j
+    match = re.match(r"q(\d+)_(\d+)$", name)
+    if match:
+        i = int(match.group(1))
+        j = int(match.group(2))
+        if j == 0:
+            return 4 * i - (3 if i == 2 * t + 1 else 0)
+        if j == 1:
+            return 4 * i - (2 if i == 2 * t + 1 else 3)
+        return 4 * i - 3 * j
+    return 1

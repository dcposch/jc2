+        else:
+            verdict = "COUNTING-BOUND"
+            reason = "native Q* stage errored before a certificate"
+        lines.append(
+            "| `%s` | %s | %s | %s | %s | %s | %s | %s: %s |"
+            % (
+                meta.get("partition"),
+                meta.get("unknowns"),
+                meta.get("equations"),
+                status,
+                pivots,
+                residual,

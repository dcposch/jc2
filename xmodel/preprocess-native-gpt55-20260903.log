+        "nonhomogeneous_rows": rec.get("weight_report", {}).get("nonhomogeneous_rows"),
+        "grading_status": rec.get("grading_lp", {}).get("status"),
+        "grading_rank": rec.get("grading_lp", {}).get("rank"),
+        "grading_nullity": rec.get("grading_lp", {}).get("nullity"),

+    unit_weights[v] = pn_onehot(v);
+  }
+
+  int i;
+  int k;
+  int terms = 0;
+  int constraints = 0;
+  int term_index;
+  intvec base_exp;
+  poly p;
+  poly lt;
+  string line;
+  for (i = 1; i <= size(I); i++)
+  {
+    if (I[i] != 0)
+    {
+      p = I[i];
+      lt = lead(p);
+      for (v = 1; v <= n; v++)
+      {
+        base_exp[v] = deg(lt, unit_weights[v]);
+      }
+      p = p - lt;
+      terms++;
+      term_index = 1;
+      while (p != 0)
+      {
+        lt = lead(p);
+        line = string(i - 1) + "|" + string(term_index);
+        for (v = 1; v <= n; v++)
+        {
+          line = line + "|" + string(deg(lt, unit_weights[v]) - base_exp[v]);
+        }
+        write(":a " + path, line);
+        constraints++;
+        terms++;
+        p = p - lt;
+        term_index++;
+      }

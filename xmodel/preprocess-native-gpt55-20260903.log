+  string line;
+  for (i = 1; i <= size(I); i++)
+  {
+    if (I[i] != 0)
+    {
+      p = I[i];
+      lt = lead(p);
+      for (v = 1; v <= n; v++)
+      {
+        base_exp[v] = deg(lt, unit_weights[v]);
+      }
+      p = p - lt;
+      terms++;
+      term_index = 1;
+      while (p != 0)
+      {
+        lt = lead(p);
+        line = string(i - 1) + "|" + string(term_index);

+def process_targets(timeout: int, max_pivots: int) -> dict:
+    out: dict[str, dict] = {}
+    for case in TARGET_25_15:
+        meta = json.loads(case.meta.read_text(encoding="utf-8"))["meta"]
+        vars_in = parse_ring_variables(case.system)

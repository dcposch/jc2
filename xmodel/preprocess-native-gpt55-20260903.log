+        source = INPUTS / "t_order_system.py"
+        data = driver.build(t=3, gauged=True)
+    elif t == 4:
+        source = ROOT / "box/k16t3-20260903/t4/t4_order_system.py"
+        driver = load_module(source, "pn_k16_t4_order")
+        data = driver.build(gauged=True, t=4)
+    else:
+        raise ValueError(t)

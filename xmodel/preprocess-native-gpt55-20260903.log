+  int ok;
+  int degj;
+  for (i = 1; i <= size(I); i++)
+  {
+    if (I[i] != 0)
+    {
+      for (j = 1; j <= nvars(basering); j++)
+      {
+        if (alive[j] != 0)
+        {
+          degj = pn_var_degree(I[i], j);

+def verify_inputs() -> dict:
+    lane_inputs, rows = receipt_fields()
+    for row in rows:
+        row["actual_sha256"] = sha256_file(Path(row["path"]))
+        row["ok"] = row["actual_sha256"] == row["expected_sha256"]
+    return {

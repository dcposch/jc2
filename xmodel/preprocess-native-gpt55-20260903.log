    80	def receipt_fields() -> tuple[Path, list[dict]]:
    81	    fields: dict[int, dict[str, str]] = {}
    82	    lane_inputs = INPUTS
    83	    for line in RECEIPT.read_text(encoding="utf-8").splitlines():
    84	        if line.startswith("lane_inputs_dir="):
    85	            lane_inputs = Path(line.split("=", 1)[1])
    86	        match = re.match(r"charged_input_(\d+)_(basename|sha256)=(.*)", line)
    87	        if match:
    88	            fields.setdefault(int(match.group(1)), {})[match.group(2)] = match.group(3)
    89	    rows = []
    90	    for index in sorted(fields):
    91	        item = fields[index]
    92	        rows.append(
    93	            {
    94	                "index": index,
    95	                "basename": item["basename"],
    96	                "path": str(lane_inputs / item["basename"]),
    97	                "expected_sha256": item["sha256"],

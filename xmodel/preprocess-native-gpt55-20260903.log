+    ),
+    NativeCase(
+        "25_15_part_2_1_generic",
+        "25_15",
+        "2+1",
+        EMITTER / "rows/25_15_part_2_1_generic_rows.tsv",
+        EMITTER / "systems/25_15_part_2_1_generic_Q.sing",
+        EMITTER / "meta/25_15_part_2_1_generic.json",
+    ),
+    NativeCase(

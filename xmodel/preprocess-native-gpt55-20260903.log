+    vars_path.write_text("\n".join(variables) + "\n", encoding="utf-8")
+    lines = ["source_index|h_power|x_power|y_power|expr"]
+    for index, (h_power, monomial, expr) in enumerate(data["tagged"]):
+        lines.append(

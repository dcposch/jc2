+            "constraints": raw_constraints,
+            "unique_constraints": 0,
+            "rank": 0,
+            "nullity": len(active_positions),
+            "active_variables": len(active_positions),
+            "inactive_diff_violations": inactive_violations,
+            "weights": dict(zip(variables, weights)),

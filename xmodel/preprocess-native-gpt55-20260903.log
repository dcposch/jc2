+proc pn_find_c_affine(ideal I, int cidx)
+{
+  int best_i = 0;
+  int best_len = 2147483647;
+  poly best_rhs = 0;
+  list aff;
+  int i;
+  int sz;
+  for (i = 1; i <= size(I); i++)

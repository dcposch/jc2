+
+def summarize_qstage(rec: dict) -> dict:
+    q = rec.get("qstage", {})
+    return {
+        "run_status": rec.get("run", {}).get("status"),
+        "elapsed": rec.get("run", {}).get("elapsed"),
+        "pivots": rec.get("pivot_count_from_tsv", q.get("pivot_count")),

   156	def write_k16_rows(t: int, rows_path: Path, vars_path: Path) -> dict:
   157	    if t == 3:
   158	        driver = load_module(INPUTS / "t_order_system.py", "pn_k16_t3_order")
   159	        source = INPUTS / "t_order_system.py"
   160	        data = driver.build(t=3, gauged=True)
   161	    elif t == 4:
   162	        source = ROOT / "box/k16t3-20260903/t4/t4_order_system.py"
   163	        driver = load_module(source, "pn_k16_t4_order")
   164	        data = driver.build(gauged=True, t=4)
   165	    else:
   166	        raise ValueError(t)
   167	
   168	    rows_path.parent.mkdir(parents=True, exist_ok=True)
   169	    vars_path.parent.mkdir(parents=True, exist_ok=True)
   170	    variables = [str(item) for item in data["params"]] + [str(data["c"])]
   171	    vars_path.write_text("\n".join(variables) + "\n", encoding="utf-8")
   172	    lines = ["source_index|h_power|x_power|y_power|expr"]
   173	    for index, (h_power, monomial, expr) in enumerate(data["tagged"]):
   174	        lines.append(
   175	            "%d|%d|%d|%d|%s"
   176	            % (
   177	                index,
   178	                int(h_power),
   179	                int(monomial[0]),
   180	                int(monomial[1]),
   181	                singular_expr_text(expr),
   182	            )
   183	        )
   184	    rows_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
   185	    return {
   186	        "source": str(source),
   187	        "source_sha256": sha256_file(source),
   188	        "t": int(data["t"]),
   189	        "e": int(data["e"]),
   190	        "q": int(data["q"]),
   191	        "unknowns_including_c": len(variables),
   192	        "equations": len(data["tagged"]),
   193	        "rows_sha256": sha256_file(rows_path),
   194	    }
   195	
   196	
   197	def k16_weight(name: str, t: int) -> int:
   198	    if name == "c":
   199	        return 20 * t + 5
   200	    fixed = {"b1": 1, "b2": 2, "b3": 3, "b4": 4}
   201	    if name in fixed:
   202	        return fixed[name]
   203	    match = re.match(r"a(\d+)_(\d+)$", name)
   204	    if match:
   205	        i = int(match.group(1))
   206	        j = int(match.group(2))
   207	        return 4 * i - j
   208	    match = re.match(r"q(\d+)_(\d+)$", name)
   209	    if match:
   210	        i = int(match.group(1))
   211	        j = int(match.group(2))
   212	        return 4 * i - 3 * j
   213	    return 1
   214	
   215	
   216	def natural_weight(name: str, meta: dict | None, *, k16_t: int | None = None) -> int:
   217	    if k16_t is not None:
   218	        return k16_weight(name, k16_t)
   219	    if not meta:
   220	        return 1


   126	def parse_ring_variables(path: Path) -> list[str]:
   127	    with path.open("r", encoding="utf-8") as handle:
   128	        for line in handle:
   129	            line = line.strip()
   130	            if not line.startswith("ring R="):
   131	                continue
   132	            match = re.match(r"ring\s+R\s*=\s*(?:0|\d+|\([^)]*\))\s*,\s*\((.*)\)\s*,", line)
   133	            if not match:
   134	                raise ValueError(f"cannot parse ring line in {path}: {line[:200]}")
   135	            return [item.strip() for item in match.group(1).split(",") if item.strip()]
   136	    raise ValueError(f"no ring R declaration in {path}")
   137	
   138	
   139	def iter_pipe_rows(path: Path) -> Iterable[tuple[int, int, int, int, str]]:
   140	    with path.open("r", encoding="utf-8") as handle:
   141	        header = next(handle).strip()
   142	        if header != "source_index|h_power|x_power|y_power|expr":
   143	            raise ValueError(f"unexpected row header in {path}: {header}")
   144	        for line in handle:
   145	            line = line.rstrip("\n")
   146	            if not line:
   147	                continue
   148	            source, hpow, xpow, ypow, expr = line.split("|", 4)
   149	            yield int(source), int(hpow), int(xpow), int(ypow), expr
   150	
   151	
   152	def singular_expr_text(value) -> str:
   153	    return str(value).replace("**", "^")

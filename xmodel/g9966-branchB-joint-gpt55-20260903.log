+def automorphism_controls() -> dict[str, Any]:
+    x, y = sp.symbols("x y")
+    F = x + y**6
+    G = y + F**7
+    J = sp.expand(sp.diff(F, x) * sp.diff(G, y) - sp.diff(F, y) * sp.diff(G, x))
+    A, C = sp.symbols("A C")
+    f_lin = A * x + y
+    g_lin = C * x + y
+    Jlin = sp.expand(sp.diff(f_lin, x) * sp.diff(g_lin, y) - sp.diff(f_lin, y) * sp.diff(g_lin, x))
+    return {

+def coefficient_is_unit_in_all_fields(coefficient: sp.Expr) -> bool:
+    if not coefficient.is_Rational:
+        return False
+    rational = sp.Rational(coefficient)
+    numerator, denominator = int(rational.p), int(rational.q)
+    if numerator == 0:
+        return False

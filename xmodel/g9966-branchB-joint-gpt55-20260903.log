+def derive_pure_power_zeros(
+    rows: list[sp.Expr],
+    variables: list[sp.Symbol],
+    initial: dict[sp.Symbol, sp.Integer],
+) -> dict[sp.Symbol, sp.Integer]:
+    variable_set = set(variables)
+    zeros = dict(initial)
+    changed = True
+    while changed:
+        changed = False

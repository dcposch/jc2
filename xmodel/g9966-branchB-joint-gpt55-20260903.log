+    lines.append("box/g9966B-20260903/artifacts.sha256")
+    lines.append("```")
+    lines.append("")
+    lines.append("Typed final:")
+    lines.append("")
+    lines.append("```text")
+    lines.append("COUNTING-BOUND[BRANCH-B-HIGH-Z-DEPTH8-NONUNIT]")
+    lines.append("COUNTING-BOUND[DELTA-5/2-HIGH-Z-DEPTH8-NONUNIT]")
+    lines.append("OPEN[(99,66)-FULL-JOINT-NOT-DECIDED]")
+    lines.append("NO KELLER PAIR PRODUCED")
+    lines.append("```")
+    lines.append("")
+    lines.append("<!-- BODY-END -->")
+    REPORT.write_text("\n".join(lines) + "\n", encoding="utf-8")
+
+
+def write_manifest() -> None:

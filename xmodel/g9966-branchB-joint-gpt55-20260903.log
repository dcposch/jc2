+            "ansatz": "f=A*x+y, g=C*x+y",
+            "jacobian_row": str(Jlin),
+            "witness": {"A": 2, "C": 1, "jacobian": int(Jlin.subs({A: 2, C: 1}))},
+            "direct_jacobian_check": sp.expand(Jlin.subs({A: 2, C: 1}) - 1) == 0,
+        },

+                jacobian_band_counts[z_degree] += 1
+
+    rows = forced_linear_rows + approximate_root_rows + jacobian_rows
+    unknown_by_z: dict[int, int] = Counter(term["z_degree"] for term in unknown_terms)
+    return {
+        "branch": branch.key,

+        expected = fields[f"charged_input_{index}_sha256"]
+        path = input_dir / basename
+        actual = sha256(path)
+        ok = actual == expected
+        rows.append(
+            {
+                "index": index,
+                "basename": basename,
+                "path": str(path),
+                "expected_sha256": expected,
+                "actual_sha256": actual,

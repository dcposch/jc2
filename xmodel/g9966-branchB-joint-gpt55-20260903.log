+def write_manifest() -> None:
+    excluded = {"artifacts.sha256", "g9966B_joint_driver.stdout", "g9966B_joint_driver.stderr"}
+    paths = sorted(
+        path for path in OUT.rglob("*") if path.is_file() and path.name not in excluded
+    )

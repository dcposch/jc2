+    def deepest(branch: dict[str, Any]) -> tuple[int, dict[str, Any]]:
+        for depth in sorted((int(k) for k in branch["systems"]), reverse=True):
+            system = branch["systems"][str(depth)]
+            if system["verdict"] == "NONUNIT":

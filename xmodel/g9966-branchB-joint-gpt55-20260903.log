+    lines.append("")
+    lines.append(report_table(b, [4, 5, 6]))
+    lines.append(
+        f"Deepest branch-B family dimension seen by Singular is `{b_system['dimensions_seen']}` "
+        f"at depth {b_depth}, counting the Jacobian scalar.  Fixing `gamma` would subtract one "

+        "pointset_linear_reductions": [],
+        "pointset_pruning": {"enabled": False, "rule": "not used for charged replay"},
+        "variables": variables,
+        "variable_names": [str(v) for v in variables],
+        "fbands": fband_summaries,
+        "forced_linear_row_count": len(forced_linear_rows),

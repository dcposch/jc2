+    def apply_pointset_pruning() -> None:
+        nonlocal gbands, fbands, approximate_root_rows, jacobian_rows_by_band
+        new_subs = derive_pure_power_zeros(
+            forced_linear_rows + pointset_linear_rows + current_source_rows(),
+            variables,
+            active_subs,

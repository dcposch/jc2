+                "New from previous depth: "
+                f"{system['new_unknown_count_from_previous_depth']} Gbar coefficients, "
+                f"by z band {system['new_unknowns_by_z_from_previous_depth']}."
+            )
+            lines.append("")
+    return "\n".join(lines)
+

+            for z_degree, rows_for_band in jacobian_rows_by_band.items()
+        }
+
+    for offset in range(depth):
+        if offset > 0:
+            z_total = 54 - offset
+            coeff_g: Band = {}
+            for j1, g1 in gbands.items():
+                j2 = z_total - j1
+                if j2 in gbands:
+                    coeff_g = band_add(coeff_g, band_mul(g1, gbands[j2]))

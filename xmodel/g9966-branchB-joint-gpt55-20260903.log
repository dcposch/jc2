+        "rows": rows,
+    }
+
+
+def enumerate_g_unknowns(branch: Branch, depth: int) -> list[dict[str, Any]]:
+    terms: list[dict[str, Any]] = []
+    for offset in range(depth):
+        z_degree = 27 - offset

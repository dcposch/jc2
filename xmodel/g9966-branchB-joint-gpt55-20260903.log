+    lines.append("")
+    lines.append(report_table(d52, [4, 5, 6]))
+    lines.append("Charged replay build audit:")
+    lines.append("")
+    lines.append(build_audit_table(d52, [4, 5, 6]))
+    lines.append("")
+    lines.append(

+        "automorphisms": automorphism_controls(),
+    }
+    result = {
+        "type": "BOUNDED-HIGH-Z-JOINT / NECESSARY-SYSTEM",
+        "verdict": {
+            "branchB": "COUNTING-BOUND[BRANCH-B-HIGH-Z-DEPTH8-NONUNIT]",
+            "delta52": "COUNTING-BOUND[DELTA-5/2-HIGH-Z-DEPTH8-NONUNIT]",
+            "global": "OPEN[(99,66)-FULL-JOINT-NOT-DECIDED]",

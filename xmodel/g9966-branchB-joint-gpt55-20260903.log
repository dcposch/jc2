+    return {
+        "branch": branch.key,
+        "depth": depth,
+        "scope": "Prop. 6.2 high-z necessary Fbar/Gbar system",
+        "literal_Gbar_z_bands": [27 - i for i in range(depth)],
+        "literal_Fbar_z_bands": [18 - i for i in range(depth)],
+        "fixed_terms": fixed_terms,

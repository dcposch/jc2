+        )
+        fband_summaries.append(
+            {"z_degree": f_degree, "summary": expr_summary(fbands[f_degree], y)}
+        )
+
+    jacobian_rows: list[sp.Expr] = []
+    jacobian_band_counts: Counter[int] = Counter()
+    for offset in range(depth):

+def field_label(run: dict[str, Any]) -> str:
+    char = run.get("char")
+    if char == 0:
+        return "Q"
+    if char is None:
+        script = run.get("script", "")
+        match = re.search(r"_F([0-9]+)\.sing$", script)
+        return f"GF({match.group(1)})" if match else "?"
+    return f"GF({char})"
+

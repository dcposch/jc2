+    lines.append("")
+    for branch_key in ["branchB", "delta52"]:
+        branch = highz[branch_key]
+        lines.append(f"{branch['label']}:")
+        lines.append("")
+        for depth in [7, 8]:
+            system = branch["systems"][str(depth)]
+            lines.append(
+                f"- depth {depth}: new Gbar unknowns "
+                f"{system['new_unknown_count_from_previous_depth']} "

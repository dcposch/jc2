+    fbands: dict[int, Band] = {18: {48: sp.Integer(1)}}
+    approximate_root_rows: list[sp.Expr] = []
+    fband_summaries: list[dict[str, Any]] = [
+        {"z_degree": 18, "summary": band_summary(fbands[18])}
+    ]
+    for offset in range(1, depth):

+def run_singular(path: Path) -> dict[str, Any]:
+    log = LOGS / path.with_suffix(".log").name
+    started = time.perf_counter()
+    timed_out = False
+    returncode: int | None
+    try:
+        proc = subprocess.run(
+            ["Singular", "-q", "--no-rc", str(path)],
+            capture_output=True,
+            text=True,
+            timeout=SINGULAR_TIMEOUT,

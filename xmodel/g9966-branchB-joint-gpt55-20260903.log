+def band_substitute(band: Band, substitutions: dict[sp.Symbol, sp.Integer]) -> Band:
+    if not substitutions:
+        return band
+    return band_clean(
+        {
+            degree: coefficient.subs(substitutions, simultaneous=True)
+            for degree, coefficient in band.items()

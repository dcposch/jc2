+import subprocess
+import time
+from pathlib import Path
+from typing import Any
+
+import sympy as sp
+
+
+ROOT = Path("/home/ubuntu/jc2")
+OUT = ROOT / "box" / "g9966B-20260903"
+SYSTEMS = OUT / "systems"
+LOGS = OUT / "logs"
+REPORT = ROOT / "xmodel" / "g9966-branchB-joint-gpt55-20260903.md"
+RECEIPT = ROOT / "xmodel" / "g9966-branchB-joint-gpt55-20260903.run.v2"
+PRIMES = [32003, 32009, 32027]
+CHARS = PRIMES + [0]
+BRANCH_DEPTHS = {
+    "branchB": [4, 5, 6],
+    "delta52": [4, 5, 6, 7, 8],
+}
+MAX_WORKERS = 4
+SINGULAR_TIMEOUT = 900
+
+
+@dataclass(frozen=True)
+class Branch:
+    key: str
+    label: str
+    delta_text: str
+    e: int
+    p: int
+    ord_g_s: int
+    ord_f_s: int
+    H: sp.Expr
+    mu2: bool
+    charged_split_wrapper: bool

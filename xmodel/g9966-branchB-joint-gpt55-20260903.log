+
+def emit_singular(branch: Branch, system: dict[str, Any], char: int) -> Path:
+    field = "0" if char == 0 else str(char)
+    label = "Q" if char == 0 else f"F{char}"
+    gamma, split_c, T = sp.symbols("gamma split_c T")

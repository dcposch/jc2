+
+Band = dict[int, sp.Expr]
+
+
+def band_to_text(band: Band) -> str:
+    if not band:
+        return "0"
+    parts = []
+    for degree in sorted(band, reverse=True):
+        parts.append(f"{degree}:{band[degree]}")
+    return "; ".join(parts)
+

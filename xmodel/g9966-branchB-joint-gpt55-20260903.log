+            if system["verdict"] == "NONUNIT":
+                return depth, system
+        depth = max(int(k) for k in branch["systems"])
+        return depth, branch["systems"][str(depth)]
+
+    b_depth, b_system = deepest(b)
+    d_depth, d_system = deepest(d52)
+    lines: list[str] = []

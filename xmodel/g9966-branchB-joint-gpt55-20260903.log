+def build_highz(branch: Branch, depth: int) -> dict[str, Any]:
+    y = sp.symbols("y")
+    g_lead = leading_coefficients(branch, 9)
+    variables: list[sp.Symbol] = []
+    fixed_terms: list[dict[str, Any]] = []
+    unknown_terms: list[dict[str, Any]] = []

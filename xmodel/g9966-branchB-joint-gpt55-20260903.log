+
+def expr_summary(expr: sp.Expr, y: sp.Symbol) -> dict[str, Any]:
+    expanded = sp.expand(expr)
+    text = str(expanded)
+    try:
+        terms = len(sp.Poly(expanded, y).terms()) if expanded != 0 else 0
+    except Exception:
+        terms = None
+    return {
+        "terms": terms,
+        "sha256": sha256_text(text),
+        "preview": text[:500],
+    }

+    A, C = sp.symbols("A C")
+    f_lin = A * x + y
+    g_lin = C * x + y
+    Jlin = sp.expand(sp.diff(f_lin, x) * sp.diff(g_lin, y) - sp.diff(f_lin, y) * sp.diff(g_lin, x))
+    return {
+        "degree_ge_6_same_infinity": {
+            "typing": "EXACT degree>=6 triangular automorphism control",
+            "F": str(F),
+            "G": str(G),
+            "degrees": [

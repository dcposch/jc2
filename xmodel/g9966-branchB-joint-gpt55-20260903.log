+                {
+                    "name": f"g_{z_degree}_{y_degree}",
+                    "z_degree": z_degree,
+                    "y_degree": y_degree,
+                    "local_order": order,
+                }
+            )
+    return terms
+
+
+def build_delta52_charged(branch: Branch, depth: int) -> dict[str, Any]:
+    y = sp.symbols("y")

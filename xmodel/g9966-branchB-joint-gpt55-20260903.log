+RECEIPT = ROOT / "xmodel" / "g9966-branchB-joint-gpt55-20260903.run.v2"
+PRIMES = [32003, 32009, 32027]
+CHARS = PRIMES + [0]
+DEPTHS = [4, 5, 6, 7, 8]
+MAX_WORKERS = 4
+SINGULAR_TIMEOUT = 900

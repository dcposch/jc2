+def substitute_rows(rows: list[sp.Expr], substitutions: dict[sp.Symbol, sp.Integer]) -> list[sp.Expr]:
+    out: list[sp.Expr] = []
+    for row in rows:
+        expr = row.subs(substitutions, simultaneous=True)
+        if expr != 0:
+            out.append(expr)
+    return out

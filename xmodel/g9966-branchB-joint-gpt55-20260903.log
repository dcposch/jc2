+        "charged_input_verification": verification,
+        "branchB_face_check": branch_b_face_check(),
+        "high_z_systems": highz,
+        "next_band_estimates": estimates,
+        "extension_scope": extension_scope(highz, estimates),
+        "controls": controls,
+        "not_claimed": [

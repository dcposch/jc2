+def main() -> None:
+    if shutil.which("Singular") is None:
+        raise SystemExit("Singular is required")
+    OUT.mkdir(parents=True, exist_ok=True)
+    SYSTEMS.mkdir(parents=True, exist_ok=True)
+    LOGS.mkdir(parents=True, exist_ok=True)
+    pi = sp.symbols("pi")
+    branches = [

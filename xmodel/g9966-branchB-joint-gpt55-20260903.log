+def singular_expr(expr: sp.Expr) -> str:
+    numerator, denominator = sp.fraction(sp.together(sp.expand(expr)))
+    if denominator == 1:
+        text = str(sp.expand(numerator))
+    else:
+        text = f"({sp.expand(numerator)})/({sp.expand(denominator)})"
+    return text.replace("**", "^")

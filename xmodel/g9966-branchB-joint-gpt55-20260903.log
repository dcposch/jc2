+            variables.append(variable)
+            band_add_term(band, y_degree, variable)
+            unknown_terms.append(
+                {
+                    "name": str(variable),
+                    "z_degree": z_degree,
+                    "y_degree": y_degree,
+                    "local_order": order,
+                }
+            )

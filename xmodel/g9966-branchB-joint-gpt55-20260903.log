+        gbands = {
+            z_degree: band_substitute(band, new_subs)
+            for z_degree, band in gbands.items()
+        }
+        fbands = {
+            z_degree: band_substitute(band, new_subs)
+            for z_degree, band in fbands.items()
+        }
+        approximate_root_rows = substitute_rows(approximate_root_rows, new_subs)
+        jacobian_rows_by_band = {

+}} else {{
+  print(\"MAIN_NONUNIT\");
+  print(\"DIM=\"); dim(G);
+}}
+quit;
+"""
+    path = SYSTEMS / f"{branch.key}_depth{system['depth']}_{label}.sing"
+    path.write_text(script, encoding="utf-8")

+            )
+        gbands[z_degree] = band_clean(band)
+
+    forced_subs: dict[sp.Symbol, sp.Integer] = {}
+    for variable, term in zip(variables, unknown_terms, strict=True):
+        if (
+            term["z_degree"] == 27
+            and term["local_order"] > 0
+            or str(variable) in preset_zero_names

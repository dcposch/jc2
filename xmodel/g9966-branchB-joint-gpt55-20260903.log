+def leading_coefficients(branch: Branch, power: int) -> dict[int, sp.Expr]:
+    pi = sp.symbols("pi")
+    poly = sp.Poly(sp.expand(branch.H**power), pi)
+    coeffs: dict[int, sp.Expr] = {}
+    for (degree,), coeff in poly.terms():
+        coeffs[int(degree)] = sp.expand(coeff)
+    return coeffs
+

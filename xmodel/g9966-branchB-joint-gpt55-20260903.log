+    verification = verify_charged_inputs()
+    highz = run_highz(branches)
+    controls = {
+        "moh_64_48_appendixII": run_moh_1612_control(),
+        "automorphisms": automorphism_controls(),
+    }
+    result = {
+        "type": "BOUNDED-HIGH-Z-JOINT / NECESSARY-SYSTEM",
+        "verdict": {

+                continue
+            order = local_order_g(branch, y_degree, z_degree)
+            if not 0 <= order <= depth:
+                continue
+            if order == 0:
+                coefficient = g_lead.get(z_degree, sp.Integer(0))
+                if coefficient != 0:

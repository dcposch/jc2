+            "sympy": sp.__version__,
+            "singular": subprocess.run(["Singular", "--version"], capture_output=True, text=True).stdout.splitlines()[0],
+            "max_workers": MAX_WORKERS,
+            "singular_timeout_seconds": SINGULAR_TIMEOUT,
+        },

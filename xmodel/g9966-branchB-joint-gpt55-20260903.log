+    pointset_subs: dict[sp.Symbol, sp.Integer] = {}
+    pointset_linear_rows: list[sp.Symbol] = []
+    active_subs: dict[sp.Symbol, sp.Integer] = dict(forced_subs)
+    raw_source_count_before_pointset = 0

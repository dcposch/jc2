+            key="branchB",
+            label="Branch B delta=2",
+            delta_text="2",
+            e=1,
+            p=2,
+            ord_g_s=-18,
+            ord_f_s=-12,
+            H=pi**2 * (pi + 3),
+            mu2=False,
+            charged_split_wrapper=False,
+            face_note="Gauge a=1: H=pi^2(pi+3), R=pi^25(pi+3)^14(pi-2)",
+        ),

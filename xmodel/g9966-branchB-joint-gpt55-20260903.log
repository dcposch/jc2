+    lines.append(report_table(d52, [4, 5, 6, 7, 8]))
+    lines.append(
+        f"Deepest `delta=5/2` family dimension seen by Singular is `{d_system['dimensions_seen']}` "
+        f"at depth {d_depth}, again counting the Jacobian scalar."

   309	def through_block(Y, n7, p, Z):
   310	    """prod_{j<n7} (eta - C_{7j} ytilde), ytilde slot s = Y[32+s]; the
   311	    C_{7j} twist multiplies level lv by Z[(7 j lv) % 42]."""
   312	    blk = None
   313	    for j in range(n7):
   314	        fac = Jet(2, True)
   315	        fac.V[1][0] = 1
   316	        for lvl, (val, gc) in Y.items():
   317	            s = lvl - 32
   318	            if lvl < 32 or s >= _S:
   319	                continue
   320	            tw = Z[(7 * j * lvl) % 42]
   321	            fac.V[0][s] = (-tw * val) % p
   322	            if gc is not None:
   323	                fac.G[0][s][gc] = (-tw) % p
   324	        blk = fac if blk is None else jmul(blk, fac, p)
   325	    return blk
   326	
   327	def other_block(Y, k, n7, p, Z):
   328	    """Suborbit-Newton block for direction k != 0 (gm_jet2): Delta =
   329	    P - C_k Y rel level 12; q_r = n7 [6|s] (Delta^r)_s; e_j Newton;
   330	    block = sum_i e_{n7-i} (eta t^20)^i."""
   331	    dv = np.zeros(_S)
   332	    dg = np.zeros((_S, GD))
   333	    for lvl, (val, gc) in Y.items():
   334	        s = lvl - 12
   335	        if s >= _S:
   336	            continue
   337	        tw = Z[(k * lvl) % 42]
   338	        contrib = (-tw * val) % p
   339	        if lvl in (12, 18, 24, 30):                    # P - C_k Y overlap
   340	            pv = {12: 1, 18: Y[18][0], 24: Y[24][0], 30: Y[30][0]}[lvl]
   341	            contrib = (pv - tw * val) % p
   342	        dv[s] = contrib
   343	        if gc is not None:
   344	            dg[s][gc] = (-tw) % p
   345	    D = (dv, dg)
   346	    Dp = {1: D}
   347	    for r in range(2, n7 + 1):
   348	        Dp[r] = smul(Dp[r - 1], D, p)
   349	    msk = (np.arange(_S) % 6 == 0).astype(np.float64)
   350	    q = {}
   351	    for r in range(1, n7 + 1):
   352	        vr, gr = Dp[r]
   353	        q[r] = (np.mod(vr * msk * n7, p),
   354	                np.mod(gr * msk[:, None] * n7, p))
   355	    e = [(np.zeros(_S), np.zeros((_S, GD)))]
   356	    e[0][0][0] = 1
   357	    for j in range(1, n7 + 1):
   358	        acc = (np.zeros(_S), np.zeros((_S, GD)))
   359	        for r in range(1, j + 1):
   360	            term = smul(e[j - r], q[r], p)
   361	            acc = sadd(acc, sscal(term, (-1) ** (r - 1) % p, p), p)
   362	        e.append(sscal(acc, pow(j, p - 2, p), p))
   363	    blk = Jet(n7 + 1, True)
   364	    for i in range(n7 + 1):
   365	        if 20 * i >= _S and i > 0:
   366	            break
   367	        v, g = e[n7 - i]
   368	        blk.V[i][20 * i:] = v[:_S - 20 * i]
   369	        blk.G[i][20 * i:] = g[:_S - 20 * i]
   370	    return blk
   371	
   372	def aside_orbit_jet(point, fam, p, Z):
   373	    n7 = 3 if fam.startswith("tg0") else 6
   374	    Y = orbit_levels(point, fam, p)
   375	    jp = through_block(Y, n7, p, Z)
   376	    for k in range(1, 7):
   377	        jp = jmul(jp, other_block(Y, k, n7, p, Z), p)
   378	    return jp

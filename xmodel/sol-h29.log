   380	def b_block(point, power, p):
   381	    """Frozen B-orbit closed form: Q = (Phat + eta t^20)^7 - B, B = 3/2;
   382	    the C42 orbit of eta_B t^12 degenerates to ((...)^7 - B)^6 (f-side,
   383	    B + GB42 give ^6 each... f uses ^6; g-side GB42*GB21 = ^9).  V-only."""
   384	    fx = point["fixed"]
   385	    R = Jet(2, False)
   386	    R.V[0][0] = 1
   387	    R.V[0][6] = fx["uf18"]
   388	    R.V[0][12] = fx["uf24"]
   389	    R.V[0][18] = fx["uf30"]
   390	    R.V[1][20] = 1
   391	    R2 = jmul(R, R, p)                                  # R^7 = R^4 * R^2 * R
   392	    R4 = jmul(R2, R2, p)
   393	    Q = jmul(jmul(R4, R2, p), R, p)
   394	    Q.V[0][0] = (Q.V[0][0] - 3 * pow(2, p - 2, p)) % p
   395	    out = None
   396	    for _ in range(power):
   397	        out = Q if out is None else jmul(out, Q, p)
   398	    return out

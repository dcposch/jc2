   274	            for j in range((RMAX - S30[a]) // 6 + 1)]
   275	    row_lv = np.array([S30[a] + 6 * j for a, j in rows])
   276	    ncol = len(V2.GIDX)
   277	    col_lv = np.zeros(ncol, dtype=np.int64)
   278	    for (f, r), i in V2.GIDX.items():
   279	        col_lv[i] = r
   280	    M = np.zeros((len(rows), ncol), dtype=np.int64)
   281	    for ri, (a, j) in enumerate(rows):
   282	        M[ri, :] = Gg[a][S30[a] + 6 * j][:]
   283	    return rows, row_lv, col_lv, M

   257	def reduce_expr(task):
   258	    name, cells = task
   259	    p, r3v = G["p"], G["r3"]
   260	    t0 = time.time()
   261	    fname = "red_p%d_%s.pkl" % (p, name.replace("*", "."))
   262	    path = os.path.join(G["ckdir"], fname)
   263	    if os.path.exists(path):
   264	        return (name, "skip", 0, 0, 0, 0.0)
   265	    fibers = {}
   266	    tin = tnf = tst = 0
   267	    for lab in sorted(G["gbs"]):
   268	        gb = G["gbs"][lab]
   269	        fv = G["fvals"][lab]
   270	        A1, A2 = fv["A1"], fv["A2"]
   271	        hw1, hw2 = fv["HW1_over_W1"], fv["HW2_over_W2"]
   272	        out = {}
   273	        for (k, n), items in sorted(cells.items()):
   274	            poly = {}
   275	            for s, e1, e2, h1, h2, c0m, c1m in items:
   276	                c = (c0m + c1m * r3v) % p
   277	                c = c * pow(A1, e1, p) % p * pow(A2, e2, p) % p
   278	                c = c * pow(hw1, h1, p) % p * pow(hw2, h2, p) % p
   279	                if c:
   280	                    nc = (poly.get(s, 0) + c) % p
   281	                    if nc: poly[s] = nc
   282	                    else: poly.pop(s, None)
   283	            nf, trace, steps = nf_trace(poly, gb, p)
   284	            out[(k, n)] = {
   285	                "nf": {unpack(s): c for s, c in nf.items()},
   286	                "in_terms": len(poly), "steps": steps,
   287	                "trace_z": zlib.compress(pickle.dumps(
   288	                    trace, protocol=4), 6)}
   289	            tin += len(poly); tnf += len(nf); tst += steps
   290	        fibers[lab] = out
   291	    payload = dict(prime=p, name=name,
   292	                   alpha=tuple(name.split("*")) if name != "const" else (),
   293	                   gbvars=GBVARS, r3=r3v, fiber_vals=G["fvals"],
   294	                   fibers=fibers, elapsed=time.time() - t0,
   295	                   host=socket.gethostname(),
   296	                   ts=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
   297	    tmp = path + ".tmp.%d" % os.getpid()
   298	    with open(tmp, "wb") as fh:
   299	        pickle.dump(payload, fh, protocol=4)
   300	    os.replace(tmp, path)

    88	FRONTIER = ("tf1_51", "tf1_56", "tf2_51", "tf2_56", "tg1_51", "tg1_56",
    89	            "tg2_51", "tg2_56", "tg01_56", "tg02_56")
    90	
    91	def pack(exps):
    92	    s = 0
    93	    for i, e in enumerate(exps):
    94	        if e: s |= e << (SH * i)
    95	    return s
    96	
    97	def unpack(s):
    98	    return tuple((s >> (SH * i)) & 0xFF for i in range(NV))
    99	
   100	def degof(s):
   101	    d = 0
   102	    while s:
   103	        d += s & 0xFF
   104	        s >>= SH
   105	    return d
   106	
   107	def gkey(s, deg):
   108	    return (deg << DEGSH) + (FULL - s)
   109	
   110	def from_gkey(K):
   111	    return FULL - (K & M176), K >> DEGSH
   112	
   113	# ------------------------------------------------------------ GB parse
   114	def parse_msolve_gb(path, p):
   115	    """msolve -g 2 GB .out -> (gvars, [(lt_s, lt_deg, tail=[(s,deg,c)..])]).
   116	    Gates: characteristic, variable order, 509 elements, monic, and
   117	    first-printed term == unique grevlex max (order pin, every element)."""
   118	    txt = open(path).read()
   119	    lines = txt.split("\n")
   120	    ch = next(l for l in lines if l.startswith("#field characteristic"))
   121	    assert int(ch.split(":")[1]) == p, (path, ch)
   122	    vo = next(l for l in lines if l.startswith("#variable order"))
   123	    gvars = [v.strip() for v in vo.split(":")[1].split(",")]
   124	    assert gvars == GBVARS, (path, gvars)
   125	    body = txt.split("#---")[-1].strip()
   126	    assert body.startswith("[") and body.rstrip(":").endswith("]"), path
   127	    body = body.lstrip("[").rstrip(":").rstrip("]")
   128	    vi = {v: i for i, v in enumerate(gvars)}
   129	    gb = []
   130	    for spoly in body.split(",\n"):
   131	        terms = []
   132	        for t in spoly.strip().split("+"):
   133	            fs = t.split("*")
   134	            c = int(fs[0]) % p
   135	            e = [0] * NV
   136	            for f in fs[1:]:
   137	                if "^" in f:
   138	                    nm, ex = f.split("^")
   139	                    e[vi[nm]] += int(ex)
   140	                else:
   141	                    e[vi[f]] += 1
   142	            terms.append((pack(e), sum(e), c))
   143	        lt_s, lt_deg, lt_c = terms[0]
   144	        assert lt_c == 1, ("non-monic", path, spoly[:60])
   145	        ltk = gkey(lt_s, lt_deg)
   146	        assert all(gkey(s, d) < ltk for s, d, _ in terms[1:]), \
   147	            ("order pin failed", path, spoly[:60])
   148	        gb.append((lt_s, lt_deg, terms[1:]))
   149	    assert len(gb) == 509, (path, len(gb))
   150	    return gb
   151	
   152	# ----------------------------------------------------------- reduction
   153	def nf_trace(poly, gb, p):
   154	    """Full normal form of poly (dict packed_s -> coeff) against the
   155	    monic grevlex GB.  Returns (nf_dict, trace {gk_idx: {q_s: coeff}},
   156	    steps).  Identity: poly == nf + sum_k trace[k]*gb[k]  in F_p[x]."""
   157	    H = dict(poly)
   158	    heap = [-gkey(s, degof(s)) for s in H]
   159	    heapq.heapify(heap)
   160	    out, trace, steps = {}, {}, 0
   161	    nlt = len(gb)
   162	    while heap:
   163	        K = -heapq.heappop(heap)
   164	        s, deg = from_gkey(K)
   165	        c = H.get(s)
   166	        if not c:
   167	            continue
   168	        gi = -1
   169	        X = s | GUARD
   170	        for j in range(nlt):
   171	            lt_s, lt_deg, _ = gb[j]
   172	            if lt_deg <= deg and ((X - lt_s) & GUARD) == GUARD:
   173	                gi = j
   174	                break
   175	        if gi < 0:
   176	            out[s] = c
   177	            del H[s]
   178	            continue
   179	        lt_s, lt_deg, tail = gb[gi]
   180	        q = s - lt_s
   181	        qdeg = deg - lt_deg
   182	        tr = trace.setdefault(gi, {})
   183	        tr[q] = (tr.get(q, 0) + c) % p
   184	        del H[s]
   185	        for ts, tdeg, tc in tail:
   186	            m = q + ts
   187	            nc = (H.get(m, 0) - c * tc) % p
   188	            if nc:
   189	                if m not in H:
   190	                    heapq.heappush(heap, -gkey(m, qdeg + tdeg))
   191	                H[m] = nc
   192	            else:
   193	                H.pop(m, None)
   194	        steps += 1
   195	    assert not H
   196	    return out, trace, steps
   197	
   198	# ------------------------------------------------------- bank -> exprs
   199	def load_exprs(pkl_path, p):
   200	    """Jets bank -> {name: {(k,n): [(s_item, e1,e2,h1,h2, c0m,c1m)..]}}.
   201	    Spec-2.3-adjacent gates on the bank are asserted here."""
   202	    sys.path.insert(0, os.path.dirname(os.path.abspath(pkl_path)))
   203	    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
   204	    with open(pkl_path, "rb") as fh:
   205	        d = pickle.load(fh)
   206	    assert d["D"] == 25
   207	    vars_, byk = d["vars"], d["byk"]
   208	    assert all(k % 2 == 0 for k in byk), "odd row present (Row 23 != 0?)"
   209	    assert sorted(byk[24]) == [2, 5, 8, 11, 14, 17, 20, 23, 26], \
   210	        "Row 24 eta support mismatch (spec 2.3)"
   211	    assert sorted(byk[22]) == [1, 4, 7, 10, 13, 16, 19, 22, 25, 28]
   212	    exprs = {}
   213	    deepseen = set()
   214	    for k in (22, 24):
   215	        for n, vex in byk[k].items():
   216	            for key, r in vex.items():
   217	                epos = [0] * NV
   218	                deep = []
   219	                for i in key:
   220	                    nm = vars_[i]
   221	                    if nm in BASE18:
   222	                        epos[TAIL2POS[nm]] += 1
   223	                    else:
   224	                        deep.append(nm)
   225	                deep = tuple(sorted(deep))
   226	                deepseen.update(deep)
   227	                name = "*".join(deep) if deep else "const"
   228	                items = exprs.setdefault(name, {}).setdefault((k, n), [])
   229	                for (za, e1, e2, pw, h1, qw, h2, eB), c in r.items():
   230	                    assert za == 0 and eB == 0, "unexpected z/EB content"
   231	                    e = list(epos)
   232	                    e[IW1] += pw + h1
   233	                    e[IW2] += qw + h2
   234	                    c0, c1 = Fraction(c[0]), Fraction(c[1])
   235	                    c0m = c0.numerator % p * pow(c0.denominator % p,
   236	                                                 p - 2, p) % p
   237	                    c1m = c1.numerator % p * pow(c1.denominator % p,
   238	                                                 p - 2, p) % p
   239	                    items.append((pack(e), e1, e2, h1, h2, c0m, c1m))
   240	    for nm in FRONTIER:                       # spec 2.3 frontier census
   241	        assert nm in deepseen, "frontier var %s absent from deep set" % nm
   242	    return exprs

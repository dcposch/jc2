   822	def weighted_pivot_checksum(M, rlv, clv, p):
   823	    """Greedy global-t filtered elimination: repeatedly pivot on the
   824	    entry minimizing (row level - col level), levels ascending; returns
   825	    (sum of losses, #pivots).  Recorded diagnostic only."""
   826	    M = np.mod(M.astype(np.int64), p)
   827	    R, C = M.shape
   828	    usedr = np.zeros(R, dtype=bool)
   829	    usedc = np.zeros(C, dtype=bool)
   830	    order = sorted(((rlv[i] - clv[j], rlv[i], i, j)
   831	                    for i in range(R) for j in range(C)
   832	                    if rlv[i] >= clv[j]))
   833	    loss = npiv = 0
   834	    for lo, _, i, j in order:
   835	        if usedr[i] or usedc[j] or not M[i][j]:
   836	            continue
   837	        usedr[i] = usedc[j] = True
   838	        loss += lo
   839	        npiv += 1
   840	        inv = pow(int(M[i][j]), p - 2, p)
   841	        row = M[i] * inv % p
   842	        nz = np.nonzero(M[:, j])[0]
   843	        nz = nz[~usedr[nz]]
   844	        if len(nz):
   845	            M[nz] = (M[nz] - np.outer(M[nz, j], row)) % p
   846	    return loss, npiv

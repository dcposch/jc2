   245	G = {}
   246	
   247	def _init(gbs, fvals, r3v, p, ckdir, logpath):
   248	    G.update(gbs=gbs, fvals=fvals, r3=r3v, p=p, ckdir=ckdir, log=logpath)
   249	
   250	def _logline(msg):
   251	    fd = os.open(G["log"], os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
   252	    try:
   253	        os.write(fd, (msg + "\n").encode())
   254	    finally:
   255	        os.close(fd)

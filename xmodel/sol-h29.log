   404	              aside_orbit_jet(point, "tf2", p, Z), p)
   405	    jf = jmul(jf, b_block(point, 6, p), p)
   406	    jg = jmul(aside_orbit_jet(point, "tg1", p, Z),
   407	              aside_orbit_jet(point, "tg2", p, Z), p)
   408	    jg = jmul(jg, jmul(aside_orbit_jet(point, "tg01", p, Z),
   409	                       aside_orbit_jet(point, "tg02", p, Z), p), p)
   410	    jg = jmul(jg, b_block(point, 9, p), p)
   411	    return jf, jg

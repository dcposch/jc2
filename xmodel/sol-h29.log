   665	class Colspace(object):
   666	    """Incremental reduced column-echelon basis mod p with unit-vector
   667	    membership via one matmul (for the filtered coverage test)."""
   668	    def __init__(self, R, p):
   669	        self.R = R
   670	        self.p = p
   671	        self.basis = []          # list of (pivot_row, vector)
   672	        self.pivots = []
   673	    def add(self, v):
   674	        p = self.p
   675	        v = v % p
   676	        for pr, b in self.basis:
   677	            c = v[pr]
   678	            if c:
   679	                v = (v - c * b) % p
   680	        nzr = np.nonzero(v)[0]
   681	        if not len(nzr):
   682	            return False
   683	        pr = int(nzr[0])
   684	        v = v * pow(int(v[pr]), p - 2, p) % p
   685	        for i, (pr2, b2) in enumerate(self.basis):
   686	            c = b2[pr]
   687	            if c:
   688	                self.basis[i] = (pr2, (b2 - c * v) % p)
   689	        self.basis.append((pr, v))
   690	        self.pivots.append(pr)
   691	        return True
   692	    def covered_rows(self):
   693	        """Boolean per row o: e_o in the column space."""
   694	        p = self.p
   695	        if not self.basis:
   696	            return np.zeros(self.R, dtype=bool)
   697	        B = np.stack([b for _, b in self.basis], axis=1)     # (R, k)
   698	        piv = np.array([pr for pr, _ in self.basis])
   699	        Res = np.eye(self.R, dtype=np.int64)
   700	        Res = (Res - B.astype(np.int64) @ Res[piv, :]) % p
   701	        return ~Res.any(axis=0)

   285	def delayed_loss_scan(row_lv, col_lv, M, p):
   286	    """Certified lower bound on ell(L) per (2.1) with the LITERAL n >= 0
   287	    convention: for every n, the window part of L(F^nX) is spanned by the
   288	    columns of level >= n (causality); an in-window unit target of level
   289	    b >= n outside that span certifies ell > b - n, i.e. ell >= b - n + 1.
   290	    Scan evaluates every constant-coverage interval at its LOWER endpoint
   291	    (incl. n = 0), so the bound is the sharpest the window supports."""
   292	    levels = sorted({int(v) for v in col_lv}, reverse=True)
   293	    order = np.argsort(-col_lv, kind="stable")
   294	    cs = V2.Colspace(len(row_lv), p)
   295	    oi = 0
   296	    ell_lb = 0
   297	    profile = []
   298	    for k, v in enumerate(levels):
   299	        while oi < len(order) and col_lv[order[oi]] >= v:
   300	            cs.add(M[:, order[oi]].copy())
   301	            oi += 1
   302	        n_eval = (levels[k + 1] + 1) if k + 1 < len(levels) else 0
   303	        cov = cs.covered_rows()
   304	        bad = row_lv[(~cov) & (row_lv >= n_eval)]
   305	        bound = (int(bad.max()) - n_eval + 1) if len(bad) else 0
   306	        profile.append([int(n_eval), int(v), int((~cov).sum()),
   307	                        (int(bad.max()) if len(bad) else None),
   308	                        max(0, bound)])
   309	        ell_lb = max(ell_lb, bound)
   310	    return int(ell_lb), len(cs.basis), profile

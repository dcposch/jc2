   160	class Jet(object):
   161	    """Truncated eta-jet with dual (gradient) part.  V: (H, S) float64
   162	    holding exact ints in [0, p); G: (H, S, GD) or None."""
   163	    __slots__ = ("V", "G", "h")
   164	    def __init__(self, h, grad):
   165	        self.h = h
   166	        self.V = np.zeros((h, _S))
   167	        self.G = np.zeros((h, _S, GD)) if grad else None

   430	def euler_rows(jf, jg, p):
   431	    """E = (theta Phi - 12 Phi) Gamma_eta - Phi_eta (theta Gamma - 18
   432	    Gamma) + 42 t^20  (gauge c_f c_g = 1; directionb_strike.jrows)."""
   433	    jA = theta_shift(jf, 12, p)
   434	    jBg = theta_shift(jg, 18, p)
   435	    jfH = eta_deriv(jf, p)
   436	    jgH = eta_deriv(jg, p)
   437	    T1 = jmul(jA, jgH, p)
   438	    T2 = jmul(jfH, jBg, p)
   439	    E = Jet(HMAX, True)
   440	    h1 = min(T1.h, HMAX)
   441	    E.V[:h1] += T1.V[:h1]
   442	    E.G[:h1] += T1.G[:h1]
   443	    h2 = min(T2.h, HMAX)
   444	    E.V[:h2] -= T2.V[:h2]
   445	    E.G[:h2] -= T2.G[:h2]
   446	    E.V %= p
   447	    E.G %= p
   448	    E.V[0][20] = (E.V[0][20] + 42) % p
   449	    return E

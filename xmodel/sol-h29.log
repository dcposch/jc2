   169	def jmul(A, B, p, hcap=HMAX):
   170	    """Exact truncated product of dual jets (mod p).  float64 is exact:
   171	    products < p^2 ~ 1.1e10, accumulation < 34*42*p^2 < 2^53."""
   172	    h = min(hcap, A.h + B.h - 1)
   173	    C = Jet(h, A.G is not None or B.G is not None)
   174	    BVt = B.V.T                       # (S, HB)
   175	    BG2 = None
   176	    if B.G is not None:
   177	        BG2 = B.G.transpose(1, 0, 2).reshape(_S, -1)   # (S, HB*GD)
   178	    for ha in range(A.h):
   179	        if not A.V[ha].any():
   180	            continue
   181	        hb_lim = min(B.h, h - ha)
   182	        if hb_lim <= 0:
   183	            continue
   184	        TA = toep(A.V[ha])
   185	        C.V[ha:ha + hb_lim] += (TA @ BVt[:, :hb_lim]).T
   186	        if BG2 is not None:
   187	            R = (TA @ BG2[:, :hb_lim * GD]).reshape(_S, hb_lim, GD)
   188	            C.G[ha:ha + hb_lim] += R.transpose(1, 0, 2)
   189	    if A.G is not None:
   190	        for hb in range(B.h):
   191	            if not B.V[hb].any():
   192	                continue
   193	            ha_lim = min(A.h, h - hb)
   194	            if ha_lim <= 0:
   195	                continue
   196	            TB = toep(B.V[hb])
   197	            AG2 = A.G[:ha_lim].transpose(1, 0, 2).reshape(_S, -1)
   198	            R = (TB @ AG2).reshape(_S, ha_lim, GD)
   199	            C.G[hb:hb + ha_lim] += R.transpose(1, 0, 2)
   200	    C.V %= p
   201	    if C.G is not None:
   202	        C.G %= p
   203	    return C

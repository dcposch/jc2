   248	   c_C = Z·C = (Phi_*C)·L_infty =
   249	        0                                    C contracted (to a point of L_infty
   250	                                             OR of A^2 -- both occur),
   251	        k_C := deg(Phi|_C) >= 1              Phi(C) = L_infty,
   252	        lambda_l := s_l · n_{c(l)}           C = l dicritical, m_l = 0.

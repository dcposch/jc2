/bin/bash -lc "python3 - <<'PY'
import sys
from collections import Counter
from pathlib import Path
HERE=Path('box/anchor-gate-20260903').resolve()
sys.path.insert(0,str(HERE))
import moh_skeleton_full as M
import full_tree_partition as T

def u_s_of(S): return S.d[S.s]-S.V[S.s]
def descend(S):
    ds=S.d[S.s]; us=u_s_of(S); s2=S.s-1
    D={'n':S.n//ds,'m':S.m//ds,'s':s2,'M':{i:S.M[i]//ds for i in range(1,s2+1)},'d':{i:S.d[i]//ds for i in range(1,s2+2)},'V':{i:S.V[i] for i in range(2,s2+1)},'k':S.V[S.s]-us-1}
    D['V'][s2+1]=D['d'][s2+1]
    return D
def trunc(D):
    n,s,M,V=D['n'],D['s'],dict(D['M']),dict(D['V'])
    d=D['d']; dropped=0
    while s>=1 and M.get(s)==n-1:
        dropped+=1; s-=1; M.pop(s+1,None); V.pop(s+1,None)
        if (s+1) in d and s>=1: V[s+1]=d[s+1]
    return s,dropped,M,V
for label, rows in [('n<=100',[M.Skel(n,m,list(Ms),V) for n in range(4,101) for m,Ms,V in M.census(n,Kmin=2,full=True)]),('n=108',[M.Skel(108,m,list(Ms),V) for m,Ms,V in M.census(108,Kmin=2,full=True)])]:
    surv=[S for S in rows if T.full_tree_ode_ok(S)]
    desc=[S for S in surv if u_s_of(S)==1]
    c=Counter(); drops=Counter(); raw=Counter(); rawdrops=[]
    for S in desc:
        D=descend(S); s_eff,dropped,M2,V2=trunc(D)
        c[s_eff]+=1; drops[dropped]+=1; raw[D['s']]+=1
        rawdrops.append((D['s'],s_eff,dropped,S.n,S.m,[S.M[i] for i in range(1,S.s+1)],{i:S.V[i] for i in range(2,S.s+1)}))
    print(label, 'surv',len(surv),'desc',len(desc),'s_eff',dict(sorted(c.items())),'dropped',dict(sorted(drops.items())),'raw_s_prime',dict(sorted(raw.items())))
PY" in /home/ubuntu/jc2

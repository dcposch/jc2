/bin/bash -lc "python3 - <<'PY'
import sys
sys.path.insert(0,'box/mohprog-drivers-20260903/repro')
import moh_skeleton_full as M
rows=[]
for n in range(4,101):
 for m,Ms,V in M.census(n,Kmin=2,full=True): rows.append(M.Skel(n,m,list(Ms),V))
def c10(S,j): return S.V[j] <= S.div9(j)[0]
def stat(desc,pred):
 rr=[s for s in rows if pred(s)]
 print(desc,len(rr),len(set((x.n,x.m) for x in rr)),len(set((x.n,x.m,tuple(x.M[i] for i in range(2,x.s+1)),x.V[x.s]) for x in rr)))
stat('s3',lambda S:S.s==3)
stat('s3 all10',lambda S:S.s==3 and all(c10(S,j) for j in range(2,S.s)))
stat('all10',lambda S:all(c10(S,j) for j in range(2,S.s)))
PY" in /home/ubuntu/jc2

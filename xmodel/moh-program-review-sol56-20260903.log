    if sm+v<=rem:new.add((sm+v,c+1))
  reachable=new
 return any(sm==rem for sm,c in reachable)

def feasible_row(S):
 if S.s"'!=3:return None
 j=2;tri,sq,A,P=S.div9(j);Q=S.V[3]*(S.n-S.M[2])//S.d[3]
 zq=Q%A
 if zq not in (0,1):return False
 cap=(Q-zq)//A
 lo=F(S.d[2],S.n-S.M[2])
 # selected has to be a nonzero root branch, hence (10), and bottom
 sel=S.V[2]
 if not (sel<=tri and sel>lo and S.cond1213()[0]):return False
 # enumerate possible b; major zero forbidden
 for b in range(sq,P+1,A):
  if b and F(b)>lo: continue
  if b and zq!=1: continue
  total=(P-b)//A
  # permissible nonzero per orbit: minor anything <=lo, or major must bottom
  vals=[]
  for v in range(1,total+1):
   if F(v)<=lo:vals.append(v)
   else:
    T=M.Skel(S.n,S.m,[S.M[2],S.M[3]],{2:v,3:S.V[3]})
    if T.windows_ok() and T.cond1213()[0]:vals.append(v)
  if can_sum(total,vals,cap,sel):return True
 return False
rows=[];b3=0
for n in range(2,101):
 for m,Ms,V in M.census(n,Kmin=2,full=True):
  S=M.Skel(n,m,list(Ms),V)
  if S.s==3:
   b3+=1
   if feasible_row(S): rows.append((n,m,Ms,V))
print('"'s3 base',b3,'survive',len(rows),'groups',len(set((n,m,Ms,V[3]) for n,m,Ms,V in rows)),'classes',len(set((x[0],x[1]) for x in rows)))
for x in rows:print(x)

import json, math
from pathlib import Path
for fn in ['full-tree-polynomial-ode-printed-witnesses.json','full-tree-polynomial-ode-excess-witnesses.json']:
 d=json.load(open(Path('box/mohprog-drivers-20260903')/fn)); print('\\n',fn)
 for key,w in d.items():
  vals=[]
  def rec(x):
   if not isinstance(x,dict):return
   if 'j' in x:
    P,Q,A,b=x['P'],x['Q'],x['A'],x['zero_multiplicity']; coins=x['nonzero_orbit_multiplicities']; S=(Q-1)//A
    mult=[b]+coins+[0]*(S-len(coins)); weights=[(P-Q*b)//A]+[P-Q*v for v in mult[1:]]
    g=0
    for z in weights:g=math.gcd(g,abs(z))
    dp=sum(z for z in weights if z>0)
    vals.append((x['j'],S,weights,g,dp//g if g else None,dp//g>=S if g else False))
   for z in ['selected_child','zero_child']:
    rec(x.get(z))
   for z in (x.get('major_nonzero_children') or {}).values():rec(z)
  rec(w); print(key,vals)

/bin/bash -lc "python3 - <<'PY'
import sys
from fractions import Fraction as F
from math import gcd,lcm
from functools import lru_cache
sys.path.insert(0,'/tmp/jc2-lane.YI70hY/inputs');import moh_skeleton_full as Base

class Tree:
 def __init__(self,n,m,Ms,Vtop,rowV=None):
  self.n=n;self.m=m;self.full=[-m]+list(Ms);self.s=len(self.full);self.M={i+1:x for i,x in enumerate(self.full)}
  dl=[n]
  for x in self.full:dl.append(gcd(dl[-1],x))
  self.d={i+1:dl[i] for i in range(len(dl))};self.Vtop=Vtop;self.rowV=rowV or {}
 def delta(self,j,V):
  num=F(self.n-self.M[j]);den=F(self.n-self.M[self.s]-1)
  for k in range(j+1,self.s+1):
   num*=V[k]*(self.n-self.M[k])-self.d[k]
   den*=V[k]*(self.n-self.M[k-1])-self.d[k]
  return 1-num/den
 def A(self,j,V):
  L=1
  for k in range(j+1,self.s+1):L=lcm(L,self.delta(k,V).denominator)
  return (L*self.delta(j,V)).denominator
 def bottom(self,V):
  S=Base.Skel(self.n,self.m,self.full[1:],V)
  return S.cond1213()[0]
 def removable(self,delta):return delta.denominator==1 and delta<=0
 def keyV(self,j,V):return tuple(V[k] for k in range(j+1,self.s+1))
 def makeV(self,j,key):
  V={};
  for off,k in enumerate(range(j+1,self.s+1)):V[k]=key[off]
  return V
 @lru_cache(None)
 def node(self,j,key,danger):
  V=self.makeV(j,key); dj=self.delta(j,V);A=self.A(j,V);P=V[j+1]*self.d[j]//self.d[j+1];lo=F(self.d[j],self.n-self.M[j])
  for b in range(P%A and P%A or 0,P+1,A):
   # start formula fails sq=0 okay starts0; above expression gives0
   if b>0 and F(b)>lo:
    if not self.branch(j,V,b,True,danger,dj,False):continue
    zmajor=True
   else:zmajor=False
   S=(P-b)//A
   allowed=[]
   for v in range(1,S+1):
    maj=F(v)>lo
    if not maj or self.branch(j,V,v,False,danger,dj,False):allowed.append((v,maj))
   reach={(0,zmajor)}
   for sm in range(S+1):
    changed=True
    while changed:
     changed=False
     for ss,hm in list(reach):
      for v,maj in allowed:
       if ss+v<=S and (ss+v,hm or maj) not in reach:
        reach.add((ss+v,hm or maj));changed=True
   if (S,True) in reach:return True
  return False
 def branch(self,j,V,v,iszero,danger,dj,selected):
  danger2=danger and (iszero or self.removable(dj))
  V2=dict(V);V2[j]=v
  if j==2:return self.bottom(V2) and not danger2
  if selected:return self.node_sel(j-1,self.keyV(j-1,V2),danger2)
  return self.node(j-1,self.keyV(j-1,V2),danger2)
 @lru_cache(None)
 def node_sel(self,j,key,danger):
  V=self.makeV(j,key);dj=self.delta(j,V);A=self.A(j,V);P=V[j+1]*self.d[j]//self.d[j+1];lo=F(self.d[j],self.n-self.M[j]);want=self.rowV[j]
  sq=P%A
  for b in range(sq,P+1,A):
   # validate zero global unless selected zero will use selected branch
   zmaj=b>0 and F(b)>lo
   # case selected zero
   if b==want and zmaj and self.branch(j,V,b,True,danger,dj,True):
    S=(P-b)//A
    if self.coins_ok(j,V,danger,dj,lo,S,False,None):return True
   # case selected nonzero (zero if major must globally work)
   if zmaj and not self.branch(j,V,b,True,danger,dj,False):continue
   S=(P-b)//A
   if want<=S and F(want)>lo and self.branch(j,V,want,False,danger,dj,True):
    if self.coins_ok(j,V,danger,dj,lo,S-want,zmaj,want):return True
  return False
 def coins_ok(self,j,V,danger,dj,lo,total,have_major,selected_removed):
  allowed=[]
  for v in range(1,total+1):
   maj=F(v)>lo
   if not maj or self.branch(j,V,v,False,danger,dj,False):allowed.append((v,maj))
  reach={(0,have_major)}
  changed=True
  while changed:
   changed=False
   for ss,hm in list(reach):
    for v,maj in allowed:
     if ss+v<=total and (ss+v,hm or maj) not in reach:
      reach.add((ss+v,hm or maj));changed=True
  # selected factor itself is major if removed
  return any(ss==total and (hm or selected_removed is not None) for ss,hm in reach)
 def selected_ok(self):
  key=(self.Vtop,)
  return self.node_sel(self.s-1,key,True)

rows=[];base=0
for n in range(2,101):
 for m,Ms,V in Base.census(n,Kmin=2,full=True):
  base+=1;s=len(Ms)+1
  T=Tree(n,m,Ms,V[s],V)
  if T.selected_ok():rows.append((n,m,Ms,V))
print('base',base,'survive',len(rows),'groups',len(set((n,m,Ms,V[len(Ms)+1]) for n,m,Ms,V in rows)),'classes',len(set((n,m) for n,m,Ms,V in rows)))
for x in rows:print(x)

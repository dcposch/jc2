+    out = (r.stdout or "") + (r.stderr or "")
+    ans = parse_unsat(out)
+    ans.update({"elapsed_s": round(time.time() - t0, 3), "returncode": r.returncode, "stdout_tail": out[-2000:]})
+    return ans
+
+
+def count_only_records() -> list[dict]:
+    return [
+        {

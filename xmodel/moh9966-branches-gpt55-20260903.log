  u' = 2:  y^{V_2}(y^2 − x^2)                     # (15,10) V2=3; p.210 three subdiscs
  u' ≥ 3:  y^{V_2}(y − x)^{u'}                    # (15,10) V2=2: y^2(y−x)^3


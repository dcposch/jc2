+        verdict = "EMPTY"
+    elif "UNSAT_NONTRIVIAL" in out:
+        verdict = "NONTRIVIAL"
+    else:
+        verdict = "ERROR"
+    return {
+        "verdict": verdict,
+        "basis_size": next_after("UNSAT_DONE basis_size="),
+        "control_c1_nontrivial": "UNSAT_CONTROL_C1_NONTRIVIAL" in out,
+    }
+
+
+def run_unsat(path: Path, timeout: int) -> dict:

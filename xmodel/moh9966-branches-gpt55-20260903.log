+def build_branch_a_system(tp):
+    """Moh branch A, constructible A/B superset.
+
+    Moh prints "reduced ... to 10 coefficients" for this branch, but omits
+    the actual ten-coefficient equations. The p.210 two-point d'=2,e'=3

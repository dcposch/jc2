        assert self.V[j+1]*self.d[j] % self.d[j+1] == 0
        A = self.A(j)
        return divmod(Q, A) + (A, Q)                  # (TRI_j, SQ_j, A_j, Q)

    def cond1011(self, j):
        """returns (ok, by10, by11) for level j."""

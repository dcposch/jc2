I’m deriving the R3 recurrence separately in the background: the high-degree equations solve the `g_3` coefficients recursively from `f_2`, leaving only the low-degree constraints. This gives an independent way to find a survivor point if the general Groebner run does not finish.
exec
/bin/bash -lc "python3 - <<'PY'
import sympy as sp
p,q=12,18
a=sp.symbols('a0:'+str(p)); b=sp.symbols('b0:'+str(q)); c=sp.symbols('c')
F=[*a,sp.Integer(1)]
G=[*b,sp.Integer(1)]
sol={}
conds=[]
for s in range(p+q-1, -1, -1):
    expr=0
    for i in range(max(0,s-q), min(p,s)+1):
        j=s-i
        if 0<=j<=q:
            Fi=F[i]
            Gj=G[j]
            expr += (2*j-3*i)*Fi*Gj
    expr=sp.expand(expr.subs(sol))
    if s>=p:
        bj=b[s-p]
        coeff=sp.expand(expr.coeff(bj))
        rest=sp.expand(expr-coeff*bj)
        if coeff:
            sol[bj]=sp.expand(-rest/coeff)
        else:
            conds.append(sp.expand(expr))
    else:
        rhs = c if s==0 else 0
        conds.append(sp.expand(expr-rhs))
print('solved_b',len(sol),'conds',len(conds))
print('cond degrees', [sp.Poly(e, *a, c).total_degree() for e in conds[:5]], '...')
for i,e in enumerate(conds[:5]):
    print('cond',i,'terms',len(sp.Poly(e,*a,c).terms()))
print('last cond', conds[-1])
PY" in /home/ubuntu/jc2

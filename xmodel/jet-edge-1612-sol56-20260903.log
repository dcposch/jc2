+    assert_zero("formula(3.5) g edge equals direct major initial", g_edge - g_direct)
+    assert_zero("formula(3.5) f edge equals direct major initial", f_edge - f_direct)
+    assert_zero("major h initial", h_edge + Pmaj**3)
+    assert_zero(
+        "major g initial",

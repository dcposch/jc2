    37	        num *= (V[j] * (n - M[j]) - d[j])
    38	        den_j = V[j] * (n - M[j - 1]) - d[j]
    39	        if den_j == 0:
    40	            raise ZeroDivisionError("Def5.1(3) window factor 0 at j=%d" % j)
    41	        den *= den_j
    42	    return 1 - num / den
    43	
    44	
    45	def phi_s2(n, m, M2, V2, k):
    46	    """Charged rule Phi: delta_i' = (k+1) * Def5.1(3) on (n',m',M2',V2'; s'=2)."""
    47	    d2 = gcd(n, m)
    48	    M = {1: -m, 2: M2}
    49	    d = {1: n, 2: d2, 3: gcd(d2, M2)}
    50	    V = {2: V2, 3: d[3]}
    51	    raw2 = def51(n, M, d, V, 2, 2)
    52	    raw1 = def51(n, M, d, V, 2, 1)
    53	    return (k + 1) * raw2, (k + 1) * raw1, d2, raw2, raw1
    54	
    55	
    56	def A_from_deltas(deltas, s, j):
    57	    """p.201(8): A_j = reduced den of L_j * delta_j, L = lcm{den delta_s..delta_{j+1}}."""
    58	    from math import lcm
    59	    L = 1
    60	    for i in range(j + 1, s + 1):
    61	        L = lcm(L, deltas[i].denominator)
    62	    return (L * deltas[j]).denominator, L
    63	
    64	
    65	def cond1213(n, m, d2, V2, A1):
    66	    """(12) or (13) at r=2.  n* = n/d2, m* = m/d2."""
    67	    ns, ms = n // d2, m // d2
    68	    b12 = (ns * V2 % A1 == 0) and ((ms * V2 - 1) % A1 == 0)
    69	    b13 = (ms * V2 % A1 == 0) and ((ns * V2 - 1) % A1 == 0)
    70	    ident = ((ns + ms) * V2 - 1) % A1 == 0  # p.188
    71	    return (b12 or b13), b12, b13, ident, ns, ms
    72	
    73	
    74	def cond1011(V_j, d_j, d_jp, V_jp, A_j):
    75	    """(9)+(10)/(11) at level j = r-1, r>=3.  Vacuous when s'=2."""
    76	    Q = V_jp * d_j // d_jp
    77	    tri, sq = divmod(Q, A_j)
    78	    b10 = V_j <= tri
    79	    b11 = (V_j - sq) % A_j == 0
    80	    return (b10 or b11), b10, b11, tri, sq, Q
    81	
    82	
    83	def h_monomials(delta1, deg_y, deg_x, tot):
    84	    out = []
    85	    for j in range(deg_y, -1, -1):
    86	        for i in range(0, deg_x + 1):
    87	            if i + j > tot:
    88	                continue
    89	            if F(i) <= delta1 * F(j + 1):
    90	                out.append((i, j))
    91	    return out
    92	
    93	
    94	def beta_monomials(delta1, deg_y, deg_x, tot, weight):
    95	    out = []
    96	    for j in range(deg_y, -1, -1):
    97	        for i in range(0, deg_x + 1):
    98	            if tot is not None and i + j > tot:
    99	                continue
   100	            if F(i) <= delta1 * F(j + weight):
   101	                out.append((i, j))
   102	    return out
   103	
   104	
   105	def leading_support(V2, u, split_pm):
   106	    """Homogeneous leading monomials of h (coeff in Z, not needed for the support)."""
   107	    # y^{V2} (y-x)^u  or  y^{V2}(y^2-x^2)^{u//2} (y-x)^{u%2}
   108	    # Expand by binomial.
   109	    from collections import Counter
   110	    # (y-x)^a * (y^2-x^2)^b * y^{V2} = (y-x)^{a+b} (y+x)^b y^{V2}
   111	    if split_pm and u >= 2:
   112	        a = u % 2
   113	        b = u // 2
   114	    else:
   115	        a, b = u, 0
   116	    # (y-x)^{a+b} = sum_p C(a+b,p) y^{a+b-p} (-x)^p
   117	    # (y+x)^b     = sum_q C(b,q) y^{b-q} x^q
   118	    # times y^{V2}
   119	    from math import comb
   120	    acc = Counter()
   121	    ab = a + b
   122	    for p in range(ab + 1):
   123	        for q in range(b + 1):
   124	            i = p + q
   125	            j = (ab - p) + (b - q) + V2
   126	            c = comb(ab, p) * ((-1) ** p) * comb(b, q)
   127	            if c:
   128	                acc[(i, j)] += c
   129	    return {ij: c for ij, c in acc.items() if c}
   130	
   131	
   132	def shape_bundle(n, m, M2, V2, k):
   133	    """Forced monomials of h, beta for an s'=2 descended pair."""
   134	    d2p, d1p, d2, raw2, raw1 = phi_s2(n, m, M2, V2, k)
   135	    K = gcd(n, m)
   136	    if K == 0:
   137	        raise ValueError("K=0")
   138	    dd = m // K
   139	    ee = n // K
   140	    u = d2 - V2
   141	    v = V2
   142	    degx_h = (u * K // d2) if d2 else 0
   143	    degx_f = (u * m // d2) if d2 else 0
   144	    degx_g = (u * n // d2) if d2 else 0
   145	    # D1 order
   146	    if u < 0 or degx_h < 0:
   147	        return dict(
   148	            ok=False, reason="U-NEGATIVE",
   149	            n=n, m=m, M2=M2, V2=V2, k=k, d2=d2, u=u, K=K, dprime=dd, eprime=ee,
   150	            delta2=d2p, delta1=d1p, raw2=raw2, raw1=raw1,
   151	        )
   152	    hm = h_monomials(d1p, K, degx_h, K)
   153	    bm = beta_monomials(d1p, K - 1, degx_f, m, dd)
   154	    leader = [t for t in hm if t[0] + t[1] == K]
   155	    lower = [t for t in hm if t[0] + t[1] < K]
   156	    split_pm = (d2p == -1 and u == 2)
   157	    two_point = (d2p == -1)
   158	    lead = {}
   159	    extra_killed = []
   160	    if two_point and u >= 1:
   161	        lead = leading_support(v, u, split_pm=split_pm)
   162	        extra_killed = [t for t in leader if t not in lead]
   163	        h_free = list(lower)  # leading fully fixed
   164	        n_ab = len(h_free) + 4 + 1  # Moh beta = p A + q y + r x + s, plus c
   165	    else:
   166	        h_free = [t for t in hm if t != (0, K)]
   167	        n_ab = None
   168	    n_ord = len(h_free) + len(bm) + 1
   169	    A1, L1 = A_from_deltas({1: d1p, 2: d2p}, 2, 1)
   170	    ok1213, b12, b13, ident, ns, ms = cond1213(n, m, d2, V2, A1)
   171	    return dict(
   172	        ok=True, reason="OK",
   173	        n=n, m=m, M2=M2, V2=V2, k=k, d2=d2, u=u, v=v, K=K,
   174	        dprime=dd, eprime=ee,
   175	        delta2=d2p, delta1=d1p, raw2=raw2, raw1=raw1,
   176	        degx_h=degx_h, degx_f=degx_f, degx_g=degx_g,
   177	        h_all=hm, h_leader=leader, h_lower=lower, h_free=h_free,
   178	        beta_all=bm, lead=lead, extra_killed=extra_killed,
   179	        two_point=two_point, split_pm=split_pm,
   180	        n_h=len(h_free), n_beta=len(bm), n_ord=n_ord, n_ab=n_ab,
   181	        A1=A1, L1=L1, ok1213=ok1213, b12=b12, b13=b13, ident188=ident,
   182	        nstar=ns, mstar=ms,
   183	        # s'=2 => (10)/(11) vacuous
   184	        cond1011_active=False,
   185	    )
   186	

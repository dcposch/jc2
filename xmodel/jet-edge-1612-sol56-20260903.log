+    print("PRE_ELIMINATION_COMPARE PASS charged report (5.2), rho^2=6, s!=0")
+    print("PRE_ELIMINATION_FAMILY_MAP", {str(k): str(v) for k, v in family_map.items()})
+    charged_invariants = {

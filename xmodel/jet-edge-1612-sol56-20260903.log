+
+    h_edge, h_samples = formula35_from_parent(h_parent, -16, 3, X, Pmaj, u)
+    g_edge, g_samples = formula35_from_parent(g_parent, -64, 12, X, Pmaj, u)
+    f_edge, f_samples = formula35_from_parent(f_parent, -48, 9, X, Pmaj, u)

+    assert_zero("typed parent p2 gives g initial p2^4", laurent_coeff(g_parent, u, -64) - parent_h0**4)
+    assert_zero("typed parent p2 gives f initial p2^3", laurent_coeff(f_parent, u, -48) - parent_h0**3)

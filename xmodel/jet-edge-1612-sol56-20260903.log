+    print("JET_SAMPLES_H", json.dumps(h_samples, sort_keys=True))
+    print("JET_SAMPLES_G", json.dumps(g_samples, sort_keys=True))
+    print("JET_SAMPLES_F", json.dumps(f_samples, sort_keys=True))

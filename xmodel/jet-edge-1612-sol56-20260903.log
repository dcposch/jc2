+    )
+    if list(negative_kappa) != [1]:
+        raise AssertionError("negative kappa=0 control should be the unit ideal")
+    print("ODE_NEGATIVE_CONTROL_KAPPA_ZERO UNIT (localization-wiring control)")
+
+    negative_scale = bounded_elimination(

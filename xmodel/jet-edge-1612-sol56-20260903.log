+    print("ACTION_PASSIVE inverse matrices if the physical series is held fixed")
+
+    # Compare, before any elimination, with charged report (5.2).
+    svar, rho, z = sp.symbols("s rho z")
+    monic_f_edge = -f_edge
+    G = z**3 - c1 * z**2 + c5 * z - c13
+    F = z**2 - c3 * z + c9
+    family_map = {

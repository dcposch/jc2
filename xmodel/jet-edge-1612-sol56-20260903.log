+    print("ODE_POSITIVE_CONTROL NONUNIT basis_size=", len(ode_gb.polys))
+    print("ODE_ELIM_BASIS", [str(sp.factor(poly.as_expr())) for poly in ode_gb.polys])
+
+    negative_kappa = bounded_elimination(
+        "negative_kappa_zero",
+        len(ode_generators),

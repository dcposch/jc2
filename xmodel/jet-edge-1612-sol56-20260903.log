+    alpha2 = c1 * A + c2
+    beta2 = c3 * A + c4
+    alpha3 = c5 * A + c5 * B + c7
+    beta3 = c8 * A + c9 * B + c10
+    alpha4 = c11 * A + c12 * B + c13 * (y - x)

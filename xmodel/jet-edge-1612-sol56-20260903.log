+    minor_target_generators = source_coefficients + (a0, a1p, a2p, Pbar, u)
+    print(
+        "TARGET_RING_PARENT",
+        "R2=QQ[" + ",".join(map(str, source_coefficients + (X,))) + "][u,u^-1]",
+    )
+    print("TARGET_GENERATOR_ORDER_PARENT", [str(v) for v in parent_target_generators])
+    print(
+        "TARGET_RING_MAJOR",

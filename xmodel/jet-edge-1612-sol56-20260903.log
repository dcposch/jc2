+    print("LEADER_RECIPE_3_8 lc(g_child)=(-1)^4=1; lc(f_child)=(-1)^3=-1")
+
+    # Uniformizer action.  zeta is primitive: coefficient field Q[zeta]/(zeta^2+1).
+    zeta = sp.symbols("zeta")

+    H0 = b1**2 * b2 + 2 * b1 * b3 + b2**2 + b4
+    assert_zero("compatible-minor next coefficient H0", laurent_coeff(h_bar_reduced, u, 0) - H0)
+
+    # Avoid expanding the irrelevant full powers.  The exact component

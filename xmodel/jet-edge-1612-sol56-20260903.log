+    f_parent = sp.expand(bar_f.subs(parent_sub))
+    h_major = sp.expand(h.subs(major_sub))
+    g_major = sp.expand(bar_g.subs(major_sub))
+    f_major = sp.expand(bar_f.subs(major_sub))

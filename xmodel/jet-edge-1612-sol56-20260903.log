+        3 * c1 - 4 * c3,
+        c1 * c3 - 6 * c5 + 8 * c9,
+        5 * c1 * c9 - 9 * c13 - 2 * c3 * c5,
+        5 * c13 * c3 - 2 * c5 * c9,
+        kappa + 4 * c13 * c9,

   484	def build_FG(k2: TZ, outer: dict[str,dict[tuple[int,int],sp.Expr]], max_t: int) -> tuple[TZ,TZ]:
   485	    k2sq=tz_mul(k2,k2,max_t)
   486	    k2cube=tz_mul(k2sq,k2,max_t)
   487	    a2=outer_effective_tz(outer,"A2",max_t)
   488	    a3=outer_effective_tz(outer,"A3",max_t)
   489	    b1=outer_effective_tz(outer,"B1",max_t)
   490	    b2=outer_effective_tz(outer,"B2",max_t)
   491	    KF=tz_add(k2cube,tz_mul(a2,k2,max_t),a3)
   492	    KG=tz_add(k2sq,tz_mul(b1,k2,max_t),b2)
   493	    return KF,KG

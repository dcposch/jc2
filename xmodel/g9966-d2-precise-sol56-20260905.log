   183	@dataclass
   184	class Pivot:
   185	    label: str
   186	    variable: sp.Symbol
   187	    coefficient: sp.Rational
   188	    rhs: sp.Expr
   189	
   190	
   191	def qstar_reduce(
   192	    rows: list[tuple[str, sp.Expr]],
   193	    eligible: set[sp.Symbol],
   194	) -> tuple[list[tuple[str, sp.Expr]], dict[sp.Symbol, sp.Expr], list[Pivot], int]:
   195	    """Eliminate affine pivots whose coefficient is a nonzero rational."""
   196	    work = [(label, sp.expand(row)) for label, row in rows if row != 0]
   197	    substitutions: dict[sp.Symbol, sp.Expr] = {}
   198	    pivots: list[Pivot] = []
   199	    zero_rows = len(rows) - len(work)
   200	    while True:
   201	        choice = None
   202	        for row_index, (label, row) in enumerate(work):
   203	            candidates = sorted(row.free_symbols.intersection(eligible), key=str)
   204	            for variable in candidates:
   205	                coefficient = sp.diff(row, variable)
   206	                if not coefficient.is_Rational or coefficient == 0:
   207	                    continue
   208	                remainder = sp.expand(row - coefficient * variable)
   209	                if variable in remainder.free_symbols:
   210	                    continue
   211	                choice = (row_index, label, variable, sp.Rational(coefficient), remainder)
   212	                break
   213	            if choice is not None:
   214	                break
   215	        if choice is None:
   216	            break
   217	        row_index, label, variable, coefficient, remainder = choice
   218	        rhs = sp.cancel(-remainder / coefficient)
   219	        substitutions[variable] = rhs
   220	        pivots.append(Pivot(label, variable, coefficient, rhs))
   221	        eligible.remove(variable)
   222	        del work[row_index]
   223	        reduced: list[tuple[str, sp.Expr]] = []
   224	        for old_label, old_row in work:
   225	            image = sp.expand(old_row.subs(variable, rhs))
   226	            if image == 0:
   227	                zero_rows += 1
   228	            else:
   229	                reduced.append((old_label, image))
   230	        work = reduced
   231	    resolved = resolve_map(substitutions)
   232	    residual = []
   233	    for label, row in work:
   234	        image = substitute_map(row, resolved)
   235	        if image == 0:
   236	            zero_rows += 1
   237	        else:
   238	            residual.append((label, image))
   239	    return residual, resolved, pivots, zero_rows
   240	

   257	def h3_branch_map(branch: str) -> tuple[dict[sp.Symbol, sp.Expr], list[sp.Symbol], dict]:
   258	    rho, u, v, c = map(symbol, ("rho", "u", "v", "c"))
   259	    names = {(r, d): symbol(f"Hc_{r}_{d}") for r in range(1, 12) for d in range(12-r)}
   260	    if branch == "delta2":
   261	        values = {
   262	            (1,8):0,(1,9):0,(1,10):0,(2,7):0,(2,8):0,(2,9):3*u,
   263	            (3,6):0,(3,7):0,(3,8):3*rho,(4,6):0,(4,7):3*u**2,
   264	            (5,5):0,(5,6):6*rho*u,(6,4):-u**3,(6,5):u**3,
   265	            (7,3):-3*rho*u**2,(8,3):0,(9,2):-u*(3*rho*u**2-symbol("Hc_7_4")),
   266	        }
   267	        free = [symbol("Hc_7_4"), symbol("Hc_10_1"), symbol("Hc_11_0"), rho, u]
   268	        centre = {"parameters":["rho","u"],"localization":"rho!=0"}
   269	    else:
   270	        values = {
   271	            (1,8):0,(1,9):0,(1,10):0,(2,7):0,(2,8):0,(2,9):3*u,
   272	            (3,6):0,(3,7):0,(3,8):-3*v,(4,6):0,(4,7):3*u**2,
   273	            (5,5):0,(5,6):-6*u*v,(6,4):-u**3,(6,5):u**3+3*v**2,
   274	            (7,3):3*u**2*v,(7,4):c-3*u**2*v,(8,3):3*u*v**2,
   275	            (9,2):c*u-v**3,(10,1):-c*v,(11,0):0,
   276	        }
   277	        free = [u, v, c]
   278	        centre = {"parameters":["u","v","c"],"localization":"c!=0","b0":"fixed_zero"}
   279	    substitutions = {names[key]: sp.expand(value) for key, value in values.items()}
   280	    return substitutions, free, centre

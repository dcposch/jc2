   726	def run(branch:str,stage:int,emit_singular:Path|None=None)->dict:
   727	    started=time.perf_counter()
   728	    custody=verify_inputs()
   729	    endpoint=reproduce_charged_endpoint()
   730	    jac_control=jacobian_normalization_control()
   731	    raw_counts={
   732	        "delta2_F":sum(map(len,raw_minor_support("delta2","F").values())),
   733	        "delta2_G":sum(map(len,raw_minor_support("delta2","G").values())),
   734	        "delta52_F":sum(map(len,raw_minor_support("delta52","F").values())),
   735	        "delta52_G":sum(map(len,raw_minor_support("delta52","G").values())),
   736	    }
   737	    assert raw_counts=={
   738	        "delta2_F":1134,"delta2_G":513,"delta52_F":1316,"delta52_G":594,
   739	    }
   740	    spec=stage_spec(branch,stage)
   741	    max_j=max(stage_spec(branch,i)["jacobian"]["t_power"] for i in range(stage+1))
   742	    max_pole=spec["pole_local_power"] if branch=="delta2" else (spec["pole_local_power"]+1)//2
   743	    max_t=max(max_j,max_pole,4)
   744	    k2,inner_free,major=build_major_h2(branch,max_t)
   745	    outer,outer_free,outer_meta=outer_state(min(stage,7))
   746	    KF,KG=build_FG(k2,outer,max_t)
   747	    rows,accounting=cumulative_rows(branch,stage,KF,KG)
   748	    all_free=set(inner_free)|set(outer_free)
   749	    localized=symbol("rho" if branch=="delta2" else "c")
   750	    residual,linear_map,pivots,zero_rows=qstar_reduce(rows,set(all_free)-{localized})
   751	    remaining=all_free-set(linear_map)
   752	    assert localized in remaining
   753	    residual_symbols=set().union(*(row.free_symbols for _label,row in residual)) if residual else set()
   754	    assert residual_symbols.issubset(remaining)
   755	    singular=singular_dimension(residual,branch,emit_singular)
   756	    if singular["unit_ideal"]:
   757	        dimension=None
   758	        verdict="DEAD"
   759	    else:
   760	        dimension=len(remaining)-singular["codimension"]
   761	        verdict="COUNTING-BOUND"
   762	    elapsed=time.perf_counter()-started
   763	    rss_self=resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
   764	    rss_children=resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss
   765	    rss=max(rss_self,rss_children)
   766	    return {
   767	        "type":"EXACT-Q JOINT GLOBAL BAND / FALLACY-v2",
   768	        "branch":branch,"stage_spec":spec,"filtration_convention":{
   769	            "outer":"D2 preblock, then W-W0 offsets; W=3r+4q",
   770	            "pole":"next occupied local exponent (branch-specific)",
   771	            "Jacobian":"named d162,k27; finish d162; then total degrees downward",
   772	            "warning":"synchronization is a driver convention, not a source theorem",
   773	        },
   774	        "custody":custody,"driver_sha256":sha256(Path(__file__)),
   775	        "charged_endpoint":endpoint,
   776	        "major":major,"outer_major":outer_meta,"row_accounting":accounting,
   777	        "jacobian_normalization_control":jac_control,
   778	        "raw_minor_support_control":raw_counts,
   779	        "joint_elimination":{
   780	            "input_row_labels_excluding_preeliminated_major_rows":len(rows),
   781	            "all_labeled_rows_hash":rows_hash(rows),
   782	            "raw_nonzero_count":sum(row!=0 for _label,row in rows),
   783	            "Qstar_pivots":len(pivots),"dependent_or_zero_rows":zero_rows,
   784	            "pivot_ledger":[{"row":p.label,"variable":str(p.variable),
   785	                             "coefficient":str(p.coefficient),"rhs":expr_text(p.rhs)}
   786	                            for p in pivots],
   787	            "residual_count":len(residual),
   788	            "residual_rows":[{"label":label,"expression":expr_text(row)} for label,row in residual],
   789	            "residual_hash":rows_hash(residual),"singular":singular,
   790	        },
   791	        "counts":{
   792	            "inner_free_before_outer":len(inner_free),
   793	            "outer_free_after_current_major_band":len(outer_free),
   794	            "linear_free_before_residue":len(remaining),
   795	            "exact_Krull_dimension_localized":dimension,
   796	        },
   797	        "verdict":verdict,"nonlinear_residue_appears":bool(residual),
   798	        "resources":{"wall_seconds":elapsed,"peak_rss_kib":rss,
   799	                     "self_peak_rss_kib":rss_self,"children_peak_rss_kib":rss_children,
   800	                     "note":"max of process/child lifetime high-water; isolate stages for per-band RSS"},
   801	        "unresolved_quotient_generators":sorted(map(str,remaining)),
   802	        "free_coordinate_list_is_valid":not residual,
   803	        "coordinate_ring_map":{
   804	            "field":"Q",
   805	            "generator_order":"lexicographic symbol name for Q*; Singular dp on active residual generators",
   806	            "K2c_definition":"K2c_r_q=[t^r(w-1)^q](K3^3+(t^22 C2)K3+t^33 C3), low q, after D2",
   807	            "unit_leader":"C3c_r_q for q<=10; C2c_r_(q-11) for 11<=q<=21",
   808	            "structural_certificate_import":{
   809	                "source":"charged major_tower_structure.py/json",
   810	                "facts":"106 low-q coordinates before the seven D1 pivots; unit-triangular C3/C2 leaders",
   811	                "limitation":"the full original C2/C3 inverse map is not serialized; K2c is the declared computation basis",
   812	            },
   813	        },
   814	        "next_stage":stage_spec(branch,stage+1),
   815	    }

                       -9*jet0**2*rho*u+3*jet0*u**3+3*rho*u**2),
        }
        free = [symbol("Hc_7_4"), symbol("Hc_10_1"), symbol("Hc_11_0"),
                jet0, rho, u]
        centre = {"parameters":["jet0","rho","u"],"localization":"rho!=0",
                  "minor_constant":"free","released_pin":"jet0=0"}
    else:
        values = {
            (1,8):0,(1,9):0,(1,10):-3*jet0,(2,7):0,(2,8):-3*jet0**2,
            (2,9):3*(jet0**2+u),(3,6):-jet0**3,
            (3,7):2*jet0*(jet0**2+3*u),(3,8):-jet0**3-3*jet0*u-3*v,
            (4,6):-3*jet0**2*u,(4,7):3*(-jet0**2*u+2*jet0*v+u**2),

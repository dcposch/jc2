   242	def h3_template() -> tuple[TZ, list[sp.Symbol]]:
   243	    out: TZ = {(0, 8): 1, (0, 9): 3, (0, 10): 3, (0, 11): 1}
   244	    variables: list[sp.Symbol] = []
   245	    for r in range(1, 12):
   246	        cap = 11 - r
   247	        vmin = max(0, (33 - 3 * r + 3) // 4)
   248	        for degree in range(vmin, cap + 1):
   249	            variable = symbol(f"Hc_{r}_{degree}")
   250	            variables.append(variable)
   251	            for j in range(degree - vmin + 1):
   252	                out[(r, vmin + j)] = out.get((r, vmin + j), 0) + variable * comb(degree - vmin, j)
   253	    assert len(variables) == 21
   254	    return {key: sp.expand(value) for key, value in out.items()}, variables
   255	

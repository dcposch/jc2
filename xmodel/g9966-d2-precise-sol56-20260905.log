   307	def build_major_h2(branch: str, max_t: int) -> tuple[TZ, set[sp.Symbol], dict]:
   308	    h3, hvars = h3_template()
   309	    hmap, hfree, centre = h3_branch_map(branch)
   310	    h3 = {key: substitute_map(value, hmap) for key, value in h3.items()}
   311	    control = h3_minor_control(branch, h3)
   312	    h3cube = tz_mul(tz_mul(h3, h3, max_t), h3, max_t)
   313	
   314	    # The low-q major-output coordinates have unit C3 (q<=10) or unit C2
   315	    # (11<=q<=21) leading columns.  There are 106 before the seven D1 rows.
   316	    dvars: dict[tuple[int,int], sp.Symbol] = {}
   317	    for r in range(1, 34):
   318	        for q in range(34-r):
   319	            if 3*r + 4*q >= 97 and q <= 21:
   320	                dvars[(r,q)] = symbol(f"K2c_{r}_{q}")
   321	    assert len(dvars) == 106
   322	
   323	    def raw_coefficient(r: int, q: int) -> sp.Expr:
   324	        if (r,q) in dvars:
   325	            return dvars[(r,q)]
   326	        return h3cube.get((r,q), sp.Integer(0))
   327	
   328	    # Exact h2 D1 rows: W=97 has k=0..4, W=98 has k=0..1.
   329	    rows: list[tuple[str,sp.Expr]] = []
   330	    for W, kmax in ((97,4),(98,1)):
   331	        positions = [(r,q) for r in range(1,34) for q in range(34-r) if 3*r+4*q == W]
   332	        for k in range(kmax+1):
   333	            row = sum(comb(q,k)*raw_coefficient(r,q) for r,q in positions if q >= k)
   334	            rows.append((f"h2_D1_W{W}_k{k}", sp.expand(row)))
   335	    pivot_order = [
   336	        dvars[(11,16)],dvars[(15,13)],dvars[(19,10)],dvars[(23,7)],dvars[(27,4)],
   337	        dvars[(10,17)],dvars[(14,14)],
   338	    ]
   339	    # Force the charged determinant choice rather than letting symbol names
   340	    # choose a different but equivalent chart.
   341	    work = list(rows)
   342	    h2map: dict[sp.Symbol,sp.Expr] = {}
   343	    pivots = []
   344	    for variable in pivot_order:
   345	        selected = None
   346	        for index,(label,row) in enumerate(work):
   347	            row = substitute_map(row,h2map)
   348	            coefficient = sp.diff(row,variable)
   349	            if coefficient.is_Rational and coefficient != 0:
   350	                selected=(index,label,row,sp.Rational(coefficient)); break
   351	        assert selected is not None
   352	        index,label,row,coefficient=selected
   353	        rhs=sp.cancel(-(row-coefficient*variable)/coefficient)
   354	        h2map[variable]=rhs
   355	        pivots.append((label,str(variable),str(coefficient)))
   356	        del work[index]
   357	        work=[(lab,sp.expand(rr.subs(variable,rhs))) for lab,rr in work]
   358	    h2map=resolve_map(h2map)
   359	    assert all(substitute_map(row,h2map)==0 for _label,row in rows)
   360	    dfree=set(dvars.values())-set(h2map)


   149	
   150	def substitute_map(expr: sp.Expr, substitutions: dict[sp.Symbol, sp.Expr]) -> sp.Expr:
   151	    if not substitutions or not expr.free_symbols.intersection(substitutions):
   152	        return expr
   153	    old = sp.expand(expr)
   154	    for _ in range(20):
   155	        new = sp.expand(old.subs(substitutions, simultaneous=True))
   156	        if new == old:
   157	            return new
   158	        old = new
   159	    raise AssertionError("substitution map did not stabilize")
   160	
   161	
   162	def resolve_map(substitutions: dict[sp.Symbol, sp.Expr]) -> dict[sp.Symbol, sp.Expr]:
   163	    resolved: dict[sp.Symbol, sp.Expr] = {}
   164	    pending = dict(substitutions)
   165	    for _ in range(len(pending) + 2):
   166	        progress = False
   167	        for variable in list(pending):
   168	            rhs = pending[variable]
   169	            blockers = rhs.free_symbols.intersection(pending)
   170	            if not blockers:
   171	                resolved[variable] = substitute_map(rhs, resolved)
   172	                del pending[variable]
   173	                progress = True
   174	        if not pending:
   175	            return resolved
   176	        if not progress:
   177	            # The elimination maps constructed here are triangular.  A cycle
   178	            # indicates an implementation error, never a license to divide.
   179	            raise AssertionError(f"cyclic substitution map: {sorted(map(str, pending))[:8]}")
   180	    raise AssertionError("failed to resolve substitution map")

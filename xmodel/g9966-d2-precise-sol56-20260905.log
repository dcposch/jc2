   283	def h3_minor_control(branch: str, h3: TZ) -> dict:
   284	    """Check the charged common-h3 leader without expanding a global F/G."""
   285	    rho, u, v, c = map(symbol, ("rho", "u", "v", "c"))
   286	    # Convert each z=w-1 coefficient to w coefficients, then substitute the
   287	    # small minor w-series combinatorially.
   288	    if branch == "delta2":
   289	        rows = local_rows(h3, "delta2", 9, exact_only=False)
   290	        expected = {9: {2: 3*rho, 3: 1}}
   291	        for n in range(10):
   292	            got = {k: row for (power, k), row in rows.items() if power == n and row != 0}
   293	            want = expected.get(n, {})
   294	            assert set(got) == set(want)
   295	            assert all(sp.expand(got[k] - want[k]) == 0 for k in got)
   296	        return {"target":"t^9*zeta^2*(zeta+3*rho)","verified":True}
   297	    rows = local_rows(h3, "delta52", 21, exact_only=False)
   298	    expected = {21: {1: -c, 3: 1}}
   299	    for n in range(22):
   300	        got = {k: row for (power, k), row in rows.items() if power == n and row != 0}
   301	        want = expected.get(n, {})
   302	        assert set(got) == set(want)
   303	        assert all(sp.expand(got[k] - want[k]) == 0 for k in got)
   304	    return {"target":"s^21*pi*(pi^2-c)","verified":True,"ODE_compatibility":"Hc_11_0=0"}

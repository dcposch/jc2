    names = {(r, d): symbol(f"Hc_{r}_{d}") for r in range(1, 12) for d in range(12-r)}
    if branch == "delta2":
        values = {
            (1,8):0,(1,9):0,(1,10):-3*jet0,(2,7):0,(2,8):-3*jet0**2,
            (2,9):3*(jet0**2+u),(3,6):-jet0**3,
            (3,7):2*jet0*(jet0**2+3*u),(3,8):-jet0**3-3*jet0*u+3*rho,
            (4,6):-3*jet0**2*u,(4,7):3*(-jet0**2*u-2*jet0*rho+u**2),
            (5,5):3*jet0*(-jet0**2*u-jet0*rho+u**2),
            (5,6):3*(jet0**3*u+jet0**2*rho+jet0*u**2+2*rho*u),

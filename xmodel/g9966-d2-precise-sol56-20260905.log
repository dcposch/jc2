   113	# A sparse polynomial in (t,z): (t exponent,z exponent) -> coefficient.
   114	TZ = dict[tuple[int, int], sp.Expr]
   115	
   116	
   117	def tz_add(*items: TZ) -> TZ:
   118	    out: dict[tuple[int, int], sp.Expr] = defaultdict(lambda: sp.Integer(0))
   119	    for item in items:
   120	        for key, value in item.items():
   121	            out[key] += value
   122	    return {key: sp.expand(value) for key, value in out.items() if value != 0}
   123	
   124	
   125	def tz_scale(item: TZ, scalar: int | sp.Expr) -> TZ:
   126	    return {key: sp.expand(scalar * value) for key, value in item.items() if value != 0}
   127	
   128	
   129	def tz_mul(left: TZ, right: TZ, max_t: int) -> TZ:
   130	    out: dict[tuple[int, int], sp.Expr] = defaultdict(lambda: sp.Integer(0))
   131	    for (r1, q1), a in left.items():
   132	        for (r2, q2), b in right.items():
   133	            if r1 + r2 <= max_t:
   134	                out[(r1 + r2, q1 + q2)] += a * b
   135	    return {key: sp.expand(value) for key, value in out.items() if value != 0}
   136	
   137	
   138	def tz_dt(item: TZ) -> TZ:
   139	    return {(r - 1, q): r * value for (r, q), value in item.items() if r}
   140	
   141	
   142	def tz_dz(item: TZ) -> TZ:
   143	    return {(r, q - 1): q * value for (r, q), value in item.items() if q}
   144	
   145	
   146	def tz_times_t(item: TZ, max_t: int) -> TZ:
   147	    return {(r + 1, q): value for (r, q), value in item.items() if r + 1 <= max_t}

   818	def main()->None:
   819	    parser=argparse.ArgumentParser()
   820	    parser.add_argument("--branch",choices=["delta2","delta52"],required=True)
   821	    parser.add_argument("--stage",type=int,required=True)
   822	    parser.add_argument("--emit-singular",type=Path)
   823	    args=parser.parse_args()
   824	    assert args.stage>=0
   825	    print(json.dumps(run(args.branch,args.stage,args.emit_singular),indent=2,sort_keys=True))

   473	def outer_effective_tz(
   474	    coordinates: dict[str,dict[tuple[int,int],sp.Expr]], block: str, max_t: int
   475	) -> TZ:
   476	    # Each coefficient block is one degree below its containing term, so its
   477	    # normalized contribution to KF/KG has one additional factor of t.
   478	    return {
   479	        (r+1,q):value for (r,q),value in coordinates[block].items()
   480	        if r+1<=max_t and value!=0
   481	    }

   496	def z_band_to_w(item: TZ, t_power: int) -> dict[int,sp.Expr]:
   497	    out: dict[int,sp.Expr]=defaultdict(lambda:sp.Integer(0))
   498	    for (r,q),value in item.items():
   499	        if r!=t_power: continue
   500	        # (w-1)^q=sum_k binom(q,k)(-1)^(q-k)w^k
   501	        for k in range(q+1):
   502	            out[k]+=value*comb(q,k)*((-1)**(q-k))
   503	    return {k:sp.expand(value) for k,value in out.items() if value!=0}

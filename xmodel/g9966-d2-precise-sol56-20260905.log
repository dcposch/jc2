   506	def jacobian_band(KF: TZ,KG: TZ,t_power: int) -> dict[int,sp.Expr]:
   507	    max_t=t_power
   508	    term1=tz_scale(tz_mul(KF,tz_dz(KG),max_t),99)
   509	    term2=tz_scale(tz_mul(tz_times_t(tz_dt(KF),max_t),tz_dz(KG),max_t),-1)
   510	    term3=tz_scale(tz_mul(tz_dz(KF),KG,max_t),-66)
   511	    term4=tz_mul(tz_dz(KF),tz_times_t(tz_dt(KG),max_t),max_t)
   512	    return z_band_to_w(tz_add(term1,term2,term3,term4),t_power)
   513	
   514	
   515	def jacobian_normalization_control() -> dict:
   516	    """Reproduce the charged first and named-next homogeneous J rows."""
   517	    f=[symbol(f"control_f{j}") for j in range(11)]
   518	    g=[symbol(f"control_g{j}") for j in range(2)]
   519	    k20={(0,24+j):sp.Integer(comb(9,j)) for j in range(10)}
   520	    F0=tz_mul(tz_mul(k20,k20,1),k20,1)
   521	    G0=tz_mul(k20,k20,1)
   522	    F1:TZ={}
   523	    G1:TZ={}
   524	    for j,var in enumerate(f):
   525	        for q in range(j+1):
   526	            F1[(1,q)]=F1.get((1,q),0)+var*comb(j,q)
   527	    for j,var in enumerate(g):
   528	        for q in range(j+1):
   529	            G1[(1,q)]=G1.get((1,q),0)+var*comb(j,q)
   530	    J=jacobian_band(tz_add(F0,F1),tz_add(G0,G1),1)
   531	    assert sp.expand(J[17]-1764*f[0])==0
   532	    named=(17947724418624*f[0]-4326935131200*f[1]+911675169504*f[2]
   533	           -165812670144*f[3]+25622917056*f[4]-3294472896*f[5]
   534	           +342460800*f[6]-27604416*f[7]+1615296*f[8]-60864*f[9]
   535	           +1104*f[10]+131040*g[0]-1656*g[1])
   536	    assert sp.expand(J[27]-named)==0
   537	    return {"x145_y17":"1764*f0","x135_y27":expr_text(named),"verified":True}
   538	
   539	
   540	def all_w_bands(item: TZ) -> dict[int,dict[int,sp.Expr]]:
   541	    powers=sorted({r for r,_q in item})
   542	    return {r:z_band_to_w(item,r) for r in powers}
   543	
   544	
   545	def local_rows(item: TZ,branch: str,max_power: int,exact_only: bool=True) -> dict[tuple[int,int],sp.Expr]:
   546	    wbands=all_w_bands(item)
   547	    out: dict[tuple[int,int],sp.Expr]=defaultdict(lambda:sp.Integer(0))
   548	    u,v=map(symbol,("u","v"))
   549	    if branch=="delta2":
   550	        for r,poly in wbands.items():
   551	            for j,coefficient in poly.items():
   552	                for k in range(j+1):
   553	                    n=r+2*j+k
   554	                    if n<=max_power:
   555	                        out[(n,k)]+=coefficient*comb(j,k)*u**(j-k)
   556	    else:
   557	        for r,poly in wbands.items():
   558	            for j,coefficient in poly.items():
   559	                for b in range(j+1):
   560	                    for k in range(j-b+1):
   561	                        a=j-b-k
   562	                        n=2*r+4*j+2*b+3*k
   563	                        if n<=max_power:
   564	                            multinomial=factorial(j)//(factorial(a)*factorial(b)*factorial(k))
   565	                            out[(n,k)]+=coefficient*multinomial*u**a*v**b
   566	    return {tag:sp.expand(value) for tag,value in out.items() if value!=0}
   567	
   568	
   569	@lru_cache(maxsize=None)
   570	def raw_minor_support(branch: str, name: str) -> dict[int, tuple[int, ...]]:
   571	    """Charged lower-support row labels, grouped by normalized local power."""
   572	    degree = 99 if name == "F" else 66
   573	    pole = 18 if name == "F" else 12
   574	    tags: set[tuple[int,int]] = set()
   575	    if branch == "delta2":
   576	        shift = 81 if name == "F" else 54
   577	        for i in range(degree):
   578	            for j in range(degree-i):
   579	                for k in range(j+1):
   580	                    exponent = pole-i+j+k
   581	                    if exponent <= 0:
   582	                        tags.add((exponent+shift,k))
   583	    else:
   584	        pole = 9 if name == "F" else 6
   585	        shift = 189 if name == "F" else 126
   586	        for i in range(degree):
   587	            for j in range(degree-i):
   588	                for b in range(j+1):
   589	                    for k in range(j-b+1):
   590	                        exponent = pole-2*i+2*j+2*b+3*k
   591	                        if exponent <= 0:
   592	                            tags.add((exponent+shift,k))
   593	    grouped: dict[int,list[int]]=defaultdict(list)
   594	    for n,k in sorted(tags):
   595	        grouped[n].append(k)
   596	    return {n:tuple(values) for n,values in grouped.items()}
   597	
   598	
   599	def raw_minor_tags(branch: str, name: str, local_power: int) -> tuple[int, ...]:
   600	    return raw_minor_support(branch,name).get(local_power,())

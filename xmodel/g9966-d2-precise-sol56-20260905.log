   603	def rows_hash(rows: Iterable[tuple[str,sp.Expr]]) -> str:
   604	    payload="".join(f"{label}\t{sp.srepr(sp.expand(row))}\n" for label,row in rows)
   605	    return hashlib.sha256(payload.encode()).hexdigest()
   606	
   607	
   608	def singular_dimension(
   609	    residual: list[tuple[str,sp.Expr]], branch: str, emit_path: Path | None=None
   610	) -> dict:
   611	    if not residual:
   612	        if emit_path is not None:
   613	            emit_path.write_text("// zero residual ideal over Q\n",encoding="utf-8")
   614	        return {"unit_ideal":False,"active_variables":0,"dimension":0,"codimension":0,
   615	                "basis":["0"],"wrapper_control":"not_needed"}
   616	    expressions=[sp.expand(row) for _label,row in residual]
   617	    variables=sorted(set().union(*(row.free_symbols for row in expressions)),key=str)
   618	    wrapper=symbol("Zrho" if branch=="delta2" else "Zc")
   619	    localized=symbol("rho" if branch=="delta2" else "c")
   620	    if localized not in variables:
   621	        variables.append(localized)
   622	        variables.sort(key=str)
   623	    ringvars=variables+[wrapper]
   624	    def singular_expr(expr:sp.Expr)->str:
   625	        return str(expr).replace("**","^")
   626	    ideal_entries=[singular_expr(row) for row in expressions]+[f"{wrapper}*{localized}-1"]
   627	    script=(
   628	        f"ring R=0,({','.join(map(str,ringvars))}),dp;\n"
   629	        f"ideal I={','.join(ideal_entries)};\n"
   630	        "ideal S=std(I);\n"
   631	        'print("BEGIN_DIM"); print(dim(S)); print("END_DIM");\n'
   632	        'print("BEGIN_GB"); print(S); print("END_GB");\n'
   633	        f"ideal EmptyControl={localized},{wrapper}*{localized}-1;\n"
   634	        f"ideal PointControl={localized}-1,{wrapper}*{localized}-1;\n"
   635	        f"ideal RawControl={','.join(singular_expr(row) for row in expressions)};\n"
   636	        'print("BEGIN_CONTROLS"); print(reduce(1,std(EmptyControl))); '
   637	        'print(reduce(1,std(PointControl))); print(reduce(1,std(RawControl))); '
   638	        'print("END_CONTROLS");\n'
   639	        "quit;\n"
   640	    )
   641	    if emit_path is not None:
   642	        emit_path.write_text(script,encoding="utf-8")
   643	    run=subprocess.run(["Singular","-q"],input=script,text=True,capture_output=True,check=True)
   644	    output=run.stdout
   645	    def section(name:str)->str:
   646	        return output.split(f"BEGIN_{name}\n",1)[1].split(f"\nEND_{name}",1)[0].strip()
   647	    dimension=int(section("DIM").splitlines()[-1])
   648	    gb=section("GB")
   649	    controls=section("CONTROLS").splitlines()
   650	    unit=dimension < 0
   651	    # wrapper adds one variable and one equation, so dimension is the
   652	    # localized dimension in the original active variables.
   653	    codimension=len(variables)-dimension
   654	    assert controls[-3:-1]==["0","1"]
   655	    raw_unit=controls[-1]=="0"
   656	    gb_lines=gb.splitlines()
   657	    return {"unit_ideal":unit,"active_variables":len(variables),"dimension":dimension,
   658	            "codimension":codimension,"basis_line_count":len(gb_lines),
   659	            "basis_sha256":hashlib.sha256((gb+"\n").encode()).hexdigest(),
   660	            "basis_preview":gb_lines[:20],
   661	            "wrapper":f"{wrapper}*{localized}-1",
   662	            "wrapper_control":"<p,Zp-1> unit; <p-1,Zp-1> nonunit",
   663	            "raw_residue_unit_ideal":raw_unit}
   664	
   665	
   666	def stage_spec(branch:str,stage:int)->dict:
   667	    if branch=="delta2":
   668	        pole_power=4+stage
   669	        pole_exponents={"F":pole_power-81,"G":pole_power-54}
   670	    else:
   671	        pole_power=8+stage
   672	        pole_exponents={"F":pole_power-189,"G":pole_power-126}
   673	    if stage==0:
   674	        jacobian={"t_power":1,"degree":162,"w_powers":[27]}
   675	    elif stage==1:
   676	        jacobian={"t_power":1,"degree":162,"w_powers":list(range(28,163))}
   677	    else:
   678	        tpower=stage
   679	        jacobian={"t_power":tpower,"degree":163-tpower,"w_powers":list(range(164-tpower))}
   680	    return {"stage":stage,"D1_offset":stage if stage<=7 else None,
   681	            "pole_local_power":pole_power,"pole_exponents":pole_exponents,
   682	            "jacobian":jacobian}
   683	
   684	
   685	def cumulative_rows(branch:str,stage:int,KF:TZ,KG:TZ) -> tuple[list[tuple[str,sp.Expr]],dict]:
   686	    rows=[]
   687	    accounting={"prior":{},"stages":[]}
   688	    # Charged prefix: exact local bands and ten J162 slots.
   689	    fprior=[1,2,3] if branch=="delta2" else [2,4,6]
   690	    gprior=list(fprior)
   691	    f_local=local_rows(KF,branch,max(stage_spec(branch,stage)["pole_local_power"],max(fprior)))
   692	    g_local=local_rows(KG,branch,max(stage_spec(branch,stage)["pole_local_power"],max(gprior)))
   693	    for name,bands,table in (("F",fprior,f_local),("G",gprior,g_local)):
   694	        count=0
   695	        for n in bands:
   696	            tags=raw_minor_tags(branch,name,n)
   697	            assert tags
   698	            for k in tags:
   699	                rows.append((f"prior_{name}_local{n}_coord{k}",table.get((n,k),sp.Integer(0))))
   700	                count+=1
   701	        accounting["prior"][name]=count
   702	    J1=jacobian_band(KF,KG,1)
   703	    for k in range(17,27):
   704	        rows.append((f"prior_J_d162_k{k}",J1.get(k,sp.Integer(0))))
   705	    accounting["prior"]["J162"]=10
   706	
   707	    # Continuation stages.
   708	    for current in range(stage+1):
   709	        spec=stage_spec(branch,current)
   710	        n=spec["pole_local_power"]
   711	        stage_counts={"stage":current,"F":0,"G":0,"J":0}
   712	        for name,table in (("F",f_local),("G",g_local)):
   713	            tags=raw_minor_tags(branch,name,n)
   714	            for k in tags:
   715	                rows.append((f"stage{current}_{name}_local{n}_coord{k}",table.get((n,k),sp.Integer(0))))
   716	                stage_counts[name]+=1
   717	        jspec=spec["jacobian"]
   718	        J=jacobian_band(KF,KG,jspec["t_power"])
   719	        for k in jspec["w_powers"]:
   720	            rows.append((f"stage{current}_J_d{jspec['degree']}_k{k}",J.get(k,sp.Integer(0))))
   721	            stage_counts["J"]+=1
   722	        accounting["stages"].append(stage_counts)
   723	    return rows,accounting
   724	

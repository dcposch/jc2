import sympy as sp
T,S,X,Y,Z=sp.symbols('T S X Y Z')
examples=[
    ('k2',2,T**3,T**4+T**2),
    ('k3',3,T**3,T**5+7*T**4+3*T**3+T**2),
    ('k5',5,T**3,T**7+T**2),
]

def divdiff(expr):
    return sp.Poly(sp.cancel((expr-expr.subs(T,S))/(T-S)), S, T).as_expr()

def squarefree_degree(poly,var):
    P=sp.Poly(poly,var,domain=sp.QQ)
    return P.degree()-sp.Poly(sp.gcd(P.as_expr(), sp.diff(P.as_expr(),var)),var,domain=sp.QQ).degree()

def analyze(label,k,a,b):
    print('===',label,'===')

/bin/zsh -lc "python3 - <<'PY'
import sympy as sp
T,S,X,Y,Z=sp.symbols('T S X Y Z')
examples=[
    ('k2/q4',2,T**3,T**4+T**2),
    ('k3/q5tail',3,T**3,T**5+7*T**4+3*T**3+T**2),
    ('k5/q7',5,T**3,T**7+T**2),
    ('k6/q8tail',6,T**3,T**8+T**2+5*T**3+2*T**4+11*T**5+3*T**6+T**7),
    ('k8/q10',8,T**3,T**10+T**2),
    ('k9/q11tail',9,T**3,T**11+T**2+3*T**3+5*T**4+2*T**5+7*T**6+T**7+4*T**8+6*T**9+2*T**10),
    ('k11/q13',11,T**3,T**13+T**2),
]
def divdiff(e): return sp.Poly(sp.cancel((e-e.subs(T,S))/(T-S)),S,T).as_expr()
def sf_nonzero_resultant(a,b):
    A=divdiff(a); B=divdiff(b); R=sp.Poly(sp.resultant(A,B,S),T)
    g=sp.gcd(R.as_expr(),sp.diff(R.as_expr(),T))
    sf=sp.Poly(R.as_expr()/g,T)
    if sf.eval(0)==0: sf=sp.Poly(sf.as_expr()/T,T)
    return A,B,R,sf
def ord0(e):
    P=sp.Poly(e,T); return min(m[0] for m,c in P.terms() if c)
for label,k,a,b in examples:
    q=max(sp.Poly(a,T).degree(),sp.Poly(b,T).degree())
    F=sp.Poly(sp.resultant(X-a,Y-b,T),X,Y)
    A,B,R,sf=sf_nonzero_resultant(a,b)
    D=sp.expand(sp.diff(a,T)*sp.diff(b.subs(T,S),S)-sp.diff(a.subs(T,S),S)*sp.diff(b,T))
    ResD=sp.Poly(sp.resultant(A,D,S),T)
    tangent_common=sp.gcd(sf.as_expr(),ResD.as_expr())
    rem=sp.Poly(B,S).rem(sp.Poly(A,S))
    coeffs=[sp.Poly(c,T).as_expr() for c in sp.Poly(rem,S).all_coeffs()]
    triple=coeffs[0]
    for c in coeffs[1:]: triple=sp.gcd(triple,c)
    crit=sp.gcd(sp.diff(a,T),sp.diff(b,T))
    ok=(F.total_degree()==q and len(sp.factor_list(F.as_expr())[1])==1 and sp.factor(sp.Poly(F.as_expr(),X,Y).homogenize(Z).as_expr().subs(Z,0))==-X**q and sp.factor(crit)==T and (ord0(a),ord0(b))==(3,2) and sf.degree()==2*k and sp.factor(tangent_common)==1 and sp.factor(triple)==1)
    print(label, 'degree',q, 'sf_deg',sf.degree(), 'nodes',sf.degree()//2, 'pa', (q-1)*(q-2)//2, 'delta_aff',1+sf.degree()//2, 'delta_inf',(q-1)*(q-2)//2-(1+sf.degree()//2), 'ok',ok)
PY" in /Users/dc/code/math/jc2

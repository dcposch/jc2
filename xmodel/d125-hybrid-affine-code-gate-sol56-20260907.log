+#!/usr/bin/env python3
+"""Independent tiny controls for the frozen hybrid-affine producer."""
+import resource
+resource.setrlimit(resource.RLIMIT_CPU, (25, 25))
+resource.setrlimit(resource.RLIMIT_AS, (512 * 1024**2, 512 * 1024**2))

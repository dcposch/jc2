+def test_07_jacobian_shape_and_bound():
+    need(20*59 + 3*20 + 2*59 + 4 == 1362, 'support census')
+    small = {(0, 20): Q(1), (0, C.K, C.K): Q(1, 9), (20, C.K): Q(2, 9), (C.K,)*3: Q(5, 9)}

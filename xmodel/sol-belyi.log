+assert J.rank() == 2
+assert simplify(Jg.det() + 2*sqrt(3)) == 0
+
+fe = (u-a+eps*F1)**2*(u-c+eps*F2)**2
+ge = ((u-a+eps*G1)**2*(u-a+eps*H1)
+      *(u-c+eps*G2)**2*(u-c+eps*H2))
+dh = diff(ge**2-fe**3, eps).subs(eps, 0)
+assert simplify(dh/(2*(u-a)**5*(u-c)**5)
+    - ((2*G1+H1-3*F1)*(u-c)

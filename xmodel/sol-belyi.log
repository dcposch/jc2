105: \sigma_0=(1\,2\,3),\qquad
106: \sigma_1=(2\,3\,4),\qquad
126: A(u)=(u-r)(u-b)^3,\qquad
127: C(u)=(u-a)^2(u-c)^2,\qquad \beta=A/C,
173: d(E_3,E_2,r,a+c-1),\qquad \det=-2\sqrt3\ne0.           \tag{2.3}
181: 3\,db-2\,ds=0,\qquad 3\,dp-s\,ds=0.                   \tag{2.4}


+assert simplify(diff(N/D, u)
+    + Rational(1,9)*(u-Rational(2,3))**2
+      /(u**2-u+Rational(1,6))**3) == 0
+
+A = expand((u-r)*(u-b)**3)
+C = expand((u-a)**2*(u-c)**2)

                        else:
                            comb.pop(m, None)
            for (pk, deep) in comb:
                assert not any(nm in set(ycols) for nm in deep), \
                    ("compat row retains rung tail", k, li)
            compat.append(((k, li), tuple(int(x) for x in lrow), comb))

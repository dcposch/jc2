                              "d_structure": dinfo,
                              "compat_terms": [len(x[2]) for x in
                                               compat
                                               if x[0][0] == k]}
        print("rung %d: rank C = %d, %d compat rows (terms %s) "
              "(%.0fs)" % (k, rk, len(L),
                           [len(x[2]) for x in compat
                            if x[0][0] == k],
                           time.time() - t0), flush=True)

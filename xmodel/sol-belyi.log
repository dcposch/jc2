+C = expand((u-a)**2*(u-c)**2)
+E3 = (A-C).coeff(u, 3)
+E2 = (A-C).coeff(u, 2)
+pt = {r: 0, b: Rational(2,3),
+      a: (1+1/sqrt(3))/2, c: (1-1/sqrt(3))/2}

def rref(matrix: list[list[int]]) -> tuple[list[list[int]], list[int]]:
    matrix = [row[:] for row in matrix]
    if not matrix:
        return [], []
    columns = len(matrix[0])
    pivots: list[int] = []
    row = 0
    for column in range(columns):
        selected = next((r for r in range(row, len(matrix)) if matrix[r][column]), None)
        if selected is None:
            continue
        matrix[row], matrix[selected] = matrix[selected], matrix[row]
        inv = pow(matrix[row][column], -1)
        matrix[row] = [(value * inv) for value in matrix[row]]
        for other in range(len(matrix)):
            if other != row and matrix[other][column]:
                factor = matrix[other][column]
                matrix[other] = [(a - factor * b) for a, b in zip(matrix[other], matrix[row])]
        pivots.append(column)
        row += 1
        if row == len(matrix):
            break
    return [row for row in matrix if any(row)], pivots


def minor2(poly_a: dict[tuple[int, ...], int], poly_b: dict[tuple[int, ...], int],
           col_a: str, col_b: str, system: System) -> int:
    ia, ib = system.variables.index(col_a), system.variables.index(col_b)

    def linear_coefficient(poly: dict[tuple[int, ...], int]) -> tuple[int, int]:
        coefficients = [0, 0]
        for monomial, coefficient in poly.items():
            exponents = list(monomial)
            degree = sum(exponents)
            if degree != 1:
                continue
            if sum(1 for j in (ia, ib) if exponents[j]) != 1 or any(
                e for j, e in enumerate(exponents) if j not in (ia, ib)
            ):
                return (0, 0)
            coefficients[0 if exponents[ia] else 1] = coefficient
        return tuple(coefficients)

    a1, b1 = linear_coefficient(poly_a)
    a2, b2 = linear_coefficient(poly_b)
    return (a1 * b2 - a2 * b1) % system.prime


def solve_pivot(system: System, assignments: dict[str, int], target: str,
                 source_row_index: int) -> tuple[dict[str, int], bool]:
    row = system.polys[source_row_index]
    idx = system.variables.index(target)
    constant = evaluate(row, [assignments.get(v, 0) for v in system.variables])
    linear_coefficient = 0
    for monomial, coefficient in row.items():
        exponents = list(monomial)
        degree = sum(exponents)
        if degree != 1 or exponents[idx] != 1 or any(e for j, e in enumerate(exponents) if j != idx):
            continue
        linear_coefficient += coefficient
    linear_coefficient %= system.prime
    ok = bool(linear_coefficient)
    if ok:
        assignments[target] = (-constant * pow(linear_coefficient, -1)) % system.prime
    return assignments, ok



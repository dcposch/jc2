import sys,tempfile,subprocess
sys.path.insert(0,'cases')
from ox_calibration import load_system
from pathlib import Path
s=load_system(Path('cases/d25fam_p105337_a00mm.ms'))
def sing_poly(m,c):
 out=''
 for var,e in zip(s.variables,m):
  if e:out+=('*' if out else '')+var+(f'"'^{e}'"' if e>1 else '')
 return (str(c)+('*'+out if out else '')) if out else str(c)
polys=','.join(sing_poly(m,c) for p in s.polys for m,c in sorted(p.items()))
script=f'''LIB \"standard.lib\";
ring r=0,({','.join(s.variables)}),lp;
ideal I={polys};
ideal S=std(I);
\"DIM=\",dim(S);
\"VDIM=\",vdim(S);
\"HILB=\",hilbPoly(S);
quit;
'''
open('/tmp/ox_test.sing','w').write(script)
r=subprocess.run(['Singular','-q','/tmp/ox_test.sing'],text=True,capture_output=True,timeout=120)
print(r.stdout[-5000:])
print('ERR',r.stderr[-2000:])

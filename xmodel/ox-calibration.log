#!/usr/bin/env python3
"""Independent finite-field verification of the D25 parked-fiber claim.

No replay certificate is read. Inputs are the sibling .ms files only.
"""
from __future__ import annotations

import argparse
import json
import re
import time
from dataclasses import dataclass
from itertools import combinations
from pathlib import Path


@dataclass(frozen=True)
class System:
    path: Path
    variables: tuple[str, ...]
    prime: int
    polys: list[dict[tuple[int, ...], int]]


def split_top_level(text: str) -> list[str]:
    parts: list[str] = []
    stack: list[str] = []
    start = 0
    for i, char in enumerate(text):
        if char in "([":
            stack.append(char)
        elif char in ")]":
            if stack:
                stack.pop()
        elif char == "," and not stack:
            parts.append(text[start:i])
            start = i + 1
    tail = text[start:].strip()
    if tail:
        parts.append(tail)
    return [part for part in (p.strip() for p in parts) if part]


TOKEN_RE = re.compile(r"(?P<num>\d+)|(?P<var>[A-Za-z][A-Za-z0-9_]*)(?:\^(?P<exp>\d+))?|(?P<op>[+*])")


class Parser:
    def __init__(self, variables: tuple[str, ...], prime: int):
        self.index = {v: i for i, v in enumerate(variables)}
        self.prime = prime
        self.i = 0
        self.text = ""
        self.poly: dict[tuple[int, ...], int] = {}

    def parse(self, text: str) -> dict[tuple[int, ...], int]:
        self.text = re.sub(r"\s+", "", text)
        self.i = 0
        self.poly = {}
        if self.peek() == "-":
            self.take()
            self.term(sign=-1)
        else:
            if self.peek() == "+":
                self.take()
            self.term(sign=1)
        while self.i < len(self.text):
            op = self.take_op()
            sign = 1 if op == "+" else -1
            self.term(sign=sign)
        return {m: c % self.prime for m, c in self.poly.items() if c % self.prime}

    def peek(self) -> str | None:
        return self.text[self.i] if self.i < len(self.text) else None

    def take(self) -> str:
        char = self.text[self.i]
        self.i += 1
        return char

    def take_op(self) -> str:
        if self.peek() not in ("+", "-", "*"):
            raise ValueError(f"expected +/- at {self.i}: {self.text[self.i:]!r}")
        return self.take()

    def term(self, sign: int) -> None:
        coeff = 1
        exps = [0] * len(self.index)
        matched_any = False
        while True:
            match = TOKEN_RE.match(self.text, self.i)
            if match is None or match.lastgroup == "op":
                break
            self.i = match.end()
            if match.group("num") is not None:
                coeff *= int(match.group("num"))
            elif match.group("var") is not None:
                name = match.group("var")
                exponent = int(match.group("exp") or 1)
                exps[self.index[name]] += exponent
            matched_any = True
        if not matched_any:
            raise ValueError(f"empty term at {self.i}: {self.text[self.i:]!r}")
        monomial = tuple(exps)
        self.poly[monomial] = self.poly.get(monomial, 0) + sign * coeff % self.prime


def load_system(path: Path) -> System:
    lines = path.read_text().splitlines()
    variables = tuple(line.strip() for line in lines[0].split(","))
    prime = int(lines[1])
    body_lines = lines[2:]
    equations = split_top_level("\n".join(body_lines))
    parser = Parser(variables, prime)
    polys = [parser.parse(equation) for equation in equations]
    return System(path, variables, prime, polys)


def evaluate(poly: dict[tuple[int, ...], int], values: list[int]) -> int:
    total = 0
    for monomial, coefficient in poly.items():
        term_value = coefficient
        for exponent, value in zip(monomial, values):
            if exponent:
                term_value *= pow(value, exponent)
        total += term_value
    return total


def rref(matrix: list[list[int]]) -> tuple[list[list[int]], list[int]]:
    matrix = [row[:] for row in matrix]
    if not matrix:
        return [], []
    columns = len(matrix[0])
    pivots: list[int] = []
    row = 0
    for column in range(columns):
        selected = next((r for r in range(row, len(matrix)) if matrix[r][column]), None)
        if selected is None:
            continue
        matrix[row], matrix[selected] = matrix[selected], matrix[row]
        inv = pow(matrix[row][column], -1)
        matrix[row] = [(value * inv) for value in matrix[row]]
        for other in range(len(matrix)):
            if other != row and matrix[other][column]:
                factor = matrix[other][column]
                matrix[other] = [(a - factor * b) for a, b in zip(matrix[other], matrix[row])]
        pivots.append(column)
        row += 1
        if row == len(matrix):
            break
    return [row for row in matrix if any(row)], pivots


def minor2(poly_a: dict[tuple[int, ...], int], poly_b: dict[tuple[int, ...], int],
           col_a: str, col_b: str, system: System) -> int:
    ia, ib = system.variables.index(col_a), system.variables.index(col_b)

    def linear_coefficient(poly: dict[tuple[int, ...], int]) -> tuple[int, int]:
        coefficients = [0, 0]
        for monomial, coefficient in poly.items():
            exponents = list(monomial)
            degree = sum(exponents)
            if degree != 1:
                continue
            if sum(1 for j in (ia, ib) if exponents[j]) != 1 or any(
                e for j, e in enumerate(exponents) if j not in (ia, ib)
            ):
                return (0, 0)
            coefficients[0 if exponents[ia] else 1] = coefficient
        return tuple(coefficients)

    a1, b1 = linear_coefficient(poly_a)
    a2, b2 = linear_coefficient(poly_b)
    return (a1 * b2 - a2 * b1) % system.prime


def solve_pivot(system: System, assignments: dict[str, int], target: str,
                 source_row_index: int) -> tuple[dict[str, int], bool]:
    row = system.polys[source_row_index]
    idx = system.variables.index(target)
    constant = evaluate(row, [assignments.get(v, 0) for v in system.variables])
    linear_coefficient = 0
    for monomial, coefficient in row.items():
        exponents = list(monomial)
        degree = sum(exponents)
        if degree != 1 or exponents[idx] != 1 or any(e for j, e in enumerate(exponents) if j != idx):
            continue
        linear_coefficient += coefficient
    linear_coefficient %= system.prime
    ok = bool(linear_coefficient)
    if ok:
        assignments[target] = (-constant * pow(linear_coefficient, -1)) % system.prime
    return assignments, ok


def verify_prime(path: Path) -> dict:
    started = time.time()
    system = load_system(path)
    prime = system.prime
    result: dict = {
        "file": str(path), "prime": prime, "variable_count": len(system.variables),
        "equation_count": len(system.polys),
    }

    # Structural checks from raw equations.
    assert len(system.polys) == 34
    inverse_poly = {(system.variables.index("W1"), system.variables.index("uW1")): 1,
                    (0,) * len(system.variables): prime - 1}
    assert evaluate(inverse_poly, [prime-1, 1]) % prime == 0
    result["inverse_equations"] = ["W1*uW1+1", "W2*uW2+1"]

    # The five residual rows are the final five raw equations.
    residual_indices = [29, 30, 31, 32, 33]
    # Claimed identity is R2 + 6 R3 + 30 R4 + 144 R5.
    identity = {}
    for multiplier, index in zip([1, 6, 30, 144], residual_indices[1:]):
        for monomial, coefficient in system.polys[index].items():
            identity[monomial] = (identity.get(monomial, 0) + multiplier * coefficient) % prime
    identity_values = [3 + i for i in range(len(system.variables))]
    identity_zero = evaluate(identity, identity_values) % prime == 0
    result["claimed_identity_R2_plus_6R3_30R4_144R5"] = identity_zero

    # Lift block rank/minor test: exact affine coefficient extraction from R1,R2.
    lift_vars = ["x33", "x38", "x16", "x19", "x24", "x27"]
    r1, r2 = system.polys[residual_indices[0]], system.polys[residual_indices[1]]
    minor_x33_x38 = minor2(r1, r2, "x33", "x38", system)
    # The raw rows are linear with common coefficients in each lift variable.
    def common_lift_coefficients(poly: dict[tuple[int, ...], int]) -> dict[str, int]:
        values = {}
        for name in lift_vars:
            index = system.variables.index(name)
            coefficients = {
                coefficient for monomial, coefficient in poly.items()
                if monomial[index] == 1 and sum(monomial) == 1
            }
            values[name] = next(iter(coefficients)) if len(coefficients) == 1 else 0
        return values
    coefficients_1 = common_lift_coefficients(r1)
    coefficients_2 = common_lift_coefficients(r2)
    minor_x33_x38 = (
        coefficients_1["x33"] * coefficients_2["x38"]
        - coefficients_1["x38"] * coefficients_2["x33"]
    ) % prime
    result["minor_R1R2_cols_x33_x38"] = minor_x33_x38
    result["R1_lift_coefficients"] = coefficients_1
    result["R2_lift_coefficients"] = coefficients_2
    result["minor_is_unit"] = bool(minor_x33_x38)
    if not minor_x33_x38:
        raise AssertionError("claimed Laurent unit minor failed")

    # Reconstruct hlin/hcore by solving the two compatibility rows directly.
    # Use symbolic Gaussian elimination on the residual coefficient matrix after x33/x38 elimination.
    # Build affine coefficient vector over remaining base/lift variables for each residual.
    vars = system.variables
    columns = list(range(len(vars)))
    rows = []
    for ri in residual_indices:
        vec = [0] * len(vars)
        constant = 0
        for monomial, coefficient in system.polys[ri].items():
            exponents = list(monomial)
            degree = sum(exponents)
            active = [j for j, e in enumerate(exponents) if e]
            if degree == 0:
                constant += coefficient
            elif degree == 1:
                vec[active[0]] += coefficient
            else:
                raise RuntimeError("residual is not affine as claimed")
        rows.append(vec + [constant])
    _, pivots = rref(rows)
    result["residual_affine_rank"] = len(pivots)
    lift_pivot_count = sum(1 for column in pivots if vars[column] in lift_vars)
    result["free_lift_count_after_residuals"] = 6 - lift_pivot_count
    result["note"] = "rank derived solely from parsed residual affine forms"

    # The six terminal source trinomials are identified structurally as sparse rows involving W1^4/W2^4.
    terminal_rows = []
    for index, poly in enumerate(system.polys):
        monomials = list(poly.items())
        if len(monomials) <= 3 and any(sum(m) in (4,) for m, _ in monomials):
            terminal_rows.append(index)
    result["terminal_candidate_source_rows"] = terminal_rows
    matrix = []
    U = vars.index("W1"); V = vars.index("W2")
    for index in terminal_rows:
        row = [0, 0, 0]
        for monomial, coefficient in system.polys[index].items():
            exponents = list(monomial)
            if exponents[U] == 4 and sum(exponents) == 4:
                row[0] += coefficient
            elif exponents[V] == 4 and sum(exponents) == 4:
                row[1] += coefficient
            elif sum(exponents) == 0:
                row[2] += coefficient
            else:
                raise RuntimeError(f"unexpected terminal monomial at row {index}")
        matrix.append([v % prime for v in row])
    reduced, terminal_pivots = rref(matrix)
    result["terminal_matrix"] = matrix
    result["terminal_rref"] = reduced
    result["terminal_rank"] = len(terminal_pivots)
    if len(reduced) < 2 or reduced[0][2] == 0 or reduced[1][2] == 0:
        raise AssertionError("terminal equations did not yield unique U,V")
    w14 = (-reduced[0][2]) % prime
    w24 = (-reduced[1][2]) % prime
    result["terminal_constants_W1_4_W2_4"] = [w14, w24]
    result["constants_nonzero_fourth_power"] = bool(w14 and w24 and pow(w14, (prime-1)//4, prime) == 1 and pow(w24,(prime-1)//4,prime)==1)
    result["base_branches"] = 16 if result["constants_nonzero_fourth_power"] else 0

    # Explicit witness evaluation of every raw equation on one reconstructed branch.
    # Terminal constants determine fourth roots; use deterministic Tonelli-Shanks via brute force only for witness.
    roots = lambda n: sorted((r for r in range(prime) if pow(r,4,prime)==n))[:4]
    w1_roots, w2_roots = roots(w14), roots(w24)
    result["fourth_root_counts"] = [len(w1_roots), len(w2_roots)]
    witness_w1, witness_w2 = w1_roots[0], w2_roots[0]
    assignments = {v: 1 for v in vars}
    assignments.update({"W1": witness_w1, "uW1": pow(witness_w1,-1,prime), "W2": witness_w2,
                        "uW2": pow(witness_w2,-1,prime)})
    # Solve A,h square-root rows deterministically.
    for varname in ("A1r","A2r","h1r","h2r"):
        row = next(i for i,poly in enumerate(system.polys) if set(poly)=={(vars.index(varname),2)} and len(poly)==2)
        const = next(c for m,c in system.polys[row].items() if sum(m)==0)
        rhs=(-const*pow(2 if varname.startswith("h") else 1,-1,prime))%prime
        root=next(r for r in range(prime) if pow(r,2 if varname.startswith("h") else 3,prime)==rhs)
        assignments[varname]=root

    # Pivot sequence using raw source rows named by the claim. This validates their unit-linear property.
    claimed_pivots = [("x71", 26), ("x55", 27), ("x70", 28), ("x53", 10), ("x58", 11),
                      ("x52", 12), ("x47", 13), ("x54", 14)]
    # The first three are direct structural rows; later rows are nonlinear, so verify only explicit
    # zero-based rows 28 and the two compatibility rows here rather than pretending they are affine.
    structural = {"x70": 28}
    for target,index in structural.items():
        assignments,ok=solve_pivot(system,assignments,target,index); result[f"pivot_{target}_row{index}"]=ok

    result["witness_all_raw_rows_zero"] = False
    result["elapsed_seconds"] = time.time()-started
    return result


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--cases", default="cases")
    args = ap.parse_args()
    root=Path(args.cases)
    systems=[root/"d25fam_p105337_a00mm.ms", root/"d25fam_p105673_a00mm.ms"]
    report={"systems":[verify_prime(p) for p in systems]}
    print(json.dumps(report,indent=2))


if __name__=="__main__":
    main()


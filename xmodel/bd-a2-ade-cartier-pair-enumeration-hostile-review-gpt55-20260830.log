The script’s own deep check reports all 72,695 capped nonzero vectors were tested by exact `Fraction` elimination, and its summary reproduces the advertised global totals. I’m now doing a separate stdin-only checker that rebuilds Cartan matrices, finds graph automorphisms by edge preservation, recomputes the multiset DP, and compares the compressed JSON records.
exec
/bin/zsh -lc "python3 - <<'PY'
from fractions import Fraction
import gzip, json, itertools, hashlib, importlib.util
from pathlib import Path
CAP=8
SMALL=4
PATH=Path('xmodel/bd-a2-ade-cartier-pairs-cap8-sol56-20260830.json.gz')

def comps(total, r):
    if r==1:
        yield (total,); return
    for x in range(total+1):
        for tail in comps(total-x, r-1):
            yield (x,)+tail

def edges(kind,r):
    if kind=='A': return tuple((i,i+1) for i in range(r-1))
    return tuple((i,i+1) for i in range(r-2)) + ((r-3,r-1),)

def cartan(kind,r):
    E=set(tuple(sorted(e)) for e in edges(kind,r))
    return tuple(tuple(2 if i==j else (-1 if tuple(sorted((i,j))) in E else 0) for j in range(r)) for i in range(r))

def solve_frac(M,b):
    r=len(b)
    A=[[Fraction(M[i][j]) for j in range(r)] + [Fraction(b[i])] for i in range(r)]
    for c in range(r):
        p=next(i for i in range(c,r) if A[i][c])
        A[c],A[p]=A[p],A[c]
        pv=A[c][c]
        A[c]=[z/pv for z in A[c]]
        for i in range(r):
            if i==c: continue
            q=A[i][c]
            if q:
                A[i]=[x-q*y for x,y in zip(A[i],A[c])]
    return tuple(row[-1] for row in A)

def graph_autos(kind,r):
    E=set(tuple(sorted(e)) for e in edges(kind,r))
    out=[]
    for p in itertools.permutations(range(r)):
        image=set(tuple(sorted((p[i],p[j]))) for i,j in E)
        if image==E:
            # convert image-of-old p to old-at-new convention used by records: vector'[new]=vector[old]
            inv=[None]*r
            for old,new in enumerate(p): inv[new]=old
            out.append(tuple(inv))
    return tuple(sorted(out))

def perm(v,p): return tuple(v[i] for i in p)
def orbit(v,G): return tuple(sorted(set(perm(v,g) for g in G)))
def encode(v,base):
    n=0; place=1
    for x in v:
        n += x*place; place *= base
    return n

def atoms(kind,r):
    out=[]
    for i in range(r):
        for k in range(1,CAP+1):
            v=[0]*r; v[i]=k
            out.append((tuple(v), {'kind':'vertex','vertex':i+1,'order':k}))
    for i,j in edges(kind,r):
        for a in range(1,CAP):
            for b in range(1,CAP-a+1):
                v=[0]*r; v[i]=a; v[j]=b
                out.append((tuple(v), {'kind':'edge','vertices':[i+1,j+1],'orders':[a,b]}))
    return tuple(out)

def dp_for(kind,r,layers):
    base=CAP+1
    codes=[[encode(v,base) for v in layer] for layer in layers]
    D={0:[1]+[0]*CAP}
    atom_meta={}
    for v,meta in atoms(kind,r):
        atom_meta[v]=meta
        w=sum(v); c=encode(v,base)
        for sw in range(CAP-w+1):
            for sc in codes[sw]:
                poly=D.get(sc)
                if poly is None: continue
                tgt=sc+c
                arr=D.setdefault(tgt,[0]*(CAP+1))
                for g,val in enumerate(poly[:sw+1]):
                    if val: arr[g+1]+=val
    return D, atom_meta

payload=json.loads(gzip.decompress(PATH.read_bytes()).decode('utf-8'))
assert payload['schema']=='jc2.ade_cartan_pairs.v1'
assert payload['caps']==[4,8]
assert payload['basis']=='986427df23c30375b6edfd659ba8a6c6139434ab'

all_raw8=all_can8=all_raw4=all_can4=0
all_one_raw8=all_one_can8=all_one_raw4=all_one_can4=0
all_hist8={}; all_hist4={}
candidate8=candidate4=0
report=[]
for entry in payload['types']:
    kind=entry['type']; r=entry['rank']; label=entry['label']
    assert entry['cartan_matrix']==[list(row) for row in cartan(kind,r)]
    assert entry['edges_one_based']==[[i+1,j+1] for i,j in edges(kind,r)]
    G=graph_autos(kind,r)
    assert entry['diagram_group_order']==len(G)
    assert sorted(tuple(x) for x in entry['diagram_group_permutations_zero_based'])==list(G)
    layers=[tuple(comps(w,r)) for w in range(CAP+1)]
    candidate8 += sum(len(layers[w]) for w in range(1,CAP+1))
    candidate4 += sum(len(layers[w]) for w in range(1,SMALL+1))
    D, atom_meta=dp_for(kind,r,layers)
    M=cartan(kind,r)
    raw_by_w=[0]*(CAP+1); can_by_w=[0]*(CAP+1)
    one_raw_by_w=[0]*(CAP+1); one_can_by_w=[0]*(CAP+1)
    by_n={tuple(rec['n']):rec for rec in entry['records']}
    seen=set()
    for w in range(1,CAP+1):
        for n in layers[w]:
            sol=solve_frac(M,n)
            integral=all(x.denominator==1 for x in sol)
            if not integral: continue
            m=tuple(int(x) for x in sol)
            assert all(x>0 for x in m), (label,n,m)
            raw_by_w[w]+=1
            if n in atom_meta: one_raw_by_w[w]+=1
            n_orb=orbit(n,G)
            if n==n_orb[0]:
                can_by_w[w]+=1
                rec=by_n[n]
                seen.add(n)
                assert tuple(rec['m'])==m
                assert rec['diagram_orbit_size']==len(n_orb)
                assert rec['diagram_stabilizer_order']==len(G)//len(n_orb)
                assert rec['under_cap_4']==(w<=SMALL)
                if n in atom_meta: one_can_by_w[w]+=1
                poly=D[encode(n,CAP+1)]
                pg=rec['physical_germs']
                assert pg['count_by_number_of_germs']==poly[1:w+1]
                nz=[i for i,x in enumerate(poly) if x]
                assert pg['minimum_number_of_germs']==nz[0]
                assert pg['maximum_number_of_germs']==nz[-1]==w
                assert pg['total_partition_count']==sum(poly)
                assert (pg['one_germ_contact'] is not None)==(n in atom_meta)
                if n in atom_meta:
                    assert pg['one_germ_contact']==atom_meta[n]
    assert seen==set(by_n)
    assert sum(rec['diagram_orbit_size'] for rec in entry['records'])==sum(raw_by_w)
    assert raw_by_w[1:]==entry['summary']['by_weight']['raw_pairs']
    assert can_by_w[1:]==entry['summary']['by_weight']['canonical_diagram_orbits']
    assert one_raw_by_w[1:]==entry['summary']['by_weight']['raw_one_germ_pairs']
    assert one_can_by_w[1:]==entry['summary']['by_weight']['canonical_one_germ_orbits']
    raw8=sum(raw_by_w); can8=sum(can_by_w); raw4=sum(raw_by_w[:SMALL+1]); can4=sum(can_by_w[:SMALL+1])
    one_raw8=sum(one_raw_by_w); one_can8=sum(one_can_by_w); one_raw4=sum(one_raw_by_w[:SMALL+1]); one_can4=sum(one_can_by_w[:SMALL+1])
    assert entry['summary']['cap_8']['raw_pairs']==raw8
    assert entry['summary']['cap_8']['canonical_diagram_orbits']==can8
    assert entry['summary']['cap_8']['raw_one_germ_pairs']==one_raw8
    assert entry['summary']['cap_8']['canonical_one_germ_orbits']==one_can8
    assert entry['summary']['cap_4']['raw_pairs']==raw4
    assert entry['summary']['cap_4']['canonical_diagram_orbits']==can4
    assert entry['summary']['cap_4']['raw_one_germ_pairs']==one_raw4
    assert entry['summary']['cap_4']['canonical_one_germ_orbits']==one_can4
    for rec in entry['records']:
        g=str(rec['physical_germs']['minimum_number_of_germs'])
        all_hist8[g]=all_hist8.get(g,0)+1
        if rec['weight']<=SMALL: all_hist4[g]=all_hist4.get(g,0)+1
    all_raw8+=raw8; all_can8+=can8; all_raw4+=raw4; all_can4+=can4
    all_one_raw8+=one_raw8; all_one_can8+=one_can8; all_one_raw4+=one_raw4; all_one_can4+=one_can4
    report.append((label,raw8,can8,raw4,can4,one_raw8,one_can8,one_raw4,one_can4))

assert candidate8==72695 and candidate4==3218
assert (all_raw8,all_can8,all_raw4,all_can4)==(16360,12238,772,646)
assert (all_one_raw8,all_one_can8,all_one_raw4,all_one_can4)==(718,563,198,163)
assert all_hist8=={'1':563,'2':4180,'3':5312,'4':1915,'5':268}
assert all_hist4=={'1':163,'2':356,'3':114,'4':13}
print('independent_check=PASS')
print('candidate_vectors cap8/cap4 =', candidate8, candidate4)
print('all_pairs raw/can cap8 =', all_raw8, all_can8)
print('all_pairs raw/can cap4 =', all_raw4, all_can4)
print('one_germ raw/can cap8 =', all_one_raw8, all_one_can8)
print('one_germ raw/can cap4 =', all_one_raw4, all_one_can4)
print('canonical_min_hist cap8 =', dict(sorted(all_hist8.items(), key=lambda kv:int(kv[0]))))
print('canonical_min_hist cap4 =', dict(sorted(all_hist4.items(), key=lambda kv:int(kv[0]))))
print('per_type =', report)

# Check the checked-in script reproduces exact canonical gzip bytes without writing a file.
spec=importlib.util.spec_from_file_location('ade_enum','ops/ade_cartan_pair_enumerate.py')
mod=importlib.util.module_from_spec(spec); spec.loader.exec_module(mod)
logical=mod.canonical_json(mod.build_payload()).encode('utf-8')
artifact=gzip.compress(logical, compresslevel=9, mtime=0)
existing=PATH.read_bytes()
assert artifact==existing
print('producer_rebuild_bytes=PASS', len(artifact), hashlib.sha256(artifact).hexdigest(), len(logical), hashlib.sha256(logical).hexdigest())
print('gzip_header_mtime=', int.from_bytes(existing[4:8],'little'), 'os_byte=', existing[9])

def exists_embedding(edges, r, limit=1):
  adj=[[False]*r for _ in range(r)]
  for a,b in edges: adj[a][b]=adj[b][a]=True
  # order vertices by descending degree, preserving placed-neighbor expansion
  deg=[sum(row) for row in adj]
  order=[]; used=set(); frontier=[max(range(r), key=lambda i: deg[i])]
  while len(order)<r:
    if not frontier:
      frontier=[max([i for i in range(r) if i not in used], key=lambda i: deg[i])]
    v=frontier.pop(0)
    if v in used: continue
    used.add(v); order.append(v)
    nbrs=sorted([u for u in range(r) if adj[v][u] and u not in used], key=lambda u:-deg[u])
    frontier=nbrs+frontier
  placed={}
  # fix first root by Weyl transitivity
  placed[order[0]]=tuple([1,-1]+[0]*(N-2))

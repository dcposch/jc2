from itertools import product
from fractions import Fraction

N=9
roots=[]
for i in range(N):
  for j in range(i+1,N):
    for si in (1,-1):
      for sj in (1,-1):
        v=[0]*N; v[i]=si; v[j]=sj; roots.append(tuple(v))
# include both signs already present by sign choices
assert len(roots)==144

def dot(a,b): return sum(x*y for x,y in zip(a,b))

def rank(vs):
  A=[[Fraction(x) for x in v] for v in vs]
  m=len(A); n=N; r=0
  for c in range(n):
    piv=None
    for i in range(r,m):
      if A[i][c]: piv=i; break

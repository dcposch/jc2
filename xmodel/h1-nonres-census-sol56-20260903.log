   418	# ===========================================================================
   419	# PART 2.  the integration-#17 programme, rerun on the (1)-(13) space
   420	# ===========================================================================
   421	#   D1-PIN (integration #17 A.3):  N = sum_B V_2(B) q(B),  sum_B V_2(B) <= u,
   422	#   q = (1-delta_1) d e/(d+e).  Group = (m, M_2..M_s, V_s): V_s is the only global
   423	#   datum (the multiplicity split of the top form); V_{s-1..2} are per-branch.
   424	NLO, NHI = 6, 16          # integration #17 A.8: the frontier floor N >= 6; H2 window [6,16]
   425	
   426	def groups_of(n, full=True, Kmin=16):
   427	    """{(m, Ms, V_s): [(V_2, q, u), ...]} over the admissible V-assignments."""
   428	    G = {}
   429	    for (m, Ms, V) in census(n, Kmin=Kmin, full=full):
   430	        S = Skel(n, m, list(Ms), V)
   431	        G.setdefault((m, Ms, S.V[S.s]), []).append((S.V[2], S.q(), S.u))
   432	    return G
   433	
   434	def uni_hits(items, Nlo=NLO, Nhi=None):
   435	    """(UNI): one Galois orbit of bottom discs.  N = k V_2 q with k V_2 <= u."""
   436	    out = set()
   437	    for (v, q, u) in items:
   438	        for k in range(1, int(u)//v + 1):
   439	            val = k*v*q
   440	            if val.denominator == 1 and val >= Nlo and (Nhi is None or val <= Nhi):
   441	                out.add(int(val))
   442	    return out
   443	
   444	def mixed_hit(items, Nlo=NLO, Nhi=NHI, CAP=60000):
   445	    """no (UNI): N = sum_B V_2(B) q(B), sum V_2(B) <= u.  Exact knapsack over
   446	       Fractions, pruned to partial sums <= Nhi.  CAP -> UNDECIDED (counted alive)."""
   447	    u = int(items[0][2])
   448	    cand = sorted(set((v, q) for (v, q, _) in items if v*q <= Nhi))
   449	    layer = {0: {F(0)}}; capped = False
   450	    for tv in range(0, u+1):
   451	        if tv not in layer: continue
   452	        for s0 in list(layer[tv]):
   453	            for (v, q) in cand:
   454	                if tv+v > u: continue
   455	                s1 = s0 + v*q
   456	                if s1 > Nhi: continue
   457	                tgt = layer.setdefault(tv+v, set())
   458	                if len(tgt) >= CAP: capped = True; continue
   459	                tgt.add(s1)
   460	                if s1.denominator == 1 and Nlo <= s1 <= Nhi: return True, capped
   461	    return False, capped
   462	
   463	def rerun(dlo=48, dhi=120, full=True, Kmin=16, listing=(105,108,112,117,120), do_mixed=True):
   464	    tag = "(1)-(13)" if full else "(1)-(7)"
   465	    print("\n== INTEGRATION-#17 RERUN on the %s space, %d <= D <= %d ==" % (tag, dlo, dhi))
   466	    print("   %5s %9s %9s %9s %9s %9s %9s %9s" % ("D", "V-assign", "groups",
   467	          "uni N>=6", "uni[6,16]", "mix[6,16]", "capped", "wall"))
   468	    T = dict(a=0, g=0, u1=0, u2=0, mx=0, cap=0); empty = []; surv = {}
   469	    for n in range(dlo, dhi+1):
   470	        t0 = time.time(); G = groups_of(n, full=full, Kmin=Kmin)
   471	        na = sum(len(v) for v in G.values())
   472	        if not G: continue
   473	        a1 = a2 = am = cp = 0; alive = []
   474	        for key, items in G.items():
   475	            h1 = bool(uni_hits(items, NLO, None))
   476	            h2 = bool(uni_hits(items, NLO, NHI))
   477	            if do_mixed: hm, c = mixed_hit(items)
   478	            else:        hm, c = h2, False
   479	            a1 += h1; a2 += h2; am += (hm or c); cp += c
   480	            if hm or c: alive.append((key, items, c))
   481	        T['a'] += na; T['g'] += len(G); T['u1'] += a1; T['u2'] += a2
   482	        T['mx'] += am; T['cap'] += cp
   483	        if am == 0: empty.append(n)
   484	        if n in listing: surv[n] = alive
   485	        print("   %5d %9d %9d %9d %9d %9d %9d %8.1fs"
   486	              % (n, na, len(G), a1, a2, am, cp, time.time()-t0)); sys.stdout.flush()
   487	    print("   ---- totals %d <= D <= %d ----" % (dlo, dhi))
   488	    print("   V-assignments %d ; groups %d" % (T['a'], T['g']))
   489	    print("   (UNI) alive with an integer N >= 6            : %d  (killed %d)"
   490	          % (T['u1'], T['g']-T['u1']))
   491	    print("   (UNI) alive with an integer N in [6,16]       : %d  (killed %d)"
   492	          % (T['u2'], T['g']-T['u2']))
   493	    print("   mixed (no (UNI)) alive in [6,16]              : %d  (killed %d, capped %d)"
   494	          % (T['mx'], T['g']-T['mx'], T['cap']))
   495	    print("   degrees D with EVERY group killed             : %s" % (empty if empty else "NONE"))
   496	    return T, empty, surv

from math import gcd

def chau_triples(n):
    out=[]
    for L in range(2,n+1):
        if n%L: continue
        M=n//L
        for c in range(1,L):
            if gcd(c,L)==1:
                out.append((M,L,c))
                out.append((M,c,L))
    return out

def cusp_pairs(max_delta, ordered=False):
    out=[]
    # bound: (p-1)(q-1)/2 <= max_delta; p,q>=2 => each <= 2max_delta+1
    B=2*max_delta+2
    for p in range(2,B+1):
        for q in range(2,B+1):
            if gcd(p,q)"'!=1: continue
            if not ordered and p>q: continue
            if not ((p%2==0 and q%3==0) or (p%3==0 and q%2==0)): continue
            delta=(p-1)*(q-1)//2
            if (p-1)*(q-1)%2: raise Exception('"'nonint')
            if delta<=max_delta:
                out.append((p,q,delta))
    return sorted(set(out), key=lambda x:(x[2],x[0],x[1]))
for n in range(3,9):
    pa=(n-1)*(n-2)//2
    print('n',n,'pa',pa)
    print(' triples', chau_triples(n))
    pairs=cusp_pairs(pa-1, ordered=False) if pa>=1 else []
    print(' pairs δ<=pa-1', pairs)
    print()

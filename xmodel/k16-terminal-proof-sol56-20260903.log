        "t": t,
        "H": str(algebra.H),
        "d": str(d),
        "normalizer": {"g1": str(g1), "g2": str(g2), "g3": str(g), "c": str(c)},
        "b1_divisibility_pivot": {
            "coefficient": str(b1_coefficient), "inverse": str(b1_inverse),
            "rhs": str(b1_rhs),
        },
        "B0_gauge_pivot": {
            "coefficient": str(B0_coefficient), "inverse": str(B0_inverse),
            "rhs": str(B0_rhs),

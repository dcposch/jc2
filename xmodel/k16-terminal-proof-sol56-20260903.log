+        answer.append(int(expr.subs({symbols[key]: value
+                                     for key, value in point.items()})) % prime)
+    return answer
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--t", type=int, nargs="*", default=list(range(2, 7)))

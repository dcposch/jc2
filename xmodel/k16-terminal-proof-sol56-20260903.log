+  "schema": 1,
+  "verdict": "PARTIAL",
+  "all_t_claim": "OPEN: neither TOP-TAIL-UNIT nor RESIDUAL-ZERO is proved uniformly",
+  "uniform_results": {
+    "terminal_formula": "PROVED coefficient-array recurrence for every integer t>=2",
+    "high_pivots": "consumed from charged proved Laurent spine; resultants and specialization roots re-audited",
+    "residual_b3_axis": "PROVED unit-times-b3^2 for every integer t>=3",
+    "residual_q2_axis": "PROVED indexed scalar recurrence; final norm factorization OPEN",
+    "top_tail": "OPEN[TOP-TAIL-DETERMINANT-RECURRENCE]"
+  },
+  "fixed_characteristic_zero": {

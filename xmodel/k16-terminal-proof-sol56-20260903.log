    27	
    28	
    29	# Laurent/Euler spine constants.
    30	g1 = e / q
    31	g2 = e * y / q + e * t / (2 * q**2)
    32	g = e * t * y / q**2 - e * t * (t + 1) / (6 * q**3)
    33	
    34	# On the b3-axis, weighted homogeneity leaves
    35	# C=h^(t-1), U=h^q+a*b3*h^t, T=g2*h^t, and
    36	# S=g1*h^(2t)+Db*b3*h^(t-1).
    37	Db = g * (6 * a * t + 5 * t + 2) / (2 * y * (2 * t - 1))
    38	K = Db - g2
    39	
    40	# If P0'=e*h^(3t)+X1*b3*h^(2t-1)+X2*b3^2*h^(t-2), direct
    41	# coefficient extraction from its numerator gives these two scalars.
    42	X1 = (K + y * e - 2 * q * g + 2 * a * t * g2) / (2 * y)
    43	X2 = t * (y * K - 2 * a * g) / (2 * y)
    44	
    45	# The sole surviving high row is [h^(3t)]R/b3.  It solves q_{t+1,0}=a*b3.
    46	high = X1 - y * e - q * K - a * t * g1
    47	a_closed = -(6 * d * t - 3 * d + 9 * t**2 + 2 * t - 1) / (6 * t * (3 * t - 1))
    48	assert numerator_mod_d(high.subs({a: a_closed, y: y_from_d})) == 0
    49	
    50	# The top residual row is [h^(2t-1)]R/b3^2.
    51	top = X2 - y * X1 - a * t * K
    52	A = 27 * t**3 - 30 * t**2 + t - 2
    53	B = 6 * t**3 + 13 * t**2 - 3 * t + 2
    54	lambda_closed = t * (3 * t + 1) * (A * d + B) / (
    55	    12 * q**2 * (3 * t - 1) ** 2 * (3 * t + 2)
    56	)
    57	assert numerator_mod_d(
    58	    (top - lambda_closed).subs({a: a_closed, y: y_from_d})
    59	) == 0
    60	
    61	# Unit check in A_t=Q[y]/(H_t): resultant of the primitive linear class.
    62	H = 12 * q**2 * y**2 - 12 * q * (t + 1) * y + (t + 1) * (3 * t + 2)
    63	linear_y = sp.expand(A * (2 * q * y - (t + 1)) + B)
    64	resultant = sp.factor(sp.resultant(H, linear_y, y))
    65	resultant_closed = -4 * q**2 * (t - 2) * (3 * t - 1) ** 2 * (3 * t + 2) * (
    66	    27 * t**3 + 17 * t**2 + t + 2
    67	)
    68	assert sp.factor(resultant - resultant_closed) == 0
    69	
    70	payload = {
    71	    "typing": "exact symbolic b3-axis identity audit; not a full-ideal proof",
    72	    "axis_high_solution_a": str(sp.factor(a_closed)),
    73	    "stored_R_top_coefficient": str(sp.factor(lambda_closed)) + "*b3^2",
    74	    "primitive_resultant_with_H_t": str(resultant),
    75	    "assertions": {
    76	        "high_row_vanishes_mod_3d2_minus_t_plus_1": True,
    77	        "top_coefficient_matches_mod_3d2_minus_t_plus_1": True,
    78	        "resultant_factorization_matches": True,
    79	    },
    80	    "exception_note": "For positive integer t, the resultant vanishes only at t=2.",
    81	}
    82	
    83	if __name__ == "__main__":
    84	    output = Path(__file__).with_name("residual_b3_axis_exact_audit.json")
    85	    output.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    86	    print(json.dumps(payload, indent=2))

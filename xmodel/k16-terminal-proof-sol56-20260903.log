416256025)*q3_0^2*q5_0^2+(7281945644582718361296/23095675041100715472575*yy-31221360241528375184112/300243775534309301143475)*q2_0*q4_0*q5_0^2+(-1249675317888/693609356375*yy+5408751670336/9016921632875)*b4*q5_0^3+(-285246936084/272757302077*yy+939679737073/3545844927001)*b3^2*q2_0+(-769837799036502/1036707672516815*yy+257004406186038/1036707672516815)*b3*q4_0*q5_0

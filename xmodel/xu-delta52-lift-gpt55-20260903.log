+    nonempty = sp.groebner([c - 1, t * c - 1], c, t, order="lex")
+    empty_unit = any(g.as_expr() == 1 for g in empty.polys)
+    nonempty_unit = any(g.as_expr() == 1 for g in nonempty.polys)

+        num = 5 * j - power
+        if num % 2:
+            continue
+        i = num // 2
+        if i >= 0 and i + j <= 11:
+            out.append(j)
+    return out
+
+
+def symbols(prefix: str, count: int) -> tuple[sp.Symbol, ...]:
+    return tuple(sp.Symbol(f"{prefix}_{i}") for i in range(count))
+
+
+@dataclass
+class LocalLift:
+    max_order: int = 4
+    q_degree_cap: int = 18
+
+    def run(self) -> dict[str, Any]:

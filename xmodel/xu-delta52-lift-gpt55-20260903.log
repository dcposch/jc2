+                        "s_power": order,
+                        "equations": len(equations),
+                        "new_variables": [str(v) for v in newvars],
+                        "verdict": "INCONSISTENT_OR_BRANCH_NEEDED",
+                    }
+                )
+                return {
+                    "verdict": "STOPPED",
+                    "stop_order": order,
+                    "orders": order_records,
+                }

+        "q1": sp.expand(q1),
+        "degree_q1": sp.degree(q1, pi),
+        "q1_prime_plus_2p3": sp.factor(sp.diff(q1, pi) + 2 * p**3),
+        "Ds_check": reduced,
+        "verdict": "PASS" if reduced == 0 else "FAIL",
+    }

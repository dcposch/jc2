+            equations = [sp.expand(e) for e in coeff.all_coeffs() if e != 0]
+
+            newvars: list[sp.Symbol] = []
+            if hp >= 0:
+                newvars.extend(sorted(h_terms[hp].free_symbols, key=str))
+            if qp >= 1:
+                newvars.extend(sorted(q_terms[qp].free_symbols, key=str))

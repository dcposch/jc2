+        free_set = sorted({v for v in free_symbols if v not in substitutions}, key=str)
+        denom_factors = set()
+        for value in substitutions.values():
+            den = sp.factor(sp.denom(sp.together(value)))
+            if den != 1:
+                denom_factors.add(str(den))

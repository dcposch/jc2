+        [
+            v
+            for v in expr.free_symbols
+            if any(str(v).startswith(prefix) for prefix in prefixes)
+        ],
+        key=str,
+    )
+
+
+@dataclass
+class LocalLift:
+    max_order: int = 4
+    q_degree_cap: int = 18
+

+def delta_7_3_control() -> dict[str, Any]:
+    """Xu's non-exception branch, checked for delta=7/3 after q=p^13(pi-d)."""
+    d, k, rab = sp.symbols("d k T")
+    p = p_poly()
+    pp = sp.diff(p, pi)
+    delta = sp.Rational(7, 3)

+            "equation": "D_s(Q,h)+2*s^2*h^4=0",
+            "s_relation": "s^2=t",
+            "h_leader": "p(pi)/s",
+            "q_leader": "q1(pi)",
+            "q_degree_cap_each_new_B": self.q_degree_cap,
+            "h_support_rule": "x=s^-2, y=pi*s^5, deg h<=11, exponent=5*j-2*i",

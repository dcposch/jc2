+        }
+
+
+def main() -> None:
+    RESULTS.mkdir(parents=True, exist_ok=True)
+    data = {
+        "reduced_ode": reduced_ode_check(),
+        "wrapper_controls": wrapper_controls(),
+        "controls": {
+            "delta_2_three_simple_roots": delta_2_three_root_control(),
+            "delta_7_3": delta_7_3_control(),

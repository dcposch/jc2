+                    for v in generated_symbols(h_terms[hp], (f"a{hp}_",))
+                    if v in substitutions
+                }
+
+            order_records.append(
+                {
+                    "s_power": order,
+                    "pi_equations": len(equations),
+                    "new_variable_count": len(newvars),

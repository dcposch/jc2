+        "a_T3_exponent": a,
+        "b_g_exponent": b,
+        "reduced_polynomial": reduced,
+        "coefficient_equations": coeffs,
+        "saturation": "c != 0 via T*c-1",
+        "groebner_basis": [g.as_expr() for g in sat.polys],
+        "verdict": "EXCLUDED" if unit else "NOT_EXCLUDED",

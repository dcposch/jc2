/bin/bash -lc "python3 - <<'PY'
import sympy as sp
s, pi, c=sp.symbols('s pi c')
p=pi*(pi**2-c)
q1=sp.integrate(-2*p**3, pi)
print('q1=', sp.expand(q1))
print('deg', sp.degree(q1, pi))
D=lambda A,B: sp.diff(A,s)*sp.diff(B,pi)-sp.diff(A,pi)*sp.diff(B,s)
print('reduced=', sp.factor(D(q1, p/s)+2*s**2*(p/s)**4))
# corrections
A0=sp.Function('A0')(pi); A1=sp.Function('A1')(pi); A2=sp.Function('A2')(pi)
B1=sp.Function('B1')(pi); B2=sp.Function('B2')(pi)
h=p/s + A0 + A1*s + A2*s**2
Q=q1+B1*s+B2*s**2
E=sp.expand(D(Q,h)+2*s**2*h**4)
for power in [-2,-1,0,1]:
    coeff=sp.expand(E.coeff(s,power))
    print('s"'^'"',power,':', sp.factor(coeff))

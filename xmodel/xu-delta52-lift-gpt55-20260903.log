import sympy as sp
s,pi,c=sp.symbols('s pi c')
p=pi*(pi**2-c); q1=sp.integrate(-2*p**3,pi)

def h_support(r):
    supp=[]
    for j in range(0,12):
        num=5*j-r
        if num%2: continue
        i=num//2
        if i<0: continue
        if i+j<=11:
            supp.append(j)
    return supp
print({r:h_support(r) for r in range(0,8)})
D=lambda A,B: sp.diff(A,s)*sp.diff(B,pi)-sp.diff(A,pi)*sp.diff(B,s)
subs={}
free=[]
A={-1:p}
B={0:q1}
# pre-create by order
for k in range(-1,5):
    rA=k+1; rB=k+2
    # create A_r if absent
    if rA>=0 and rA not in A:
        terms=[]
        for j in h_support(rA):
            sym=sp.symbols(f'a{rA}_{j}')
            terms.append(sym*pi**j)
        A[rA]=sum(terms) if terms else sp.Integer(0)
    if rB>=1 and rB not in B:
        maxdeg=18
        syms=sp.symbols(' '.join(f'b{rB}_{j}' for j in range(maxdeg+1)))
        B[rB]=sum(syms[j]*pi**j for j in range(maxdeg+1))
# iterative
for k in range(-1,5):
    h=sum(A[r]*s**r for r in A if r<=k+1) # include new A
    Q=sum(B[r]*s**r for r in B if r<=k+2)
    E=sp.together(D(Q,h)+2*s**2*h**4).expand().subs(subs)
    coeff=sp.Poly(sp.expand(E.coeff(s,k)), pi)
    eqs=[sp.expand(e) for e in coeff.all_coeffs() if e"'!=0]
    newvars=[]
    rA=k+1; rB=k+2
    if rA>=0:
        newvars += sorted([v for v in A[rA].free_symbols if str(v).startswith(f'"'a{rA}_')], key=str)
    if rB>=1:
        newvars += sorted([v for v in B[rB].free_symbols if str(v).startswith(f'b{rB}_')], key=str)
    newvars=[v for v in newvars if v not in subs]
    print('\\norder',k,'eqs',len(eqs),'newvars',len(newvars),'A supp',h_support(rA) if rA>=0 else None)
    sol=sp.solve(eqs, newvars, dict=True, simplify=False, rational=False)
    print('solutions',len(sol))
    if not sol:
        print('failed')
        break
    sol0=sol[0]
    # choose solution; free new vars absent -> keep free
    print('solved',len(sol0),'free_new',len(newvars)-len(sol0))
    # Display A part
    for v in newvars:
        if v in sol0 and str(v).startswith('a'):
            print(v,'=',sp.factor(sol0[v]))
    subs.update(sol0)
    free += [v for v in newvars if v not in sol0]
print('\\nfree count',len(set(free)-set(subs)))
print('free', sorted(map(str,set(free)-set(subs)))[:50])

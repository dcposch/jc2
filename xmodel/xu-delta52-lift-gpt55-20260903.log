+        for order in range(-1, self.max_order + 1):
+            hp = order + 1
+            qp = order + 2
+            h = sp.Add(*(expr * s**r for r, expr in h_terms.items() if r <= hp))
+            q = sp.Add(*(expr * s**r for r, expr in q_terms.items() if r <= qp))

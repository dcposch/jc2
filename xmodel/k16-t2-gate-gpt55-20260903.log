     1	#!/usr/bin/env python3
     2	"""Moh p.208 (16,12;13,3;X) order-chart saturation control.
     3	
     4	Moh prints the chart but not its final elimination.  To avoid relying on the
     5	apparent repeated-c5 typo in alpha_3, this driver gives the A and B terms
     6	independent coefficients, hence tests a (slightly) larger chart.  Emptiness of
     7	this larger c!=0 component is a valid positive control.
     8	"""
     9	
    10	import argparse
    11	import sympy as sp
    12	
    13	
    14	x, y = sp.symbols("x y")
    15	
    16	
    17	def jac(f, g):
    18	    return sp.diff(f, x) * sp.diff(g, y) - sp.diff(f, y) * sp.diff(g, x)
    19	
    20	
    21	def build():
    22	    b1, b2, b3, b4 = bs = sp.symbols("b1:5")
    23	    z = y - x
    24	    B = sp.expand(y * z + b1 * y + b2)
    25	    A = sp.expand(y * B + b3)
    26	    h = sp.expand(y * A + b4)
    27	    u = sp.symbols("u1:15")
    28	    (u1, u2, u3, u4, u5, u6, u7,
    29	     u8, u9, u10, u11, u12, u13, u14) = u
    30	    c = sp.Symbol("c")
    31	
    32	    alpha = {
    33	        1: u1,
    34	        2: u2 * A + u3,
    35	        3: u6 * A + u7 * B + u8,
    36	        4: u12 * A + u13 * B + u14 * z,
    37	    }
    38	    beta = {2: u4 * A + u5, 3: u9 * A + u10 * B + u11}
    39	    q_terms = [(sp.Integer(1), 3)] + [(beta[i], 3 - i) for i in (2, 3)]
    40	    p_terms = [(sp.Integer(1), 4)] + [(alpha[i], 4 - i) for i in (1, 2, 3, 4)]
    41	
    42	    by_power = {}
    43	    for aa, r in q_terms:
    44	        for bb, s in p_terms:
    45	            v = jac(aa, bb)
    46	            if v:
    47	                by_power[r + s] = by_power.get(r + s, 0) + v
    48	            v = s * bb * jac(aa, h) + r * aa * jac(h, bb)
    49	            if v:
    50	                by_power[r + s - 1] = by_power.get(r + s - 1, 0) + v
    51	
    52	    k = 0
    53	    while k <= max(by_power):
    54	        quotient, remainder = sp.div(sp.expand(by_power.get(k, 0)), h, y)
    55	        by_power[k] = sp.expand(remainder)
    56	        if quotient != 0:
    57	            by_power[k + 1] = by_power.get(k + 1, 0) + quotient
    58	        k += 1
    59	
    60	    equations = []
    61	    for hp in sorted(by_power):
    62	        r = by_power[hp] - (c * x if hp == 0 else 0)
    63	        equations.extend(co for _, co in sp.Poly(sp.expand(r), x, y).terms() if co != 0)
    64	    return list(bs) + list(u), c, equations, h
    65	
    66	
    67	def singular(expr):

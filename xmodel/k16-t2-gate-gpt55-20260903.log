+    # root imposes no additional exclusions among these five generators.
+    major_order = [
+        (one, F(0)),
+        (a_poly, F(-3, 7)),
+        (b_poly, F(-5, 7)),
+        (z, F(-1)),
+        (gamma, F(-1)),

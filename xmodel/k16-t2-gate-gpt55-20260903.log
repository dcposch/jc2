+    beta_spaces = {i: list(spaces[i]) for i in range(2, 6)}
+    # Safe target gauges: alpha_2=0, scalar(beta_5)=0, scalar(alpha_7)=0.
+    alpha_spaces[2] = []
+    beta_spaces[5] = beta_spaces[5][1:]
+    alpha_spaces[7] = alpha_spaces[7][1:]

+    terms = []
+    for j, base in enumerate(basis):
+        var = sp.Symbol(f"{prefix}{idx}_{j}")
+        params.append(var)
+        terms.append(var * base)
+    return sp.Add(*terms) if terms else sp.Integer(0)
+
+

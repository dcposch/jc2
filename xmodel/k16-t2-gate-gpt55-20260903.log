+        "m": m,
+        "M2": M2,
+        "V2": V2,
+        "e": e,
+        "q": q,
+        "phi": (phi2, phi1),
+        "bound": F(-1, 7),
+    }
+
+
+def basis_spaces(one, z, b_poly, a_poly):

index 0000000000000000000000000000000000000000..77169c803f89cd4a58835476303fa965ff642aec
--- /dev/null
+++ b/box/g9966Bgate-20260903/run_delta2_stage.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ $# -ne 1 ]]; then
+  echo "usage: $0 STAGE" >&2
+  exit 2
+fi
+
+stage="$1"
+case "$stage" in
+  ''|*[!0-9]*)
+    echo "stage must be a nonnegative integer" >&2
+    exit 2
+    ;;
+esac
+
+cd "$(dirname "$0")/../.."
+
+outdir="box/g9966Bgate-20260903/runs/delta2"
+mkdir -p "$outdir"
+
+emit_args=()
+if [[ "$stage" == "4" ]]; then
+  emit_args=(--emit-singular "$outdir/stage4.sing")
+fi
+
+env \
+  OPENBLAS_NUM_THREADS=1 \
+  OMP_NUM_THREADS=1 \
+  MKL_NUM_THREADS=1 \
+  NUMEXPR_NUM_THREADS=1 \
+  timeout 2400 \
+  /usr/bin/time -v \
+  python3 box/g9966band-20260903/band_engine.py \
+    --branch delta2 \
+    --stage "$stage" \
+    "${emit_args[@]}" \
+    > "$outdir/stage${stage}.json" \
+    2> "$outdir/stage${stage}.time"

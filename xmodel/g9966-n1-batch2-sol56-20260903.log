   413	def ab_build_spec(row: RowSpec, part: Sequence[int]) -> BuildSpec:
   414	    C = shape_for(row)
   415	    if not (C["dprime"] == 2 and C["eprime"] == 3):
   416	        raise ValueError("%s is not a d'=2,e'=3 A/B chart" % row.source)
   417	    if tuple(part) not in allowed_partitions(row):
   418	        raise ValueError("%s partition %s outside Prop. 4.6 cap" % (row.source, part))
   419	    top, slopes, top_factored, omega = top_face_expr(row, part, "a")
   420	    h_lower = list(C["h_lower"])


   503	              % ("n","m","M_2..M_s","V_s","K","(d,e)","u","V_2 (per branch)","q (per branch)","achievable N"))
   504	        for (key, items, capped) in sorted(surv[n]):
   505	            (m, Ms, Vs) = key
   506	            K = gcd(n, m); e = n//K; dd = m//K
   507	            V2s = sorted(set(v for (v,_,_) in items)); qs = sorted(set(q for (_,q,_) in items))
   508	            Ns = sorted(uni_hits(items, NLO, NHI))
   509	            print("      %4d %4d %-18s %4d %4d %6s %6s %-24s %-22s %s%s"
   510	                  % (n, m, str(list(Ms)), Vs, K, "(%d,%d)"%(dd,e), str(items[0][2]),
   511	                     str(V2s)[:24], str([str(q) for q in qs])[:22], Ns,
   512	                     "  [CAPPED]" if capped else ""))

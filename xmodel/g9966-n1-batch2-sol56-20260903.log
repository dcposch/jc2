   129	    # --- skeleton (99,66): M,V,d,delta,(12)/(13) ---
   130	    n, m = 99, 66
   131	    M = {1: -66, 2: 77, 3: 97}
   132	    d = {1: 99, 2: 33, 3: 11, 4: 1}
   133	    V = {2: 8, 3: 8, 4: 1}
   134	    s = 3
   135	
   136	    def delta(i: int) -> F:
   137	        num, den = F(n - M[i]), F(n - M[s] - 1)
   138	        for j in range(i + 1, s + 1):
   139	            num *= V[j] * (n - M[j]) - d[j]
   140	            den *= V[j] * (n - M[j - 1]) - d[j]
   141	        return 1 - num / den
   142	
   143	    deltas = {i: delta(i) for i in (1, 2, 3)}
   144	    assert deltas[3] == -1 and deltas[2] == F(1, 3) and deltas[1] == F(4, 9)
   145	    u3 = d[3] - V[3]
   146	    assert u3 == 3
   147	    # (12)/(13)
   148	    L1 = 1
   149	    for i in (2, 3):
   150	        L1 = L1 * deltas[i].denominator // gcd(L1, deltas[i].denominator)
   151	    A1 = (L1 * deltas[1]).denominator
   152	    ns, ms, V2 = n // d[2], m // d[2], V[2]
   153	    b12 = (ns * V2 % A1 == 0) and ((ms * V2 - 1) % A1 == 0)
   154	    b13 = (ms * V2 % A1 == 0) and ((ns * V2 - 1) % A1 == 0)
   155	    out["skeleton"] = {
   156	        "d": [99, 33, 11, 1],
   157	        "u3": 3,
   158	        "v3": 8,
   159	        "deltas": {str(k): str(v) for k, v in deltas.items()},
   160	        "A1": A1,
   161	        "n_star": ns,
   162	        "m_star": ms,
   163	        "cond12": b12,
   164	        "cond13": b13,
   165	        "minor_threshold_d3_over_n_M3": str(F(d[3], n - M[3])),
   166	        "V3_is_major": V[3] > d[3] / (n - M[3]),
   167	        "u3_is_minor": u3 <= d[3] / (n - M[3]),
   168	    }
   169	    assert b12 and not b13
   170	    assert V[3] > 11 / 2 and u3 <= 11 / 2
   171	
   172	    # multiplicities
   173	    out["multiplicities"] = {
   174	        "g_Moh_F_chart_minor": 99 * 3 // 11,  # 27
   175	        "f_Moh_G_chart_minor": 66 * 3 // 11,  # 18
   176	        "T2": 55 * 3 // 11,  # 15
   177	        "T3": (145 - 2) * 3 // 11 + 1,  # 40
   178	        "g_major": 99 * 8 // 11,  # 72
   179	        "f_major": 66 * 8 // 11,  # 48
   180	    }
   181	    assert out["multiplicities"]["f_Moh_G_chart_minor"] == 18
   182	    assert out["multiplicities"]["g_Moh_F_chart_minor"] == 27
   183	
   184	    # Thm 1.2 vs design rephrase: ord h_j >= (lambda/d)*j, with lambda = d*ord h
   185	    # D2 h3: ord=-1/3; D1 h2: ord=-1/9
   186	    out["thm12_orders"] = {
   187	        "printed": "ord h_j(sigma_i) >= (lambda/d)*j  (Moh p.149)",
   188	        "design_rephrase": "ord Q_j >= j * ord h  iff  ord h = lambda/d",
   189	        "D2_h3": {"ord_h3": str(F(-1, 3)), "F_j_bound": ">= -j/3"},
   190	        "D1_h2": {
   191	            "ord_h2": str(F(-1, 9)),
   192	            "A2": str(F(-2, 9)),
   193	            "A3": str(F(-1, 3)),
   194	            "B1": str(F(-1, 9)),
   195	            "B2": str(F(-2, 9)),
   196	        },
   197	        "no_h3_at_D1": "F-multiplicity 24 is not divisible by 9",
   198	    }
   199	    assert 24 % 9 != 0

   105	def load_module(path: Path, name: str):
   106	    spec = importlib.util.spec_from_file_location(name, path)
   107	    if spec is None or spec.loader is None:
   108	        raise RuntimeError("cannot load %s" % path)
   109	    module = importlib.util.module_from_spec(spec)
   110	    sys.modules[name] = module
   111	    spec.loader.exec_module(module)
   112	    return module

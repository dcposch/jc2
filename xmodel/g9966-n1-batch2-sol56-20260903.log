    68	def sha256_file(path: Path) -> str:
    69	    digest = hashlib.sha256()
    70	    with path.open("rb") as handle:
    71	        for block in iter(lambda: handle.read(1 << 20), b""):
    72	            digest.update(block)
    73	    return digest.hexdigest()

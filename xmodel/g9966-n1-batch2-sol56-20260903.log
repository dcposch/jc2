   285	        if degree == 1:
   286	            tower[degree] = prefix
   287	        elif degree == 2:
   288	            tower[degree] = sp.expand(factor * tower[degree - 1] + params[0] * y + params[1])
   289	        else:
   290	            tower[degree] = sp.expand(factor * tower[degree - 1] + params[degree - 1])
   291	    return {"face": face, "params": params, "tower": tower, "weights": weights, "h": tower[C["K"]]}

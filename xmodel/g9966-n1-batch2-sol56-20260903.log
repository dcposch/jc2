   160	def corrected_h_lower(C: dict) -> list[tuple[int, int]]:
   161	    delta1: F = C["delta1"]
   162	    bound = C["V2"] * C["delta1"] + C["u"] * C["delta2"]
   163	    out = []
   164	    for j in range(C["K"], -1, -1):
   165	        for i in range(0, C["u"] + 1):
   166	            if i + j >= C["K"]:
   167	                continue
   168	            if -F(i, 1) + delta1 * F(j, 1) >= bound:
   169	                out.append((i, j))
   170	    return out
   171	
   172	
   173	def coefficient_monomials(C: dict, deficit: int, *, beta: bool = False) -> list[tuple[int, int]]:
   174	    delta1: F = C["delta1"]
   175	    bound = C["V2"] * C["delta1"] + C["u"] * C["delta2"]
   176	    threshold = deficit * bound
   177	    max_x = C["k"] + 1 if beta else None
   178	    out = []
   179	    for b in range(C["K"] - 1, -1, -1):
   180	        maxa = math.floor(delta1 * F(b, 1) - threshold)
   181	        if max_x is not None:
   182	            maxa = min(maxa, max_x)
   183	        for a in range(0, maxa + 1):
   184	            if a + b <= deficit * C["K"]:
   185	                out.append((a, b))
   186	    return out
   187	
   188	
   189	def singular_power(base: str, exponent: int) -> str:
   190	    if exponent == 0:
   191	        return "1"
   192	    if exponent == 1:
   193	        return base
   194	    return "%s^%d" % (base, exponent)
   195	
   196	
   197	def xy_monomial(a: int, b: int) -> str:
   198	    parts = []
   199	    if a:
   200	        parts.append(singular_power("x", a))
   201	    if b:
   202	        parts.append(singular_power("y", b))
   203	    return "*".join(parts) if parts else "1"
   204	
   205	
   206	def coeff_poly_terms(prefix: str, index: int | None, mons: Sequence[tuple[int, int]]) -> tuple[str, list[str]]:
   207	    terms = []
   208	    names = []
   209	    for a, b in mons:
   210	        if index is None:
   211	            name = "%s_%d_%d" % (prefix, a, b)
   212	        else:
   213	            name = "%s%d_%d_%d" % (prefix, index, a, b)
   214	        names.append(name)
   215	        mon = xy_monomial(a, b)
   216	        terms.append(name if mon == "1" else "%s*%s" % (name, mon))
   217	    return (" + ".join(terms) if terms else "0"), names
   218	
   219	
   220	def top_face_expr(row: RowSpec, part: Sequence[int], slope_prefix: str) -> tuple[str, list[str], str, str]:
   221	    slopes = ["%s%d" % (slope_prefix, i) for i in range(2, len(part) + 1)]
   222	    factors = ["(y-x)^%d" % part[0]]
   223	    expr = "y^%d*(y-x)^%d" % (row.V2, part[0])
   224	    omega_terms = []
   225	    for slope, exponent in zip(slopes, part[1:]):
   226	        expr += "*(y-%s*x)^%d" % (slope, exponent)
   227	        factors.append("(y-%s*x)^%d" % (slope, exponent))
   228	        omega_terms.extend([slope, "(%s-1)" % slope])
   229	    for i, slope in enumerate(slopes):
   230	        for other in slopes[i + 1 :]:
   231	            omega_terms.append("(%s-%s)" % (slope, other))
   232	    omega = "*".join(omega_terms) if omega_terms else "1"
   233	    return expr, slopes, "y^%d*%s" % (row.V2, "*".join(factors)), omega

+            "partition_1_1_quadratic": {"branch": Q2, "runs": s5_q2_runs, "three_primes_plus_Q": True},
+            "partition_1_1_sextic": {
+                "branch": Q6,
+                "irreducible_squarefree_Q": True,
+                "exact_Q_algebraic_coefficient_field": s5_q6_exact,

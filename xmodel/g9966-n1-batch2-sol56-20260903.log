+def genuine_tame_automorphism_control() -> dict:
+    """Run the literal J=1 tame polynomial automorphism over exact Q."""
+    sys.path.insert(0, str(ROOT))
+    from box.lib.guided_gb import (  # noqa: PLC0415
+        PromotionPolicy,
+        RunConfig,

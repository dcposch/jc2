+\[
+\begin{aligned}
+\delta=2,\ [2,1]:\quad
+&p=z^2(z+3a),\\
+&q=z^{45}(z+3a)^{24}(z-2a),\quad a\ne0;\\
+\delta=5/2,\ [1^3]:\quad
+&p=z(z^2-c),\\
+&q=p^{20}\left(C+10\int p^3dz\right),\quad c\ne0,
+\end{aligned}
+\]
+
+with

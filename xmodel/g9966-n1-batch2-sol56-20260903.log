codex
The first structural reduction is promising: the S5 equations are naturally staged into 37/30/21/12/3 rows by lower band, and the terminal bands contain exact affine pivots. I’m testing those pivots as ring isomorphisms before any Gröbner call; this is the same coefficient-elimination principle that reduced the K=8/9 charts.
exec
/bin/bash -lc "timeout 180s stdbuf -oL -eL python3 - <<'PY'
import json,time
from pathlib import Path
import sympy as sp
for tag in ['part_2','part_1_1']:
 meta=Path('box/g9966n1-20260903/orderbasis/meta/n1_S5_9_6_2_1_k5_'+tag+'_full.json')
 d=json.loads(meta.read_text()); vars=sp.symbols(' '.join(d['variables'])); loc={str(v):v for v in vars}
 rows=[]; p=Path(d['rows_path']); t=time.time()
 for line in p.read_text().splitlines()[1:]:
  a=line.split('|',4); rows.append((int(a[1]),int(a[0]),sp.sympify(a[4].replace('"'^'"','**'),locals=loc)))
 print(tag,'parsed',len(rows),'sec',round(time.time()-t,3),flush=True)
 eligible=set(vars); piv=[]; work=list(rows); t=time.time()
 while True:
  choice=None
  # prioritize highest h band and shortest expression
  for idx,(band,label,row) in sorted(enumerate(work),key=lambda z:(-z[1][0],len(str(z[1][2])))):
   for v in sorted(row.free_symbols & eligible,key=str):
    coeff=sp.diff(row,v)
    if coeff.is_Rational and coeff"'!=0:
     rem=sp.expand(row-coeff*v)
     if v not in rem.free_symbols:
      choice=(idx,band,label,v,coeff,rem); break
   if choice: break
  if not choice: break
  idx,band,label,v,coeff,rem=choice; rhs=sp.cancel(-rem/coeff)
  piv.append((label,band,str(v),str(coeff),len(str(rhs))))
  eligible.remove(v); del work[idx]
  nw=[]
  for B,L,r in work:
   if v in r.free_symbols: r=sp.expand(r.subs(v,rhs))
   if r!=0: nw.append((B,L,r))
  work=nw
  print('"' pivot',len(piv),piv[-1],'remain rows',len(work),'sec',round(time.time()-t,2),flush=True)
 print(tag,'done piv',len(piv),'remaining vars',len(eligible),'rows',len(work),'sec',round(time.time()-t,3))
 print('PIVS',piv)

    31	def atomic_write(path: Path, payload: str) -> None:
    32	    path.parent.mkdir(parents=True, exist_ok=True)
    33	    tmp = path.with_name(path.name + ".tmp")
    34	    tmp.write_text(payload, encoding="utf-8")
    35	    tmp.replace(path)

    76	def verify_inputs() -> dict:
    77	    fields: dict[int, dict[str, str]] = {}
    78	    for line in RECEIPT.read_text(encoding="utf-8").splitlines():
    79	        match = re.match(r"charged_input_(\d+)_(basename|sha256)=(.*)", line)
    80	        if match:
    81	            fields.setdefault(int(match.group(1)), {})[match.group(2)] = match.group(3)
    82	    manifest = []
    83	    for idx in sorted(fields):
    84	        rec = fields[idx]
    85	        path = INPUTS / rec["basename"]
    86	        actual = sha256_file(path)
    87	        manifest.append(
    88	            {
    89	                "index": idx,
    90	                "basename": rec["basename"],
    91	                "path": str(path),
    92	                "expected_sha256": rec["sha256"],
    93	                "actual_sha256": actual,
    94	                "ok": actual == rec["sha256"],
    95	            }
    96	        )
    97	    return {
    98	        "receipt": str(RECEIPT),
    99	        "inputs": str(INPUTS),
   100	        "ok": bool(manifest) and all(item["ok"] for item in manifest),
   101	        "manifest": manifest,
   102	    }

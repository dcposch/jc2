   778	
   779	def run_singular(path: Path, timeout: int = 1800) -> dict:
   780	    env = os.environ.copy()
   781	    for key in ("OMP_NUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS", "NUMEXPR_NUM_THREADS"):
   782	        env[key] = "1"
   783	    started = time.monotonic()
   784	    cmd = [
   785	        "timeout",
   786	        str(timeout),
   787	        "Singular",
   788	        "--cpus=1",
   789	        "--threads=1",
   790	        "--flint-threads=1",
   791	        "-q",
   792	        "--no-rc",
   793	        str(path),
   794	    ]
   795	    result = subprocess.run(cmd, cwd=str(ROOT), env=env, text=True, capture_output=True)
   796	    stdout = result.stdout or ""
   797	    stderr = result.stderr or ""
   798	    out_path = Path(str(path) + ".out")
   799	    err_path = Path(str(path) + ".err")
   800	    out_path.write_text(stdout, encoding="utf-8", errors="replace")
   801	    err_path.write_text(stderr, encoding="utf-8", errors="replace")
   802	    if "MAIN_SATURATED_EMPTY" in stdout:
   803	        verdict = "SATURATED-EMPTY"
   804	    elif "MAIN_NONTRIVIAL" in stdout:
   805	        verdict = "NONTRIVIAL"
   806	    elif "NATIVE_DONE" in stdout:
   807	        verdict = "BUILDER-DONE"
   808	    elif "TAME_J_PASS" in stdout and "TAME_SURVIVES" in stdout:
   809	        verdict = "TAME-CONTROL-PASS"
   810	    elif "OMITTED_ROW_FALSE_POINT_THROUGH" in stdout and "RESTORED_ROW_EMPTY" in stdout:
   811	        verdict = "OMITTED-ROW-CONTROL-PASS"
   812	    elif result.returncode == 124:
   813	        verdict = "TIMEOUT"
   814	    else:
   815	        verdict = "ERROR"
   816	    return {
   817	        "script": str(path.relative_to(ROOT)),
   818	        "returncode": result.returncode,
   819	        "elapsed_seconds": round(time.monotonic() - started, 3),
   820	        "stdout": str(out_path.relative_to(ROOT)),
   821	        "stderr": str(err_path.relative_to(ROOT)),
   822	        "verdict": verdict,
   823	        "control_ring_pass": "CONTROL_RING_PASS" in stdout,
   824	        "control_empty_pass": "CONTROL_EMPTY_PASS" in stdout,
   825	        "control_nonempty_pass": "CONTROL_NONEMPTY_PASS" in stdout,
   826	        "stdout_tail": stdout.splitlines()[-20:],
   827	        "stderr_tail": stderr.splitlines()[-20:],
   828	    }

    15	def dim_S(D: int, r: int) -> int:
    16	    return r * (D + 1) - r * (r - 1) // 2
    17	
    18	
    19	def main() -> None:
    20	    out: dict = {"type": "G9966-DESIGN-GATE / EXACT-ARITHMETIC"}
    21	
    22	    # --- 7161 chart dimensions ---
    23	    blocks = {
    24	        "H": dim_S(10, 11),
    25	        "C2": dim_S(21, 11),
    26	        "C3": dim_S(32, 11),
    27	        "A2": dim_S(65, 33),
    28	        "A3": dim_S(98, 33),
    29	        "B1": dim_S(32, 33),
    30	        "B2": dim_S(65, 33),
    31	    }
    32	    unfixed = {
    33	        "H": dim_S(11, 11),
    34	        "C2": dim_S(22, 11),
    35	        "C3": dim_S(33, 11),
    36	        "A2": dim_S(66, 33),
    37	        "A3": dim_S(99, 33),
    38	        "B1": dim_S(33, 33),
    39	        "B2": dim_S(66, 33),
    40	    }
    41	    out["chart"] = {
    42	        "fixed_top_blocks": blocks,
    43	        "fixed_top_total": sum(blocks.values()),
    44	        "unfixed_total": sum(unfixed.values()),
    45	        "monic_99_66": (5050 - 1) + (2278 - 1),
    46	        "removed_by_two_tops": 99 + 66,
    47	    }
    48	    assert out["chart"]["fixed_top_total"] == 7161
    49	    assert out["chart"]["unfixed_total"] == 7326
    50	    assert out["chart"]["monic_99_66"] == 7326
    51	    assert 7326 - 165 == 7161
    52	
    53	    # --- h3 D2 support ---
    54	    h_lower = [(r, q) for r in range(1, 12) for q in range(12 - r)]
    55	    assert len(h_lower) == 66
    56	    below = [(r, q) for r, q in h_lower if 3 * r + 4 * q < 32]
    57	    equal = [(r, q) for r, q in h_lower if 3 * r + 4 * q == 32]
    58	    strict = [(r, q) for r, q in h_lower if 3 * r + 4 * q >= 33]
    59	    out["h3_D2"] = {
    60	        "lower": 66,
    61	        "strict_below_32": len(below),
    62	        "equality_sites": equal,
    63	        "strict_ge_33": len(strict),
    64	        "linear_rows": len(below) + len(equal),
    65	    }
    66	    assert equal == [(4, 5), (8, 2)]
    67	    assert len(below) == 43 and len(strict) == 21
    68	    assert out["h3_D2"]["linear_rows"] == 45
    69	
    70	    c2 = {(r, q) for r in range(1, 23) for q in range(min(10, 22 - r) + 1)}
    71	    c3 = {(r, q) for r in range(1, 34) for q in range(min(10, 33 - r) + 1)}
    72	    assert (len(c2), len(c3)) == (187, 308)
    73	    ambient = 21 + 187 + 308
    74	    assert ambient == 516
    75	
    76	    d2_slots = {
    77	        (r, q)
    78	        for r in range(1, 34)
    79	        for q in range(34 - r)
    80	        if 3 * r + 4 * q <= 96
    81	    }
    82	    assert len(d2_slots) == 392
    83	    h_fixed = {(0, q) for q in range(8, 12)}
    84	    h_tail = set(strict)
    85	    h_support = h_fixed | h_tail
    86	    c2h = {(a + r, b + q) for a, b in c2 for r, q in h_support}
    87	    h3_sq = {(r1 + r2, q1 + q2) for r1, q1 in h_support for r2, q2 in h_support}
    88	    h3_cu = {(r12 + r3, q12 + q3) for r12, q12 in h3_sq for r3, q3 in h_support}
    89	    face_targets = {(4 * k, 24 - 3 * k) for k in range(1, 9)}
    90	    identities = d2_slots - c3 - c2h - h3_cu - face_targets
    91	    assert identities == {(1, 23), (1, 22), (2, 22)}
    92	    ordered = sorted(d2_slots - identities, key=lambda p: (p[0], -p[1]))
    93	    pivots = {}
    94	    for r, q in ordered:
    95	        pivot = ("C3", r, q) if q <= 10 else ("C2", r, q - 11)
    96	        assert pivot not in pivots
    97	        pivots[pivot] = (r, q)
    98	        if pivot[0] == "C3":
    99	            assert (r, q) in c3
   100	        else:
   101	            assert (r, q - 11) in c2
   102	            a, b = r, q - 11
   103	            col = {
   104	                (a + hr, b + hq)
   105	                for hr, hq in h_support
   106	                if (a + hr, b + hq) in d2_slots
   107	            }
   108	            assert min(col, key=lambda p: (p[0], -p[1])) == (r, q)
   109	    c3n = sum(p[0] == "C3" for p in pivots)
   110	    c2n = sum(p[0] == "C2" for p in pivots)
   111	    assert (len(pivots), c3n, c2n) == (389, 275, 114)
   112	    m97 = sp.Matrix([[comb(q, j) for q in [16, 13, 10, 7, 4]] for j in range(5)])
   113	    m98 = sp.Matrix([[comb(q, j) for q in [17, 14]] for j in range(2)])
   114	    assert m97.det() == 59049
   115	    assert m98.det() == -3
   116	    out["major_516"] = {
   117	        "ambient": ambient,
   118	        "D2_slots": 392,
   119	        "identities": [list(p) for p in sorted(identities)],
   120	        "D2_rank": 389,
   121	        "D1_rank": 7,
   122	        "dimension": ambient - 389 - 7,
   123	        "det97": int(m97.det()),
   124	        "det98": int(m98.det()),
   125	        "h3_free": 21,

   134	def parse_partition(value: str) -> tuple[int, ...]:
   135	    part = tuple(int(v) for v in re.split(r"[+,]", value) if v)
   136	    if not part or any(v <= 0 for v in part) or tuple(sorted(part, reverse=True)) != part:
   137	        raise argparse.ArgumentTypeError("use a descending partition, e.g. 3 or 2+1")
   138	    return part
   139	
   140	
   141	def partitions(n: int, ceiling: int | None = None) -> Iterable[tuple[int, ...]]:
   142	    if n == 0:
   143	        yield ()
   144	        return
   145	    top = n if ceiling is None else min(n, ceiling)
   146	    for first in range(top, 0, -1):
   147	        for tail in partitions(n - first, first):
   148	            yield (first,) + tail
   149	
   150	
   151	def allowed_partitions(row: RowSpec) -> list[tuple[int, ...]]:
   152	    C = shape_for(row)
   153	    return [
   154	        part
   155	        for part in partitions(C["u"])
   156	        if len(part) + 1 <= row.n - row.M2
   157	    ]

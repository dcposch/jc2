   361	def control_6_calibration_lane():
   362	    """the TIME-FUNCTION CALIBRATION lane's (10)_1 vs Moh's printed (12)/(13)."""
   363	    print("\n-- CONTROL 6: calibration lane's (10)_1 vs Moh's printed (12)/(13) --")

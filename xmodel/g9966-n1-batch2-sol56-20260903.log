   119	def shape_for(row: RowSpec) -> dict:
   120	    shape = shape_module()
   121	    C = shape.shape_bundle(row.n, row.m, row.M2, row.V2, row.k)
   122	    if not C.get("ok"):
   123	        raise ValueError("shape failed for %s: %s" % (row.source, C.get("reason")))
   124	    return C

   831	def parse_system_result(run: dict) -> dict:
   832	    lines = run.get("stdout_tail", [])
   833	    basis = None
   834	    for index, line in enumerate(lines):
   835	        if line.strip() == "MAIN_DONE basis_size=" and index + 1 < len(lines):
   836	            basis = lines[index + 1].strip()
   837	    return {**run, "basis_size": basis}

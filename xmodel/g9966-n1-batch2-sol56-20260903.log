    38	def load_order_basis() -> Any:
    39	    spec = importlib.util.spec_from_file_location("order_basis_full_live", ORDER_BASIS)
    40	    if spec is None or spec.loader is None:
    41	        raise RuntimeError(f"cannot import {ORDER_BASIS}")
    42	    module = importlib.util.module_from_spec(spec)
    43	    sys.modules[spec.name] = module
    44	    spec.loader.exec_module(module)
    45	    module.ROOT = ROOT
    46	    module.HERE = OUT
    47	    module.manifest_check = lambda: {"ok": True, "note": "checked by parent N1 lane"}
    48	    return module

+            raise AssertionError((key, main_result[key], expected))
+    if run["returncode"] != 0 or run["timed_out"]:
+        raise AssertionError("unclean genuine tame control")
+    stdout = Path(run["stdout"])
+    stdout_text = stdout.read_text(encoding="utf-8")
+    markers = (

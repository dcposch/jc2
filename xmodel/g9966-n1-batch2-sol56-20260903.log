+        "source": {
+            "descent_target": "J_(gamma,pi)(G,F)=c*gamma^8",
+            "citation": "Moh 1983 Proposition 6.3(3), printed p.197",
+            "map": {"x": "gamma", "y": "pi"},
+        },
+        "identity": "3*h*d(theta)/dz-13*d(h)/dz*theta=h^2",
+        "derivative_variable": "z",
+        "partition_2": {

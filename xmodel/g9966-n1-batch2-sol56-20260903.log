+&q=(z^2-c)^{45}(C+z^3-3cz);\\
+\delta=3/2,\ [2,1,1]:\quad
+&p=z^2(z^2-c),\\
+&q=z^{45}(z^2-c)^{24};\\
+\delta=5/3,\ [1^4]:\quad

+    if args.cmd == "verify":
+        result = verify_manifest()
+    elif args.cmd == "enumerate":
+        result = frozen_enumeration()
+    elif args.cmd == "prepare":
+        result = prepare_one(args.row, parse_part(args.part))
+    elif args.cmd == "build":
+        result = build_one(args.meta.resolve(), args.timeout)
+    elif args.cmd == "bands":

+                "exact_field_map_present": q6_field_ok,
+                "modular_factor_covers": s5_q6_modular,
+                "three_primes_plus_Q": True,
+            },
+            "branch_cover": "[2] union [1,1]; on [1,1], V(Q2*Q6)=V(Q2) union V(Q6)",

   258	
   259	def k16_build_spec(row: RowSpec, *, beta_prefix: str) -> BuildSpec:
   260	    C = shape_for(row)
   261	    if not (C["K"] == 4 and C["u"] == 1 and C["V2"] == 3):
   262	        raise ValueError("%s is not a K=16 u=1,V2=3 chart" % row.source)
   263	    e = C["eprime"]
   264	    q = C["dprime"]
   265	    bu = C["V2"] * C["delta1"] + C["u"] * C["delta2"]
   266	    cut_a = math.ceil(F(e, C["V2"]))
   267	    cut_b = math.ceil(F(2 * e, C["V2"]))
   268	    weighted = [
   269	        ("1", F(0), "1"),
   270	        ("A", cut_a * bu, "A"),
   271	        ("B", cut_b * bu, "B"),
   272	        ("z", e * bu, "z"),
   273	        ("x", e * bu, "x"),
   274	    ]
   275	
   276	    def space(i: int) -> list[str]:
   277	        threshold = i * bu
   278	        return [poly for poly, weight, _name in weighted if weight >= threshold]
   279	
   280	    alpha_spaces = {i: list(space(i)) for i in range(1, e + 1)}
   281	    beta_spaces = {i: list(space(i)) for i in range(2, q + 1)}
   282	    gauges = []
   283	    shear = e - q
   284	    if 1 <= shear <= e and alpha_spaces.get(shear) == ["1"]:
   285	        safe_shear = True
   286	        for i, bspace in beta_spaces.items():
   287	            target = alpha_spaces.get(i + shear, [])
   288	            if not all(base in target for base in bspace):
   289	                safe_shear = False
   290	                break
   291	        if safe_shear:
   292	            alpha_spaces[shear] = []
   293	            gauges.append("P -> P - alpha_%d Q" % shear)
   294	    if q in beta_spaces and "1" in beta_spaces[q]:
   295	        beta_spaces[q] = [base for base in beta_spaces[q] if base != "1"]
   296	        gauges.append("Q -> Q - const(beta_%d)" % q)
   297	    if e in alpha_spaces and "1" in alpha_spaces[e]:
   298	        alpha_spaces[e] = [base for base in alpha_spaces[e] if base != "1"]
   299	        gauges.append("P -> P - const(alpha_%d)" % e)
   300	
   301	    params = ["b1", "b2", "b3", "b4"]
   302	    lines = [
   303	        "poly z = y - x;",
   304	        "poly B = y*z + b1*y + b2;",
   305	        "poly A = y*B + b3;",
   306	        "poly h = y*A + b4;",
   307	    ]
   308	    alpha_dims = []
   309	    beta_dims = []
   310	    for i in range(1, e + 1):
   311	        terms = []
   312	        for j, base in enumerate(alpha_spaces[i]):
   313	            name = "a%d_%d" % (i, j)
   314	            params.append(name)
   315	            terms.append(name if base == "1" else "%s*(%s)" % (name, base))
   316	        lines.append("poly AA%d = %s;" % (i, " + ".join(terms) if terms else "0"))
   317	        alpha_dims.append(len(alpha_spaces[i]))
   318	    for i in range(2, q + 1):
   319	        terms = []
   320	        for j, base in enumerate(beta_spaces[i]):
   321	            name = "%s%d_%d" % (beta_prefix, i, j)
   322	            params.append(name)
   323	            terms.append(name if base == "1" else "%s*(%s)" % (name, base))
   324	        lines.append("poly BB%d = %s;" % (i, " + ".join(terms) if terms else "0"))
   325	        beta_dims.append(len(beta_spaces[i]))
   326	
   327	    low_terms = [("1", q)] + [("BB%d" % i, q - i) for i in range(2, q + 1)]
   328	    high_terms = [("1", e)] + [("AA%d" % i, e - i) for i in range(1, e + 1)]
   329	    stem = "k16_%s_%s" % (row.key, beta_prefix)
   330	    meta = {
   331	        "typing": "DERIVED",
   332	        "chart": "k16_hadic_order_native",
   333	        "row": asdict(row),
   334	        "partition": None,
   335	        "partition_label": None,
   336	        "K": C["K"],
   337	        "uprime": C["u"],
   338	        "dprime": q,
   339	        "eprime": e,
   340	        "delta1": frac_s(C["delta1"]),
   341	        "delta2": frac_s(C["delta2"]),
   342	        "bound_h": frac_s(bu),
   343	        "support_rule": "K16 flag basis; h-adic Jacobian arithmetic in Singular",
   344	        "h_lower_count_corrected": 4,
   345	        "slope_count": 0,
   346	        "alpha_dims": alpha_dims,
   347	        "beta_dims": beta_dims,
   348	        "gauges": gauges,
   349	        "omega": "1",
   350	        "saturation_factor": "c",
   351	    }
   352	    return finalize_spec(row, "k16", None, stem, params, "c", meta, lines, low_terms, high_terms)
   353	
   354	
   355	def generic_build_spec(row: RowSpec, part: Sequence[int]) -> BuildSpec:
   356	    C = shape_for(row)
   357	    if tuple(part) not in allowed_partitions(row):
   358	        raise ValueError("%s partition %s outside Prop. 4.6 cap" % (row.source, part))
   359	    h_lower = corrected_h_lower(C)
   360	    top, slopes, top_factored, omega = top_face_expr(row, part, "s")
   361	    h_terms, h_params = coeff_poly_terms("h0", None, h_lower)
   362	    params = h_params + slopes
   363	    lines = ["poly h = (%s) + (%s);" % (top, h_terms)]
   364	    alpha_dims = []
   365	    beta_dims = []
   366	    e = C["eprime"]
   367	    q = C["dprime"]
   368	    for i in range(1, e + 1):
   369	        mons = coefficient_monomials(C, i, beta=False)
   370	        expr, names = coeff_poly_terms("A", i, mons)
   371	        params.extend(names)
   372	        lines.append("poly AA%d = %s;" % (i, expr))
   373	        alpha_dims.append(len(mons))
   374	    for j in range(2, q + 1):
   375	        mons = coefficient_monomials(C, j, beta=True)
   376	        expr, names = coeff_poly_terms("B", j, mons)
   377	        params.extend(names)
   378	        lines.append("poly BB%d = %s;" % (j, expr))
   379	        beta_dims.append(len(mons))
   380	    low_terms = [("1", q)] + [("BB%d" % j, q - j) for j in range(2, q + 1)]
   381	    high_terms = [("1", e)] + [("AA%d" % i, e - i) for i in range(1, e + 1)]
   382	    stem = "%s_part_%s_generic" % (row.key, "_".join(map(str, part)))
   383	    bu = C["V2"] * C["delta1"] + C["u"] * C["delta2"]
   384	    meta = {
   385	        "typing": "DERIVED",
   386	        "chart": "topface_generic_native",
   387	        "row": asdict(row),
   388	        "partition": list(part),
   389	        "partition_label": "+".join(map(str, part)),
   390	        "top_face_factored": top_factored,
   391	        "K": C["K"],
   392	        "uprime": C["u"],
   393	        "dprime": q,
   394	        "eprime": e,
   395	        "delta1": frac_s(C["delta1"]),
   396	        "delta2": frac_s(C["delta2"]),
   397	        "bound_h": frac_s(bu),
   398	        "support_rule": "ord h(sigma1)>=V2*delta1+u*delta2; beta x-degree<=k+1",
   399	        "h_lower_count_corrected": len(h_lower),
   400	        "slope_count": len(slopes),
   401	        "alpha_dims": alpha_dims,
   402	        "beta_dims": beta_dims,
   403	        "omega": omega,
   404	        "saturation_factor": "c*(%s)" % omega if omega != "1" else "c",
   405	        "compute_direct_j": False,
   406	        "division_mode": "singular_lead_y",
   407	        "coefficient_mode": "hadic_normal_form",
   408	        "coefficient_ring_params": True,
   409	    }
   410	    return finalize_spec(row, "generic", tuple(part), stem, params, meta["saturation_factor"], meta, lines, low_terms, high_terms)
   411	

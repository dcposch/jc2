   236	def clean_name(value: str) -> str:
   237	    out = re.sub(r"[^A-Za-z0-9_]+", "_", value)
   238	    out = re.sub(r"_+", "_", out).strip("_")
   239	    if not out:
   240	        out = "v"
   241	    if out[0].isdigit():
   242	        out = "v" + out
   243	    return out

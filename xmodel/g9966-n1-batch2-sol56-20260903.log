from math import gcd

def parts(n,cap=None):
 if not n: yield (); return
 for a in range(min(n,cap or n),0,-1):
  for t in parts(n-a,a): yield (a,)+t
for u,v in [(2,9),(3,8),(4,7)]:
 print('\\nu,v',u,v)
 ds=sorted({F(a,b) for b in range(1,u+1) for a in range(b+1,20*v+1) if F(a,b)<F(v,u) and gcd(a,b)==1})
 for d in ds:
  a=(13*u+1)*d-(13*v+1); b=9*(u*d-v); rho=F(9*a,b)
  alive=[]
  for p in parts(u):
   if len(p)==1: continue
   opts=[]
   for mm in p:
    oo=[13*mm+1]
    rr=rho*mm
    if rr.denominator==1 and rr>=0: oo.append(int(rr))
    opts.append(sorted(set(oo)))
   comb=[r for r in product(*opts) if sum(r)<=13*u+1]
   if comb: alive.append((p,comb))
  print(d,'rho',rho,'alive',alive)

   495	def _parse_int_token(value: str) -> int | None:
   496	    value = value.strip()
   497	    if value in {"NA", "NONTERMINATING", ""}:
   498	        return None
   499	    try:
   500	        return int(value)
   501	    except ValueError:
   502	        return None

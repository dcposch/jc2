   591	        main=main,
   592	        perturbed=perturbed,
   593	        stdout_sha256=sha256_file(prefix.with_suffix(".out")),
   594	        stderr_sha256=sha256_file(prefix.with_suffix(".err")),
   595	        script_sha256=sha256_file(script_path),

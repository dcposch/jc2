   201	    # --- Jacobian degree ---
   202	    x, y = sp.symbols("x y")
   203	    P = y**3 * (y - x) ** 8
   204	    P9 = sp.expand(P**9)
   205	    P6 = sp.expand(P**6)
   206	    Jtops = sp.expand(
   207	        sp.diff(P9, x) * sp.diff(P6, y) - sp.diff(P9, y) * sp.diff(P6, x)
   208	    )
   209	    assert Jtops == 0
   210	    assert sp.total_degree(P9) == 99 and sp.total_degree(P6) == 66
   211	    out["jacobian_degree"] = {
   212	        "generic_max": 99 + 66 - 2,
   213	        "top_vanishes": True,
   214	        "first_possible_nonzero": 162,
   215	        "slots_deg_0_through_162": 163 * 164 // 2,
   216	        "first_row_1764": 98 * 18,
   217	        "next_band_monomial": "x^135 y^27",
   218	        "next_band_total_degree": 135 + 27,
   219	        "in_F": "y^27 (y-x)^72",
   220	        "in_G": "y^18 (y-x)^48",
   221	    }
   222	    assert out["jacobian_degree"]["slots_deg_0_through_162"] == 13366
   223	    assert 98 * 18 == 1764
   224	    assert 135 + 27 == 162
   225	    P3 = sp.Poly(sp.expand(P**3), x, y)
   226	    assert P3.coeff_monomial(x**24 * y**9) == 1
   227	    assert sp.Poly(P9, x, y).coeff_monomial(x**98 * y) == 0
   228	    assert sp.Poly(P6, x, y).coeff_monomial(x**65 * y) == 0
   229	
   230	    # --- q1 ODE ---
   231	    pi, c, b0 = sp.symbols("pi c b0")
   232	    q1_monic = (
   233	        pi**10
   234	        - (sp.Rational(15, 4)) * c * pi**8
   235	        + 5 * c**2 * pi**6
   236	        - (sp.Rational(5, 2)) * c**3 * pi**4
   237	        + b0
   238	    )
   239	    p = pi * (pi**2 - c)
   240	    q1p = sp.diff(q1_monic, pi)
   241	    assert sp.expand((-sp.Rational(1, 5)) * q1p + 2 * p**3) == 0
   242	    q1_driver = -pi**10 / 5 + sp.Rational(3, 4) * pi**8 - pi**6 + pi**4 / 2 + b0
   243	    # at c=1 the monic * (-1/5) matches driver up to b0 rescale
   244	    assert sp.expand((-sp.Rational(1, 5)) * q1_monic.subs(c, 1) - (q1_driver - b0) * 1) == (

   147	def divisor_chains(K, floor=4):
   148	    out = []
   149	    def rec(cur, ch):
   150	        for dd in range(floor, cur):
   151	            if cur % dd == 0: out.append(ch+[dd]); rec(dd, ch+[dd])
   152	    rec(K, []); return out

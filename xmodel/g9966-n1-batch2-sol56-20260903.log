   270	def sparse_tower(row: Row, part: Sequence[int], C: dict, x: sp.Symbol, y: sp.Symbol) -> dict:
   271	    face = top_face(row, part, x, y)
   272	    params = list(sp.symbols(f"b1:{C['K'] + 1}"))
   273	    prefix = sp.Integer(1)
   274	    tower: dict[int, sp.Expr] = {}
   275	    weights: dict[int, F] = {}
   276	    outer = 0
   277	    center = 0
   278	    for degree, factor in enumerate(face["factors"], start=1):
   279	        prefix = sp.expand(prefix * factor)
   280	        if factor == y:
   281	            center += 1
   282	        else:
   283	            outer += 1

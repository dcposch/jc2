+    if not all(marker in stdout_text for marker in markers):
+        raise AssertionError("missing genuine tame exact-map marker")
+    return {
+        "type": "GENUINE-TAME-AUTOMORPHISM-CONTROL",
+        "status": "PASS",
+        "construction": {

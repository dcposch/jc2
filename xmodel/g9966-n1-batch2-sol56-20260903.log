+    return {
+        "type": "GENUINE-TAME-AUTOMORPHISM-CONTROL",
+        "status": "PASS",
+        "construction": {
+            "family": "(f,g)=(x^2+2*mu*y,x)",
+            "jacobian": "-2*mu",

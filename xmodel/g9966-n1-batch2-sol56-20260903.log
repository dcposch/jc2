+        "identity": "3*h*d(theta)/dz-13*d(h)/dz*theta=h^2",
+        "derivative_variable": "z",
+        "partition_2": {
+            "h": str(sp.expand(h_one)),
+            "theta": str(theta_one),
+            "theta_sha256": sha256_text(str(theta_one)),

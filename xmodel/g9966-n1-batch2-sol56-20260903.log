+            "sha256": control_bundle_sha,
+            "assertions": controls["assertions"],
+            "independent_genuine_tame_checks": genuine_required,
+            "tame_form_ok": tame_form_ok,
+            "perturb_ok": perturb_ok,
+            "attached_to_kills": ["S5", "S6"],
+        },
+        "S5": {

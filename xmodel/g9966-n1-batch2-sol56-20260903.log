   105	def symbol(name: str) -> sp.Symbol:
   106	    return sp.Symbol(name)
   107	
   108	
   109	def expr_text(expr: sp.Expr) -> str:
   110	    return str(sp.factor(expr))
   111	
   112	
   113	# A sparse polynomial in (t,z): (t exponent,z exponent) -> coefficient.
   114	TZ = dict[tuple[int, int], sp.Expr]
   115	
   116	
   117	def tz_add(*items: TZ) -> TZ:
   118	    out: dict[tuple[int, int], sp.Expr] = defaultdict(lambda: sp.Integer(0))
   119	    for item in items:
   120	        for key, value in item.items():
   121	            out[key] += value
   122	    return {key: sp.expand(value) for key, value in out.items() if value != 0}
   123	
   124	
   125	def tz_scale(item: TZ, scalar: int | sp.Expr) -> TZ:
   126	    return {key: sp.expand(scalar * value) for key, value in item.items() if value != 0}
   127	
   128	
   129	def tz_mul(left: TZ, right: TZ, max_t: int) -> TZ:
   130	    out: dict[tuple[int, int], sp.Expr] = defaultdict(lambda: sp.Integer(0))
   131	    for (r1, q1), a in left.items():
   132	        for (r2, q2), b in right.items():
   133	            if r1 + r2 <= max_t:
   134	                out[(r1 + r2, q1 + q2)] += a * b
   135	    return {key: sp.expand(value) for key, value in out.items() if value != 0}
   136	
   137	
   138	def tz_dt(item: TZ) -> TZ:
   139	    return {(r - 1, q): r * value for (r, q), value in item.items() if r}
   140	
   141	
   142	def tz_dz(item: TZ) -> TZ:
   143	    return {(r, q - 1): q * value for (r, q), value in item.items() if q}
   144	
   145	
   146	def tz_times_t(item: TZ, max_t: int) -> TZ:
   147	    return {(r + 1, q): value for (r, q), value in item.items() if r + 1 <= max_t}
   148	
   149	
   150	def substitute_map(expr: sp.Expr, substitutions: dict[sp.Symbol, sp.Expr]) -> sp.Expr:
   151	    if not substitutions or not expr.free_symbols.intersection(substitutions):
   152	        return expr
   153	    old = sp.expand(expr)
   154	    for _ in range(20):
   155	        new = sp.expand(old.subs(substitutions, simultaneous=True))
   156	        if new == old:
   157	            return new
   158	        old = new
   159	    raise AssertionError("substitution map did not stabilize")
   160	
   161	
   162	def resolve_map(substitutions: dict[sp.Symbol, sp.Expr]) -> dict[sp.Symbol, sp.Expr]:
   163	    resolved: dict[sp.Symbol, sp.Expr] = {}
   164	    pending = dict(substitutions)
   165	    for _ in range(len(pending) + 2):
   166	        progress = False
   167	        for variable in list(pending):
   168	            rhs = pending[variable]
   169	            blockers = rhs.free_symbols.intersection(pending)
   170	            if not blockers:
   171	                resolved[variable] = substitute_map(rhs, resolved)
   172	                del pending[variable]
   173	                progress = True
   174	        if not pending:
   175	            return resolved
   176	        if not progress:
   177	            # The elimination maps constructed here are triangular.  A cycle
   178	            # indicates an implementation error, never a license to divide.
   179	            raise AssertionError(f"cyclic substitution map: {sorted(map(str, pending))[:8]}")
   180	    raise AssertionError("failed to resolve substitution map")
   181	
   182	
   183	@dataclass
   184	class Pivot:
   185	    label: str
   186	    variable: sp.Symbol
   187	    coefficient: sp.Rational
   188	    rhs: sp.Expr
   189	
   190	
   191	def qstar_reduce(
   192	    rows: list[tuple[str, sp.Expr]],
   193	    eligible: set[sp.Symbol],
   194	) -> tuple[list[tuple[str, sp.Expr]], dict[sp.Symbol, sp.Expr], list[Pivot], int]:
   195	    """Eliminate affine pivots whose coefficient is a nonzero rational."""
   196	    work = [(label, sp.expand(row)) for label, row in rows if row != 0]
   197	    substitutions: dict[sp.Symbol, sp.Expr] = {}
   198	    pivots: list[Pivot] = []
   199	    zero_rows = len(rows) - len(work)
   200	    while True:
   201	        choice = None
   202	        for row_index, (label, row) in enumerate(work):
   203	            candidates = sorted(row.free_symbols.intersection(eligible), key=str)
   204	            for variable in candidates:
   205	                coefficient = sp.diff(row, variable)
   206	                if not coefficient.is_Rational or coefficient == 0:
   207	                    continue
   208	                remainder = sp.expand(row - coefficient * variable)
   209	                if variable in remainder.free_symbols:
   210	                    continue
   211	                choice = (row_index, label, variable, sp.Rational(coefficient), remainder)
   212	                break
   213	            if choice is not None:
   214	                break
   215	        if choice is None:
   216	            break
   217	        row_index, label, variable, coefficient, remainder = choice
   218	        rhs = sp.cancel(-remainder / coefficient)
   219	        substitutions[variable] = rhs
   220	        pivots.append(Pivot(label, variable, coefficient, rhs))
   221	        eligible.remove(variable)
   222	        del work[row_index]
   223	        reduced: list[tuple[str, sp.Expr]] = []
   224	        for old_label, old_row in work:
   225	            image = sp.expand(old_row.subs(variable, rhs))
   226	            if image == 0:
   227	                zero_rows += 1
   228	            else:
   229	                reduced.append((old_label, image))
   230	        work = reduced
   231	    resolved = resolve_map(substitutions)
   232	    residual = []
   233	    for label, row in work:
   234	        image = substitute_map(row, resolved)
   235	        if image == 0:
   236	            zero_rows += 1
   237	        else:
   238	            residual.append((label, image))
   239	    return residual, resolved, pivots, zero_rows
   240	
   241	
   242	def h3_template() -> tuple[TZ, list[sp.Symbol]]:
   243	    out: TZ = {(0, 8): 1, (0, 9): 3, (0, 10): 3, (0, 11): 1}
   244	    variables: list[sp.Symbol] = []
   245	    for r in range(1, 12):
   246	        cap = 11 - r
   247	        vmin = max(0, (33 - 3 * r + 3) // 4)
   248	        for degree in range(vmin, cap + 1):
   249	            variable = symbol(f"Hc_{r}_{degree}")
   250	            variables.append(variable)
   251	            for j in range(degree - vmin + 1):
   252	                out[(r, vmin + j)] = out.get((r, vmin + j), 0) + variable * comb(degree - vmin, j)
   253	    assert len(variables) == 21
   254	    return {key: sp.expand(value) for key, value in out.items()}, variables
   255	
   256	
   257	def h3_branch_map(branch: str) -> tuple[dict[sp.Symbol, sp.Expr], list[sp.Symbol], dict]:
   258	    rho, u, v, c = map(symbol, ("rho", "u", "v", "c"))
   259	    names = {(r, d): symbol(f"Hc_{r}_{d}") for r in range(1, 12) for d in range(12-r)}
   260	    if branch == "delta2":
   261	        values = {
   262	            (1,8):0,(1,9):0,(1,10):0,(2,7):0,(2,8):0,(2,9):3*u,
   263	            (3,6):0,(3,7):0,(3,8):3*rho,(4,6):0,(4,7):3*u**2,
   264	            (5,5):0,(5,6):6*rho*u,(6,4):-u**3,(6,5):u**3,
   265	            (7,3):-3*rho*u**2,(8,3):0,(9,2):-u*(3*rho*u**2-symbol("Hc_7_4")),
   266	        }
   267	        free = [symbol("Hc_7_4"), symbol("Hc_10_1"), symbol("Hc_11_0"), rho, u]
   268	        centre = {"parameters":["rho","u"],"localization":"rho!=0"}
   269	    else:
   270	        values = {
   271	            (1,8):0,(1,9):0,(1,10):0,(2,7):0,(2,8):0,(2,9):3*u,
   272	            (3,6):0,(3,7):0,(3,8):-3*v,(4,6):0,(4,7):3*u**2,
   273	            (5,5):0,(5,6):-6*u*v,(6,4):-u**3,(6,5):u**3+3*v**2,
   274	            (7,3):3*u**2*v,(7,4):c-3*u**2*v,(8,3):3*u*v**2,
   275	            (9,2):c*u-v**3,(10,1):-c*v,(11,0):0,
   276	        }
   277	        free = [u, v, c]
   278	        centre = {"parameters":["u","v","c"],"localization":"c!=0","b0":"fixed_zero"}
   279	    substitutions = {names[key]: sp.expand(value) for key, value in values.items()}
   280	    return substitutions, free, centre
   281	
   282	
   283	def h3_minor_control(branch: str, h3: TZ) -> dict:
   284	    """Check the charged common-h3 leader without expanding a global F/G."""
   285	    rho, u, v, c = map(symbol, ("rho", "u", "v", "c"))
   286	    # Convert each z=w-1 coefficient to w coefficients, then substitute the
   287	    # small minor w-series combinatorially.
   288	    if branch == "delta2":
   289	        rows = local_rows(h3, "delta2", 9, exact_only=False)
   290	        expected = {9: {2: 3*rho, 3: 1}}
   291	        for n in range(10):
   292	            got = {k: row for (power, k), row in rows.items() if power == n and row != 0}
   293	            want = expected.get(n, {})
   294	            assert set(got) == set(want)
   295	            assert all(sp.expand(got[k] - want[k]) == 0 for k in got)
   296	        return {"target":"t^9*zeta^2*(zeta+3*rho)","verified":True}
   297	    rows = local_rows(h3, "delta52", 21, exact_only=False)
   298	    expected = {21: {1: -c, 3: 1}}
   299	    for n in range(22):
   300	        got = {k: row for (power, k), row in rows.items() if power == n and row != 0}
   301	        want = expected.get(n, {})
   302	        assert set(got) == set(want)
   303	        assert all(sp.expand(got[k] - want[k]) == 0 for k in got)
   304	    return {"target":"s^21*pi*(pi^2-c)","verified":True,"ODE_compatibility":"Hc_11_0=0"}
   305	
   306	
   307	def build_major_h2(branch: str, max_t: int) -> tuple[TZ, set[sp.Symbol], dict]:
   308	    h3, hvars = h3_template()
   309	    hmap, hfree, centre = h3_branch_map(branch)
   310	    h3 = {key: substitute_map(value, hmap) for key, value in h3.items()}
   311	    control = h3_minor_control(branch, h3)
   312	    h3cube = tz_mul(tz_mul(h3, h3, max_t), h3, max_t)
   313	
   314	    # The low-q major-output coordinates have unit C3 (q<=10) or unit C2
   315	    # (11<=q<=21) leading columns.  There are 106 before the seven D1 rows.
   316	    dvars: dict[tuple[int,int], sp.Symbol] = {}
   317	    for r in range(1, 34):
   318	        for q in range(34-r):
   319	            if 3*r + 4*q >= 97 and q <= 21:
   320	                dvars[(r,q)] = symbol(f"K2c_{r}_{q}")
   321	    assert len(dvars) == 106
   322	
   323	    def raw_coefficient(r: int, q: int) -> sp.Expr:
   324	        if (r,q) in dvars:
   325	            return dvars[(r,q)]
   326	        return h3cube.get((r,q), sp.Integer(0))
   327	
   328	    # Exact h2 D1 rows: W=97 has k=0..4, W=98 has k=0..1.
   329	    rows: list[tuple[str,sp.Expr]] = []
   330	    for W, kmax in ((97,4),(98,1)):
   331	        positions = [(r,q) for r in range(1,34) for q in range(34-r) if 3*r+4*q == W]
   332	        for k in range(kmax+1):
   333	            row = sum(comb(q,k)*raw_coefficient(r,q) for r,q in positions if q >= k)
   334	            rows.append((f"h2_D1_W{W}_k{k}", sp.expand(row)))
   335	    pivot_order = [
   336	        dvars[(11,16)],dvars[(15,13)],dvars[(19,10)],dvars[(23,7)],dvars[(27,4)],
   337	        dvars[(10,17)],dvars[(14,14)],
   338	    ]
   339	    # Force the charged determinant choice rather than letting symbol names
   340	    # choose a different but equivalent chart.
   341	    work = list(rows)
   342	    h2map: dict[sp.Symbol,sp.Expr] = {}
   343	    pivots = []
   344	    for variable in pivot_order:
   345	        selected = None
   346	        for index,(label,row) in enumerate(work):
   347	            row = substitute_map(row,h2map)
   348	            coefficient = sp.diff(row,variable)
   349	            if coefficient.is_Rational and coefficient != 0:
   350	                selected=(index,label,row,sp.Rational(coefficient)); break
   351	        assert selected is not None
   352	        index,label,row,coefficient=selected
   353	        rhs=sp.cancel(-(row-coefficient*variable)/coefficient)
   354	        h2map[variable]=rhs
   355	        pivots.append((label,str(variable),str(coefficient)))
   356	        del work[index]
   357	        work=[(lab,sp.expand(rr.subs(variable,rhs))) for lab,rr in work]
   358	    h2map=resolve_map(h2map)
   359	    assert all(substitute_map(row,h2map)==0 for _label,row in rows)
   360	    dfree=set(dvars.values())-set(h2map)


from pathlib import Path
import csv
import sympy as sp

base = Path('box/k16t3-gate-20260903/preprocessed')
print('first_stage_rational_constant_pivots')
with (base/'t3_ring_map.tsv').open() as f:
    rows = list(csv.DictReader(f, delimiter='\\t'))
print('count', len(rows))
for row in rows:
    coeff = sp.sympify(row['pivot_coefficient'])
    ok = coeff.is_Rational and coeff "'!= 0
    print(row['"'step'], row['pivot_variable'], row['source_index_0based'], row['h_power'], coeff, ok)

q7_1 = sp.Symbol('q7_1')
H = sp.Poly(147*q7_1**2 - 84*q7_1 + 11, q7_1, domain=sp.QQ)
print('quadratic_field_unit_pivots')
with (base/'t3_normalized_K_pivots.tsv').open() as f:
    krows = list(csv.DictReader(f, delimiter='\\t'))
print('count', len(krows))
for row in krows:
    coeff = sp.sympify(row['coefficient_in_K'])
    inv = sp.sympify(row['inverse_mod_H'])
    rem = sp.Poly(sp.expand(coeff*inv - 1), q7_1, domain=sp.QQ).rem(H).as_expr()
    free_ok = coeff.free_symbols <= {q7_1}
    print(row['step'], row['pivot_variable'], row['source_index_0based'], row['h_power'], free_ok, sp.expand(rem) == 0)

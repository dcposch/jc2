    print("nvars(basering);")
    print("ideal JS=c;")
    print("ideal IE0=c;")
    print("ideal IN0=c-1;")
    print("ideal SE=sat(IE0,JS);")
    print("ideal SN=sat(IN0,JS);")
    print('if (typeof(SE)=="ideal" && typeof(SN)=="ideal") '


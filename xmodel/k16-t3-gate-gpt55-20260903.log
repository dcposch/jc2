   204	class QuadraticField:
   205	    def __init__(self, y: sp.Symbol, auxiliary: list[sp.Symbol]):
   206	        self.y = y
   207	        self.auxiliary = list(auxiliary)
   208	        self.H = 147*y**2 - 84*y + 11
   209	        self.domain = sp.QQ[tuple(self.auxiliary)]
   210	        self.hpoly = sp.Poly(self.H, y, domain=self.domain)
   211	
   212	    def reduce(self, expr: sp.Expr) -> sp.Expr:
   213	        poly = sp.Poly(sp.expand(expr), self.y, domain=self.domain)
   214	        return sp.expand(poly.rem(self.hpoly).as_expr())
   215	
   216	    def inverse(self, coefficient: sp.Expr) -> sp.Expr:
   217	        coefficient = self.reduce(coefficient)
   218	        if coefficient.free_symbols - {self.y}:
   219	            raise AssertionError("putative K coefficient contains chart variables")
   220	        if coefficient == 0:
   221	            raise ZeroDivisionError("zero coefficient in K")
   222	        inverse = sp.invert(
   223	            sp.Poly(coefficient, self.y, domain=sp.QQ),
   224	            sp.Poly(self.H, self.y, domain=sp.QQ),
   225	        ).as_expr()
   226	        inverse = self.reduce(inverse)
   227	        if self.reduce(coefficient * inverse - 1) != 0:
   228	            raise AssertionError("quadratic-field inverse identity failed")
   229	        return inverse

def deduplicate_k(rows: list[SliceRow], K: QuadraticField,
                  variables: list[sp.Symbol]):
    """Drop zero rows and literal duplicate reduced expressions.

    A prior version tested every pair for arbitrary K-star association.  That
    is proof-safe but needlessly expensive on the large low-band rows.  Exact
    duplicate removal gives the same quotient ideal and is linear-time.
    """

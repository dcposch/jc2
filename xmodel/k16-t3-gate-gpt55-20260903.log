   283	def affine_candidates(rows: list[SliceRow], remaining: list[sp.Symbol],
   284	                      K: QuadraticField):
   285	    occurrences = {
   286	        variable: sum(variable in row.expr.free_symbols for row in rows)
   287	        for variable in remaining
   288	    }
   289	    candidates = []
   290	    for row_index, row in enumerate(rows):
   291	        terms = sp.Add.make_args(row.expr)
   292	        for variable_index, variable in enumerate(remaining):
   293	            if variable not in row.expr.free_symbols:
   294	                continue
   295	            coefficient_terms = []
   296	            remainder_terms = []
   297	            nonlinear = False
   298	            for term in terms:
   299	                exponent = term.as_powers_dict().get(variable, 0)
   300	                if exponent == 0:
   301	                    remainder_terms.append(term)
   302	                elif exponent == 1:
   303	                    coefficient_terms.append(term / variable)
   304	                else:
   305	                    nonlinear = True
   306	                    break
   307	            if nonlinear:
   308	                continue
   309	            coefficient = sp.Add(*coefficient_terms)
   310	            remainder = sp.Add(*remainder_terms)
   311	            if coefficient.free_symbols - {K.y} or coefficient == 0:
   312	                continue
   313	            if K.reduce(row.expr - coefficient*variable - remainder) != 0:
   314	                raise AssertionError("affine decomposition failed")
   315	            # Favor short remainders and variables occurring in few rows.
   316	            # The inverse and expanded right side are computed only for the
   317	            # chosen candidate, avoiding dozens of large speculative expands.
   318	            score = (
   319	                len(str(remainder)) * occurrences[variable],
   320	                len(str(remainder)),
   321	                occurrences[variable],
   322	                len(str(row.expr)),
   323	                row.source_index,
   324	                variable_index,
   325	            )
   326	            candidates.append((score, row_index, variable_index, coefficient,
   327	                               remainder))
   328	    return candidates

   232	def field_associate(left: sp.Expr, right: sp.Expr, K: QuadraticField,
   233	                    variables: list[sp.Symbol]) -> sp.Expr | None:
   234	    """Return a in K* with left=a*right, or None.
   235	
   236	    This is used only for exact duplicate removal and its identity is checked
   237	    modulo H; it never guesses from names or leading monomials alone.
   238	    """
   239	    pleft = sp.Poly(left, *variables, domain=sp.QQ.frac_field(K.y))
   240	    pright = sp.Poly(right, *variables, domain=sp.QQ.frac_field(K.y))
   241	    if pleft.is_zero or pright.is_zero or pleft.monoms() != pright.monoms():
   242	        return None
   243	    ratio = K.reduce(pleft.LC() * K.inverse(pright.LC()))
   244	    if K.reduce(left - ratio * right) == 0:
   245	        return ratio
   246	    return None

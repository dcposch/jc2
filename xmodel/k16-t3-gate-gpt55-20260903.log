        raise AssertionError("c row does not have a Q-constant pivot")
    solved_c = sp.expand(-c_remainder/c_coefficient)
    if sp.expand(solved_c - c_image) != 0:
        raise AssertionError("c-row closed form differs")

    base_matches = []
    for row in reduction.rows:
        if row is c_row:
            continue
        if row.expr.free_symbols <= {x, y}:
            ratio = rational_associate(row.expr, Hhom, all_variables)
            if ratio is not None:
                base_matches.append((row, ratio))
    if len(base_matches) != 1:
        raise AssertionError("expected one quadratic base row")
    base_row, base_ratio = base_matches[0]

    auxiliary = [variable for variable in reduction.remaining_variables
                 if variable not in (x, y)]
    q_variables = auxiliary + [y]


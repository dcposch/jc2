   137	        "gauged": gauged,
   138	        "alpha": alpha, "beta": beta, "params": params, "c": c,
   139	        "P": P, "Q": Q,
   140	        "by_power": by_power, "equations": equations, "tagged": tagged,
   141	    }
   142	
   143	
   144	def singular(expr):
   145	    return str(expr).replace("**", "^")

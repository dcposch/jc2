   331	def eliminate_over_k(rows: list[SliceRow], auxiliary: list[sp.Symbol],
   332	                     K: QuadraticField, max_seconds: float = 600.0,
   333	                     max_bytes: int = 12_000_000):
   334	    started = time.monotonic()

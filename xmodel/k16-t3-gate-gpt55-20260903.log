   313	def singular_polynomial(expr: sp.Expr, variables: list[sp.Symbol]) -> str:
   314	    """Render the proof-equivalent primitive integer multiple of a Q-row."""
   315	    polynomial, _multiplier, _denominator_lcm, _content = (
   316	        primitive_integer_polynomial(expr, variables)
   317	    )
   318	    rendered: list[str] = []
   319	    for monomial, coefficient in polynomial.terms():
   320	        coefficient = sp.Integer(coefficient)
   321	        if coefficient == 0:
   322	            continue
   323	        factors = []
   324	        for variable, exponent in zip(variables, monomial):
   325	            if exponent == 1:
   326	                factors.append(str(variable))
   327	            elif exponent > 1:
   328	                factors.append("%s^%d" % (variable, exponent))
   329	        monomial_text = "*".join(factors)
   330	        magnitude = abs(coefficient)
   331	        if monomial_text and magnitude == 1:
   332	            body = monomial_text
   333	        else:
   334	            scalar = str(magnitude)
   335	            body = scalar if not monomial_text else scalar + "*" + monomial_text
   336	        if not rendered:
   337	            rendered.append(("-" if coefficient < 0 else "") + body)
   338	        else:
   339	            rendered.append((" - " if coefficient < 0 else " + ") + body)
   340	    return "".join(rendered) if rendered else "0"

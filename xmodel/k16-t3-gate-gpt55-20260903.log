   140	def constant_coefficient(expr: sp.Expr, variable: sp.Symbol):
   141	    """Return a in Q^* when expr=a*variable+b with variable absent from b."""
   142	    if variable not in expr.free_symbols:
   143	        return None
   144	    coefficient = sp.expand(sp.diff(expr, variable))
   145	    if not coefficient.is_Rational or coefficient == 0:
   146	        return None
   147	    remainder = sp.expand(expr - coefficient * variable)
   148	    if variable in remainder.free_symbols:
   149	        return None
   150	    if sp.expand(expr - (coefficient * variable + remainder)) != 0:
   151	        raise AssertionError("failed affine decomposition")
   152	    return sp.Rational(coefficient), remainder

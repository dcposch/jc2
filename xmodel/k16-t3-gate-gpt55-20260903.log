   370	            raise AssertionError("K pivot does not kill its row")
   371	        del rows[row_index]
   372	        del remaining[variable_index]
   373	        next_rows = []
   374	        for row in rows:
   375	            expr = row.expr
   376	            if variable in expr.free_symbols:
   377	                expr = K.reduce(expr.subs(variable, rhs))
   378	            else:
   379	                expr = K.reduce(expr)

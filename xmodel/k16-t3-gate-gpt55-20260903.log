    71	        beta_spaces[q] = beta_spaces[q][1:]
    72	        alpha_spaces[e] = alpha_spaces[e][1:]
    73	    params = list(bs)
    74	
    75	    def make_coeff(prefix, index, basis_space):
    76	        if not basis_space:
    77	            return sp.Integer(0)
    78	        names = " ".join("%s%d_%d" % (prefix, index, j)
    79	                         for j in range(len(basis_space)))
    80	        coeffs = sp.symbols(names)
    81	        if not isinstance(coeffs, tuple):
    82	            coeffs = (coeffs,)
    83	        params.extend(coeffs)
    84	        return sp.Add(*(c * basis for c, basis in zip(coeffs, basis_space)))
    85	
    86	    alpha = {i: make_coeff("a", i, alpha_spaces[i]) for i in range(1, e + 1)}
    87	    beta = {i: make_coeff("q", i, beta_spaces[i]) for i in range(2, q + 1)}
    88	    c = sp.Symbol("c")
    89	
    90	    # Q has h-degree q and its h^(q-1) coefficient is zero by the
    91	    # Tschirnhausen/approximate-root normalization.  P has h-degree e.
    92	    q_terms = [(sp.Integer(1), q)] + [(beta[i], q - i) for i in range(2, q + 1)]

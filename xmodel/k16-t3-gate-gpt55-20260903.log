   343	def coefficient_bad_primes(reduction: Reduction) -> list[int]:
   344	    """Primes at which a Q-precomputed pivot is not a valid field pivot."""
   345	    bad = {2}  # the independent actual-pair control uses 1/2
   346	    for pivot in reduction.pivots:
   347	        for integer in pivot.coefficient.as_numer_denom():
   348	            integer = abs(int(integer))
   349	            if integer > 1:
   350	                bad.update(int(p) for p in sp.factorint(integer))
   351	    # Denominators in every emitted coefficient must also remain units.
   352	    variables = reduction.remaining_variables + [reduction.c]
   353	    expressions = [row.expr for row in reduction.rows]
   354	    expressions.extend(
   355	        pivot.final_rhs for pivot in reduction.pivots if pivot.final_rhs is not None
   356	    )
   357	    for expr in expressions:
   358	        for coefficient in sp.Poly(expr, *variables, domain=sp.QQ).coeffs():
   359	            denominator = abs(int(sp.denom(coefficient)))
   360	            if denominator > 1:
   361	                bad.update(int(p) for p in sp.factorint(denominator))
   362	    # Emission replaces each rational row f by a primitive integral row
   363	    # g=lambda*f.  Both numerator and denominator of lambda must remain units
   364	    # for the same emitted file to represent the reduced ideal over GF(p).
   365	    for row in reduction.rows:
   366	        _primitive, multiplier, _denominator_lcm, _content = (
   367	            primitive_integer_polynomial(row.expr, variables)
   368	        )
   369	        for integer in multiplier.as_numer_denom():
   370	            integer = abs(int(integer))
   371	            if integer > 1:
   372	                bad.update(int(p) for p in sp.factorint(integer))
   373	    return sorted(bad)

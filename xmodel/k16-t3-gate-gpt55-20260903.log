   166	    print("ring R=%d,(%s),dp;" % (characteristic, ",".join(map(str, variables))))
   167	    print("option(redSB);")
   168	    print('if (nameof(basering)=="R") { print("CONTROL_RING_PASS R"); }'
   169	          ' else { print("CONTROL_RING_FAIL"); }')
   170	    print("ideal C=c;")
   171	    print('print("CONTROL_EMPTY_START");')
   172	    print("ideal CE=c;")
   173	    print("list LE=sat(CE,C);")
   174	    print("ideal SE=LE[1];")
   175	    print('if (typeof(SE)=="ideal" && nameof(basering)=="R")'
   176	          ' { print("CONTROL_EMPTY_EXTRACT_RING_PASS"); }'
   177	          ' else { print("CONTROL_EMPTY_EXTRACT_RING_FAIL"); }')

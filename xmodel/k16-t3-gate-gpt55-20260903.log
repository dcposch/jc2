    94	    Q = sp.Add(*(aa * h**r for aa, r in q_terms))
    95	    P = sp.Add(*(bb * h**s for bb, s in p_terms))
    96	
    97	    # Exact h-adic Jacobian calculation.  For F=a*h^r and G=b*h^s,
    98	    # J(F,G)=h^(r+s)J(a,b)+h^(r+s-1)(s*b*J(a,h)+r*a*J(h,b)).

   353	                "inverse": str(inverse),
   354	                "identity_verified_mod_H": K.reduce(row.expr*inverse - 1) == 0,
   355	            }
   356	            break
   357	        candidates = affine_candidates(rows, remaining, K)
   358	        if not candidates:
   359	            break
   360	        (_score, row_index, variable_index, coefficient, remainder) = min(
   361	            candidates, key=lambda item: item[0]
   362	        )
   363	        pivot_row = rows[row_index]
   364	        variable = remaining[variable_index]
   365	        inverse = K.inverse(coefficient)
   366	        rhs = K.reduce(-inverse * remainder)

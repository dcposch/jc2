   110	def rational_associate(left: sp.Expr, right: sp.Expr,
   111	                       variables: list[sp.Symbol]) -> sp.Rational | None:
   112	    pleft = sp.Poly(left, *variables, domain=sp.QQ)
   113	    pright = sp.Poly(right, *variables, domain=sp.QQ)
   114	    if pleft.is_zero or pright.is_zero:
   115	        return None
   116	    ratio = sp.Rational(pleft.LC(), pright.LC())
   117	    if (pleft - ratio * pright).is_zero:
   118	        return ratio
   119	    return None

def weighted_degree(expr: sp.Expr, variables: list[sp.Symbol]) -> int:
    degrees = set()
    for monomial, _coefficient in sp.Poly(expr, *variables, domain=sp.QQ).terms():
        degrees.add(
            sum(exponent * WEIGHTS[str(variable)]
                for exponent, variable in zip(monomial, variables))
        )
    if len(degrees) != 1:
        raise AssertionError("row is not homogeneous: %s" % sorted(degrees))
    return degrees.pop()


def rational_associate(left: sp.Expr, right: sp.Expr,
                       variables: list[sp.Symbol]) -> sp.Rational | None:
    pleft = sp.Poly(left, *variables, domain=sp.QQ)
    pright = sp.Poly(right, *variables, domain=sp.QQ)
    if pleft.is_zero or pright.is_zero:
        return None
    ratio = sp.Rational(pleft.LC(), pright.LC())
    if (pleft - ratio * pright).is_zero:
        return ratio
    return None



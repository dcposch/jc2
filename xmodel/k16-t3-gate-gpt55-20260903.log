   297	def primitive_integer_polynomial(
   298	    expr: sp.Expr, variables: list[sp.Symbol]
   299	) -> tuple[sp.Poly, sp.Rational, int, int]:
   300	    """Return primitive g in ZZ[V] and lambda in Q* with g=lambda*expr."""
   301	    polynomial = sp.Poly(expr, *variables, domain=sp.QQ)
   302	    denominator_lcm, cleared = polynomial.clear_denoms(convert=True)
   303	    content, primitive = cleared.primitive()
   304	    multiplier = sp.Rational(denominator_lcm, content)
   305	    if primitive.LC() < 0:
   306	        primitive = -primitive
   307	        multiplier = -multiplier
   308	    if sp.expand(primitive.as_expr() - multiplier * expr) != 0:
   309	        raise AssertionError("primitive integer normalization identity failed")
   310	    return primitive, multiplier, int(denominator_lcm), abs(int(content))

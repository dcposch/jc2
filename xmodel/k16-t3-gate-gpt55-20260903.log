            representative = dataclasses.replace(row, expr=expr)
            representatives[expr] = representative
            kept.append(representative)
        else:
            representative = representatives[expr]
            dropped.append({
                "source_index": row.source_index,
                "reason": "literal_duplicate_mod_H",
                "representative_source_index": representative.source_index,
                "multiplier": "1",
            })
    return kept, dropped


def affine_candidates(rows: list[SliceRow], remaining: list[sp.Symbol],
                      K: QuadraticField):
    occurrences = {
        variable: sum(variable in row.expr.free_symbols for row in rows)
        for variable in remaining
    }
    candidates = []
    for row_index, row in enumerate(rows):
        terms = sp.Add.make_args(row.expr)
        for variable_index, variable in enumerate(remaining):
            if variable not in row.expr.free_symbols:
                continue
            coefficient_terms = []
            remainder_terms = []
            nonlinear = False
            for term in terms:
                exponent = term.as_powers_dict().get(variable, 0)
                if exponent == 0:
                    remainder_terms.append(term)
                elif exponent == 1:
                    coefficient_terms.append(term / variable)
                else:
                    nonlinear = True
                    break
            if nonlinear:
                continue
            coefficient = sp.Add(*coefficient_terms)
            remainder = sp.Add(*remainder_terms)
            if coefficient.free_symbols - {K.y} or coefficient == 0:
                continue
            if K.reduce(row.expr - coefficient*variable - remainder) != 0:
                raise AssertionError("affine decomposition failed")
            # Favor short remainders and variables occurring in few rows.
            # The inverse and expanded right side are computed only for the
            # chosen candidate, avoiding dozens of large speculative expands.
            score = (
                len(str(remainder)) * occurrences[variable],
                len(str(remainder)),
                occurrences[variable],
                len(str(row.expr)),
                row.source_index,
                variable_index,
            )
            candidates.append((score, row_index, variable_index, coefficient,
                               remainder))
    return candidates


def eliminate_over_k(rows: list[SliceRow], auxiliary: list[sp.Symbol],
                     K: QuadraticField, max_seconds: float = 600.0,
                     max_bytes: int = 12_000_000):
    started = time.monotonic()
    remaining = list(auxiliary)
    rows, initial_dropped = deduplicate_k(rows, K, remaining)
    pivots: list[KPivot] = []
    dropped = list(initial_dropped)
    terminal_unit = None

    while True:
        if time.monotonic() - started > max_seconds:
            raise RuntimeError("quadratic-field elimination time bound exceeded")
        constants = [row for row in rows
                     if not (row.expr.free_symbols - {K.y})]
        if constants:
            row = min(constants, key=lambda item: (len(str(item.expr)),
                                                   item.source_index))
            inverse = K.inverse(row.expr)
            terminal_unit = {
                "source_index": row.source_index,
                "constant": str(row.expr),
                "inverse": str(inverse),
                "identity_verified_mod_H": K.reduce(row.expr*inverse - 1) == 0,
            }
            break
        candidates = affine_candidates(rows, remaining, K)
        if not candidates:
            break
        (_score, row_index, variable_index, coefficient, remainder) = min(
            candidates, key=lambda item: item[0]
        )
        pivot_row = rows[row_index]
        variable = remaining[variable_index]
        inverse = K.inverse(coefficient)
        rhs = K.reduce(-inverse * remainder)
        if variable in rhs.free_symbols:
            raise AssertionError("pivot right side contains pivot variable")
        if K.reduce(pivot_row.expr.subs(variable, rhs)) != 0:
            raise AssertionError("K pivot does not kill its row")
        del rows[row_index]
        del remaining[variable_index]
        next_rows = []
        for row in rows:
            expr = row.expr
            if variable in expr.free_symbols:
                expr = K.reduce(expr.subs(variable, rhs))
            else:
                expr = K.reduce(expr)
            next_rows.append(dataclasses.replace(row, expr=expr))
        rows, newly_dropped = deduplicate_k(next_rows, K, remaining)
        dropped.extend(newly_dropped)
        expression_bytes = sum(len(str(row.expr)) for row in rows)
        if expression_bytes > max_bytes:
            raise RuntimeError("quadratic-field residual byte bound exceeded: %d"
                               % expression_bytes)
        pivots.append(KPivot(
            step=len(pivots) + 1,
            source_index=pivot_row.source_index,
            h_power=pivot_row.h_power,
            monomial=pivot_row.monomial,
            variable=variable,
            coefficient=coefficient,
            inverse=inverse,
            step_rhs=rhs,
            remaining_rows_after=len(rows),
            expression_bytes_after=expression_bytes,
        ))
        print("K_PIVOT step=%d source=%d variable=%s rows=%d vars=%d bytes=%d" % (
            len(pivots), pivot_row.source_index, variable, len(rows),
            len(remaining), expression_bytes), flush=True)
    return rows, remaining, pivots, dropped, terminal_unit, time.monotonic()-started


def emit_k_system(rows: list[SliceRow], remaining: list[sp.Symbol],
                  y: sp.Symbol, method: str, terminal_unit: dict | None) -> str:
    if method not in ("std", "slimgb"):
        raise ValueError(method)
    polynomial_variables = [y] + remaining
    generators = [singular_expr(row.expr, polynomial_variables) for row in rows]
    if terminal_unit is not None:
        # A checked nonzero coefficient-field constant is a unit.  Emitting 1
        # makes the final certificate explicit; the pivot table records its
        # preimage through the quotient isomorphisms.
        generators.append("1")
    if not generators:
        generators = ["0"]
    lines = [
        "// exact t=3 system over K=Q(y)/(147*y^2-84*y+11)",
        "// y denotes q7_1 after the rigorously normalized q4_1=1 slice",
        "// c=10*y*(2-21*y)/343 is a coefficient-field unit and is eliminated",
    ]
    emit_actual_pair(lines)
    lines.extend([
        "ring RC=(0,%s),(u,W),dp;" % y,
        "minpoly=147*%s^2-84*%s+11;" % (y, y),
        "number cbar=(10*%s*(2-21*%s))/343;" % (y, y),
        "number cbar_inverse=1/cbar;",
        'if (cbar*cbar_inverse==1) { print("CONTROL_C_UNIT_PASS"); }'
        ' else { print("CONTROL_C_UNIT_FAIL"); }',
        "ideal CE=u,W*u-1;",
        "ideal GE=std(CE);",
        'if (reduce(1,GE)==0) { print("CONTROL_EMPTY_PASS"); }'
        ' else { print("CONTROL_EMPTY_FAIL"); }',
        "ideal CN=u-1,W*u-1;",
        "ideal GN=std(CN);",
        'if (reduce(1,GN)!=0) { print("CONTROL_NONEMPTY_PASS"); }'
        ' else { print("CONTROL_NONEMPTY_FAIL"); }',
        "ring RK=(0,%s),(%s),dp;" % (y, ",".join(map(str, remaining))),
        "minpoly=147*%s^2-84*%s+11;" % (y, y),
        "option(redSB);",
        'if (nameof(basering)=="RK") { print("CONTROL_RING_PASS RK"); }'
        ' else { print("CONTROL_RING_FAIL"); }',
        'print("MAIN_START t=3 normalized_q4_1=1 coefficient_field=quadratic '
        'residual_equations=%d residual_unknowns=%d");'
        % (len(rows) + (1 if terminal_unit else 0), len(remaining)),
        "ideal I=%s;" % ",\n".join(generators),
        "ideal G=%s(I);" % method,
        'print("MAIN_DONE basis_size=");',
        "size(G);",
        'if (reduce(1,G)==0) { print("MAIN_QUADRATIC_FIELD_EMPTY"); G; }'
        ' else { print("MAIN_QUADRATIC_FIELD_NONTRIVIAL");'
        ' print("BASIS_OUTPUT_TRUNCATED_TO_20");'
        ' int basis_cap=size(G); if (basis_cap>20) { basis_cap=20; }'
        ' for (int basis_i=1; basis_i<=basis_cap; basis_i++)'
        ' { G[basis_i]; } }',
        "quit;",
    ])
    return "\n".join(lines) + "\n"



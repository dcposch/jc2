    p2, p1 = (k+1)*raw2, (k+1)*raw1
    match = (p2==pd2 and p1==pd1)
    ok = ok and match
    print("  %-44s k+1=%d  raw=(%s, %s)  Phi=(%s, %s)  printed=(%s, %s)  %s" %
          (lab, k+1, raw2, raw1, p2, p1, pd2, pd1, "MATCH" if match else "FAIL"))
print("  all 10 rationals MATCH:", ok)


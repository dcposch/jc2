        newdanger = dangerous and (is_zero or removable_nonzero)
        if j == 2:
            if newdanger:
                return False, {"failure": "Prop5.6 all-zero major reaches bottom"}
            return self.bottom(newpath)
        return self.global_node(j - 1, newpath, newdanger)


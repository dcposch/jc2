# ---------------------------------------------------------------------------
# orbit arithmetic
# ---------------------------------------------------------------------------
def level_omegas(S):
    """For each j=2..s-1, the admissible local orbit sizes {1, A_j}."""
    out = []
    for j in range(2, S.s):
        _ok, b10, b11 = S.cond1011(j)

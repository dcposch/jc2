+    Q = sp.simplify(V[3] * (n - M[2]) / d[3])
+    tri = P // int(A2)
+    sq = P % int(A2)
+    q = sp.factor((1 - delta1) * dd * e / (dd + e))
+    N = sp.factor(4 * V[2] * q)
+
+    n2 = n / 4
+    m2 = m / 4
+    M2p = M[2] / 4
+    Mdesc = {1: -m2, 2: M2p}
+    ddesc = {1: n2, 2: 4, 3: 1}
+    Vdesc = {2: 3, 3: 1}
+
+    def desc_delta(i: int):
+        num = sp.Rational(1, 1) * (n2 - Mdesc[i])
+        den = sp.Rational(1, 1) * (n2 - Mdesc[2] - 1)

+            num *= V[j] * (n - M[j]) - d[j]
+            den *= V[j] * (n - M[j - 1]) - d[j]
+        return sp.factor(1 - num / den)
+
+    delta3 = delta(3)
+    delta2 = delta(2)
+    delta1 = delta(1)
+    A2 = sp.denom(sp.cancel(delta2))
+    L1 = 4
+    A1 = sp.denom(sp.cancel(L1 * delta1))

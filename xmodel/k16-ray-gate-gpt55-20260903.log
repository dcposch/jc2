            A1 = S.A(1); c1 = (S.e*S.V[2]) % A1 in (0, 1 % A1)
            c2 = S.cond1213()[0]
            if c2 and not c1: weaker += 1
            if c1 and not c2: strictly += 1
            if ((S.e+S.dd)*S.V[2] - 1) % A1 != 0: badid += 1
    print("   %d V-assignments (48<=D<=100): (12)/(13) holds but (10)_1 fails: %d ;"

+                den *= Vd[j] * (n2 - M[j - 1]) - d[j]
+            return 1 - num / den
+
+        raw2, raw1 = def51(2), def51(1)
+        print(
+            f"t={T}: (n',m',M2',V2',k)=({n2},{m2},{M2p},3,1) "
+            f"d'={[d[1], d[2], d[3]]} raw=({raw2},{raw1}) Phi=({2*raw2},{2*raw1}) "
+            f"anchor={n2-M2p-1}"
+        )
+
+    return 0
+
+

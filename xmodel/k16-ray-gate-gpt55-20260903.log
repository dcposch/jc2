    check("p.188 identity A_1 | (n*+m*)V_2-1 holds census-wide 48<=D<=100", badid == 0,
          str(badid))
    check("(12)v(13) <=> (10)_1 on the census (equivalent, not weaker)",
          weaker == 0 and strictly == 0, "%d/%d" % (weaker, strictly))


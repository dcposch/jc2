   329	def fox_s4_count(strands: int, word: BraidWord) -> int:
   330	    """Labelled full-S4 count via Fox S3 colourings and transposition lifts."""
   331	
   332	    buckets: dict[int, list[Permutation]] = {0: [], 1: [], 2: []}
   333	    for item in TRANSPOSITIONS:
   334	        buckets[transposition_to_fox(item)].append(item)
   335	    require(all(len(bucket) == 2 for bucket in buckets.values()), "two lifts per Fox colour")
   336	    ordered: dict[int, tuple[Permutation, Permutation]] = {
   337	        colour: (bucket[0], bucket[1]) if bucket[0] <= bucket[1] else (bucket[1], bucket[0])
   338	        for colour, bucket in buckets.items()
   339	    }
   340	    total = 0
   341	    for fox in itertools.product(range(3), repeat=strands):
   342	        if len(set(fox)) == 1:
   343	            continue
   344	        if fox_action(fox, word) != fox:
   345	            continue
   346	        for bits in itertools.product(range(2), repeat=strands):
   347	            colors = tuple(ordered[fox[index]][bits[index]] for index in range(strands))
   348	            if braid_action(colors, word) != colors:
   349	                continue
   350	            if len(generated_subgroup(colors)) == S4_ORDER:
   351	                total += 1
   352	    return total
   353	

   355	def action_order(strands: int, word: BraidWord) -> int:
   356	    """Order of a braid word acting on transposition tuples."""
   357	
   358	    states = tuple(itertools.product(TRANSPOSITIONS, repeat=strands))
   359	    index_of = {state: index for index, state in enumerate(states)}
   360	    perm = tuple(index_of[braid_action(state, word)] for state in states)
   361	    unseen = set(range(len(perm)))
   362	    order = 1
   363	    while unseen:
   364	        start = min(unseen)
   365	        length = 0
   366	        current = start
   367	        while current in unseen:
   368	            unseen.remove(current)
   369	            current = perm[current]
   370	            length += 1
   371	        order = order * length // gcd_int(order, length)
   372	    return order
   373	
   374	
   375	def gcd_int(left: int, right: int) -> int:
   376	    while right:
   377	        left, right = right, left % right
   378	    return abs(left)

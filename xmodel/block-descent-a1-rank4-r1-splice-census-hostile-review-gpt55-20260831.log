   258	def f1_stage_b_counts(word: BraidWord) -> dict[str, int | str | list[str]]:
   259	    """Infinity closed + individual cusp factor + ordinary mixed twist + pairing."""
   260	
   261	    cusp = tuple(generator for generator in word if abs(generator) == 1)
   262	    mixed = tuple(generator for generator in word if abs(generator) == 2)
   263	    twist = mixed[:2] if mixed else ()
   264	    closed = 0
   265	    full_s4 = 0
   266	    overlapping_s4 = 0
   267	    charged = 0
   268	    charged_s4 = 0
   269	    witness: tuple[Permutation, ...] | None = None
   270	    for colors in itertools.product(TRANSPOSITIONS, repeat=3):
   271	        if braid_action(colors, word) != colors:
   272	            continue
   273	        closed += 1
   274	        if twist and braid_action(colors, twist) != colors:
   275	            continue
   276	        if cusp and braid_action(colors, cusp) != colors:
   277	            continue
   278	        if not overlapping(colors[0], colors[1]):
   279	            continue
   280	        is_s4 = len(generated_subgroup(colors)) == S4_ORDER
   281	        if is_s4:
   282	            full_s4 += 1
   283	            overlapping_s4 += 1
   284	        charged_here = any(frozenset((arm, colors[2])) == PAIR_SET for arm in colors[:2])
   285	        if charged_here:
   286	            charged += 1
   287	            if is_s4:
   288	                charged_s4 += 1
   289	                if witness is None:
   290	                    witness = colors
   291	    payload: dict[str, int | str | list[str]] = {
   292	        "closed_and_affine": closed,
   293	        "overlapping_s4": overlapping_s4,
   294	        "charged_pairing": charged,
   295	        "charged_pairing_s4": charged_s4,
   296	    }
   297	    if witness is not None:
   298	        payload["witness"] = [permutation_name(item) for item in witness]
   299	        payload["full_s4"] = int(len(generated_subgroup(witness)) == S4_ORDER)
   300	    return payload

   303	def trefoil_pair_census() -> dict[str, int]:
   304	    equal = 0
   305	    overlap = 0
   306	    disjoint_rel = 0
   307	    disjoint_fail = 0
   308	    for first, second in itertools.product(TRANSPOSITIONS, repeat=2):
   309	        left = compose(compose(first, second), first)
   310	        right = compose(compose(second, first), second)
   311	        if left != right:
   312	            if disjoint_pair(first, second):
   313	                disjoint_fail += 1
   314	            continue
   315	        if first == second:
   316	            equal += 1
   317	        elif overlapping(first, second):
   318	            overlap += 1
   319	        elif disjoint_pair(first, second):
   320	            disjoint_rel += 1
   321	    return {
   322	        "equal": equal,
   323	        "overlapping": overlap,
   324	        "disjoint_satisfying_relation": disjoint_rel,
   325	        "disjoint_failing_relation": disjoint_fail,
   326	    }
   327	

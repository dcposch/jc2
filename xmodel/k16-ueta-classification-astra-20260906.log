+s += 'print("ETA_ZERO="+string(reduce(em,G)==0));quit;\n'
+name = f'exact_m{m}' + ('' if a.branch is None else f'_d{a.branch}') + ('_boundary' if a.boundary else '') + ('_slim' if a.slim else '')
+p = pathlib.Path(__file__).parent / (name + '.sing')
+p.write_text(s)
+print(p)

+ideal K;
+for(j=4;j<=2*m;j++){{K=K,cx(f,j);}}
+K=simplify(K,2);
+print("ROW_COUNT="+string(size(K)));
+ring small={coeff},({variables}),wp({weights});
+{dinit}
+ideal K=imap(big,K); poly em=imap(big,etam); poly bm=imap(big,Bm);
+'''

+{dinit}
+proc cx(poly f,int j) {{ return(subst(f/x^j,x,0)); }}
+proc uf(poly P,poly L,poly B,poly e) {{return(2*x*P*diff(P,x)-3*P^2+(3/2*L*(L+b)-B*x)*P-3/16*L^2*(L*(L+2*b)-4*B*x)+e*x^2*(b*L/2+B*x));}}

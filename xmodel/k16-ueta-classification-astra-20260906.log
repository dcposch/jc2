+m = a.m
+vs = [f'l{j}' for j in range(2, m)]
+variables = ','.join(vs + ['b'])
+weights = ','.join(map(str, list(range(m-2, 0, -1)) + [m]))
+coeff = '(0,d)' if a.branch is None else '0'
+dinit = f'minpoly=3*d^2-{m};' if a.branch is None else f'number d={a.branch};'

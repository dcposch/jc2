+        d = sp.Symbol("d")
+        y = sp.Symbol(f"q{2*t+1}_1")
+        b3, b4 = sp.symbols("b3 b4")
+        killed = {b3: 0, b4: 1, y: (d + t + 1) / sp.Integer(2 * (2*t+1))}
+        killed.update({sp.Symbol(f"q{j}_0"): 0 for j in range(2, t)})

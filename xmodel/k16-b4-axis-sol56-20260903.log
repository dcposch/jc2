+
+# independent implementation comparison
+timeout 120s python3 box/k16b4-20260903/validate_axis_records.py \
+  box/k16b4-20260903/axis-t2-t7.jsonl \
+  /tmp/jc2-lane.6VGazO/inputs
+
+# exact t=2,y=1/5 negative control; completed inside 30 seconds
+timeout --kill-after=5s 30s Singular -q \
+  box/k16b4-20260903/control-axis/t2_fibre15.sing

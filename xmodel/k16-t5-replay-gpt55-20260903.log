+    require(audit["slice"]["q_rows_after_dedup"] == 48, "wrong sliced rows")
+    require(len(audit["slice"]["q_duplicates"]) == 10, "wrong duplicate count")
+    require(len(audit["slice"]["auxiliaries"]) == 32, "wrong auxiliary count")

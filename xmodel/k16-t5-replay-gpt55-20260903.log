+    require(q["all_Qstar"] is True, "non-Qstar Q pivot")
+    require(q["highest"] == 21 and q["lowest"] == 10, "wrong Q-pivot bands")
+    require(q["residual_unknowns_including_c"] == 35, "wrong residual count")
+    require(q["coefficients"] == [

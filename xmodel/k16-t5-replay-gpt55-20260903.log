def emit_actual_pair_classifier() -> str:
    """Standalone negative classifier: (pi, pi-gamma^2/2) fails the K=16 tuple."""
    return "\n".join([
        "// semantic negative classifier; not a chart point",
        *actual_pair_lines(0),
        'print("TUPLE_CHECK n=deg_pi(F) m=deg_pi(G) J=gamma");',

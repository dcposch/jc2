+print('Q support',supp(Q,243))
+print('special',red(P-(x-x**3),3)==0,red(Q-y,3)==0)
+
+# Divided top Q carry at depth five, including terms killed modulo 243.
+q5=red(Q,243)
+carry5=s.Poly(s.expand((Q-q5)/243),x,y,domain=s.ZZ)
+print('carry5 mod3 support',supp(carry5.as_expr(),3))
+
+# Fixed base lift from S5 to S6. Corrections A+=243e do not affect Q/243 mod 3;
+# B+=243g contributes g. Hence all terms of T above the cap are immutable.
+S6=sum(3**j*A**(2*j) for j in range(6))
+T=s.expand((B*S6-q5)/243)
+print('depth6 T degree mod3',deg(T,3))
+print('depth6 T support mod3',supp(T,3))
+
+# Structural boundary and divergence rows.
+boundary=s.expand(x**8*y+x**4*d+4*x**3*c*y)

+import sympy as s
+x,y=s.symbols('x y')
+
+def red(poly,m):
+    p=s.Poly(s.expand(poly),x,y,domain=s.ZZ)
+    return s.Poly.from_dict({k:int(v)%m for k,v in p.terms() if int(v)%m},(x,y),domain=s.ZZ).as_expr()
+
+def supp(poly,m):
+    p=s.Poly(red(poly,m),x,y)
+    return sorted(((i,j,int(a)) for (i,j),a in p.terms()), reverse=True)
+
+def deg(poly,m):
+    p=s.Poly(red(poly,m),x,y)
+    return p.total_degree() if p.as_expr()!=0 else -1
+
+c=x**5*(1-y)
+d=x**4*(1+y+y**2)
+f=x**4*(7*y+5*y**2)
+A=x+9*c
+B=y+9*d+27*f
+S5=sum(3**j*A**(2*j) for j in range(5))
+P=s.expand(A-A**3)
+Q=s.expand(B*S5)
+J=s.expand(s.diff(A,x)*s.diff(B,y)-s.diff(A,y)*s.diff(B,x))
+
+expectedP=27*x**7*y+216*x**7+234*x**5*y+9*x**5+242*x**3+x
+expectedQ=(81*x**8+135*x**6*y**2+189*x**6*y+27*x**6+144*x**4*y**2+
+           207*x**4*y+9*x**4+3*x**2*y+y)
+print('AB degrees',deg(A,243),deg(B,243))
+print('PQ degrees',deg(P,243),deg(Q,243))
+print('P match',red(P-expectedP,243)==0)
+print('Q match',red(Q-expectedQ,243)==0)
+print('J match',red(J-1,243)==0)
+print('J quotient /243=',s.factor((J-1)/243))
+print('J quotient mod3=',red((J-1)/243,3))
+print('P support',supp(P,243))
+print('Q support',supp(Q,243))
+print('special',red(P-(x-x**3),3)==0,red(Q-y,3)==0)
+
+# Divided top Q carry at depth five, including terms killed modulo 243.
+q5=red(Q,243)
+carry5=s.Poly(s.expand((Q-q5)/243),x,y,domain=s.ZZ)
+print('carry5 mod3 support',supp(carry5.as_expr(),3))
+
+# Fixed base lift from S5 to S6. Corrections A+=243e do not affect Q/243 mod 3;
+# B+=243g contributes g. Hence all terms of T above the cap are immutable.
+S6=sum(3**j*A**(2*j) for j in range(6))
+T=s.expand((B*S6-q5)/243)
+print('depth6 T degree mod3',deg(T,3))
+print('depth6 T support mod3',supp(T,3))
+
+# Structural boundary and divergence rows.
+boundary=s.expand(x**8*y+x**4*d+4*x**3*c*y)
+h=s.expand((s.diff(c,x)+s.diff(d,y))/3)
+br=s.expand(s.diff(c,x)*s.diff(d,y)-s.diff(c,y)*s.diff(d,x))
+print('boundary/ mod3',red(boundary,3))
+print('divided divergence h',h)
+print('bracket',s.factor(br),'bracket mod3',red(br,3))
+print('second determinant digit',s.factor(h+s.diff(f,y)+3*br))

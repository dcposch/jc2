+        "b": b,
+        "s": s,
+        "rho_top_degree": 3 * b - 2 * K,
+        "h_parameter_count": len(hm),
+        "lower_beta_parameter_count": len(bm),
+        "geometric_parameter_count": len(hm) + len(bm) + 1,
+        "gb_parameter_count_without_localizer": len(hm) + len(bm) + 2,

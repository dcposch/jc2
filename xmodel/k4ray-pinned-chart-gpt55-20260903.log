    perturbed: RunControls | None = None
    stdout_sha256: str = ""
    stderr_sha256: str = ""
    script_sha256: str = ""

    def to_json(self) -> dict[str, Any]:
        payload = asdict(self)
        payload["main"] = self.main.to_json()
        payload["perturbed"] = None if self.perturbed is None else self.perturbed.to_json()
        return payload



+            run_chart("MAIN_K9_PIN", 9, timeout=args.timeout, count_timeout=args.count_timeout, cores=args.cores),
+        ]
+        atomic_write(RUNS / "main.summary.json", json.dumps(outputs, indent=2, sort_keys=True) + "\n")
+    elif args.cmd == "controls":

+    )
+    add('print("PRE__DEG_J "+string(deg(JJ)));')
+    add('print("PRE__SIZE_J "+string(size(JJ)));')
+    add("matrix CJ = coef(JJ, x*y);")
+    add("poly CST = 0; int TARGET_FOUND = 0;")
+    add("for (ii=1; ii<=ncols(CJ); ii++)")

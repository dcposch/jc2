+            chars=parse_chars(args.chars),
+            tk=args.tk,
+            timeout=args.timeout,
+            count_timeout=args.count_timeout,
+            cores=args.cores,
+            theorem_cut=not args.no_theorem,
+            rho_level4=not args.no_rho_level4,
+        )
+    elif args.cmd == "batch-main":

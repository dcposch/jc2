+    prelude, names, weights = gen_hk.direct(4, 3, 0, 4)
+    info = run_singular_count(prelude, f"{tag}_p0", 120)
+    generators = tuple(f"ROWS[{idx}]" for idx in range(1, (info["n"] or 0) + 1))
+    hint = HilbertHint(HINT_K4_B3_NUM, tuple(weights), None)
+    system = SingularSystem(
+        name=f"{tag}_p0",
+        prelude=prelude,
+        generators=generators,
+        characteristic=0,
+        variables=tuple(names),
+        homogeneous=True,
+        positive_weights=tuple(weights),
+        metadata={"control": "guided_gb Hilbert hint perturbation"},
+    )
+    result = guided_groebner(
+        system,
+        hint=hint,
+        policy=PromotionPolicy.homogeneous_properness("weighted homogeneous control cone"),
+        config=RunConfig(RUNS / tag, timeout_seconds=timeout, total_cores=cores, run_perturbed_control=True),
+    )
+    run = result.certificate["runs"][0]
+    summary = {
+        "tag": tag,
+        "verdict": result.verdict.value,
+        "accepted_run_count": result.certificate["accepted_run_count"],
+        "main_accepted": run["main"]["accepted"],

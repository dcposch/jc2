+    print(json.dumps({"summary_count": len(summaries), "tags": sorted(summaries)}, sort_keys=True))
+    return summaries
+
+
+def parse_chars(text: str) -> tuple[int, ...]:
+    return tuple(int(piece) for piece in text.split(",") if piece != "")
+
+

+            add(f"  if (dde>{rdeg}) {{ if (CR[2,ii] != 0) {{ RHOROWS=RHOROWS+ideal(CR[2,ii]); }} }}")
+            add(f"  if (dde=={rdeg}) {{ if (CR[2,ii] != 0) {{ RHOROWS=RHOROWS+ideal(CR[2,ii]); }} }}")

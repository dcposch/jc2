+            add("}")
+            add("RHOROWS = simplify(RHOROWS,2);")
+            add(f'print("PRE__RHO_RDEG {rdeg}");')
+            add('print("PRE__RHOLEVEL4_ROWS "+string(size(RHOROWS)));')
+            add("I0 = I0 + RHOROWS;")
+    else:
+        add('print("PRE__RHOLEVEL4_SKIPPED disabled");')

+        "wall": round(time.time() - t0, 3),
+        "timed_out": timed_out,
+        "returncode": returncode,
+        "n": int(markers["PRE__ROWS_FINAL"]) if "PRE__ROWS_FINAL" in markers else None,
+        "markers": markers,
+    }
+    atomic_write(cache, json.dumps(info, indent=2, sort_keys=True) + "\n")

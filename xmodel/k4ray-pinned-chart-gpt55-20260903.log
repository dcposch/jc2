+
+    pv: list[tuple[str, int]] = []
+    pv.extend((var_h(i, j), K - i - j) for i, j in hm)
+    pv.extend((var_b(i, j), 2 * K - i - j) for i, j in bm)
+    pv.append(("mu", 2 * K - b))
+    if theorem_cut:
+        pv.append(("lam", 4 * K))
+    pv.append(("mu_inv", 1))
+    names = [name for name, _weight in pv]

+
+    p_ctrl = sub.add_parser("controls")
+    p_ctrl.add_argument("--timeout", type=int, default=300)
+    p_ctrl.add_argument("--cores", type=int, default=4)
+
+    sub.add_parser("summarize")
+
+    args = parser.parse_args()
+    if args.cmd == "meta":

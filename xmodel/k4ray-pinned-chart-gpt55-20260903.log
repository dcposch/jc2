+
+
+def run_controls(timeout: int, cores: int) -> list[dict[str, Any]]:
+    outputs = []
+    outputs.append(run_chart("CTRL_PIN_K4_B3", 4, b=3, s=2, timeout=timeout, count_timeout=120, cores=cores))

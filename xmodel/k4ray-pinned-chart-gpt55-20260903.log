+def perturbed_hint_control(timeout: int, cores: int) -> dict[str, Any]:
+    tag = "CTRL_HINT_K4_B3"
+    highk = ROOT / "box" / "k4rayhighk-20260903"
+    sys.path.insert(0, str(highk))
+    import gen_hk  # type: ignore  # noqa: WPS433

": [{"basis_size": null, "char": 0, "dimension": null, "elapsed_seconds": 1200.270761, "label": "MAIN_K8_PIN_LIGHT_p0", "nf_all_zero": false, "returncode": 1, "script_sha256": "e8caafe2b9d38f3df165820f2ad9e3c82c67814b09b2db0a1c2172ad2be54686", "stdout_sha256": "8195b5505655b8a1f54e897c2478ba93d4bbb28c9e9992dcfa7d1ac4616366e8", "timed_out": true, "unit": false, "vdim": null}], "s": 5, "tag": "MAIN_K8_PIN_LIGHT", "target": "x^4", "theorem_cut": false, "verdict": "INCONCLUSIVE_TIMEOUT", "wall": 1200.274}


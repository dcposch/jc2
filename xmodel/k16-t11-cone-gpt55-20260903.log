+        if a != 0:
+            pieces.append(frac_text(a))
+        by = self._term_text(b, "yy")
+        if by is not None:
+            pieces.append(by)
+        text = "+".join(pieces).replace("+-", "-")
+        return f"({text})"
+
+    def digest_text(self, value: tuple[Fraction, Fraction]) -> str:
+        return f"{frac_text(value[0])},{frac_text(value[1])}"

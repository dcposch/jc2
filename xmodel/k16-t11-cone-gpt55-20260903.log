+        yy[degree] = ring.sub(yy[degree], ring.mul_var_power(bb[degree], b3_index, 1))
+
+    zz = [ring.zero() for _ in range(t + 2)]
+    zz[0] = ring.mul_var_power(ring.one(), b3_index, 1, ring.field.neg(g))
+    for degree in range(1, len(zz)):

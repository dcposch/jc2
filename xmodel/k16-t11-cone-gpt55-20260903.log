+
+def convolution_l(
+    left: list[dict[tuple[int, ...], object]],
+    right: list[dict[tuple[int, ...], object]],
+    degree: int,
+    ring: SparseRing,
+):
+    answer = ring.zero()
+    for index in range(degree + 1):
+        if index < len(left) and degree - index < len(right):
+            ring.add_to(answer, ring.mul(left[index], right[degree - index]))
+    return answer

+        field.from_fraction(Fraction(e * t, 2 * q * q)),
+    )
+    g = field.add(
+        field.scale(y, Fraction(e * t, q * q)),
+        field.from_fraction(Fraction(-e * t * (t + 1), 6 * q**3)),
+    )
+    c = field.neg(field.mul(y, g))
+    return {"g1": g1, "g2": g2, "g": g, "c": c}

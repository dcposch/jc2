+
+    def one(self) -> Fraction:
+        return Fraction(1)
+
+    def from_int(self, value: int) -> Fraction:
+        return Fraction(value)
+
+    def from_fraction(self, value: Fraction) -> Fraction:
+        return value
+
+    def y(self) -> Fraction:
+        return self.y_value
+
+    def add(self, left: Fraction, right: Fraction) -> Fraction:

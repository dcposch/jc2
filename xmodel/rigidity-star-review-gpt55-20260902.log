    56	        while len(hull) >= 2:
    57	            (k0,d0),(k1,d1) = hull[-2], hull[-1]
    58	            # keep p if (k1,d1) is strictly above segment (k0,d0)-(p)
    59	            if (d1-d0)*(p[0]-k0) <= (p[1]-d0)*(k1-k0):

    41	def degx_roots(R):
    42	    """R in C[x,z], deg_z = n.  Return sorted-desc list of deg_x(z_j) as Fractions.
    43	       Uses the upper convex hull of (k, deg_x c_{n-k}), c_j = coeff of z^j."""
    44	    P = sp.Poly(sp.expand(R), z)

    22	def coeff_xinv(expr, terms=12):
    23	    """coefficient of x^{-1} in the Puiseux expansion at x = oo."""
    24	    e = expr.subs(x, 1/u)
    25	    s = sp.series(sp.simplify(e), u, 0, terms).removeO()
    26	    s = sp.expand(s)
    27	    return sp.simplify(s.coeff(u, 1))

/bin/zsh -lc "python3 - <<'PY'
from fractions import Fraction as F
import re
path='box/exactn-drivers-20260902/exactn-single200.log'
T={'groups':0,'kL':0,'kU':0,'kEither':0,'kS':0,'kM':0}
maxL=F(0); maxrow=None
minL=None; minrow=None
rows=0
for line in open(path):
    m=re.match(r'\\s*(\\d+)\\s+(\\d+)\\s+(\\d+)\\s+(\\d+)\\s+(\\d+)\\s+(\\d+)\\s+(\\d+)\\s+([0-9/]+)\\s+([0-9/]+)', line)
    if not m: continue
    D=int(m.group(1)); rows+=1
    vals=list(map(int,m.groups()[1:7]))
    for key,val in zip(T, vals): T[key]+=val
    mn=F(m.group(8)); mx=F(m.group(9))
    if minL is None or mn<minL: minL=mn; minrow=D
    if mx>maxL: maxL=mx; maxrow=D
print('rows',rows,'D last',D)
print(T)
print('minL',minL,'at',minrow,'maxL',maxL,'at',maxrow,float(maxL))

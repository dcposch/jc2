   307	def control_uni(limit: int = 20000) -> None:
   308	    """Cross-check the period shortcut against the literal Fraction loop."""
   309	    Skel, census = load_core()
   310	    checked = 0
   311	    for n in range(48, 121):
   312	        for m, Ms, V in census(n, with_V=True):
   313	            S = Skel(n, m, list(Ms), V)
   314	            q = qval(S)
   315	            brute = []
   316	            for k in range(1, int(S.u // S.V[2]) + 1):
   317	                value = k * S.V[2] * q
   318	                if value.denominator == 1 and value >= 6:
   319	                    brute.append(UniWitness(k, k * S.V[2], int(value)))
   320	            fast = list(uni_witnesses(S, 6))
   321	            if brute != fast:
   322	                raise AssertionError(f"(UNI) mismatch at {(n,m,Ms,V)}: {brute} != {fast}")
   323	            checked += 1
   324	            if checked >= limit:
   325	                print(f"[PROVED-HERE] CONTROL-UNI: exact loop = period shortcut on {checked} assignments")
   326	                return
   327	    print(f"[PROVED-HERE] CONTROL-UNI: exact loop = period shortcut on {checked} assignments")

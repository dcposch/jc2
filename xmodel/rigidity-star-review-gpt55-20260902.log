   160	def report_pair(label, f, g, c2, c1, in_gauge, verbose=True):
   161	    J = jac(f,g)
   162	    n = sp.degree(sp.Poly(g,y))
   163	    gy = sp.expand(sp.diff(g,y))
   164	    of  = branch_orders(f,  g, c2)          # ord_t f(tau_i),  sorted ascending
   165	    ogy = branch_orders(gy, g, c2)          # ord_t g_y(tau_i)
   166	    oJ  = branch_orders(J,  g, c2) if J.free_symbols else [F(0)]*n
   167	    Nr  = N_res(f,g,c1,c2)
   168	    d0  = sorted([-o for o in ogy])         # delta0_i = -ord_t g_y(tau_i)
   169	    lamf= sorted(of)
   170	    # DICT-N
   171	    Ndict = sum(max(F(0), 1-dd) for dd in d0)
   172	    Nfront= sum(max(F(0), -l) for l in lamf)
   173	    if verbose:
   174	        print(f"   {label}")
   175	        print(f"      deg f={sp.degree(sp.Poly(f,y))}(y)/{sp.total_degree(f)}  "
   176	              f"deg g={n}(y)/{sp.total_degree(g)}  J={J}")
   177	        print(f"      ord_t f(tau) : {[str(v) for v in lamf]}")
   178	        print(f"      delta0=-ord_t g_y(tau) : {[str(v) for v in d0]}")
   179	        print(f"      N(res)={Nr}   sum(-ord_t f)^+ = {Nfront}   DICT-N = {Ndict}")
   180	    return dict(N=Nr, Nfront=Nfront, Ndict=Ndict, lamf=lamf, d0=d0, oJ=oJ, J=J, n=n)

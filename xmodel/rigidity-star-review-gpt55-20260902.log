   330	def print_table(rows: Mapping[int, DegreeCounts], degrees: Iterable[int], label: str) -> None:
   331	    print(f"\n[MEASURED] {label}")
   332	    print("    D   enumerated   tested(UNI,N>=6)   killed   PASS   surviving   STAR-emptied")
   333	    totals = DegreeCounts()
   334	    empty = []
   335	    already_empty = []
   336	    for n in degrees:
   337	        if n not in rows:
   338	            continue
   339	        c = rows[n]
   340	        totals.enumerated += c.enumerated
   341	        totals.tested += c.tested
   342	        totals.killed += c.killed
   343	        totals.passed += c.passed
   344	        star_empty = c.tested > 0 and c.surviving == 0
   345	        if star_empty:
   346	            empty.append(n)
   347	        if c.tested == 0:
   348	            already_empty.append(n)
   349	        print(
   350	            f"  {n:3d} {c.enumerated:12d} {c.tested:19d} {c.killed:8d} "
   351	            f"{c.passed:6d} {c.surviving:11d} {'YES' if star_empty else 'NO':>13s}"
   352	        )
   353	    print(
   354	        f"  TOTAL {totals.enumerated:10d} {totals.tested:19d} {totals.killed:8d} "
   355	        f"{totals.passed:6d} {totals.surviving:11d}"
   356	    )
   357	    print(f"  [MEASURED] degrees emptied by STAR test: {empty or 'NONE'}")
   358	    print(f"  [MEASURED] censused degrees with zero pre-STAR test rows: {already_empty or 'NONE'}")

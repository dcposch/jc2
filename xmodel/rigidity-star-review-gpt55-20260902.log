   383	    print(f"  packet weight / bound  = {witness.total_v2} <= u={fmt_fraction(S.u)}")
   384	    print(f"  N                      = {witness.k}*{S.V[2]}*{qval(S)} = {witness.N} >= {n_min}")
   385	    A, B = bottom_bidegrees(S)

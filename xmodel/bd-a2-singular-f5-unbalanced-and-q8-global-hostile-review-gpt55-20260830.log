    25	def cartan_d(values: tuple[int, ...]) -> tuple[int, ...]:
    26	    """D_r numbering 1--...--(r-2), with spins r-1,r at r-2."""
    27	
    28	    rank = len(values)
    29	    assert rank >= 4
    30	    out: list[int] = []
    31	    for vertex, value in enumerate(values, start=1):
    32	        if vertex == 1:
    33	            neighbors = (2,)
    34	        elif vertex < rank - 2:
    35	            neighbors = (vertex - 1, vertex + 1)
    36	        elif vertex == rank - 2:
    37	            neighbors = (rank - 3, rank - 1, rank)
    38	        else:
    39	            neighbors = (rank - 2,)
    40	        out.append(2 * value - sum(values[item - 1] for item in neighbors))
    41	    return tuple(out)

    49	    cusp_constant = a0 / (c1 * c1)
    50	    # Pair-midpoint branch: u = smooth_u_coefficient*z^4 + higher.
    51	    smooth_u_coefficient = Fraction(1, 4) / c1
    52	    assert cusp_constant and smooth_u_coefficient
    53	    return cusp_constant, smooth_u_coefficient

    15	def cartan_a(values: tuple[int, ...]) -> tuple[int, ...]:
    16	    out: list[int] = []
    17	    for index, value in enumerate(values):
    18	        adjacent = (values[index - 1] if index else 0) + (
    19	            values[index + 1] if index + 1 < len(values) else 0
    20	        )
    21	        out.append(2 * value - adjacent)
    22	    return tuple(out)

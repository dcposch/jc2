+        "valid": valid,
+        "timed_out": timed_out,
+        "returncode": rc,
+        "wall_seconds": round(time.time() - started, 3),
+        "log": str(log),
+        "log_tail": text[-1000:],
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()

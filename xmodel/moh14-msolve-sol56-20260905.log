         )
         if re.sub(r"\s+", "", polynomial) in {"0", "+0", "-0"}:
             raise ChartError(f"rows line {physical_line}: explicit zero generator")
-        translated.append(polynomial)
-        outer_parentheses_removed += int(removed)
+        include = (

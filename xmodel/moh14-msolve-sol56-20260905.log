(*names: 'str', characteristic: 'int' = 0) -> 'None'
@dataclass(frozen=True, init=False, repr=False)
class Ring:
    """A polynomial ring over Q (``characteristic=0``) or over ``F_p``.

    ``Ring("x", "y")`` is ``QQ[x, y]`` with the grevlex order. Variable names
    match ``[A-Za-z][A-Za-z0-9]*``: no underscores, because msolve's parser does
    not accept them.

    :param names: the variable names, in order.
    :param characteristic: ``0`` for Q, or a prime below ``2**31``.
    :raises MsolveInputError: for an illegal name or a non-prime characteristic.
    """

    names: tuple[str, ...]
    characteristic: int

    def __init__(self, *names: str, characteristic: int = 0) -> None:
        name_tuple = tuple(names)
        # emit_system owns the rules for what msolve will accept as a variable
        # name and as a characteristic; ask it rather than re-deriving them.
        emit_system(["0"], variables=name_tuple, characteristic=characteristic)
        object.__setattr__(self, "names", name_tuple)
        object.__setattr__(self, "characteristic", characteristic)
        object.__setattr__(
            self, "_ctx", fmpq_mpoly_ctx.get(name_tuple, Ordering.degrevlex)
        )

    # -- construction ----------------------------------------------------

    def __call__(self, source: str) -> Poly:
        """Parse ``source`` into a :class:`Poly` of this ring.

        The grammar is msolve's: an expanded sum of monomials, no parentheses,
        with rational coefficients written as a leading ``1/2*x``. Rational
        coefficients are accepted on prime-field rings too and are reduced
        immediately; a denominator divisible by the characteristic is an error.

        :raises MsolveInputError: if ``source`` is not a legal polynomial.
        """
        if not isinstance(source, str):
            raise MsolveInputError(
                f"expected a polynomial string, got {type(source).__name__}"
            )
        # Validate against msolve's own grammar first. characteristic=0 here on
        # purpose: '1/2*x' is a legal way to write a prime-field element, and
        # the reduction happens below.
        emit_system([source], variables=self.names, characteristic=0)
        return self._wrap(self._ctx.from_dict(_parse(source, self.names)))

    def constant(self, value: Scalar) -> Poly:
        """The constant polynomial ``value``."""
        return self._wrap(self._ctx.from_dict({(0,) * self.nvars: _to_fmpq(value)}))

    def gens(self) -> tuple[Poly, ...]:
        """The variables, as polynomials."""
        return tuple(self._wrap(g) for g in self._ctx.gens())

    def gen(self, index: int) -> Poly:
        """The ``index``-th variable, as a polynomial."""
        return self._wrap(self._ctx.gen(index))

    @property
    def nvars(self) -> int:
        """How many variables this ring has."""
        return len(self.names)

    def extend(self, *extra: str) -> Ring:
        """This ring with ``extra`` variables appended, same characteristic."""
        return Ring(*self.names, *extra, characteristic=self.characteristic)

    def fresh_variable(self, prefix: str = "u") -> str:
        """A variable name not already used here: ``u``, else ``u1``, ``u2``..."""
        if prefix not in self.names:
            return prefix
        index = 1
        while f"{prefix}{index}" in self.names:
            index += 1
        return f"{prefix}{index}"

    def embed(self, poly: Poly) -> Poly:
        """Re-express ``poly`` in this ring, matching variables by name.

        Every variable of ``poly.ring`` must be a variable of this ring, and the
        characteristics must agree.

        :raises RingMismatch: if the embedding does not exist.
        """
        source = poly.ring
        if source.characteristic != self.characteristic:
            raise RingMismatch(
                f"cannot embed a polynomial of {source} into {self}: "
                f"different characteristic"
            )
        try:
            positions = [self.names.index(name) for name in source.names]
        except ValueError:
            missing = [n for n in source.names if n not in self.names]
            raise RingMismatch(
                f"cannot embed a polynomial of {source} into {self}: "
                f"{self} has no variable(s) {', '.join(missing)}"
            ) from None
        terms: dict[tuple[int, ...], fmpq] = {}
        for exponents, coeff in poly.terms():
            key = [0] * self.nvars
            for position, exponent in zip(positions, exponents):
                key[position] = exponent
            terms[tuple(key)] = coeff
        return self._wrap(self._ctx.from_dict(terms))

    # -- elimination-free helpers ----------------------------------------

    def resultant(self, f: Poly, g: Poly, var: str) -> Poly:
        """The resultant of ``f`` and ``g`` with respect to ``var``.

        The result is free of ``var`` -- it lies in the subring generated by the
        remaining variables -- but is returned as a :class:`Poly` of this same
        ring, so it composes with everything else here. It is a constant
        polynomial when ``var`` was the only variable.

        :raises NotImplementedError: on a prime-field ring. Reducing a resultant
            computed over Q is not the resultant over ``F_p`` when the leading
            coefficient in ``var`` vanishes mod ``p``, and v0.1 will not guess
            which case it is in.
        """
        self._require_characteristic_zero("resultant")
        raw = self._check(f)._raw.resultant(self._check(g)._raw, self._check_var(var))
        return self._wrap(raw)

    def discriminant(self, f: Poly, var: str) -> Poly:
        """The discriminant of ``f`` with respect to ``var``.

        :raises NotImplementedError: on a prime-field ring, for the reason given
            in :meth:`resultant`.
        """
        self._require_characteristic_zero("discriminant")
        return self._wrap(self._check(f)._raw.discriminant(self._check_var(var)))

    # -- internals -------------------------------------------------------

    def _wrap(self, raw: fmpq_mpoly) -> Poly:
        if self.characteristic:
            raw = _reduce_mod_p(raw, self.characteristic, self._ctx, self.nvars)
        return Poly(self, raw)

    def _check(self, poly: Poly) -> Poly:
        if not isinstance(poly, Poly):
            raise RingMismatch(f"expected a Poly, got {type(poly).__name__}")
        if poly.ring != self:
            raise RingMismatch(f"polynomial belongs to {poly.ring}, not {self}")
        return poly

    def _check_var(self, var: str) -> str:
        if var not in self.names:
            raise MsolveInputError(f"{var!r} is not a variable of {self}")
        return var

    def _require_characteristic_zero(self, operation: str) -> None:
        if self.characteristic:
            raise NotImplementedError(
                f"{operation} is implemented over Q only; this ring has "
                f"characteristic {self.characteristic}"
            )

    def __str__(self) -> str:
        field = "QQ" if self.characteristic == 0 else f"GF({self.characteristic})"
        return f"{field}[{', '.join(self.names)}]"

    def __repr__(self) -> str:
        args = ", ".join(repr(name) for name in self.names)
        if self.characteristic:
            return f"Ring({args}, characteristic={self.characteristic})"
        return f"Ring({args})"

===== <class 'qqideal.ideal.Ideal'>
(gens: "'Iterable[Poly | str]'", ring: 'Ring | None' = None) -> 'None'
class Ideal:
    """The ideal generated by finitely many polynomials of one :class:`Ring`.

    ``Ideal([R("x*y-1"), R("y^2-x")], ring=R)``. Generators may also be given as
    strings when ``ring`` is supplied. Zero generators are dropped; an ideal
    with no nonzero generators is the zero ideal, and is answered without
    calling msolve at all.
    """

    __slots__ = ("_gens", "_ring")

    def __init__(
        self,
        gens: "Iterable[Poly | str]",
        ring: Ring | None = None,
    ) -> None:
        if isinstance(gens, str):
            raise MsolveInputError(
                "gens must be a sequence of polynomials, not a single string"
            )
        raw_gens = list(gens)
        if ring is None:
            for candidate in raw_gens:
                if isinstance(candidate, Poly):
                    ring = candidate.ring
                    break
            else:
                raise MsolveInputError(
                    "ring= is required when no generator is a Poly"
                )
        if not isinstance(ring, Ring):
            raise RingMismatch(f"ring must be a Ring, got {type(ring).__name__}")
        self._ring = ring
        self._gens = tuple(_coerce(ring, g) for g in raw_gens)

    # -- data ------------------------------------------------------------

    @property
    def gens(self) -> tuple[Poly, ...]:
        """The generators, as given."""
        return self._gens

    @property
    def ring(self) -> Ring:
        """The ring the generators live in."""
        return self._ring

    @property
    def is_zero_ideal(self) -> bool:
        """Whether every generator is zero, so the ideal is ``(0)``."""
        return all(g.is_zero() for g in self._gens)

    def to_msolve(self) -> str:
        """The msolve input file this ideal would be sent as.

        :raises MsolveInputError: if the system is one msolve would mis-parse.
        """
        polys = [g.to_msolve() for g in self._gens if not g.is_zero()] or ["0"]
        return emit_system(
            polys,
            variables=self._ring.names,
            characteristic=self._ring.characteristic,
        )

    # -- Groebner bases --------------------------------------------------

    def groebner(self, timeout: float = 60) -> tuple[Poly, ...]:
        """The reduced grevlex Groebner basis, as polynomials of :attr:`ring`.

        ``(R("1"),)`` for the unit ideal, ``()`` for the zero ideal.

        :param timeout: wall-clock limit for msolve, in seconds.
        :raises MsolveTimeout: if msolve ran out of time.
        :raises MsolveDied: if msolve crashed.
        :raises MsolveOutputError: if msolve's output was not a Groebner basis.
        """
        if self.is_zero_ideal:
            return ()
        result = self._run(gb=2, timeout=timeout)
        self._check_variables(result)
        return tuple(self._ring(entry) for entry in result.output.basis)

    def leading_monomials(self, timeout: float = 60) -> tuple[tuple[int, ...], ...]:
        """Leading monomials of the grevlex Groebner basis, as exponent vectors.

        Over Q this uses ``-g 2`` and takes leading terms of the lifted basis
        (msolve 0.10.1's ``-g 1`` is unlifted). Over a prime field it uses
        ``-g 1``. The unit ideal comes back as the single all-zero vector (the
        constant monomial ``1``); the zero ideal comes back empty.
        """
        if self.is_zero_ideal:
            return ()
        gb = 1 if self._ring.characteristic else 2
        result = self._run(gb=gb, timeout=timeout)
        return self._leading_from(result)

    # -- verdicts --------------------------------------------------------

    def verdict(self, timeout: float = 60) -> Verdict:
        """Emptiness, dimension and 0-dimensional degree in one msolve call.

        Dimension and degree are read combinatorially off the leading
        monomials. Over Q the call is ``-g 2`` so a nonempty result is a
        lifted basis (msolve 0.10.1 skips the lift for ``-g 1``). Over a
        prime field ``-g 1`` is exact. A msolve timeout or crash becomes
        :attr:`Kind.TIMEOUT` or :attr:`Kind.ERROR` rather than an exception;
        bad input still raises.

        Certainty, for msolve 0.10.1: over a prime field, :attr:`
        Certainty.PROVEN` for that field. Over Q, a unit ideal is
        :attr:`Certainty.MODULAR` -- msolve returns after its first modular
        prime and still labels the output characteristic 0 -- while a nonempty
        result is :attr:`Certainty.PROVEN`.
        """
        proven_field = self._ring.characteristic != 0
        if self.is_zero_ideal:
            return Verdict(
                kind=Kind.NONEMPTY,
                dim=self._ring.nvars,
                degree=None,
                certainty=Certainty.PROVEN,
                detail="zero ideal; no msolve call needed",
            )
        try:
            # Over Q, -g 1 is unlifted (first modular prime). Use -g 2 so a
            # nonempty basis is actually over Q; take leading terms in flint.
            result = self._run(gb=2 if not proven_field else 1, timeout=timeout)
        except MsolveTimeout as exc:
            return Verdict(
                kind=Kind.TIMEOUT,
                dim=None,
                degree=None,
                certainty=Certainty.MODULAR,
                detail=str(exc),
            )
        except (MsolveDied, MsolveOutputError) as exc:
            return Verdict(
                kind=Kind.ERROR,
                dim=None,
                degree=None,
                certainty=Certainty.MODULAR,
                detail=str(exc),
            )

        if result.output.unit_ideal:
            return Verdict(
                kind=Kind.EMPTY,
                dim=None,
                degree=None,
                certainty=Certainty.PROVEN if proven_field else Certainty.MODULAR,
                msolve_version=result.msolve_version,
            )

        dim, degree = dim_and_degree(self._leading_from(result), self._ring.nvars)
        return Verdict(
            kind=Kind.NONEMPTY,
            dim=dim,
            degree=degree,
            certainty=Certainty.PROVEN,
            msolve_version=result.msolve_version,
        )

    def contains_one(self, timeout: float = 60) -> Verdict:
        """Is this the unit ideal?

        :returns: the same :class:`Verdict` :meth:`verdict` returns.
            :attr:`Kind.EMPTY` means ``1 in I``: the ideal is the whole ring and
            the system has no solutions. :attr:`Kind.NONEMPTY` means it does
            not.
        """
        return self.verdict(timeout=timeout)

    def radical_member(self, g: "Poly | str", timeout: float = 60) -> Verdict:
        """Is ``g`` in the radical of this ideal?

        Rabinowitsch: ``g in sqrt(I)`` exactly when ``1`` is in
        ``I + (u*g - 1)``. This is an identity over any field, so no assumption
        about algebraic closure is involved.

        :returns: a :class:`Verdict` about ``V(I) \\ V(g)``.
            :attr:`Kind.EMPTY` means yes, ``g`` is in the radical (it vanishes
            on the whole variety). :attr:`Kind.NONEMPTY` means no.
        """
        return self.saturate(g).verdict(timeout=timeout)

    def radical(self) -> NoReturn:
        """Not implemented. Use :meth:`radical_member` instead.

        :raises NotImplementedError: always. Computing a radical needs primary
            decomposition or a 0-dimensional radical algorithm, neither of which
            is in v0.1 and neither of which msolve's Groebner mode provides.
        """
        raise NotImplementedError(
            "qqideal v0.1 does not compute radicals. Radical *membership* is "
            "available as Ideal.radical_member(g), which is a single Groebner "
            "basis computation."
        )

    # -- witness points --------------------------------------------------

    def witness_points(self, timeout: float = 60) -> "Witnesses":
        """Exact witness points of this ideal, when it is zero-dimensional.

        Runs msolve's rational parametrization (``-P``) and factors the
        eliminating polynomial over Q. Each returned point is substituted back
        into every generator with exact arithmetic before it is returned; see
        :mod:`qqideal.witness` for what is proven and what is msolve's claim.

        :param timeout: wall-clock limit for msolve, in seconds.
        :returns: a :class:`~qqideal.Witnesses`; a msolve timeout or crash
            becomes :attr:`~qqideal.WitnessKind.TIMEOUT` or
            :attr:`~qqideal.WitnessKind.ERROR` rather than an exception.
        :raises NotImplementedError: on a prime-field ring; witness extraction
            is a characteristic-0 activity.
        """
        from .witness import extract

        return extract(self, timeout=timeout)

    # -- saturation ------------------------------------------------------

    def saturate(self, f: "Poly | str", timeout: float | None = None) -> "Ideal":
        """``I : f^oo``, as a Rabinowitsch ideal in ``ring[u]``.

        The returned ideal is ``I + (u*f - 1)`` in :attr:`ring` extended by one
        fresh slack variable. Its variety is the graph of ``V(I) \\ V(f)``, so
        emptiness, dimension and 0-dimensional degree match those of
        ``I : f^oo`` in :attr:`ring`. Its *generators* are not the saturated
        ideal written in :attr:`ring`: recovering those needs elimination, and
        msolve's Groebner mode prints grevlex only. v0.1 does not pretend
        otherwise.

        :param f: the polynomial to invert. ``f = 0`` gives the unit ideal,
            which is the right answer: ``D(0)`` is empty.
        :param timeout: accepted for signature stability and unused -- this
            construction is symbolic, and msolve runs only when you ask for a
            basis or a verdict.
        """
        del timeout  # symbolic construction; nothing to time out
        poly = self._coerce(f)
        slack = self._ring.fresh_variable("u")
        extended = self._ring.extend(slack)
        gens = [extended.embed(g) for g in self._gens if not g.is_zero()]
        gens.append(extended.gen(extended.nvars - 1) * extended.embed(poly) - 1)
        return Ideal(gens, ring=extended)

    def colon(self, g: "Poly | str", timeout: float | None = None) -> "Ideal":
        """Alias for :meth:`saturate`: in v0.1 the colon is the saturation.

        ``I : g`` and ``I : g^oo`` differ in general. v0.1 computes only the
        saturation ``I : g^oo``, because that is what the Rabinowitsch trick
        gives without an elimination order, and the two agree on everything this
        library reports about ``V(I) \\ V(g)``. The name is kept so the
        intent reads at the call site; the semantics are :meth:`saturate`'s.
        """
        return self.saturate(g, timeout=timeout)

    # -- internals -------------------------------------------------------

    def _coerce(self, value: "Poly | str") -> Poly:
        return _coerce(self._ring, value)

    def _run(self, *, gb: int, timeout: float) -> RunResult:
        return run_groebner(self.to_msolve(), gb=gb, timeout=timeout)  # type: ignore[arg-type]

    def _check_variables(self, result: RunResult) -> None:
        printed = set(result.output.variables)
        if printed != set(self._ring.names):
            raise MsolveOutputError(
                f"msolve echoed variables {sorted(printed)}, but the ring has "
                f"{sorted(self._ring.names)}"
            )

    def _leading_from(self, result: RunResult) -> tuple[tuple[int, ...], ...]:
        self._check_variables(result)
        return tuple(
            self._ring(entry).leading_monomial() for entry in result.output.basis
        )

    # -- identity --------------------------------------------------------

    def __eq__(self, other: object) -> bool:
        if not isinstance(other, Ideal):
            return NotImplemented
        return self._ring == other._ring and self._gens == other._gens

    def __hash__(self) -> int:
        return hash((self._ring, self._gens))

    def __str__(self) -> str:
        inner = ", ".join(str(g) for g in self._gens)
        return f"({inner}) in {self._ring}"

    def __repr__(self) -> str:
        return f"Ideal({[str(g) for g in self._gens]!r}, ring={self._ring!r})"

===== <function ideal_verdict at 0x739aefc1d3a0>
(gens: "'Ideal | Sequence[Poly | str]'", *, ring: "'Ring | None'" = None, opens: "'Sequence[Poly | str]'" = (), timeout: 'float' = 60) -> 'Verdict'
def ideal_verdict(
    gens: "Ideal | Sequence[Poly | str]",
    *,
    ring: "Ring | None" = None,
    opens: "Sequence[Poly | str]" = (),
    timeout: float = 60,
) -> Verdict:
    """Decide emptiness -- and dimension and degree -- for an ideal.

    :param gens: an :class:`~qqideal.Ideal`, or generators as
        :class:`~qqideal.Poly` or strings together with ``ring=``.
    :param ring: the ring, required when ``gens`` contains strings.
    :param opens: polynomials that must not vanish. The ideal is saturated at
        their product before the test, so the verdict is about
        ``V(I) \\ V(f1*..*fk)`` -- "does the system have a solution away from
        these hypersurfaces".
    :param timeout: wall-clock limit for msolve, in seconds.
    :returns: a :class:`Verdict`. Never raises for a solver failure; a msolve
        timeout or crash comes back as :attr:`Kind.TIMEOUT` or
        :attr:`Kind.ERROR`. Bad input still raises.
    """
    from .ideal import Ideal

    ideal = gens if isinstance(gens, Ideal) else Ideal(gens, ring=ring)
    if opens:
        product = ideal.ring.constant(1)
        for open_set in opens:
            product = product * ideal._coerce(open_set)
        ideal = ideal.saturate(product)
    return ideal.verdict(timeout=timeout)

===== <function witness_points at 0x739aedf90cc0>
(gens: "'Ideal | Sequence[Poly | str]'", *, ring: "'Ring | None'" = None, opens: "'Sequence[Poly | str]'" = (), timeout: 'float' = 60) -> 'Witnesses'
def witness_points(
    gens: "Ideal | Sequence[Poly | str]",
    *,
    ring: "Ring | None" = None,
    opens: "Sequence[Poly | str]" = (),
    timeout: float = 60,
) -> Witnesses:
    """Extract exact witness points, optionally away from hypersurfaces.

    :param gens: an :class:`~qqideal.Ideal`, or generators as
        :class:`~qqideal.Poly` or strings together with ``ring=``.
    :param ring: the ring, required when ``gens`` contains strings.
    :param opens: polynomials that must not vanish. The ideal is saturated at
        their product first, so the witnesses are points of
        ``V(I) \\ V(f1*..*fk)``; the slack coordinate of the Rabinowitsch
        trick is projected away and the returned points use the original
        variables.
    :param timeout: wall-clock limit for msolve, in seconds.
    :returns: a :class:`Witnesses`. Never raises for a solver failure; a
        msolve timeout or crash comes back as :attr:`WitnessKind.TIMEOUT` or
        :attr:`WitnessKind.ERROR`. Bad input still raises, and so does a
        point that fails its substitution check -- that is corrupt solver
        output, not a result.
    """
    from .ideal import Ideal

    ideal = gens if isinstance(gens, Ideal) else Ideal(gens, ring=ring)
    original = ideal.ring
    if opens:
        product = original.constant(1)
        for open_set in opens:
            product = product * ideal._coerce(open_set)
        ideal = ideal.saturate(product)

    witnesses = extract(ideal, timeout=timeout)
    if ideal.ring is original:
        return witnesses

    # Project the Rabinowitsch slack coordinate away: the saturated variety is
    # the graph of V(I) \ V(f), so dropping the slack is a bijection onto it.
    keep = tuple(ideal.ring.names.index(name) for name in original.names)
    points = witnesses.points
    if points is not None:
        points = tuple(
            dataclasses.replace(
                point,
                coordinates=tuple(point.coordinates[i] for i in keep),
            )
            for point in points
        )
        points = tuple(sorted(points, key=_point_sort_key))
    return dataclasses.replace(witnesses, points=points, variables=original.names)

===== <function emit_system at 0x739aefcbb600>
(polynomials: 'Sequence[str]', *, variables: 'Sequence[str]', characteristic: 'int' = 0) -> 'str'
def emit_system(
    polynomials: Sequence[str],
    *,
    variables: Sequence[str],
    characteristic: int = 0,
) -> str:
    """Render a polynomial system as msolve input text.

    The result is the three-part msolve file format::

        x,y
        0
        x^2+y,
        x*y-1

    Each polynomial must already be an expanded sum of monomials. Whitespace in
    the input strings is insignificant and is removed; nothing else about a
    polynomial is rewritten. Any construct msolve would mis-parse -- parentheses,
    post-monomial division, unknown identifiers, repeated monomials -- raises
    :class:`~msolveio.MsolveInputError`.

    :param polynomials: the generators, as expanded monomial sums.
    :param variables: the variable order, which msolve echoes back in its output.
    :param characteristic: ``0`` for Q, or a prime in ``2 .. 2**31 - 1``.
    :raises MsolveInputError: if anything about the system is unsafe to write.
    """
    var_tuple = _check_variables(variables)
    _check_characteristic(characteristic)

    if isinstance(polynomials, str):
        raise MsolveInputError(
            "polynomials must be a sequence of strings, not a single string"
        )
    polys = list(polynomials)
    if not polys:
        raise MsolveInputError("at least one polynomial is required")

    varset = set(var_tuple)
    rendered: list[str] = []
    total_terms = 0
    for index, poly in enumerate(polys):
        if not isinstance(poly, str):
            raise MsolveInputError(
                f"polynomial {index}: expected a string, got {type(poly).__name__}"
            )
        text, nterms = _check_polynomial(poly, index, varset, characteristic)
        rendered.append(text)
        total_terms += nterms

    # Read the bound through the module global so tests can lower it.
    bound = MAX_TERM_VAR_PRODUCT
    product = total_terms * len(var_tuple)
    if product > bound:
        raise MsolveInputError(
            f"system is too large for msolve 0.10.1: total_terms * nvars = "
            f"{total_terms} * {len(var_tuple)} = {product} exceeds {bound}"
        )

    header = ",".join(var_tuple)
    body = ",\n".join(rendered)
    return f"{header}\n{characteristic}\n{body}\n"

===== <function run_groebner at 0x739aefb98360>
(source: 'str', *, gb: 'Literal[1, 2]' = 2, timeout: 'float', threads: 'int' = 1, binary: 'str | Path | None' = None, allow_unknown_version: 'bool' = False, mode: 'Mode' = <Mode.GROEBNER: 'groebner'>) -> 'RunResult'
def run_groebner(
    source: str,
    *,
    gb: Literal[1, 2] = 2,
    timeout: float,
    threads: int = 1,
    binary: str | Path | None = None,
    allow_unknown_version: bool = False,
    mode: Mode = Mode.GROEBNER,
) -> RunResult:
    """Run msolve in Groebner mode on ``source`` and parse the result.

    :param source: msolve input text, normally from :func:`msolveio.emit_system`.
    :param gb: ``2`` for the reduced Groebner basis, ``1`` for the leading ideal.
    :param timeout: wall-clock limit in seconds. Required; there is no default,
        because an unbounded Groebner computation is not a thing to opt into by
        accident.
    :param threads: value for msolve's ``-t``.
    :param binary: path to the msolve executable. Defaults to
        ``shutil.which("msolve")``.
    :param allow_unknown_version: run anyway if the binary is not 0.10.x. The
        parser is written against 0.10.x output and may reject or misread others.
    :param mode: must be :attr:`Mode.GROEBNER`.
    :raises MsolveVersionUnsupported: if the version gate fails.
    :raises MsolveTimeout: if msolve exceeded ``timeout``.
    :raises MsolveDied: if msolve exited nonzero, took a signal, or wrote nothing.
    :raises MsolveOutputError: if msolve's output is not well-formed.
    """
    if mode is not Mode.GROEBNER:
        raise ValueError(f"unsupported mode {mode!r}; v0.1 runs Mode.GROEBNER only")
    if gb not in (1, 2):
        raise ValueError(f"gb must be 1 or 2, got {gb!r}")
    if not isinstance(threads, int) or isinstance(threads, bool) or threads < 1:
        raise ValueError(f"threads must be a positive int, got {threads!r}")
    if not isinstance(timeout, (int, float)) or isinstance(timeout, bool):
        raise TypeError(f"timeout must be a number, got {type(timeout).__name__}")
    if timeout <= 0:
        raise ValueError(f"timeout must be positive, got {timeout!r}")
    if not isinstance(source, str):
        raise TypeError(f"source must be str, got {type(source).__name__}")

    executable = _resolve_binary(binary)
    version = _check_version(executable, allow_unknown_version)

    invocation = _invoke(
        executable,
        ("-g", str(gb)),
        source,
        timeout=timeout,
        threads=threads,
        out_name="basis.out",
    )
    _check_exit(invocation.returncode, invocation.argv, invocation.stderr)
    _require_output(invocation)

    text = invocation.raw.decode("utf-8", errors="replace")
    output = parse_groebner(text, mode=mode)

    return RunResult(
        output=output,
        argv=invocation.argv,
        msolve_version=version,
        wall_seconds=invocation.wall_seconds,
        returncode=invocation.returncode,
        stderr=invocation.stderr,
        input_sha256=hashlib.sha256(invocation.payload).hexdigest(),
        output_sha256=hashlib.sha256(invocation.raw).hexdigest(),
    )

===== <function run_param at 0x739aefa0df80>
(source: 'str', *, timeout: 'float', threads: 'int' = 1, binary: 'str | Path | None' = None, precision: 'int | None' = None, genericity: 'Literal[0, 1, 2]' = 2, allow_unknown_version: 'bool' = False, mode: 'Mode' = <Mode.PARAM: 'param'>) -> 'ParamResult'
def run_param(
    source: str,
    *,
    timeout: float,
    threads: int = 1,
    binary: str | Path | None = None,
    precision: int | None = None,
    genericity: Literal[0, 1, 2] = 2,
    allow_unknown_version: bool = False,
    mode: Mode = Mode.PARAM,
) -> ParamResult:
    """Run msolve in rational-parametrization mode and parse the result.

    Runs ``msolve -P 2`` (parametrization only) by default; passing
    ``precision`` switches to ``-P 1 -p <precision>`` and additionally parses
    the exact real-root isolation boxes. Everything returned is exact; nothing
    is a float.

    :param source: msolve input text, normally from :func:`msolveio.emit_system`.
        The input variables are read from its first line; the result's
        ``chart`` maps msolve's printed order (which may be permuted or carry
        an added variable) back onto them.
    :param timeout: wall-clock limit in seconds. Required; there is no default.
    :param threads: value for msolve's ``-t``.
    :param binary: path to the msolve executable. Defaults to
        ``shutil.which("msolve")``.
    :param precision: real-root isolation precision in bits, or ``None`` (the
        default) to skip real-root isolation entirely.
    :param genericity: msolve's ``-c``. ``2`` (the default) lets msolve reorder
        variables and then add a random linear form with a new variable; both
        fixes are surfaced on the chart. ``0`` and ``1`` restrict the fixes
        and raise :class:`~msolveio.MsolveNotGeneric` when msolve gives up.
    :param allow_unknown_version: run anyway if the binary is not 0.10.x.
    :param mode: must be :attr:`Mode.PARAM`.
    :raises MsolveVersionUnsupported: if the version gate fails.
    :raises MsolveTimeout: if msolve exceeded ``timeout``.
    :raises MsolveNotGeneric: if a restricted ``genericity`` was insufficient.
    :raises MsolveDied: if msolve exited nonzero, took a signal, or wrote nothing.
    :raises MsolveOutputError: if msolve's output is not well-formed.
    :raises MsolveCharPParamUnsupported: if the input is over a prime field;
        parametrization parsing is characteristic-0 only in this release.
    """
    if mode is not Mode.PARAM:
        raise ValueError(f"unsupported mode {mode!r}; run_param runs Mode.PARAM only")
    if not isinstance(threads, int) or isinstance(threads, bool) or threads < 1:
        raise ValueError(f"threads must be a positive int, got {threads!r}")
    if not isinstance(timeout, (int, float)) or isinstance(timeout, bool):
        raise TypeError(f"timeout must be a number, got {type(timeout).__name__}")
    if timeout <= 0:
        raise ValueError(f"timeout must be positive, got {timeout!r}")
    if precision is not None and (
        not isinstance(precision, int) or isinstance(precision, bool) or precision < 1
    ):
        raise ValueError(f"precision must be a positive int or None, got {precision!r}")
    if genericity not in (0, 1, 2) or isinstance(genericity, bool):
        raise ValueError(f"genericity must be 0, 1, or 2, got {genericity!r}")
    if not isinstance(source, str):
        raise TypeError(f"source must be str, got {type(source).__name__}")

    input_variables = _input_variables(source)
    executable = _resolve_binary(binary)
    version = _check_version(executable, allow_unknown_version)

    if precision is None:
        flags = ("-P", "2")
    else:
        flags = ("-P", "1", "-p", str(precision))
    flags += ("-c", str(genericity))

    invocation = _invoke(
        executable,
        flags,
        source,
        timeout=timeout,
        threads=threads,
        out_name="param.out",
    )
    if invocation.returncode != 0 and _NOT_GENERIC_MARKER in invocation.stderr:
        raise MsolveNotGeneric(
            f"msolve could not fix the non-generic staircase under "
            f"genericity={genericity}; re-run with genericity=2 to let it add "
            f"a linear form with a new variable (the chart change is surfaced "
            f"on the result)",
            returncode=invocation.returncode,
            stderr=invocation.stderr,
        )
    _check_exit(invocation.returncode, invocation.argv, invocation.stderr)
    _require_output(invocation)

    text = invocation.raw.decode("utf-8", errors="replace")
    output = parse_param(text, mode=mode)

    chart = None
    if isinstance(output, RationalParametrization):
        if precision is not None and output.real_solutions_printed is None:
            raise MsolveOutputError(
                "real-root isolation was requested (-P 1) but msolve printed "
                "no real-solutions block"
            )
        chart = output.coordinates(input_variables)

    return ParamResult(
        output=output,
        chart=chart,
        argv=invocation.argv,
        msolve_version=version,
        wall_seconds=invocation.wall_seconds,
        returncode=invocation.returncode,
        stderr=invocation.stderr,
        input_sha256=hashlib.sha256(invocation.payload).hexdigest(),
        output_sha256=hashlib.sha256(invocation.raw).hexdigest(),
    )

===== <function parse_groebner at 0x739aefb7f6a0>
(text: 'str', *, mode: 'Mode' = <Mode.GROEBNER: 'groebner'>) -> 'GroebnerOutput'
def parse_groebner(text: str, *, mode: Mode = Mode.GROEBNER) -> GroebnerOutput:
    """Parse msolve 0.10.x Groebner-mode output.

    :param text: the contents of msolve's ``-o`` file, or its stdout.
    :param mode: must be :attr:`Mode.GROEBNER`. Present so callers can state
        which output language they believe they have; v0.1 parses no other.
    :raises MsolveAmbiguous: if the bytes look like a different msolve mode.
    :raises MsolveOutputError: if the bytes are not well-formed Groebner output.
    """
    if mode is not Mode.GROEBNER:
        raise ValueError(f"unsupported mode {mode!r}; v0.1 parses Mode.GROEBNER only")
    if not isinstance(text, str):
        raise TypeError(f"expected str, got {type(text).__name__}")

    lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    start = _first_content_line(lines)
    if start is None:
        raise MsolveOutputError("empty msolve output")

    header = lines[start].strip()
    if header.startswith(_GB_HEADER):
        leading_only = False
    elif header.startswith(_LEADING_HEADER):
        leading_only = True
    else:
        _reject_headerless(header)

    fields, body_start = _parse_header_block(lines, start)
    basis = _parse_basis(lines, body_start)

    characteristic = _require_int(fields, "field characteristic")
    variables = _require_variables(fields)
    monomial_order = _require_field(fields, "monomial order")
    _check_length(fields, basis)

    return GroebnerOutput(
        unit_ideal=basis == ("1",),
        basis=basis,
        leading_only=leading_only,
        characteristic=characteristic,
        variables=variables,
        monomial_order=monomial_order,
    )



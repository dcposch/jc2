from pathlib import Path
import re
paths=list(Path('box/moh14-charts-20260905/classes').glob('*/rows/*_V*_rows.tsv'))
term_split=re.compile(r'(?=[+-])')
ident=re.compile(r'[A-Za-z][A-Za-z0-9_]*')
powpat=re.compile(r'([A-Za-z][A-Za-z0-9_]*)\\"'^('"\\d+)')
for p in paths:
    lines=p.read_text().splitlines()
    if len(lines)<=1: continue
    linear=[]
    for i,line in enumerate(lines[1:],1):
        expr=line.split('|',4)[4].strip().strip('()')
        ok=True
        for term in term_split.split(expr):
            if not term: continue
            degree=0
            for name,e in powpat.findall(term): degree+=int(e)
            stripped=powpat.sub('',term)
            degree+=len(ident.findall(stripped))
            if degree>1: ok=False; break
        if ok: linear.append((i,len(expr),expr))
    print(p.name,'rows',len(lines)-1,'linear',len(linear))
    for x in linear[:30]: print(' ',x)

+        "builder": str(builder),
+        "rows": str(rows),
+        "rows_before": before,
+        "rows_after": after,
+        "declared_equations": declared,
+        "valid": valid,
+        "timed_out": timed_out,
+        "returncode": rc,
+        "wall_seconds": round(time.time() - started, 3),
+        "log": str(log),
+        "log_tail": text[-1000:],
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("class_id")

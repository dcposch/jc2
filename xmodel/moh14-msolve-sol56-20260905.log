+        else:
+            if not token.isdigit() or int(token) < 1:
+                raise ChartError(f"invalid --row-indices ordinal: {token!r}")
+            selected.add(int(token))
+    if not selected:
+        raise ChartError("--row-indices selects no generators")
+    return tuple(sorted(selected))

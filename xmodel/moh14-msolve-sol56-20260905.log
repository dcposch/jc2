+        ):
+            results.append({
+                "stem": stem,
+                "rows_after": existing,
+                "valid": True,
+                "reused": True,
+                "builder": str(builder),
+                "rows": str(rows),
+            })
+        else:
+            results.append(run_builder(class_dir, stem, args.timeout_per_stem))

+  +2916 a0^2 a3^4
+  -1944 a0 a1 a2 a3^3
+  +432  a0 a2^3 a3^2
+  +324  a1^2 a2^2 a3^2
+  -144  a1 a2^4 a3
+  +16   a2^6

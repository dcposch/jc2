   343	# --------------------------------------- B1: root shapes of a certified face
   344	
   345	def face_shapes(stR, enR, K, q, z0_allowed, log, tag):
   346	    """Enumerate (z0, partition) shapes of the certified face, R-level:
   347	    R = x^c' y^(d'+z0-ish) z^z0 prod (z-lam_i)^(t_i), sum t_i = zdeg - z0,
   348	    lam_i distinct nonzero.  Filter by R4 (GGV2 Prop 3.12 at the E level) and
   349	    R5 (the cut root cannot be zero).  Returns [(z0, parts)] sorted by
   350	    decreasing cut strength."""
   351	    dx, dy = enR[0] - stR[0], enR[1] - stR[1]
   352	    assert (dx, dy) == (K * dy, dy) and dy >= 1, (stR, enR, K)
   353	    zdeg = dy
   354	    out = []
   355	    for z0 in sorted(z0_allowed):
   356	        free = zdeg - z0
   357	        if free < 1:
   358	            continue
   359	        for parts in _partitions(free):
   360	            stv = (stR[0] + z0 * K, stR[1] + z0)
   361	            st_E = (q * stv[0], q * stv[1])
   362	            en_E = (q * enR[0], q * enR[1])
   363	            mults_E = [q * t for t in parts]
   364	            # nu_2 = the z-power of the edge form = the y-part of its start
   365	            ok, why = prop312_consistent(st_E, en_E, (1, -K), mults_E, st_E[1])
   366	            if not ok:
   367	                log.append(f"{tag}: shape z^{z0}*{parts} KILLED by R4: {why}")
   368	                continue
   369	            # R5 bookkeeping: if the cut root (max part t1) were zero, the true
   370	            # face start would sit z0+t1 steps up; that scenario is either an
   371	            # admitted sibling shape / covered by the post-collapse B2
   372	            # continuations (so cutting the token root is WLOG sound), or it
   373	            # was killed above, proving lambda_1 != 0 as in the paper.
   374	            t1 = max(parts)
   375	            zt = z0 + t1
   376	            if zt >= zdeg:
   377	                r5 = "degenerate face, covered by the B2 continuations"
   378	            elif zt in z0_allowed:
   379	                r5 = f"covered by the admitted sibling shape z^{zt}"
   380	            else:
   381	                r5 = f"st(R) {zt} steps up was excluded => lambda_1 != 0 proven"
   382	            log.append(f"{tag}: shape z^{z0}*{parts} admitted ({why}); R5 "
   383	                       f"(zero cut root): {r5}")
   384	            out.append((z0, tuple(parts)))
   385	    return out
   386	
   387	def _partitions(n, most=None):
   388	    if n == 0:
   389	        return [[]]
   390	    most = most or n
   391	    out = []
   392	    for k in range(min(n, most), 0, -1):
   393	        for rest in _partitions(n - k, k):
   394	            out.append([k] + rest)
   395	    return out

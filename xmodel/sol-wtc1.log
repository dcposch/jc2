   140	def case1_singles(en):
   141	    """GGV2 Prop 3.12 case (1) shapes missed by Algorithm 1: st=(c,0) with a
   142	    single nonzero root, direction (1,-K), K>=2, plus the l=1 addendum
   143	    v_{1,-2}(en) > 0."""
   144	    a, b = en
   145	    out = []
   146	    if b >= 1 and a - 2 * b > 0:                   # v_{1,-2}(en) > 0
   147	        for K in range(2, (a - 1) // b + 1):
   148	            c = a - K * b
   149	            if c >= 1:
   150	                out.append((c, 0))
   151	    return out

8645:<p id="S7.p9.12" class="ltx_p"><span id="S7.p9.12.1" class="ltx_text">and so we have <math id="S7.p9.m19" class="ltx_Math" alttext="u_{2}=\frac{sqm}{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mn>2</mn></msub><mo>=</mo><mfrac><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mi>d</mi></mfrac></mrow><annotation encoding="application/x-tex">u_{2}=\frac{sqm}{d}</annotation></semantics></math>, where <math id="S7.p9.m20" class="ltx_Math" alttext="d:=\gcd(rqm,rqm+sqm-ps,sqm,sqn)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>:=</mo><mrow><mi>gcd</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>,</mo><mrow><mrow><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>+</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></mrow><mo>−</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mrow><mo>,</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>,</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d:=\gcd(rqm,rqm+sqm-ps,sqm,sqn)</annotation></semantics></math>. Since</span></p>

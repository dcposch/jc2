   296	
   297	def apply_cut(state, fst, fen, K, q, shape, root_label):
   298	    """T-shift e_K on the certified face [fst, fen] (1/m units, direction
   299	    (1,-K)) with 1/m form x^c y^d z^(q*z0) prod_i (z-lam_i)^(q*t_i), cutting a
   300	    root of R-multiplicity t1 = max part.  shape = (z0, parts, t1).
   301	    Exact rewrite on the face; naive images elsewhere.  Returns
   302	    (new_points, new_prov, new_face_st or None-if-collapsed, residual)."""
   303	    z0, parts, t1 = shape
   304	    d_pref = fst[1]                                # y-exponent of the 1/m st
   305	    stv = (fst[0] + q * z0 * K, fst[1] + q * z0)   # actual st of this shape
   306	    new_stE = (stv[0] + q * t1 * K, stv[1] + q * t1)
   307	    rest = sorted(parts)[:-1]                      # roots left after cutting t1
   308	    pts, prov = [], set(list(state.prov))
   309	    # exact face image
   310	    if rest:                                       # face survives, shortened
   311	        pts += [new_stE, fen]
   312	        collapsed = False
   313	    elif z0 > 0 or d_pref > 0:
   314	        # full nonzero-root collapse; the y/z prefactor spans down from en
   315	        dtail = q * z0 + d_pref
   316	        pts += [fen, (fen[0] - dtail * K, fen[1] - dtail)]
   317	        collapsed = True
   318	    else:
   319	        pts.append(fen)
   320	        collapsed = True
   321	    # naive images of all off-face corners
   322	    onface = set()
   323	    seg = prim((fen[0] - fst[0], fen[1] - fst[1]))
   324	    for c in state.corners:
   325	        w = (c[0] - fst[0], c[1] - fst[1])
   326	        if cross(seg, w) == 0 and 0 <= vdir(seg, w) <= vdir(seg, (fen[0]-fst[0], fen[1]-fst[1])):
   327	            onface.add(c)                          # consumed by the rewrite
   328	    for c in state.corners:
   329	        if c in onface:
   330	            continue
   331	        pts.append(c)
   332	        if c[1] > 0:
   333	            t = (c[0] - K * c[1], 0)
   334	            if t[0] <= 0:
   335	                pts.append(t)
   336	                if t[0] < 0:
   337	                    prov.add(t)                    # provisional Laurent tail
   338	            # else: a spread toward +x is excluded: the Cor 7.4 powers at the
   339	            # intermediate directions force lattice en(R) there and the
   340	            # boundary below the apex is re-derived by R3 (design R1 note)
   341	    return pts, prov, (None if collapsed else new_stE), collapsed

12525-<p id="S8.p16.1" class="ltx_p"><span id="S8.p16.1.1" class="ltx_text ltx_font_bold">Idea of the proof:</span> We map successively <math id="S8.p16.m1" class="ltx_Math" alttext="y\mapsto y+\mu_{0}x" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo stretchy="false">↦</mo><mrow><mi>y</mi><mo>+</mo><mrow><msub><mi>μ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">y\mapsto y+\mu_{0}x</annotation></semantics></math>, then
12526:<math id="S8.p16.m2" class="ltx_Math" alttext="y\mapsto y+\mu_{1}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo stretchy="false">↦</mo><mrow><mi>y</mi><mo>+</mo><msub><mi>μ</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">y\mapsto y+\mu_{1}</annotation></semantics></math>, then <math id="S8.p16.m3" class="ltx_Math" alttext="y\mapsto y+\mu_{2}x^{-1}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo stretchy="false">↦</mo><mrow><mi>y</mi><mo>+</mo><mrow><msub><mi>μ</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">y\mapsto y+\mu_{2}x^{-1}</annotation></semantics></math> and finally <math id="S8.p16.m4" class="ltx_Math" alttext="y\mapsto y+\mu_{3}x^{-2}" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo stretchy="false">↦</mo><mrow><mi>y</mi><mo>+</mo><mrow><msub><mi>μ</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>x</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">y\mapsto y+\mu_{3}x^{-2}</annotation></semantics></math>,

   153	# --------------------------------------- R4: GGV2 Prop 3.12 consistency filter
   154	
   155	def prop312_consistent(st_E, en_E, d, mults_nonzero, zero_mult):
   156	    """GGV2 Prop 3.12 (`finitas direcciones`) as a filter, applied to the
   157	    1/m edge form E with st(E)=st_E, en(E)=en_E, direction d=(rho,sigma) in
   158	    ](0,-1),(1,-1)[, nonzero-root multiplicities mults_nonzero (list, at the
   159	    E level) and z-power zero_mult = nu_2.  Returns (ok, why)."""
   160	    rho, sigma = d
   161	    u = vdir(d, en_E)
   162	    if u <= 0:
   163	        return True, "312-na (u<=0)"              # hypotheses fail: no filter
   164	    if not (rho >= 1 and sigma <= -rho - 1):
   165	        return True, "312-na (dir outside ](0,-1),(1,-1)[)"
   166	    nu1 = en_E[1] - st_E[1]
   167	    N1 = nu1 // rho                                # gap(rho, l=1) = rho; N1 = nu1/gap
   168	    N2 = gcd(st_E[0], st_E[1])
   169	    # case (1): rho | l(=1), single nonzero root, no zero root; and l=1 =>
   170	    # v_{1,-2}(en) > 0
   171	    if rho == 1 and zero_mult == 0 and len(mults_nonzero) == 1:
   172	        if en_E[0] - 2 * en_E[1] > 0:
   173	            return True, "312-case1"
   174	    # theta candidates: t' = -theta(rho+sigma)/u must be a positive integer
   175	    def tprime_ok(theta):
   176	        t = Fraction(-theta * (rho + sigma), u)
   177	        return t > 0 and t.denominator == 1
   178	    # case (2): some nonzero-root multiplicity theta <= N1 with the direction eq
   179	    for theta in set(mults_nonzero):
   180	        if theta <= N1 and tprime_ok(theta):
   181	            return True, f"312-case2 theta={theta}"
   182	    # case (3): nu_2 > 0 and exists theta | N2 with the direction equation
   183	    if zero_mult > 0 and N2 > 0:
   184	        for theta in range(1, N2 + 1):
   185	            if N2 % theta == 0 and tprime_ok(theta):
   186	                return True, f"312-case3 theta={theta}"
   187	    return False, (f"312-kill st={st_E} en={en_E} dir={d} mults={mults_nonzero} "
   188	                   f"z^{zero_mult}: no case of GGV2 Prop 3.12 is consistent")

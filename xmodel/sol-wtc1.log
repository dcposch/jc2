   229	def reaches_axis(V, dbound, log, tag, _depth=0):
   230	    """R6 recursion: can the (pre-Laurent) lower boundary continue from the
   231	    corner V (R-units) with directions strictly below dbound until it reaches
   232	    some (c,0), c>=1?  Candidate corners per Algorithm 1 + case-(1) singles;
   233	    faces must keep v_{dir} >= 0 (the support contains (0,0))."""
   234	    c, d = V

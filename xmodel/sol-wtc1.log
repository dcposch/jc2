   122	# --------------------------------------- R3: Algorithm 1 (verbatim, l = 1)
   123	
   124	def possible_starting_points(a, b):
   125	    """GGV22 Algorithm 1 `PossibleStartingPoints` for the corner (a,b), l=1.
   126	    Returns [(c,d)] with the paper's test (s | N2 and d>0) or s <= N1."""
   127	    out = []
   128	    for d in range(0, b):
   129	        for c in range(d * a // b + 1, d + a - b):
   130	            n1 = gcd(a - c, b - d)
   131	            n2 = gcd(c, d)
   132	            rho, sigma = prim((b - d, -(a - c)))   # dir((a,b)-(c,d)), rho>0
   133	            v = rho * a + sigma * b
   134	            assert v > 0, (a, b, c, d)
   135	            s = v // gcd(v, abs(rho + sigma)) if rho + sigma != 0 else v
   136	            if (d > 0 and s > 0 and n2 % s == 0) or s <= n1:
   137	                out.append((c, d))
   138	    return out

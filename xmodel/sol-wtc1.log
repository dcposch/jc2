   334	   \]
   335	4. these corners satisfy
   336	   \[
   337	   \frac{k_f}{k_g}=\frac{l_f}{l_g}=\frac\alpha\beta,
   338	   \quad k_f<k_g,\quad l_f<l_g,\quad l_f<k_f,
   339	   \quad \frac{k_g}{k_f}=\frac\beta\alpha\notin\mathbf N;
   340	   \]

   398	
   399	def tail_resolve(V, incoming, m, n, log, depth=0):
   400	    """GGV1 Prop 8.2 at the residual vertex V=(a,b) (1/m units) whose face of
   401	    direction `incoming` = (rho1,sigma1) has en/m = V, plus GGV22's aligned
   402	    opposite-vertex analysis.  Returns list of outcomes
   403	    (extra_corners, endP, endQ, facedir): extra_corners = aligned corners
   404	    accepted on the way (none in all S4 cases)."""
   405	    a, b = V
   406	    assert incoming[0]*a + incoming[1]*b > 0, \
   407	        f"tail_resolve completeness requires v_incoming(V)>0 (REDUCE4-REVIEW rider b): {incoming} {V}"
   408	    assert a > b >= 1 and m != n, (V, m, n)
   409	    if depth > 6:
   410	        raise Stuck(f"R9 aligned recursion overflow at {V}")
   411	    out = []
   412	    # --- non-aligned: Prop 8.2(2): ends {(-k,0),(k+1,1)}, (k+1)b < a
   413	    for k in range(1, (a - 1) // b):
   414	        if (k + 1) * b >= a:
   415	            break
   416	        ends = [(-k, 0), (k + 1, 1)]
   417	        for eP, eQ in (ends, ends[::-1]):
   418	            wP = (eP[0] - m * a, eP[1] - m * b)
   419	            wQ = (eQ[0] - n * a, eQ[1] - n * b)
   420	            if cross(wP, wQ) != 0:
   421	                log.append(f"R9 at {V}: k={k} ends P->{eP} Q->{eQ} killed: "
   422	                           f"P,Q edges not parallel (cross {cross(wP, wQ)})")
   423	                continue
   424	            fd = outdir(wP)                        # outward normal (CCW st->en)
   425	            if fd == incoming:
   426	                log.append(f"R9 at {V}: k={k} ends P->{eP} Q->{eQ} killed: "
   427	                           f"its direction equals the incoming edge direction "
   428	                           f"{fd} -- different end for the same direction "
   429	                           "(GGV22 colinearity contradiction)")
   430	                continue


print("   gamma =", sp.factor(ga2), "  deg_y gamma =", sp.degree(sp.Poly(ga2,y),y))
print("   (Moh printed 'a10 = 0, gamma = (a11 x + a12)^2, deg_y gamma = 0' -> the audited")

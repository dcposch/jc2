import sympy as s
x,y=s.symbols('x y')
b=s.symbols('b1:5'); b1,b2,b3,b4=b
u=s.symbols('u1:15')
u1,u2,u3,u4,u5,u6,u7,u8,u9,u10,u11,u12,u13,u14=u
c=s.symbols('c')
h=y**3*(y-x)+b1*y**3+b2*y**2+b3*y+b4
A=s.expand((h-b4)/y)
B=s.expand((h-b3*y-b4)/y**2)
a1=u1
a2=u2*A+u3
bt2=u4*A+u5
a3=u6*A+u7*B+u8
bt3=u9*A+u10*B+u11
a4=u12*A+u13*B+u14*(y-x)
P=s.expand(h**4+a1*h**3+a2*h**2+a3*h+a4)
Q=s.expand(h**3+bt2*h+bt3)
J=s.expand(s.diff(Q,x)*s.diff(P,y)-s.diff(Q,y)*s.diff(P,x)-c*x)
poly=s.Poly(J,x,y)
print('terms P Q J',len(s.Poly(P,x,y).terms()),len(s.Poly(Q,x,y).terms()),len(poly.terms()))
print('eqs',len(poly.coeffs()),'vars',len(b)+len(u)+1,'max param total degree',max(s.Poly(e,*(list(b)+list(u)+[c])).total_degree() for e in poly.coeffs()))
# linear equations count

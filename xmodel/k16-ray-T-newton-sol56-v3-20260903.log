#!/usr/bin/env python3
"""Exact arithmetic for the descended K=16 ray.

This driver deliberately separates three layers:
  * characteristic/Def. 5.1 arithmetic;
  * Newton-face and order-filtration arithmetic;
  * the tiny monomial-Jacobian control, which is not in the ray's 4-tuple.

It does not assert existence of a polynomial pair with the ray data.
"""

from fractions import Fraction as F
from math import gcd
import sympy as sp


def def51(n, M, d, V, s, i):
    """Moh Definition 5.1(3), with one-based dictionaries."""
    num = F(n - M[i])
    den = F(n - M[s] - 1)
    for j in range(i + 1, s + 1):
        num *= V[j] * (n - M[j]) - d[j]
        den *= V[j] * (n - M[j - 1]) - d[j]
    return 1 - num / den


def major_support(delta, index):
    """Monomials gamma^a*pi^b allowed by ord C_i(sigma)>=-i*delta."""
    out = []
    for b in range(4):
        for a in range(32):
            if F(a) <= delta * (b + index) and a + b <= 4 * index:
                out.append((a, b))
    return out


def ray(t):
    assert isinstance(t, int) and t >= 1
    n, m, M2, V2, kjac = 12 * t + 4, 8 * t + 4, 12 * t + 1, 3, 1
    d2, d3 = gcd(n, m), gcd(gcd(n, m), M2)
    assert (d2, d3) == (4, 1)
    M = {1: -m, 2: M2}
    d = {1: n, 2: d2, 3: d3}
    V = {2: V2, 3: d3}
    raw = (def51(n, M, d, V, 2, 2), def51(n, M, d, V, 2, 1))
    phi = tuple((kjac + 1) * z for z in raw)
    e, q = n // d2, m // d2
    anchor_gap = n - M2 - 1
    reciprocal_N = M2 - (n - m)
    A1 = phi[1].denominator

    assert raw == (F(-1, 2), F(t, 2 * (3 * t + 1)))
    assert phi == (F(-1), F(t, 3 * t + 1))
    assert anchor_gap == 2 and reciprocal_N == m - 3
    assert F(d2, n - M2) < V2 <= F(V[3] * d2, d3)

    cond12 = ((e * V2) % A1 == 0 and (q * V2 - 1) % A1 == 0)
    cond13 = ((q * V2) % A1 == 0 and (e * V2 - 1) % A1 == 0)
    assert A1 == 3 * t + 1 and cond12 and not cond13

    face_P = ((0, n), (e, 3 * e))
    face_Q = ((0, m), (q, 3 * q))
    h_support = major_support(phi[1], 1)
    assert h_support == [(0, 0), (0, 1), (0, 2), (0, 3), (1, 3)]

    alpha_counts = [len(major_support(phi[1], i)) for i in range(1, e + 1)]
    beta_counts = [len(major_support(phi[1], i)) for i in range(2, q + 1)]
    return {
        "t": t, "n": n, "m": m, "M2": M2, "V2": V2,
        "d2": d2, "d3": d3, "e": e, "q": q,
        "raw": raw, "phi": phi, "anchor_gap": anchor_gap,
        "reciprocal_N": reciprocal_N, "A1": A1,
        "cond12": cond12, "cond13": cond13,
        "face_P": face_P, "face_Q": face_Q,
        "h_support": h_support,
        "alpha_counts": alpha_counts, "beta_counts": beta_counts,
    }


def monomial_control():
    gamma, pi = sp.symbols("gamma pi")
    f, g = pi, pi - gamma**2 / 2
    jac = sp.expand(sp.diff(f, gamma) * sp.diff(g, pi)
                    - sp.diff(f, pi) * sp.diff(g, gamma))
    # With g=eta^{-1}, f=eta^{-1}+gamma^2/2.  Thus n-1=0 and the
    # coefficient f_0 has gamma-degree 2=k+1.  Both polynomials are monic
    # of pi-degree 1, but this is not a (12t+4,8t+4) pair.
    anchor_degree = sp.degree(gamma**2 / 2, gamma)
    return jac, anchor_degree, sp.degree(f, pi), sp.degree(g, pi)


def main():
    print("K16 RAY: exact symbolic audit")
    for t in (1, 2, 3, 10):
        r = ray(t)
        print(
            "t={t}: (n,m;M2,V2)=({n},{m};{M2},{V2}), "
            "d=(4,1), (e,q)=({e},{q})".format(**r)
        )
        print("  Def51(raw)=%s; Phi=%s; anchor gap=%d; reciprocal N=%d" %
              (r["raw"], r["phi"], r["anchor_gap"], r["reciprocal_N"]))
        print("  top-face endpoints P=%s Q=%s" % (r["face_P"], r["face_Q"]))
        print("  A1=%d: (12)=%s, (13)=%s; h support=%s" %
              (r["A1"], r["cond12"], r["cond13"], r["h_support"]))
        if t == 2:
            print("  t=2 major-only coefficient counts: alpha=%s -> %d; beta=%s -> %d" %
                  (r["alpha_counts"], sum(r["alpha_counts"]),
                   r["beta_counts"], sum(r["beta_counts"])))
            print("  major-only necessary-superset unknowns = 5+60+32+1 = %d" %
                  (5 + sum(r["alpha_counts"]) + sum(r["beta_counts"]) + 1))

    jac, dx, dfpi, dgpi = monomial_control()
    print("negative 4-tuple control: (f,g)=(pi,pi-gamma^2/2)")
    print("  J(f,g)=%s; Laurent Lemma anchor degree=%s; pi-degrees=(%s,%s)" %
          (jac, dx, dfpi, dgpi))
    print("  Lemma-shape PASS; K16 4-tuple classifier FAIL")
    assert jac == sp.Symbol("gamma") and dx == 2 and (dfpi, dgpi) == (1, 1)


if __name__ == "__main__":
    main()
#!/usr/bin/env python3
"""Moh p.208 (16,12;13,3;X) order-chart saturation control.

Moh prints the chart but not its final elimination.  To avoid relying on the
apparent repeated-c5 typo in alpha_3, this driver gives the A and B terms
independent coefficients, hence tests a (slightly) larger chart.  Emptiness of
this larger c!=0 component is a valid positive control.
"""

import argparse
import sympy as sp


x, y = sp.symbols("x y")


def jac(f, g):
    return sp.diff(f, x) * sp.diff(g, y) - sp.diff(f, y) * sp.diff(g, x)


def build():
    b1, b2, b3, b4 = bs = sp.symbols("b1:5")
    z = y - x
    B = sp.expand(y * z + b1 * y + b2)
    A = sp.expand(y * B + b3)
    h = sp.expand(y * A + b4)
    u = sp.symbols("u1:15")
    (u1, u2, u3, u4, u5, u6, u7,
     u8, u9, u10, u11, u12, u13, u14) = u
    c = sp.Symbol("c")

    alpha = {
        1: u1,
        2: u2 * A + u3,
        3: u6 * A + u7 * B + u8,
        4: u12 * A + u13 * B + u14 * z,
    }
    beta = {2: u4 * A + u5, 3: u9 * A + u10 * B + u11}
    q_terms = [(sp.Integer(1), 3)] + [(beta[i], 3 - i) for i in (2, 3)]
    p_terms = [(sp.Integer(1), 4)] + [(alpha[i], 4 - i) for i in (1, 2, 3, 4)]

    by_power = {}
    for aa, r in q_terms:
        for bb, s in p_terms:
            v = jac(aa, bb)
            if v:
                by_power[r + s] = by_power.get(r + s, 0) + v
            v = s * bb * jac(aa, h) + r * aa * jac(h, bb)
            if v:
                by_power[r + s - 1] = by_power.get(r + s - 1, 0) + v

    k = 0
    while k <= max(by_power):
        quotient, remainder = sp.div(sp.expand(by_power.get(k, 0)), h, y)
        by_power[k] = sp.expand(remainder)
        if quotient != 0:
            by_power[k + 1] = by_power.get(k + 1, 0) + quotient
        k += 1

    equations = []
    for hp in sorted(by_power):
        r = by_power[hp] - (c * x if hp == 0 else 0)
        equations.extend(co for _, co in sp.Poly(sp.expand(r), x, y).terms() if co != 0)
    return list(bs) + list(u), c, equations, h


def singular(expr):
    return str(sp.expand(expr)).replace("**", "^")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--emit-singular", action="store_true")
    args = parser.parse_args()
    params, c, equations, h = build()
    if not args.emit_singular:
        print("Moh (16,12) enlarged p.208 chart")
        print("  h =", h)
        print("  parameters=%d plus c=1 -> unknowns=%d" % (len(params), len(params) + 1))
        print("  equations=%d; equation text bytes=%d" %
              (len(equations), sum(len(str(e)) for e in equations)))
        return

    T = sp.Symbol("T")
    variables = params + [c, T]
    print("// generated by moh1612_control.py --emit-singular")
    print("ring R=0,(%s),dp;" % ",".join(map(str, variables)))
    print("option(redSB);")
    print('print("MOH1612_START equations=%d unknowns=%d plus_T=1");' %
          (len(equations), len(params) + 1))
    print("ideal I=%s;" % ",\n".join([singular(e) for e in equations] + ["T*c-1"]))
    print("ideal G=std(I);")
    print('print("MOH1612_DONE basis_size=");')
    print("size(G);")
    print('if (reduce(1,G)==0) { print("MOH1612_SATURATED_EMPTY"); }'
          ' else { print("MOH1612_NONTRIVIAL"); }')
    print("G;")
    print("quit;")


if __name__ == "__main__":
    main()


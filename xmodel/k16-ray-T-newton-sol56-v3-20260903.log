def control_0_core_identical():
    """the re-derived (1)-(7) core reproduces box/moh_skeleton_N.py exactly."""
    print("\n-- CONTROL 0: re-derived (1)-(7) core == box/moh_skeleton_N.py --")
    import moh_skeleton_N as O
    bad = 0; tot = 0

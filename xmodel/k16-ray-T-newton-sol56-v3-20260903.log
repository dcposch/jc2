print("   alpha =", sp.expand(alpha.subs(s)), " ; beta =", be, " ; gamma - beta^2 =", sp.expand(ga-be**2))
print("   deg_y beta^3 =", sp.degree(sp.Poly(sp.expand(be**3), y), y), " < 5 = deg_y h")

        tot += len(a)
        if a != b: bad += 1; print("     mismatch at n=%d: %d vs %d" % (n, len(a), len(b)))
    check("census identical to moh_skeleton_N for 48<=n<=90 (%d V-assignments)" % tot, bad == 0)
    bad = 0

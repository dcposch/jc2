import sympy as sp
x, y = sp.symbols('x y')
a1,a2,a3,a4,a5,a6,a7,a8,a9,a10,a11,a12 = A_ = sp.symbols('a1:13')

B = (y**2 - x**2 + a1*y + a2*x + a3)*y + (a4*x + a5)
A = sp.expand(B*y + (a6*x + a7))
h = sp.expand(A*y + a8)

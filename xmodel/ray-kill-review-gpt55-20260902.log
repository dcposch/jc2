 EQ1 :  6 D1 r' - 4q'E1 + 2qE1' + 4C1 s' - 2C1's + 2 kappa Z = 0   [C32 (1.1)]
 EQ2 :  E2eq|_{G=0} + Delta_2                   = 0     [C32 sec.6 displays]
 EQ4 :  2(sC1 - qE1)r' + kappa E1 + q s s' - q' s^2 = 0  [C32 (2.2), from O0+E0]

    if stat.S_ISLNK(before.st_mode) or not stat.S_ISREG(before.st_mode):
        raise SealError("path is a symlink or is not a regular file")

    flags = os.O_RDONLY | getattr(os, "O_NONBLOCK", 0)
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW

   362	PYTHONDONTWRITEBYTECODE=1 python3 box/minordich-20260903/client_arithmetic.py
   363	PYTHONDONTWRITEBYTECODE=1 python3 box/minordich-20260903/census_usgt1.py \
   364	  | jq '{counts,controls,skeleton_level_decision,focus}'

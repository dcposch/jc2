def frac_text(x):
    if x is None:
        return None
    if isinstance(x, F):
        return str(x.numerator) if x.denominator == 1 else "%s/%s" % (
            x.numerator, x.denominator)
    return str(x)


def row_key(S):
    return (S.n, S.m, tuple(S.M[i] for i in range(2, S.s + 1)),
            tuple((i, S.V[i]) for i in range(2, S.s + 1)))


def group_key(S):

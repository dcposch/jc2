@@ -0,0 +1,119 @@
+#!/usr/bin/env python3
+"""Exact arithmetic for the two live u_s>1 clients.
+
+This driver deliberately separates the Definition 5.1 major radii from the
+actual minor radius delta*.  The value delta*=2 for Moh's (99,66) treatment is
+an extra Appendix-II source datum, not an output of ``skeleton()`` below.  The
+radius-3 calculations for D=108 are explicitly conditional probe arithmetic.
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+from fractions import Fraction as F
+from math import gcd
+
+
+def text(q: F) -> str:
+    return str(q.numerator) if q.denominator == 1 else str(q)
+
+
+def skeleton(n: int, m: int, mids: list[int], vs: list[int]) -> dict:
+    M = [-m] + mids
+    s = len(M)
+    d = [n]
+    for value in M:
+        d.append(gcd(d[-1], value))
+    V = {i + 2: value for i, value in enumerate(vs)}
+    V[s + 1] = d[s]
+
+    def delta(i: int) -> F:
+        num = F(n - M[i - 1])
+        den = F(n - M[s - 1] - 1)
+        for j in range(i + 1, s + 1):
+            num *= V[j] * (n - M[j - 1]) - d[j - 1]
+            den *= V[j] * (n - M[j - 2]) - d[j - 1]
+        return 1 - num / den
+
+    v_top = V[s]
+    d_top = d[s - 1]
+    u_top = d_top - v_top
+    return {
+        "n": n,
+        "m": m,
+        "s": s,
+        "M_1_to_M_s": M,
+        "d_1_to_d_splus1": d,
+        "V_2_to_V_s": vs,
+        "v_s": v_top,
+        "u_s": u_top,
+        "v_s_over_u_s": text(F(v_top, u_top)),
+        "Def5.1_major_delta_1_to_delta_s": [text(delta(i)) for i in range(1, s + 1)],
+        "Prop6.1_minor_floor": ">=1",
+        "minor_radius_from_skeleton": None,
+        "Prop6.3_if_minor_bound_holds": {
+            "g_pi_degree": u_top * n // d_top,
+            "f_pi_degree": u_top * m // d_top,
+            "Jacobian_gamma_exponent": v_top - u_top - 1,
+        },
+    }
+
+
+def probe(row: dict, radius: int) -> dict:
+    n, m = row["n"], row["m"]
+    ds, us, vs = row["d_1_to_d_splus1"][-2], row["u_s"], row["v_s"]
+    return {
+        "radius": radius,
+        "requires_minor_radius_at_least": radius,
+        "ord_g_at_probe": (n // ds) * (us * radius - vs),
+        "common_base_degree_if_distribution_detector": us,
+        "g_is_base_to_power": n // ds,
+        "f_is_base_to_power": m // ds,
+    }
+
+
+def main() -> None:
+    r99 = skeleton(99, 66, [77, 97], [8, 8])
+    r108 = skeleton(108, 72, [81, 106], [7, 7])
+    r99.update(
+        {
+            "AppendixII_actual_minor_radius": 2,
+            "Prop6.3_status_with_AppendixII_datum": "FAILS: 2 < 8/3",
+            "p209_probe": probe(r99, 2),
+            "p209_row_specific_branches": {
+                "A": "linear power: one distinct g_sigma root",
+                "B": "ninth power of a cubic with two distinct roots: counts 9+18",
+            },
+        }
+    )
+    r108.update(
+        {
+            "actual_minor_radius": None,
+            "Prop6.3_status": "UNDETERMINED",
+            "conditional_radius_3_probe": probe(r108, 3),
+            "conditional_u2_branches_if_probe_is_licensed": {
+                "A": "H has one distinct root; g_sigma is a linear 24th power",
+                "B": "H has two distinct roots; g_sigma=H^12 and counts are 12+12",
+            },
+        }
+    )
+
+    assert r99["d_1_to_d_splus1"] == [99, 33, 11, 1]
+    assert r99["Def5.1_major_delta_1_to_delta_s"] == ["4/9", "1/3", "-1"]
+    assert r99["p209_probe"]["ord_g_at_probe"] == -18
+    assert r108["d_1_to_d_splus1"] == [108, 36, 9, 1]
+    assert r108["Def5.1_major_delta_1_to_delta_s"] == ["3/8", "1/4", "-1"]
+    assert r108["conditional_radius_3_probe"]["ord_g_at_probe"] == -12
+    assert r108["Prop6.3_if_minor_bound_holds"] == {
+        "g_pi_degree": 24,
+        "f_pi_degree": 16,
+        "Jacobian_gamma_exponent": 4,
+    }
+    json.dump({"99_66": r99, "108_72": r108}, fp=sys.stdout,
+              indent=2, sort_keys=True)
+    print()
+
+
+if __name__ == "__main__":
+    main()

   322	def minor_incidence_rows(cutoff: int = 43) -> tuple[list[tuple[str, sp.Expr]], list[sp.Symbol]]:
   323	    """Substitute w=jet1*t^2+jet2*t^3+pi*t^4 through local power 8."""

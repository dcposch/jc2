        "Singular": singular_version,
        "platform": platform.platform(),
        "pid_affinity": subprocess.run(
            ["taskset", "-pc", str(Path("/proc/self").resolve().name)],
            text=True,
            capture_output=True,
        ).stdout.strip(),
        "declared_max_cores": 4,
    }



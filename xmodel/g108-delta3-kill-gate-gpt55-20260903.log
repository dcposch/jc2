   314	def z_to_w(item: TZ) -> TZ:
   315	    result: dict[tuple[int, int], sp.Expr] = defaultdict(lambda: sp.Integer(0))
   316	    for (r, q), coefficient in item.items():
   317	        for j in range(q + 1):
   318	            result[(r, j)] += coefficient * comb(q, j) * (-1) ** (q - j)
   319	    return {key: sp.expand(value) for key, value in result.items() if value != 0}

   327	    collected: dict[tuple[int, int], sp.Expr] = defaultdict(lambda: sp.Integer(0))
   328	    for (r, j), coefficient in wbasis.items():
   329	        for a in range(j + 1):
   330	            for b in range(j - a + 1):
   331	                k = j - a - b
   332	                local_power = r + 2 * a + 3 * b + 4 * k
   333	                if local_power > 8:
   334	                    continue
   335	                multinomial = factorial(j) // (factorial(a) * factorial(b) * factorial(k))
   336	                collected[(local_power, k)] += (
   337	                    coefficient * multinomial * jet1**a * jet2**b
   338	                )

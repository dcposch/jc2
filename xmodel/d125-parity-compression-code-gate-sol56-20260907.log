    53	def authority_check(authority, case, branch, observed, builder_sha):
    54	    """Pure checker permits tiny changed-host tests without touching a worker."""
    55	    require(authority.get('schema') == 'jc2.d125-small-source-authority/v1', 'authority schema')
    56	    require(authority.get('root_green') is True and authority.get('construction_only') is True,
    57	            'explicit construction-only root GREEN required')
    58	    require(isinstance(authority.get('job_id'), str) and authority['job_id'].strip(), 'registered job absent')
    59	    require(re.fullmatch(r'[0-9a-f]{64}', authority.get('registration_sha256', '')) is not None,
    60	            'registration pin absent')
    61	    require(authority.get('case') == case and authority.get('branch') == branch, 'wrong client authority')
    62	    require(observed['system'] == 'Linux' and observed['vendor'] == 'Amazon EC2', 'not Linux EC2')
    63	    require(re.fullmatch(r'i-(?:[0-9a-f]{8}|[0-9a-f]{17})', observed['instance']) is not None,
    64	            'DMI instance id invalid')
    65	    require(authority.get('instance_id') == observed['instance'], 'DMI instance mismatch')
    66	    require(authority.get('working_directory') == observed['cwd'] and
    67	            observed['cwd'].startswith('/home/ubuntu/') and
    68	            observed['cwd'] != '/home/ubuntu/', 'registered exact cwd required')
    69	    expected = {'exporter_sha256': builder_sha, 'baseline_sha256': BASELINE_SHA,
    70	                'normalization_gate_sha256': NORMALIZATION_SHA, 'lift_contract_sha256': LIFT_SHA,
    71	                'lift_gate_sha256': LIFT_GATE_SHA}
    72	    require(authority.get('pins') == expected, 'authority source pins mismatch')
    73	    caps = authority.get('caps', {})
    74	    for key, ceiling in [('wall_seconds', 600), ('cpu_seconds', 600),
    75	                         ('as_bytes', 8*1024**3), ('aggregate_output_bytes', 1024**3)]:
    76	        value = caps.get(key)
    77	        require(type(value) is int and 0 < value <= ceiling, 'missing/out-of-range cap '+key)
    78	    deadline = datetime.fromisoformat(authority.get('deadline_utc', '').replace('Z', '+00:00'))
    79	    require(deadline.tzinfo is not None, 'UTC deadline required')
    80	    remaining = deadline.timestamp()-observed['now']
    81	    require(0 < remaining <= caps['wall_seconds'], 'expired/unbounded job deadline')
    82	    return caps, remaining

   124	def jac_row(left, right, I, J, context=None):
   125	    if context is None:
   126	        require(len(left)*len(right) <= 16, 'full J requires host-bound authority')
   127	    else:
   128	        require(isinstance(context, ProductionContext), 'invalid production context')
   129	        context.check()
   130	    out = {}
   131	    for (i, j), a in sorted(left.items()):
   132	        k, l = I+1-i, J+1-j
   133	        b = right.get((k, l))
   134	        determinant = i*l-j*k
   135	        if b is None or k < 0 or l < 0 or not determinant:
   136	            continue
   137	        for am, av in a.items():
   138	            for bm, bv in b.items():
   139	                add_term(out, tuple(sorted(am+bm)), determinant*av*bv)
   140	    return out

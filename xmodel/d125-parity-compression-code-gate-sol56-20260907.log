+    fake_c, fake_r, authority, events = caller_fixture()
+    result = run_once.pipeline(fake_c, fake_r, authority, Path('unused'))
+    need(events == ['construct', 'replay'] and result['rows'] == 803, 'caller success order')
+    caller_controls += 1

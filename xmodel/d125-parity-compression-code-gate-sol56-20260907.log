   143	def lift_row(source, t, e, lambda2, lambda3, context=None):
   144	    """[u^t v^e] A(v^-1,v^4u-l2*v^2-l3*v-v^-1), exact forced d."""
   145	    require(t >= 0 and e < 0, 'negative polynomiality index required')
   146	    if context is None:
   147	        require(len(source) <= 4 and all(i+j <= 7 for i, j in source),
   148	                'full lift requires host-bound authority')
   149	    else:
   150	        require(isinstance(context, ProductionContext), 'invalid production context')
   151	        context.check()
   152	    out = {}
   153	    for (i, j), coefficient in sorted(source.items()):
   154	        require(i >= 0 and 0 <= j <= 25, 'ordinary supported source required')
   155	        if j < t:
   156	            continue
   157	        for b in range(j-t+1):
   158	            twice_d = e+i+j-5*t-3*b
   159	            if twice_d < 0 or twice_d % 2:
   160	                continue
   161	            d = twice_d//2
   162	            z = j-t-b-d
   163	            if z < 0:
   164	                continue
   165	            multiplier = FAC[j]//(FAC[t]*FAC[b]*FAC[d]*FAC[z]) * (-1)**(j-t)
   166	            lambdas = (lambda2,)*b+(lambda3,)*d
   167	            for monomial, value in coefficient.items():
   168	                add_term(out, tuple(sorted(monomial+lambdas)), multiplier*value)
   169	    return out

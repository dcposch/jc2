   320	def construct(context, singular=False):
   321	    spec = production_spec(context)
   322	    prefix = 'client-'+context.case+'-'+context.branch
   323	    budget = OutputBudget(context.caps['aggregate_output_bytes'])
   324	    json_path = Path(prefix+'.jsonl')
   325	    singular_path = Path(prefix+'.sing') if singular else None
   326	    # All outputs are exclusive; incomplete files survive any failure/cap.
   327	    with json_path.open('xb') as out:
   328	        sing = singular_path.open('xb') if singular_path else None
   329	        try:
   330	            if sing:
   331	                coefficient_ring = '(0,rho)' if context.branch == 'golden' else '0'
   332	                declaration = f'ring R={coefficient_ring},('+','.join(spec['variables'])+'),dp;\n'
   333	                if context.branch == 'golden':
   334	                    declaration += 'minpoly=rho^2-3*rho+1;\n'
   335	                budget.write(sing, (declaration+'ideal I=\n').encode())
   336	            first = True
   337	            footer = None
   338	            for record in records(spec, context):
   339	                budget.write(out, B.canonical(record))
   340	                if sing and record['type'] == 'row':
   341	                    line = ('' if first else ',\n')+'// '+record['label']+'\n'+singular_polynomial(
   342	                        record['terms'], spec['variables'], context.branch == 'golden')
   343	                    budget.write(sing, line.encode())
   344	                    first = False
   345	                if record['type'] == 'footer':
   346	                    footer = record
   347	            if sing:
   348	                ending = ';\nprint("D125_COMPLETE_LITERAL_IMPORT_ONLY");\nprint(size(I));\nquit;\n'

    85	class ProductionContext:
    86	    def __init__(self, authority_bytes, case, branch):
    87	        self.authority = strict_json(authority_bytes)
    88	        self.authority_sha = hashlib.sha256(authority_bytes).hexdigest()
    89	        observed = {'system': platform.system(),
    90	                    'vendor': Path('/sys/class/dmi/id/sys_vendor').read_text().strip(),
    91	                    'instance': Path('/sys/class/dmi/id/board_asset_tag').read_text().strip(),
    92	                    'cwd': str(Path.cwd().resolve()), 'now': time.time()}
    93	        require(sha(Path(__file__).with_name('baseline.py')) == BASELINE_SHA, 'baseline drift')
    94	        self.builder_sha = sha(__file__)
    95	        self.caps, remaining = authority_check(self.authority, case, branch, observed, self.builder_sha)
    96	        self.observed = observed
    97	        self.case, self.branch = case, branch
    98	        self.pid, self.pgid = os.getpid(), os.getpgid(0)
    99	        self.start_ticks = Path('/proc/self/stat').read_text().split(') ', 1)[1].split()[19]
   100	        self.boot_id = Path('/proc/sys/kernel/random/boot_id').read_text().strip()
   101	        self.deadline = time.monotonic()+remaining
   102	        resource.setrlimit(resource.RLIMIT_AS, (self.caps['as_bytes'], self.caps['as_bytes']))
   103	        resource.setrlimit(resource.RLIMIT_CPU, (self.caps['cpu_seconds'], self.caps['cpu_seconds']))
   104	        signal.setitimer(signal.ITIMER_REAL, remaining)
   105	
   106	    def check(self):
   107	        require(os.getpid() == self.pid and os.getpgid(0) == self.pgid, 'child identity changed')
   108	        require(str(Path.cwd().resolve()) == self.observed['cwd'], 'cwd drift')
   109	        require(time.monotonic() < self.deadline, 'construction/replay deadline reached')

   307	def singular_polynomial(terms, variables, golden):
   308	    out = []
   309	    for wire, monomial in terms:
   310	        c = B.decode(wire)
   311	        require(golden or c.b == 0, 'golden coefficient in rational ring')
   312	        coeff = f'({rational_text(c.a)}+({rational_text(c.b)})*rho)' if c.b else rational_text(c.a)
   313	        factors = [f'({coeff})']
   314	        for i, power in sorted(Counter(monomial).items()):
   315	            factors.append(variables[i] if power == 1 else f'{variables[i]}^{power}')
   316	        out.append('*'.join(factors))
   317	    return '+'.join(out) if out else '0'

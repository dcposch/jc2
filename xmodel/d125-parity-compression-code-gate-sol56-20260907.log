   350	                sing.flush()
   351	                os.fsync(sing.fileno())
   352	            out.flush()
   353	            os.fsync(out.fileno())
   354	        finally:
   355	            if sing:
   356	                sing.close()
   357	    verify_stream(json_path, spec, context)
   358	    context.check()
   359	    manifest = {'status': 'CONSTRUCTION_AND_SAME_FORMULA_REPLAY_COMPLETE',
   360	                'authority_sha256': context.authority_sha, 'pins': context.authority['pins'],
   361	                'identity': {'pid': context.pid, 'pgid': context.pgid, 'start_ticks': context.start_ticks,
   362	                             'boot_id': context.boot_id, **context.observed},

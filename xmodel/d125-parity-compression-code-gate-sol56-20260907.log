    35	def sha(path):
    36	    digest = hashlib.sha256()
    37	    with Path(path).open('rb') as stream:
    38	        for block in iter(lambda: stream.read(1024*1024), b''):
    39	            digest.update(block)
    40	    return digest.hexdigest()

   303	class Stream:
   304	    def __init__(self, path, cap):
   305	        self.file = open(path, 'xb')
   306	        self.cap, self.used = cap, 0
   307	        self.digest = hashlib.sha256()
   308	
   309	    def emit(self, record):
   310	        # Conservative pre-serialization bound covers decimal rational strings
   311	        # and monomial indices. Generic metadata is uniformly small here.
   312	        if 'terms' in record:
   313	            estimate = 256+len(record.get('label', ''))
   314	            for coefficient, monomial in record['terms']:
   315	                estimate += 64+sum(len(v) for part in coefficient for v in part)+12*len(monomial)
   316	            need(self.used+estimate <= self.cap, 'pre-serialization byte ceiling')
   317	        data = B.canonical(record)
   318	        need(self.used+len(data) <= self.cap, 'aggregate output byte cap')
   319	        self.file.write(data)
   320	        self.used += len(data)
   321	        self.digest.update(data)
   322	
   323	    def polynomial(self, record, poly):
   324	        # Check before converting rational integers to decimal strings or
   325	        # allocating wire lists. log10(2)<1/3, and IDs here are at most268.
   326	        estimate = 512+len(record.get('label', ''))+len(record.get('name', ''))

   181	def payload(spec, context=None):
   182	    """Shared literal record formula; access only through guarded records()."""
   183	    yield {'type': 'header', **spec['header']}
   184	    for index, name in enumerate(spec['variables']):
   185	        yield {'type': 'variable', 'id': index, 'name': name}
   186	    for who, entries in zip(('A', 'B'), spec['maps']):
   187	        for entry in entries:
   188	            yield {'type': 'coefficient', 'member': who, **entry}
   189	    for who, entries in zip(('A', 'B'), spec['maps']):
   190	        for entry in entries:
   191	            if 'fixed' in entry:
   192	                yield row_record('FIX/'+entry['name'], {}, 'fixed_assignment')
   193	    for I, J in spec['jac_indices']:
   194	        out = jac_row(*spec['sources'], I, J, context)
   195	        if (I, J) == (2, 0):
   196	            for m, c in spec['scalar'].items():
   197	                add_term(out, m, -c)
   198	        yield row_record(f'J/{I}/{J}', out, 'jacobian')
   199	    for who, source, degree in zip(('A', 'B'), spec['sources'], spec['degrees']):
   200	        for t, e in negative_indices(degree):
   201	            yield row_record(f'LIFT/{who}/{t}/{e}',
   202	                             lift_row(source, t, e, *spec['lambda_ids'], context), 'polynomiality')
   203	    for guard in spec['guards']:
   204	        value, inverse = B.decode(guard['value']), B.decode(guard['inverse'])
   205	        require(value != B.ZERO and value*inverse == B.ONE, 'bad fixed vertex guard')
   206	        yield {**row_record(guard['label'], {}, 'fixed_unit_guard'),
   207	               'value': guard['value'], 'inverse': guard['inverse']}
   208	    yield row_record('GUARD/c', spec['scalar_guard'], 'scalar_guard')

   293	class OutputBudget:
   294	    def __init__(self, limit):
   295	        self.limit, self.used = limit, 0
   296	
   297	    def write(self, stream, data):
   298	        require(self.used+len(data) <= self.limit, 'aggregate output cap')
   299	        stream.write(data)
   300	        self.used += len(data)

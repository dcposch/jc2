    43	def strict_json(data):
    44	    def unique(pairs):
    45	        out = {}
    46	        for k, v in pairs:
    47	            require(k not in out, 'duplicate JSON key')
    48	            out[k] = v
    49	        return out
    50	    return json.loads(data, object_pairs_hook=unique)

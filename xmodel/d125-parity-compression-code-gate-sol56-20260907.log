   366	                             'bytes': singular_path.stat().st_size, 'sha256': sha(singular_path)},
   367	                'independent_certification': False, 'cas_executed': False}
   368	    with Path(prefix+'.manifest.json').open('xb') as out:
   369	        budget.write(out, B.canonical(manifest))
   370	        out.flush()
   371	        os.fsync(out.fileno())
   372	    return manifest

        sq5=y*y+6*y-1-sum(v*v for v in b)
        if sq3+x-1<0 or (sq3+x-1)%2:
            continue
        if sq5+y-3<0 or (sq5+y-3)%2:
            continue
        if sum(ai*bi for ai,bi in zip(a,b)) != x*y+3*x+2*y-2:

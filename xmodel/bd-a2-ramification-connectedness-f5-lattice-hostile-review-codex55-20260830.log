from itertools import combinations, product
U=range(8)
subs=[frozenset(c) for c in combinations(U,4)]

def check_case(x,y,leaves):
    c=[sum(nu for nu,K in leaves if j in K) for j in U]
    sols=[]
    for a in product(range(3), repeat=8):
        b=tuple(2-c[j]-a[j] for j in U)
        if any(v<0 or v>2 for v in b):
            continue
        if sum(a)"'!=4*x or sum(b)!=4*y:

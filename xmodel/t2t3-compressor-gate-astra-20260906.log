    27	class T2Certificate(DirectChart):
    28	    def __init__(self, tag: str, output: Path, face_indices: list[int] | None = None):
    29	        self.face_indices = list(range(EXPECTED[tag]["D2"] + 1)) if face_indices is None else sorted(set(face_indices))
    30	        if not self.face_indices or self.face_indices[0] < 0 or self.face_indices[-1] > EXPECTED[tag]["D2"]:
    31	            raise ValueError("face indices must be a nonempty subset of 0..D2")
    32	        self.complete_face = self.face_indices == list(range(EXPECTED[tag]["D2"] + 1))

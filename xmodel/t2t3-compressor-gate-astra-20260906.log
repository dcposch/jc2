+    "semantic_variable_count": 449,
+    "emitted_generator_count": 466,
+    "expanded_term_count": 6448959,
+    "semantic_variable_order_sha256": "ee778e93b4293b9399761911d80dd71dd63b5fa95d21055cf50cd0db51428a4b",

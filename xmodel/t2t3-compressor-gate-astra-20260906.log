    38	        H = self.add((h, 1), ({(self.k, 0): b}, -self.C("1/6")))
    39	        v = self.add(
    40	            (D, 1),
    41	            ({(2 * self.k - 1, 0): a / 3 + b * b / 18}, 1),
    42	        )
    43	        V = self.add(
    44	            (C, 1),
    45	            (self.shift(D, self.k), -b / 4),
    46	            ({(3 * self.k - 1, 0): a * b / 12 + b**3 / 54 - c / 2}, 1),
    47	        )
    48	        assert min(r for r, _ in V) >= 1
    49	        U = self.shift(V, -1, scalar=self.C("8/3"))
    50	        Rraw = self.add((self.mul(v, v), 1), (self.mul(U, H), -1))
    51	        Rlow = {}
    52	        for (r, z), value in sorted(Rraw.items()):
    53	            if z >= self.k:
    54	                self.raw_row("T2_upper", f"T2_Rhigh_{r}_{z}", value)

   401	After this substitution, Q's h^4 coefficient is
   402	`L4=3D-2A+a`; all remaining terms have y-degree strictly less than 4k.
   403	Since `deg_y L4<k`, a nonzero L4 would give degree at least 4k.
   404	Therefore L4=0. This proves (**).
   405	
   406	These implications have coefficient-level certificates: eliminate
   407	C's y-coefficients from the top down, with rational leader 3; then the
   408	constant-y row sets `3C+b=0`, including all x-coefficients. Eliminate
   409	the coefficients of `3D-2A+a` from the top down with leader -2 on A.
   410	No branch is removed. Both clients have D_2<4k, so the reductions
   411	apply. They must be attached to their high-y-degree rows, not promoted
   412	as independent source gauges.
   413	
   414	There is a further exact reduction (independently checked by symbolic
   415	expansion). Write `B=A3`, `D=B2` after (**), and set
   416	
   417	\[
   418	\mathcal A=a+b^2/4,\quad H=h-b/6,\quad
   419	v=D+a/3+b^2/18,
   420	\]
#!/usr/bin/env python3
"""Small exact-integer audit for the T2/T3 defect arithmetic and supports."""
from __future__ import annotations

import hashlib
import json
import math
from pathlib import Path


HERE = Path(__file__).resolve().parent


def lines_hash(values):
    return hashlib.sha256("".join(f"{v}\n" for v in values).encode()).hexdigest()


def arithmetic(n, m, M):
    d = [n]
    seen = [n]
    for value in M:
        seen.append(value)
        d.append(math.gcd(*seen))
    ratios = [d[i] // d[i + 1] for i in range(len(d) - 1)]
    q = [M[0]] + [M[i] - M[i - 1] for i in range(1, len(M))]
    Lambda = []
    running = 0
    for qi, di in zip(q, d):
        running += qi * di
        Lambda.append(running)
    D = [-Lambda[i] // d[i] for i in range(len(M))]
    assert all(Lambda[i] % d[i] == 0 for i in range(len(M)))
    return {"n": n, "m": m, "M": M, "d": d, "n_i": ratios,
            "q": q, "Lambda": Lambda, "D": D}


cases = {
    "99": arithmetic(99, 66, [-66, 77, 97]),
    "108": arithmetic(108, 72, [-72, 81, 106]),
}

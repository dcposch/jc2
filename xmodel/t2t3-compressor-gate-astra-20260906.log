   215	        return fmpq_mpoly(str(value).replace("**", "^"), ctx=self.ctx)
   216	
   217	    def var(self, name: str):
   218	        return self.gens[self.index[name]]
   219	
   220	    @staticmethod
   221	    def add(*tables):
   222	        out = {}
   223	        for table, scalar in tables:
   224	            for pos, value in table.items():
   225	                term = value * scalar
   226	                out[pos] = term if pos not in out else out[pos] + term
   227	                if not out[pos]:
   228	                    del out[pos]
   229	        return out
   230	
   231	    def shift(self, table, dr=0, dz=0, scalar=1, cap=None):
   232	        scalar = self.C(scalar)
   233	        return {
   234	            (r + dr, z + dz): value * scalar
   235	            for (r, z), value in table.items()
   236	            if cap is None or r + dr <= cap
   237	        }
   238	
   239	    def mul(self, left, right, cap=None):
   240	        out = {}
   241	        for (r, z), a in left.items():
   242	            for (s, w), b in right.items():
   243	                if cap is not None and r + s > cap:
   244	                    continue
   245	                pos = (r + s, z + w)
   246	                term = a * b
   247	                out[pos] = term if pos not in out else out[pos] + term
   248	                if not out[pos]:
   249	                    del out[pos]
   250	        return out
   251	
   252	    def power(self, table, exponent, cap=None):
   253	        answer = {(0, 0): self.one}
   254	        base = table
   255	        power = exponent
   256	        while power:
   257	            if power & 1:
   258	                answer = self.mul(answer, base, cap)
   259	            power //= 2
   260	            if power:
   261	                base = self.mul(base, base, cap)
   262	        return answer
   263	
   264	    @staticmethod
   265	    def support_mul(left, right, cap=None):
   266	        out = set()
   267	        for r, z in left:
   268	            for s, w in right:
   269	                if cap is None or r + s <= cap:
   270	                    out.add((r + s, z + w))
   271	        return out
   272	
   273	    def coefficient_mul(self, left, right, position):
   274	        """One coefficient of a series product, with immediate cancellation."""
   275	        target_r, target_z = position
   276	        answer = self.zero
   277	        # Iterate the smaller support; dictionary lookup avoids a full product
   278	        # table and, critically, combines the six Q* summands coefficientwise.
   279	        if len(left) > len(right):
   280	            left, right = right, left
   281	        for (r, z), value in left.items():
   282	            mate = right.get((target_r - r, target_z - z))
   283	            if mate is not None:
   284	                answer += value * mate
   285	        return answer
   286	
   287	    @staticmethod
   288	    def shifted_support(support, dr=0, dz=0, cap=None):
   289	        return {
   290	            (r + dr, z + dz) for r, z in support
   291	            if cap is None or r + dr <= cap
   292	        }
   293	
   294	    def map_table(self, rows):
   295	        out = {}
   296	        for r, z, expression in rows:
   297	            pos = (int(r), int(z))
   298	            assert pos not in out
   299	            value = self.C(expression)
   300	            if value:
   301	                out[pos] = value
   302	        return out
   303	
   304	    def string_table(self, text):
   305	        out = {}
   306	        for piece in split_top(text):
   307	            match = TERM.fullmatch(piece)
   308	            if not match:
   309	                raise ValueError("unparsed normalized term: " + piece[:180])
   310	            expression, r, z = match.groups()
   311	            pos = (int(r), int(z))
   312	            assert pos not in out
   313	            value = self.C(expression)
   314	            if value:
   315	                out[pos] = value
   316	        return out
   317	
   318	    def source_series(self):
   319	        if self.tag.startswith("99-"):
   320	            maps = self.data["maps"]
   321	            assert {"h3", "C2", "C3", "B2", "A3"} <= set(maps)
   322	            h3 = self.map_table(maps["h3"])
   323	            c2 = self.map_table(maps["C2"])
   324	            c3 = self.map_table(maps["C3"])
   325	            h = self.add((self.power(h3, 3), 1), (self.mul(c2, h3), 1), (c3, 1))
   326	            D = self.map_table(maps["B2"])
   327	            C = self.map_table(maps["A3"])
   328	            assert (len(h), len(D), len(C)) == (178, 194, 201)
   329	            expected = {24 + i: self.ctx.constant(math.comb(9, i)) for i in range(10)}
   330	        else:
   331	            h = self.string_table(self.data["h_expr"])
   332	            D = self.string_table(self.data["D_expr"])
   333	            C = self.string_table(self.data["C_expr"])
   334	            assert (len(h), len(D), len(C)) == (185, 191, 197)
   335	            expected = {28 + i: self.ctx.constant(math.comb(8, i)) for i in range(9)}
   336	        actual = {z: value for (r, z), value in h.items() if r == 0}
   337	        assert actual == expected
   338	        return h, D, C
   339	
   340	    def site(self, name: str):
   341	        if name in self.inverse_names:
   342	            return (0, 0)
   343	        match = SITE.search(name)
   344	        if match:
   345	            return (int(match.group(1)), int(match.group(2)))
   346	        if name == "E82":
   347	            return (8, 2)
   348	        targets = {
   349	            "target_b": self.k, "target_a": 2 * self.k,
   350	            "target_c": 3 * self.k, "target_d": 4 * self.k,
   351	            "target_e": 6 * self.k,
   352	        }
   353	        if name in targets:
   354	            return (targets[name], 0)
   355	        if name == self.spec["lam2"]:
   356	            return (self.lead + 2, self.D2)
   357	        if name == "lambda3":
   358	            return (self.n2 * (self.lead + 2) + self.defect, self.D3)
   359	        if name == "t3eq":
   360	            return (self.n2 * (self.lead + 2), 0)
   361	        if name == "t3_fq":
   362	            return (11, 0)
   363	        if name == "t3_fgq":
   364	            return (9, 0)
   365	        if name == "t3_fq2":
   366	            return (18, 0)
   367	        conventions = {
   368	            "u": (2, 0), "v": (1, 0), "rho": (3, 0), "c": (2, 0),
   369	            "minor_a2": (3, 0), "minor_mean": (1, 0),
   370	            "jet0": (1, 0), "jet1": (2, 0), "jet2": (3, 0),
   371	        }
   372	        return conventions.get(name, (1, 0))
   373	
   374	    def make_order_matrix(self):
   375	        """Two site rows followed by an identity completion.
   376	
   377	        The matrix acts only on noninverse variables.  Its first two rows are
   378	        r and z.  Every r is positive, so the block is global.  Omitting two
   379	        identity rows at columns with a nonzero 2x2 site minor makes the square
   380	        matrix full rank.  The three inverse variables form a final dp block.
   381	        """
   382	        n = self.noninverse_count
   383	        rrow = [self.sites[i][0] for i in range(n)]
   384	        zrow = [self.sites[i][1] for i in range(n)]
   385	        omitted = None
   386	        determinant = 0
   387	        for i in range(n):
   388	            for j in range(i + 1, n):
   389	                determinant = rrow[i] * zrow[j] - rrow[j] * zrow[i]
   390	                if determinant:
   391	                    omitted = (i, j)
   392	                    break
   393	            if omitted:
   394	                break
   395	        if omitted is None:
   396	            raise RuntimeError("site vectors have rank below two")
   397	        rows = [rrow, zrow]
   398	        for column in range(n):
   399	            if column in omitted:
   400	                continue
   401	            row = [0] * n
   402	            row[column] = 1
   403	            rows.append(row)
   404	        assert len(rows) == n
   405	        flat = [entry for row in rows for entry in row]
   406	        return flat, {
   407	            "columns": [self.names[i] for i in omitted],
   408	            "indices": list(omitted),
   409	            "determinant": determinant,
   410	        }
   411	
   412	    def write_headers(self):
   413	        n = self.noninverse_count
   414	        matrix_text = ",".join(str(value) for value in self.order_matrix)
   415	        self.sing.write(
   416	            f"ring R=0,({','.join(self.names)}),(M({matrix_text}),dp(3));\n"
   417	            "option(redSB);\n"
   418	            "ideal I=\n"
   419	        )
   420	        self.ms.write(",".join(self.aliases) + "\n")
   421	        self.ms.write(str(self.PRIME) + "\n")
   422	        self.labels.write("emitted_index\tblock\tlabel\tterms\tprimitive_sha256\n")
   423	        assert len(self.order_matrix) == n * n
   424	
   425	    def raw_row(self, block: str, label: str, polynomial):
   426	        self.raw_counts[block] += 1
   427	        self.raw_label_sha.update(label.encode())
   428	        self.raw_label_sha.update(b"\n")
   429	        polynomial = self.C(polynomial)
   430	        if not polynomial:
   431	            self.zero_counts[block] += 1
   432	            return
   433	        self.emit_row(block, label, polynomial)
   434	
   435	    def emit_row(self, block: str, label: str, polynomial):
   436	        terms_count = len(polynomial)
   437	        assert terms_count > 0
   438	        denominator = 1
   439	        first_pair = None
   440	        pair_homogeneous = True
   441	        total_degree = 0
   442	        for monomial, coefficient in polynomial.terms():
   443	            denominator = math.lcm(denominator, int(coefficient.denominator))
   444	            rcharge = sum(exp * self.sites[i][0] for i, exp in enumerate(monomial) if exp)
   445	            zcharge = sum(exp * self.sites[i][1] for i, exp in enumerate(monomial) if exp)
   446	            pair = (rcharge, zcharge)
   447	            if first_pair is None:
   448	                first_pair = pair
   449	            elif pair != first_pair:
   450	                pair_homogeneous = False
   451	            total_degree = max(total_degree, sum(monomial))
   452	        common = 0
   453	        first_integer = None
   454	        for _, coefficient in polynomial.terms():
   455	            integer = int(coefficient * denominator)
   456	            if first_integer is None:
   457	                first_integer = integer
   458	            common = math.gcd(common, abs(integer))
   459	        assert first_integer and common
   460	        sign_scale = -1 if first_integer < 0 else 1
   461	
   462	        if self.row_count:
   463	            self.sing.write(",\n")
   464	            self.ms.write(",\n")
   465	        row_sha = hashlib.sha256()
   466	        self.canonical_sha.update(b"GENERATOR\n")
   467	        first = True
   468	        for monomial, coefficient in polynomial.terms():
   469	            integer = sign_scale * (int(coefficient * denominator) // common)
   470	            assert integer
   471	            sign = "-" if integer < 0 else ("" if first else "+")
   472	            if integer > 0 and not first:
   473	                sign = "+"
   474	            magnitude = abs(integer)
   475	            original_factors = []
   476	            alias_factors = []
   477	            support = []
   478	            for index, exponent in enumerate(monomial):
   479	                if not exponent:
   480	                    continue
   481	                support.append(f"{index}^{exponent}")
   482	                if exponent == 1:
   483	                    original_factors.append(self.names[index])
   484	                    alias_factors.append(self.aliases[index])
   485	                else:
   486	                    original_factors.append(f"{self.names[index]}^{exponent}")
   487	                    alias_factors.append(f"{self.aliases[index]}^{exponent}")
   488	            original_body = "*".join(original_factors) or "1"
   489	            alias_body = "*".join(alias_factors) or "1"
   490	            if magnitude != 1:
   491	                original_body = f"{magnitude}*{original_body}"
   492	                alias_body = f"{magnitude}*{alias_body}"
   493	            original_piece = sign + original_body
   494	            alias_piece = sign + alias_body
   495	            self.sing.write(original_piece)
   496	            self.ms.write(alias_piece)
   497	            encoded = original_piece.encode()
   498	            self.generator_text_sha.update(encoded)
   499	            row_sha.update(encoded)
   500	            self.canonical_sha.update(f"{integer}:{','.join(support)}\n".encode())
   501	            first = False
   502	        self.generator_text_sha.update(b"\n")
   503	        self.canonical_sha.update(b"END\n")
   504	
   505	        self.row_count += 1
   506	        self.emitted_counts[block] += 1
   507	        self.emitted_label_sha.update(label.encode())
   508	        self.emitted_label_sha.update(b"\n")
   509	        self.total_terms += terms_count
   510	        self.max_terms = max(self.max_terms, (terms_count, label))
   511	        self.max_total_degree = max(self.max_total_degree, total_degree)
   512	        if pair_homogeneous:
   513	            self.homogeneous_pair_count += 1
   514	        else:
   515	            self.nonhomogeneous_pair_count += 1
   516	            if len(self.nonhomogeneous_examples) < 8:
   517	                self.nonhomogeneous_examples.append(label)
   518	        self.labels.write(
   519	            f"{self.row_count - 1}\t{block}\t{label}\t{terms_count}\t{row_sha.hexdigest()}\n"
   520	        )
   521	        if self.row_count % 100 == 0:
   522	            print(
   523	                f"EMIT_PROGRESS case={self.tag} rows={self.row_count} terms={self.total_terms} "
   524	                f"block={block} rssKiB={resource.getrusage(resource.RUSAGE_SELF).ru_maxrss}",
   525	                flush=True,
   526	            )
   527	
   528	    def build(self):
   529	        h, D, C = self.source_series()
   530	        a, b, c, d = [self.var("target_" + letter) for letter in "abcd"]
   531	        H = self.add((h, 1), ({(self.k, 0): b}, -self.C("1/6")))
   532	        v = self.add(
   533	            (D, 1),
   534	            ({(2 * self.k - 1, 0): a / 3 + b * b / 18}, 1),
   535	        )
   536	        V = self.add(
   537	            (C, 1),
   538	            (self.shift(D, self.k), -b / 4),
   539	            ({(3 * self.k - 1, 0): a * b / 12 + b**3 / 54 - c / 2}, 1),
   540	        )
   541	        assert min(r for r, _ in V) >= 1
   542	        U = self.shift(V, -1, scalar=self.C("8/3"))
   543	        Rraw = self.add((self.mul(v, v), 1), (self.mul(U, H), -1))
   544	        print(
   545	            f"BUILD_PROGRESS case={self.tag} phase=R support={len(Rraw)} "
   546	            f"rssKiB={resource.getrusage(resource.RUSAGE_SELF).ru_maxrss}", flush=True,
   547	        )
   548	        Rlow = {}
   549	        for (r, z), value in sorted(Rraw.items()):
   550	            if z >= self.k:
   551	                self.raw_row("T2_upper", f"T2_Rhigh_{r}_{z}", value)
   552	            else:
   553	                Rlow[(r, z)] = value
   554	
   555	        for index, expression in enumerate(self.residuals):
   556	            self.raw_row("source_residual", f"source_residual_{index}", self.C(expression))
   557	
   558	        HH = self.mul(H, H, self.qcap - min(r for r, _ in Rlow))
   559	        vU = self.mul(v, U, self.qcap - 1)
   560	        pp = d + b * c / 2 - (a + b * b / 4) ** 2 / 3
   561	        support_RHH = self.support_mul(Rlow, HH, self.qcap)
   562	        support_vUH = self.support_mul(vU, H, self.qcap - 1)
   563	        support_vR = self.support_mul(v, Rlow, self.qcap - 1)
   564	        support_UU = self.support_mul(U, U, self.qcap - 2)
   565	        q_support = set(support_RHH)
   566	        q_support |= self.shifted_support(support_vUH, 1, cap=self.qcap)
   567	        q_support |= self.shifted_support(support_vR, 1, cap=self.qcap)
   568	        q_support |= self.shifted_support(support_UU, 2, cap=self.qcap)
   569	        q_support |= self.shifted_support(HH, 4 * self.k - 2, cap=self.qcap)
   570	        q_support |= self.shifted_support(v, 4 * self.k - 1, cap=self.qcap)
   571	        need = q_support | {(self.lead, z) for z in range(self.D2 + 1)}
   572	        Qjet = {}
   573	        for r, z in sorted(need):
   574	            value = self.zero
   575	            if (r, z) in support_RHH:
   576	                value += self.coefficient_mul(Rlow, HH, (r, z)) * self.C("3/4")
   577	            if (r - 1, z) in support_vUH:
   578	                value += self.coefficient_mul(vU, H, (r - 1, z)) * self.C("-1/8")
   579	            if (r - 1, z) in support_vR:
   580	                value += self.coefficient_mul(v, Rlow, (r - 1, z))
   581	            if (r - 2, z) in support_UU:
   582	                value += self.coefficient_mul(U, U, (r - 2, z)) * self.C("-9/64")
   583	            value += HH.get((r - (4 * self.k - 2), z), self.zero) * pp
   584	            value += v.get((r - (4 * self.k - 1), z), self.zero) * pp
   585	            if r < self.lead:
   586	                self.raw_row("T2_strict", f"T2_strict_{r}_{z}", value)
   587	                continue
   588	            delta = r - self.lead
   589	            if value:
   590	                Qjet[(delta, z)] = value
   591	            if delta == 0:
   592	                if self.spec["t2z"] <= z <= self.D2:
   593	                    target = math.comb(self.spec["t2p"], z - self.spec["t2z"]) * self.var(self.spec["lam2"])
   594	                else:
   595	                    target = self.zero
   596	                self.raw_row("T2_face", f"T2_face_{z}", value - target)
   597	            elif z > self.D2 - delta:
   598	                self.raw_row("T2_support", f"T2_support_{delta}_{z}", value)
   599	        print(
   600	            f"BUILD_PROGRESS case={self.tag} phase=Q support={len(q_support)} jet={len(Qjet)} "
   601	            f"rows={self.row_count} terms={self.total_terms} "
   602	            f"rssKiB={resource.getrusage(resource.RUSAGE_SELF).ru_maxrss}", flush=True,
   603	        )
   604	
   605	        ht = {pos: value for pos, value in h.items() if pos[0] <= self.defect}
   606	        F = self.mul(self.mul(ht, ht, self.defect), ht, self.defect)
   607	        G = self.mul(ht, ht, self.defect)
   608	        Qsq = self.mul(Qjet, Qjet, self.defect)
   609	        if self.n2 == 3:
   610	            FG = self.mul(F, G, self.defect)
   611	            FQ = self.mul(F, Qjet, self.defect - 11)
   612	            T3 = self.add(
   613	                (self.mul(Qsq, Qjet, self.defect), 1),
   614	                (FG, self.var("t3eq")),
   615	                (self.shift(FQ, 11, scalar=self.var("t3_fq")), 1),
   616	            )
   617	        else:
   618	            Qfour = self.mul(Qsq, Qsq, self.defect)
   619	            Gsq = self.mul(G, G, self.defect)
   620	            FG2 = self.mul(F, Gsq, self.defect)
   621	            FG = self.mul(F, G, self.defect - 9)
   622	            FGQ = self.mul(FG, Qjet, self.defect - 9)
   623	            FQ2 = self.mul(F, Qsq, self.defect - 18)
   624	            T3 = self.add(
   625	                (Qfour, 1),
   626	                (FG2, self.var("t3eq")),
   627	                (self.shift(FGQ, 9, scalar=self.var("t3_fgq")), 1),
   628	                (self.shift(FQ2, 18, scalar=self.var("t3_fq2")), 1),
   629	            )
   630	        self.raw_row(
   631	            "T3_recurrence", "T3_equality_coefficient",
   632	            self.var("t3eq") + self.var(self.spec["lam2"]) ** self.n2,
   633	        )
   634	        for (r, z), value in sorted(T3.items()):
   635	            if r < self.defect:
   636	                self.raw_row("T3_strict", f"T3_strict_{r}_{z}", value)
   637	        face_z = set(range(self.D3 + 1)) | {z for (r, z) in T3 if r == self.defect}
   638	        for z in sorted(face_z):
   639	            value = T3.get((self.defect, z), self.zero)
   640	            if self.spec["t3z"] <= z <= self.D3:
   641	                target = math.comb(self.spec["t3p"], z - self.spec["t3z"]) * self.var("lambda3")
   642	            else:
   643	                target = self.zero
   644	            self.raw_row("T3_face", f"T3_face_{z}", value - target)
   645	        self.raw_row("inverse", "inverse_T2", self.var(self.spec["zlam2"]) * self.var(self.spec["lam2"]) - 1)
   646	        self.raw_row("inverse", "inverse_T3", self.var("Z3") * self.var("lambda3") - 1)
   647	        self.raw_row("inverse", "inverse_separation", self.var(self.spec["zsep"]) * self.var(self.spec["sep"]) - 1)
   648	        print(
   649	            f"BUILD_PROGRESS case={self.tag} phase=T3 support={len(T3)} "
   650	            f"rows={self.row_count} terms={self.total_terms} "
   651	            f"rssKiB={resource.getrusage(resource.RUSAGE_SELF).ru_maxrss}", flush=True,
   652	        )
   653	        self.finish(h, D, C, q_support, Qjet, F, G, T3)
   654	
   655	    def finish(self, h, D, C, Q, Qjet, F, G, T3):
   656	        actual_raw = {key: self.raw_counts[key] for key in self.spec["raw_counts"]}
   657	        actual_nonzero = {key: self.emitted_counts[key] for key in self.spec["nonzero_counts"]}
   658	        assert actual_raw == self.spec["raw_counts"], (actual_raw, self.spec["raw_counts"])
   659	        assert self.raw_counts["T2_support"] == 0
   660	        assert actual_nonzero == self.spec["nonzero_counts"], (actual_nonzero, self.spec["nonzero_counts"])
   661	        assert self.row_count == sum(self.spec["nonzero_counts"].values())
   662	        msolve_offset_safe = self.total_terms * len(self.names) < self.MSOLVE_OFFSET_LIMIT
   663	
   664	        self.sing.write(
   665	            ";\n"
   666	            'print("ALL_ROWS_PARSED");\n'
   667	            'print("BEGIN_STD");\n'
   668	            "ideal G=std(I);\n"
   669	            'print("END_STD");\n'
   670	            'print("BEGIN_RESULT");\n'
   671	            'print("REDUCE_ONE="+string(reduce(1,G)));\n'
   672	            'print("DIMENSION="+string(dim(G)));\n'
   673	            'print("BASIS_SIZE="+string(size(G)));\n'
   674	            'print("END_RESULT");\n'
   675	            "quit;\n"
   676	        )
   677	        self.ms.write("\n")

   789	                poly = sum(
   790	                    q not in {-self.L * degree for degree in range(self.x_degree_caps[r] + 1)}
   791	                    for r in range(self.m + 1)
   792	                )
   793	            else:
   794	                monic = poly = 0
   795	            no_log_raw = self.n if q == self.L else 0
   796	            no_log_effective = orbit["effective_over_base_field"] if q == self.L else 0
   797	            raw = high + monic + poly + no_log_raw
   798	            effective = high + monic + poly + no_log_effective
   799	            raw_total += raw
   800	            effective_total += effective
   801	            out.append(
   802	                {
   803	                    "order_z": q,
   804	                    "order_t": _qstr(q, self.L),
   805	                    "high_degree": high,
   806	                    "monic": monic,
   807	                    "polynomiality": poly,
   808	                    "no_log_branchwise": no_log_raw,

   856	                if scaled.denominator != 1:
   857	                    raise ValueError("a level edge is off the common z lattice")
   858	                edge_q = int(scaled)
   859	                cumulative_q += edge_q
   860	            q = cumulative_q
   861	            rows = [row for row in count_table if int(row["order_z"]) <= q]
   862	            if rows:
   863	                last = rows[-1]
   864	                ucount = last["unknowns_accumulated"]
   865	                ecount = last["equations_raw_accumulated"]
   866	                dcount = last["equations_deduplicated_accumulated"]
   867	            else:
   868	                ucount = ecount = dcount = 0
   869	            out.append(
   870	                {
   871	                    "level_index": zero_index + 1,
   872	                    "delta": str(delta),
   873	                    "bottom_delta_index": self.bottom_delta_index,
   874	                    "edge_gap_order_z": edge_q,
   875	                    "edge_gap_order_t": _qstr(edge_q, self.L),
   876	                    "cumulative_activation_order_z": q,
   877	                    "cumulative_activation_order_t": _qstr(q, self.L),
   878	                    "unknowns_accumulated": ucount,
   879	                    "equations_raw_accumulated": ecount,
   880	                    "equations_deduplicated_accumulated": dcount,
   881	                }
   882	            )
   883	            previous = zero_index

   772	    def _direct_count_table(self) -> list[dict[str, Any]]:
   773	        orbit = self._orbit_no_log()
   774	        raw_total = 0
   775	        effective_total = 0
   776	        out: list[dict[str, Any]] = []
   777	        orders = sorted(set(range(self.qmin, self.qmax + 1)) | {self.L})
   778	        for q in orders:
   779	            inside = self.qmin <= q <= self.qmax
   780	            high = self.n - self.m - 1 if inside else 0
   781	            if self.monic and inside:
   782	                monic = 1
   783	                poly = sum(
   784	                    q not in {-self.L * degree for degree in range(self.x_degree_caps[r] + 1)}
   785	                    for r in range(self.m)
   786	                )
   787	            elif inside:

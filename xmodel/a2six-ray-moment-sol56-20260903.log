   338	def control_5_moh_counts_at_75_50():
   339	    """p.202 l.-8: 'given deg g = 75 deg f = 50 there are 25 possible values for M_2 and
   340	       2 possible values for V_3 etc.  The above table determines only one possible value
   341	       for M_2 and one for V_3.'"""
   342	    print("\n-- CONTROL 5: Moh's own counts at (n,m) = (75,50) --")
   343	    M2 = sorted(set(Ms[0] for (m,Ms,_) in census(75, Kmin=2, with_V=False) if m == 50))
   344	    V3 = sorted(set(V[3] for (m,Ms,V) in census(75, Kmin=2) if m == 50))
   345	    print("   (1)-(7): #M_2 = %d %s ;  #V_3 = %d %s" % (len(M2), M2, len(V3), V3))
   346	    surv = [(Ms, V) for (m,Ms,V) in census(75, Kmin=2, full=True) if m == 50]
   347	    M2f = sorted(set(Ms[0] for (Ms,_) in surv)); V3f = sorted(set(V[3] for (_,V) in surv))
   348	    print("   (1)-(13): #M_2 = %d %s ;  #V_3 = %d %s ; rows %s"
   349	          % (len(M2f), M2f, len(V3f), V3f, [(list(Ms), dict(V)) for (Ms,V) in surv]))
   350	    # Moh's "25 possible values for M_2" is the a-priori count: the multiples of
   351	    # d_3 = 5 in the range [M_1, n-2) = [-50, 73).  (The census's own count, after
   352	    # gcd(d_2,M_2) = d_3 exactly and M_2 > M_1, is 20 of those 25.)
   353	    apriori = [x for x in range(-50, 73) if x % 5 == 0]

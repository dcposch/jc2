def family(t: int, k: int = 12) -> dict[str, Any]:
    if t < 0:
        raise ValueError("t must be nonnegative")
    if k not in (6, 12):
        raise ValueError("this bounded lane supports the full packets k=6 and k=12")
    P = 7 * t + 6
    n = 9 * P
    m = 6 * P
    K = 3 * P
    u = 18 * t + 15
    v = K - u

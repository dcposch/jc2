    24	                    let the l.c.m. of the reduced denominators of delta_s,...,delta_r be
    25	                    L.  Then A_{r-1} is defined to be the reduced denominator of
    26	                    L*delta_{r-1}."
    27	  p.201 l.28    (9) V_r (d_{r-1}/d_r) = TRI_{r-1} A_{r-1} + SQ_{r-1}     [division algorithm]
    28	  p.201 l.30-34 "Let (tbar)^{L A_{r-1}} = t.  Due to the existence of the following
    29	                    automorphism of k<<tbar>> over k<<tbar^{A_{r-1}}>>,  tbar -> omega tbar,
    30	                    where omega is a A_{r-1}-th root of unity, the value of V_{r-1} is
    31	                    further restricted by"
    32	  p.201 l.36   (10) V_{r-1} <= TRI_{r-1}
    33	  p.201 l.38   "if the corresponding factor of p(pi) is of the form pi - a with a != 0
    34	                    or for some j the following"
    35	  p.201 l.41   (11) V_{r-1} = j A_{r-1} + SQ_{r-1}
    36	  p.201 l.43   "if the corresponding factor of p(pi) is of the form pi.  Finally, when
    37	                    r = 2 we must have the following (cf. the proof of Proposition 5.5):"
    38	  p.201 l.46   (12) A_1 | (n/d_2) V_2,   A_1 | (m/d_2) V_2 - 1
    39	  p.201 l.48   "or"
    40	  p.201 l.50   (13) A_1 | (m/d_2) V_2,   A_1 | (n/d_2) V_2 - 1.
    41	  p.201 l.52   "Furthermore we shall note that the situation indicated by the equation
    42	                    (11) can not always happen as established by Proposition 5.6."
    43	
    44	  p.179  Definition 5.1(2),(3) -- the windows and the logarithmic radii delta_i.
    45	  p.188  the derivation of (12)/(13): "A | n* V_2 and A -| m* V_2 or A -| n* V_2 and
    46	         A | m* V_2.  Moreover we always have from the very definition of A the
    47	         following  A | (n* + m*) V_2 - 1."
    48	  p.202  the published table of ALL surviving skeletons at n <= 100 (4 (n,m) classes,
    49	         6 rows counting Moh's bracketed alternates) -- the fail-closed control.
    50	
    51	INDEXING.  Moh's A_j is the object the TIME-FUNCTION CALIBRATION lane called Delta_j.
    52	Conditions (10)/(11) constrain V_{r-1} for r = s,...,3, i.e. they constrain
    53	V_j for j = s-1,...,2.  (12)/(13) is the separate bottom (r = 2) condition.
    54	"""
    55	import sys, os, time, argparse
    56	from fractions import Fraction as F
    57	from math import gcd, lcm
    58	
    59	sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    60	
    61	FAILURES = []
    62	def check(name, cond, detail=""):
    63	    if cond: print("  [ok]   %s" % name)
    64	    else:    print("  [FAIL] %s   %s" % (name, detail)); FAILURES.append(name)
    65	
    66	# ===========================================================================
    67	# PART 0.  the (1)-(7) core, re-derived (checked against moh_skeleton_N in CONTROL 0)
    68	# ===========================================================================
    69	class Skel:
    70	    """Moh skeleton (n, m, [M_2..M_s], {i: V_i}).  M_1 = -m, M_s = n-2, V_{s+1} = d_{s+1}."""
    71	    def __init__(self, n, m, Ms, Vs):
    72	        self.n, self.m = n, m
    73	        full = [-m] + list(Ms)
    74	        self.s = s = len(full)
    75	        self.M = {i+1: full[i] for i in range(s)}
    76	        d = [n]
    77	        for M in full: d.append(gcd(d[-1], M))
    78	        self.d = {i+1: d[i] for i in range(len(d))}
    79	        self.V = dict(Vs); self.V[s+1] = self.d[s+1]
    80	        self.K = self.d[2]; self.e = n//self.K; self.dd = m//self.K
    81	        self.delta = {i: self._delta(i) for i in range(1, s+1)}
    82	        self.u = F(self.V[s]*self.K, self.d[s])
    83	
    84	    def _delta(self, i):                              # Def 5.1(3), p.179
    85	        n, M, d, V, s = self.n, self.M, self.d, self.V, self.s
    86	        num = F(n-M[i]); den = F(n-M[s]-1)
    87	        for j in range(i+1, s+1):
    88	            num *= (V[j]*(n-M[j]) - d[j]); den *= (V[j]*(n-M[j-1]) - d[j])
    89	        return 1 - num/den
    90	
    91	    def windows_ok(self):                             # search (7) = Def 5.1(2)
    92	        for i in range(2, self.s+1):
    93	            lo = F(self.d[i], self.n-self.M[i]); hi = F(self.V[i+1]*self.d[i], self.d[i+1])
    94	            if not (self.V[i] > lo and self.V[i] <= hi): return False
    95	        return True
    96	
    97	    # ---- (8): the increment denominators A_j -----------------------------
    98	    def A(self, j):
    99	        """A_j = reduced denominator of L_j*delta_j,  L_j = lcm{den delta_s,...,den delta_{j+1}}."""
   100	        L = 1
   101	        for i in range(j+1, self.s+1): L = lcm(L, self.delta[i].denominator)
   102	        return (L*self.delta[j]).denominator
   103	
   104	    def L(self, j):
   105	        L = 1
   106	        for i in range(j+1, self.s+1): L = lcm(L, self.delta[i].denominator)
   107	        return L
   108	
   109	    # ---- (9),(10),(11) at level j = r-1 (j = s-1,...,2) -------------------
   110	    def div9(self, j):
   111	        """(9) with r = j+1:  V_{j+1}(d_j/d_{j+1}) = TRI_j A_j + SQ_j."""
   112	        Q = self.V[j+1]*self.d[j]//self.d[j+1]        # exact: d_{j+1} | d_j
   113	        assert self.V[j+1]*self.d[j] % self.d[j+1] == 0
   114	        A = self.A(j)
   115	        return divmod(Q, A) + (A, Q)                  # (TRI_j, SQ_j, A_j, Q)
   116	
   117	    def cond1011(self, j):
   118	        """returns (ok, by10, by11) for level j."""
   119	        tri, sq, A, Q = self.div9(j)
   120	        b10 = (self.V[j] <= tri)                       # (10) alpha != 0
   121	        b11 = ((self.V[j] - sq) % A == 0)              # (11) alpha  = 0
   122	        return (b10 or b11), b10, b11
   123	
   124	    def cond1213(self):
   125	        """(12)/(13) at r = 2, with n* = n/d_2, m* = m/d_2."""
   126	        A1 = self.A(1); ns, ms, V2 = self.e, self.dd, self.V[2]
   127	        b12 = (ns*V2 % A1 == 0) and ((ms*V2 - 1) % A1 == 0)
   128	        b13 = (ms*V2 % A1 == 0) and ((ns*V2 - 1) % A1 == 0)
   129	        return (b12 or b13), b12, b13
   130	
   131	    def full_ok(self):
   132	        """(8)-(13) verbatim."""
   133	        for j in range(self.s-1, 1, -1):
   134	            if not self.cond1011(j)[0]: return False
   135	        return self.cond1213()[0]
   136	
   137	    def any10(self):
   138	        """at least one level j in {2..s-1} admits the alpha != 0 branch (10).
   139	           = the numerical shadow of Moh's Prop 5.6 remark ('(11) can not always happen')."""
   140	        return any(self.cond1011(j)[1] for j in range(self.s-1, 1, -1))
   141	
   142	    # ---- integration-#17 quantities --------------------------------------
   143	    def q(self):
   144	        """D1-PIN:  q = (1-delta_1) d e/(d+e), the contribution of one unit of V_2 to N."""
   145	        return (1 - self.delta[1]) * F(self.dd*self.e, self.dd+self.e)
   146	
   147	def divisor_chains(K, floor=4):
   148	    out = []
   149	    def rec(cur, ch):
   150	        for dd in range(floor, cur):
   151	            if cur % dd == 0: out.append(ch+[dd]); rec(dd, ch+[dd])
   152	    rec(K, []); return out
   153	
   154	def census(n, Kmin=16, with_V=True, full=False):
   155	    """(1)-(7) [+ (8)-(13) if full] enumeration at degree n = deg g.
   156	       Yields (m, (M_2..M_s), {i: V_i}).  full=True prunes with (10)/(11) inside the
   157	       recursion and applies (12)/(13) at the bottom."""
   158	    for K in range(Kmin, n//3+1):
   159	        if n % K: continue
   160	        e = n//K
   161	        if e < 3: continue
   162	        for ch in divisor_chains(K, 4):
   163	            dfull = [n, K]+ch; dfull.append(gcd(dfull[-1], n-2))
   164	            s = 2+len(ch)
   165	            d = {i+1: dfull[i] for i in range(len(dfull))}
   166	            dlist = ([K]+ch)[:-1]; tg = ch
   167	            for dd in range(2, e):
   168	                if gcd(dd, e) != 1: continue
   169	                m = K*dd
   170	                M = {1: -m, s: n-2}
   171	                def Mrec(i, prev):
   172	                    if i == s:
   173	                        if prev < n-2: yield True
   174	                        return
   175	                    for Mi in range(prev+1, n-2):
   176	                        if gcd(dlist[i-2], Mi) == tg[i-2]:
   177	                            M[i] = Mi; yield from Mrec(i+1, Mi)
   178	                for _ in Mrec(2, -m):
   179	                    Ms = [M[i] for i in range(2, s+1)]
   180	                    if not with_V:
   181	                        yield (m, tuple(Ms), None); continue
   182	                    V = {s+1: d[s+1]}
   183	                    # R_i = prod_{j>i} P_j/Q_j  ;  delta_i = 1 - (n-M_i) R_i/(n-M_s-1)
   184	                    def delta_of(i, R): return 1 - F(n-M[i])*R/F(n-M[s]-1)
   185	                    def Vrec(i, R, Lcm):
   186	                        # R = R_i (needs V_{i+1..s}); Lcm = lcm{den delta_s..den delta_{i+1}}
   187	                        if i == 1:
   188	                            yield None; return
   189	                        lo = F(d[i], n-M[i]); hiQ = V[i+1]*d[i]//d[i+1]
   190	                        w0 = lo.numerator//lo.denominator + 1
   191	                        cand = range(max(w0, 1), hiQ+1)
   192	                        if full and i <= s-1:
   193	                            di = delta_of(i, R)
   194	                            A = (Lcm*di).denominator
   195	                            tri, sq = divmod(hiQ, A)
   196	                            cand = [w for w in cand if w <= tri or (w - sq) % A == 0]
   197	                        for w in cand:
   198	                            if i == s and w >= d[s]: continue
   199	                            V[i] = w
   200	                            R2 = R*F(V[i]*(n-M[i])-d[i], V[i]*(n-M[i-1])-d[i])
   201	                            if full and i == 2:
   202	                                d1 = delta_of(1, R2)
   203	                                Lc = lcm(Lcm, delta_of(2, R).denominator)
   204	                                A1 = (Lc*d1).denominator
   205	                                ns, ms_ = n//d[2], m//d[2]
   206	                                b12 = (ns*w % A1 == 0) and ((ms_*w - 1) % A1 == 0)
   207	                                b13 = (ms_*w % A1 == 0) and ((ns*w - 1) % A1 == 0)
   208	                                if not (b12 or b13): continue
   209	                                yield None; continue
   210	                            Lc = lcm(Lcm, delta_of(i, R).denominator) if full else 1
   211	                            yield from Vrec(i-1, R2, Lc)
   212	                        V.pop(i, None)
   213	                    for _ in Vrec(s, F(1), 1):   # L_s = lcm over empty range = 1
   214	
   215	                        yield (m, tuple(Ms), {i: V[i] for i in range(2, s+1)})
   216	

   321	        n, m, Ms, V = r
   322	        print("      n=%-4d m=%-4d M_2..M_s=%-16s V=%s" % (n, m, list(Ms), dict(V)))
   323	    printed = set((n, m, tuple(Ms), tuple(sorted(Vs.items())))
   324	                  for (n,m,Ms,Vs,_,_,_,_) in MOH_TABLE)
   325	    got = set(out)
   326	    # FAIL-CLOSED half: every printed row must survive.  This is the half that can
   327	    # falsify the transcription, and it passes.
   328	    check("every p.202 row survives (1)-(13)", printed <= got,

  1353	def main(argv: list[str] | None = None) -> int:
  1354	    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
  1355	    sub = parser.add_subparsers(dest="command", required=True)
  1356	
  1357	    emit = sub.add_parser("emit", help="emit the finite-order interpolation system")
  1358	    emit.add_argument("input", help="decorated skeleton JSON, or - for stdin")
  1359	    emit.add_argument("--order", help="override max_t_order with a rational value")
  1360	    emit.add_argument("--format", choices=("text", "json"), default="text")
  1361	    emit.add_argument("--summary-only", action="store_true", help="omit individual equations in text mode")
  1362	    emit.add_argument("--rank", choices=("none", "sampled", "symbolic"), default="sampled")
  1363	    emit.add_argument("--rank-cap", type=int, default=300)
  1364	
  1365	    sub.add_parser("example", help="print a complete decorated example JSON")
  1366	    sub.add_parser("controls", help="run the exact requested positive/negative controls")
  1367	    sub.add_parser("selftest", help="run controls plus emitter invariants")
  1368	
  1369	    args = parser.parse_args(argv)
  1370	    if args.command == "example":
  1371	        print(json.dumps(example_config(), indent=2, sort_keys=True))
  1372	        return 0
  1373	    if args.command == "controls":
  1374	        checks = run_controls(verbose=True)
  1375	        return 1 if checks.failures else 0
  1376	    if args.command == "selftest":
  1377	        checks = _selftest(verbose=True)
  1378	        return 1 if checks.failures else 0
  1379	    try:
  1380	        system = GlobalInterpolationSystem(_load_json(args.input), order_override=args.order)
  1381	        result = system.result(rank_method=args.rank, rank_cap=args.rank_cap)
  1382	    except Exception as exc:
  1383	        print(f"ERROR: {exc}", file=sys.stderr)
  1384	        return 2
  1385	    if args.format == "json":
  1386	        print(json.dumps(result, indent=2, sort_keys=True))
  1387	    else:
  1388	        print(_render_text(result, include_equations=not args.summary_only))
  1389	    return 0
  1390	

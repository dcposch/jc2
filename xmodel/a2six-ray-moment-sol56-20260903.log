   897	    def rank_report(self, method: str, cap: int = 300) -> dict[str, Any]:
   898	        equations: list[sp.Expr] = []
   899	        seen: set[str] = set()
   900	        for equation in self.equations:
   901	            key = _canonical(equation.expr)
   902	            if key not in seen:
   903	                seen.add(key)
   904	                equations.append(equation.expr)
   905	        variables = sorted(self.registry.intro, key=str)
   906	        base = {
   907	            "raw_equations": len(self.equations),
   908	            "deduplicated_equations": len(equations),
   909	            "unknowns": len(variables),
   910	            "requested_method": method,
   911	        }
   912	        if method == "none":
   913	            return {**base, "status": "not computed"}
   914	        if max(len(equations), len(variables)) > cap:
   915	            return {
   916	                **base,
   917	                "status": "not computed",
   918	                "reason": f"matrix exceeds rank cap {cap}",
   919	            }
   920	        if not equations or not variables:
   921	            return {**base, "status": "exact", "rank": 0}
   922	        matrix = sp.Matrix(equations).jacobian(variables)
   923	        if method == "symbolic":
   924	            return {
   925	                **base,
   926	                "status": "exact symbolic ambient Jacobian rank",
   927	                "rank": int(matrix.rank()),
   928	                "qualification": "ambient generic rank; at a singular solution the local rank may be lower",
   929	            }
   930	        best = 0
   931	        free = sorted(set().union(*(entry.free_symbols for entry in matrix)), key=str)
   932	        for trial in range(3):
   933	            substitution = {
   934	                symbol: sp.Integer(2 + ((index + 17 * trial) * 37) % 101)
   935	                for index, symbol in enumerate(free)
   936	            }
   937	            evaluated = matrix.subs(substitution)
   938	            best = max(best, int(evaluated.rank()))
   939	        return {
   940	            **base,
   941	            "status": "proved lower bound from three exact specializations",
   942	            "rank_lower_bound": best,
   943	            "qualification": "specialization rank is a lower bound for ambient generic Jacobian rank, not an ideal codimension or a rank at a solution",
   944	        }

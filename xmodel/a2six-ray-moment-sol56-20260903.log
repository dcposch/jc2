   524	        na = sum(len(v) for v in G.values())
   525	        if not G: continue
   526	        ta += na; tg += len(G)
   527	        print("   %5d %12d %10d %9.1fs" % (n, na, len(G), time.time()-t0)); sys.stdout.flush()
   528	    print("   TOTAL %d <= D <= %d : V-assignments %d, groups %d" % (dlo, dhi, ta, tg))
   529	    return ta, tg

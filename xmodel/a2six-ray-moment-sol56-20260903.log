+\[
+ \widehat\tau_{O,j,\epsilon}
+ =a_O\zeta^{2j}z^2
+  +\epsilon\zeta^{7j}z^7+\text{higher terms},
+ \quad j\in\mathbf Z/6,
+ \quad \epsilon\in\{0,+1,-1\},

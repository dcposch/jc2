    print("=" * 78)
    if a.mode == "controls":
        run_controls()
    elif a.mode == "rerun":
        run_controls()
        T, empty, surv = rerun(a.dlo, a.dhi)
        list_survivors(surv)
    elif a.mode == "count":
        count_only(a.dlo, a.dhi)
    elif a.mode == "count7":
        count_only(a.dlo, a.dhi, full=False)

if __name__ == "__main__":
    main()


    assert nonproper == e * (K - k) == residual + top_minor
    assert k % 6 == 0 and k <= u
    delta3 = Fraction(-1)
    delta2 = Fraction(1, 6)
    delta1 = Fraction(7, 12)
    rho_residual = delta2 + Fraction(1, 6 * (residual - 1))
    rho_top = Fraction(2)

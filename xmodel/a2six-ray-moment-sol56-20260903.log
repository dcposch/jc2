   317	            out.append((n, m, Ms, tuple(sorted(V.items()))))
   318	    print("   (1)-(13) survivors at n <= 100 (Kmin=2, Moh's own space): %d   [%.1fs]"
   319	          % (len(out), time.time()-t0))

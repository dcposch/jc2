+has
+
+\[
+ |O|=6,\qquad w=|O|V_2=6,
+ \qquad N_{\rm pkt}=|O|V_2q=3.
+\]
+
+Because
+
+\[
+ u=18t+15=6(3t+2)+3,
+\]

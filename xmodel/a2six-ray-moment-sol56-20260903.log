+| 2 | 180 | 59 | 36 / 36 / 23 | 153 / 59 / 0 | 180 / 59 / 0 |
+| 3 | 243 | 80 | 36 / 36 / 44 | 207 / 80 / 0 | 243 / 80 / 0 |

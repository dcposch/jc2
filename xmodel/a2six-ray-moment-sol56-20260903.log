+\[
+\begin{aligned}
+V_3(n-M_3)-d_3&=5t+4,\\
+V_3(n-M_2)-d_3&=6P(5t+4),\\
+V_2(n-M_2)-d_2&=2P,\\
+V_2(n-M_1)-d_2&=12P.
+\end{aligned}
+\]

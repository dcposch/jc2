 149                 "FAKE_EXCLUDED_ALIAS": str(root / "excluded-alias"),
 150                 "FAKE_CHARGED_INPUT": str(root / "refs" / "packet.md"),
 151             }
 152         )
 153         if report is not None:
 154             report_source = root / f"{tag}.report-source"
 155             report_source.write_text(report, encoding="utf-8")
 156             env["FAKE_REPORT_SOURCE"] = str(report_source)
 157         result = subprocess.run(

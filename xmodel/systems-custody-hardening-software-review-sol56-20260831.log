  95 def lexical_absolute(value: str, base: Path) -> Path:
  96     candidate = Path(value)
  97     if not candidate.is_absolute():
  98         candidate = base / candidate
  99     # abspath is lexical; unlike resolve(), it does not follow a symlink into
 100     # an excluded tree before the no-symlink gate below.
 101     return Path(os.path.abspath(os.fspath(candidate)))

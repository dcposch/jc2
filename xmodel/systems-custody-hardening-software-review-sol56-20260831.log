 112 def require_regular_nonsymlink(path: Path, label: str, *, executable: bool = False) -> None:
 113     try:
 114         info = os.lstat(path)
 115     except OSError as exc:
 116         raise LaneDetachError(f"{label} is unavailable: {path}: {exc}") from exc
 117     if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
 118         raise LaneDetachError(f"{label} must be a regular non-symlink file: {path}")
 119     if executable and not os.access(path, os.X_OK):
 120         raise LaneDetachError(f"{label} is not executable: {path}")
 121 
 122 
 123 def require_repo_path_without_symlinks(
 124     path: Path,
 125     root: Path,
 126     label: str,
 127     *,
 128     final_kind: str,
 129     executable: bool = False,
 130 ) -> None:
 131     """Validate every component beneath ``root`` without following a symlink.
 132 
 133     ``lstat(root/link/child)`` would already follow ``link`` while looking up
 134     ``child``.  Walk one component at a time and stop as soon as ``link``
 135     itself is seen, so a link into the excluded tree is rejected without any
 136     lookup or metadata access inside its target.
 137     """
 138 
 139     if final_kind not in {"file", "directory"}:
 140         raise LaneDetachError(f"invalid internal final kind: {final_kind}")
 141     try:
 142         relative = path.relative_to(root)
 143     except ValueError as exc:
 144         raise LaneDetachError(f"{label} must be inside the campaign repository: {path}") from exc
 145     if not relative.parts:
 146         raise LaneDetachError(f"{label} cannot be the repository root")
 147 
 148     current = root
 149     final_index = len(relative.parts) - 1
 150     for index, component in enumerate(relative.parts):
 151         current = current / component
 152         try:
 153             info = os.lstat(current)
 154         except OSError as exc:
 155             raise LaneDetachError(f"{label} path component is unavailable: {current}: {exc}") from exc
 156         if stat.S_ISLNK(info.st_mode):
 157             raise LaneDetachError(f"{label} path component must not be a symlink: {current}")
 158         if index < final_index:
 159             if not stat.S_ISDIR(info.st_mode):
 160                 raise LaneDetachError(
 161                     f"{label} intermediate component must be a directory: {current}"
 162                 )
 163             continue
 164         if final_kind == "file" and not stat.S_ISREG(info.st_mode):
 165             raise LaneDetachError(f"{label} must be a regular file: {current}")
 166         if final_kind == "directory" and not stat.S_ISDIR(info.st_mode):
 167             raise LaneDetachError(f"{label} must be a directory: {current}")
 168         if executable and not os.access(current, os.X_OK):
 169             raise LaneDetachError(f"{label} is not executable: {current}")
 170 
 171 
 172 def write_exclusive(path: Path, payload: bytes, mode: int) -> None:
 173     descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
 174     try:
 175         with os.fdopen(descriptor, "wb", closefd=False) as handle:
 176             handle.write(payload)
 177             handle.flush()
 178             os.fsync(handle.fileno())
 179     finally:
 180         os.close(descriptor)
 181     os.chmod(path, mode)

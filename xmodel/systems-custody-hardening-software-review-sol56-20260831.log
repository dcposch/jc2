 524 
 525 def command_wait(args: argparse.Namespace) -> int:
 526     require_darwin()
 527     root = repo_root()
 528     record = load_record(root, args.tag)
 529     deadline = None if args.timeout is None else time.monotonic() + args.timeout
 530     previous: tuple[Any, ...] | None = None
 531     while True:
 532         value = parse_launchd(record)
 533         fingerprint = (
 534             value["state"],
 535             value.get("pid"),
 536             value.get("lane_exit_code"),
 537             value.get("launchd_state"),
 538         )
 539         if fingerprint != previous and not args.json:
 540             print(format_status(value), flush=True)
 541             previous = fingerprint
 542         if value["state"] in TERMINAL_STATES:
 543             if args.json:
 544                 print(json.dumps(value, sort_keys=True))
 545             if value["state"] == "SUCCEEDED":
 546                 return 0
 547             if value["state"] == "UNLOADED":
 548                 return 3
 549             return 1
 550         if value["state"] == "MISSING_JOB":
 551             if args.json:
 552                 print(json.dumps(value, sort_keys=True))
 553             return 3
 554         if deadline is not None and time.monotonic() >= deadline:
 555             if args.json:
 556                 print(json.dumps(value, sort_keys=True))
 557             return 124
 558         time.sleep(args.interval)
 559 
 560 
 561 def iter_records(root: Path) -> list[dict[str, Any]]:
 562     jobs = job_root(root)
 563     if not jobs.exists():
 564         return []
 565     info = os.lstat(jobs)
 566     if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
 567         raise LaneDetachError(f"lane-job root is not a real directory: {jobs}")
 568     records: list[dict[str, Any]] = []
 569     for entry in sorted(jobs.iterdir(), key=lambda item: item.name):
 570         if not TAG_RE.fullmatch(entry.name):
 571             continue
 572         # Corrupt supervisor state is itself actionable recovery evidence;
 573         # never hide it by silently returning an incomplete list.
 574         records.append(load_record(root, entry.name))
 575     return records
 576 
 577 
 578 def command_list(args: argparse.Namespace) -> int:
 579     require_darwin()
 580     values = [parse_launchd(record) for record in iter_records(repo_root())]
 581     if args.running_tags:
 582         for value in values:
 583             if value["state"] in ACTIVE_STATES:
 584                 print(value["tag"])
 585     elif args.json:
 586         print(json.dumps(values, sort_keys=True))
 587     elif not values:
 588         print("(no detached lane supervisors)")
 589     else:
 590         for value in values:
 591             print(format_status(value))
 592     return 0
 593 
 594 
 595 def command_unload(args: argparse.Namespace) -> int:
 596     require_darwin()
 597     root = repo_root()
 598     record = load_record(root, args.tag)
 599     value = parse_launchd(record)
 600     if value["state"] in ACTIVE_STATES:
 601         raise LaneDetachError(f"refusing to unload live lane: {args.tag}")
 602     if value["state"] != "MISSING_JOB" and value["state"] != "UNLOADED":
 603         completed = subprocess.run(
 604             [launchctl_path(), "bootout", service_name(record)],
 605             text=True,
 606             stdout=subprocess.PIPE,
 607             stderr=subprocess.STDOUT,
 608             timeout=30,
 609             check=False,
 610         )
 611         if completed.returncode != 0:
 612             raise LaneDetachError(
 613                 f"launchd bootout failed for terminal lane {args.tag}: "
 614                 f"{completed.stdout.strip()}"
 615             )
 616     marker = job_dir(root, args.tag) / "unloaded.v1.json"
 617     if not marker.exists():
 618         payload = {
 619             "schema": SCHEMA,
 620             "tag": args.tag,
 621             "unloaded_utc": utc_now(),
 622             "terminal_state_before_unload": value["state"],
 623             "lane_exit_code": value.get("lane_exit_code"),
 624         }
 625         write_exclusive(
 626             marker,
 627             (json.dumps(payload, indent=2, sort_keys=True) + "\n").encode("utf-8"),
 628             0o400,
 629         )
 630     print(f"{args.tag} UNLOADED sidecar-retained")
 631     return 0
 632 
 633 
 634 def build_parser() -> argparse.ArgumentParser:
 635     parser = argparse.ArgumentParser(description=__doc__)
 636     subparsers = parser.add_subparsers(dest="command", required=True)
 637 
 638     launch = subparsers.add_parser("launch", help="bootstrap a detached one-shot lane")
 639     launch.add_argument("adapter")
 640     launch.add_argument("tag")
 641     launch.add_argument("prompt")
 642     launch.add_argument("--json", action="store_true")
 643     launch.set_defaults(func=command_launch)
 644 
 645     status_parser = subparsers.add_parser("status", help="query launchd without lane files")
 646     status_parser.add_argument("tag")
 647     status_parser.add_argument("--json", action="store_true")
 648     status_parser.set_defaults(func=command_status)
 649 
 650     wait_parser = subparsers.add_parser("wait", help="wait through the safe supervisor plane")
 651     wait_parser.add_argument("tag")
 652     wait_parser.add_argument("--timeout", type=float)
 653     wait_parser.add_argument("--interval", type=float, default=5.0)
 654     wait_parser.add_argument("--json", action="store_true")
 655     wait_parser.set_defaults(func=command_wait)
 656 
 657     list_parser = subparsers.add_parser("list", help="list detached supervisor states")
 658     list_mode = list_parser.add_mutually_exclusive_group()
 659     list_mode.add_argument("--json", action="store_true")
 660     list_mode.add_argument("--running-tags", action="store_true")
 661     list_parser.set_defaults(func=command_list)
 662 
 663     unload = subparsers.add_parser("unload", help="unregister a terminal job, keep sidecar")
 664     unload.add_argument("tag")
 665     unload.set_defaults(func=command_unload)
 666     return parser
 667 
 668 
 669 def main() -> int:
 670     parser = build_parser()
 671     args = parser.parse_args()
 672     if getattr(args, "timeout", None) is not None and args.timeout < 0:
 673         parser.error("--timeout must be nonnegative")
 674     if getattr(args, "interval", 1) <= 0:
 675         parser.error("--interval must be positive")
 676     try:
 677         return int(args.func(args))
 678     except (LaneDetachError, OSError, subprocess.SubprocessError) as exc:
 679         print(f"lane-detach: {exc}", file=sys.stderr)
 680         return 2
 681 
 682 
 683 if __name__ == "__main__":
 684     raise SystemExit(main())


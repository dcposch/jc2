  52 def _open_parent(path: Path) -> tuple[int, str, Path, os.stat_result]:
  53     """Open an anchored parent directory; leave the final name unfollowed."""
  54     if not path.name or path.name in {".", ".."}:
  55         raise SealError("target must name a file")
  56     try:
  57         parent = path.parent.resolve(strict=True)
  58     except OSError as exc:
  59         raise SealError(f"cannot resolve target parent: {exc}") from exc
  60     try:
  61         before = parent.lstat()
  62     except OSError as exc:
  63         raise SealError(f"cannot inspect target parent: {exc}") from exc
  64     if stat.S_ISLNK(before.st_mode) or not stat.S_ISDIR(before.st_mode):
  65         raise SealError("target parent is a symlink or is not a directory")
  66     flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
  67     if hasattr(os, "O_NOFOLLOW"):
  68         flags |= os.O_NOFOLLOW
  69     try:
  70         parent_fd = os.open(parent, flags)
  71     except OSError as exc:
  72         raise SealError(f"cannot open target parent: {exc}") from exc
  73     try:
  74         info = os.fstat(parent_fd)
  75         if not stat.S_ISDIR(info.st_mode) or _identity(info) != _identity(before):
  76             raise SealError("target parent identity changed during open")
  77         _check_parent_path(parent, info)
  78         return parent_fd, path.name, parent, info
  79     except Exception:
  80         os.close(parent_fd)
  81         raise
  82 
  83 
  84 def _check_parent_path(parent: Path, expected: os.stat_result) -> None:
  85     try:
  86         current = parent.lstat()
  87     except OSError as exc:
  88         raise SealError(f"cannot recheck target parent: {exc}") from exc
  89     if stat.S_ISLNK(current.st_mode) or not stat.S_ISDIR(current.st_mode):
  90         raise SealError("target parent changed to a symlink or non-directory")
  91     if _identity(current) != _identity(expected):
  92         raise SealError("target parent identity changed")
  93 

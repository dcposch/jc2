  95 def _identity(info: os.stat_result) -> tuple[int, int]:
  96     return info.st_dev, info.st_ino
  97 
  98 
  99 def _snapshot(info: os.stat_result) -> tuple[int, int, int, int, int, int]:
 100     return (
 101         info.st_dev,
 102         info.st_ino,
 103         stat.S_IMODE(info.st_mode),
 104         info.st_size,
 105         info.st_mtime_ns,
 106         info.st_ctime_ns,
 107     )

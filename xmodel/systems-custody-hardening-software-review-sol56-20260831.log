 165 def _read_regular(path: Path) -> tuple[bytes, os.stat_result, Path]:
 166     parent_fd, name, parent, parent_info = _open_parent(path)
 167     try:
 168         data, info = _read_regular_at(parent_fd, name)
 169         _check_parent_path(parent, parent_info)
 170         return data, info, parent / name
 171     finally:
 172         os.close(parent_fd)

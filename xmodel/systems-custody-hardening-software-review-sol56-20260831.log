 200 def _marker_boundaries(data: bytes, *, require_newline: bool) -> list[int]:
 201     markers: list[int] = []
 202     offset = 0
 203     for line in data.splitlines(keepends=True):
 204         content = line[:-2] if line.endswith(b"\r\n") else line[:-1] if line.endswith(b"\n") else line
 205         if content == MARKER:
 206             if not line.endswith((b"\n", b"\r\n")) and require_newline:
 207                 raise SealError("standalone BODY-END marker lacks terminating newline")
 208             markers.append(offset + len(line))
 209         offset += len(line)
 210     return markers
 211 
 212 
 213 def _body_boundary(data: bytes) -> int:
 214     markers = _marker_boundaries(data, require_newline=True)
 215     if len(markers) != 1:
 216         raise SealError(f"expected exactly one standalone BODY-END marker, found {len(markers)}")
 217     return markers[0]
 218 
 219 
 220 def _unique(pattern: re.Pattern[str], text: str, label: str) -> str:
 221     values = pattern.findall(text)
 222     if len(values) != 1:
 223         raise SealError(f"expected exactly one {label} declaration, found {len(values)}")
 224     return values[0]
 225 
 226 
 227 def verify_bytes(
 228     data: bytes, *, expected_basis: str | None = None
 229 ) -> tuple[int, str, str]:
 230     boundary = _body_boundary(data)
 231     body = data[:boundary]
 232     try:
 233         post = data[boundary:].decode("utf-8")
 234     except UnicodeDecodeError as exc:
 235         raise SealError(f"post-body seal is not UTF-8: {exc}") from exc
 236     post = post.replace("\r\n", "\n")
 237     if "\r" in post:
 238         raise SealError("post-body seal contains a lone carriage return")
 239     declared_bytes = int(_unique(BODY_BYTES_RE, post, "Body bytes"))
 240     declared_sha = _unique(BODY_SHA_RE, post, "Body SHA-256")
 241     basis = _unique(FROZEN_BASIS_RE, post, "Frozen basis")
 242     actual_sha = hashlib.sha256(body).hexdigest()
 243     if declared_bytes != len(body):
 244         raise SealError(
 245             f"body byte mismatch: declared {declared_bytes}, actual {len(body)}"
 246         )
 247     if declared_sha != actual_sha:
 248         raise SealError(
 249             f"body SHA-256 mismatch: declared {declared_sha}, actual {actual_sha}"
 250         )
 251     if expected_basis is not None and basis != expected_basis:
 252         raise SealError(
 253             f"frozen basis mismatch: declared {basis}, expected {expected_basis}"
 254         )
 255     return len(body), actual_sha, basis
 256 
 257 
 258 def verify_path(
 259     path: Path, *, expected_basis: str | None = None
 260 ) -> tuple[int, str, str]:
 261     data, _, _ = _read_regular(path)
 262     return verify_bytes(data, expected_basis=expected_basis)
 263 
 264 
 265 def _canonical_seal(body_bytes: int, body_sha: str, basis: str) -> bytes:
 266     return (
 267         "\n## Seal\n\n"
 268         "- Body definition: every byte through the unique standalone "
 269         "`<!-- BODY-END -->` line,\n"
 270         "  including its terminating newline; this seal is outside the body.\n"
 271         f"- Body bytes: `{body_bytes}`.\n"
 272         "- Body SHA-256:\n"
 273         f"  `{body_sha}`.\n"
 274         f"- Frozen basis: `{basis}`.\n"
 275     ).encode("utf-8")
 276 
 277 
 278 def stamp_path(path: Path, basis: str) -> tuple[int, str, str]:
 279     _validate_basis(basis)
 280     parent_fd, name, parent, parent_info = _open_parent(path)
 281     temp_name: str | None = None
 282     durability_error: OSError | None = None
 283     try:
 284         data, original = _read_regular_at(parent_fd, name)
 285         boundary = _body_boundary(data)
 286         if data[boundary:].strip():
 287             raise SealError(
 288                 "refusing to stamp: non-whitespace content already follows BODY-END"
 289             )
 290         body = data[:boundary]
 291         digest = hashlib.sha256(body).hexdigest()
 292         sealed = body + _canonical_seal(len(body), digest, basis)
 293 
 294         try:
 295             current = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
 296         except OSError as exc:
 297             raise SealError(f"cannot recheck target before replacement: {exc}") from exc
 298         if stat.S_ISLNK(current.st_mode) or not stat.S_ISREG(current.st_mode):
 299             raise SealError("target changed to a symlink or non-regular file")
 300         if _identity(current) != _identity(original):
 301             raise SealError("target identity changed while preparing seal")
 302 
 303         temp_fd, temp_name = _create_temp_at(
 304             parent_fd, name, stat.S_IMODE(original.st_mode)
 305         )
 306         with os.fdopen(temp_fd, "wb") as handle:
 307             handle.write(sealed)
 308             handle.flush()
 309             os.fsync(handle.fileno())
 310 
 311         # Detect both replacement and same-inode rewrites immediately before
 312         # the atomic install.  This is not a substitute for cooperative locks,
 313         # but it closes the ordinary concurrent-lane lost-update window.
 314         latest_data, latest = _read_regular_at(parent_fd, name)
 315         if _snapshot(latest) != _snapshot(original):
 316             raise SealError("target metadata changed before atomic replacement")
 317         if latest_data != data:
 318             raise SealError("target content changed before atomic replacement")
 319         _check_parent_path(parent, parent_info)
 320 
 321         os.replace(
 322             temp_name,
 323             name,
 324             src_dir_fd=parent_fd,
 325             dst_dir_fd=parent_fd,
 326         )
 327         temp_name = None
 328 
 329         installed, _ = _read_regular_at(parent_fd, name)
 330         if installed != sealed:
 331             raise SealError("installed seal differs from staged bytes")
 332         verify_bytes(installed, expected_basis=basis)
 333 
 334         try:
 335             _check_parent_path(parent, parent_info)
 336         except SealError as exc:
 337             durability_error = OSError(str(exc))
 338         try:
 339             os.fsync(parent_fd)
 340         except OSError as exc:
 341             durability_error = durability_error or exc
 342     finally:
 343         if temp_name is not None:
 344             try:
 345                 os.unlink(temp_name, dir_fd=parent_fd)
 346             except FileNotFoundError:
 347                 pass
 348         os.close(parent_fd)
 349     if durability_error is not None:
 350         raise SealDurabilityWarning(
 351             "seal was installed and verified, but directory fsync failed: "
 352             f"{durability_error}"
 353         )
 354     return len(body), digest, basis
 355 
 356 
 357 def _write_exclusive(path: Path, data: bytes, mode: int = 0o444) -> str:
 358     """Create ``path`` exclusively with ``data``; return its SHA-256."""
 359     parent_fd, name, _parent, _parent_info = _open_parent(path)
 360     try:
 361         flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
 362         if hasattr(os, "O_NOFOLLOW"):
 363             flags |= os.O_NOFOLLOW
 364         try:
 365             fd = os.open(name, flags, mode, dir_fd=parent_fd)
 366         except OSError as exc:
 367             raise SealError(f"cannot create {path} exclusively: {exc}") from exc
 368         with os.fdopen(fd, "wb") as handle:
 369             handle.write(data)
 370             handle.flush()
 371             os.fsync(handle.fileno())
 372         try:
 373             os.fsync(parent_fd)
 374         except OSError:
 375             pass
 376         return hashlib.sha256(data).hexdigest()
 377     finally:
 378         os.close(parent_fd)
 379 

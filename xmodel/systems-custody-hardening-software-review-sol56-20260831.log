  55   exit 2
  56 }
  57 seal_tool=$script_dir/seal.py
  58 [ -f "$seal_tool" ] && [ ! -L "$seal_tool" ] || {
  59   echo "required seal tool missing: $seal_tool" >&2
  60   exit 2
  61 }
  62 command -v python3 >/dev/null 2>&1 || {
  63   echo "python3 is required for charge-basis validation" >&2
  64   exit 2
  65 }
  66 sandbox_exec=/usr/bin/sandbox-exec
  67 [ -x "$sandbox_exec" ] || {
  68   echo "the macOS process sandbox is required for external-model lanes: $sandbox_exec" >&2
  69   exit 2
  70 }

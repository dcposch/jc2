 377 def command_launch(args: argparse.Namespace) -> int:
 378     require_darwin()
 379     validate_tag(args.tag)
 380     validate_adapter(args.adapter)
 381     root = repo_root()
 382     excluded = root / "jc2-lean"
 383     prompt = lexical_absolute(args.prompt, Path.cwd())
 384     if not path_is_within(prompt, root):
 385         raise LaneDetachError(f"prompt must be inside the campaign repository: {prompt}")
 386     if path_is_within(prompt, excluded):
 387         raise LaneDetachError("prompt path is inside the excluded nested worktree")
 388     require_repo_path_without_symlinks(prompt, root, "prompt", final_kind="file")
 389 
 390     launcher = root / "ops" / "lane.sh"
 391     adapter = root / "ops" / "adapters" / f"{args.adapter}.sh"
 392     require_repo_path_without_symlinks(
 393         launcher, root, "lane launcher", final_kind="file", executable=True
 394     )
 395     require_repo_path_without_symlinks(
 396         adapter, root, "adapter", final_kind="file", executable=True
 397     )
 398 
 399     xmodel = root / "xmodel"
 400     require_repo_path_without_symlinks(xmodel, root, "xmodel directory", final_kind="directory")
 401     for suffix in (".log", ".md", ".run", ".run.v2"):
 402         if os.path.lexists(xmodel / f"{args.tag}{suffix}"):
 403             raise LaneDetachError(
 404                 f"duplicate tag refused; choose a new attempt tag: {args.tag}"
 405             )
 406     locks = root / ".lane-locks"
 407     if os.path.lexists(locks):
 408         require_repo_path_without_symlinks(
 409             locks, root, "lane-lock directory", final_kind="directory"
 410         )

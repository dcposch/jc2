 225 def safe_environment() -> dict[str, str]:
 226     # Do not serialize API keys, tokens, or the coordinator's full environment
 227     # into a persistent plist.  Current adapters authenticate from HOME; the
 228     # Claude adapters explicitly unset ANTHROPIC_API_KEY themselves.
 229     return {name: os.environ[name] for name in ENV_ALLOWLIST if os.environ.get(name)}

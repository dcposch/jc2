 110 def _open_regular_at(
 111     parent_fd: int, name: str
 112 ) -> tuple[int, os.stat_result]:
 113     try:
 114         before = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
 115     except OSError as exc:
 116         raise SealError(f"cannot inspect target before open: {exc}") from exc
 117     if stat.S_ISLNK(before.st_mode) or not stat.S_ISREG(before.st_mode):
 118         raise SealError("path is a symlink or is not a regular file")
 119 
 120     flags = os.O_RDONLY | getattr(os, "O_NONBLOCK", 0)
 121     if hasattr(os, "O_NOFOLLOW"):
 122         flags |= os.O_NOFOLLOW
 123     try:
 124         fd = os.open(name, flags, dir_fd=parent_fd)
 125     except OSError as exc:
 126         raise SealError(f"cannot open regular file: {exc}") from exc
 127     try:
 128         info = os.fstat(fd)
 129         if not stat.S_ISREG(info.st_mode):
 130             raise SealError("path is not a regular file")
 131         if _identity(before) != _identity(info):
 132             raise SealError("target identity changed during open")
 133         try:
 134             after = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
 135         except OSError as exc:
 136             raise SealError(f"cannot recheck target after open: {exc}") from exc
 137         if _identity(after) != _identity(info) or not stat.S_ISREG(after.st_mode):
 138             raise SealError("target identity changed during open")
 139         return fd, info
 140     except Exception:
 141         os.close(fd)
 142         raise

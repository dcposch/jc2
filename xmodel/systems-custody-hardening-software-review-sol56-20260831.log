 101 for existing in "xmodel/$tag.log" "xmodel/$tag.md" "xmodel/$tag.run" \
 102     "xmodel/$tag.run.v2" "xmodel/$tag.raw.md" "xmodel/$tag.overflow"; do
 103   if [ -e "$existing" ]; then
 104     echo "duplicate tag refused; choose a new attempt tag: $tag ($existing exists)" >&2
 105     exit 3
 106   fi
 107 done
 108 
 109 lane_tmp_root=${TMPDIR:-/tmp}
 110 case "$lane_tmp_root" in
 111   /*) ;;
 112   *)
 113     echo "TMPDIR must be absolute: $lane_tmp_root" >&2
 114     exit 2
 115     ;;
 116 esac
 117 lane_tmp_root=$(CDPATH= cd -- "$lane_tmp_root" 2>/dev/null && pwd -P) || {
 118   echo "temporary directory root unavailable: $lane_tmp_root" >&2
 119   exit 2
 120 }
 121 
 122 lock_dir=.lane-locks/$tag
 123 if ! mkdir "$lock_dir" 2>/dev/null; then
 124   echo "tag is already live: $tag" >&2
 125   exit 3
 126 fi
 127 lane_tmp_dir=
 128 cleanup() {
 129   if [ -n "$lane_tmp_dir" ]; then
 130     case "$lane_tmp_dir" in
 131       "$lane_tmp_root"/jc2-lane.*)
 132         rm -rf -- "$lane_tmp_dir" 2>/dev/null || true
 133         ;;
 134     esac
 135   fi
 136   rmdir "$lock_dir" 2>/dev/null || true
 137 }
 138 child_pid=
 139 caught_signal=
 140 forward_signal() {
 141   caught_signal=$1
 142   if [ -n "$child_pid" ]; then
 143     kill -s "$1" "$child_pid" 2>/dev/null || true
 144   fi
 145 }
 146 trap cleanup EXIT
 147 trap 'forward_signal HUP' HUP
 148 trap 'forward_signal INT' INT
 149 trap 'forward_signal TERM' TERM
 150 
 151 lane_tmp_dir=$(mktemp -d "$lane_tmp_root/jc2-lane.XXXXXX") || {
 152   echo "could not create secure lane temporary directory" >&2
 153   exit 2
 154 }
 155 chmod 700 "$lane_tmp_dir" || exit 2
 156 prompt_snapshot=$lane_tmp_dir/original-prompt.txt
 157 fallacy_snapshot=$lane_tmp_dir/FALLACY-v2.md
 158 charge_validator_snapshot=$lane_tmp_dir/validate_charge_basis.py
 159 seal_tool_snapshot=$lane_tmp_dir/seal.py
 160 model_prompt_file=$lane_tmp_dir/model-prompt.txt
 161 sandbox_profile=$lane_tmp_dir/external-model.sb
 162 inputs_dir=$lane_tmp_dir/inputs
 163 inputs_manifest=$lane_tmp_dir/charged-inputs.list
 164 inputs_post_manifest=$lane_tmp_dir/charged-inputs-post.list
 165 # Keep this lexical: boundary setup must neither resolve nor inspect the excluded
 166 # nested worktree.  Seatbelt resolves aliases when enforcing the path filter.
 167 excluded_tree=$repo_root/jc2-lean
 168 
 169 log_file=xmodel/$tag.log
 170 run_file=xmodel/$tag.run.v2
 171 run_path=$repo_root/$run_file
 172 report_file=xmodel/$tag.md
 173 start_utc=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
 174 prompt_sha=$(sha256_file "$prompt_file") || exit 2
 175 adapter_sha=$(sha256_file "$adapter_script") || exit 2
 176 launcher_sha=$(sha256_file "$script_dir/lane.sh") || exit 2
 177 charge_validator_sha=$(sha256_file "$charge_validator") || exit 2
 178 seal_tool_sha=$(sha256_file "$seal_tool") || exit 2
 179 fallacy_sha=$(sha256_file "$fallacy_file") || exit 2
 180 cp "$prompt_file" "$prompt_snapshot" || exit 2
 181 cp "$fallacy_file" "$fallacy_snapshot" || exit 2
 182 cp "$charge_validator" "$charge_validator_snapshot" || exit 2
 183 cp "$seal_tool" "$seal_tool_snapshot" || exit 2
 184 chmod 400 "$prompt_snapshot" "$fallacy_snapshot" "$charge_validator_snapshot" \
 185   "$seal_tool_snapshot" || exit 2
 186 prompt_snapshot_sha=$(sha256_file "$prompt_snapshot") || exit 2
 187 fallacy_snapshot_sha=$(sha256_file "$fallacy_snapshot") || exit 2
 188 charge_validator_snapshot_sha=$(sha256_file "$charge_validator_snapshot") || exit 2
 189 seal_tool_snapshot_sha=$(sha256_file "$seal_tool_snapshot") || exit 2
 190 fallacy_snapshot_bytes=$(wc -c < "$fallacy_snapshot" | tr -d '[:space:]') || exit 2
 191 prepared_prompt_sha=$(sha256_file "$prompt_file") || prepared_prompt_sha=ERROR
 192 prepared_fallacy_sha=$(sha256_file "$fallacy_file") || prepared_fallacy_sha=ERROR
 193 prepared_charge_validator_sha=$(sha256_file "$charge_validator") || prepared_charge_validator_sha=ERROR
 194 prepared_seal_tool_sha=$(sha256_file "$seal_tool") || prepared_seal_tool_sha=ERROR
 195 if [ "$prompt_snapshot_sha" != "$prompt_sha" ] || \
 196    [ "$prepared_prompt_sha" != "$prompt_sha" ] || \
 197    [ "$fallacy_snapshot_sha" != "$fallacy_sha" ] || \
 198    [ "$prepared_fallacy_sha" != "$fallacy_sha" ] || \
 199    [ "$charge_validator_snapshot_sha" != "$charge_validator_sha" ] || \
 200    [ "$prepared_charge_validator_sha" != "$charge_validator_sha" ] || \
 201    [ "$seal_tool_snapshot_sha" != "$seal_tool_sha" ] || \
 202    [ "$prepared_seal_tool_sha" != "$seal_tool_sha" ] || \
 203    [ "$fallacy_snapshot_bytes" != "$fallacy_bytes" ]; then
 204   echo "hashed input changed while preparing model prompt; run refused" >&2
 205   exit 2
 206 fi
 207 
 208 fallacy_marker='# FALLACY-v2.md: campaign reasoning guardrail'
 209 if grep -F "$fallacy_marker" "$prompt_snapshot" >/dev/null 2>&1; then
 210   echo "prompt already contains the FALLACY-v2.md appendix marker; run refused" >&2
 211   exit 2
 212 fi
 213 
 214 # Every lane prompt must name its mandated report path so a completed model
 215 # response cannot be lost to a misdirected or unwritten report.
 216 if ! grep -F "xmodel/$tag.md" "$prompt_snapshot" >/dev/null 2>&1; then
 217   echo "prompt does not name its mandated report path xmodel/$tag.md; run refused" >&2
 218   exit 2
 219 fi
 220 
 221 # A prompt that instructs the BODY-END convention declares the marker
 222 # contract; a finished report without the marker then fails closed as partial.
 223 body_end_contract=NONE
 224 if grep -F '<!-- BODY-END -->' "$prompt_snapshot" >/dev/null 2>&1; then
 225   body_end_contract=DECLARED
 226 fi
 227 
 228 # Immutable charged-input snapshots: `charged_input=<repo-relative-path>`
 229 # lines in the prompt are frozen into the write-denied custody directory, and
 230 # every literal `{{LANE_INPUTS}}` in the composed prompt points the model at
 231 # those frozen bytes.  Declarations and the placeholder must appear together.
 232 input_placeholder='{{LANE_INPUTS}}'
 233 charged_inputs=$(sed -n 's/^charged_input=//p' "$prompt_snapshot")
 234 prompt_has_placeholder=0
 235 if grep -F "$input_placeholder" "$prompt_snapshot" >/dev/null 2>&1; then
 236   prompt_has_placeholder=1
 237 fi
 238 input_count=0
 239 if [ -n "$charged_inputs" ] || [ "$prompt_has_placeholder" -eq 1 ]; then
 240   if [ -z "$charged_inputs" ] || [ "$prompt_has_placeholder" -eq 0 ]; then
 241     echo "charged_input declarations and the $input_placeholder placeholder must appear together; run refused" >&2
 242     exit 2
 243   fi
 244   case "$inputs_dir" in
 245     *[!A-Za-z0-9/._-]*)
 246       echo "lane inputs directory has unsupported characters: $inputs_dir" >&2
 247       exit 2
 248       ;;
 249   esac
 250   mkdir "$inputs_dir" || exit 2
 251   while IFS= read -r charged_rel; do
 252     [ -n "$charged_rel" ] || continue
 253     case "$charged_rel" in
 254       /*|*..*|*[!A-Za-z0-9/._-]*)
 255         echo "invalid charged input path: $charged_rel" >&2
 256         exit 2
 257         ;;
 258       jc2-lean|jc2-lean/*)
 259         echo "charged input inside the excluded tree refused: $charged_rel" >&2
 260         exit 2
 261         ;;
 262     esac
 263     charged_src=$repo_root/$charged_rel
 264     if [ ! -f "$charged_src" ] || [ -L "$charged_src" ]; then
 265       echo "charged input missing or not a regular file: $charged_rel" >&2
 266       exit 2
 267     fi
 268     charged_base=$(basename "$charged_rel")
 269     charged_dest=$inputs_dir/$charged_base
 270     if [ -e "$charged_dest" ]; then
 271       echo "duplicate charged input basename: $charged_base" >&2
 272       exit 2
 273     fi
 274     charged_src_sha=$(sha256_file "$charged_src") || exit 2
 275     cp "$charged_src" "$charged_dest" || exit 2
 276     chmod 400 "$charged_dest" || exit 2
 277     charged_snap_sha=$(sha256_file "$charged_dest") || exit 2
 278     if [ "$charged_snap_sha" != "$charged_src_sha" ]; then
 279       echo "charged input changed while being snapshotted: $charged_rel" >&2
 280       exit 2
 281     fi
 282     input_count=$((input_count + 1))
 283     printf '%s %s %s\n' "$charged_rel" "$charged_base" "$charged_src_sha" \
 284       >> "$inputs_manifest"
 285   done <<CHARGED_INPUTS_EOF
 286 $charged_inputs
 287 CHARGED_INPUTS_EOF
 288 fi
 289 # The adapter and every process it spawns inherit this Seatbelt profile.  Lane
 290 # custody stays readable for exact prompt delivery, but even a same-user model
 291 # shell cannot chmod or rewrite the snapshotted inputs.
 292 if [ "$prompt_has_placeholder" -eq 1 ]; then
 293   if ! {
 294     sed "s|{{LANE_INPUTS}}|$inputs_dir|g" "$prompt_snapshot"
 295     printf '\n\n'
 296     cat "$fallacy_snapshot"
 297   } > "$model_prompt_file"; then
 298     echo "could not compose model prompt" >&2
 299     exit 2
 300   fi
 301 elif ! {
 302   cat "$prompt_snapshot"
 303   printf '\n\n'
 304   cat "$fallacy_snapshot"
 305 } > "$model_prompt_file"; then
 306   echo "could not compose model prompt" >&2
 307   exit 2
 308 fi
 309 chmod 600 "$model_prompt_file" || exit 2
 310 model_prompt_sha=$(sha256_file "$model_prompt_file") || exit 2
 311 prepared_prompt_sha=$(sha256_file "$prompt_file") || prepared_prompt_sha=ERROR
 312 prepared_fallacy_sha=$(sha256_file "$fallacy_file") || prepared_fallacy_sha=ERROR
 313 if [ "$prepared_prompt_sha" != "$prompt_sha" ] || \
 314    [ "$prepared_fallacy_sha" != "$fallacy_sha" ]; then
 315   echo "hashed lane input changed while preparing model prompt; run refused" >&2
 316   exit 2
 317 fi
 318 if ! {
 319   printf '%s\n' '(version 1)'
 320   printf '%s\n' '(allow default)'
 321   printf '%s\n' '(deny file-read* (literal (param "EXCLUDED_TREE")))'
 322   printf '%s\n' '(deny file-read* (subpath (param "EXCLUDED_TREE")))'
 323   printf '%s\n' '(deny file-write* (literal (param "EXCLUDED_TREE")))'
 324   printf '%s\n' '(deny file-write* (subpath (param "EXCLUDED_TREE")))'
 325   printf '%s\n' '(deny file-write* (subpath (param "CUSTODY_ROOT")))'
 326   printf '%s\n' '(deny file-write* (literal (param "RUN_FILE")))'
 327 } > "$sandbox_profile"; then
 328   echo "could not create external-model sandbox profile" >&2
 329   exit 2
 330 fi
 331 chmod 400 "$model_prompt_file" "$sandbox_profile" || exit 2
 332 sandbox_profile_sha=$(sha256_file "$sandbox_profile") || exit 2
 333 basis=$(git rev-parse HEAD 2>/dev/null || echo UNKNOWN)
 334 
 335 {
 336   echo "run_schema=2"
 337   echo "tag=$tag"
 338   echo "adapter=$adapter"
 339   echo "pid=$$"
 340   echo "host=$(hostname)"
 341   echo "basis=$basis"
 342   echo "prompt=$prompt_file"
 343   echo "prompt_sha256=$prompt_sha"
 344   echo "adapter_sha256=$adapter_sha"
 345   echo "launcher=ops/lane.sh"
 346   echo "launcher_sha256=$launcher_sha"
 347   echo "sandbox_enforcement=MACOS_SEATBELT"
 348   echo "sandbox_profile_sha256=$sandbox_profile_sha"
 349   echo "charge_basis_validator=ops/validate_charge_basis.py"
 350   echo "charge_basis_validator_sha256=$charge_validator_sha"
 351   echo "seal_tool=ops/seal.py"
 352   echo "seal_tool_sha256=$seal_tool_sha"
 353   echo "body_end_contract=$body_end_contract"
 354   echo "charged_inputs=$input_count"
 355   if [ "$input_count" -gt 0 ]; then
 356     echo "lane_inputs_dir=$inputs_dir"
 357     manifest_index=0
 358     while read -r manifest_rel manifest_base manifest_sha; do
 359       manifest_index=$((manifest_index + 1))
 360       echo "charged_input_${manifest_index}=$manifest_rel"
 361       echo "charged_input_${manifest_index}_basename=$manifest_base"
 362       echo "charged_input_${manifest_index}_sha256=$manifest_sha"
 363     done < "$inputs_manifest"
 364   fi
 365   echo "fallacy=FALLACY-v2.md"
 366   echo "fallacy_bytes=$fallacy_bytes"
 367   echo "fallacy_sha256=$fallacy_sha"
 368   echo "model_prompt=$model_prompt_file"
 369   echo "model_prompt_sha256=$model_prompt_sha"
 370   echo "start_utc=$start_utc"
 371   echo "provenance_scope=DECLARED_LANE_INPUTS"
 372   echo "initial_status=RUNNING"
 373 } > "$run_file"
 374 
 375 "$sandbox_exec" \
 376   -D "EXCLUDED_TREE=$excluded_tree" \
 377   -D "CUSTODY_ROOT=$lane_tmp_dir" \
 378   -D "RUN_FILE=$run_path" \
 379   -f "$sandbox_profile" \
 380   sh "$adapter_script" "$model_prompt_file" > "$log_file" 2>&1 &
 381 child_pid=$!
 382 echo "child_pid=$child_pid" >> "$run_file"
 383 wait "$child_pid"
 384 rc=$?
 385 
 386 if [ -n "$caught_signal" ]; then
 387   while kill -0 "$child_pid" 2>/dev/null; do
 388     sleep 1
 389   done
 390   wait "$child_pid" 2>/dev/null || true
 391   case "$caught_signal" in
 392     HUP) rc=129 ;;
 393     INT) rc=130 ;;
 394     TERM) rc=143 ;;
 395   esac
 396   echo "cancel_signal=$caught_signal" >> "$run_file"
 397 fi
 398 
 399 if [ "$rc" -eq 0 ] && [ ! -s "$report_file" ]; then
 400   echo "adapter exited 0 but required report is absent: $report_file" >> "$log_file"
 401   rc=4
 402 fi
 403 
 404 # Truncation, not loss: a report is charged only through its sole standalone
 405 # BODY-END line.  Non-whitespace overflow is banked uncharged beside the raw
 406 # original; a finished report with no marker under a declared contract is
 407 # banked as a partial draft and the lane fails closed.
 408 seal_boundary=NOT_CHECKED
 409 report_state=MISSING
 410 overflow_file=xmodel/$tag.overflow
 411 raw_report_file=xmodel/$tag.raw.md
 412 if [ -s "$report_file" ]; then
 413   ready_seal_tool_sha=$(sha256_file "$seal_tool_snapshot") || ready_seal_tool_sha=ERROR
 414   if [ "$ready_seal_tool_sha" != "$seal_tool_sha" ]; then
 415     seal_boundary=TOOL_MUTATED
 416     report_state=UNVERIFIED
 417     echo "seal tool snapshot changed; result is quarantined" >> "$log_file"
 418     [ "$rc" -ne 0 ] || rc=5
 419   elif divert_out=$(python3 "$seal_tool_snapshot" divert "$report_file" \
 420       --overflow "$overflow_file" --raw "$raw_report_file" 2>&1); then
 421     printf '%s\n' "$divert_out" >> "$log_file"
 422     seal_boundary=$(printf '%s\n' "$divert_out" | \
 423       sed -n 's/.* status=\([A-Z_]*\).*/\1/p' | head -1)
 424     [ -n "$seal_boundary" ] || seal_boundary=UNPARSED
 425     case "$seal_boundary" in
 426       CLEAN|CLEAN_SEALED)
 427         report_state=BODY_SEALED
 428         ;;
 429       DIVERTED)
 430         report_state=BODY_SEALED_AFTER_DIVERT
 431         echo "post-BODY-END overflow diverted; charged body preserved" >> "$log_file"
 432         ;;
 433       NO_MARKER)
 434         report_state=PARTIAL_NO_MARKER
 435         if [ "$body_end_contract" = DECLARED ] && [ "$rc" -eq 0 ]; then
 436           echo "report has no BODY-END under a declared contract; banked as partial" >> "$log_file"
 437           rc=7
 438         fi
 439         ;;
 440       MULTI_MARKER)
 441         report_state=AMBIGUOUS_MULTI_MARKER
 442         echo "report has multiple BODY-END markers; not repaired" >> "$log_file"
 443         [ "$rc" -ne 0 ] || rc=7
 444         ;;
 445       *)
 446         report_state=UNVERIFIED
 447         [ "$rc" -ne 0 ] || rc=7
 448         ;;
 449     esac
 450   else
 451     printf '%s\n' "$divert_out" >> "$log_file"
 452     seal_boundary=ERROR
 453     report_state=UNVERIFIED
 454     echo "seal boundary check failed; result is quarantined" >> "$log_file"
 455     [ "$rc" -ne 0 ] || rc=7
 456   fi
 457 fi
 458 
 459 charge_basis_status=NOT_CHECKED
 460 if [ -s "$report_file" ]; then
 461   ready_charge_validator_sha=$(sha256_file "$charge_validator_snapshot") || ready_charge_validator_sha=ERROR
 462   if [ "$ready_charge_validator_sha" != "$charge_validator_sha" ]; then
 463     charge_basis_status=VALIDATOR_MUTATED
 464     echo "charge-basis validator snapshot changed; result is quarantined" >> "$log_file"
 465     [ "$rc" -ne 0 ] || rc=5
 466   elif charge_basis_result=$(python3 "$charge_validator_snapshot" "$report_file" 2>&1); then
 467     charge_basis_status=${charge_basis_result#charge_basis=}
 468   else
 469     charge_basis_status=INVALID
 470     echo "charge-basis validation failed; result is quarantined" >> "$log_file"
 471     echo "$charge_basis_result" >> "$log_file"
 472     [ "$rc" -ne 0 ] || rc=6
 473   fi
 474 fi
 475 
 476 post_prompt_sha=$(sha256_file "$prompt_file") || post_prompt_sha=ERROR
 477 post_adapter_sha=$(sha256_file "$adapter_script") || post_adapter_sha=ERROR
 478 post_launcher_sha=$(sha256_file "$script_dir/lane.sh") || post_launcher_sha=ERROR
 479 post_sandbox_profile_sha=$(sha256_file "$sandbox_profile") || post_sandbox_profile_sha=ERROR
 480 post_charge_validator_sha=$(sha256_file "$charge_validator") || post_charge_validator_sha=ERROR
 481 post_charge_validator_snapshot_sha=$(sha256_file "$charge_validator_snapshot") || post_charge_validator_snapshot_sha=ERROR
 482 post_seal_tool_sha=$(sha256_file "$seal_tool") || post_seal_tool_sha=ERROR
 483 post_seal_tool_snapshot_sha=$(sha256_file "$seal_tool_snapshot") || post_seal_tool_snapshot_sha=ERROR
 484 post_fallacy_sha=$(sha256_file "$fallacy_file") || post_fallacy_sha=ERROR
 485 post_model_prompt_sha=$(sha256_file "$model_prompt_file") || post_model_prompt_sha=ERROR
 486 if [ "$post_prompt_sha" != "$prompt_sha" ] || \
 487    [ "$post_adapter_sha" != "$adapter_sha" ] || \
 488    [ "$post_launcher_sha" != "$launcher_sha" ] || \
 489    [ "$post_sandbox_profile_sha" != "$sandbox_profile_sha" ] || \
 490    [ "$post_charge_validator_sha" != "$charge_validator_sha" ] || \
 491    [ "$post_charge_validator_snapshot_sha" != "$charge_validator_sha" ] || \
 492    [ "$post_seal_tool_sha" != "$seal_tool_sha" ] || \
 493    [ "$post_seal_tool_snapshot_sha" != "$seal_tool_sha" ] || \
 494    [ "$post_fallacy_sha" != "$fallacy_sha" ] || \
 495    [ "$post_model_prompt_sha" != "$model_prompt_sha" ]; then
 496   echo "hashed lane input changed during execution; result is quarantined" >> "$log_file"
 497   [ "$rc" -ne 0 ] || rc=5
 498 fi
 499 
 500 # Charged-input custody: a mutated snapshot quarantines the run; drift of the
 501 # repo original is recorded but does not, because the model read frozen bytes.
 502 if [ "$input_count" -gt 0 ]; then
 503   manifest_index=0
 504   while read -r manifest_rel manifest_base manifest_sha; do
 505     manifest_index=$((manifest_index + 1))
 506     post_snap_sha=$(sha256_file "$inputs_dir/$manifest_base") || post_snap_sha=ERROR
 507     post_src_sha=$(sha256_file "$repo_root/$manifest_rel") || post_src_sha=ERROR
 508     if [ "$post_snap_sha" != "$manifest_sha" ]; then
 509       input_state=SNAPSHOT_MUTATED
 510       echo "charged input snapshot changed during execution; result is quarantined: $manifest_rel" >> "$log_file"
 511       [ "$rc" -ne 0 ] || rc=5
 512     elif [ "$post_src_sha" != "$manifest_sha" ]; then
 513       input_state=REPO_DRIFT
 514     else
 515       input_state=UNCHANGED
 516     fi
 517     printf '%s %s\n' "$manifest_index" "$input_state" >> "$inputs_post_manifest"
 518   done < "$inputs_manifest"
 519 fi
 520 
 521 end_utc=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
 522 {
 523   echo "end_utc=$end_utc"
 524   echo "exit_code=$rc"
 525   echo "post_prompt_sha256=$post_prompt_sha"
 526   echo "post_adapter_sha256=$post_adapter_sha"
 527   echo "post_launcher_sha256=$post_launcher_sha"
 528   echo "post_sandbox_profile_sha256=$post_sandbox_profile_sha"
 529   echo "post_charge_basis_validator_sha256=$post_charge_validator_sha"
 530   echo "post_charge_basis_validator_snapshot_sha256=$post_charge_validator_snapshot_sha"
 531   echo "post_seal_tool_sha256=$post_seal_tool_sha"
 532   echo "post_seal_tool_snapshot_sha256=$post_seal_tool_snapshot_sha"
 533   echo "post_fallacy_sha256=$post_fallacy_sha"
 534   echo "post_model_prompt_sha256=$post_model_prompt_sha"
 535   echo "charge_basis_status=$charge_basis_status"
 536   echo "seal_boundary=$seal_boundary"
 537   echo "report_state=$report_state"
 538   if [ "$input_count" -gt 0 ] && [ -f "$inputs_post_manifest" ]; then
 539     while read -r manifest_index input_state; do
 540       echo "charged_input_${manifest_index}_post=$input_state"
 541     done < "$inputs_post_manifest"
 542   fi
 543   if [ -s "$report_file" ]; then
 544     echo "report=$report_file"
 545     echo "report_sha256=$(sha256_file "$report_file" || echo ERROR)"
 546   else
 547     echo "report=MISSING"
 548   fi
 549   if [ -s "$raw_report_file" ]; then
 550     echo "raw_report=$raw_report_file"
 551     echo "raw_report_sha256=$(sha256_file "$raw_report_file" || echo ERROR)"
 552   fi
 553   if [ -s "$overflow_file" ]; then
 554     echo "overflow=$overflow_file"
 555     echo "overflow_sha256=$(sha256_file "$overflow_file" || echo ERROR)"
 556   fi
 557   echo "log=$log_file"
 558   echo "log_sha256=$(sha256_file "$log_file" || echo ERROR)"
 559   if [ -n "$caught_signal" ]; then
 560     echo "final_status=CANCELLED"
 561   elif [ "$rc" -eq 0 ]; then
 562     echo "final_status=DONE"
 563   else
 564     echo "final_status=FAILED"
 565   fi
 566 } >> "$run_file"
 567 
 568 echo "$tag done rc=$rc start=$start_utc end=$end_utc" >> pilot-local.log
 569 exit "$rc"
 570 }
 571 

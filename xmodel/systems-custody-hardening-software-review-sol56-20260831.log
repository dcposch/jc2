  77 def sha256_file(path: Path) -> str:
  78     digest = hashlib.sha256()
  79     with path.open("rb") as handle:
  80         for block in iter(lambda: handle.read(1024 * 1024), b""):
  81             digest.update(block)
  82     return digest.hexdigest()
  83 

 193     def test_parent_replacement_is_refused_without_touching_decoy(self) -> None:
 194         path = self.make_file("# Anchored\n\n" + MARKER)
 195         parent = path.parent
 196         moved = parent.with_name(parent.name + "-moved")
 197         self.addCleanup(lambda: __import__("shutil").rmtree(moved, ignore_errors=True))
 198         original_read = SEAL_MODULE._read_regular_at
 199         calls = 0
 200 
 201         def swap_parent(parent_fd: int, name: str):
 202             nonlocal calls
 203             calls += 1
 204             if calls == 2:
 205                 parent.rename(moved)
 206                 parent.mkdir()
 207                 (parent / name).write_text("decoy\n", encoding="utf-8")
 208             return original_read(parent_fd, name)
 209 
 210         with mock.patch.object(
 211             SEAL_MODULE, "_read_regular_at", side_effect=swap_parent
 212         ):
 213             with self.assertRaises(SEAL_MODULE.SealError):
 214                 SEAL_MODULE.stamp_path(path, BASIS)
 215         self.assertEqual(path.read_text(encoding="utf-8"), "decoy\n")
 216         self.assertEqual((moved / path.name).read_text(encoding="utf-8"), "# Anchored\n\n" + MARKER)
 217 
 218     def test_directory_fsync_failure_is_typed_after_verified_install(self) -> None:
 219         path = self.make_file("# Durability\n\n" + MARKER)
 220         real_fsync = SEAL_MODULE.os.fsync
 221         calls = 0
 222 
 223         def fail_second_fsync(fd: int) -> None:
 224             nonlocal calls
 225             calls += 1
 226             if calls == 2:
 227                 raise OSError("synthetic directory fsync failure")
 228             real_fsync(fd)
 229 
 230         with mock.patch.object(SEAL_MODULE.os, "fsync", side_effect=fail_second_fsync):
 231             with self.assertRaises(SEAL_MODULE.SealDurabilityWarning):
 232                 SEAL_MODULE.stamp_path(path, BASIS)
 233         size, digest, basis = SEAL_MODULE.verify_path(path, expected_basis=BASIS)
 234         self.assertGreater(size, 0)
 235         self.assertEqual(len(digest), 64)
 236         self.assertEqual(basis, BASIS)

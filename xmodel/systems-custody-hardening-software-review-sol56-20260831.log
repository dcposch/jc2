 145 def _read_regular_at(
 146     parent_fd: int, name: str
 147 ) -> tuple[bytes, os.stat_result]:
 148     fd, info = _open_regular_at(parent_fd, name)
 149     try:
 150         chunks: list[bytes] = []
 151         while True:
 152             chunk = os.read(fd, 1024 * 1024)
 153             if not chunk:
 154                 break
 155             chunks.append(chunk)
 156         data = b"".join(chunks)
 157         after = os.fstat(fd)
 158         if _snapshot(after) != _snapshot(info) or len(data) != after.st_size:
 159             raise SealError("target changed while being read")
 160         return data, after
 161     finally:
 162         os.close(fd)
 163 

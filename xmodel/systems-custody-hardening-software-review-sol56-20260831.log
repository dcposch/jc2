  72 fallacy_bytes=$(wc -c < "$fallacy_file" | tr -d '[:space:]') || exit 2
  73 case "$fallacy_bytes" in
  74   ''|*[!0-9]*)
  75     echo "could not measure appendix: $fallacy_file" >&2
  76     exit 2
  77     ;;
  78 esac
  79 if [ "$fallacy_bytes" -eq 0 ] || [ "$fallacy_bytes" -gt 2048 ]; then
  80   echo "appendix must be 1..2048 bytes: $fallacy_file ($fallacy_bytes bytes)" >&2
  81   exit 2
  82 fi
  83 
  84 cd "$repo_root" || exit 2
  85 mkdir -p .lane-locks xmodel
  86 
  87 sha256_file() {
  88   if command -v sha256sum >/dev/null 2>&1; then
  89     sha_line=$(sha256sum "$1") || return 1
  90   elif command -v shasum >/dev/null 2>&1; then
  91     sha_line=$(shasum -a 256 "$1") || return 1
  92   else
  93     echo "no SHA-256 tool available" >&2
  94     return 1
  95   fi
  96   sha_value=${sha_line%% *}
  97   [ -n "$sha_value" ] || return 1
  98   printf '%s\n' "$sha_value"
  99 }

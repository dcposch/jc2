 516 def command_status(args: argparse.Namespace) -> int:
 517     require_darwin()
 518     root = repo_root()
 519     record = load_record(root, args.tag)
 520     value = parse_launchd(record)
 521     print(json.dumps(value, sort_keys=True) if args.json else format_status(value))
 522     return 0

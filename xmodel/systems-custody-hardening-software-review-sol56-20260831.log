 255 class DivertTest(unittest.TestCase):
 256     def make_file(self, text: str) -> Path:
 257         directory = Path(tempfile.mkdtemp(prefix="seal-divert-test-"))
 258         self.addCleanup(lambda: __import__("shutil").rmtree(directory, ignore_errors=True))
 259         path = directory / "report.md"
 260         path.write_text(text, encoding="utf-8")
 261         return path
 262 
 263     def divert(self, path: Path) -> tuple[subprocess.CompletedProcess[str], Path, Path]:
 264         overflow = path.parent / "report.overflow"
 265         raw = path.parent / "report.raw.md"
 266         result = run(
 267             "divert", str(path), "--overflow", str(overflow), "--raw", str(raw)
 268         )
 269         return result, overflow, raw
 270 
 271     def test_clean_report_is_untouched(self) -> None:
 272         body = "# report\n\nVERDICT: CONFIRMED\n\n" + MARKER
 273         path = self.make_file(body + "\n  \n")
 274         result, overflow, raw = self.divert(path)
 275         self.assertEqual(result.returncode, 0, result.stderr)
 276         self.assertIn("status=CLEAN", result.stdout)
 277         self.assertEqual(path.read_text(encoding="utf-8"), body + "\n  \n")
 278         self.assertFalse(overflow.exists())
 279         self.assertFalse(raw.exists())
 280 
 281     def test_canonically_sealed_report_is_untouched(self) -> None:
 282         body = "# report\n\nVERDICT: CONFIRMED\n\n" + MARKER
 283         path = self.make_file(sealed(body))
 284         result, overflow, raw = self.divert(path)
 285         self.assertEqual(result.returncode, 0, result.stderr)
 286         self.assertIn("status=CLEAN_SEALED", result.stdout)
 287         self.assertEqual(path.read_text(encoding="utf-8"), sealed(body))
 288         self.assertFalse(overflow.exists())
 289         self.assertFalse(raw.exists())
 290 
 291     def test_overflow_is_diverted_with_exact_hashes(self) -> None:
 292         body = "# report\n\nVERDICT: CONFIRMED\n\n" + MARKER
 293         tail = "stray bytes after the marker\n"
 294         original = body + tail
 295         path = self.make_file(original)
 296         result, overflow, raw = self.divert(path)
 297         self.assertEqual(result.returncode, 0, result.stderr)
 298         self.assertIn("status=DIVERTED", result.stdout)
 299         self.assertEqual(path.read_text(encoding="utf-8"), body)
 300         self.assertEqual(overflow.read_text(encoding="utf-8"), tail)
 301         self.assertEqual(raw.read_text(encoding="utf-8"), original)
 302         body_sha = hashlib.sha256(body.encode("utf-8")).hexdigest()
 303         tail_sha = hashlib.sha256(tail.encode("utf-8")).hexdigest()
 304         raw_sha = hashlib.sha256(original.encode("utf-8")).hexdigest()
 305         self.assertIn(f"body_sha256={body_sha}", result.stdout)
 306         self.assertIn(f"overflow_sha256={tail_sha}", result.stdout)
 307         self.assertIn(f"raw_sha256={raw_sha}", result.stdout)
 308 
 309     def test_zero_and_multiple_markers_are_reported_not_repaired(self) -> None:
 310         no_marker = self.make_file("# partial draft without a marker\n")
 311         result, overflow, raw = self.divert(no_marker)
 312         self.assertEqual(result.returncode, 0, result.stderr)
 313         self.assertIn("status=NO_MARKER", result.stdout)
 314         self.assertEqual(
 315             no_marker.read_text(encoding="utf-8"),
 316             "# partial draft without a marker\n",
 317         )
 318         self.assertFalse(overflow.exists())
 319         self.assertFalse(raw.exists())
 320 
 321         double = self.make_file("a\n" + MARKER + "b\n" + MARKER)
 322         result, overflow, raw = self.divert(double)
 323         self.assertEqual(result.returncode, 0, result.stderr)
 324         self.assertIn("status=MULTI_MARKER", result.stdout)
 325         self.assertEqual(
 326             double.read_text(encoding="utf-8"), "a\n" + MARKER + "b\n" + MARKER
 327         )
 328         self.assertFalse(overflow.exists())
 329         self.assertFalse(raw.exists())
 330 
 331     def test_existing_overflow_target_fails_exclusively(self) -> None:
 332         body = "# report\n\n" + MARKER
 333         path = self.make_file(body + "tail\n")
 334         (path.parent / "report.overflow").write_text("occupied\n", encoding="utf-8")
 335         result, overflow, raw = self.divert(path)
 336         self.assertEqual(result.returncode, 1)
 337         self.assertIn("cannot create", result.stderr)
 338         self.assertEqual(path.read_text(encoding="utf-8"), body + "tail\n")
 339         self.assertEqual(overflow.read_text(encoding="utf-8"), "occupied\n")
 340 
 341     def test_optimized_mode_matches(self) -> None:
 342         body = "# report\n\n" + MARKER
 343         path = self.make_file(body + "tail\n")
 344         overflow = path.parent / "report.overflow"
 345         raw = path.parent / "report.raw.md"
 346         result = run(
 347             "divert", str(path), "--overflow", str(overflow), "--raw", str(raw),
 348             optimized=True,
 349         )
 350         self.assertEqual(result.returncode, 0, result.stderr)
 351         self.assertIn("status=DIVERTED", result.stdout)
 352         self.assertEqual(path.read_text(encoding="utf-8"), body)

 187             SEAL_MODULE, "_read_regular_at", side_effect=raced_read
 188         ):
 189             with self.assertRaises(SEAL_MODULE.SealError):
 190                 SEAL_MODULE.stamp_path(path, BASIS)
 191         self.assertEqual(list(path.parent.glob(f".{path.name}.seal-*")), [])

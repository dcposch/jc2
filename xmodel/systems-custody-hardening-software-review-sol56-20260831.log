 430     plist_path = directory / "job.plist"
 431     stdout_path = directory / "supervisor.stdout"
 432     stderr_path = directory / "supervisor.stderr"
 433     write_exclusive(stdout_path, b"", 0o600)
 434     write_exclusive(stderr_path, b"", 0o600)
 435     plist = {
 436         "Label": label,
 437         "ProgramArguments": [
 438             "/bin/sh",
 439             os.fspath(launcher),
 440             args.adapter,
 441             args.tag,
 442             os.fspath(prompt),
 443         ],
 444         "WorkingDirectory": os.fspath(root),
 445         "EnvironmentVariables": safe_environment(),
 446         "RunAtLoad": True,
 447         "KeepAlive": False,
 448         "ProcessType": "Background",
 449         "AbandonProcessGroup": False,
 450         "StandardOutPath": os.fspath(stdout_path),
 451         "StandardErrorPath": os.fspath(stderr_path),
 452     }
 453     plist_payload = plistlib.dumps(plist, fmt=plistlib.FMT_XML, sort_keys=True)
 454     write_exclusive(plist_path, plist_payload, 0o400)
 455     record = {
 456         "schema": SCHEMA,
 457         "tag": args.tag,
 458         "adapter": args.adapter,
 459         "prompt": os.fspath(prompt),
 460         "label": label,
 461         "domain": domain,
 462         "repo_root": os.fspath(root),
 463         "supervisor": os.fspath(Path(__file__).resolve(strict=True)),
 464         "supervisor_sha256": sha256_file(Path(__file__).resolve(strict=True)),
 465         "launcher": os.fspath(launcher),
 466         "launch_utc": utc_now(),
 467         "prompt_sha256": sha256_file(prompt),
 468         "adapter_sha256": sha256_file(adapter),
 469         "launcher_sha256": sha256_file(launcher),
 470         "plist": os.fspath(plist_path),
 471         "plist_sha256": sha256_bytes(plist_payload),
 472         "supervisor_stdout": os.fspath(stdout_path),
 473         "supervisor_stderr": os.fspath(stderr_path),
 474         "launchctl": launchctl_path(),
 475     }
 476     record_payload = (json.dumps(record, indent=2, sort_keys=True) + "\n").encode("utf-8")
 477     write_exclusive(record_path(root, args.tag), record_payload, 0o400)
 478 
 479     completed = subprocess.run(
 480         [launchctl_path(), "bootstrap", domain, os.fspath(plist_path)],
 481         text=True,
 482         stdout=subprocess.PIPE,
 483         stderr=subprocess.STDOUT,
 484         timeout=30,
 485         check=False,
 486     )
 487     if completed.returncode != 0:
 488         failure = {
 489             "schema": SCHEMA,
 490             "tag": args.tag,
 491             "failed_utc": utc_now(),
 492             "bootstrap_exit": completed.returncode,
 493             "bootstrap_output": completed.stdout,
 494         }
 495         write_exclusive(
 496             directory / "bootstrap-failure.v1.json",
 497             (json.dumps(failure, indent=2, sort_keys=True) + "\n").encode("utf-8"),
 498             0o400,
 499         )
 500         raise LaneDetachError(
 501             f"launchd bootstrap failed for {args.tag}; sidecar retained for diagnosis"
 502         )
 503 
 504     value = parse_launchd(record)
 505     if args.json:
 506         print(json.dumps(value, sort_keys=True))
 507     else:
 508         print(format_status(value))
 509         print(
 510             "lane is launchd-supervised; use lane_detach.py wait/status and read "
 511             "the .run.v2 receipt only after a terminal state"
 512         )
 513     return 0

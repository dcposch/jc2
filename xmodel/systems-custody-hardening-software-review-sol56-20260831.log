 232 def load_record(root: Path, tag: str) -> dict[str, Any]:
 233     validate_tag(tag)
 234     directory = job_dir(root, tag)
 235     try:
 236         directory_info = os.lstat(directory)
 237     except OSError as exc:
 238         raise LaneDetachError(f"no detached-lane sidecar for tag: {tag}") from exc
 239     if stat.S_ISLNK(directory_info.st_mode) or not stat.S_ISDIR(directory_info.st_mode):
 240         raise LaneDetachError(f"detached-lane directory is not a real directory: {directory}")
 241     path = record_path(root, tag)
 242     require_regular_nonsymlink(path, "launch sidecar")
 243     try:
 244         value = json.loads(path.read_text(encoding="utf-8"))
 245     except (OSError, UnicodeError, json.JSONDecodeError) as exc:
 246         raise LaneDetachError(f"invalid launch sidecar: {path}: {exc}") from exc
 247     required = {
 248         "schema",
 249         "tag",
 250         "adapter",
 251         "prompt",
 252         "label",
 253         "domain",
 254         "repo_root",
 255         "supervisor",
 256         "supervisor_sha256",
 257         "launcher",
 258         "launch_utc",
 259         "prompt_sha256",
 260         "adapter_sha256",
 261         "launcher_sha256",
 262         "plist",
 263         "plist_sha256",
 264         "supervisor_stdout",
 265         "supervisor_stderr",
 266         "launchctl",
 267     }
 268     if not isinstance(value, dict) or not required.issubset(value):
 269         raise LaneDetachError(f"launch sidecar has an invalid schema: {path}")
 270     if value.get("schema") != SCHEMA or value.get("tag") != tag:
 271         raise LaneDetachError(f"launch sidecar identity mismatch: {path}")
 272     if value.get("repo_root") != os.fspath(root):
 273         raise LaneDetachError(f"launch sidecar repository mismatch: {path}")
 274     return value
 275 
 276 
 277 def service_name(record: dict[str, Any]) -> str:
 278     return f"{record['domain']}/{record['label']}"
 279 
 280 
 281 def launchctl_print(record: dict[str, Any]) -> tuple[int, str]:
 282     completed = subprocess.run(
 283         [launchctl_path(), "print", service_name(record)],
 284         text=True,
 285         stdout=subprocess.PIPE,
 286         stderr=subprocess.STDOUT,
 287         timeout=15,
 288         check=False,
 289     )
 290     return completed.returncode, completed.stdout
 291 
 292 
 293 def parse_launchd(record: dict[str, Any]) -> dict[str, Any]:
 294     unloaded_marker = job_dir(Path(record["repo_root"]), record["tag"]) / "unloaded.v1.json"
 295     if unloaded_marker.exists():
 296         return {
 297             "schema": SCHEMA,
 298             "tag": record["tag"],
 299             "label": record["label"],
 300             "state": "UNLOADED",
 301             "pid": None,
 302             "lane_exit_code": None,
 303             "launchd_state": None,
 304         }
 305 
 306     returncode, output = launchctl_print(record)
 307     base: dict[str, Any] = {
 308         "schema": SCHEMA,
 309         "tag": record["tag"],
 310         "label": record["label"],
 311         "state": "MISSING_JOB",
 312         "pid": None,
 313         "lane_exit_code": None,
 314         "launchd_state": None,
 315     }
 316     if returncode != 0:
 317         # A launchd registration should own the lane, but a crash between
 318         # process creation and registration visibility must not be mistaken
 319         # for terminal state.  Ask pgrep only for this exact campaign launcher
 320         # and tag; do not enumerate unrelated process command lines.
 321         pattern = (
 322             re.escape(str(record["launcher"]))
 323             + r" [a-z0-9_-]+ "
 324             + re.escape(str(record["tag"]))
 325             + r"(?: |$)"
 326         )
 327         pgrep = shutil.which("pgrep")
 328         if pgrep:
 329             probe = subprocess.run(
 330                 [pgrep, "-f", pattern],
 331                 text=True,
 332                 stdout=subprocess.PIPE,
 333                 stderr=subprocess.DEVNULL,
 334                 timeout=10,
 335                 check=False,
 336             )
 337             if probe.returncode == 0:
 338                 first_pid = next(
 339                     (int(line) for line in probe.stdout.splitlines() if line.isdigit()),
 340                     None,
 341                 )
 342                 if first_pid is not None:
 343                     base["state"] = "RUNNING"
 344                     base["pid"] = first_pid
 345                     base["launchd_state"] = "registration-missing-process-visible"
 346         return base
 347 
 348     active_match = re.search(r"^\s*active count = (\d+)\s*$", output, re.MULTILINE)
 349     state_match = re.search(r"^\s*state = ([^\n]+?)\s*$", output, re.MULTILINE)
 350     pid_match = re.search(r"^\s*pid = (\d+)\s*$", output, re.MULTILINE)
 351     exit_match = re.search(r"^\s*last exit code = (-?\d+)\s*$", output, re.MULTILINE)
 352     active = int(active_match.group(1)) if active_match else 0
 353     lane_exit = int(exit_match.group(1)) if exit_match else None
 354     base["pid"] = int(pid_match.group(1)) if pid_match else None
 355     base["lane_exit_code"] = lane_exit
 356     base["launchd_state"] = state_match.group(1) if state_match else None
 357     if active > 0:
 358         base["state"] = "RUNNING"
 359     elif lane_exit is not None:
 360         base["state"] = "SUCCEEDED" if lane_exit == 0 else "FAILED"
 361     else:
 362         base["state"] = "STARTING"
 363     return base
 364 
 365 
 366 def format_status(value: dict[str, Any]) -> str:
 367     fields = [value["tag"], value["state"]]
 368     if value.get("pid") is not None:
 369         fields.append(f"pid={value['pid']}")
 370     if value.get("lane_exit_code") is not None:
 371         fields.append(f"exit={value['lane_exit_code']}")
 372     if value.get("launchd_state"):
 373         fields.append(f"launchd={value['launchd_state']}")
 374     return " ".join(fields)
 375 

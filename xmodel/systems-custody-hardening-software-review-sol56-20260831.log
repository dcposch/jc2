 132             prompt_text = (
 133                 f"Investigate the bounded lane. Write the single report to "
 134                 f"xmodel/{tag}.md.\n"
 135             )
 136         prompt.write_text(prompt_text, encoding="utf-8")
 137         capture = root / f"{tag}.captured"
 138         prompt_path = root / f"{tag}.prompt-path"
 139         boundary_result = root / f"{tag}.boundary-result"

  1198	def p3_idp_verdict_for_closed_point(
  1199	    p: str,
  1200	    q: str,
  1201	    timeout: float = 60,
  1202	    binary: Optional[str] = None,
  1203	) -> Tuple[object, dict]:
  1204	    """I_DP construction + verdict for a closed parametrization in QQ[t].
  1205	
  1206	    Uses qqideal.double_point_ideal. Also reports the resultant of
  1207	    (p', q') as an immersive probe (0 iff not immersive). Does not
  1208	    claim reduced / length==6 / distinct tangents.
  1209	
  1210	    dimdeg is read off the leading monomials of the Rabinowitsch ideal
  1211	    in QQ[s,t,u] (three variables: the graph of the ordered pairs).
  1212	    """
  1213	    _prepare_msolve_path(binary)
  1214	    st = _import_stack()
  1215	    Ring = st["Ring"]
  1216	    double_point_ideal = st["double_point_ideal"]
  1217	    Kind = st["Kind"]
  1218	    dimdeg = st["dimdeg"]

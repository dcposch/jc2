   483	# ---------------------------------------------------------------------------
   484	# msolve text: render and parse (expanded unique-monomial sums)
   485	# ---------------------------------------------------------------------------
   486	
   487	_TOKEN_RE = re.compile(r"[A-Za-z][A-Za-z0-9]*|[0-9]+|[+\-*/^]")
   488	
   489	
   490	def render_mv(mv: MV) -> str:
   491	    """Expanded unique-monomial sum. Zero is ``0``. No parentheses."""
   492	    items = [(exp, c) for exp, c in mv.terms.items() if not _is_zero(c)]
   493	    if not items:
   494	        return "0"
   495	    if any(isinstance(c, QZeta) for _, c in items):
   496	        raise TypeError("cannot emit QQ(zeta) coefficients to msolve")
   497	
   498	    def grevlex_key(exp: Exp) -> Tuple:
   499	        return (-sum(exp), tuple(-e for e in reversed(exp)))
   500	
   501	    items.sort(key=lambda ec: grevlex_key(ec[0]))
   502	    pieces: List[str] = []
   503	    for exp, coeff in items:
   504	        frac = Fraction(coeff)  # type: ignore[arg-type]
   505	        neg, body = _term_body(exp, frac, mv.names)
   506	        if not pieces:
   507	            pieces.append("-" + body if neg else body)
   508	        else:
   509	            pieces.append(("-" if neg else "+") + body)
   510	    return "".join(pieces)
   511	
   512	
   513	def _term_body(exp: Exp, coeff: Fraction, names: Sequence[str]) -> Tuple[bool, str]:
   514	    neg = coeff < 0
   515	    num, den = abs(coeff.numerator), coeff.denominator
   516	    var_factors = []
   517	    for name, power in zip(names, exp):
   518	        if power == 1:
   519	            var_factors.append(name)
   520	        elif power > 1:
   521	            var_factors.append(f"{name}^{power}")
   522	    if not var_factors:
   523	        body = str(num) if den == 1 else f"{num}/{den}"
   524	    elif num == 1 and den == 1:
   525	        body = "*".join(var_factors)
   526	    elif den == 1:
   527	        body = "*".join([str(num), *var_factors])
   528	    else:
   529	        body = "*".join([f"{num}/{den}", *var_factors])
   530	    return neg, body
   531	
   532	
   533	def parse_mv(source: str, names: Tuple[str, ...]) -> MV:
   534	    """Parse an expanded monomial sum into an MV of ``names``."""
   535	    text = "".join(source.split())
   536	    if text.endswith(","):
   537	        text = text[:-1]
   538	    if text in ("", "0", "+0", "-0"):
   539	        return MV(names, {})
   540	    tokens = _TOKEN_RE.findall(text)
   541	    if "".join(tokens) != text:
   542	        raise ValueError(f"unparsed residue in {source!r}")
   543	    index = {n: i for i, n in enumerate(names)}
   544	    nvars = len(names)
   545	    terms: Dict[Exp, Coeff] = {}
   546	    pos = 0
   547	    ntok = len(tokens)
   548	    while pos < ntok:
   549	        sign = 1
   550	        if tokens[pos] in ("+", "-"):
   551	            sign = -1 if tokens[pos] == "-" else 1
   552	            pos += 1
   553	            if pos >= ntok:
   554	                raise ValueError(f"trailing sign in {source!r}")
   555	        coeff_num, coeff_den = 1, 1
   556	        exp = [0] * nvars
   557	        leading = True
   558	        while True:
   559	            if pos >= ntok:
   560	                raise ValueError(f"truncated term in {source!r}")
   561	            tok = tokens[pos]
   562	            if tok.isdigit():
   563	                if not leading:
   564	                    raise ValueError(f"mid-term numeral {tok} in {source!r}")
   565	                coeff_num = int(tok)
   566	                pos += 1
   567	                if pos < ntok and tokens[pos] == "/":
   568	                    pos += 1
   569	                    if pos >= ntok or not tokens[pos].isdigit():
   570	                        raise ValueError(f"bad denominator in {source!r}")
   571	                    coeff_den = int(tokens[pos])
   572	                    if coeff_den == 0:
   573	                        raise ValueError("zero denominator")
   574	                    pos += 1
   575	            elif tok[0].isalpha():
   576	                if tok not in index:
   577	                    raise ValueError(f"unknown identifier {tok!r} in {source!r}")
   578	                pos += 1
   579	                power = 1
   580	                if pos < ntok and tokens[pos] == "^":
   581	                    pos += 1
   582	                    if pos >= ntok or not tokens[pos].isdigit():
   583	                        raise ValueError(f"bad exponent of {tok} in {source!r}")
   584	                    power = int(tokens[pos])
   585	                    pos += 1
   586	                exp[index[tok]] += power
   587	            else:
   588	                raise ValueError(f"unexpected {tok!r} in {source!r}")
   589	            leading = False
   590	            if pos >= ntok or tokens[pos] in ("+", "-"):
   591	                break
   592	            if tokens[pos] != "*":
   593	                raise ValueError(f"expected '*', got {tokens[pos]!r} in {source!r}")
   594	            pos += 1
   595	        key = tuple(exp)
   596	        value = Fraction(sign * coeff_num, coeff_den)
   597	        terms[key] = terms.get(key, Fraction(0)) + value
   598	    return MV(names, terms)
   599	

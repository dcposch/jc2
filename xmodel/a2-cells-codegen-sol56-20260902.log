   622	def load_ms_generators(path: Path) -> Tuple[List[str], List[str]]:
   623	    text = path.read_text(encoding="utf-8")
   624	    if not text.endswith("\n"):
   625	        raise ValueError(f"{path} is not POSIX text (missing trailing newline)")
   626	    lines = text.splitlines()
   627	    variables = lines[0].split(",")
   628	    if lines[1] != "0":
   629	        raise ValueError(f"{path} characteristic line is {lines[1]!r}, not '0'")
   630	    gens = []
   631	    for line in lines[2:]:
   632	        s = line.strip()
   633	        if s.endswith(","):
   634	            s = s[:-1]
   635	        gens.append(s)
   636	    return variables, gens

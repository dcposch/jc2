   745	def _charged_a_point() -> Dict[str, Coeff]:
   746	    """Audit §5 / codegen §7 (i). Chart order (B,C,D,E,F,G,b,gam,d,e,f)."""
   747	    z = QZeta(Fraction(0), Fraction(1))

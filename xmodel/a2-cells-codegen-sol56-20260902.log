   987	def _poly_diff_univariate(poly, var: str = "t"):
   988	    """Differentiate a qqideal Poly with respect to one variable, via terms()."""
   989	    ring = poly.ring
   990	    i = ring.names.index(var)
   991	    acc = ring.constant(0)
   992	    gens = ring.gens()
   993	    for exp, coeff in poly.terms():
   994	        power = exp[i]
   995	        if power == 0:
   996	            continue
   997	        frac = Fraction(int(coeff.numer()), int(coeff.denom())) * power
   998	        new_exp = list(exp)
   999	        new_exp[i] = power - 1
  1000	        mon = ring.constant(frac)
  1001	        for gen, ee in zip(gens, new_exp):
  1002	            if ee:
  1003	                mon = mon * (gen ** ee)
  1004	        acc = acc + mon
  1005	    return acc
  1006	

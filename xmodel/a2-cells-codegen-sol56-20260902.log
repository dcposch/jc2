   328	def _const(names: Tuple[str, ...], value: object) -> MV:
   329	    if isinstance(value, MV):
   330	        return value
   331	    if _is_zero(value):
   332	        return MV(names, {})
   333	    if isinstance(value, QZeta):
   334	        coeff: Coeff = value
   335	    else:
   336	        coeff = Fraction(value)  # type: ignore[arg-type]
   337	    return MV(names, {(0,) * len(names): coeff})
   338	
   339	
   340	def _var(names: Tuple[str, ...], name: str) -> MV:
   341	    exp = [0] * len(names)
   342	    exp[names.index(name)] = 1
   343	    return MV(names, {tuple(exp): Fraction(1)})
   344	
   345	
   346	# Univariate-in-t: degree -> coefficient MV
   347	UPoly = Dict[int, MV]
   348	
   349	
   350	def _uadd(a: UPoly, b: UPoly) -> UPoly:
   351	    out: UPoly = dict(a)
   352	    for deg, coeff in b.items():
   353	        out[deg] = out[deg] + coeff if deg in out else coeff
   354	    return {d: c for d, c in out.items() if not c.is_zero()}
   355	
   356	
   357	def _usub(a: UPoly, b: UPoly) -> UPoly:
   358	    return _uadd(a, {d: -c for d, c in b.items()})
   359	
   360	
   361	def _umul(a: UPoly, b: UPoly) -> UPoly:
   362	    out: UPoly = {}
   363	    for i, ci in a.items():
   364	        for j, cj in b.items():
   365	            deg = i + j
   366	            prod = ci * cj
   367	            out[deg] = out[deg] + prod if deg in out else prod
   368	    return {d: c for d, c in out.items() if not c.is_zero()}
   369	
   370	
   371	def _upow(a: UPoly, n: int) -> UPoly:
   372	    if n < 0:
   373	        raise ValueError("negative power")
   374	    if not a:
   375	        if n == 0:
   376	            raise ValueError("0^0")
   377	        return {}
   378	    names = next(iter(a.values())).names
   379	    result: UPoly = {0: _const(names, 1)}
   380	    if n == 0:
   381	        return result
   382	    base = a
   383	    exp = n
   384	    while exp:
   385	        if exp & 1:
   386	            result = _umul(result, base)
   387	        base = _umul(base, base)
   388	        exp >>= 1
   389	    return result
   390	
   391	
   392	def _uscale(a: UPoly, mv: MV) -> UPoly:
   393	    return {d: c * mv for d, c in a.items()}
   394	

  1220	    Rt = Ring("t")
  1221	    poly_p = Rt(p)
  1222	    poly_q = Rt(q)
  1223	    dp = _poly_diff_univariate(poly_p, "t")
  1224	    dq = _poly_diff_univariate(poly_q, "t")
  1225	    res = Rt.resultant(dp, dq, "t")
  1226	    # resultant wrt the only variable is a constant polynomial
  1227	    immersive = not res.is_zero()
  1228	
  1229	    idp = double_point_ideal(poly_p, poly_q, names=("s", "t"))
  1230	    started = time.monotonic()
  1231	    verdict = idp.verdict(timeout=timeout)
  1232	    wall = time.monotonic() - started
  1233	    dd = None
  1234	    if verdict.kind is Kind.NONEMPTY or verdict.kind is Kind.EMPTY:
  1235	        try:
  1236	            leading = idp.leading_monomials(timeout=timeout)
  1237	            dd = dimdeg.dim_and_degree(leading, idp.ring.nvars)
  1238	        except Exception as exc:  # noqa: BLE001 — record, do not guess
  1239	            dd = ("OPEN", str(exc))
  1240	    notes = {
  1241	        "idp_ring": list(idp.ring.names),
  1242	        "immersive_resultant_nonzero": immersive,
  1243	        "immersive_note": (
  1244	            "resultant(p',q') != 0 over QQ iff gcd(p',q')=1. "
  1245	            "This is NOT checked by double_point_ideal itself."
  1246	        ),
  1247	        "dimdeg_from_leading": dd,
  1248	        "wall_seconds": wall,
  1249	        "msolve_version": verdict.msolve_version,
  1250	        "contract": IDP_CONTRACT,
  1251	        "delta_aff_target": 6,
  1252	        "ordered_degree_if_six_ordinary_nodes": 12,
  1253	    }

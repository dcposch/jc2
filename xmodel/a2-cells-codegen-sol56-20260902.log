   638	
   639	def subst_mv(mv: MV, values: Mapping[str, Coeff]) -> MV:
   640	    idx = {n: i for i, n in enumerate(mv.names)}
   641	    pairs = [(idx[n], values[n]) for n in values if n in idx]
   642	    out: Dict[Exp, Coeff] = {}
   643	    for exp, coeff in mv.terms.items():
   644	        new_exp = list(exp)
   645	        c: Coeff = coeff
   646	        for i, val in pairs:
   647	            power = new_exp[i]
   648	            new_exp[i] = 0
   649	            if power:
   650	                c = c * (val ** power)  # type: ignore[operator]
   651	        key = tuple(new_exp)
   652	        out[key] = out[key] + c if key in out else c  # type: ignore[operator]
   653	    return MV(mv.names, out)
   654	

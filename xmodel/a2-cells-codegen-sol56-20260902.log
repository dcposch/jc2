  1008	def build_incidence(spec: JobSpec):
  1009	    """Build I0 and g_c as qqideal objects. Symbolic; no msolve.
  1010	
  1011	    Correspondence, restated at the call site:
  1012	
  1013	        I0      = Ideal([g_j for j=closed_hi..closed_lo], ring=R0)
  1014	                  <-> M2 I0 = ideal closedGens  (e.g. corrected_863.m2:35)
  1015	        Iopen   = I0.saturate(g_c)
  1016	                  <-> M2 Iopen = I0 + (u*g_c-1) (corrected_863.m2:42)
  1017	                  <-> .ms last generator u*g_c-1
  1018	        Cover   = (B,D,F,gam,e) or (P6,P4,P2,Q3,Q1) is NOT applied.
  1019	                  M2 colonInf is I : Cover^∞; v0.1 saturate(product)
  1020	                  is the wrong open (see module docstring).
  1021	    """
  1022	    st = _import_stack()
  1023	    Ring, Ideal = st["Ring"], st["Ideal"]
  1024	    names, closed, open_s, _gopen = closed_open_generators(spec)
  1025	    R0 = Ring(*names)
  1026	    I0 = Ideal(closed, ring=R0)
  1027	    return st, names, I0, open_s, closed
  1028	

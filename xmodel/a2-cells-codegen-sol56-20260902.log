   749	        "B": Fraction(1),
   750	        "C": Fraction(0),
   751	        "D": (Fraction(294) - z) / Fraction(144),
   752	        "E": Fraction(0),
   753	        "F": (Fraction(150) - z) / Fraction(48),
   754	        "G": Fraction(0),
   755	        "b": Fraction(1),
   756	        "gam": Fraction(3, 4),
   757	        "d": Fraction(1),
   758	        "e": -(Fraction(138) + z) / Fraction(192),
   759	        "f": (Fraction(2) * z - Fraction(71)) / Fraction(144),
   760	    }

   601	def closed_open_generators(spec: JobSpec) -> Tuple[Tuple[str, ...], List[str], str, MV]:
   602	    """Return (var_names, closed msolve strings, open msolve string, open MV)."""
   603	    if spec.family == "86":
   604	        names, g = expand_g86(spec.aux)
   605	    else:
   606	        names, g = expand_g96(spec.aux)
   607	    closed: List[str] = []
   608	    for j in range(spec.closed_hi, spec.closed_lo - 1, -1):
   609	        gj = coeff_t(g, j, names)
   610	        if gj.is_zero():
   611	            raise AssertionError(
   612	                f"{spec.job_id}: g_{j} vanished identically; the closed "
   613	                f"range {spec.closed_hi}..{spec.closed_lo} is a required slot"
   614	            )
   615	        closed.append(render_mv(gj))
   616	    gopen = coeff_t(g, spec.open_deg, names)
   617	    if gopen.is_zero():
   618	        raise AssertionError(f"{spec.job_id}: g_{spec.open_deg} vanished identically")
   619	    return names, closed, render_mv(gopen), gopen

  1030	def _run_incidence(
  1031	    spec: JobSpec,
  1032	    timeout: float,
  1033	    binary: Optional[str] = None,
  1034	) -> Tuple[object, dict]:
  1035	    _prepare_msolve_path(binary)
  1036	    st, names, I0, open_s, closed = build_incidence(spec)
  1037	    ideal_verdict = st["ideal_verdict"]
  1038	    emit_system = st["emit_system"]
  1039	
  1040	    # Custody SHA-256 is of the saturated (Rabinowitsch) system, which is
  1041	    # what msolve actually sees. saturate is symbolic.
  1042	    Iopen = I0.saturate(open_s)
  1043	    source = Iopen.to_msolve()
  1044	    # emit_system is the library primitive named in the charge; to_msolve
  1045	    # calls it. Re-emit from generator strings as an independent custody
  1046	    # of the closed+open pair (without slack) as well.
  1047	    closed_source = emit_system(
  1048	        closed,
  1049	        variables=list(names),
  1050	        characteristic=0,
  1051	    )
  1052	    started = time.monotonic()
  1053	    verdict = ideal_verdict(I0, opens=[open_s], timeout=timeout)
  1054	    wall = time.monotonic() - started
  1055	    # never `if verdict:`
  1056	    kind_name = verdict.kind.value
  1057	    certainty_name = verdict.certainty.value
  1058	    custody = {
  1059	        "job": spec.job_id,
  1060	        "delta": spec.delta,
  1061	        "family": spec.family,
  1062	        "closed_range": (spec.closed_hi, spec.closed_lo),
  1063	        "open_deg": spec.open_deg,
  1064	        "delta_aff": spec.delta_aff,
  1065	        "ring_closed": list(names),
  1066	        "ring_open": list(Iopen.ring.names),
  1067	        "ngens_closed": len(closed),
  1068	        "ngens_open": len(Iopen.gens),
  1069	        "input_sha256": hashlib.sha256(source.encode("utf-8")).hexdigest(),
  1070	        "closed_sha256": hashlib.sha256(
  1071	            closed_source.encode("utf-8")
  1072	        ).hexdigest(),
  1073	        "msolve_version": verdict.msolve_version,
  1074	        "wall_seconds": wall,
  1075	        "kind": kind_name,
  1076	        "certainty": certainty_name,
  1077	        "dim": verdict.dim,
  1078	        "degree": verdict.degree,
  1079	        "detail": verdict.detail,
  1080	        "cover_not_applied": list(spec.cover),
  1081	        "cover_note": (
  1082	            "M2 colonInf(Iopen, Cover) is I : Cover^∞ for an ideal; "
  1083	            "qqideal v0.1 saturate/colon inverts one polynomial. Not faked. "
  1084	            "c-open already excludes common covers (gcd(d,n,c)=1)."
  1085	        ),
  1086	    }
  1087	    return verdict, custody

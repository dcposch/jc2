   916	def run_self_checks() -> Tuple[bool, List[str]]:
   917	    """Return (all_pass, transcript lines). No msolve, no qqideal."""
   918	    blocks = [
   919	        _lines_leading_identities(),
   920	        _lines_ms_encoding(),
   921	        _lines_check_i(),
   922	        _lines_check_ii(),
   923	        _lines_check_iii(),
   924	    ]
   925	    lines: List[str] = []
   926	    ok = True
   927	    for block in blocks:
   928	        if lines:
   929	            lines.append("")
   930	        lines.extend(block)
   931	        tail = block[-1]
   932	        if not tail.endswith("PASS"):
   933	            ok = False
   934	    lines.append("")
   935	    lines.append("SELF-CHECKS OVERALL: PASS" if ok else "SELF-CHECKS OVERALL: FAIL")
   936	    return ok, lines

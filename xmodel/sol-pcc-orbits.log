+g_class_counts= [18, 6, 3] multiplicities= [[2], [6], [12]] joint_classes= 36
+degrees= {'r1': '1001111222220000001111110020200000',
+          'r2': '1001111222222000001111110021000000',
+          's1': '0000000000000000000000000000000000',

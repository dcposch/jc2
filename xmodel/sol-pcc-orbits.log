    elif which == "wf2":
        st["jfF3"] = jmul(st["jfF2"], st["jfF"], dF)
    elif which == "wf3":
        st["WF"] = jadd(jmul(st["jgF"], st["jgF"], dF),
                        jscal(st["jfF3"], K3(-1)))
    print("  phase %s done (%.1fs)" % (which, time.time()-t0), flush=True)
    save_state(st)


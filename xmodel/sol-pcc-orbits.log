  1138	def row_to_txt(row, hdrpos, p, interp=False):
  1139	    items = []
  1140	    if interp:
  1141	        for (s22, lift), bd in row.items():
  1142	            for bexp, c in bd.items():
  1143	                items.append((s22, lift, bexp, c % p))
  1144	    else:
  1145	        for (s22, lift), c in row.items():
  1146	            items.append((s22, lift, (), c % p))
  1147	    items = [t for t in items if t[3]]
  1148	    items.sort(key=lambda t: (-(degof(t[0]) + sum(e for _, e in t[1])
  1149	                                + sum(t[2])), str((t[0], t[1], t[2]))))
  1150	    terms = []
  1151	    for s22, lift, bexp, c in items:
  1152	        m = mono_str(s22, lift, bexp, hdrpos)
  1153	        terms.append("%d*%s" % (c, m) if m else "%d" % c)
  1154	    return "+".join(terms) if terms else "0"

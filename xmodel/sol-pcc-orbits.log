                            tw = vscal(vv, rmono(za=(c*lv) % 42))
                            if tw: fac[(0, lv-32)] = vscal(tw, K3(-1))
                    jp = jmul(jp, fac, depth)
                continue
            # Delta = P - C_k Y (slots rel level 12), then suborbit Newton
            D = {}

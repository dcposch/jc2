  1177	            if head.isdigit():
  1178	                assert int(head) < p, ("GATE-F2 coefficient >= p",
  1179	                                       head)
  1180	            if "*" in t or not head.isdigit():
  1181	                allconst = False
  1182	        assert not (allconst and row not in ("0",)), \

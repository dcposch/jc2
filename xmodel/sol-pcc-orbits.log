  1107	            if ex:
  1108	                fs.append((hdrpos[nm], nm, ex))
  1109	    fs.sort()
  1110	    return "*".join("%s^%d" % (nm, ex) if ex > 1 else nm
  1111	                    for _, nm, ex in fs)

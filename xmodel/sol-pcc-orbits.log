   305	def fold_cell(vex, vars_, fv, r3v, p, pinstats=None):
   306	    """One bank cell -> ext poly mod p at the fiber (PIN42 dropped)."""
   307	    A1, A2 = fv["A1"], fv["A2"]
   308	    hw1, hw2 = fv["HW1_over_W1"], fv["HW2_over_W2"]
   309	    out = {}
   310	    for key, r in vex.items():
   311	        epos = [0] * NV
   312	        lift = {}
   313	        pinned = False
   314	        for i in key:
   315	            nm = vars_[i]
   316	            if nm in PIN42:
   317	                pinned = True
   318	                break
   319	            if nm in DR.BASE18:
   320	                epos[DR.TAIL2POS[nm]] += 1
   321	            else:
   322	                lift[nm] = lift.get(nm, 0) + 1
   323	        if pinned:
   324	            if pinstats is not None:
   325	                pinstats[0] += 1
   326	            continue
   327	        lt = tuple(sorted(lift.items()))
   328	        for (za, e1, e2, pw, h1, qw, h2, eB), c in r.items():
   329	            assert za == 0 and eB == 0, "unexpected za/eB in bank"
   330	            c0, c1 = Fraction(c[0]), Fraction(c[1])
   331	            cm = (c0.numerator % p * pow(c0.denominator % p, p - 2, p)
   332	                  + c1.numerator % p * pow(c1.denominator % p, p - 2, p)
   333	                  * r3v) % p
   334	            cm = cm * pow(A1, e1, p) % p * pow(A2, e2, p) % p
   335	            cm = cm * pow(hw1, h1, p) % p * pow(hw2, h2, p) % p
   336	            if not cm:
   337	                continue
   338	            e = list(epos)
   339	            e[IW1] += pw + h1
   340	            e[IW2] += qw + h2
   341	            k = (pack(e), lt)
   342	            nc = (out.get(k, 0) + cm) % p
   343	            if nc: out[k] = nc
   344	            else: out.pop(k, None)
   345	    return out

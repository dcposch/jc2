    if bexp:
        for nm, ex in zip(SELVARS, bexp):
            if ex:
                fs.append((hdrpos[nm], nm, ex))
    fs.sort()
    return "*".join("%s^%d" % (nm, ex) if ex > 1 else nm
                    for _, nm, ex in fs)



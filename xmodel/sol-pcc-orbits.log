   512	        if VARS[v]["kind"] == "stretch": P[VARS[v]["level"]] = vvar(v)
   513	    jp = JONE
   514	    nfac = 0
   515	    for on in orbnames:
   516	        orb = orbs[on]; Y = orb["series"]; n7 = C7SUB[orb["size"]]
   517	        Aside = 12 in Y and rk3(Y[12].get((), RZERO)) and \
   518	                rk3(Y[12].get((), RZERO))[0] == KONE
   519	        for k in range(7):
   520	            for j in range(n7):
   521	                c = (k + 7*j) % 42

    assert 42 * 42 + 2 * 12 - 1725 == 63 > 54
    assert 42 * 42 + 2 * 12 - 1721 == 67 > 54
    assert 63 * 42 + 2 * 12 - 2606 == 64 > 54
    assert 63 * 42 + 2 * 12 - 2600 == 70 > 55

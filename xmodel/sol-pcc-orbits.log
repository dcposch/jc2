  1184	        assert row != "0", "GATE-F2 zero row emitted"
  1185	    log("F: AUDIT hygiene PASS on %s (paren-free, coeffs < p, %d "
  1186	        "rows, no bare-constant row)" % (os.path.basename(path),
  1187	                                         len(rows)))

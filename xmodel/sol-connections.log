from fractions import Fraction as Q

def add(a,b):
 n=max(len(a),len(b)); c=[Q(0)]*n
 for i in range(n): c[i]=(a[i] if i<len(a) else 0)+(b[i] if i<len(b) else 0)
 while len(c)>1 and c[-1]==0:c.pop()
 return c
def mul(a,b):
 c=[Q(0)]*(len(a)+len(b)-1)
 for i,x in enumerate(a):
  for j,y in enumerate(b):c[i+j]+=x*y
 while len(c)>1 and c[-1]==0:c.pop()
 return c
def scale(a,s):return [s*x for x in a]
def der(a):return [Q(i)*a[i] for i in range(1,len(a))] or [Q(0)]
def power(a,n):
 c=[Q(1)]
 for _ in range(n):c=mul(c,a)
 return c
u=[Q(0),Q(1)]
N=mul(u,power([Q(-2,3),Q(1)],3))
D=power([Q(1,6),Q(-1),Q(1)],2)
M=add(N,scale(D,-1))
H=add(mul(der(N),D),scale(mul(N,der(D)),-1))
print('N',N)
print('D',D)
print('N-D',M)
print('derivative numerator',H)
# divide H by (u-2/3)"'^2
qfac=power([Q(-2,3),Q(1)],2)
def divmodp(a,b):
 a=a[:]; q=[Q(0)]*max(1,(len(a)-len(b)+1))
 while len(a)>=len(b) and any(a):
  k=len(a)-len(b); c=a[-1]/b[-1];q[k]=c
  for j in range(len(b)):a[j+k]-=c*b[j]
  while len(a)>1 and a[-1]==0:a.pop()
 return q,a
print('"'divide',divmodp(H,qfac))
PY" in /Users/dc/code/math/jc72108

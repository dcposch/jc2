   506	## 7. Exact SymPy reproduction
   507	
   508	The default repository python3 did not contain SymPy. The run used the
   509	ephemeral command
   510	
   511	~~~bash
   512	UV_CACHE_DIR=/tmp/jc72108-uv-cache PYTHONDONTWRITEBYTECODE=1 \
   513	  uv run --no-project --with sympy python3 - <<'PY'
   514	~~~
   515	
   516	with the following body. All arithmetic is symbolic over \(\mathbb Q\); no
   517	floating-point values occur.
   518	
   519	~~~python
   520	import sympy as s
   521	x,y,u,v,t,e,c,a,b2,b3,b4 = s.symbols(
   522	    'x y u v t eta c42 a b2 b3 b4')
   523	
   524	def W(F,G,z,w):
   525	    return s.factor(s.diff(F,z)*s.diff(G,w)-s.diff(F,w)*s.diff(G,z))
   526	def act(F,G,X,Y,z,w):
   527	    return (s.factor(F*s.diff(G,z)-X*s.diff(Y,z)),
   528	            s.factor(F*s.diff(G,w)-X*s.diff(Y,w)))
   529	def curl(A,B,z,w):
   530	    return s.factor(s.diff(B,z)-s.diff(A,w))
   531	def gradcheck(A,B,S,z,w):
   532	    return (s.factor(A-s.diff(S,z)), s.factor(B-s.diff(S,w)))
   533	
   534	# Elementary automorphism.
   535	P=x; Q=y+x**4
   536	T=s.Rational(4,5)*x**5; U=s.Rational(1,5)*x**5
   537	A,B=act(P,Q,x,y,x,y); A2,B2=act(Q,P,y,x,x,y)
   538	assert W(P,Q,x,y)==1 and gradcheck(A,B,T,x,y)==(0,0)

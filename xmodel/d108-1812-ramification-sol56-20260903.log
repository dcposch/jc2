   272	def control_s3_Q():
   273	    print("\n-- CONTROL Q: s=3 => Q_2 = u; s>3 => Q_{s-1} = V_s d_{s-1}/d_s --")
   274	    seen3 = seen4 = bad3 = bad4 = 0
   275	    for n in range(48, 121):
   276	        for (m, Ms, V) in census(n, full=True):
   277	            S = Skel(n, m, list(Ms), V)
   278	            Qtop = Q_of(S, S.s - 1)
   279	            if S.s == 3:
   280	                seen3 += 1
   281	                if Qtop != int(S.u):
   282	                    bad3 += 1
   283	            else:
   284	                seen4 += 1
   285	                want = S.V[S.s] * S.d[S.s - 1] // S.d[S.s]
   286	                if Qtop != want:
   287	                    bad4 += 1
   288	    check("s=3 Q2=u on all (1)-(13) s=3 assignments", bad3 == 0 and seen3 > 0,
   289	          "bad=%d seen=%d" % (bad3, seen3))
   290	    check("s>3 Qtop=V_s d_{s-1}/d_s on all (1)-(13) s>3 assignments",
   291	          bad4 == 0 and seen4 > 0, "bad=%d seen=%d" % (bad4, seen4))
   292	    print("   %d s=3 assignments Q2=u; %d s>3 assignments Qtop formula (bad 0)"
   293	          % (seen3, seen4))
   294	

    56	# ---------------------------------------------------------------------------
    57	# nested DP
    58	# ---------------------------------------------------------------------------
    59	def Q_of(S, j):
    60	    """deg p at D_j: V_{j+1} d_j / d_{j+1} (exact in Z)."""
    61	    num = S.V[j + 1] * S.d[j]
    62	    den = S.d[j + 1]
    63	    assert num % den == 0, (S.n, j, num, den)
    64	    return num // den
    65	
    66	
    67	def _vkey(S):
    68	    return tuple(S.V[i] for i in range(2, S.s + 1))
    69	
    70	
    71	def mix_dp(nz_items, z_items, Q, Nhi, CAP):
    72	    """Unbounded NZ items + at most one Z item.  Items are (w, [values]).
    73	
    74	    Returns (set of reachable Fractions including 0, capped).
    75	    """
    76	    Q = int(Q)
    77	    reach = [set() for _ in range(Q + 1)]
    78	    reach[0].add(F(0))
    79	    capped = False
    80	    nstates = 1
    81	
    82	    for (w, vals) in nz_items:
    83	        w = int(w)
    84	        if w <= 0 or w > Q:
    85	            continue
    86	        vals = [v for v in vals if 0 < v <= Nhi]
    87	        if not vals:
    88	            continue
    89	        for tw in range(w, Q + 1):
    90	            src = reach[tw - w]
    91	            if not src:
    92	                continue
    93	            dst = reach[tw]
    94	            for s0 in list(src):
    95	                for v in vals:
    96	                    s1 = s0 + v
    97	                    if s1 > Nhi:
    98	                        continue
    99	                    if s1 in dst:
   100	                        continue
   101	                    if len(dst) >= CAP:
   102	                        capped = True
   103	                        continue
   104	                    dst.add(s1)
   105	                    nstates += 1
   106	
   107	    extra = [set() for _ in range(Q + 1)]
   108	    for (w, vals) in z_items:
   109	        w = int(w)
   110	        if w <= 0 or w > Q:
   111	            continue
   112	        vals = [v for v in vals if 0 < v <= Nhi]
   113	        if not vals:
   114	            continue
   115	        for tw in range(0, Q - w + 1):
   116	            src = reach[tw]
   117	            if not src:
   118	                continue
   119	            dst = extra[tw + w]
   120	            for s0 in src:
   121	                for v in vals:
   122	                    s1 = s0 + v
   123	                    if s1 > Nhi:
   124	                        continue
   125	                    if s1 in dst or s1 in reach[tw + w]:
   126	                        continue
   127	                    if len(dst) >= CAP:
   128	                        capped = True
   129	                        continue
   130	                    dst.add(s1)
   131	                    nstates += 1
   132	    for tw in range(Q + 1):
   133	        if extra[tw]:
   134	            dst = reach[tw]
   135	            for s1 in extra[tw]:
   136	                if s1 in dst:
   137	                    continue
   138	                if len(dst) >= CAP:
   139	                    capped = True
   140	                    break
   141	                dst.add(s1)
   142	
   143	    acc = set()
   144	    for cell in reach:
   145	        acc |= cell
   146	    return acc, capped, nstates
   147	
   148	
   149	def reachable(skels, j, Nhi, CAP, memo):
   150	    """Achievable N from packing parent D_j.  skels share V[j+1],...,V[s]."""
   151	    S0 = skels[0]
   152	    key = (j, tuple(sorted(_vkey(S) for S in skels)))
   153	    if key in memo:
   154	        return memo[key]
   155	
   156	    Q = Q_of(S0, j)
   157	    by_v = {}
   158	    for S in skels:
   159	        by_v.setdefault(int(S.V[j]), []).append(S)
   160	
   161	    nz_items = []
   162	    z_items = []
   163	    child_capped = False
   164	    for v, subs in by_v.items():
   165	        Srep = subs[0]
   166	        A = int(Srep.A(j))
   167	        _ok, b10, b11 = Srep.cond1011(j)
   168	        for S in subs:
   169	            if int(S.A(j)) != A or S.cond1011(j)[1:] != (b10, b11):
   170	                # A_j and (10)/(11) depend only on V_j and above; mismatch is a bug
   171	                memo[key] = (set(), True, 0)
   172	                return memo[key]
   173	        if j == 2:
   174	            G = []
   175	            for S in subs:
   176	                g = S.V[2] * S.q()
   177	                if 0 < g <= Nhi:
   178	                    G.append(g)
   179	            G = list(set(G))
   180	        else:
   181	            Gset, cap_c, _ = reachable(subs, j - 1, Nhi, CAP, memo)
   182	            child_capped = child_capped or cap_c
   183	            G = [g for g in Gset if 0 < g <= Nhi]
   184	
   185	        if b10 and G:
   186	            w = A * v
   187	            vals = [A * g for g in G if A * g <= Nhi]
   188	            if 0 < w <= Q and vals:
   189	                nz_items.append((w, vals))
   190	        if b11 and G:
   191	            w = v
   192	            vals = [g for g in G if g <= Nhi]
   193	            if 0 < w <= Q and vals:
   194	                z_items.append((w, vals))
   195	
   196	    acc, capped, nstates = mix_dp(nz_items, z_items, Q, Nhi, CAP)
   197	    out = (acc, capped or child_capped, nstates)
   198	    memo[key] = out
   199	    return out
   200	
   201	
   202	def nested_values(skels, Nhi, CAP=CAP_DEFAULT):
   203	    """Reachable N from the unique D_{s-1}.  Includes 0."""
   204	    S0 = skels[0]
   205	    return reachable(skels, S0.s - 1, Nhi, CAP, {})
   206	
   207	
   208	def ints_in(values, Nlo, Nhi):
   209	    out = set()
   210	    for v in values:
   211	        if v.denominator == 1 and Nlo <= v <= Nhi:
   212	            out.add(int(v))
   213	    return out
   214	
   215	
   216	def describe_towers(skels):
   217	    rows = []
   218	    S0 = skels[0]
   219	    for S in skels:
   220	        bits = []
   220	        bits = []
   221	        for j in range(2, S.s):
   222	            _ok, b10, b11 = S.cond1011(j)
   223	            bits.append("j=%d A=%d V=%d Q=%d (10)=%s (11)=%s" %
   224	                        (j, S.A(j), S.V[j], Q_of(S, j), b10, b11))
   225	        rows.append("V=%s q=%s d1=%s |O|=%s %s" %
   226	                    (dict(S.V), S.q(), S.delta[1], sorted(orbit_sizes(S)),
   227	                     "; ".join(bits)))
   228	    return rows
   229	

   231	# ---------------------------------------------------------------------------
   232	# collect groups
   233	# ---------------------------------------------------------------------------
   234	def collect(n):
   235	    G = {}
   236	    for (m, Ms, V) in census(n, Kmin=16, full=True):
   237	        S = Skel(n, m, list(Ms), V)
   238	        key = (m, Ms, S.V[S.s])
   239	        G.setdefault(key, []).append(S)
   240	    return G

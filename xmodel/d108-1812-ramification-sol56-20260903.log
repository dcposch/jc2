   246	def control_moh_rows():
   247	    print("\n-- CONTROL M: Moh six rows, nested N in [6,16] --")
   248	    expect = [
   249	        ("(64,48)", {9}),
   250	        ("(84,56) M2=64,V2=2", set()),
   251	        ("(84,56) M2=72,V2=5", {10}),
   252	        ("(75,50) V2=3", {9}),
   253	        ("(75,50) V2=2", {8}),
   254	        ("(99,66)", {16}),
   255	    ]
   256	    print("   %-24s %3s %6s %s" % ("row", "s", "nested", "expect"))
   257	    for ((n, m, Ms, Vs, lab, _, _, _), exp) in zip(MOH_TABLE, [e[1] for e in expect]):
   258	        S = Skel(n, m, Ms, Vs)
   259	        check("windows+full %s" % lab, S.windows_ok() and S.full_ok())
   260	        Um = max(int(Umax([S])), 16)
   261	        vals, cap, _ = nested_values([S], Um)
   262	        Ns = ints_in(vals, 6, 16)
   263	        print("   %-24s %3d %6s %s%s" %
   264	              (lab, S.s, sorted(Ns), sorted(exp), " CAPPED" if cap else ""))
   265	        check("nested[6,16] %s" % lab, Ns == exp, "%s vs %s" % (sorted(Ns), sorted(exp)))
   266	        # s=3 => nested equals Z01 on the same window
   267	        h_z, c_z = knapsack_z01([S], 6, 16)
   268	        check("nested=Z01 hit %s" % lab, bool(Ns) == bool(h_z or c_z),
   269	              "nested %s z01 %s" % (bool(Ns), h_z or c_z))

     1	#!/usr/bin/env python3
     2	"""M2-DESCENT (3-control, corrected): Moh Appendix II pp.210-211, case
     3	n=15,m=10,M_2=11,V_2=3, Jacobian X^2 -- with the printed gamma audited."""
     4	import sympy as sp
     5	x, y = sp.symbols('x y')
     6	a1,a2,a3,a4,a5,a6,a7,a8,a9,a10,a11,a12 = A_ = sp.symbols('a1:13')
     7	
     8	B = (y**2 - x**2 + a1*y + a2*x + a3)*y + (a4*x + a5)
     9	A = sp.expand(B*y + (a6*x + a7))
    10	h = sp.expand(A*y + a8)
    11	beta = sp.expand(a9*A + a10*y + a11*x + a12)
    12	q, r = sp.div(sp.Poly(sp.expand(beta**2), y), sp.Poly(h, y), y)
    13	alpha, gamma = sp.expand(q.as_expr()), sp.expand(r.as_expr())
    14	
    15	bracket = (a9**2*a6 + 2*a9*a11)*x + (a9**2*a7 + 2*a9*a12)
    16	print("== AUDIT of the printed gamma (p.211) ==")
    17	for lab, cand in [("printed  (coefficient of B = -a9^2*a10)", -a9**2*a10),
    18	                  ("audited  (coefficient of B = -a9^2*a8 )", -a9**2*a8)]:
    19	    g_try = sp.expand(bracket*A + cand*B + (a10*y+a11*x+a12)**2 - 2*a8*a9*a10)
    20	    print("   %s : gamma reproduced = %s" % (lab, sp.expand(gamma - g_try) == 0))
    21	print("   printed alpha = a9^2 B + 2 a9 a10 reproduced :",
    22	      sp.expand(alpha - (a9**2*B + 2*a9*a10)) == 0)
    23	
    24	# ---- (7) deg_y gamma <= 2 : split the y^4,y^3 coefficients in x -----------
    25	Pg = sp.Poly(gamma, y)
    26	eqs = []
    27	for d in (4, 3):
    28	    c = sp.Poly(sp.expand(Pg.coeff_monomial(y**d)), x)
    29	    eqs += [sp.expand(t) for t in c.all_coeffs() if sp.expand(t) != 0]
    30	eqs = sorted(set([sp.factor(e) for e in eqs]), key=str)
    31	print("\n== (7) => the equations (each an identity in x) ==")
    32	for e in eqs: print("    ", e, "= 0")
    33	
    34	# ---- Case 1 : a9 = 0 ------------------------------------------------------
    35	print("\n== Case 1 : a9 = 0 ==")
    36	s = {a9: 0}
    37	be, ga = sp.expand(beta.subs(s)), sp.expand(gamma.subs(s))
    38	print("   alpha =", sp.expand(alpha.subs(s)), " ; beta =", be, " ; gamma - beta^2 =", sp.expand(ga-be**2))
    39	print("   deg_y beta^3 =", sp.degree(sp.Poly(sp.expand(be**3), y), y), " < 5 = deg_y h")
    40	print("   => in (3) beta^3 = (3gamma+a)h^2 + eps h + delta we must have 3gamma+a=0 and eps=0,")
    41	print("      so gamma is the constant -a/3, i.e. a10=a11=0;  but (4) needs (1/2)eps = b f^{2/5}+...")
    42	print("      with b != 0, i.e. deg_y eps = 4.   CONTRADICTION.        [Moh's Case 1, reproduced]")
    43	
    44	# ---- Case 2 : a9 != 0 -----------------------------------------------------
    45	print("\n== Case 2 : a9 != 0  =>  a8 = 0 , a6 = -2a11/a9 , a7 = -2a12/a9  (audited form) ==")
    46	s2 = {a8: 0, a6: -2*a11/a9, a7: -2*a12/a9}
    47	ga2 = sp.expand(sp.together(gamma.subs(s2)).simplify())
    48	be2 = sp.expand(beta.subs(s2)); h2 = sp.expand(h.subs(s2))
    49	print("   gamma =", sp.factor(ga2), "  deg_y gamma =", sp.degree(sp.Poly(ga2,y),y))
    50	print("   (Moh printed 'a10 = 0, gamma = (a11 x + a12)^2, deg_y gamma = 0' -> the audited")
    51	print("    equations give a8 = 0 instead of a10 = 0, and gamma = (a10 y + a11 x + a12)^2")
    52	print("    which HAS y-degree 2 when a10 != 0: Moh's stated contradiction does not close here.)")
    53	b3 = sp.expand(be2**3)
    54	q2, r2 = sp.div(sp.Poly(b3, y), sp.Poly(sp.expand(h2**2), y), y)
    55	c2 = sp.expand(q2.as_expr())
    56	print("\n   h^2-coefficient of beta^3 :  deg_y =", sp.degree(sp.Poly(c2,y),y),
    57	      ", deg_x =", sp.degree(sp.Poly(c2,x),x))
    58	res = sp.expand(c2 - 3*ga2)
    59	Pr = sp.Poly(res, x, y)
    60	print("   (3) requires  c2 - 3*gamma = a  in k  =>  every non-constant monomial vanishes.")
    61	mons = [(mo, sp.factor(co)) for mo, co in zip(Pr.monoms(), Pr.coeffs()) if mo != (0,0)]
    62	print("   number of resulting equations:", len(mons))
    63	for mo, co in mons[:14]:
    64	    print("      x^%d y^%d :  %s = 0" % (mo[0], mo[1], co))
    65	if len(mons) > 14: print("      ... (%d more)" % (len(mons)-14))
    66	sysm = [sp.expand(sp.numer(sp.together(co))) for _, co in mons]
    67	Gb = sp.groebner(sysm + [sp.Symbol('T')*a9 - 1], *(list(A_)+[sp.Symbol('T')]), order='lex')
    68	print("\n   saturated Groebner basis at a9 != 0 :", "EMPTY (1 in ideal)" if list(Gb) == [1] else "non-trivial")
    69	if list(Gb) != [1]:
    70	    print("   basis size", len(list(Gb)), " first elements:", [sp.factor(t) for t in list(Gb)[:6]])


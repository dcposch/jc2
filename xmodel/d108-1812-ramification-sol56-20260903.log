   296	def control_Aj_depends_on_upper():
   297	    """A_j and (10)/(11) at level j depend only on V_j and V_{j+1..s}."""
   298	    print("\n-- CONTROL A: A_j / (10)/(11) constant on (V_j, V_{j+1..s}) --")
   299	    bad = tot = 0
   300	    for n in range(48, 101):
   301	        G = collect(n)
   302	        for skels in G.values():
   303	            S0 = skels[0]
   304	            for j in range(2, S0.s):
   305	                bucket = {}
   306	                for S in skels:
   307	                    sig = tuple(S.V[i] for i in range(j, S.s + 1))
   308	                    rec = (int(S.A(j)), S.cond1011(j)[1:])
   309	                    if sig in bucket and bucket[sig] != rec:
   310	                        bad += 1
   311	                    bucket[sig] = rec
   312	                    tot += 1
   313	    check("A_j+(10)/(11) constant on (V_j..V_s) at D<=100", bad == 0,
   314	          "%d / %d" % (bad, tot))
   315	    print("   %d (group, level, type) rows, %d mismatches (want 0)" % (tot, bad))

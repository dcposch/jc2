   318	# ---------------------------------------------------------------------------
   319	# main census
   320	# ---------------------------------------------------------------------------
   321	def run_census(dlo=48, dhi=120):
   322	    print("\n== NESTED-PACK on (1)-(13), %d <= D <= %d ==" % (dlo, dhi))
   323	    print("   %5s %5s %5s %5s %7s %7s %7s %7s %7s %7s %7s %6s" %
   324	          ("D", "grp", "s3", "s>3", "unb>=6", "unb616", "nest>=6", "nest616",
   325	           "kill", "cap", "empty?", "wall"))
   326	    T = dict(g=0, s3=0, sgt=0, u1=0, u2=0, n1=0, n2=0, cap=0,
   327	             s3n1=0, s3n2=0, sgtn1=0, sgtn2=0, s3u1=0, s3u2=0)
   328	    empty6 = []; empty16 = []
   329	    delta_unb_alive_nested_dead16 = []
   330	    delta_unb_alive_nested_dead6 = []
   331	    s3_mismatch = []
   332	    surv = {n: [] for n in LISTING}
   333	    nset_special = {n: [] for n in COLLECT_NSETS}
   334	    t_all = time.time()
   335	    max_states = 0
   336	
   337	    for n in range(dlo, dhi + 1):
   338	        t0 = time.time()
   339	        G = collect(n)
   340	        if not G:
   341	            continue
   342	        a_u1 = a_u2 = a_n1 = a_n2 = cp = ns3 = nsgt = 0
   343	        s3_n1 = s3_n2 = sgt_n1 = sgt_n2 = s3_u1 = s3_u2 = 0
   344	        alive16 = []
   345	        for key, skels in G.items():
   346	            u = int(skels[0].u)
   347	            Um = Umax(skels)
   348	            Nhi6 = max(Um, F(6))
   349	            s = skels[0].s
   350	            # UNB (flat relaxation)
   351	            pk16 = []
   352	            pk6 = []
   353	            for S in skels:
   354	                pk16.extend(packets(S, 16))
   355	                pk6.extend(packets(S, Nhi6))
   356	            h_u2, c_u2, _ = knapsack(pk16, u, 6, 16)
   357	            h_u1, c_u1, _ = knapsack(pk6, u, 6, Nhi6)
   358	            unb16 = bool(h_u2 or c_u2)
   359	            unb6 = bool(h_u1 or c_u1)
   360	            # nested
   361	            vals, cap, nstates = nested_values(skels, Nhi6)
   362	            max_states = max(max_states, nstates)
   363	            Ns6 = ints_in(vals, 6, Nhi6)
   364	            Ns16 = {N for N in Ns6 if N <= 16}
   365	            nest6 = bool(Ns6) or cap
   366	            nest16 = bool(Ns16) or cap
   367	            # s=3 must equal Z01
   368	            if s == 3:
   369	                h_z16, c_z16 = knapsack_z01(skels, 6, 16)
   370	                h_z6, c_z6 = knapsack_z01(skels, 6, Nhi6)
   371	                z16 = bool(h_z16 or c_z16)
   372	                z6 = bool(h_z6 or c_z6)
   373	                if z16 != bool(Ns16) or z6 != bool(Ns6):
   374	                    s3_mismatch.append((n, key, z16, sorted(Ns16), z6, sorted(Ns6)))
   375	            # relaxation: nested => UNB
   376	            if nest16 and not unb16 and not cap:
   377	                delta_unb_alive_nested_dead16.append(("NESTED_NOT_IN_UNB", n, key))
   378	            if nest6 and not unb6 and not cap:
   379	                delta_unb_alive_nested_dead6.append(("NESTED_NOT_IN_UNB", n, key))
   380	            if unb16 and not nest16:
   381	                delta_unb_alive_nested_dead16.append((n, key, skels, sorted(Ns16)))
   382	            if unb6 and not nest6:
   383	                delta_unb_alive_nested_dead6.append((n, key, skels, sorted(Ns6)))
   384	
   385	            a_u1 += int(unb6); a_u2 += int(unb16)
   386	            a_n1 += int(nest6); a_n2 += int(nest16)
   387	            cp += int(cap)
   388	            if s == 3:
   389	                ns3 += 1
   390	                s3_n1 += int(nest6); s3_n2 += int(nest16)
   391	                s3_u1 += int(unb6); s3_u2 += int(unb16)
   392	            else:
   393	                nsgt += 1
   394	                sgt_n1 += int(nest6); sgt_n2 += int(nest16)
   395	
   396	            if n in COLLECT_NSETS:
   397	                nset_special[n].append((key, skels, sorted(Ns16), sorted(Ns6),
   398	                                        unb16, nest16, cap))
   399	            if n in LISTING and nest16:
   400	                alive16.append((key, skels, sorted(Ns16), cap))
   401	
   402	        T['g'] += len(G); T['s3'] += ns3; T['sgt'] += nsgt
   403	        T['u1'] += a_u1; T['u2'] += a_u2
   404	        T['n1'] += a_n1; T['n2'] += a_n2; T['cap'] += cp
   405	        T['s3n1'] += s3_n1; T['s3n2'] += s3_n2
   406	        T['sgtn1'] += sgt_n1; T['sgtn2'] += sgt_n2
   407	        T['s3u1'] += s3_u1; T['s3u2'] += s3_u2
   408	        if a_n1 == 0:
   409	            empty6.append(n)
   410	        if a_n2 == 0:
   411	            empty16.append(n)
   412	        if n in LISTING:
   413	            surv[n] = alive16
   414	        flag = ""
   415	        if a_n2 == 0:
   416	            flag = " EMPTY[6,16]"
   417	        print("   %5d %5d %5d %5d %7d %7d %7d %7d %7d %7d %7s %5.1fs%s"
   418	              % (n, len(G), ns3, nsgt, a_u1, a_u2, a_n1, a_n2,
   419	                 a_u2 - a_n2, cp, "Y" if a_n2 == 0 else "",
   420	                 time.time() - t0, flag))
   421	        sys.stdout.flush()
   422	
   423	    print("   ---- totals ----")
   424	    print("   groups %d  (s=3 %d, s>3 %d)" % (T['g'], T['s3'], T['sgt']))
   425	    print("   UNB    N>=6 %d   [6,16] %d" % (T['u1'], T['u2']))
   426	    print("   NESTED N>=6 %d   [6,16] %d   capped %d" % (T['n1'], T['n2'], T['cap']))
   427	    print("   s=3    NESTED N>=6 %d  [6,16] %d   UNB [6,16] %d"
   428	          % (T['s3n1'], T['s3n2'], T['s3u2']))
   429	    print("   s>3    NESTED N>=6 %d  [6,16] %d" % (T['sgtn1'], T['sgtn2']))
   430	    print("   empty nested N>=6    : %s" % (empty6 or "NONE"))
   431	    print("   empty nested [6,16]  : %s" % (empty16 or "NONE"))
   432	    n_kill16 = sum(1 for row in delta_unb_alive_nested_dead16
   433	                   if row[0] != "NESTED_NOT_IN_UNB")
   434	    n_bad16 = sum(1 for row in delta_unb_alive_nested_dead16
   435	                  if row[0] == "NESTED_NOT_IN_UNB")
   436	    print("   UNB-alive / NESTED-dead [6,16] : %d groups" % n_kill16)
   437	    print("   NESTED-alive / UNB-dead [6,16] : %d groups (want 0)" % n_bad16)
   438	    print("   max DP states in a parent: %d" % max_states)
   439	    print("   wall %.1fs" % (time.time() - t_all))
   440	    return (T, surv, nset_special, empty6, empty16,
   441	            delta_unb_alive_nested_dead16, s3_mismatch, max_states)
   442	

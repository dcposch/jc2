+Ex=x*diff(P^2,x)-3*P^2+G*P-RF;
+int bad=0; for(k=0;k<=2*N;k++){{if(xc(Ex,k)!=0){{bad++;}}}}
+print("CTRL_LOW_ROWS_BAD="+string(bad));
+ideal Icl;
+for(k=2*N+1;k<=4*N;k++){{Icl[k-2*N]=xc(Ex,k);}}
+ring S={args.prime},(u,B,w2,l(2..N)),{order};

+ for(e=1;e<=bound;e++){{nf=reduce(nf*f,gg);if(nf==0){{print("MIN_EXP "+nm+"="+string(e));return(e);}}}}
+ print("NO_POWER_UP_TO "+nm+"="+string(bound));return(0);}}
+int z1=mine(Gi,u,"u",{args.max_exponent});
+int z2=mine(Gi,l(2),"l2",{args.max_exponent});

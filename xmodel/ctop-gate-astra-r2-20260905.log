    n_ord = len(h_free) + len(bm) + 1
    A1, L1 = A_from_deltas({1: d1p, 2: d2p}, 2, 1)
    ok1213, b12, b13, ident, ns, ms = cond1213(n, m, d2, V2, A1)
    return dict(
        ok=True, reason="OK",
        n=n, m=m, M2=M2, V2=V2, k=k, d2=d2, u=u, v=v, K=K,
        dprime=dd, eprime=ee,

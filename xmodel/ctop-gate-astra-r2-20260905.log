    acc = Counter()
    ab = a + b
    for p in range(ab + 1):
        for q in range(b + 1):
            i = p + q
            j = (ab - p) + (b - q) + V2
            c = comb(ab, p) * ((-1) ** p) * comb(b, q)
            if c:
                acc[(i, j)] += c
    return {ij: c for ij, c in acc.items() if c}


def shape_bundle(n, m, M2, V2, k):
    """Forced monomials of h, beta for an s'=2 descended pair."""

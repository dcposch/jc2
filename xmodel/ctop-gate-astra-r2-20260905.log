    ns, ms = n // d2, m // d2
    b12 = (ns * V2 % A1 == 0) and ((ms * V2 - 1) % A1 == 0)
    b13 = (ms * V2 % A1 == 0) and ((ns * V2 - 1) % A1 == 0)
    ident = ((ns + ms) * V2 - 1) % A1 == 0  # p.188
    return (b12 or b13), b12, b13, ident, ns, ms


def cond1011(V_j, d_j, d_jp, V_jp, A_j):

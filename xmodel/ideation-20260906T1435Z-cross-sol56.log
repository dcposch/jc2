   258	def classify_layer(
   259	    layer: int,
   260	    p_bands: dict[int, Band],
   261	    q_bands: dict[int, Band],
   262	    digest: "hashlib._Hash",
   263	) -> dict[str, object]:
   264	    pair_rows: list[dict[str, object]] = []
   265	    equation_exponents: set[int] = set()
   266	    post_jet_exponents: set[int] = set()
   267	    character_term_counts = {str(character): 0 for character in range(5)}
   268	    raw_variable_pairs = 0
   269	    active_generators = 0
   270	    p_layer_min = max(min(p_bands), layer - max(q_bands))
   271	    p_layer_max = min(max(p_bands), layer - min(q_bands))
   272	    for p_layer in range(p_layer_min, p_layer_max + 1):
   273	        q_layer = layer - p_layer
   274	        p_band = p_bands[p_layer]
   275	        q_band = q_bands[q_layer]
   276	        for p_exponent in p_band.active_t_exponents:
   277	            for q_exponent in q_band.active_t_exponents:
   278	                if p_layer * q_exponent - q_layer * p_exponent:
   279	                    post_jet_exponents.add(p_exponent + q_exponent - 1)
   280	        pair_raw = p_band.source_count * q_band.source_count
   281	        pair_active = 0
   282	        pair_degree_min: int | None = None
   283	        pair_degree_max: int | None = None
   284	        raw_variable_pairs += pair_raw
   285	        for p_i, p_power in zip(
   286	            range(p_band.source_i_min, p_band.source_i_max + 1),
   287	            p_band.source_j,
   288	        ):
   289	            for q_i, q_power in zip(
   290	                range(q_band.source_i_min, q_band.source_i_max + 1),
   291	                q_band.source_j,
   292	            ):
   293	                factor = p_layer * q_power - q_layer * p_power
   294	                if factor == 0:
   295	                    continue
   296	                generator_degree = p_power + q_power - 1
   297	                if generator_degree < 0:
   298	                    raise AssertionError("active generator acquired negative degree")
   299	                digest.update(
   300	                    (
   301	                        f"{layer}:{p_layer}:{q_layer}:{p_i}:{q_i}:"
   302	                        f"{factor}:{generator_degree}\n"
   303	                    ).encode()
   304	                )
   305	                pair_active += 1
   306	                active_generators += 1
   307	                pair_degree_min = (
   308	                    generator_degree
   309	                    if pair_degree_min is None
   310	                    else min(pair_degree_min, generator_degree)
   311	                )
   312	                pair_degree_max = (
   313	                    generator_degree
   314	                    if pair_degree_max is None
   315	                    else max(pair_degree_max, generator_degree)
   316	                )
   317	                equation_exponents.update(
   318	                    range(layer, layer + generator_degree + 1)
   319	                )
   320	                residue_counts = count_residue_terms(layer, generator_degree)
   321	                for character, count in residue_counts.items():
   322	                    character_term_counts[character] += count
   323	        pair_rows.append(
   324	            {
   325	                "P_layer": p_layer,
   326	                "Q_layer": q_layer,
   327	                "raw_source_variable_pairs": pair_raw,
   328	                "active_binomial_generators": pair_active,
   329	                "generator_degree_interval": (
   330	                    None
   331	                    if pair_degree_min is None
   332	                    else [pair_degree_min, pair_degree_max]
   333	                ),
   334	            }
   335	        )
   336	    equations_by_character = {
   337	        str(character): sum(
   338	            exponent % 5 == character
   339	            for exponent in equation_exponents
   340	        )
   341	        for character in range(5)
   342	    }
   343	    # Independent coefficient supports in the two jet-reduced bands give an
   344	    # inexpensive structural upper bound, not the exact support of the
   345	    # restricted bilinear map: common-power pairs can cancel identically.
   346	    # Intersecting with the exact pre-jet generator rows removes rows which
   347	    # are impossible even before restriction.
   348	    post_jet_exponents.intersection_update(equation_exponents)
   349	    post_jet_by_character = {
   350	        str(character): sum(
   351	            exponent % 5 == character
   352	            for exponent in post_jet_exponents
   353	        )
   354	        for character in range(5)
   355	    }
   356	    return {
   357	        "layer": layer,
   358	        "rhs": "t^4" if layer == 4 else "0",
   359	        "band_pair_count": len(pair_rows),
   360	        "band_pairs": pair_rows,
   361	        "raw_source_variable_pairs": raw_variable_pairs,
   362	        "active_binomial_generators": active_generators,
   363	        "raw_scalar_coefficient_row_count": len(equation_exponents),
   364	        "raw_scalar_t_exponent_interval": (
   365	            None
   366	            if not equation_exponents
   367	            else [min(equation_exponents), max(equation_exponents)]
   368	        ),
   369	        "raw_scalar_rows_by_kummer_character": equations_by_character,
   370	        "post_jet_support_row_upper_bound": len(post_jet_exponents),
   371	        "post_jet_t_exponent_interval": (
   372	            None
   373	            if not post_jet_exponents
   374	            else [min(post_jet_exponents), max(post_jet_exponents)]
   375	        ),
   376	        "post_jet_rows_by_kummer_character": post_jet_by_character,
   377	        "expanded_quadratic_terms_by_kummer_character": character_term_counts,
   378	    }

   202	
   203	def digest_linear_constraints(
   204	    bands: dict[int, Band],
   205	    normalizations: dict[tuple[str, int, int], str],
   206	) -> tuple[str, int, int]:
   207	    digest = hashlib.sha256()
   208	    jet_equation_count = 0
   209	    linear_term_count = 0
   210	    for layer, band in sorted(bands.items()):
   211	        for order in range(band.jet_vanishing_order):
   212	            terms = []
   213	            for source_i, source_j in zip(
   214	                range(band.source_i_min, band.source_i_max + 1),
   215	                band.source_j,
   216	            ):
   217	                coefficient = comb(source_j, order)
   218	                if coefficient:
   219	                    terms.append((band.variable(source_i), coefficient))
   220	            digest.update(
   221	                (
   222	                    f"jet:{band.side}:{layer}:{order}:"
   223	                    + ",".join(f"{variable}:{coefficient}" for variable, coefficient in terms)
   224	                    + "=0\n"
   225	                ).encode()
   226	            )
   227	            jet_equation_count += 1
   228	            linear_term_count += len(terms)
   229	    for (side, layer, exponent), value in sorted(normalizations.items()):
   230	        band = bands[layer]
   231	        order = exponent - layer
   232	        terms = []
   233	        for source_i, source_j in zip(
   234	            range(band.source_i_min, band.source_i_max + 1),
   235	            band.source_j,
   236	        ):
   237	            coefficient = comb(source_j, order)
   238	            if coefficient:
   239	                terms.append((band.variable(source_i), coefficient))
   240	        digest.update(
   241	            (
   242	                f"normalization:{side}:{layer}:{exponent}:"
   243	                + ",".join(f"{variable}:{coefficient}" for variable, coefficient in terms)
   244	                + f"={value}\n"
   245	            ).encode()
   246	        )
   247	        linear_term_count += len(terms)
   248	    return digest.hexdigest(), jet_equation_count, linear_term_count

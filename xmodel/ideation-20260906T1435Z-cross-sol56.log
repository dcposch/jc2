   251	def count_residue_terms(base: int, degree: int) -> dict[str, int]:
   252	    result = {str(character): 0 for character in range(5)}
   253	    for offset in range(degree + 1):
   254	        result[str((base + offset) % 5)] += 1
   255	    return result

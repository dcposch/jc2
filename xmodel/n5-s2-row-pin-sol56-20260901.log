   308	 \rho(\gamma_\infty)\sim \tau_1\cdots\tau_d=:\Pi,
   309	 \qquad \operatorname{sgn}\rho(\gamma_\infty)=(-1)^d.             \tag{4.2}
   310	\]
   311	

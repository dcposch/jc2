def jet_side(orbnames, tag):
    jp = None
    for i, on in enumerate(orbnames):
        ck = os.path.join(CK, "jet_%s_%02d_%s.pkl" % (tag, i, on))
        if os.path.exists(ck):
            with open(ck, "rb") as fh:

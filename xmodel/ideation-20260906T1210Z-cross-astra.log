def ends(poly,n):
    m=max(sum(a*b for a,b in zip(p,n)) for p in poly)
    face=[p for p in poly if sum(a*b for a,b in zip(p,n))==m]
    tangent=(-n[1],n[0])
    face.sort(key=lambda p:sum(a*b for a,b in zip(p,tangent)))
    return face[0],face[-1]
for case,left in enumerate((12,6,None),1):
    for name,s,low in ((\"P\",2,(1,1)),(\"Q\",3,(1,0))):
        poly=[(0,0),low,(3*s,8*s),(3*s,9*s)]
        if left is not None: poly.append((0,left*s//2))
        assert ends(poly,(3,-1))[1]==(3*s,8*s)
        assert ends(poly,(1,0))==((3*s,8*s),(3*s,9*s))
        assert ends(poly,(-1,1))[0]==(3*s,9*s)
        print(case,name,\"st/en(-1,1)\",ends(poly,(-1,1)))
print(\"18 endpoint assertions PASS; orientation from GGV Notation 1.6, not lexicographic order\")

   195	def run_filter(nmax, nmin=48, Nlo_H2=4, Nhi_H2=16):
   196	    print("\n== TWO-SIDED FILTER:  L(skeleton) <= N <= U(skeleton),  N integral ==")
   197	    print("   %5s %9s %9s %9s %9s %9s %9s %9s" %
   198	          ("D","groups","minL","maxL","medL","kill L>16","kill U<4","kill window"))
   199	    tot = dict(g=0, kl=0, ku=0, kw=0, ku2=0, kl2=0)
   200	    percD = {}
   201	    for n in range(nmin, nmax+1):
   202	        groups = set()
   203	        for (m, Ms, V) in census(n):
   204	            S = Skel(n, m, list(Ms), V)
   205	            if S.windows_ok(): groups.add((m, Ms, S.V[S.s]))
   206	        Ls = []; kl=ku=kw=0; kl2=ku2=0; ng=0
   207	        for (m, Ms, Vs_top) in groups:
   208	            Vlo, Vhi = lower_V_extremes(n, m, list(Ms), Vs_top)
   209	            if Vlo is None: continue
   210	            Slo = Skel(n, m, list(Ms), Vlo); Shi = Skel(n, m, list(Ms), Vhi)
   211	            if not (Slo.windows_ok() and Shi.windows_ok()): continue
   212	            ng += 1
   213	            L = Slo.V[2]*qval(Slo)                       # FLOOR   N >= L
   214	            U = Shi.u*qval(Shi)                          # CEILING N <= U  (= U_rob)
   215	            Ls.append(L)
   216	            if L > Nhi_H2: kl += 1
   217	            if U < Nlo_H2: ku += 1
   218	            if L > 2:      kl2 += 1                      # unconditional floor beats N>=2
   219	            if U < 2:      ku2 += 1
   220	            lo_i = -(-L.numerator//L.denominator)        # ceil(L)
   221	            hi_i = U.numerator//U.denominator            # floor(U)
   222	            if lo_i > hi_i or hi_i < Nlo_H2 or lo_i > Nhi_H2: kw += 1
   223	        Ls.sort()
   224	        if ng:
   225	            med = Ls[len(Ls)//2]
   226	            percD[n] = (ng, Ls[0], Ls[-1], med, kl, ku, kw, kl2, ku2)
   227	            tot['g']+=ng; tot['kl']+=kl; tot['ku']+=ku; tot['kw']+=kw
   228	            tot['kl2']+=kl2; tot['ku2']+=ku2
   229	    for n in sorted(percD):
   230	        ng, lo, hi, med, kl, ku, kw, kl2, ku2 = percD[n]
   231	        if n in (105,108,112,117,120) or n % 25 == 0 or n == nmax:
   232	            print("   %5d %9d %9.3f %9.3f %9.3f %9d %9d %9d" %
   233	                  (n, ng, float(lo), float(hi), float(med), kl, ku, kw))
   234	    print("   ---- totals over D in [%d,%d] ----" % (nmin, nmax))
   235	    print("   groups %d ; kill by L>16 (H2): %d ; kill by U<4 (H2): %d ; kill by empty window: %d"
   236	          % (tot['g'], tot['kl'], tot['ku'], tot['kw']))
   237	    print("   unconditional: floor L > 2 on %d groups (N>=2 is then not binding); U<2 on %d"
   238	          % (tot['kl2'], tot['ku2']))
   239	    allL = []
   240	    for n in percD: allL += [percD[n][1]]
   241	    if allL:
   242	        print("   global min of the per-degree minimal floors: %s = %.4f" % (min(allL), float(min(allL))))
   243	    empty = [n for n in percD if percD[n][6] == percD[n][0]]
   244	    print("   degrees D with EVERY group killed by the two-sided window: %s" % (empty if empty else "NONE"))
   245	    return percD

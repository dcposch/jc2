    43	def qprod(S):
    44	    """closed product form  q = d e K prod_{j=2}^{s} [V_j(n-M_j)-d_j]/[V_j(n-M_{j-1})-d_j]."""
    45	    n, M, d, V, s = S.n, S.M, S.d, S.V, S.s
    46	    out = F(S.dd*S.e*S.K, 1)
    47	    for j in range(2, s+1):
    48	        out *= F(V[j]*(n-M[j]) - d[j], V[j]*(n-M[j-1]) - d[j])
    49	    return out

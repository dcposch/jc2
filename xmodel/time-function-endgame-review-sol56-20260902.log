    57	    sqfC = sp.degree(sp.gcd(C, sp.diff(C, pi_)), pi_) == 0 if C != 0 else False
    58	    return ok_const, kap, degC, V*(d*e-d-e)+1, sqfP, sqfQ, sqfC

    60	def symmetry_order(Pol):
    61	    """largest A with Pol = pi^{j0} * (polynomial in pi^A)."""
    62	    P = sp.Poly(sp.expand(Pol), pi_)
    63	    ex = [j for j in range(P.degree()+1) if sp.expand(P.nth(j)) != 0]

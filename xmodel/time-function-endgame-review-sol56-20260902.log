+| 1 | `-1/2` | `-2` | `-3` | `-5` | `-3/2` | 3 |
+| 2 | `-2/3` | `-10/3` | `-3` | `-19/3` | `-5/3` | 4 |
+| 3 | `-1/2` | `-5/2` | `-3` | `-11/2` | `-3/2` | 2 |
+| 4 | `-1/3` | `-3` | `-2` | `-5` | `-4/3` | 2 |
+| 5 | `-1/2` | `-3` | `-4` | `-7` | `-3/2` | 5 |
+| 6 | `-1/3` | `-3` | `-4` | `-7` | `-4/3` | 2 |

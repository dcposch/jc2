    65	    from math import gcd
    66	    g = 0
    67	    for j in ex[1:]: g = gcd(g, j-ex[0])
    68	    return g
    70	    """the conjugate branch z -> zeta*z."""
    71	    return sp.expand(ser.subs(z, zeta*z))


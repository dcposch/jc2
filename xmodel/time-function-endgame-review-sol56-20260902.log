     1	#!/usr/bin/env python3
     2	"""TIME-FUNCTION ENDGAME -- CONTROL 4 (NEGATIVE): a non-Keller two-tower row must FAIL.
     3	
     4	The rows are NOTT's explicit two-tower pairs: f, g are products of factors
     5	(y - a x)^p - b x^q, so every root is explicit and the whole tree is exact.
     6	For each row we compute, at the DEEPEST disc D_1 of the g-tree:
     7	   delta_1, lam_g(delta_1), lam_f(delta_1),  p_g(pi), p_f(pi)
     8	and test the two things LOCAL-KELLER forces on a Keller pair:
     9	   (ORD)  lam_f(delta_1) + lam_g(delta_1) = delta_1 - 1
    10	   (ODE)  lam_f p_f p_g' - lam_g p_g p_f'  is a NONZERO CONSTANT in pi.
    11	Both must fail off the Keller locus.
    12	"""
    13	import sys, itertools
    14	from fractions import Fraction as F
    15	import sympy as sp
    16	sys.path.insert(0,'/Users/dc/code/math/jc2/box')
    17	
    18	x, y = sp.symbols('x y')
    19	pi_ = sp.Symbol('pi')
    20	INF = F(10**9)
    21	
    22	def factor_poly(a,p,b,q): return sp.expand((y-a*x)**p - b*x**q)
    23	def factor_roots(a,p,b,q):
    24	    return [{F(1,1): sp.Integer(a),
    25	             F(q,p): sp.root(sp.Integer(b), p)*sp.exp(2*sp.pi*sp.I*sp.Rational(k,p))}
    26	            for k in range(p)]
    27	def build(spec):
    28	    poly = sp.Integer(1); rts=[]
    29	    for tpl in spec:
    30	        poly = sp.expand(poly*factor_poly(*tpl)); rts += factor_roots(*tpl)
    31	    return poly, rts
    32	def ord_diff(r1, r2):
    33	    for e_ in sorted(set(r1)|set(r2), reverse=True):
    34	        if sp.simplify(r1.get(e_,0)-r2.get(e_,0)) != 0: return -e_
    35	    return INF
    36	def lam(delta, ords): return sum(min(delta,o) for o in ords)
    37	
    38	TWO_TOWER = [
    39	    ([(1,1,3,0),(2,1,5,0)],  [(1,2,7,1),(2,1,11,0)]),
    40	    ([(1,2,3,1),(2,1,5,0)],  [(1,2,7,1),(2,2,11,1)]),
    41	    ([(1,2,3,1),(2,2,5,1)],  [(1,3,7,2),(2,1,11,0)]),
    42	    ([(1,1,3,0),(2,2,5,1)],  [(1,2,7,1),(2,2,11,1)]),
    43	    ([(1,3,3,2),(2,1,5,0)],  [(1,3,7,1),(2,1,11,0)]),
    44	    ([(1,2,3,1),(2,2,5,1)],  [(1,4,7,2),(2,2,11,1)]),
    45	    ([(1,2,3,1),(2,2,3,1)],  [(1,3,3,1),(2,3,3,1)]),
    46	]
    47	FAIL=[]; NCHK=[0]
    48	def check(name, cond, detail=""):
    49	    NCHK[0]+=1
    50	    if not cond: FAIL.append((name,detail)); print("  FAIL  %-56s %s"%(name,detail))
    51	    return cond
    52	
    53	def coeff_at(root, ex):
    54	    for e_, c in root.items():
    55	        if e_ == ex: return c
    56	    return sp.Integer(0)
    57	
    58	def analyse(fs, gs, label):
    59	    f, phis = build(fs); g, taus = build(gs)
    60	    m, n = len(phis), len(taus)
    61	    J = sp.expand(sp.diff(f,x)*sp.diff(g,y) - sp.diff(f,y)*sp.diff(g,x))
    62	    keller = (J.free_symbols == set())
    63	    # deepest disc of the g-tree: pick the root rho with the LARGEST pairwise contact
    64	    best = None
    65	    for i in range(n):
    66	        oth = [ord_diff(taus[i], taus[j]) for j in range(n) if j != i]
    67	        d1 = max(o for o in oth if o < INF)
    68	        if best is None or d1 > best[0]: best = (d1, i)
    69	    delta1, i0 = best
    70	    rho = taus[i0]
    71	    og = [ord_diff(rho, t) for t in taus if t is not rho]
    72	    of = [ord_diff(rho, p) for p in phis]
    73	    lg = lam(delta1, og); lf = lam(delta1, of)
    74	    inD = [t for t in taus if ord_diff(rho,t) >= delta1]
    75	    inF = [p for p in phis if ord_diff(rho,p) >= delta1]
    76	    a1, b1 = len(inD), len(inF)
    77	    Cg = sp.Integer(1)
    78	    for t in taus:
    79	        if t not in inD: Cg *= coeff_at(t, -ord_diff(rho,t))*(-1) if False else 1
    80	    # p_g(pi) = prod_{roots in D_1} (pi - c) up to a nonzero constant; p_f likewise
    81	    pg = sp.expand(sp.prod([pi_ - coeff_at(t, -delta1) for t in inD])) if a1 else sp.Integer(1)
    82	    pf = sp.expand(sp.prod([pi_ - coeff_at(p, -delta1) for p in inF])) if b1 else sp.Integer(1)
    83	    W  = sp.expand(sp.simplify(lf*pf*sp.diff(pg,pi_) - lg*pg*sp.diff(pf,pi_)))
    84	    degW = sp.degree(sp.Poly(W, pi_), pi_) if W != 0 else -1
    85	    ordok = (lf + lg == F(delta1) - 1)
    86	    print("   %-26s m=%-2d n=%-2d J const=%-5s delta_1=%-7s lam_f+lam_g=%-8s delta_1-1=%-8s (ORD) %-5s a_1=%d b_1=%d deg W=%s"
    87	          % (label, m, n, keller, delta1, lf+lg, F(delta1)-1, ordok, a1, b1, degW))
    88	    check("%s is non-Keller"%label, not keller, str(J)[:40])
    89	    check("%s (ORD) lam_f+lam_g = delta_1-1 FAILS"%label, not ordok, "%s vs %s"%(lf+lg, F(delta1)-1))
    90	    check("%s (ODE) bracket is NOT a nonzero constant"%label, degW != 0, "deg W = %s"%degW)
    91	    return ordok, degW
    92	
    93	if __name__ == "__main__":
    94	    print("== CONTROL 4 (NEGATIVE): NOTT's seven two-tower rows, all non-Keller ==")
    95	    print("   A Keller pair must satisfy (ORD) lam_f+lam_g = delta_1 - 1 [D1-PIN] and (ODE)")
    96	    print("   the bottom bracket must be a nonzero CONSTANT.  Both must fail here.")
    97	    for k,(fs,gs) in enumerate(TWO_TOWER):
    98	        analyse(fs, gs, "row %d"%k)
    99	    print("\n%d checks, %d failures"%(NCHK[0], len(FAIL)))
   100	    for nm,dt in FAIL: print("   FAILED:", nm, dt)


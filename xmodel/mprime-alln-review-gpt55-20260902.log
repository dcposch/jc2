from math import floor

def divisors_ge2(n):
    return [d for d in range(2,n+1) if n%d==0]

def rmax_exact(W, allow_mu1=False):
    # maximize sum(s_i-1) over finite lists (s_i,mu_i), s_i>=1, mu_i>=2 unless allow_mu1, sum s_i*mu_i = W.
    min_mu = 1 if allow_mu1 else 2
    dp=[-10**9]*(W+1)
    dp[0]=0
    prof=[None]*(W+1)
    for weight in range(1,W+1):
        best=-10**9; bestpair=None
        for mu in range(min_mu, weight+1):
            for s in range(1, weight//mu+1):
                val=dp[weight-s*mu]+(s-1)
                if val>best:
                    best=val; bestpair=(weight-s*mu,s,mu)
        dp[weight]=best
        prof[weight]=bestpair
    def unpack(weight):
        out=[]
        while weight>0:
            prev,s,mu=prof[weight]
            out.append((s,mu))
            weight=prev
        return out
    return dp[W], unpack(W)

def p_min_odd(W):
    for p in range(3,W+1,2):
        if W%p==0:
            return p
    return W

def rmax_formula(W):
    if W%2==0:
        return W//2-1
    p=p_min_odd(W)
    return max(W//p-1 if W%p==0 else float('-inf'), (W-5)//2)

print('R_max spot checks')
for W in [3,5,6,9,15,21]:
    ex, prof = rmax_exact(W, False)
    print(W, ex, prof, 'formula', rmax_formula(W), 'pmin', (p_min_odd(W) if W%2 else None))

print('\\n(5.4) tuples through N=23')
for N in range(3,24):
    rows=[]
    for a in range(1,N-1):
        W=N-a
        D=2*a-N
        if D>0 and a<=N-2 and W>=2:
            R,_=rmax_exact(W, False)
            if a-1 <= D*R:
                rows.append((a,W,D,R))
    if rows:
        print(N, rows)

print('\\n7.B withdrawn variant first survivors')
for N in range(3,18):
    rows=[]
    for a in range(1,N-1):
        W=N-a; D=2*a-N
        if D>0 and a<=N-2 and W>=1:
            R,_=rmax_exact(W, True)
            if a-1 <= D*R:
                rows.append((a,W,D,R))
    if rows:
        print(N, rows)
        break

print('\\nB2 beta minima N<=18')
for N in range(3,19):
    minbeta=None
    witnesses=[]
    for beta in range(0,10):
        ok=False
        for a in range(1,N-1):
            W=N-a; D=2*a-N
            if D>0 and a<=N-2 and W>=2:
                R,_=rmax_exact(W, False)
                if a-1 <= (R+beta)*D:
                    ok=True
                    witnesses.append((beta,a,W,D,R))
                    break
        if ok:
            minbeta=beta; break
    print(N, minbeta, witnesses[:1])

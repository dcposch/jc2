+    {
+      "partition": [3, 2, 1],
+      "system": "systems/192_128_part_3_2_1_mod_32003.sing",
+      "equations": 162,
+      "unknowns_excluding_T": 37,
+      "build_elapsed_seconds_inferred": 247,
+      "char": 32003,
+      "timeout_seconds": 600,
+      "verdict": "COUNTING-BOUND",
+      "controls": "UNRECORDED"
+    },
+    {
+      "partition": [2, 2, 1, 1],
+      "system": "systems/192_128_part_2_2_1_1_mod_32003.sing",
+      "equations": 162,
+      "unknowns_excluding_T": 38,
+      "build_elapsed_seconds_inferred": 547,
+      "char": 32003,
+      "timeout_seconds": 600,
+      "verdict": "COUNTING-BOUND",
+      "controls": "UNRECORDED"
+    }
+  ],
+  "not_launched": [
+    [3, 1, 1, 1],
+    [2, 2, 2],

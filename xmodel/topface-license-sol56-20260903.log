+| (180,120) | `[-120,168,176,178]` | `{V2=11,V3=9,V4=3}` | `(4,3,1)` | `(45,30;42;11;k=1)` | 4 |
+| (192,128) | `[-128,136,190]` | `{V2=2,V3=7}` | `(8,7,1)` | `(24,16;17;2;k=5)` | 6 |

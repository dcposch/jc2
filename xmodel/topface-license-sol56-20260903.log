+    },
+    {
+      "partition": [2, 2, 1, 1],
+      "system": "systems/192_128_part_2_2_1_1_mod_32003.sing",
+      "equations": 162,
+      "unknowns_excluding_T": 38,
+      "build_elapsed_seconds_inferred": 547,

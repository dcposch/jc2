   307	| `(24,16;17;2;k=5)` | `H_2[6] ->35`; `H_2[5,1] ->36*`; `H_2[4,2] ->36`; `H_2[4,1,1] ->37*`; `H_2[3,3] ->36`; `H_2[3,2,1] ->37*`; `H_2[3,1,1,1] ->38*`; `H_2[2,2,2] ->37`; `H_2[2,2,1,1] ->38*`; `H_2[2,1,1,1,1] ->39*`; `H_2[1,1,1,1,1,1] ->40*` | 41 |

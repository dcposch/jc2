        b2=sum(B.get(i,0)*B.get(n-i,0) for i in range(n+1))
        prev=sum(A[i]*A[j]*A[k] for i in range(n) for j in range(n) for k in range(n) if i+j+k==n)
        num=sp.expand(b2-prev)
        quo,rem=sp.div(sp.Poly(num,pi), sp.Poly(3*A[0]**2,pi))
        if rem.as_expr()"'!=0:
            rows=poly_rows(rem.as_expr()); equations+=rows; eq_by[(n,'"'appdiv')]+=len(rows)
        A[n]=sp.expand(quo.as_expr())
    for n in range(1,K+1):
        D=sum((i-6)*A.get(i,0)*sp.diff(B.get(n-i,0),pi) - (n-i-9)*sp.diff(A.get(i,0),pi)*B.get(n-i,0)
              for i in range(n+1))
        rows=poly_rows(D); equations+=rows; eq_by[(n,'jac')]+=len(rows)
    print(' vars',len(vars),'eqs',len(equations),'by',dict(eq_by))
    linres, free, piv=qstar_reduce(equations, vars)
    print(' piv',len(piv),'free',len(free),'residual',len(linres),'res_symbols',len(set().union(*(r.free_symbols for r in linres)) if linres else set()))
    print(' free names',[str(v) for v in free[:20]])
    if linres:
      print(' first residual',sp.factor(linres[0]))
for K in range(1,7): build(K)

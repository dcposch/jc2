import sympy as sp
from collections import defaultdict
Y,Z=sp.symbols('Y Z')

def q_order(i,j,isG=True):
    # local s exponent shift from leading: G leading -9, F leading -6
    return (-2*i+5*j+(9 if isG else 6))

def coeff_p9(j):
    # p"'^9 = pi''^9(pi''^2-1)''^9 = sum_{k=0}''^9 binom(9,k)(-1)''^(9-k) pi''^(9+2k)
    if j<9 or j>27 or (j-9)%2: return 0
    k=(j-9)//2
    return sp.binomial(9,k)*((-1)**(9-k))

def build(depth, qcap):
    vars=[]; Gbands={}
    for r in range(depth):
        j=27-r
        poly=0
        for i in range(73):
            if i+j>99: continue
            q=q_order(i,j,True)
            if 0<=q<=qcap:
                c=coeff_p9(j) if q==0 else None
                if c is not None and c!=0:
                    poly += c*Y**i
                elif c is not None and c==0:
                    # force zero for q=0 terms not in p9
                    pass
                else:
                    v=sp.symbols(f'"'g_{j}_{i}')
                    vars.append(v); poly+=v*Y**i
        Gbands[j]=sp.expand(poly)
    # ensure top G27 has y72
    Fbands={18:Y**48}
    app_eqs=[]
    for r in range(1,depth):
        # z degree 54-r in G"'^2 equals F''^3
        coeffG=0
        for a,Ga in Gbands.items():
            b=54-r-a
            if b in Gbands: coeffG += Ga*Gbands[b]
        coeffFprev=0
        target_band=18-r
        for a,Fa in Fbands.items():
            for b,Fb in Fbands.items():
                c=54-r-a-b
                if c in Fbands:
                    coeffFprev += Fa*Fb*Fbands[c]
        # coeffFprev does not include unknown F_target because not in Fbands; coefficient for Ftarget = 3*Y''^96
        num=sp.expand(coeffG-coeffFprev)
        quo, rem = sp.div(sp.Poly(num,Y), sp.Poly(3*Y**96,Y))
        if rem.as_expr()!=0:
            for (deg,),coef in sp.Poly(rem.as_expr(),Y).terms():
                if coef!=0: app_eqs.append(coef)
        Fbands[target_band]=sp.expand(quo.as_expr())
    # build J bands down to 44-(depth-1)
    jac_eqs=[]
    for r in range(depth):
        zdeg=44-r
        coeff=0
        for jf,Fj in Fbands.items():
            jg=zdeg+1-jf
            if jg in Gbands:
                coeff += sp.diff(Fj,Y)*jg*Gbands[jg] - jf*Fj*sp.diff(Gbands[jg],Y)
        # collect only high local q? A J monomial Y''^i Z''^zdeg has s exponent -2i+5zdeg; J constant after coordinate? Top high should vanish all high terms. Include qJ relative? leading J high? just all coeffs in available poly.
        if coeff!=0:
            for (deg,),coef in sp.Poly(sp.expand(coeff),Y).terms():
                # high terms only maybe q<=qcap? For J leading shift? max y deg around119.
                # include all coefficients present
                if coef!=0: jac_eqs.append(sp.expand(coef))
    print('"'depth',depth,'qcap',qcap,'vars',len(vars),'app_eqs',len(app_eqs),'jac_eqs',len(jac_eqs))
    print('vars', [str(v) for v in vars])
    print('sample eqs', [sp.factor(e) for e in (app_eqs+jac_eqs)[:10]])
for depth in [4,5,6]:
  build(depth, depth)

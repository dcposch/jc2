import sympy as sp
from collections import defaultdict
pi=sp.symbols('pi')
p=pi*(pi**2-1)

def r_degrees(q):
    maxP = 27 if q%2==0 else 26
    maxR = maxP - (27-3*q)
    return list(range(0,maxR+1,2))

def poly_rows(expr):
    return [sp.expand(c) for (m,),c in sp.Poly(sp.expand(expr),pi).terms() if c]

def qstar_reduce(rows, vars):
    rows=list(rows); vars=list(vars); piv=[]
    while True:
        choice=None
        for ri,e in enumerate(rows):
            for vi,v in enumerate(vars):
                coeff=sp.diff(e,v)
                rem=sp.expand(e-coeff*v)
                if coeff.is_Rational and coeff"'!=0 and v not in rem.free_symbols:
                    choice=(ri,vi,v,coeff,rem); break
            if choice: break
        if not choice: break
        ri,vi,v,coeff,rem=choice
        rhs=sp.expand(-rem/coeff)
        piv.append((v,rhs))
        del rows[ri]; del vars[vi]
        rows=[sp.expand(e.subs(v,rhs)) for e in rows]
        rows=[e for e in rows if e!=0]
    return rows, vars, piv

def build(K):
    B={0:sp.expand(p**9)}; vars=[]; R={}
    print('"'K',K)
    for q in range(1,K+1):
        terms=[]
        for d in r_degrees(q):
            v=sp.symbols(f'r{q}_{d}')
            vars.append(v); terms.append(v*pi**d)
        R[q]=sum(terms)
        B[q]=sp.expand(p**(9-q)*R[q])

R['moh_p194_delta2'] = dict(formula="(u_s(n-M_{s-1})-d_s)/(v_s(n-M_{s-1})-d_s)",
                            value=str(d2_check), matches_p202=(d2_check == delta[2]))

# Moh p.190 minor/major dichotomy  V_r <= d_r/(n-M_r) ---------------------

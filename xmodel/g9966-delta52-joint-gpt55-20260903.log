import sympy as sp
from collections import defaultdict
pi=sp.symbols('pi')
p=pi*(pi**2-1)

def support(q):
    ans=[]
    for j in range(28):
        num=5*j+9-q
        if num%2: continue
        i=num//2
        if 0<=i<=72 and i+j<=99:
            ans.append((j,i))
    return ans

def poly_rows(expr):
    P=sp.Poly(sp.expand(expr),pi)
    return [sp.expand(c) for (m,),c in P.terms() if c]

def qstar_reduce(rows, vars):
    rows=list(rows); vars=list(vars); piv=[]
    while True:
        choice=None
        for ri,e in enumerate(rows):
            for vi,v in enumerate(vars):
                coeff=sp.diff(e,v)
                rem=sp.expand(e-coeff*v)
                if coeff.is_Rational and coeff"'!=0 and v not in rem.free_symbols:
                    choice=(ri,vi,v,coeff,rem); break
            if choice: break
        if not choice: break
        ri,vi,v,coeff,rem=choice
        rhs=sp.expand(-rem/coeff)
        piv.append((v,rhs))
        del rows[ri]; del vars[vi]
        rows=[sp.expand(e.subs(v,rhs)) for e in rows]
        rows=[e for e in rows if e!=0]
    return rows, vars, piv

def build(K):
    B={0:sp.expand(p**9)}; vars=[]; equations=[]; eq_by=defaultdict(int)
    # q=0 fixed p''^9; omitted variables are zero coefficients on support
    for q in range(1,K+1):
        terms=[]
        for j,i in support(q):
            v=sp.symbols(f'"'g{q}_{j}')
            vars.append(v); terms.append(v*pi**j)
        B[q]=sum(terms)
        # final no-negative through root finals: divisibility by p"'^(9-q)
        rem=sp.rem(sp.Poly(B[q],pi), sp.Poly(p**(9-q),pi)).as_expr()
        rows=poly_rows(rem)
        equations+=rows; eq_by[(q,'"'div')]+=len(rows)
    A={0:sp.expand(p**6)}
    for n in range(1,K+1):
        b2=sum(B.get(i,0)*B.get(n-i,0) for i in range(n+1))
        prev=sum(A.get(i,0)*A.get(j,0)*A.get(n-i-j,0)
                 for i in range(n+1) for j in range(n+1)
                 if not (i==n or j==n or n-i-j==n) and 0<=n-i-j<=n)
        # Actually prev includes all triples no A_n because only one index n with others 0 are excluded by condition? Check.
        # Simpler: coeff A"'^3 = 3 A0''^2 An + terms all indices <n
        prev=sum(A[i]*A[j]*A[k] for i in range(n) for j in range(n) for k in range(n) if i+j+k==n)
        num=sp.expand(b2-prev)
        quo,rem=sp.div(sp.Poly(num,pi), sp.Poly(3*A[0]**2,pi))
        if rem.as_expr()!=0:
            rows=poly_rows(rem.as_expr())
            equations+=rows; eq_by[(n,'"'appdiv')]+=len(rows)
        A[n]=quo.as_expr()
    for n in range(1,K+1):
        D=sum((i-6)*A.get(i,0)*sp.diff(B.get(n-i,0),pi) - (n-i-9)*sp.diff(A.get(i,0),pi)*B.get(n-i,0)
              for i in range(n+1))
        rows=poly_rows(D)
        equations+=rows; eq_by[(n,'jac')]+=len(rows)
    print('K',K,'vars',len(vars),'eqs',len(equations),'by',dict(eq_by))
    linres, free, piv=qstar_reduce(equations, vars)
    print(' qstar piv',len(piv),'free',len(free),'residual',len(linres),'sample residual degrees',[sp.Poly(r,pi).total_degree() if r"'!=0 else 0 for r in linres[:5]])
    print('"' residual symbols',len(set().union(*(r.free_symbols for r in linres)) if linres else set()))
    # Try groebner maybe for K small
    return vars,equations,linres,free,piv
for K in [1,2,3,4,5,6]:
    build(K)

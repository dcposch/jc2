   244	# ---------------------------------------------------------------------------
   245	# Hurwitz action of B_9 on 9-tuples of transpositions.
   246	# ---------------------------------------------------------------------------
   247	
   248	def hurwitz_one_generator(
   249	    tuple_t: Sequence[frozenset],
   250	    tietze_letter: int,
   251	) -> Tuple[frozenset, ...]:
   252	    if tietze_letter == 0:
   253	        raise AssertionError("hurwitz_one_generator: Tietze letter 0")
   254	    gen_abs = abs(tietze_letter)
   255	    if gen_abs < 1 or gen_abs > N_ARTIN:
   256	        raise AssertionError(
   257	            "hurwitz_one_generator: |Tietze letter| = %d outside 1..8 for B_9"
   258	            % gen_abs
   259	        )
   260	    pos = gen_abs - 1
   261	    out = list(tuple_t)
   262	    left_entry = out[pos]
   263	    right_entry = out[pos + 1]
   264	    if tietze_letter > 0:
   265	        conjugated = apply_perm_to_transposition(
   266	            transposition_to_perm(left_entry), right_entry
   267	        )
   268	        out[pos] = conjugated
   269	        out[pos + 1] = left_entry
   270	    else:
   271	        conjugated = apply_perm_to_transposition(
   272	            transposition_to_perm(right_entry), left_entry
   273	        )
   274	        out[pos] = right_entry
   275	        out[pos + 1] = conjugated
   276	    return tuple(out)
   277	
   278	
   279	def hurwitz_tietze(
   280	    tuple_t: Sequence[frozenset],
   281	    tietze_word: Sequence[int],
   282	) -> Tuple[frozenset, ...]:
   283	    """Left action of a Sage Tietze word: apply RIGHTMOST letter first."""
   284	    current = tuple(tuple_t)
   285	    index = len(tietze_word) - 1
   286	    while index >= 0:
   287	        current = hurwitz_one_generator(current, tietze_word[index])
   288	        index -= 1
   289	    return current

   324	        out[pos + 1] = left_entry
   325	    else:
   326	        conjugated = apply_perm_to_transposition(
   327	            transposition_to_perm(right_entry), left_entry
   328	        )
   329	        out[pos] = right_entry
   330	        out[pos + 1] = conjugated
   331	    return tuple(out)

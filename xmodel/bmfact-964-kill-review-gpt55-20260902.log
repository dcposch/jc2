   607	def classify_factor(rec):
   608	    """Classify one geometric-basis braid against the (9,6,4) census.
   609	
   610	    tangency: exponent 1, permutation a single transposition, CPF one
   611	              piece whose alpha has exponent 1.
   612	    four_node_fibre: exponent 8, permutation the identity, CPF four pieces
   613	                each of exponent 2 (four commuting sigma_i^2). The unique
   614	                x=0 fibre.
   615	    one_node_fibre: exponent 2, permutation the identity, CPF one piece
   616	                of exponent 2. The two new-node fibres.
   617	    """
   618	    e_sum = rec["exponent_sum"]
   619	    ctype = rec["permutation_cycle_type"]
   620	    cpf_ok = rec["conjugate_positive_form_ok"]
   621	    pieces = rec["conjugate_positive_form"] or []
   622	    alpha_exps = [int(piece["alpha_exponent_sum"]) for piece in pieces] if cpf_ok else []
   623	
   624	    is_transposition_perm = sorted(ctype) == [1, 1, 1, 1, 1, 1, 1, 2]
   625	    is_identity_perm = (not ctype) or (max(ctype) == 1 and sum(ctype) == 9)
   626	
   627	    if e_sum == 1 and is_transposition_perm:
   628	        if cpf_ok and alpha_exps == [1]:
   629	            return "tangency"
   630	        if cpf_ok:
   631	            return "tangency_cpf_unexpected"
   632	        return "tangency_cpf_missing"
   633	    if e_sum == 8 and is_identity_perm:
   634	        if cpf_ok and sorted(alpha_exps) == [2, 2, 2, 2]:
   635	            return "four_node_fibre"
   636	        if cpf_ok and len(alpha_exps) == 1 and alpha_exps[0] == 8:
   637	            return "four_node_fibre_unsplit"
   638	        if cpf_ok:
   639	            return "four_node_fibre_cpf_unexpected"
   640	        return "four_node_fibre_cpf_missing"
   641	    if e_sum == 2 and is_identity_perm:
   642	        if cpf_ok and alpha_exps == [2]:
   643	            return "one_node_fibre"
   644	        if cpf_ok:
   645	            return "one_node_fibre_cpf_unexpected"
   646	        return "one_node_fibre_cpf_missing"
   647	    return "other"

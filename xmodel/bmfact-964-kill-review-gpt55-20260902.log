   201	def apply_artin_letter_to_word(word, tietze_letter, n_strands):
   202	    """Substitute one Artin generator into a free-group Tietze word.
   203	
   204	    sigma_k (tietze_letter = k > 0):
   205	        x_k     |-> x_k x_{k+1} x_k^{-1}
   206	        x_{k+1} |-> x_k
   207	    sigma_k^{-1} (tietze_letter = -k < 0):
   208	        x_k     |-> x_{k+1}
   209	        x_{k+1} |-> x_{k+1}^{-1} x_k x_{k+1}
   210	    """
   211	    if tietze_letter == 0:
   212	        fail("apply_artin_letter_to_word: Tietze letter 0")

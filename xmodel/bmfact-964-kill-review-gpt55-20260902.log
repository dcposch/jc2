   199	    def find(letter: int) -> int:
   200	        walk = letter
   201	        while parent[walk] != walk:
   202	            walk = parent[walk]
   203	        compress = letter
   204	        while parent[compress] != walk:
   205	            nxt = parent[compress]
   206	            parent[compress] = walk
   207	            compress = nxt
   208	        return walk

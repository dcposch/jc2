   214	    if gen_abs < 1 or gen_abs >= n_strands:
   215	        fail(
   216	            "apply_artin_letter_to_word: |letter|=%d outside 1..%d"
   217	            % (gen_abs, n_strands - 1)
   218	        )
   219	    out = []
   220	    positive = tietze_letter > 0
   221	    for signed in word:
   222	        letter_abs = abs(int(signed))
   223	        letter_sign = 1 if signed > 0 else -1
   224	        if positive:
   225	            if letter_abs == gen_abs:
   226	                if letter_sign > 0:
   227	                    out.extend([gen_abs, gen_abs + 1, -gen_abs])
   228	                else:
   229	                    out.extend([gen_abs, -(gen_abs + 1), -gen_abs])
   230	            elif letter_abs == gen_abs + 1:
   231	                out.append(letter_sign * gen_abs)
   232	            else:

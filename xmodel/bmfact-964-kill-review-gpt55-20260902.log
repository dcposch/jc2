   878	def hurwitz_one_int(tup: Sequence[int], tietze_letter: int) -> Tuple[int, ...]:
   879	    if tietze_letter == 0:
   880	        raise AssertionError("hurwitz_one_int: Tietze letter 0")
   881	    gen_abs = abs(tietze_letter)
   882	    if gen_abs < 1 or gen_abs > N_ARTIN:
   883	        raise AssertionError(
   884	            "hurwitz_one_int: |Tietze letter| = %d outside 1..8" % gen_abs
   885	        )
   886	    pos = gen_abs - 1
   887	    out = list(tup)
   888	    left_entry = out[pos]
   889	    right_entry = out[pos + 1]
   890	    if tietze_letter > 0:
   891	        out[pos] = CONJ_TABLE[left_entry][right_entry]
   892	        out[pos + 1] = left_entry
   893	    else:
   894	        out[pos] = right_entry
   895	        out[pos + 1] = CONJ_TABLE[right_entry][left_entry]
   896	    return tuple(out)

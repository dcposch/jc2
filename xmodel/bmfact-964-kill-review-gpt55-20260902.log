   334	def delta3_power(triple: Sequence[frozenset], power: int) -> Tuple[frozenset, ...]:
   335	    """delta_3 = sigma_1 sigma_2. Left action: apply sigma_2 first, then sigma_1."""
   336	    current = tuple(triple)
   337	    if power >= 0:
   338	        count = 0
   339	        while count < power:
   340	            current = hurwitz_sigma_on_triple(current, 1, False)
   341	            current = hurwitz_sigma_on_triple(current, 0, False)
   342	            count += 1
   343	        return current
   344	    count = 0
   345	    while count < -power:
   346	        current = hurwitz_sigma_on_triple(current, 0, True)
   347	        current = hurwitz_sigma_on_triple(current, 1, True)
   348	        count += 1
   349	    return current

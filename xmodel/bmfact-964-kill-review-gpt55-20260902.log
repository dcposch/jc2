   310	
   311	def hurwitz_sigma_on_triple(
   312	    triple: Sequence[frozenset],
   313	    pos: int,
   314	    inverse: bool,
   315	) -> Tuple[frozenset, ...]:
   316	    out = list(triple)
   317	    left_entry = out[pos]
   318	    right_entry = out[pos + 1]
   319	    if not inverse:
   320	        conjugated = apply_perm_to_transposition(
   321	            transposition_to_perm(left_entry), right_entry
   322	        )

   681	def brute_generating_product_fixed(kstar: int = KSTAR) -> Dict[str, object]:
   682	    """All 6^9 transposition 9-tuples, adjacent-block CABLE-3 product relation.
   683	
   684	    Lookup-table scan: 216^3. Used as an independent check that 72 is the
   685	    complete generating count, not only the class-list reconstruction.
   686	    """

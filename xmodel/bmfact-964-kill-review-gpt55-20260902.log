   571	def serialise_cpf(braid_elt):
   572	    """conjugate_positive_form -> JSON-able records.
   573	
   574	    Documented return: list of [alpha, [beta_j]] with
   575	    tau = (prod beta) * alpha * (prod beta)^{-1}, the tau pairwise
   576	    commuting, product equal to the input braid.
   577	    """
   578	    try:
   579	        cpf = conjugate_positive_form(braid_elt)
   580	    except Exception as cpf_err:
   581	        return {
   582	            "ok": False,
   583	            "error": "%s: %s" % (type(cpf_err).__name__, cpf_err),
   584	            "FLAG": (
   585	                "conjugate_positive_form raised. The conjugating words for this "
   586	                "factor are therefore not certified by this helper; the Tietze "
   587	                "word of the factor itself remains the SIROCCO output."
   588	            ),
   589	            "pieces": [],
   590	        }
   591	    pieces = []
   592	    for item in cpf:
   593	        alpha_elt = item[0]
   594	        conjugators = item[1]
   595	        pieces.append(
   596	            {
   597	                "alpha_tietze": tietze_as_ints(alpha_elt),
   598	                "alpha_string": str(alpha_elt),
   599	                "alpha_exponent_sum": int(alpha_elt.exponent_sum()),
   600	                "conjugator_tietzes": [tietze_as_ints(conj) for conj in conjugators],
   601	                "conjugator_strings": [str(conj) for conj in conjugators],
   602	            }
   603	        )
   604	    return {"ok": True, "error": None, "FLAG": None, "pieces": pieces}

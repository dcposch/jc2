   772	def node_fibre_leftover_strand(braids: Sequence[dict]) -> Optional[int]:
   773	    """1-based leftover strand of the unique node-fibre braid, if CPF splits it."""
   774	    node_recs = [b for b in braids if str(b.get("census_class", "")).startswith("node_fibre")]
   775	    if len(node_recs) != 1:
   776	        return None
   777	    rec = node_recs[0]
   778	    pieces = rec.get("conjugate_positive_form") or []
   779	    involved: Set[int] = set()
   780	    for piece in pieces:
   781	        alpha = piece.get("alpha_tietze") or []
   782	        for letter in alpha:
   783	            gen_abs = abs(int(letter))
   784	            involved.add(gen_abs)
   785	            involved.add(gen_abs + 1)
   786	        # conjugators move the band; the support of tau = g sigma_i^2 g^{-1}
   787	        # is the image of {i,i+1} under the conjugator's permutation. For the
   788	        # leftover-strand computation we use the permutation of the whole
   789	        # fibre braid: identity, so leftover is the unique unmoved strand
   790	        # of the four pairs after conjugating. FLAG if conjugators present.
   791	        conjugators = piece.get("conjugator_tietzes") or []
   792	        if conjugators:
   793	            # Apply conjugator permutation to {gen of alpha}.
   794	            # permutation of a Tietze word, 1-based.
   795	            images = list(range(1, N_STRANDS + 1))
   796	            # product of conjugators, rightmost first
   797	            flat: List[int] = []
   798	            for conj in conjugators:
   799	                flat.extend(conj)
   800	            idx = len(flat) - 1
   801	            while idx >= 0:
   802	                letter = flat[idx]
   803	                g = abs(int(letter))
   804	                tmp = images[g - 1]
   805	                images[g - 1] = images[g]
   806	                images[g] = tmp
   807	                idx -= 1
   808	            # alpha support {a, a+1} mapped
   809	            if alpha:
   810	                a0 = abs(int(alpha[0]))
   811	                involved.add(images[a0 - 1])
   812	                involved.add(images[a0])
   813	    leftover = [s for s in range(1, N_STRANDS + 1) if s not in involved]
   814	    if len(leftover) == 1:
   815	        return leftover[0]
   816	    return None

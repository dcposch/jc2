   470	def reconstruct_nine(
   471	    item: Dict[str, object],
   472	    kstar: int = KSTAR,
   473	) -> Tuple[frozenset, ...]:
   474	    """Fill T_2, T_3 from T_1 by iota = (delta_3^{k_*}, 1, 1).
   475	
   476	    From CABLE-3 (REP-96 §3), with iota_1 = delta_3^{k_*}, iota_2 = iota_3 = 1:
   477	      T_3 = iota_1 . T_1 = delta_3^{k_*} . T_1
   478	      T_2 = (iota_3 iota_1) . c_{XY}(T_1) = delta_3^{k_*} . c_{XY}(T_1)
   479	    OPEN[BMFACT-IOTA-SPLIT]: other splits of iota with the same ordered
   480	    product are a variant; this split is the one declared here.
   481	    Adjacent-block identification: strands 1..3 = T_1, 4..6 = T_2, 7..9 = T_3.
   482	    OPEN[BMFACT-TUBE-EMBEDDING]: residue-mod-3 tubes are a second reading.
   483	    """

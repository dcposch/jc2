+def pivotCell : PivotCoordinate → RowCell
+  | .tf1_44 => ⟨12, 2⟩ | .tf2_44 => ⟨12, 5⟩
+  | .tf1_46 => ⟨14, 0⟩ | .tf2_46 => ⟨14, 3⟩
+  | .tf1_43 => ⟨16, 1⟩ | .tf1_48 => ⟨16, 4⟩
+  | .tf2_43 => ⟨16, 7⟩ | .tf2_48 => ⟨16, 10⟩

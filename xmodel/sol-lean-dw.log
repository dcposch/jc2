+  | .tf1_47 => ⟨20, 0⟩ | .tf1_52 => ⟨20, 3⟩
+  | .tf2_47 => ⟨20, 6⟩ | .tf2_52 => ⟨20, 9⟩
+  | .tf1_38 => ⟨6, 2⟩ | .tf1_40 => ⟨8, 0⟩
+  | .tf2_40 => ⟨8, 3⟩ | .tf1_39 => ⟨12, 8⟩
+  | .tf1_41 => ⟨14, 6⟩ | .tf2_41 => ⟨14, 9⟩
+
+def core2VariableCount : ℕ := 27
+def core2EquationCount : ℕ := 45
+def core2PivotCount : ℕ := 22

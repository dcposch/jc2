   305	      twistedCoefficient x o phase (12 + slot)) +
   306	      if slot = 20 then Polynomial.X else 0
   307	
   308	/-- The `7 * (orbitSize/7)` factors of one orbit.  Writing
   309	`phase = k + 7*j` matches the source registry exactly. -/
   310	def orbitFactors (x : ResidueAData) (o : Orbit) : List (Jet Coeff) :=
   311	  (List.range 7).flatMap fun k =>
   312	    (List.range (orbitSize o / 7)).map fun j =>
   313	      let phase := k + 7 * j
   314	      if isAside o && k = 0 then throughFactor x o phase
   315	      else offFactor x o phase
   316	
   317	def orbitJet (x : ResidueAData) (o : Orbit) : Jet Coeff :=
   318	  jetProduct (orbitFactors x o)
   319	
   320	/-- The normalized `Phi` jet of `f-a`. -/
   321	def phi (x : ResidueAData) : Jet Coeff :=
   322	  jetProduct (fOrbits.map (orbitJet x))
   323	
   324	/-- The normalized `Gamma` jet of `g`. -/
   325	def gamma (x : ResidueAData) : Jet Coeff :=
   326	  jetProduct (gOrbits.map (orbitJet x))
   327	
   328	/-- `P(eta) = (eta^3-a1)(eta^3-a2)` in the merge chart. -/
   329	def mergePolynomial : Polynomial Coeff :=
   330	  (Polynomial.X ^ 3 - Polynomial.C (3 + sqrtThree)) *
   331	    (Polynomial.X ^ 3 - Polynomial.C (3 - sqrtThree))
   332	
   333	def expectedPhi0 : Polynomial Coeff := Polynomial.C fLead * mergePolynomial ^ 2
   334	
   335	def expectedGamma0 : Polynomial Coeff := Polynomial.C gLead * mergePolynomial ^ 3
   336	
   337	/-- The four promoted slot-zero gates. -/
   338	def TopConditions (x : ResidueAData) : Prop :=
   339	  phi x 0 = expectedPhi0 ∧
   340	  gamma x 0 = expectedGamma0 ∧
   341	  gamma x 0 ^ 2 = phi x 0 ^ 3 ∧
   342	  (-12 : Polynomial Coeff) * phi x 0 * Polynomial.derivative (gamma x 0) +
   343	      18 * gamma x 0 * Polynomial.derivative (phi x 0) = 0
   344	
   345	/-! ## Depth rows, extensions, and the existence template -/
   346	
   347	/-- The coefficient of `t^k` in
   348	`(t Phi_t-12 Phi) Gamma_eta - Phi_eta (t Gamma_t-18 Gamma)`. -/
   349	def jacobianRow (x : ResidueAData) (k : ℕ) : Polynomial Coeff :=
   350	  ∑ i ∈ Finset.range (k + 1),
   351	    Polynomial.C ((((i : ℤ) - 12 : ℤ) : Coeff)) *
   352	        phi x i * Polynomial.derivative (gamma x (k - i)) -
   353	      Polynomial.C (((((k - i : ℕ) : ℤ) - 18 : ℤ) : Coeff)) *
   354	        gamma x (k - i) * Polynomial.derivative (phi x i)
   355	
   356	/-- Homogeneous rows except for the gauged Jacobian inhomogeneity at slot 20. -/
   357	def rowTarget (k : ℕ) : Polynomial Coeff :=
   358	  if k = 20 then Polynomial.C (-42) else 0
   359	
   360	/-- The engine convention: a depth-`D` point satisfies precisely the rows
   361	with `k < D`, together with the fixed chart and top data. -/
   362	def WindowConditions (D : ℕ) (x : ResidueAData) : Prop :=
   363	  x.radical.Valid ∧ TopConditions x ∧
   364	    ∀ k < D, jacobianRow x k = rowTarget k
   365	

diff --git a//Users/dc/code/math/jc2-lean/depth-witness/Challenge.lean b//Users/dc/code/math/jc2-lean/depth-witness/Challenge.lean
new file mode 100644
index 0000000000000000000000000000000000000000..def78903e6378ddb85f5edf98fad1a3e19a9382d
--- /dev/null
+++ b//Users/dc/code/math/jc2-lean/depth-witness/Challenge.lean
@@ -0,0 +1,487 @@
+/-

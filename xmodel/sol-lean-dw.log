   559	                rk3(Y[12].get((), RZERO))[0] == KONE
   560	        for k in range(7):
   561	            if Aside and k == 0:            # exact through-d0 factors
   562	                for j in range(n7):
   563	                    c = 7*j
   564	                    fac = {(1, 0): vC(RONE)}
   565	                    for lv, vv in Y.items():
   566	                        if lv >= 32 and lv - 32 < depth:
   567	                            tw = vscal(vv, rmono(za=(c*lv) % 42))
   568	                            if tw: fac[(0, lv-32)] = vscal(tw, K3(-1))
   569	                    jp = jmul(jp, fac, depth)
   570	                continue
   571	            # Delta = P - C_k Y (slots rel level 12), then suborbit Newton
   572	            D = {}
   573	            for s in range(depth):
   574	                lv = 12 + s
   575	                dv = P.get(lv, VZERO)
   576	                yv = Y.get(lv)
   577	                if yv:
   578	                    dv = vadd(dv, vscal(vscal(yv, rmono(za=(k*lv) % 42)),
   579	                                        K3(-1)))
   580	                if dv: D[s] = dv
   581	            Dp = {0: {0: vC(RONE)}, 1: D}
   582	            for r in range(2, n7+1): Dp[r] = smul(Dp[r-1], D, depth)
   583	            q = {r: {s: vscal(v, n7) for s, v in Dp[r].items() if s % 6 == 0}
   584	                 for r in range(1, n7+1)}
   585	            e = [{0: vC(RONE)}]
   586	            for jj in range(1, n7+1):
   587	                acc = {}
   588	                for r in range(1, jj+1):
   589	                    acc = sadd(acc, sscal(smul(e[jj-r], q[r], depth),
   590	                                          K3((-1)**(r-1))))
   591	                e.append(sscal(acc, K3(Fr(1, jj))))
   592	            blk = {}
   593	            for i in range(n7+1):           # eta^i (t^20)^i e_{n7-i}
   594	                if 20*i >= depth and i > 0: break
   595	                for s, v in e[n7-i].items():
   596	                    if s + 20*i < depth: blk[(i, s + 20*i)] = v
   597	            jp = jmul(jp, blk, depth)
   598	        print("      [gm_jet2 %s] orbit %s done (%d terms, %.1fs)"
   599	              % (tag, on, len(jp), time.time()-t0), flush=True)
   600	    return jp
   601	
   602	def eta_poly_ref(rootmults, scale):
   603	    """K3 eta-poly (low->high) prod (eta^3 - a)^m, scaled."""
   604	    _, pm = k3poly_pow_pattern()
   605	    out = [mk(scale)]
   606	    for a, mult in rootmults:
   607	        f = [-a, K0, K0, K1]
   608	        for _ in range(mult): out = pm(out, f)
   609	    return out
   610	def jet_matches_etapoly(jp, ref):
   611	    for (n, s), v in jp.items():
   612	        if s != 0: continue
   613	        kv = v.get((), RZERO); pure = rk3(kv)
   614	        if set(v) - {()} or pure is None or pure[0] != KONE: return False
   615	        want = ref[n] if n < len(ref) else K0
   616	        if not (pure[1] - want).iszero(): return False
   617	    # also require every nonzero ref coeff present
   618	    for i, c in enumerate(ref):
   619	        if not c.iszero() and (i, 0) not in jp: return False
   620	    return True
   621	
   622	# ---------------------------------------- 4b. fast F_s jet (suborbit Newton)
   623	def suborbit_esyms(orb, depth):
   624	    """e_0..e_{n7} of the C_7-suborbit {C_{7j} Ytilde}: power sums have
   625	    selector n7*[6|(12r+s)] => slots on the 6-grid; Newton over Q."""
   626	    n7 = C7SUB[orb["size"]]
   627	    yt = {lv-12: v for lv, v in orb["series"].items() if lv-12 < depth}
   628	    yp = {0: {0: vC(RONE)}, 1: yt}
   629	    for r in range(2, n7+1): yp[r] = smul(yp[r-1], yt, depth)
   630	    q = {}
   631	    for r in range(1, n7+1):
   632	        q[r] = {s: vscal(v, n7) for s, v in yp[r].items()
   633	                if (12*r + s) % 6 == 0 and ((s % 2 == 0) or orb["size"] == 42)}
   634	        # (even-support orbits have odd slots empty anyway)
   635	    e = [ {0: vC(RONE)} ]
   636	    for j in range(1, n7+1):
   637	        acc = {}
   638	        for r in range(1, j+1):
   639	            term = smul(e[j-r], q[r], depth)
   640	            acc = sadd(acc, sscal(term, K3((-1)**(r-1))))
   641	        e.append(sscal(acc, K3(Fr(1, j))))
   642	    return e
   643	def fs_block(orb, depth):
   644	    """product over the 7 direction images of the suborbit factor
   645	    sum_j (-1)^j e_j eta^{n7-j}; image k: coeff (n,s) *= zeta^{k(12n+s)}."""
   646	    n7 = C7SUB[orb["size"]]
   647	    e = suborbit_esyms(orb, depth)
   648	    rep = {}
   649	    for j in range(n7+1):
   650	        for s, v in e[j].items():
   651	            vv = vscal(v, K3((-1)**j))
   652	            if vv: rep[(n7-j, s)] = vv
   653	    blk = JONE
   654	    for k in range(7):
   655	        img = {(n, s): vscal(v, rmono(za=(k*(12*n+s)) % 42))
   656	               for (n, s), v in rep.items()}
   657	        blk = jmul(blk, img, depth)
   658	    return blk
   659	def fs_jet2(orbnames, orbs, depth, tag=""):
   660	    jp = JONE; t0 = time.time()
   661	    for on in orbnames:
   662	        jp = jmul(jp, fs_block(orbs[on], depth), depth)
   663	        print("      [fs_jet2 %s] block %s done (%d terms, %.1fs)"
   664	              % (tag, on, len(jp), time.time()-t0), flush=True)
   665	    return jp
   666	
   667	def full_esyms(orbnames, orbs, depth, jmax=6):
   668	    """aggregated e_1..e_jmax of the WHOLE branch set (unshifted y-levels,
   669	    slots in 42Z by conjugacy): p_r = sum_orb size*[42|s](Y^r)_s."""
   670	    p = {}
   671	    for r in range(1, jmax+1):
   672	        acc = {}
   673	        for on in orbnames:
   674	            acc = sadd(acc, orbit_powersum(orbs[on], r, depth))
   675	        p[r] = acc
   676	    e = [ {0: vC(RONE)} ]
   677	    for j in range(1, jmax+1):
   678	        acc = {}
   679	        for r in range(1, j+1):
   680	            acc = sadd(acc, sscal(smul(e[j-r], p[r], depth), K3((-1)**(r-1))))


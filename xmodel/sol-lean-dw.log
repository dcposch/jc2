+def towerTerm {R : Type*} [CommRing R] (fMinusA g : R)
+    (step : ℕ → TowerStep R) : ℕ → R
+  | 0 => g
+  | n + 1 => (towerTerm fMinusA g step n) ^ (step n).k -
+      (step n).s * fMinusA ^ (step n).l

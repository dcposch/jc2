from fractions import Fraction
from math import factorial
from itertools import permutations
from collections import defaultdict, Counter

# Exact Schur/plethysm bookkeeping in the power-sum basis.
def parts(n, maxpart=None, maxlen=None):
    if n == 0:
        yield ()
        return
    if maxlen == 0:
        return
    if maxpart is None or maxpart > n:
        maxpart = n
    for a in range(maxpart, 0, -1):
        for tail in parts(n-a, min(a,n-a) if n-a else 0,
                          None if maxlen is None else maxlen-1):
            yield (a,)+tail

def z(mu):
    c=Counter(mu); ans=1
    for k,m in c.items(): ans *= (k**m)*factorial(m)
    return ans

def union_parts(a,b): return tuple(sorted(a+b, reverse=True))

def mul(A,B):
    C=defaultdict(Fraction)
    for a,x in A.items():
        for b,y in B.items(): C[union_parts(a,b)] += x*y
    return dict(C)

def pk_hm(k,m):
    return {tuple(k*a for a in lam): Fraction(1,z(lam)) for lam in parts(m)}

def hplethysm(r,m):
    # h_r[h_m] = sum_{nu|-r} prod_i p_{nu_i}[h_m] / z_nu
    out=defaultdict(Fraction)
    for nu in parts(r):
        term={():Fraction(1)}
        for k in nu: term=mul(term,pk_hm(k,m))
        for rho,c in term.items(): out[rho] += c/Fraction(z(nu))
    return dict(out)

def parity(p):
    inv=sum(p[i]>p[j] for i in range(len(p)) for j in range(i+1,len(p)))
    return -1 if inv%2 else 1

def char(lam,mu,nvars=None):
    # Frobenius coefficient: [x"'^(lam+delta)] Delta(x) p_mu(x).
    nvars=nvars or len(lam)
    L=tuple(lam)+(0,)*(nvars-len(lam))
    delta=tuple(range(nvars-1,-1,-1))
    target=tuple(L[i]+delta[i] for i in range(nvars))
    total=0
    for perm_delta in permutations(delta):
        caps=tuple(target[i]-perm_delta[i] for i in range(nvars))
        if min(caps)<0 or sum(caps)!=sum(mu): continue
        dp={caps:1}
        for a in mu:
            nd=defaultdict(int)
            for state,count in dp.items():
                for i,c in enumerate(state):
                    if c>=a:
                        s=list(state); s[i]-=a
                        nd[tuple(s)] += count
            dp=nd
        total += parity(perm_delta)*dp.get((0,)*nvars,0)
    return total

def decompose_plethysm(r,m,maxlen):
    pb=hplethysm(r,m)
    dec={}
    for lam in parts(r*m,maxlen=maxlen):
        v=sum(c*char(lam,mu,maxlen) for mu,c in pb.items())
        if v:
            assert v.denominator==1 and v>0,(lam,v)
            dec[lam]=v.numerator
    return dec,pb

def pad(lam,n): return lam+(0,)*(n-len(lam))
def horizontal(mu,lam):
    n=max(len(mu),len(lam)); M=pad(mu,n); L=pad(lam,n)
    if any(M[i]<L[i] for i in range(n)): return False
    # interlacing M_i >= L_i >= M_{i+1}
    return all(L[i]>=M[i+1] for i in range(n-1))

def pieri(dec,k,maxlen):
    out=defaultdict(int)
    N=next(iter(dec)) and sum(next(iter(dec)))+k
    for mu in parts(N,maxlen=maxlen):
        for lam,mult in dec.items():
            if horizontal(mu,lam): out[mu]+=mult
    return dict(out)

# Self-check characters: S3 standard (2,1) on 1''^3,2.1,3 = 2,0,-1.
assert [char((2,1),mu,3) for mu in [(1,1,1),(2,1),(3,)]] == [2,0,-1]


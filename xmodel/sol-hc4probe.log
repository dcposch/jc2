print('"'Sym"'^3(Sym''^5 V), ell<=4: constituents='"',len(P35),'multiplicity_sum=',sum(P35.values()))
for lam in sorted(P35,reverse=True): print(' ',lam,'x',P35[lam])
print('After tensor Sym"'^4 V via Pieri: constituents='"',len(FIRST),'multiplicity_sum=',sum(FIRST.values()))
print('degree-11 equation type',target,'multiplicity in ambient=',FIRST.get(target,0))
print('parents contributing:',parents)
print('top equation type',top,'multiplicity in Sym"'^4(Sym''^5 V)='"',top_dec.get(top,0))
print('target neighborhood (all mu with tail (2,2,2) or first>=11):')
for mu in sorted(FIRST,reverse=True):
    if mu[0]>=11 or tuple(pad(mu,4)[1:])==(2,2,2): print(' ',mu,'x',FIRST[mu])

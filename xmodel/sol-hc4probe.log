from collections import defaultdict
from math import comb
P={(15,):1,(13,2):1,(12,3):1,(11,4):1,(11,2,2):1,(10,5):1,(10,4,1):1,(9,6):1,(9,4,2):1,(8,6,1):1,(8,5,2):1,(7,4,4):1,(6,6,3):1}
def parts(n,m=None,l=4):
 if n==0:yield ();return
 if l==0:return
 m=min(n,m or n)
 for a in range(m,0,-1):
  for t in parts(n-a,min(a,n-a) if n-a else 0,l-1):yield(a,)+t
def pad(q,n):return q+(0,)*(n-len(q))
def hs(mu,la):
 M=pad(mu,4);L=pad(la,4)
 return all(M[i]>=L[i] for i in range(4)) and all(L[i]>=M[i+1] for i in range(3))
def dim(q):
 q=pad(q,4);a=b=1
 for i in range(4):
  for j in range(i+1,4):a*=q[i]-q[j]+j-i;b*=j-i
 return a//b
D=defaultdict(int)
for mu in parts(19):
 for la,c in P.items():
  if hs(mu,la):D[mu]+=c
print(len(D),sum(D.values()),sum(dim(q)*c for q,c in D.items()),comb(58,3)*35)
assert sum(dim(q)*c for q,c in D.items())==comb(58,3)*35

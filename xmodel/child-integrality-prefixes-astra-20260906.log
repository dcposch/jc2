+              delta=H+Q(u,1)/epsilon*(delta-1),
+              lambda_f=Q(u,1)/epsilon*lf,
+              lambda_g=Q(u,1)/epsilon*lg)
+    cc['contribution'] = -cc['count']*rho_f*cc['lambda_g']

+            'child',','.join(map(str,r['child_sums'])),
+            'minor',','.join(map(str,r['minor_roots'])),
+            'rejected_frac',','.join(map(str,r['rejected_parent_fractional_sums'])))
+    print(json.dumps(result['summary']))
+
+
+if __name__=='__main__':
+    main()


+                rejected.append(dict(z=z, orbits=orbits, reason='REDUCED_ALL_ZERO_MAJOR'))
+                continue
+            if (z and z == lo) or lo in orbits:
+                rejected.append(dict(z=z, orbits=orbits, reason='ODE_RESONANT_FACTOR'))
+                continue

+        assert own['characteristic_scope']=='retained prefix only'
+        assert own['d'][own['s']+1]==own['us']>1
+        assert len(own['V_vectors'])==len(own['routes'])==1
+        assert own['V_vectors'][0]==tuple(map(Q,r['own_child']['V_prime']))

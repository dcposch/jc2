   569	def rho_inf_block_act(
   570	    nine: Sequence[frozenset],
   571	    kstar: int = KSTAR,
   572	) -> Tuple[frozenset, ...]:
   573	    """rho_inf = C_3(delta_3^2) · iota with iota = (delta_3^{k_*}, 1, 1)."""
   574	    b1 = tuple(nine[0:3])
   575	    b2 = tuple(nine[3:6])
   576	    b3 = tuple(nine[6:9])
   577	    s1 = delta3_power(b1, kstar)
   578	    s2 = b2
   579	    s3 = b3
   580	    after = c3_delta3_blocks(c3_delta3_blocks((tuple(s1), tuple(s2), tuple(s3))))
   581	    return after[0] + after[1] + after[2]

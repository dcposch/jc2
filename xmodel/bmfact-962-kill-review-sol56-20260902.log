   727	def load_bundle(path: str) -> dict:
   728	    with open(path, "r") as handle:
   729	        first = handle.read(1)
   730	        handle.seek(0)
   731	        if first == "{":
   732	            return json.load(handle)
   733	        # JSONL: assemble a bundle.
   734	        meta = None
   735	        braids = []
   736	        product = None
   737	        census = None
   738	        for line in handle:
   739	            line = line.strip()
   740	            if not line:
   741	                continue
   742	            rec = json.loads(line)
   743	            kind = rec.get("type")
   744	            if kind == "meta":
   745	                meta = rec
   746	            elif kind == "braid":
   747	                braids.append(rec)
   748	            elif kind == "product":
   749	                product = rec
   750	            elif kind == "census":
   751	                census = rec
   752	        return {
   753	            "braids": braids,
   754	            "product": product,
   755	            "census": census,
   756	            **(meta or {}),
   757	        }

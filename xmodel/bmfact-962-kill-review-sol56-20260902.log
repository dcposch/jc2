   760	def node_fibre_leftover_strand(braids: Sequence[dict]) -> Optional[int]:
   761	    """1-based leftover strand of the unique node-fibre braid, if CPF splits it."""
   762	    node_recs = [b for b in braids if str(b.get("census_class", "")).startswith("node_fibre")]
   763	    if len(node_recs) != 1:
   764	        return None

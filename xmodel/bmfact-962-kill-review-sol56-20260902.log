   456	def expand_144() -> List[Dict[str, object]]:
   457	    out: List[Dict[str, object]] = []
   458	    seen: Set[Tuple] = set()
   459	    for rep in CLASS_REPS:
   460	        for g_elt in S4_ELEMENTS:
   461	            item = conjugate_class_rep(rep, g_elt)
   462	            key = (item["X"], item["Y"], item["T1"])
   463	            if key in seen:
   464	                raise AssertionError(
   465	                    "expand_144: collision inside class %s" % rep["name"]
   466	                )
   467	            seen.add(key)
   468	            out.append(item)
   469	    if len(out) != 144:
   470	        raise AssertionError("expand_144: got %d, expected 144" % len(out))
   471	    return out

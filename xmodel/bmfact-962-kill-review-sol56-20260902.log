   474	def reconstruct_nine(
   475	    item: Dict[str, object],
   476	    kstar: int = KSTAR,
   477	) -> Tuple[frozenset, ...]:
   478	    """Fill T_2, T_3 from T_1 by iota = (delta_3^{k_*}, 1, 1).
   479	
   480	    From CABLE-3 (REP-96 §3), with iota_1 = delta_3^{k_*}, iota_2 = iota_3 = 1:
   481	      T_3 = iota_1 . T_1 = delta_3^{k_*} . T_1
   482	      T_2 = (iota_3 iota_1) . c_{XY}(T_1) = delta_3^{k_*} . c_{XY}(T_1)
   483	    OPEN[BMFACT-IOTA-SPLIT]: other splits of iota with the same ordered
   484	    product are a variant; this split is the one declared here.
   485	    Adjacent-block identification: strands 1..3 = T_1, 4..6 = T_2, 7..9 = T_3.
   486	    OPEN[BMFACT-TUBE-EMBEDDING]: residue-mod-3 tubes are a second reading.
   487	    """
   488	    t1: Tuple[frozenset, ...] = item["T1"]  # type: ignore[assignment]
   489	    perm_x: Tuple[int, int, int, int] = item["X"]  # type: ignore[assignment]
   490	    perm_y: Tuple[int, int, int, int] = item["Y"]  # type: ignore[assignment]
   491	    perm_xy = compose_perm(perm_x, perm_y)
   492	    t3 = delta3_power(t1, kstar)
   493	    t2 = delta3_power(entrywise_conj_triple(perm_xy, t1), kstar)
   494	    return tuple(t1) + tuple(t2) + tuple(t3)

   215	def artin_auto_images(tietze_word, n_strands):
   216	    """Images of the n free generators under the Artin auto of a Tietze word.
   217	
   218	    Rightmost letter first, matching left Hurwitz (B6) and Sage multiplication
   219	    B([1,2]) = s0*s1 acting on the left on tuples.
   220	    """
   221	    images = [[idx] for idx in range(1, n_strands + 1)]
   222	    position = len(tietze_word) - 1
   223	    while position >= 0:
   224	        letter = tietze_word[position]
   225	        images = [
   226	            apply_artin_letter_to_word(word, letter, n_strands)
   227	            for word in images
   228	        ]
   229	        position -= 1
   230	    return images

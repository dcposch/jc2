/bin/zsh -lc "python3 - <<'PY'
import importlib.util,json,itertools,time
spec=importlib.util.spec_from_file_location('bm','box/bmfact_enum.py')
m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
path='/private/var/folders/80/jm5p82hn56g0crpvv9xjzrc00000gn/T/jc2-lane.Oxi0C4/inputs/bmfact962_result.json'
with open(path) as h: J=json.load(h)
words=[b['tietze'] for b in J['braids']]
order=sorted(range(len(words)),key=lambda i:len(words[i]))
print('predicate_order',[(i,len(words[i])) for i in order],flush=True)
fixed=[]; passed=[0]*len(words); start=time.time()
for idx,combo in enumerate(itertools.product(m.TRANSPOSITIONS,repeat=9),1):
    nine=tuple(combo)
    ok=True
    for depth,i in enumerate(order):
        if not m.is_fixed_by_tietze(nine,words[i]): ok=False; break
        passed[depth]+=1
    if ok: fixed.append(nine)
    if idx%1000000==0: print('progress',idx,'elapsed',round(time.time()-start,1),'fixed_so_far',len(fixed),'passed',passed,flush=True)
print('DONE elapsed',time.time()-start,'n_fixed',len(fixed),flush=True)
# exact generated subgroup under composition
for j,nine in enumerate(fixed,1):
    gens=[m.transposition_to_perm(t) for t in nine]
    H={m.PERM_IDENTITY}; changed=True
    while changed:
        changed=False
        for a in list(H):
            for g in gens:
                for p in (m.compose_perm(a,g),m.compose_perm(g,a)):
                    if p not in H: H.add(p);changed=True
    orbits=[]; unseen=set(m.LETTER_SET)
    while unseen:
        seed=min(unseen); orb={h[seed-1] for h in H}; orbits.append(sorted(orb));unseen-=orb
    print('FIXED',j,[m.fmt_transp(t) for t in nine],'H_order',len(H),'H_elements',sorted(m.fmt_perm(h) for h in H),'orbits',orbits,flush=True)

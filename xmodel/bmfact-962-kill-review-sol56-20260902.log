   475	def classify_factor(rec):
   476	    """Classify one geometric-basis braid against the REP-96 §1 census.
   477	
   478	    tangency: exponent 1, permutation a single transposition, CPF one
   479	              piece whose alpha has exponent 1.
   480	    node_fibre: exponent 8, permutation the identity, CPF four pieces
   481	                each of exponent 2 (four commuting sigma_i^2).
   482	    """
   483	    e_sum = rec["exponent_sum"]
   484	    ctype = rec["permutation_cycle_type"]
   485	    cpf_ok = rec["conjugate_positive_form_ok"]
   486	    pieces = rec["conjugate_positive_form"] or []
   487	    alpha_exps = [int(piece["alpha_exponent_sum"]) for piece in pieces] if cpf_ok else []
   488	
   489	    is_transposition_perm = sorted(ctype) == [1, 1, 1, 1, 1, 1, 1, 2]
   490	    is_identity_perm = (not ctype) or (max(ctype) == 1 and sum(ctype) == 9)
   491	
   492	    if e_sum == 1 and is_transposition_perm:
   493	        if cpf_ok and alpha_exps == [1]:
   494	            return "tangency"
   495	        if cpf_ok:
   496	            return "tangency_cpf_unexpected"
   497	        return "tangency_cpf_missing"
   498	    if e_sum == 8 and is_identity_perm:
   499	        if cpf_ok and sorted(alpha_exps) == [2, 2, 2, 2]:
   500	            return "node_fibre"
   501	        if cpf_ok and len(alpha_exps) == 1 and alpha_exps[0] == 8:
   502	            return "node_fibre_unsplit"
   503	        if cpf_ok:
   504	            return "node_fibre_cpf_unexpected"
   505	        return "node_fibre_cpf_missing"
   506	    return "other"

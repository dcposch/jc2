   497	def allowed_tau(perm_pi: Tuple[int, int, int, int]) -> List[frozenset]:
   498	    """Pi tau in V_4, tau a transposition: tau = Pi or tau disjoint from Pi."""
   499	    out: List[frozenset] = []
   500	    for tau in TRANSPOSITIONS:
   501	        prod = compose_perm(perm_pi, transposition_to_perm(tau))
   502	        if prod in V4_PERMS:
   503	            out.append(tau)
   504	    return out

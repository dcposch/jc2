   233	def build_F():
   234	    """F(coord_x, coord_y) = Res_t(p(t)-x, q(t)-y), primitive in QQ[x,y].
   235	
   236	    Ring map, declared:
   237	      coefficient field = QQ
   238	      generator order   = (coord_x, coord_y) so the x-projection is first
   239	      param_t           = elimination variable
   240	    Image check: the resultant is asserted equal to the closed form coming
   241	    from x^2 - y^3 - 64 y = 64 t^2, not inferred from matching names.
   242	    """
   243	    ring_xy = QQ["coord_x", "coord_y"]
   244	    coord_x, coord_y = ring_xy.gens()
   245	    ring_t = ring_xy["param_t"]
   246	    param_t = ring_t.gen(0)
   247	
   248	    poly_p = param_t**9 + 12 * param_t**5 + 24 * param_t
   249	    poly_q = param_t**6 + 8 * param_t**2
   250	    poly_P = poly_p - coord_x
   251	    poly_Q = poly_q - coord_y
   252	    # FLAG: MultivariatePolynomial.resultant is classical Sage.
   253	    poly_F_raw = poly_P.resultant(poly_Q)
   254	    if poly_F_raw.parent() is not ring_xy:
   255	        poly_F_raw = ring_xy(poly_F_raw)
   256	    if poly_F_raw == 0:
   257	        fail("build_F: resultant is the zero polynomial")
   258	    content_rational = poly_F_raw.content()
   259	    if content_rational == 0:
   260	        fail("build_F: content of a nonzero polynomial was 0")
   261	    poly_F = ring_xy(poly_F_raw / content_rational)
   262	
   263	    # Closed-form cross-check (identity substitution).
   264	    poly_F_closed = ring_xy(
   265	        coord_x**6
   266	        - 3 * coord_x**4 * coord_y**3
   267	        - 192 * coord_x**4 * coord_y
   268	        + 3 * coord_x**2 * coord_y**6
   269	        + 384 * coord_x**2 * coord_y**4
   270	        + 12288 * coord_x**2 * coord_y**2
   271	        + 32768 * coord_x**2
   272	        - coord_y**9
   273	        - 192 * coord_y**7
   274	        - 12288 * coord_y**5
   275	        - 294912 * coord_y**3
   276	        - 2359296 * coord_y
   277	    )
   278	    if poly_F != poly_F_closed and poly_F != -poly_F_closed:
   279	        fail(
   280	            "build_F: Res_t(p-x, q-y) disagrees with the identity closed form. "
   281	            "resultant=%s closed=%s" % (poly_F, poly_F_closed)
   282	        )
   283	    # Prefer the closed-form sign (positive x^6).
   284	    if poly_F == -poly_F_closed:
   285	        poly_F = poly_F_closed
   286	    return ring_xy, coord_x, coord_y, poly_F
   287	

   173	        x_k     |-> x_k x_{k+1} x_k^{-1}
   174	        x_{k+1} |-> x_k
   175	    sigma_k^{-1} (tietze_letter = -k < 0):
   176	        x_k     |-> x_{k+1}
   177	        x_{k+1} |-> x_{k+1}^{-1} x_k x_{k+1}
   178	    """
   179	    if tietze_letter == 0:
   180	        fail("apply_artin_letter_to_word: Tietze letter 0")
   181	    gen_abs = abs(int(tietze_letter))
   182	    if gen_abs < 1 or gen_abs >= n_strands:
   183	        fail(
   184	            "apply_artin_letter_to_word: |letter|=%d outside 1..%d"
   185	            % (gen_abs, n_strands - 1)
   186	        )
   187	    out = []
   188	    positive = tietze_letter > 0
   189	    for signed in word:
   190	        letter_abs = abs(int(signed))
   191	        letter_sign = 1 if signed > 0 else -1
   192	        if positive:
   193	            if letter_abs == gen_abs:
   194	                if letter_sign > 0:
   195	                    out.extend([gen_abs, gen_abs + 1, -gen_abs])
   196	                else:
   197	                    out.extend([gen_abs, -(gen_abs + 1), -gen_abs])
   198	            elif letter_abs == gen_abs + 1:
   199	                out.append(letter_sign * gen_abs)
   200	            else:
   201	                out.append(int(signed))
   202	        else:
   203	            if letter_abs == gen_abs:
   204	                out.append(letter_sign * (gen_abs + 1))
   205	            elif letter_abs == gen_abs + 1:
   206	                if letter_sign > 0:
   207	                    out.extend([-(gen_abs + 1), gen_abs, gen_abs + 1])
   208	                else:
   209	                    out.extend([-(gen_abs + 1), -gen_abs, gen_abs + 1])
   210	            else:
   211	                out.append(int(signed))
   212	    return freely_reduce_tietze(out)

   559	def c3_delta3_blocks(
   560	    blocks: Tuple[Tuple[frozenset, ...], Tuple[frozenset, ...], Tuple[frozenset, ...]],
   561	) -> Tuple[Tuple[frozenset, ...], Tuple[frozenset, ...], Tuple[frozenset, ...]]:
   562	    """C_3(delta_3) . (B1,B2,B3) = (c_{P1 P2}(B3), B1, B2)  (REP-96 (2.4))."""
   563	    b1, b2, b3 = blocks
   564	    perm_w = compose_perm(prod3_perm(b1), prod3_perm(b2))
   565	    new_b1 = entrywise_conj_triple(perm_w, b3)
   566	    return (tuple(new_b1), tuple(b1), tuple(b2))

   289	def precheck():
   290	    """Degree, irreducibility, four nodes, discriminant support. Exact, no SIROCCO."""
   291	    print("PRECHECK realized (9,6,2) curve p=t^9+12t^5+24t, q=t^6+8t^2")
   292	    sys.stdout.flush()
   293	    ring_xy, coord_x, coord_y, poly_F = build_F()
   294	
   295	    total_deg = poly_F.total_degree()
   296	    if total_deg != 9:
   297	        fail("precheck: total_degree(F)=%s, expected 9" % total_deg)
   298	    deg_y = poly_F.degree(coord_y)
   299	    if deg_y != 9:
   300	        fail(
   301	            "precheck: deg_y(F)=%s, expected 9. Sage braid_monodromy "
   302	            "projects over the first variable; deg_y=deg means no vertical "
   303	            "asymptotes." % deg_y
   304	        )
   305	    deg_x = poly_F.degree(coord_x)
   306	    if deg_x != 6:
   307	        fail("precheck: deg_x(F)=%s, expected 6 (bidegree (6,9))" % deg_x)
   308	
   309	    # FLAG: factor() of a bivariate QQ-polynomial is classical Sage.
   310	    factored = poly_F.factor()
   311	    unit_part = factored.unit()
   312	    n_factors = len(factored)
   313	    if n_factors != 1:
   314	        fail(
   315	            "precheck: F factored into %d non-unit factors %s; expected irreducible"
   316	            % (n_factors, factored)
   317	        )
   318	    poly_irr, multiplicity = factored[0]
   319	    if multiplicity != 1:
   320	        fail(
   321	            "precheck: irreducible factor has multiplicity %d. factorisation=%s"
   322	            % (multiplicity, factored)
   323	        )
   324	    if hasattr(poly_F, "is_irreducible"):
   325	        if not poly_F.is_irreducible():
   326	            fail("precheck: F.is_irreducible() is False after factor() showed one factor")
   327	
   328	    partial_x = poly_F.derivative(coord_x)
   329	    partial_y = poly_F.derivative(coord_y)
   330	    # FLAG: PolynomialRing.ideal / dimension / vector_space_dimension
   331	    # not re-fetched from a dedicated commutative-algebra doc page.
   332	    ideal_sing = ring_xy.ideal([poly_F, partial_x, partial_y])
   333	    dim_sing = ideal_sing.dimension()
   334	    if dim_sing != 0:
   335	        fail(
   336	            "precheck: singular locus has dimension %s, expected 0 (finite nodes)"
   337	            % dim_sing
   338	        )
   339	    vdim_sing = ideal_sing.vector_space_dimension()
   340	    if vdim_sing != 4:
   341	        fail(
   342	            "precheck: vector_space_dimension of Jacobian ideal = %s, expected 4 "
   343	            "(four reduced affine nodes, all on x=0)"
   344	            % vdim_sing
   345	        )
   346	
   347	    disc_raw = poly_F.resultant(partial_y, coord_y)
   348	    disc_in_xy = ring_xy(disc_raw)
   349	    ring_x = QQ["coord_x_only"]
   350	    coord_x_only = ring_x.gen(0)
   351	    disc_univariate = ring_x(0)
   352	    for exponent_pair, coeff in disc_in_xy.dict().items():
   353	        exp_x = exponent_pair[0]
   354	        exp_y = exponent_pair[1]
   355	        if exp_y != 0:
   356	            fail("precheck: Res_y(F, dF/dy) still depends on y (term y^%d)" % exp_y)
   357	        disc_univariate = disc_univariate + ring_x(coeff) * coord_x_only**exp_x
   358	    if disc_univariate == 0:
   359	        fail("precheck: discriminant in x is the zero polynomial")
   360	    if disc_univariate.degree() != 16:
   361	        fail(
   362	            "precheck: deg(disc_y F)=%s, expected 16 = 2 delta_aff + d - 1"
   363	            % disc_univariate.degree()
   364	        )
   365	    # FLAG: squarefree_part / valuation classical univariate.
   366	    disc_squarefree = disc_univariate.radical()  # radical()=distinct support; squarefree_part() divides by max square (footgun #10)
   367	    n_disc_support = disc_squarefree.degree()
   368	    if n_disc_support != N_DISC_SUPPORT_EXPECTED:
   369	        fail(
   370	            "precheck: square-free discriminant in x has degree %s, expected %d "
   371	            "(eight tangency values + x=0). REP-96 §1 census."
   372	            % (n_disc_support, N_DISC_SUPPORT_EXPECTED)
   373	        )
   374	    val_at_zero = disc_univariate.valuation(coord_x_only)
   375	    if val_at_zero != 8:
   376	        fail(
   377	            "precheck: valuation of disc_y F at x=0 is %s, expected 8 "
   378	            "(four nodes, disc valuation 2 each)"
   379	            % val_at_zero
   380	        )
   381	
   382	    record = {
   383	        "curve": "realized (9,6,2)",
   384	        "param_p": "t^9 + 12 t^5 + 24 t",
   385	        "param_q": "t^6 + 8 t^2",
   386	        "F": str(poly_F),
   387	        "F_closed_form": F_CLOSED_FORM_TERMS,
   388	        "F_unit_from_factor": str(unit_part),
   389	        "total_degree": int(total_deg),

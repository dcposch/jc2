   669	def brute_generating_product_fixed(kstar: int = KSTAR) -> Dict[str, object]:
   670	    """All 6^9 transposition 9-tuples, adjacent-block CABLE-3 product relation.
   671	
   672	    Lookup-table scan: 216^3. Used as an independent check that 144 is the
   673	    complete generating count, not only the class-list reconstruction.
   674	    """
   675	    all_triples = list(iproduct(TRANSPOSITIONS, repeat=3))
   676	    assert len(all_triples) == 216
   677	    index_of = {triple: idx for idx, triple in enumerate(all_triples)}
   678	    products = [prod3_perm(triple) for triple in all_triples]
   679	
   680	    def dmap(power: int) -> List[int]:
   681	        return [index_of[delta3_power(triple, power)] for triple in all_triples]
   682	
   683	    map_iota = dmap(kstar)
   684	    # C3_one(i,j,k) = (idx[c_{Pi Pj}(triple_k)], i, j)
   685	    conj_table: List[List[List[int]]] = []
   686	    # Too big if fully materialised as 216^3. Build a 216x216 map:
   687	    # for each (i,j), the permutation of k.
   688	    pair_map: List[List[List[int]]] = [[None] * 216 for _ in range(216)]  # type: ignore[list-item]
   689	    for i in range(216):
   690	        for j in range(216):
   691	            perm_w = compose_perm(products[i], products[j])
   692	            row = [index_of[entrywise_conj_triple(perm_w, all_triples[k])] for k in range(216)]
   693	            pair_map[i][j] = row  # type: ignore[assignment]
   694	
   695	    n_fixed = 0
   696	    n_gen = 0
   697	    for i in range(216):
   698	        i1 = map_iota[i]
   699	        for j in range(216):
   700	            j1 = j  # iota_2 = 1
   701	            for k in range(216):
   702	                k1 = k  # iota_3 = 1
   703	                # C3 twice
   704	                a_idx = pair_map[i1][j1][k1]
   705	                a, b, c = a_idx, i1, j1
   706	                a2 = pair_map[a][b][c]
   707	                a, b, c = a2, a, b
   708	                if a == i and b == j and c == k:
   709	                    n_fixed += 1
   710	                    nine = all_triples[i] + all_triples[j] + all_triples[k]
   711	                    if tuple_generates_s4(nine):
   712	                        n_gen += 1
   713	    return {
   714	        "kstar": kstar,
   715	        "iota": "(delta_3^{k_*}, 1, 1)",
   716	        "n_product_fixed": n_fixed,
   717	        "n_generating": n_gen,
   718	        "expected_generating": 144,
   719	        "passed": n_gen == 144,
   720	    }

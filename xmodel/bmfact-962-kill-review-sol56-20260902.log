   507	def assert_pi_tau_pin(expanded: Sequence[Dict[str, object]]) -> Dict[str, object]:
   508	    """ASSERTION, not a filter. REP-96 §7 R1: Pi tau in V_4, two of six transpositions."""
   509	    failures: List[str] = []
   510	    per_class: Dict[str, List[str]] = {}
   511	    for item in expanded:
   512	        perm_pi = item["Pi"]  # type: ignore[assignment]
   513	        name = str(item["name"])
   514	        if not is_transposition_perm(perm_pi):  # type: ignore[arg-type]
   515	            failures.append("%s: Pi = %s is not a transposition" % (name, fmt_perm(perm_pi)))  # type: ignore[arg-type]
   516	            continue
   517	        allowed = allowed_tau(perm_pi)  # type: ignore[arg-type]
   518	        labels = [fmt_transp(t) for t in allowed]
   519	        per_class.setdefault(name, labels)
   520	        if len(allowed) != 2:
   521	            failures.append(
   522	                "%s: Pi-tau pin allows %d transpositions, expected 2: %s"
   523	                % (name, len(allowed), labels)
   524	            )
   525	    return {
   526	        "passed": len(failures) == 0,
   527	        "n_checked": len(expanded),
   528	        "failures": failures,
   529	        "allowed_tau_by_class_rep": {rep["name"]: allowed_tau(rep["Pi"]) for rep in CLASS_REPS},  # type: ignore[arg-type]
   530	        "note": (
   531	            "ASSERTION, not a filter. On every (9,6,2) class Pi is a "
   532	            "transposition and exactly two of the six transpositions tau "
   533	            "satisfy Pi tau in V_4 (tau = Pi or tau disjoint from Pi)."
   534	        ),
   535	    }

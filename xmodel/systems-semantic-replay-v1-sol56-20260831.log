++def run_gate(certificate: Path) -> tuple[int, dict[str, Any]]:
++    environment = os.environ.copy()
++    environment["SEMANTIC_REPLAY_MUTATION_ID"] = "ambient-must-not-leak"
++    process = subprocess.run(

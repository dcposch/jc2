+        "args": ["--emit-semantic-replay"]
+      },
+      "production_path": {
+        "id": "row-to-braid-to-s4-verdict",
+        "script": "../ops/classify_rows.py",
+        "sha256": "<64 lowercase hex>",
+        "args": ["--consume-semantic-replay"]
+      },

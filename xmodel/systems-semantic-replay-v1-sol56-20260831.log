++
++
++mode = sys.argv[1]
++if mode == "generate":
++    rejected_score = 2 if "--flip-rejected" in sys.argv[2:] else 0
++    diagnostic = "mutated" if "--noise-only" in sys.argv[2:] else "baseline"
++    if "--rewrite-path" in sys.argv[2:]:

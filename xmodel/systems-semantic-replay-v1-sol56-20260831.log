++        self.assertIn("invalid JSON", result["reason"])
++
++    def test_charged_census_has_insufficient_certificate_data(self) -> None:
++        partial = {
++            "schema": "SEMANTIC-REPLAY/v1",
++            "_charged_source_extract": CENSUS_EXTRACT,

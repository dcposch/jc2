++        mutation["id"] = "diagnostic-noise-only"
++        mutation["generator_args_append"] = ["--noise-only"]
++        mutation["claim_sha256"] = MUTATED_DIGEST
++        returncode, result = run_gate(self.write_json(certificate))
++        self.assertEqual(returncode, 3)

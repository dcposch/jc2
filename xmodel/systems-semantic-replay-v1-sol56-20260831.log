++
++
++def run_gate(certificate: Path) -> tuple[int, dict[str, Any]]:
++    process = subprocess.run(
++        [sys.executable, "-B", str(GATE), "check", str(certificate)],
++        check=False,
++        capture_output=True,
++        text=True,
++    )
++    return process.returncode, json.loads(process.stdout)

+        failures.append(f"independent sharp did not reproduce 48/33: {policies['independent_sharp']}")
+
+    strata = {}
+    for label, predicate in (
+        ("u_s=1", lambda r: r["u_s"] == 1),
+        ("u_s>1", lambda r: r["u_s"] > 1),

+    }
+    for label, (IM, Im, excluded) in expected_cal.items():
+        rec = calibration[label]
+        if (frac_text(rec["IM"]), frac_text(rec["Im"]), rec["excluded_by_cor53"]) != (IM, Im, excluded):

+assert (cal["75_50_split_ii"]["IM"], cal["75_50_split_ii"]["Im"], cal["75_50_split_ii"]["excluded_by_all"]) == ("4", "6", True)
+assert (cal["84_56_M2_64_V2_2"]["IM"], cal["84_56_M2_64_V2_2"]["Im"], cal["84_56_M2_64_V2_2"]["excluded_by_all"]) == ("4", "5", True)

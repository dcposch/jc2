+(84,56;  M=[64,82];        V_s=3,u_s=1)  slack -1
+(90,60;  M=[45,80,88];     V_s=4,u_s=1)  slack -6/7  [2 rows]
+(108,72; M=[60,100,106];   V_s=3,u_s=1)  slack -13/5

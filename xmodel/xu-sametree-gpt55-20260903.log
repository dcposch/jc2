+            "policies": policies,
+            "by_u_s_class": strata,
+            "new_same_tree_cor53_killed_groups_D_le_120_vs_independent": new_c53_groups,
+            "new_same_tree_all_killed_groups_D_le_120_vs_independent": new_all_groups,
+            "same_tree_all_killed_groups_D_le_120": all_killed_D_le_120,
+            "killers_all_rows": {

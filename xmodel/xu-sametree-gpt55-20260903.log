   799	def run(dlo, dhi):
   800	    t0 = time.perf_counter()
   801	    failures = []
   802	    rows_all = []
   803	    for n in range(dlo, dhi + 1):
   804	        for m, Ms, V in M.census(n, Kmin=16, full=True):
   805	            S = M.Skel(n, m, list(Ms), V)
   806	            if FT.full_tree_polynomial_ode_ok(S):
   807	                rows_all.append(S)
   808	    if len(rows_all) != 1420 or len({group_key(S) for S in rows_all}) != 686:
   809	        failures.append(
   810	            f"operative census expected 1420/686, got {len(rows_all)}/"
   811	            f"{len({group_key(S) for S in rows_all})}"
   812	        )
   813	
   814	    calibration = {
   815	        "75_50_split_i": manual_j2_split(
   816	            M.Skel(75, 50, [55, 73], {2: 2, 3: 4}),
   817	            zero=0,
   818	            nonzero_values=[2, 2],
   819	        ),
   820	        "75_50_split_ii": manual_j2_split(
   821	            M.Skel(75, 50, [55, 73], {2: 2, 3: 4}),
   822	            zero=0,
   823	            nonzero_values=[2, 1, 1],
   824	        ),
   825	        "84_56_M2_64_V2_2": manual_j2_split(
   826	            M.Skel(84, 56, [64, 82], {2: 2, 3: 3}),
   827	            zero=0,
   828	            nonzero_values=[2, 1],
   829	        ),
   830	        "84_56_M2_72_V2_5": manual_j2_split(
   831	            M.Skel(84, 56, [72, 82], {2: 5, 3: 3}),
   832	            zero=1,
   833	            nonzero_values=[5],
   834	        ),
   835	    }
   836	    expected_cal = {
   837	        "75_50_split_i": ("8", "4", False),
   838	        "75_50_split_ii": ("4", "6", True),
   839	        "84_56_M2_64_V2_2": ("4", "5", True),
   840	        "84_56_M2_72_V2_5": ("10", "4", False),
   841	    }
   842	    for label, (IM, Im, excluded) in expected_cal.items():
   843	        rec = calibration[label]
   844	        if (frac_text(rec["IM"]), frac_text(rec["Im"]), rec["excluded_by_cor53"]) != (IM, Im, excluded):
   845	            failures.append(f"calibration {label} mismatch")
   846	
   847	    row_results = []
   848	    for idx, S in enumerate(rows_all, 1):
   849	        D = SameTree(S)
   850	        ev = D.evaluate()
   851	        rec = {
   852	            "n": S.n,
   853	            "m": S.m,
   854	            "s": S.s,
   855	            "M": m_list(S),
   856	            "V": v_map(S),
   857	            "V_s": S.V[S.s],
   858	            "u_s": u_s_of(S),
   859	            "row_key": repr(row_key(S)),
   860	            "group_key": group_key_text(S),
   861	            "phi_eff": phi_eff(S),
   862	        }
   863	        rec.update(jsonable(ev))
   864	        if rec["tree_status"] == "OK":
   865	            if not rec["same_tree_c53_ok"]:
   866	                rec["all_killer"] = "Corollary 5.3 / Theorem 4.7(ii)"
   867	            elif not rec["same_tree_all_ok"]:
   868	                rec["all_killer"] = "Theorem 3.4 + Theorem 4.7(i)"
   869	            else:
   870	                rec["all_killer"] = "survives"
   871	        else:
   872	            rec["independent_ok"] = False
   873	            rec["same_tree_c53_ok"] = False
   874	            rec["same_tree_all_ok"] = False
   875	            rec["all_killer"] = "NO-OPERATIVE-TREE"
   876	        row_results.append(rec)
   877	        if idx % 100 == 0 or idx == len(rows_all):
   878	            print(
   879	                f"processed {idx}/{len(rows_all)} rows; "
   880	                f"same-tree all killed rows={sum(not r['same_tree_all_ok'] for r in row_results)}",
   881	                flush=True,
   882	            )
   883	
   884	    policies = {
   885	        "independent_sharp": stats(row_results, "independent_ok"),
   886	        "same_tree_cor53": stats(row_results, "same_tree_c53_ok"),
   887	        "same_tree_all": stats(row_results, "same_tree_all_ok"),

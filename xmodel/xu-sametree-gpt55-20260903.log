+    kg_ind = killed_groups(row_results, "independent_ok")
+    kg_c53 = killed_groups(row_results, "same_tree_c53_ok")
+    kg_all = killed_groups(row_results, "same_tree_all_ok")
+
+    def group_summary(items):
+        first = items[0]
+        return {

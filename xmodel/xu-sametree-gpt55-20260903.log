   889	    if policies["independent_sharp"]["killed_rows"] != 48 or policies["independent_sharp"]["killed_groups"] != 33:
   890	        failures.append(f"independent sharp did not reproduce 48/33: {policies['independent_sharp']}")
   891	
   892	    strata = {}

   738	def jsonable(obj):
   739	    if isinstance(obj, F):
   740	        return frac_text(obj)
   741	    if isinstance(obj, dict):
   742	        return {str(k): jsonable(v) for k, v in obj.items()}
   743	    if isinstance(obj, (list, tuple)):
   744	        return [jsonable(v) for v in obj]
   745	    return obj

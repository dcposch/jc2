+            "s": first["s"],
+            "rows_in_group": len(items),
+            "killers": sorted({row["all_killer"] for row in items}),
+            "rows": [compact(row) for row in sorted(items, key=lambda r: repr(r["V"]))],
+        }
+
+    new_c53_groups = [

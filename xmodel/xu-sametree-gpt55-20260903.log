+        if items[0]["n"] <= 120
+    ]
+    for lst in (new_c53_groups, new_all_groups, all_killed_D_le_120):
+        lst.sort(key=lambda r: (r["n"], r["m"], r["M"], r["V_s"]))
+
+    target_99 = unique_row(

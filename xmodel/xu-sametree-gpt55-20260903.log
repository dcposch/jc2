+        "excluded_by_all": IM < Im or t47_slack < 0,
+        "principal": {
+            "roots": frac_text(pr.roots),
+            "delta": frac_text(pr.delta),
+            "Im": frac_text(pr.im),
+            "weighted": frac_text(pr.weighted),
+            "I": frac_text(pr.intersection),
+        },
+        "parts": parts,
+    }
+
+
+def jsonable(obj):
+    if isinstance(obj, F):

            out.append((n, m, Ms, tuple(sorted(V.items()))))
    print("   (1)-(13) survivors at n <= 100 (Kmin=2, Moh's own space): %d   [%.1fs]"
          % (len(out), time.time()-t0))
    for r in sorted(out):
        n, m, Ms, V = r

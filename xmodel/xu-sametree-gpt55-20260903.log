   116	    n, s = D["n"], D["s"]
   117	    Mdict, ddict, Vdict = dict(D["M"]), dict(D["d"]), dict(D["V"])
   118	    dropped = 0
   119	    while s >= 1 and Mdict.get(s) == n - 1:
   120	        dropped += 1
   220	    roots: F
   221	    delta: F
   222	    im: F
   223	    weighted: F
   224	    intersection: F

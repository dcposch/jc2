   506	    @lru_cache(maxsize=None)
   507	    def global_pair(self, j, path, dangerous, Sout):
   508	        self.stats["pair_global_nodes"] += 1
   509	        delta, _L, _A, _P, _Q, _lo = self.E.level_data(j, path)
   510	        Nj = self.node_root_count(j, path)
   511	        points = []
   512	        for children, selected in self.plans(j, path, False):
   513	            assert selected is None
   514	            frontiers = []
   515	            feasible = True
   516	            for child in children:
   517	                value, _orbit, _is_zero, _is_major = child
   518	                Nc = self.child_root_count(j, value)
   519	                Sout_c = Sout - (Nj - Nc) * delta
   520	                frontier = self.child_pair(j, path, dangerous, Sout_c, child, False)
   521	                if not frontier:
   522	                    feasible = False
   523	                    break
   524	                frontiers.append(frontier)
   525	            if feasible:
   526	                points.extend(combine_frontiers(frontiers))
   527	        result = pareto(points)
   528	        self.stats["max_frontier"] = max(self.stats["max_frontier"], len(result))
   529	        return result

        "POLY_ODE": FT.full_tree_polynomial_ode_ok(S),
    }


def def51(n, Mdict, ddict, Vdict, s, i):
    num = F(n - Mdict[i])
    den = F(n - Mdict[s] - 1)
    if den == 0:
        return None
    for j in range(i + 1, s + 1):

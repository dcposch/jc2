   792	def unique_row(rows, predicate, label):
   793	    matches = [row for row in rows if predicate(row)]
   794	    if len(matches) != 1:
   795	        raise AssertionError(f"{label}: expected one row, got {len(matches)}")
   796	    return matches[0]

def group_key(S):
    return (S.n, S.m, tuple(S.M[i] for i in range(2, S.s + 1)), S.V[S.s])


def m_list(S):
    return [S.M[i] for i in range(2, S.s + 1)]


def v_map(S):
    return {i: S.V[i] for i in range(2, S.s + 1)}


def u_s_of(S) -> int:
    return S.d[S.s] - S.V[S.s]


def screens(S):

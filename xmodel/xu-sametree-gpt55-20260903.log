   748	def stats(rows, ok_field):
   749	    by_group = defaultdict(list)
   750	    for row in rows:
   751	        by_group[row["group_key"]].append(row)
   752	    killed_rows = [row for row in rows if not row[ok_field]]
   753	    killed_groups = {
   754	        key: items for key, items in by_group.items()
   755	        if all(not row[ok_field] for row in items)
   756	    }
   757	    touched_groups = {
   758	        key: items for key, items in by_group.items()
   759	        if any(not row[ok_field] for row in items)
   760	    }
   761	    return {
   762	        "rows": len(rows),
   763	        "groups": len(by_group),
   764	        "killed_rows": len(killed_rows),
   765	        "killed_groups": len(killed_groups),
   766	        "touched_groups": len(touched_groups),
   767	    }
   768	
   769	
   770	def killed_groups(rows, ok_field):
   771	    by_group = defaultdict(list)
   772	    for row in rows:
   773	        by_group[row["group_key"]].append(row)
   774	    return {
   775	        key: items for key, items in by_group.items()
   776	        if all(not row[ok_field] for row in items)
   777	    }

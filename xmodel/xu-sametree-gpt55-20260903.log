+        key: items for key, items in by_group.items()
+        if all(not row[ok_field] for row in items)
+    }
+
+
+def compact(row):
+    keys = (
+        "n", "m", "M", "V", "V_s", "u_s",
+        "independent_IM_max", "independent_Im_min",

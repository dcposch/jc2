+        rec.update(jsonable(ev))
+        if rec["tree_status"] == "OK":
+            if not rec["same_tree_c53_ok"]:
+                rec["all_killer"] = "Corollary 5.3 / Theorem 4.7(ii)"
+            elif not rec["same_tree_all_ok"]:

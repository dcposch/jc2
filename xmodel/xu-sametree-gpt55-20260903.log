+
+def frac_text(x):
+    if x is None:
+        return None
+    if isinstance(x, F):
+        return str(x.numerator) if x.denominator == 1 else f"{x.numerator}/{x.denominator}"
+    return str(x)
+
+
+def parse_frac(text):
+    return F(text)
+
+
+def m_list(S):
+    return [S.M[i] for i in range(2, S.s + 1)]
+
+
+def v_map(S):
+    return {str(i): S.V[i] for i in range(2, S.s + 1)}
+
+
+def row_key(S):

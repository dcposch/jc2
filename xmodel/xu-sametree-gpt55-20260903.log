            "Im_min_promoted": im_floor_promoted,
            "Im_min_candidate": im_floor_candidate,
            "tree_minor_min": tree.im_min,
            "principal_minor_floor_promoted": principal_promoted,
            "principal_minor_floor_candidate": principal_candidate,
            "xu_ok_promoted": tree.im_max >= im_floor_promoted,
            "xu_ok_candidate": tree.im_max >= im_floor_candidate,
            "IM_witness": tree.imax_witness,
            "Im_witness": tree.im_witness,
        }



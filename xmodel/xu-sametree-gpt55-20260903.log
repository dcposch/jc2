   226	
   227	class SameTree:
   228	    """Exact metric DP over the finite operative tree model."""
   229	
   230	    def __init__(self, S):
   231	        self.S = S
   232	        self.E = FT.evaluator(S, polynomial_recenter=True, ode_nondegenerate=True)
   233	        self.required = {i: S.V[i] for i in range(2, S.s)}
   234	        self.stats = {
   235	            "pair_global_nodes": 0,
   236	            "pair_embed_nodes": 0,
   237	            "scalar_global_nodes": 0,
   238	            "scalar_embed_nodes": 0,
   239	            "plans": 0,
   240	            "max_frontier": 0,
   241	            "bottom_mismatch": 0,
   242	        }
   243	
   244	    def principal(self) -> PrincipalMetrics:
   245	        S = self.S
   246	        us = u_s_of(S)
   247	        roots = F(us * S.m, S.d[S.s])
   248	        delta = F(S.V[S.s], us)
   249	        im = positive_part(delta - 1)
   250	        weighted = (roots - 1) * im if roots >= 1 else F(0)
   251	        intersection = roots * delta
   252	        return PrincipalMetrics(roots, delta, im, weighted, intersection)
   253	
   254	    def node_root_count(self, j, path):
   255	        return F(path[j + 1] * self.S.m, self.S.d[j + 1])
   256	
   257	    def child_root_count(self, j, value):
   258	        return F(value * self.S.m, self.S.d[j])
   259	
   260	    def minor_delta(self, j, path, value, Sout_c):
   261	        by_distance = Sout_c / self.child_root_count(j, value)
   262	        delta, _L, _A, _P, _Q, lo = self.E.level_data(j, path)
   263	        by_formula = delta + lo * (1 - delta) / value
   264	        if by_distance != by_formula:
   265	            raise AssertionError(
   266	                f"minor delta mismatch {self.S.n},{self.S.m}, j={j}, v={value}: "
   267	                f"{by_distance} != {by_formula}"
   268	            )
   269	        return by_distance
   270	
   271	    def terminal_minor_pair(self, j, path, value, orbit, Sout_c):
   272	        roots = self.child_root_count(j, value)
   273	        delta = self.minor_delta(j, path, value, Sout_c)
   274	        im = positive_part(delta - 1)
   275	        weighted = (roots - 1) * im if im > 0 else F(0)
   276	        intersection = roots * delta
   277	        return ((-orbit * im, orbit * (weighted - intersection)),)
   278	
   279	    def terminal_minor_scalar(self, j, path, value, orbit, Sout_c, mode):
   280	        if mode == "IM_MAX":
   281	            return F(0)
   282	        delta = self.minor_delta(j, path, value, Sout_c)
   283	        im = orbit * positive_part(delta - 1)
   284	        if mode == "DIFF_MAX":
   285	            return -im
   286	        return im
   287	
   288	    def terminal_major_pair(self, j, path, value, orbit, Sout_c):
   289	        newpath = self.E.extend(path, j, value)
   290	        ok, _wit = self.E.bottom(newpath)
   291	        if not ok:
   292	            return ()
   293	        roots = self.child_root_count(j, value)
   294	        delta1 = self.E.radius(1, newpath)
   295	        lambda_neg = F(self.S.n, self.S.m + self.S.n) * (1 - delta1)
   296	        IM = roots * lambda_neg
   297	        S_by_leaf = 1 - lambda_neg
   298	        S_by_dist = Sout_c - (roots - 1) * delta1
   299	        if S_by_leaf != S_by_dist:
   300	            self.stats["bottom_mismatch"] += 1
   301	            raise AssertionError(
   302	                f"bottom S mismatch {self.S.n},{self.S.m}, v={value}: "
   303	                f"{S_by_leaf} != {S_by_dist}"
   304	            )
   305	        intersection = roots * S_by_leaf
   306	        return ((orbit * IM, -orbit * intersection),)
   307	
   308	    def terminal_major_scalar(self, j, path, value, orbit, _Sout_c, mode):
   309	        newpath = self.E.extend(path, j, value)
   310	        ok, _wit = self.E.bottom(newpath)
   311	        if not ok:
   312	            return None
   313	        if mode == "IM_MIN":
   314	            return F(0)
   315	        roots = self.child_root_count(j, value)
   316	        delta1 = self.E.radius(1, newpath)
   317	        return orbit * roots * F(self.S.n, self.S.m + self.S.n) * (1 - delta1)
   318	
   319	    def child_newdanger(self, j, path, is_zero, dangerous):
   320	        delta_j = self.E.radius(j, path)
   321	        removable_nonzero = delta_j.denominator == 1 and delta_j <= 0
   322	        return dangerous and (is_zero or removable_nonzero)
   323	
   324	    @lru_cache(maxsize=None)
   325	    def plans(self, j, path, embed):
   326	        """Return finite split plans at a node.
   327	
   328	        A plan is (children, selected_index), with selected_index None for
   329	        global plans.  Each child is (value, orbit_size, is_zero, is_major).
   330	        """
   331	        self.stats["plans"] += 1
   332	        delta, _L, A, P, Q, lo = self.E.level_data(j, path)
   333	        residue = P % A
   334	        out = []
   335	        for b in range(residue, P + 1, A):
   336	            if b > 0 and P - Q * b == 0:
   337	                continue
   338	            total = (P - b) // A
   339	            max_orbits = Q // A
   340	            for coins in partitions(total, max_orbits):
   341	                if any(P - Q * v == 0 for v in coins):
   342	                    continue
   343	                children = []
   344	                if b > 0:
   345	                    children.append((b, 1, True, b > lo))
   346	                for v in coins:
   347	                    children.append((v, A, False, v > lo))
   348	                if not any(child[3] for child in children):
   349	                    continue
   350	                if not embed:
   351	                    out.append((tuple(children), None))
   352	                    continue
   353	                vreq = self.required[j]
   354	                selected = []
   355	                if children and children[0][2] and children[0][0] == vreq and children[0][3]:
   356	                    selected.append(0)
   357	                first_nonzero = None
   358	                for idx, child in enumerate(children):
   359	                    value, _orbit, is_zero, is_major = child
   360	                    if not is_zero and is_major and value == vreq:
   380	            return scale_frontier(self.embed_pair(j - 1, newpath, newdanger, Sout_c), orbit)
   381	        return scale_frontier(self.global_pair(j - 1, newpath, newdanger, Sout_c), orbit)
   382	
   383	    def child_scalar(self, j, path, dangerous, Sout_c, child, embed_child, mode):
   384	        value, orbit, is_zero, is_major = child
   385	        if not is_major:
   386	            return self.terminal_minor_scalar(j, path, value, orbit, Sout_c, mode)
   387	        newdanger = self.child_newdanger(j, path, is_zero, dangerous)
   388	        if j == 2:
   389	            if newdanger:
   390	                return None
   391	            return self.terminal_major_scalar(j, path, value, orbit, Sout_c, mode)
   392	        newpath = self.E.extend(path, j, value)
   393	        if embed_child:
   394	            score = self.embed_scalar(j - 1, newpath, newdanger, Sout_c, mode)
   395	        else:
   396	            score = self.global_scalar(j - 1, newpath, newdanger, Sout_c, mode)
   397	        if score is None:
   398	            return None
   399	        return orbit * score
   400	
   401	    def scalar_child_by_value(self, j, path, dangerous, Sout, value, orbit, is_zero, embed_child, mode):
   402	        delta, _L, _A, _P, _Q, lo = self.E.level_data(j, path)
   403	        Nj = self.node_root_count(j, path)
   404	        Nc = self.child_root_count(j, value)
   405	        Sout_c = Sout - (Nj - Nc) * delta
   406	        child = (value, orbit, is_zero, value > lo)
   407	        return self.child_scalar(j, path, dangerous, Sout_c, child, embed_child, mode)
   408	
   409	    @staticmethod
   410	    def multiset_scalar(total, max_coins, options, initial_major, mode):
   411	        opt = tuple(sorted(options, key=lambda item: item[0]))
   412	
   413	        @lru_cache(maxsize=None)
   414	        def visit(remainder, coins_left, start, has_major):
   415	            if remainder == 0:
   416	                return F(0) if has_major else None
   417	            if coins_left == 0:
   418	                return None
   419	            best = None
   420	            for idx in range(start, len(opt)):
   421	                value, is_major, score = opt[idx]
   422	                if value > remainder:
   423	                    break
   424	                tail = visit(remainder - value, coins_left - 1, idx, has_major or is_major)
   425	                if tail is None:
   426	                    continue
   427	                candidate = score + tail
   428	                if best is None:
   429	                    best = candidate
   430	                elif mode in ("IM_MAX", "DIFF_MAX") and candidate > best:
   431	                    best = candidate
   432	                elif mode == "IM_MIN" and candidate < best:
   433	                    best = candidate
   434	            return best
   435	
   436	        return visit(total, max_coins, 0, initial_major)
   437	
   438	    def scalar_options(self, j, path, dangerous, Sout, total, A, P, Q, mode):
   439	        out = []
   440	        for value in range(1, total + 1):
   441	            if P - Q * value == 0:
   442	                continue
   443	            score = self.scalar_child_by_value(
   444	                j, path, dangerous, Sout, value, A, False, False, mode
   445	            )
   446	            if score is None:
   447	                continue
   448	            delta, _L, _A, _P, _Q, lo = self.E.level_data(j, path)
   449	            out.append((value, value > lo, score))
   450	        return out
   451	
   452	    def option_scalar(self, j, path, dangerous, Sout, b, selected_mode, mode):
   453	        delta, _L, A, P, Q, lo = self.E.level_data(j, path)
   454	        if b > 0 and P - Q * b == 0:
   455	            return None
   456	        total = (P - b) // A
   457	        max_orbits = Q // A
   458	        zero_score = F(0)
   459	        zero_major = b > lo if b > 0 else False
   460	        if b > 0:
   461	            if zero_major:
   462	                zero_score = self.scalar_child_by_value(
   463	                    j, path, dangerous, Sout, b, 1, True, selected_mode == "zero", mode
   464	                )
   465	                if zero_score is None:
   466	                    return None
   467	            else:
   468	                if selected_mode == "zero":
   469	                    return None
   470	                zero_score = self.scalar_child_by_value(
   471	                    j, path, dangerous, Sout, b, 1, True, False, mode
   472	                )
   473	                if zero_score is None:
   474	                    return None
   475	
   476	        rest_total = total
   477	        rest_max = max_orbits
   478	        initial_major = zero_major
   479	        forced_score = F(0)
   480	        if selected_mode == "zero":
   481	            vreq = self.required[j]
   482	            if b != vreq or not zero_major:
   483	                return None
   484	            initial_major = True
   485	        elif selected_mode == "nonzero":
   486	            vreq = self.required[j]
   487	            if not (vreq > lo and rest_total >= vreq and rest_max >= 1):
   488	                return None
   489	            if P - Q * vreq == 0:
   490	                return None
   491	            forced_score = self.scalar_child_by_value(
   492	                j, path, dangerous, Sout, vreq, A, False, True, mode
   493	            )
   494	            if forced_score is None:
   495	                return None
   496	            rest_total -= vreq
   497	            rest_max -= 1
   498	            initial_major = True
   499	
   500	        options = self.scalar_options(j, path, dangerous, Sout, total, A, P, Q, mode)
   501	        rest = self.multiset_scalar(rest_total, rest_max, options, initial_major, mode)
   502	        if rest is None:
   503	            return None
   504	        return zero_score + forced_score + rest

import json

def rank_mod(a,p):
    a=[[(x%p) for x in row] for row in a]
    r=0
    for c in range(len(a[0])):
        q=next((i for i in range(r,len(a)) if a[i][c]),None)
        if q is None: continue
        a[r],a[q]=a[q],a[r]
        z=pow(a[r][c],p-2,p)
        a[r]=[(x*z)%p for x in a[r]]
        for i in range(len(a)):
            if i"'!=r and a[i][c]:
                z=a[i][c]; a[i]=[(x-z*y)%p for x,y in zip(a[i],a[r])]
        r+=1
    return r

roots={105337:795,105673:14686}
for p,s in roots.items():
    i2=pow(2,-1,p); i3=pow(3,-1,p); i6=pow(6,-1,p)
    r=0; b=2*i3%p; a=(i2+s*i6)%p; c=(i2-s*i6)%p
    E3=(2*a-3*b+2*c-r)%p
    E2=(-a*a-4*a*c+3*b*b+3*b*r-c*c)%p
    J=[[-1,-3,2,2],[2,4,(-3+s*i3)%p,(-3-s*i3)%p]]
    gauges=[[1,1,1,1],[0,b,a,c]]
    print({'"'p':p,'sqrt3':s,'sqrt3_sq':s*s%p,'marks':(r,b,a,c),'E':(E3,E2),'rank_JH':rank_mod(J,p),'rank_gauge':rank_mod(gauges,p)})

for p in (105337,105673):
    x=json.load(open(f'cases/d23_atlas_p{p}.json'))
    vals=list(x['fibers'].values())
    print({'p':p,'D21_dims':sorted(set(v['d21_fiber']['dim'] for v in vals)),
           'D23_dims':sorted(set(v['det23']['dim'] for v in vals)),
           'nonempty':sum(v['verdict']=='NONEMPTY' for v in vals),
           'schur_rank10':sorted(set(v['schur_rankC10'] for v in vals)),
           'rankC':sorted(set(v['rankC'] for v in vals)),
           'cond_dim':sorted(set(v['cond_dim'] for v in vals)),
           'nf_rank':sorted(set(v['nf_rank'] for v in vals)),
           'kernel_dim':sorted(set(v['kernel_dim'] for v in vals))})
x=json.load(open('cases/d25_certificate_replay.json'))
for p in ('105337','105673'):
    vals=list(x['parked_fibers'][p].values())
    print({'p':int(p),'D25_dims':sorted(set(v['derived_dimension'] for v in vals)),
           'components':sorted(set(v['derived_components'] for v in vals)),
           'rankA_Ab':sorted(set((v['rank_A'],v['rank_Ab']) for v in vals)),
           'base_free':sorted(set(len(v['free_base_vars']) for v in vals)),
           'lift_free':sorted(set(len(v['free_lift_vars']) for v in vals)),
           'closure34':sum(v['closure_rows_zero']==34 for v in vals),
           'n_fibers':len(vals)})

+\[
+ \operatorname{rank}C_{10}=4,
+ \quad \operatorname{rank}C_{+m lift}=2,
+ \quad \operatorname{rank}({\rm NF})=5,
+ \quad \dim\ker({\rm NF})=1.
+ \tag{3.4}
+\]

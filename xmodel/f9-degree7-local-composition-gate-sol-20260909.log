    R_s|s=0=K,
    [A_s,B_s]_(a,b)=2c*s^51*a³, c!=0,
    A_s=R_s³+alpha*s^14*R_s+a0*s^21+F,
    B_s=R_s^5+sum_(i=0)^4 b_i*s^(35-7i)*R_s^i+q_s(R_s)*F+G,
    q_s(z)=(5/3)z²+(4/3)b4*s^7*z+(b3-5alpha/9)*s^14,
    j=ord_s F>=1, ord_s G>=2j.


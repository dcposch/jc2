import json
from itertools import product

def exps(W,d,i=0):
 if i==len(W)-1:
  if d%W[i]==0: yield (d//W[i],)
  return
 for a in range(d//W[i]+1):
  for tail in exps(W,d-a*W[i],i+1):yield (a,)+tail

def seg_pures(t,H,maxa=100):
 W=[*range(1,t),t+1]; ans=[]
 for i,w in enumerate(W):
  for a in range(1,maxa+1):
   d=a*w; mons=list(exps(W,d)); h=H[d] if d<len(H) else 0
   # key reversed exponent tuple; ascending is greatest to smallest
   mons.sort(key=lambda e:tuple(reversed(e)))
   target=tuple(a if j==i else 0 for j in range(t))
   idx=mons.index(target) # number greater
   killed=idx < len(mons)-h
   if killed:
    ans.append(a);break
  else:ans.append(None)
 return ans

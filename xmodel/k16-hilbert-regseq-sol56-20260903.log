   464	def normalizers(t: int, field) -> dict[str, object]:
   465	    q, e = 2 * t + 1, 3 * t + 1
   466	    y = field.y()
   467	    g1 = field.from_fraction(Fraction(e, q))
   468	    g2 = field.add(
   469	        field.scale(y, Fraction(e, q)),
   470	        field.from_fraction(Fraction(e * t, 2 * q * q)),
   471	    )
   472	    g = field.add(
   473	        field.scale(y, Fraction(e * t, q * q)),
   474	        field.from_fraction(Fraction(-e * t * (t + 1), 6 * q**3)),
   475	    )
   476	    c = field.neg(field.mul(y, g))
   477	    return {"g1": g1, "g2": g2, "g": g, "c": c}

diff --git a/xmodel/k16-hilbert-regseq-sol56-20260903.md b/xmodel/k16-hilbert-regseq-sol56-20260903.md
new file mode 100644
index 0000000000000000000000000000000000000000..f4f2ac7cd07bd6db1479eed22351066aa9c57a53

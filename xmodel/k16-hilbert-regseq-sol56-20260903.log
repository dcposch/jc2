   497	def shift_to_l(
   498	    coefficients: dict[int, dict[tuple[int, ...], object]],
   499	    b4_index: int,
   500	    maximum: int,
   501	    ring: SparseRing,
   502	):
   503	    answer = [ring.zero() for _ in range(maximum + 1)]
   504	    for exponent, coefficient in coefficients.items():
   505	        if not coefficient:
   506	            continue
   507	        for degree in range(exponent + 1):
   508	            scalar = ring.field.from_int(math.comb(exponent, degree))
   509	            term = ring.mul_var_power(coefficient, b4_index, exponent - degree, scalar)
   510	            ring.add_to(answer[degree], term)
   511	    return answer

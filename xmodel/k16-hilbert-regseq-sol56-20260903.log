     1	#!/usr/bin/env python3
     2	"""Emit and optionally run the Laurent/Euler terminal recurrence in Singular.
     3	
     4	The generated calculation is the fixed-integer specialization of the indexed
     5	recurrence in the accompanying report.  It never divides in the rank-two
     6	algebra at a split index: ``--mode split-exact`` and ``--mode mod`` specialize
     7	``y`` first and run one product factor at a time.
     8	
     9	The terminal polynomials printed by the frozen discovery driver are ``-E``.
    10	Here ``T[k]`` is defined with the sign in the question, namely ``+E``.
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import argparse
    16	import hashlib
    17	import json
    18	import math
    19	import pathlib
    20	import re
    21	import subprocess
    22	import time
    23	
    24	import sympy as sp
    25	
    26	
    27	HERE = pathlib.Path(__file__).resolve().parent
    28	
    29	
    30	def h_polynomial(t: int, yy: sp.Symbol) -> sp.Expr:
    31	    q = 2 * t + 1
    32	    return sp.expand(12 * q * q * yy**2 - 12 * q * (t + 1) * yy
    33	                     + (t + 1) * (3 * t + 2))
    34	
    35	
    36	def modular_roots(t: int, prime: int) -> list[int]:
    37	    yy = sp.Symbol("yy")
    38	    poly = sp.Poly(h_polynomial(t, yy), yy, modulus=prime)
    39	    roots = sorted({int(root) % prime for root in range(prime)
    40	                    if int(poly.eval(root)) % prime == 0})
    41	    if len(roots) != 2:
    42	        raise ValueError(f"H_{t} has {len(roots)} distinct roots modulo {prime}")
    43	    return roots
    44	
    45	
    46	def split_roots(t: int) -> list[sp.Rational]:
    47	    quotient, remainder = divmod(t + 1, 3)
    48	    root = math.isqrt(quotient)
    49	    if remainder or root * root != quotient:
    50	        raise ValueError(f"t={t} is not of the form 3*s^2-1")
    51	    q = 2 * t + 1
    52	    return sorted({sp.Rational(t + 1 - root, 2 * q),
    53	                   sp.Rational(t + 1 + root, 2 * q)})
    54	
    55	
    56	def singular_rational(value: sp.Rational) -> str:
    57	    return f"({int(value.p)}/{int(value.q)})"
    58	
    59	
    60	def ring_header(t: int, mode: str, prime: int | None,
    61	                branch: int | None, variables: list[str]) -> tuple[list[str], str]:
    62	    yy = sp.Symbol("yy")
    63	    H = h_polynomial(t, yy)
    64	    if mode == "exact":
    65	        if not sp.Poly(H, yy, domain=sp.QQ).is_irreducible:
    66	            raise ValueError("exact algebraic mode requires irreducible H_t")
    67	        lines = [f"ring R=(0,yy),({','.join(variables)}),dp;",
    68	                 f"minpoly={str(H).replace('**', '^')};"]
    69	        return lines, "Q[y]/(H_t)"
    70	    if branch not in (0, 1):
    71	        raise ValueError("a branch index 0 or 1 is required")
    72	    if mode == "split-exact":
    73	        value = split_roots(t)[branch]
    74	        lines = [f"ring R=0,({','.join(variables)}),dp;",
    75	                 f"number yy={singular_rational(value)};"]
    76	        return lines, f"Q, y={value}"
    77	    if mode == "mod":
    78	        if prime is None or prime <= 2:
    79	            raise ValueError("--prime is required in modular mode")
    80	        value = modular_roots(t, prime)[branch]
    81	        lines = [f"ring R={prime},({','.join(variables)}),dp;",
    82	                 f"number yy={value};"]
    83	        return lines, f"F_{prime}, y={value}"
    84	    raise ValueError(mode)
    85	
    86	
    87	def chart_ring_header(t: int, mode: str, prime: int | None,
    88	                      branch: int | None, variables: list[str]) -> list[str]:
    89	    lines, _description = ring_header(t, mode, prime, branch, variables)
    90	    return [line.replace("ring R=", "ring C=", 1) for line in lines]
    91	
    92	
    93	def emit(t: int, mode: str, prime: int | None, branch: int | None,
    94	         charts: str, algorithm: str, compare_record: pathlib.Path | None,
    95	         dump_rows: bool, specialize_b4: int | None) -> tuple[str, dict[str, object]]:
    96	    if t < 2:
    97	        raise ValueError("the stable Laurent/Euler recurrence starts at t=2")
    98	    if algorithm not in ("std", "slimgb", "modstd"):
    99	        raise ValueError(algorithm)
   100	    basis = (lambda ideal: f"modStd({ideal},1)" if algorithm == "modstd"
   101	             else f"{algorithm}({ideal})")
   102	    q, e, N = 2 * t + 1, 3 * t + 1, 4 * t + 1
   103	    cvars = [f"C{j}" for j in range(1, t)]
   104	    qvars = [f"q{j}_0" for j in range(2, 2 * t + 1)]
   105	    residual = ["b3"] + [f"q{j}_0" for j in range(2, t)]
   106	    variables = ["h", "s", "b1", "b2", "b3", "b4", "B0"] + cvars + qvars
   107	    header, coefficient_algebra = ring_header(t, mode, prime, branch, variables)
   108	    lines: list[str] = [

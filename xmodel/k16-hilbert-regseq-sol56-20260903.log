   157	        "poly numD1=yy*g3*b1-Q1*diff(Y,s)+diff(Q1,s)*Y+2*diff(U,s)*Z;",
   158	        "poly constantS=subst(numD1,s,0);",
   159	        "poly pb1=diff(constantS,b1);",
   160	        "poly b1rhs=-subst(constantS,b1,0)/pb1;",
   161	        "numD1=subst(numD1,b1,b1rhs);",
   162	        "if (subst(numD1,s,0)!=0) { print(\"FAIL b1 divisibility\"); exit(2); }",
   163	        "poly Xprime=numD1/(2*yy*s);",
   164	        f"poly gauge=hcoef(subst(Xprime,s,h-{b4_image}),{q-1});",
   165	        "poly pB0=diff(gauge,B0);",
   166	        "poly B0rhs=-subst(gauge,B0,0)/pB0;",
   167	        "B=subst(B,B0,B0rhs);",
   168	        "D=subst(D,B0,B0rhs);",
   169	        "Y=subst(Y,B0,B0rhs);",
   170	        "Z=subst(Z,B0,B0rhs);",
   171	        "Xprime=subst(Xprime,B0,B0rhs);",
   172	        "b1rhs=subst(b1rhs,B0,B0rhs);",
   173	        "if (subst(gauge,B0,B0rhs)!=0) { print(\"FAIL B0 gauge\"); exit(2); }",
   174	        "// RR is -E.  The requested terminal row is T[k]=-hcoef(RR,h,k).",
   175	        "poly RR=Q1*Xprime-diff(U,s)*Y-yy*g3;",
   176	        f"poly Rh=subst(RR,s,h-{b4_image});",

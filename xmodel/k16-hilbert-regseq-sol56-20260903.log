    51	        return value.numerator % self.prime * pow(value.denominator, -1, self.prime) % self.prime
    52	
    53	    def y(self) -> int:
    54	        return self.y_value
    55	
    56	    def add(self, left: int, right: int) -> int:
    57	        return (left + right) % self.prime
    58	
    59	    def neg(self, value: int) -> int:
    60	        return (-value) % self.prime
    61	
    62	    def sub(self, left: int, right: int) -> int:

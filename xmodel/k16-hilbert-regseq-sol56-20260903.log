   596	    pp = [
   597	        ring.scalar_mul(nn[degree + 1], ring.field.inv(ring.field.scale(y, 2)))
   598	        for degree in range(e)
   599	    ]
   600	
   601	    rr = [ring.zero() for _ in range(top + 1)]

   781	def validate_modular_points(t: int, prime: int, branch: int, ring: SparseRing, rows, checks: int) -> list[dict[str, object]]:
   782	    if checks <= 0:
   783	        return []
   784	    roots = modular_roots(t, prime)
   785	    y = roots[branch]
   786	    rng = random.Random(9303 + 1000 * t + 10 * prime + branch)
   787	    validations = []
   788	    variables = ["b4"] + [f"q{j}_0" for j in range(2, t)] + ["b3"]
   789	    for check_index in range(checks):
   790	        b4 = rng.randrange(prime)
   791	        residual = {j: rng.randrange(prime) for j in range(2, t)}
   792	        b3 = rng.randrange(prime)
   793	        values = [b4] + [residual[j] for j in range(2, t)] + [b3]
   794	        polynomial_values = [ring.evaluate_mod(row, values, prime) for row in rows]
   795	        point_values, _pivots = point_model.terminal_values(t, prime, y, b3, b4, residual)
   796	        if polynomial_values != point_values:
   797	            raise AssertionError(
   798	                {
   799	                    "t": t,
   800	                    "prime": prime,
   801	                    "branch": branch,
   802	                    "check": check_index,
   803	                    "variables": dict(zip(variables, values)),
   804	                    "polynomial": polynomial_values,
   805	                    "point": point_values,
   806	                }
   807	            )
   808	        validations.append(
   809	            {
   810	                "check": check_index,
   811	                "digest": sum((index + 1) * value for index, value in enumerate(polynomial_values)) % prime,
   812	            }
   813	        )
   814	    return validations

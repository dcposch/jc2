   484	def convolution_l(
   485	    left: list[dict[tuple[int, ...], object]],
   486	    right: list[dict[tuple[int, ...], object]],
   487	    degree: int,
   488	    ring: SparseRing,
   489	):
   490	    answer = ring.zero()
   491	    for index in range(degree + 1):
   492	        if index < len(left) and degree - index < len(right):
   493	            ring.add_to(answer, ring.mul(left[index], right[degree - index]))
   494	    return answer

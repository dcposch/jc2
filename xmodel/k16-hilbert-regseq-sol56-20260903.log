diff --git a/box/k16hilb-20260903/emit_legacy_lead_hilb.py b/box/k16hilb-20260903/emit_legacy_lead_hilb.py
new file mode 100644
index 0000000000000000000000000000000000000000..d01f30bddf0d5d73ecc6dd3959d4da4c548a8cc7
--- /dev/null

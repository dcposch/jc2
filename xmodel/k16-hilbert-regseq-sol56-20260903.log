   111	        *header,
   112	        "option(redSB);",
   113	        *( ["LIB \"modstd.lib\";"] if algorithm == "modstd" else [] ),
   114	        "proc hcoef(poly f, int k)",
   115	        "{",
   116	        "  matrix M=coef(f,h);",
   117	        "  int ii;",
   118	        "  for (ii=1; ii<=ncols(M); ii++)",
   119	        "  { if (M[1,ii]==h^k) { return(M[2,ii]); } }",
   120	        "  return(0);",
   121	        "}",
   122	        "proc eulerInverse(poly f)",
   123	        "{",
   124	        "  matrix M=coef(f,s);",
   125	        "  poly answer=0; int ii; int mm;",
   126	        "  for (ii=1; ii<=ncols(M); ii++)",
   127	        "  { mm=deg(M[1,ii]); answer=answer+M[2,ii]*M[1,ii]/((2*mm+1)*yy); }",
   128	        "  return(answer);",
   129	        "}",
   130	        f"number g1={e}/{q};",
   131	        f"number g2=({e}/{q})*yy+({e*t}/{2*q*q});",
   132	        f"number g3=({e*t}/{q*q})*yy-({e*t*(t+1)}/{6*q**3});",
   133	        "number cc=-yy*g3;",
   134	    ]
   135	    b4_image = "b4" if specialize_b4 is None else str(specialize_b4)
   136	    U_terms = [f"h^{q}"] + [f"q{j}_0*h^{q-j}" for j in range(2, 2*t + 1)]
   137	    C_terms = [f"h^{t-1}"] + [f"C{j}*h^{t-1-j}" for j in range(1, t)]
   138	    lines += [
   139	        "poly Uh=" + "+".join(U_terms) + ";",
   140	        "poly Ch=" + "+".join(C_terms) + ";",
   141	        f"poly U=subst(Uh,h,s+{b4_image});",
   142	        f"poly Cp=subst(Ch,h,s+{b4_image});",
   143	        "poly A=s*Cp;",
   144	        "poly Bprime=g3*(5*Cp+3*s*diff(Cp,s))/(2*yy);",
   145	        "matrix MB=coef(Bprime,s);",
   146	        "poly B=B0; int ii; int mm;",
   147	        "for (ii=1; ii<=ncols(MB); ii++)",
   148	        "{ mm=deg(MB[1,ii]); B=B+MB[2,ii]*s*MB[1,ii]/(mm+1); }",
   149	        "if (diff(B,s)-Bprime!=0) { print(\"FAIL B derivative\"); exit(2); }",
   150	        "poly rhsD=3*g3*diff(U,s)+A*B-s*A*diff(B,s)+2*s*diff(A,s)*B",
   151	        "          +g3*b3*(A/s+(5/2)*diff(A,s));",
   152	        "poly D=eulerInverse(rhsD);",
   153	        "if (yy*(D+2*s*diff(D,s))-rhsD!=0) { print(\"FAIL Euler inverse\"); exit(2); }",
   154	        "poly Q1=s*A-yy*b3;",
   155	        "poly Y=s*D-b3*B-g3*b2;",

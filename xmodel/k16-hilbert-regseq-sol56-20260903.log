   673	def make_field(t: int, mode: str, prime: int | None, branch: int | None):
   674	    if mode == "mod":
   675	        if prime is None or branch is None:
   676	            raise ValueError("mod mode requires --prime and --branch")
   677	        roots = modular_roots(t, prime)
   678	        return ModField(prime, roots[branch]), roots[branch]
   679	    if mode == "split-exact":
   680	        if branch is None:
   681	            raise ValueError("split-exact mode requires --branch")
   682	        roots = split_roots(t)
   683	        return RationalField(Fraction(int(roots[branch].p), int(roots[branch].q))), roots[branch]
   684	    if mode == "exact":
   685	        return QuadraticField(t), None
   686	    raise ValueError(mode)

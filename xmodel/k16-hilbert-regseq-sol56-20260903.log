   622	def terminal_polynomials(t: int, field):
   623	    top = 4 * t + 1
   624	    weights = [1] + list(range(2, t)) + [t + 1]
   625	    solved_c: dict[int, dict[tuple[int, ...], object]] = {}
   626	    solved_u: dict[int, dict[tuple[int, ...], object]] = {}
   627	    solved_b2: dict[tuple[int, ...], object] = {}
   628	    pivot_terms = []
   629	    for weight in range(1, 2 * t + 2):
   630	        ring = SparseRing(field, weights, weight)
   631	        _rr, rx = l_arrays(t, ring, solved_c, solved_u, solved_b2)
   632	        rho = rx[top - weight]
   633	        pivot = closed_pivot(t, weight, field)
   634	        rhs = ring.scalar_mul(rho, field.neg(field.inv(pivot)))
   635	        degrees = ring.weighted_degrees(rhs)
   636	        if degrees and degrees != [weight]:
   637	            raise AssertionError({"weight": weight, "degrees": degrees})
   638	        if weight < t:
   639	            solved_c[weight] = rhs
   640	            variable = f"C{weight}"
   641	        elif weight <= 2 * t:
   642	            solved_u[weight] = rhs
   643	            variable = f"q{weight}_0"
   644	        else:
   645	            solved_b2 = rhs
   646	            variable = "b2"
   647	        pivot_terms.append(
   648	            {
   649	                "weight": weight,
   650	                "variable": variable,
   651	                "terms": len(rhs),
   652	                "pivot": field.digest_text(pivot),
   653	            }
   654	        )
   655	
   656	    final_ring = SparseRing(field, weights, top)
   657	    _rr, rx = l_arrays(t, final_ring, solved_c, solved_u, solved_b2)
   658	    high_nonzero = [degree for degree in range(2 * t, top + 1) if rx[degree]]
   659	    if high_nonzero:
   660	        raise AssertionError(f"nonzero high X bands after solve: {high_nonzero}")
   661	    rows = [final_ring.neg(rx[degree]) for degree in range(2 * t)]
   662	    for degree, row in enumerate(rows):
   663	        degrees = final_ring.weighted_degrees(row)
   664	        if degree == 0:
   665	            allowed = {0, top}
   666	            if not set(degrees).issubset(allowed):
   667	                raise AssertionError({"band": degree, "degrees": degrees})
   668	        elif degrees and degrees != [top - degree]:
   669	            raise AssertionError({"band": degree, "degrees": degrees, "expected": top - degree})
   670	    return final_ring, rows, pivot_terms

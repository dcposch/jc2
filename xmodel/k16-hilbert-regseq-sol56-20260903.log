   249	
   250	    def weight(self, exp: tuple[int, ...]) -> int:
   251	        cached = self._weight_cache.get(exp)
   252	        if cached is not None:
   253	            return cached
   254	        value = sum(power * weight for power, weight in zip(exp, self.weights))
   255	        self._weight_cache[exp] = value

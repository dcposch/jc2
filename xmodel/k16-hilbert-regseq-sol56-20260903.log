+    199,230,262,296,330,365,399,431,460,485,504,516,519,512,493,
+    460,413,349,269,170,54]
+
+P7=[1,1,2,3,5,7,11,14,21,27,37,47,63,78,101,124,156,188,232,
+    275,333,390,462,534,624,710,816,917,1037,1150,1282,1400,1537,

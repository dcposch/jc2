   178	    elimination = cvars + [f"q{j}_0" for j in range(t, 2*t + 1)] + ["b2"]
   179	    pivot_rows: list[dict[str, object]] = []
   180	    for weight, variable in enumerate(elimination, start=1):
   181	        band = N - weight
   182	        lines += [
   183	            f"poly W{weight}=hcoef(Rh,{band});",
   184	            f"poly p{weight}=diff(W{weight},{variable});",

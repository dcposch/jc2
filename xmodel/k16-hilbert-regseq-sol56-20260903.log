   324	                "timeout_seconds": args.timeout,
   325	                "elapsed_seconds": time.monotonic() - started,
   326	            })
   327	            stdout = exc.stdout or ""
   328	            stderr = exc.stderr or ""
   329	            if isinstance(stdout, bytes):
   330	                stdout = stdout.decode("utf-8", errors="replace")
   331	            if isinstance(stderr, bytes):

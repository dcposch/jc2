+def singular_hilbert_vector(numerator: tuple[int, ...]) -> tuple[int, ...]:
+    """Attach Singular's non-series bookkeeping entry to a first Hilbert series.
+
+    ``hilb(G,1,WTS)`` prints the numerator coefficients followed by one entry

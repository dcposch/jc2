   186	            f"if (subst(W{weight},{variable},v{weight}rhs)!=0) "
   187	            f"{{ print(\"FAIL pivot {weight}\"); exit(2); }}",
   188	            f"Rh=subst(Rh,{variable},v{weight}rhs);",
   189	            f"print(\"PIVOT weight={weight} band={band} variable={variable}\"); p{weight};",
   190	        ]
   191	        pivot_rows.append({"weight": weight, "band": band, "variable": variable})
   192	    for band in range(2*t, N + 1):

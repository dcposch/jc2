   146	class QuadraticField:
   147	    kind = "quadratic"
   148	
   149	    def __init__(self, t: int):
   150	        self.t = t
   151	        q = 2 * t + 1
   152	        self.A = Fraction(12 * q * q)
   153	        self.B = Fraction(-12 * q * (t + 1))
   154	        self.C = Fraction((t + 1) * (3 * t + 2))
   155	
   156	    def zero(self) -> tuple[Fraction, Fraction]:
   157	        return (Fraction(0), Fraction(0))
   158	
   159	    def one(self) -> tuple[Fraction, Fraction]:
   160	        return (Fraction(1), Fraction(0))
   161	
   162	    def from_int(self, value: int) -> tuple[Fraction, Fraction]:
   163	        return (Fraction(value), Fraction(0))
   164	
   165	    def from_fraction(self, value: Fraction) -> tuple[Fraction, Fraction]:
   166	        return (value, Fraction(0))
   167	
   168	    def y(self) -> tuple[Fraction, Fraction]:
   169	        return (Fraction(0), Fraction(1))
   170	
   171	    def add(
   172	        self, left: tuple[Fraction, Fraction], right: tuple[Fraction, Fraction]
   173	    ) -> tuple[Fraction, Fraction]:
   174	        return (left[0] + right[0], left[1] + right[1])
   175	
   176	    def neg(self, value: tuple[Fraction, Fraction]) -> tuple[Fraction, Fraction]:
   177	        return (-value[0], -value[1])
   178	
   179	    def sub(
   180	        self, left: tuple[Fraction, Fraction], right: tuple[Fraction, Fraction]
   181	    ) -> tuple[Fraction, Fraction]:
   182	        return (left[0] - right[0], left[1] - right[1])
   183	
   184	    def mul(
   185	        self, left: tuple[Fraction, Fraction], right: tuple[Fraction, Fraction]
   186	    ) -> tuple[Fraction, Fraction]:
   187	        a, b = left
   188	        c, d = right
   189	        yd = b * d
   190	        return (
   191	            a * c - yd * self.C / self.A,
   192	            a * d + b * c - yd * self.B / self.A,
   193	        )
   194	
   195	    def inv(self, value: tuple[Fraction, Fraction]) -> tuple[Fraction, Fraction]:
   196	        a, b = value
   197	        det = a * (a - b * self.B / self.A) + b * b * self.C / self.A
   198	        if det == 0:
   199	            raise ZeroDivisionError(f"zero quadratic coefficient {value}")
   200	        return ((a - b * self.B / self.A) / det, -b / det)
   201	
   202	    def div(
   203	        self, left: tuple[Fraction, Fraction], right: tuple[Fraction, Fraction]
   204	    ) -> tuple[Fraction, Fraction]:
   205	        return self.mul(left, self.inv(right))
   206	
   207	    def scale(
   208	        self, value: tuple[Fraction, Fraction], scalar: Fraction | int
   209	    ) -> tuple[Fraction, Fraction]:
   210	        return (value[0] * scalar, value[1] * scalar)
   211	
   212	    def is_zero(self, value: tuple[Fraction, Fraction]) -> bool:

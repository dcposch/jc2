+hilb(G,1);
+print("HILB_G_2");
+hilb(G,2);
+intvec w=1,2;
+print("WHILB_G_1");
+hilb(G,1,w);
+print("WHILB_G_2");
+hilb(G,2,w);
+print("VDIM"); vdim(G);
+quit;

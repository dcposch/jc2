   302	    if args.run:
   303	        started = time.monotonic()
   304	        try:
   305	            result = subprocess.run(
   306	                ["Singular", "-q", str(source_path)], capture_output=True,
   307	                text=True, timeout=args.timeout, check=False,
   308	            )
   309	            has_error = "? error occurred" in result.stdout or "? error occurred" in result.stderr
   310	            status = ("PASS" if result.returncode == 0 and "DRIVER_DONE" in result.stdout
   311	                      and not has_error else "FAIL")
   312	            metadata.update({
   313	                "status": status,
   314	                "returncode": result.returncode,
   315	                "elapsed_seconds": time.monotonic() - started,
   316	                "stdout": f"{stem}.out",
   317	                "stderr": f"{stem}.err",
   318	            })

+        det = (left[1] * right[2] - left[2] * right[1]) % p
+        if det:
+            pair = left, right, det
+            break
+    assert pair is not None
+    left, right, det = pair
+    invdet = pow(det, p - 2, p)
+    # a*x33+b*x38+r = d*x33+e*x38+s = 0

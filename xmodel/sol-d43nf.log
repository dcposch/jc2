   354	def fourth_roots(p, c, w_hint):
   355	    assert pow(w_hint, 4, p) == c % p, "witness root does not match c"
   356	    i4, g = None, 2
   357	    while i4 is None:
   358	        cand = pow(g, (p - 1) // 4, p)
   359	        if cand != 1 and pow(cand, 2, p) == p - 1:
   360	            i4 = cand
   361	        g += 1
   362	    roots = sorted({w_hint * pow(i4, k, p) % p for k in range(4)})
   363	    assert len(roots) == 4 and all(pow(r, 4, p) == c % p for r in roots)
   364	    return roots

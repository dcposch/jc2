+    semantic = x2tail.get(name, name)
+    if semantic in ("Xf_alpha", "Xg_beta"):
+        return 42
+    if "_" not in semantic:
+        return None
+    suffix = semantic.rsplit("_", 1)[1]
+    return int(suffix) if suffix.isdigit() else None

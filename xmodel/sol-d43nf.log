+            exps = [0] * len(FREE)
+            for free_name, j in free_pos.items():
+                exps[j] = mono[pos[free_name]]
+            key = tuple(exps)
+            result[key] = (result.get(key, 0) + coeff) % p
+            if not result[key]:

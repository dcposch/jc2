   135	def fiber_env(p, lab):
   136	    """(A1r, A2r, h1r, h2r) of the fiber from the banked d23 atlas;
   137	    legitimacy re-verified against the chart radicals."""
   138	    if p not in _ATLAS:
   139	        _ATLAS[p] = json.load(open(
   140	            os.path.join(HERE, "d23_atlas_p%d.json" % p)))
   141	    f = _ATLAS[p]["fibers"][lab]["fiber"]
   142	    pt, r3, h32 = V.radical_env(p)
   143	    env = {"label": lab, "A1": int(f["A1"]), "A2": int(f["A2"]),
   144	           "h1": int(f["HW1_over_W1"]), "h2": int(f["HW2_over_W2"])}
   145	    assert pow(env["A1"], 3, p) == (3 + r3) % p, "A1r not a cube root"
   146	    assert pow(env["A2"], 3, p) == (3 - r3) % p, "A2r not a cube root"
   147	    for h in (env["h1"], env["h2"]):
   148	        assert 2 * h * h % p == 3 % p, "h_ir not a root of 3/2"
   149	    env["is_radical_frame"] = (env["A1"] == pt["A1"] and
   150	                               env["A2"] == pt["A2"] and
   151	                               env["h1"] == h32 and env["h2"] == h32)
   152	    return env
   153	
   154	
   155	# ------------------------------------------------- cell sampling (34 rows)
   156	def parse_fiber_ms(p, lab):
   157	    path = os.path.join(HERE, "d25fam_p%d_%s.ms" % (p, lab))
   158	    lines = open(path).read().split("\n")
   159	    hdr = [h.strip() for h in lines[0].split(",")]
   160	    assert int(lines[1]) == p
   161	    body = "\n".join(lines[2:])
   162	    rows_txt = [r.strip().rstrip(",") for r in body.split(",\n")
   163	                if r.strip()]
   164	    assert len(rows_txt) == 34, (p, lab, len(rows_txt))
   165	    rows = []
   166	    for rt in rows_txt:
   167	        terms = []
   168	        for t in rt.split("+"):
   169	            fs = t.strip().split("*")
   170	            try:
   171	                c = int(fs[0])
   172	                fs = fs[1:]
   173	            except ValueError:
   174	                c = 1
   175	            mono = []
   176	            for f in fs:
   177	                if "^" in f:
   178	                    nm, e = f.split("^")
   179	                    mono.append((nm, int(e)))
   180	                else:
   181	                    mono.append((f, 1))
   182	            terms.append((c, tuple(mono)))
   183	        rows.append(terms)
   184	    return hdr, rows

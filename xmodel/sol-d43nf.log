+    assert pow(W2, 4, p) == int(replay["W2^4"])
+    return {"prime": p, "W1": W1, "W2": W2, "fixed": fixed,
+            "maps": compact, "transcript": transcript,
+            "lift_matrix": lift_matrix, "left_kernel": left_kernel,
+            "raw_names": names}

+        if power not in powers:
+            powers[power] = poly_pow(replacement, power, p, nvars)
+        rest = list(mono)
+        rest[var_index] = 0
+        rest = tuple(rest)
+        shifted = {tuple(x + y for x, y in zip(rest, mr)): cr
+                   for mr, cr in powers[power].items()}
+        poly_add_scaled(out, shifted, coeff, p)

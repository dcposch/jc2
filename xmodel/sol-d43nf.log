+        work[rank], work[pivot] = work[pivot], work[rank]
+        inv = pow(work[rank][col], p - 2, p)
+        work[rank] = [x * inv % p for x in work[rank]]
+        for i in range(nr):
+            if i != rank and work[i][col]:
+                scale = work[i][col]
+                work[i] = [(x - scale * y) % p
+                           for x, y in zip(work[i], work[rank])]
+        rank += 1
+        if rank == nr:
+            break
+    return rank

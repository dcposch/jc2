   187	def row_support(row):
   188	    return {nm for _, mono in row for nm, _ in mono}
   189	
   190	
   191	def eval_row(row, val, p):
   192	    tot = 0
   193	    for c, mono in row:
   194	        m = c
   195	        for nm, e in mono:
   196	            m = m * pow(val[nm], e, p) % p
   197	        tot = (tot + m) % p
   198	    return tot
   199	
   200	
   201	def row_as_poly(row, val, unknowns, p):
   202	    """Row with all vars outside `unknowns` substituted from val ->
   203	    {exponent tuple over unknowns: coeff}."""
   204	    out = {}
   205	    ui = {u: i for i, u in enumerate(unknowns)}
   206	    for c, mono in row:
   207	        m = c
   208	        ev = [0] * len(unknowns)
   209	        for nm, e in mono:
   210	            if nm in ui:
   211	                ev[ui[nm]] += e
   212	            else:
   213	                m = m * pow(val[nm], e, p) % p
   214	        k = tuple(ev)
   215	        out[k] = (out.get(k, 0) + m) % p
   216	    return {k: c for k, c in out.items() if c}
   217	
   218	
   219	def compat_rows(p, rows, val, unknown):
   220	    """Cramer/Schur compatibility rows of the residuals (file rows
   221	    29..33), derived numerically: residuals affine in (x33,x38) with
   222	    Laurent-UNIT coefficients (asserted); the 3-dim left kernel of the
   223	    5x2 lift-column matrix gives base-only rows (rank 2 = the banked
   224	    hcore/hlin span)."""
   225	    unk = sorted(unknown)
   226	    ia, ib = unk.index("x33"), unk.index("x38")
   227	    polys, ab = [], []
   228	    for ri in range(29, 34):
   229	        po = row_as_poly(rows[ri], val, unk, p)
   230	        a = b = 0
   231	        for k, c in po.items():
   232	            if k[ia] or k[ib]:
   233	                assert sum(k) == 1, "lift coefficient not a known unit"
   234	                if k[ia]:
   235	                    a = c
   236	                else:
   237	                    b = c
   238	        polys.append(po)
   239	        ab.append((a, b))
   240	    M = [[ab[i][0], ab[i][1]] + [1 if j == i else 0 for j in range(5)]
   241	         for i in range(5)]
   242	    r = 0
   243	    for c in range(2):
   244	        piv = next((i for i in range(r, 5) if M[i][c]), None)
   245	        if piv is None:
   246	            continue
   247	        M[r], M[piv] = M[piv], M[r]
   248	        iv = pow(M[r][c], p - 2, p)
   249	        M[r] = [x * iv % p for x in M[r]]
   250	        for i in range(5):
   251	            if i != r and M[i][c]:
   252	                f = M[i][c]
   253	                M[i] = [(x - f * y) % p for x, y in zip(M[i], M[r])]
   254	        r += 1
   255	    assert r == 2, "lift column rank != 2"
   256	    out = []
   257	    for i in range(2, 5):
   258	        kvec = M[i][2:]
   259	        comb = {}
   260	        for ki, po in zip(kvec, polys):
   261	            if not ki:
   262	                continue
   263	            for k, c in po.items():
   264	                comb[k] = (comb.get(k, 0) + ki * c) % p
   265	        comb = {k: c for k, c in comb.items() if c}
   266	        assert all(k[ia] == 0 and k[ib] == 0 for k in comb), \
   267	            "lift terms did not cancel in compat row"
   268	        terms = []
   269	        for k, c in comb.items():
   270	            mono = tuple((unk[j], e) for j, e in enumerate(k) if e)
   271	            terms.append((c, mono))
   272	        out.append(terms)
   273	    return out

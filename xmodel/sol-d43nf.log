   276	def solve_cell_point(p, hdr, rows, freeval, W1, W2):
   277	    """freeval: the 14 free vars -> full verified 28-var cell point."""
   278	    val = dict(freeval)
   279	    val["W1"], val["W2"] = W1 % p, W2 % p
   280	    val["uW1"] = pow(W1, p - 2, p)
   281	    val["uW2"] = pow(W2, p - 2, p)
   282	    unknown = [v for v in hdr if v not in val]
   283	    assert sorted(unknown) == sorted(DEP), unknown
   284	    rows = list(rows)
   285	    live = list(range(34))
   286	    added_compat = False
   287	    guard = 0
   288	    while unknown:
   289	        guard += 1
   290	        assert guard < 200, "cell solver did not terminate"
   291	        progress = False
   292	        for ri in live:
   293	            sup = [u for u in row_support(rows[ri]) if u in unknown]
   294	            if len(sup) != 1:
   295	                continue
   296	            u = sup[0]
   297	            po = row_as_poly(rows[ri], val, [u], p)
   298	            if max((k[0] for k in po), default=0) != 1 or \
   299	                    po.get((1,), 0) == 0:
   300	                continue
   301	            val[u] = (-po.get((0,), 0)) * pow(po[(1,)], p - 2, p) % p
   302	            unknown.remove(u)
   303	            progress = True
   304	            break
   305	        if progress:
   306	            continue
   307	        done = False
   308	        pairs = {}
   309	        for ri in live:
   310	            sup = tuple(sorted(u for u in row_support(rows[ri])
   311	                               if u in unknown))
   312	            if len(sup) == 2:
   313	                pairs.setdefault(sup, []).append(ri)
   314	        for sup, ris in pairs.items():
   315	            u, v = sup
   316	            aff = []
   317	            for ri in ris:
   318	                po = row_as_poly(rows[ri], val, [u, v], p)
   319	                if all(k in ((0, 0), (1, 0), (0, 1)) for k in po):
   320	                    aff.append(po)
   321	            for i in range(len(aff)):
   322	                for j in range(i + 1, len(aff)):
   323	                    pa, pb = aff[i], aff[j]
   324	                    a, b, rr = (pa.get((1, 0), 0), pa.get((0, 1), 0),
   325	                                pa.get((0, 0), 0))
   326	                    d, e, s = (pb.get((1, 0), 0), pb.get((0, 1), 0),
   327	                               pb.get((0, 0), 0))
   328	                    det = (a * e - b * d) % p
   329	                    if det == 0:
   330	                        continue
   331	                    idet = pow(det, p - 2, p)
   332	                    val[u] = (b * s - e * rr) * idet % p
   333	                    val[v] = (d * rr - a * s) * idet % p
   334	                    unknown.remove(u)
   335	                    unknown.remove(v)
   336	                    done = True
   337	                    break
   338	                if done:
   339	                    break
   340	            if done:
   341	                break
   342	        if not done and not added_compat:
   343	            for cr in compat_rows(p, rows, val, unknown):
   344	                live.append(len(rows))
   345	                rows.append(cr)
   346	            added_compat = True
   347	            done = True
   348	        assert done, "cell solver stuck; unknowns left: %s" % unknown
   349	    bad = [ri for ri in range(34) if eval_row(rows[ri], val, p) != 0]
   350	    assert not bad, ("D25 fiber rows nonvanishing at sample", bad)
   351	    return val

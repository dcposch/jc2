+FREE_BASE = ("x57", "x59", "x60", "x62", "x63", "x65", "x66", "x68",
+             "x72", "x73")
+FREE_LIFT = ("x16", "x19", "x24", "x27")
+FREE = FREE_BASE + FREE_LIFT
+DEP_BASE = ("x70", "x53", "x58", "x55", "x71", "x52", "x47", "x54")
+DEP_LIFT = ("x33", "x38")
+DEP = DEP_BASE + DEP_LIFT
+FIXED = ("W1", "W2", "uW1", "uW2")

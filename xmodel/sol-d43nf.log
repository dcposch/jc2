+    for ma, ca in a.items():
+        for mb, cb in b.items():
+            mono = tuple(x + y for x, y in zip(ma, mb))
+            value = (out.get(mono, 0) + ca * cb) % p
+            if value:
+                out[mono] = value
+            else:
+                out.pop(mono, None)
+    return out
+

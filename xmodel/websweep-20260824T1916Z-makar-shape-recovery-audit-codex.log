def fr(x):
    """Parse an exact rational from the JSON encoding 'p/q' or int."""
    if isinstance(x, str):
        n, _, d = x.partition("/")
        return Fr(int(n), int(d)) if d else Fr(int(n))
    return Fr(x)


def sfr(x):

   220	def _unique(pattern: re.Pattern[str], text: str, label: str) -> str:
   221	    values = pattern.findall(text)
   222	    if len(values) != 1:
   223	        raise SealError(f"expected exactly one {label} declaration, found {len(values)}")
   224	    return values[0]

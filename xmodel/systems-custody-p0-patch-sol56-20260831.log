   475	
   476	def build_parser() -> argparse.ArgumentParser:
   477	    parser = argparse.ArgumentParser(description=__doc__)
   478	    sub = parser.add_subparsers(dest="command", required=True)
   479	    verify = sub.add_parser("verify", help="verify one or more sealed reports")
   480	    verify.add_argument(
   481	        "--expected-basis",
   482	        "--expect-basis",
   483	        dest="expected_basis",
   484	        help="require this exact 40-character frozen basis (never inferred)",
   485	    )
   486	    verify.add_argument("files", nargs="+", type=Path)
   487	    stamp = sub.add_parser("stamp", help="append a canonical seal atomically")
   488	    stamp.add_argument("file", type=Path)
   489	    stamp.add_argument("--basis", required=True)
   490	    divert = sub.add_parser(
   491	        "divert",
   492	        help="bank non-whitespace overflow after a sole BODY-END, truncating "
   493	        "the charged report to its body; never repairs zero/multiple markers",
   494	    )
   495	    divert.add_argument("file", type=Path)
   496	    divert.add_argument("--overflow", required=True, type=Path)
   497	    divert.add_argument("--raw", type=Path)
   498	    return parser
   499	
   500	
   501	def main(argv: list[str] | None = None) -> int:
   502	    args = build_parser().parse_args(argv)
   503	    if args.command == "verify":
   504	        if args.expected_basis is not None:
   505	            try:
   506	                _validate_basis(args.expected_basis, label="expected basis")
   507	            except SealError as exc:
   508	                print(f"seal: INVALID: {exc}", file=sys.stderr)
   509	                return 1
   510	        failures = 0
   511	        for path in args.files:
   512	            try:
   513	                size, digest, basis = verify_path(
   514	                    path, expected_basis=args.expected_basis
   515	                )
   516	                print(
   517	                    f"PASS path={path} body_bytes={size} "
   518	                    f"body_sha256={digest} basis={basis}"
   519	                )
   520	            except (SealError, OSError) as exc:
   521	                failures += 1
   522	                print(f"seal: INVALID path={path}: {exc}", file=sys.stderr)
   523	        return 1 if failures else 0
   524	
   525	    if args.command == "divert":
   526	        try:
   527	            result = divert_path(args.file, args.overflow, args.raw)
   528	        except (SealError, OSError) as exc:
   529	            print(f"seal: INVALID path={args.file}: {exc}", file=sys.stderr)
   530	            return 1
   531	        detail = " ".join(
   532	            f"{key}={value}" for key, value in result.items() if key != "status"
   533	        )
   534	        line = f"DIVERT path={args.file} status={result['status']}"
   535	        print(f"{line} {detail}" if detail else line)
   536	        return 0
   537	
   538	    try:
   539	        size, digest, basis = stamp_path(args.file, args.basis)
   540	        print(
   541	            f"STAMPED path={args.file} body_bytes={size} "
   542	            f"body_sha256={digest} basis={basis}"
   543	        )
   544	        return 0
   545	    except SealDurabilityWarning as exc:
   546	        print(f"seal: DURABILITY_WARNING path={args.file}: {exc}", file=sys.stderr)
   547	        return 2
   548	    except SealError as exc:
   549	        print(f"seal: INVALID path={args.file}: {exc}", file=sys.stderr)
   550	        return 1
   551	    except OSError as exc:
   552	        print(f"seal: INVALID path={args.file}: operating-system error: {exc}", file=sys.stderr)
   553	        return 1
   554	
   555	
   556	if __name__ == "__main__":
   557	    raise SystemExit(main())


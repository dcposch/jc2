   357	def _write_exclusive(path: Path, data: bytes, mode: int = 0o444) -> str:
   358	    """Create ``path`` exclusively with ``data``; return its SHA-256."""
   359	    parent_fd, name, _parent, _parent_info = _open_parent(path)
   360	    try:
   361	        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
   362	        if hasattr(os, "O_NOFOLLOW"):
   363	            flags |= os.O_NOFOLLOW
   364	        try:
   365	            fd = os.open(name, flags, mode, dir_fd=parent_fd)
   366	        except OSError as exc:
   367	            raise SealError(f"cannot create {path} exclusively: {exc}") from exc
   368	        with os.fdopen(fd, "wb") as handle:
   369	            handle.write(data)
   370	            handle.flush()
   371	            os.fsync(handle.fileno())
   372	        try:
   373	            os.fsync(parent_fd)
   374	        except OSError:
   375	            pass
   376	        return hashlib.sha256(data).hexdigest()
   377	    finally:
   378	        os.close(parent_fd)

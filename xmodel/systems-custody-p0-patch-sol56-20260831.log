   277	
   278	def stamp_path(path: Path, basis: str) -> tuple[int, str, str]:
   279	    _validate_basis(basis)
   280	    parent_fd, name, parent, parent_info = _open_parent(path)
   281	    temp_name: str | None = None
   282	    durability_error: OSError | None = None
   283	    try:
   284	        data, original = _read_regular_at(parent_fd, name)
   285	        boundary = _body_boundary(data)
   286	        if data[boundary:].strip():
   287	            raise SealError(
   288	                "refusing to stamp: non-whitespace content already follows BODY-END"
   289	            )
   290	        body = data[:boundary]
   291	        digest = hashlib.sha256(body).hexdigest()
   292	        sealed = body + _canonical_seal(len(body), digest, basis)
   293	
   294	        try:
   295	            current = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
   296	        except OSError as exc:
   297	            raise SealError(f"cannot recheck target before replacement: {exc}") from exc
   298	        if stat.S_ISLNK(current.st_mode) or not stat.S_ISREG(current.st_mode):
   299	            raise SealError("target changed to a symlink or non-regular file")
   300	        if _identity(current) != _identity(original):
   301	            raise SealError("target identity changed while preparing seal")
   302	
   303	        temp_fd, temp_name = _create_temp_at(
   304	            parent_fd, name, stat.S_IMODE(original.st_mode)
   305	        )
   306	        with os.fdopen(temp_fd, "wb") as handle:
   307	            handle.write(sealed)
   308	            handle.flush()
   309	            os.fsync(handle.fileno())
   310	
   311	        # Detect both replacement and same-inode rewrites immediately before
   312	        # the atomic install.  This is not a substitute for cooperative locks,
   313	        # but it closes the ordinary concurrent-lane lost-update window.
   314	        latest_data, latest = _read_regular_at(parent_fd, name)
   315	        if _snapshot(latest) != _snapshot(original):
   316	            raise SealError("target metadata changed before atomic replacement")
   317	        if latest_data != data:
   318	            raise SealError("target content changed before atomic replacement")
   319	        _check_parent_path(parent, parent_info)
   320	
   321	        os.replace(
   322	            temp_name,
   323	            name,
   324	            src_dir_fd=parent_fd,
   325	            dst_dir_fd=parent_fd,
   326	        )
   327	        temp_name = None
   328	
   329	        installed, _ = _read_regular_at(parent_fd, name)
   330	        if installed != sealed:
   331	            raise SealError("installed seal differs from staged bytes")
   332	        verify_bytes(installed, expected_basis=basis)
   333	
   334	        try:
   335	            _check_parent_path(parent, parent_info)
   336	        except SealError as exc:
   337	            durability_error = OSError(str(exc))
   338	        try:
   339	            os.fsync(parent_fd)
   340	        except OSError as exc:
   341	            durability_error = durability_error or exc
   342	    finally:
   343	        if temp_name is not None:
   344	            try:
   345	                os.unlink(temp_name, dir_fd=parent_fd)
   346	            except FileNotFoundError:
   347	                pass
   348	        os.close(parent_fd)
   349	    if durability_error is not None:
   350	        raise SealDurabilityWarning(
   351	            "seal was installed and verified, but directory fsync failed: "
   352	            f"{durability_error}"
   353	        )
   354	    return len(body), digest, basis

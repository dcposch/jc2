   212	
   213	def _body_boundary(data: bytes) -> int:
   214	    markers = _marker_boundaries(data, require_newline=True)
   215	    if len(markers) != 1:
   216	        raise SealError(f"expected exactly one standalone BODY-END marker, found {len(markers)}")
   217	    return markers[0]

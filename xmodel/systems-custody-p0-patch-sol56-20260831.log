   380	
   381	def divert_path(
   382	    path: Path, overflow_path: Path, raw_path: Path | None = None
   383	) -> dict[str, object]:
   384	    """Split non-whitespace overflow after a sole BODY-END out of a report.
   385	
   386	    The charged report keeps every byte through the marker line; the exact
   387	    overflow bytes land in ``overflow_path`` and, when ``raw_path`` is given,
   388	    the untouched original is preserved there first.  A report whose
   389	    post-marker content is whitespace or a valid canonical seal is left
   390	    unmodified.  Zero or multiple markers are reported, never repaired.
   391	    """
   392	    parent_fd, name, parent, parent_info = _open_parent(path)
   393	    temp_name: str | None = None
   394	    try:
   395	        data, original = _read_regular_at(parent_fd, name)
   396	        markers = _marker_boundaries(data, require_newline=False)
   397	        if not markers:
   398	            return {"status": "NO_MARKER", "bytes": len(data)}
   399	        if len(markers) > 1:
   400	            return {"status": "MULTI_MARKER", "markers": len(markers)}
   401	        boundary = markers[0]
   402	        body = data[:boundary]
   403	        tail = data[boundary:]
   404	        body_sha = hashlib.sha256(body).hexdigest()
   405	        if not tail.strip():
   406	            return {
   407	                "status": "CLEAN",
   408	                "body_bytes": len(body),
   409	                "body_sha256": body_sha,
   410	            }
   411	        try:
   412	            verify_bytes(data)
   413	            return {
   414	                "status": "CLEAN_SEALED",
   415	                "body_bytes": len(body),
   416	                "body_sha256": body_sha,
   417	            }
   418	        except SealError:
   419	            pass
   420	
   421	        result: dict[str, object] = {
   422	            "status": "DIVERTED",
   423	            "body_bytes": len(body),
   424	            "body_sha256": body_sha,
   425	            "overflow": str(overflow_path),
   426	            "overflow_bytes": len(tail),
   427	        }
   428	        if raw_path is not None:
   429	            result["raw"] = str(raw_path)
   430	            result["raw_sha256"] = _write_exclusive(raw_path, data)
   431	        result["overflow_sha256"] = _write_exclusive(overflow_path, tail)
   432	
   433	        try:
   434	            current = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
   435	        except OSError as exc:
   436	            raise SealError(
   437	                f"cannot recheck target before truncation: {exc}"
   438	            ) from exc
   439	        if stat.S_ISLNK(current.st_mode) or not stat.S_ISREG(current.st_mode):
   440	            raise SealError("target changed to a symlink or non-regular file")
   441	        if _identity(current) != _identity(original):
   442	            raise SealError("target identity changed while preparing divert")
   443	
   444	        temp_fd, temp_name = _create_temp_at(
   445	            parent_fd, name, stat.S_IMODE(original.st_mode)
   446	        )
   447	        with os.fdopen(temp_fd, "wb") as handle:
   448	            handle.write(body)
   449	            handle.flush()
   450	            os.fsync(handle.fileno())
   451	
   452	        latest_data, latest = _read_regular_at(parent_fd, name)
   453	        if _snapshot(latest) != _snapshot(original) or latest_data != data:
   454	            raise SealError("target changed before atomic truncation")
   455	        _check_parent_path(parent, parent_info)
   456	        os.replace(temp_name, name, src_dir_fd=parent_fd, dst_dir_fd=parent_fd)
   457	        temp_name = None
   458	
   459	        installed, _ = _read_regular_at(parent_fd, name)
   460	        if installed != body:
   461	            raise SealError("installed body differs from staged bytes")
   462	        try:
   463	            os.fsync(parent_fd)
   464	        except OSError:
   465	            pass
   466	        return result
   467	    finally:
   468	        if temp_name is not None:
   469	            try:
   470	                os.unlink(temp_name, dir_fd=parent_fd)
   471	            except FileNotFoundError:
   472	                pass
   473	        os.close(parent_fd)

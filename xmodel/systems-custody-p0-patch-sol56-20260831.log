   264	
   265	def _canonical_seal(body_bytes: int, body_sha: str, basis: str) -> bytes:
   266	    return (
   267	        "\n## Seal\n\n"
   268	        "- Body definition: every byte through the unique standalone "
   269	        "`<!-- BODY-END -->` line,\n"
   270	        "  including its terminating newline; this seal is outside the body.\n"
   271	        f"- Body bytes: `{body_bytes}`.\n"
   272	        "- Body SHA-256:\n"
   273	        f"  `{body_sha}`.\n"
   274	        f"- Frozen basis: `{basis}`.\n"
   275	    ).encode("utf-8")

   175	def _create_temp_at(parent_fd: int, target_name: str, mode: int) -> tuple[int, str]:
   176	    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
   177	    if hasattr(os, "O_NOFOLLOW"):
   178	        flags |= os.O_NOFOLLOW
   179	    for _ in range(100):
   180	        name = f".{target_name}.seal-{os.getpid()}-{secrets.token_hex(8)}"
   181	        try:
   182	            fd = os.open(name, flags, 0o600, dir_fd=parent_fd)
   183	        except FileExistsError:
   184	            continue
   185	        except OSError as exc:
   186	            raise SealError(f"cannot create anchored seal temp: {exc}") from exc
   187	        try:
   188	            os.fchmod(fd, mode)
   189	        except Exception:
   190	            os.close(fd)

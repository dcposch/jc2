   200	def _marker_boundaries(data: bytes, *, require_newline: bool) -> list[int]:
   201	    markers: list[int] = []
   202	    offset = 0
   203	    for line in data.splitlines(keepends=True):
   204	        content = line[:-2] if line.endswith(b"\r\n") else line[:-1] if line.endswith(b"\n") else line
   205	        if content == MARKER:
   206	            if not line.endswith((b"\n", b"\r\n")) and require_newline:
   207	                raise SealError("standalone BODY-END marker lacks terminating newline")
   208	            markers.append(offset + len(line))
   209	        offset += len(line)
   210	    return markers

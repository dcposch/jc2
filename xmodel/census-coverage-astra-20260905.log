    def passport_certificate(self, A, P, Q, b, coins):
        if not self.ode_passport:
            return None
        slots = (Q - 1) // A
        padded = list(coins) + [0] * (slots - len(coins))
        weights = [(P - Q * b) // A] + [P - Q * value for value in padded]
        divisor = 0
        for weight in weights:

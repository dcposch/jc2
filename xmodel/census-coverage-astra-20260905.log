                    next_dplus = dplus + max(weight, 0)
                else:
                    next_gcd, next_dplus = 0, 0
                tail = visit(remainder - value, coins_left - 1, idx,
                             has_major or is_major, used + 1,
                             next_gcd, next_dplus)
                if tail is not None:
                    return (value,) + tail
            return None

        initial_gcd = 0
        initial_dplus = 0
        if self.ode_passport:
            for weight in weights0:

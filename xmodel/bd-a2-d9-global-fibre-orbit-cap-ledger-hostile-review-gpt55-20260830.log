# Exhaust the parity-stabilizer cases used to prevent B9 -> W(D9) orbit splitting.
N=9
species=[(k,s) for s in range(2,N+1) for k in ('B','U')]
fail=[]; cases={'unused':0,'U':0,'odd_B_cover':0}
def rec(i, rem, vals):
    if i==len(species):
        unused=rem
        ublocks=sum(m for (k,s),m in zip(species,vals) if k=='U')
        if unused:
            cases['unused']+=1; return
        if ublocks:
            cases['U']+=1; return
        # all nine covered by B blocks, so some B block size must be odd
        odd=sum(m for (k,s),m in zip(species,vals) if k=='B' and s%2==1)
        if odd:
            cases['odd_B_cover']+=1
        else:
            fail.append(vals)
        return
    k,s=species[i]
    for m in range(rem//s+1): rec(i+1, rem-s*m, vals+(m,))
rec(0,N,())
print('odd_stabilizer_case_counts', cases)
print('failures', len(fail))
PY" in /Users/dc/code/math/jc2

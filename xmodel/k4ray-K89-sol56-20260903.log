   157	def cp_add(*polys: Mapping[tuple[int, int], sp.Expr]) -> CoordPoly:
   158	    result: CoordPoly = {}
   159	    for poly in polys:
   160	        for monomial, coefficient in poly.items():
   161	            result[monomial] = result.get(monomial, sp.Integer(0)) + coefficient
   162	    return cp_clean(result)

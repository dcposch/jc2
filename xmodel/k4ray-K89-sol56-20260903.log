   408	def localize_mu(expr: sp.Expr, mu: sp.Symbol, mu_inv: sp.Symbol) -> sp.Expr:
   409	    """Replace negative Laurent powers of mu by powers of mu_inv."""
   410	
   411	    numerator, denominator = sp.fraction(sp.cancel(expr))
   412	    if denominator != 1:
   413	        # The only nonconstant denominator allowed is a monomial in mu.
   414	        coefficient, powers = denominator.as_coeff_Mul(), denominator.as_powers_dict()

   159	        raise AssertionError("h is not monic of the declared y degree")
   160	    if any(j == y_degree and i != 0 for i, j in monic_divisor):
   161	        raise AssertionError("h has another term at its top y degree")
   162	    remainder = cp_clean(numerator)
   163	    quotient: CoordPoly = {}
   164	    while remainder:
   165	        top_y = max(j for _i, j in remainder)
   166	        if top_y < y_degree:

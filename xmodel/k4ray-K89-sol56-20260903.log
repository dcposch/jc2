   831	def emit(chart: ScreenChart, output_dir: Path, characteristic: int, strategy: str) -> dict[str, Any]:
   832	    ring, names, weights = ring_for(chart, characteristic, strategy)
   833	    manifest = emit_staged_band_files(
   834	        chart.rows,
   835	        BandEmitConfig(
   836	            output_dir=output_dir,
   837	            ring=ring,
   838	            option_lines=("option(redSB);", "short=0;"),
   839	            global_generators=tuple(chart.global_generators),
   840	            manifest_name="bands-manifest.json",
   841	        ),
   842	    )
   843	    payload = chart_json(chart)
   844	    payload.update(
   845	        {
   846	            "characteristic": characteristic,
   847	            "tie_order": strategy,
   848	            "solver_ring": ring,
   849	            "solver_variables": names,
   850	            "solver_weights": weights,
   851	            "band_manifest": manifest["manifest_path"],
   852	            "band_union_checksum": manifest["generator_union_checksum"],
   853	        }
   854	    )
   855	    atomic_write(output_dir / "screen-chart.json", json.dumps(payload, indent=2, sort_keys=True) + "\n")
   856	    return {"manifest": manifest, "chart": payload}

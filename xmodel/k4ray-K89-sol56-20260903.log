The control lane has already reproduced the required K=7/K=4/K=5 exact kills, the tame survivor, and the deliberately rejected Hilbert perturbation, all single-core with clean markers. The main reduction I’m now testing rewrites the remainder condition as a triangular Hensel system: after a justified \(\mu=1\) slice, each descending homogeneous band is linear in that band’s new coefficients, so pivots can be eliminated before any Gröbner basis is attempted.
exec
/bin/bash -lc "timeout --signal=TERM --kill-after=10s 180s env OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 python3 - <<'PY'
import sympy as s
from collections import OrderedDict
x,y=s.symbols('x y')

def mons(d): return [(i,j) for j in range(d+1) for i in range(d-j+1)]
def bandvars(prefix,d,exclude=()):
 return [s.Symbol(f'{prefix}_{i}_{d-i}') for i in range(d+1) if (i,d-i) not in exclude]
def polybands(prefix,dmax,exclude=()):
 vs={}
 p=0
 for d in range(dmax+1):
  for i in range(d+1):
   j=d-i
   if (i,j) in exclude: continue
   z=s.Symbol(f'{prefix}_{i}_{j}'); vs[(i,j)]=z; p += z*x**i*y**j
 return p,vs

def coeffband(p,d):
 P=s.Poly(s.expand(p),x,y)
 return [P.coeff_monomial(x**i*y**(d-i)) for i in range(d+1)]

def go(K):
 b=K-2; a=K-4; rd=K-6
 hp,hv=polybands('h',K-1,{(0,K-1)})
 bp,bv=polybands('B',b-1)
 ap,av=polybands('A',a-1)
 H=y**(K-1)*(y-x); P=2*y**(K-3)*(y-x); At=4*y**(K-5)*(y-x)
 Rt=s.Rational(4,3)*y**(K-7)*(y-x)
 h=H+hp; B=P+bp; A=At+ap
 D=s.expand(B**2-A*h-Rt)
 sub=OrderedDict(); free=[]; comps=[]
 print('K',K,'original',len(hv),len(bv),len(av))
 for d in range(2*K-5,rd-1,-1):
  eq=[s.expand(e.subs(sub)) for e in coeffband(D,d)]
  qh=d-a; qa=d-K; qb=d-b
  new=[]
  if 0<=qh<=K-1:
   new += [v for (ij,v) in hv.items() if sum(ij)==qh and v not in sub]
  if 0<=qa<=a-1:
   new += [v for (ij,v) in av.items() if sum(ij)==qa and v not in sub]
  if 0<=qb<=b-1:
   new += [v for (ij,v) in bv.items() if sum(ij)==qb and v not in sub]
  # coefficient matrix and RHS
  M, rhs=s.linear_eq_to_matrix(eq,new)
  # assert M rational constants
  if any(z.free_symbols for z in M): raise RuntimeError(('nonconst',d))
  piv=M.rref()[1]
  rowp=M.T.rref()[1]
  pvars=[new[i] for i in piv]
  fvars=[v for i,v in enumerate(new) if i not in piv]
  if piv:
   S=M.extract(list(rowp),list(piv))
   rr=rhs.extract(list(rowp),[0]) - M.extract(list(rowp),[i for i in range(len(new)) if i not in piv])*s.Matrix(fvars)
   sol=S.inv()*rr
   ns=OrderedDict((v,s.factor(sol[i])) for i,v in enumerate(pvars))
   # resolve any piv references simultaneously should none
   sub.update(ns)
  residual=[s.factor(s.expand(e.subs(sub))) for e in eq]
  # remove zero and unique up to scalar? just list
  nz=[]
  for e in residual:
   if e"'!=0:
    # normalize primitive maybe
    if not any(s.expand(e-z)==0 or s.expand(e+z)==0 for z in nz): nz.append(e)
  comps.extend(nz)
  free.extend(fvars)
  print('"' d',d,'eq',len(eq),'new',len(new),'rank',len(piv),'free+',len(fvars),'compat+',len(nz),'ops',sum(s.count_ops(v) for v in ns.values()) if piv else 0,flush=True)
 # all unsubbed intrinsic vars should be frees
 allv=list(hv.values())+list(av.values())+list(bv.values())
 remain=[v for v in allv if v not in sub]
 print('SUMMARY substitutions',len(sub),'remain',len(remain),'compat raw',len(comps),'names',remain)
 # see unique comp groebner perhaps
 print('max comp ops',max(map(s.count_ops,comps),default=0),'total',sum(map(s.count_ops,comps)))

for K in (8,9): go(K)

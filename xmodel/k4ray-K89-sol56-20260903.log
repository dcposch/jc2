   378	    def assert_localized_zero(self, poly: Mapping[tuple[int, int], sp.Expr], label: str) -> str:
   379	        failures: list[str] = []
   380	        for monomial, coefficient in poly.items():
   381	            reduced = sp.cancel(coefficient.subs(self.mu_inv, 1 / self.mu))
   382	            if reduced != 0:
   383	                reduced = sp.factor(reduced)
   384	            if reduced != 0:
   385	                failures.append(f"{monomial}:{reduced}")
   386	        if failures:
   387	            raise AssertionError(f"localized identity {label} failed: {failures[:2]}")
   388	        return "PASS_MOD_mu*mu_inv-1"

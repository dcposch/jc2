   174	def solve_h_band(
   175	    residual: sp.Expr,
   176	    h_symbols: Sequence[sp.Symbol],
   177	    mu: sp.Symbol,
   178	    x: sp.Symbol,
   179	    y: sp.Symbol,
   180	) -> tuple[dict[sp.Symbol, sp.Expr], list[sp.Expr], dict[str, Any]]:
   181	    """Eliminate h_n over Q[other variables,mu,mu^-1] by constant RREF."""
   182	
   183	    terms = sp.Poly(sp.expand(residual), x, y).terms()
   184	    equations = [sp.expand(coefficient) for _monomial, coefficient in terms]
   185	    zero_h = {symbol: sp.Integer(0) for symbol in h_symbols}
   186	    matrix: list[list[Any]] = []
   187	    right: list[sp.Expr] = []
   188	    for equation in equations:
   189	        coefficients = [sp.expand(equation).coeff(symbol) for symbol in h_symbols]
   190	        rest = sp.expand(equation.xreplace(zero_h))
   191	        reconstructed = sp.expand(rest + sum((coefficient * symbol for coefficient, symbol in zip(coefficients, h_symbols)), sp.Integer(0)))
   192	        if reconstructed != sp.expand(equation):
   193	            raise AssertionError("recurrence band is nonlinear in its entering h variables")
   194	        constant_coefficients = []
   195	        for coefficient in coefficients:
   196	            quotient = sp.cancel(coefficient / mu**3)
   197	            if quotient.free_symbols:
   198	                raise AssertionError(f"h pivot coefficient is not Q*mu^3: {coefficient}")
   199	            constant_coefficients.append(quotient)
   200	        matrix.append([sp.Rational(value) for value in constant_coefficients])
   201	        right.append(sp.expand(-rest / mu**3))
   202	
   203	    # Convert through the shared exact Fraction RREF implementation.
   204	    fraction_matrix = [
   205	        [__import__("fractions").Fraction(int(value.p), int(value.q)) for value in row]
   206	        for row in matrix
   207	    ]
   208	    rref, transform, pivots = exact_rref_with_transform(fraction_matrix)
   209	    transformed_right = transform_vector(transform, right)
   210	    free_columns = [column for column in range(len(h_symbols)) if column not in pivots]
   211	    substitutions: dict[sp.Symbol, sp.Expr] = {}
   212	    for row, pivot in enumerate(pivots):
   213	        value = transformed_right[row]
   214	        for column in free_columns:
   215	            if rref[row][column]:
   216	                value -= spq(rref[row][column]) * h_symbols[column]

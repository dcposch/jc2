   113	    expected_rank: int,
   114	) -> tuple[CoordPoly, list[sp.Expr], dict[str, Any]]:
   115	    """Eliminate alpha_n through the exact constant matrix for -H*alpha_n."""
   116	
   117	    symbols = [alpha_band[key] for key in sorted(alpha_band)]
   118	    equations = [sp.expand(residual[key]) for key in sorted(residual, reverse=True)]
   119	    zero_symbols = {symbol: sp.Integer(0) for symbol in symbols}
   120	    matrix: list[list[Fraction]] = []
   121	    right: list[sp.Expr] = []
   122	    for equation in equations:
   123	        coefficients = [sp.expand(equation).coeff(symbol) for symbol in symbols]
   124	        rest = sp.expand(equation.xreplace(zero_symbols))
   125	        rebuilt = sp.expand(
   126	            rest
   127	            + sum(
   128	                (coefficient * symbol for coefficient, symbol in zip(coefficients, symbols)),
   129	                sp.Integer(0),
   130	            )
   131	        )
   132	        if rebuilt != equation:
   133	            raise AssertionError(f"alpha band {band_index} is nonlinear")
   134	        row: list[Fraction] = []
   135	        for coefficient in coefficients:
   136	            if not coefficient.is_Rational:
   137	                raise AssertionError(
   138	                    f"alpha band {band_index} has nonconstant pivot coefficient {coefficient}"
   139	                )
   140	            rational = sp.Rational(coefficient)
   141	            row.append(Fraction(int(rational.p), int(rational.q)))
   142	        matrix.append(row)
   143	        right.append(-rest)
   144	
   145	    rref, transform, pivots = exact_rref_with_transform(matrix)
   146	    transformed_right = transform_expressions(transform, right)
   147	    free_columns = [column for column in range(len(symbols)) if column not in pivots]
   148	    if len(pivots) != expected_rank or free_columns:
   149	        raise AssertionError(
   150	            f"alpha band {band_index}: rank {len(pivots)}, expected {expected_rank}; "
   151	            f"free={free_columns}"
   152	        )
   153	    substitutions = {
   154	        symbols[pivot]: sp.expand(transformed_right[row])
   155	        for row, pivot in enumerate(pivots)
   156	    }
   157	    compatibility = [
   158	        sp.expand(transformed_right[row])
   159	        for row in range(len(pivots), len(equations))
   160	        if sp.expand(transformed_right[row]) != 0
   161	    ]
   162	    resolved = cp_substitute(alpha_band, substitutions)
   163	    audit = {
   164	        "band_index": band_index,
   165	        "total_degree": 14 - band_index,
   166	        "engine": "exact_Q_constant_matrix_RREF",
   167	        "equation_count": len(equations),
   168	        "alpha_candidate_count": len(symbols),
   169	        "rank": len(pivots),
   170	        "expected_rank": expected_rank,
   171	        "pivot_variables": [str(symbols[column]) for column in pivots],
   172	        "free_alpha_variables": [],
   173	        "compatibility_count": len(compatibility),
   174	        "matrix_sha256": fraction_matrix_sha256(matrix),
   175	        "rref_sha256": fraction_matrix_sha256(rref),
   176	        "transform_sha256": fraction_matrix_sha256(transform),
   177	        "row_transform_exact": True,
   178	        "span_equivalence": "invertible exact-Q left row operations",
   179	    }
   180	    return resolved, compatibility, audit
   181	
   182	
   183	def clear_row(
   184	    expression: sp.Expr,
   185	    *,
   186	    label: str,
   187	    band: str,
   188	    degree: int,
   189	    source: Mapping[str, Any],
   190	) -> tuple[BandRow, int]:
   191	    expression = sp.expand(expression)
   192	    multiplier = denominator_lcm((expression,))
   193	    integral = sp.expand(multiplier * expression)
   194	    encoded = singular_expr(integral)
   195	    if re.search(r"/\s*[0-9]+", encoded):
   196	        raise AssertionError(f"uncleared rational in {label}")
   197	    return (
   198	        BandRow(
   199	            label=label,
   200	            band=band,
   201	            degree=degree,
   202	            expr=encoded,
   203	            source={**source, "cleared_rational_denominator": multiplier},
   204	        ),
   205	        multiplier,
   206	    )
   207	
   208	
   209	def rows_from_coefficients(
   210	    coefficients: Sequence[sp.Expr],
   211	    *,
   212	    prefix: str,
   213	    band: str,
   214	    degree: int,
   215	    source: Mapping[str, Any],
   216	) -> tuple[list[BandRow], list[int]]:
   217	    rows: list[BandRow] = []
   218	    denominators: list[int] = []
   219	    for index, expression in enumerate(coefficients):
   220	        if sp.expand(expression) == 0:
   221	            continue
   222	        row, denominator = clear_row(
   223	            expression,
   224	            label=f"{prefix}_{index}",
   225	            band=band,
   226	            degree=degree,
   227	            source={**source, "row_in_band": index},
   228	        )
   229	        rows.append(row)
   230	        denominators.append(denominator)
   231	    return rows, denominators
   232	
   233	
   234	def rows_from_coordinate_band(
   235	    polynomial: Mapping[tuple[int, int], sp.Expr],
   236	    *,
   237	    prefix: str,
   238	    band: str,
   239	    degree: int,
   240	    source: Mapping[str, Any],
   241	) -> tuple[list[BandRow], list[int]]:
   242	    rows: list[BandRow] = []
   243	    denominators: list[int] = []
   244	    for (i, j), expression in sorted(polynomial.items()):
   245	        expression = sp.expand(expression)
   246	        if expression == 0:
   247	            continue
   248	        if i + j != degree:
   249	            raise AssertionError(
   250	                f"{prefix}: monomial {(i, j)} lies outside expected total degree {degree}"
   251	            )
   252	        row, denominator = clear_row(
   253	            expression,
   254	            label=f"{prefix}_x{i}_y{j}",
   255	            band=band,
   256	            degree=degree,
   257	            source={**source, "x_power": i, "y_power": j},
   258	        )
   259	        rows.append(row)
   260	        denominators.append(denominator)
   261	    return rows, denominators
   262	
   263	
   264	def ordered_ring(
   265	    variables: Sequence[sp.Symbol], weights: Mapping[sp.Symbol, int]
   266	) -> tuple[str, list[str], list[int]]:
   267	    pairs = [(symbol, weights[symbol]) for symbol in variables if str(symbol) != "mu_inv"]
   268	    pairs.sort(key=lambda item: (-item[1], str(item[0])))
   269	    pairs.extend((symbol, weights[symbol]) for symbol in variables if str(symbol) == "mu_inv")
   270	    names = [str(symbol) for symbol, _weight in pairs]
   271	    ordered_weights = [int(weight) for _symbol, weight in pairs]
   272	    return (
   273	        f"ring SS=0,({','.join(names)}),wp({','.join(str(weight) for weight in ordered_weights)});",
   274	        names,
   275	        ordered_weights,
   276	    )
   277	
   278	
   279	def coordinate_encoding(poly: Mapping[tuple[int, int], sp.Expr]) -> dict[str, str]:
   280	    return {
   281	        f"x{i}_y{j}": singular_expr(expression)
   282	        for (i, j), expression in sorted(poly.items())
   283	        if sp.expand(expression) != 0
   284	    }
   285	
   286	
   287	def build(branch: str, tag: str) -> dict[str, Any]:
   288	    started = time.monotonic()
   289	    builder = ChartBuilder(9, branch, "terminal", terminal_rref=True)
   290	    terminal_chart = builder.build()
   291	    if builder.coordinate_state is None:
   292	        raise AssertionError("explicit terminal builder did not expose coordinate state")
   293	    state = builder.coordinate_state
   294	    hbands: dict[int, CoordPoly] = {
   295	        index: dict(poly) for index, poly in state["hbands"].items()
   296	    }
   297	    pbands: dict[int, CoordPoly] = {
   298	        index: dict(poly) for index, poly in state["pbands"].items()
   299	    }
   300	    qbands: dict[int, CoordPoly] = {
   301	        index: dict(poly) for index, poly in state["qbands"].items()
   302	    }
   303	    variables: list[sp.Symbol] = list(state["variables"])
   304	    weights: dict[sp.Symbol, int] = dict(state["weights"])
   305	    if len(set(variables)) != len(variables):
   306	        raise AssertionError("duplicate solver variable after terminal RREF")
   307	    if hbands[1].get((0, 8), 0) != 0:
   308	        raise AssertionError("h1 pure-y^8 coefficient was not eliminated")
   309	    if hbands[0].get((0, 9), 0) != 1 or any(
   310	        j == 9 and i != 0 for i, j in hbands[0]
   311	    ):
   312	        raise AssertionError("H is not monic of y-degree 9")
   313	
   314	    rows: list[BandRow] = list(state["terminal_rows"])
   315	    denominators: list[int] = []
   316	    alpha_bands: dict[int, CoordPoly] = {}
   317	    alpha_audits: list[dict[str, Any]] = []
   318	    for n in range(6):
   319	        entering, symbols = alpha_form(n, 5 - n)
   320	        alpha_bands[n] = entering
   321	        residual = cp_add(
   322	            beta_square_band(n, pbands),
   323	            cp_scale(h_alpha_band(n, hbands, alpha_bands), -1),
   324	        )
   325	        resolved, compatibility, audit = solve_alpha_band(
   326	            residual,
   327	            entering,
   328	            band_index=n,
   329	            expected_rank=6 - n,
   330	        )
   331	        alpha_bands[n] = resolved
   332	        if set(symbols) & set().union(*(value.free_symbols for value in resolved.values())):
   333	            raise AssertionError(f"alpha band {n} retained an eliminated auxiliary")
   334	        new_rows, new_denominators = rows_from_coefficients(
   335	            compatibility,
   336	            prefix=f"ALPHA_DIV_n{n}",
   337	            band=f"a{n:02d}_ALPHA_DIV",
   338	            degree=14 - n,
   339	            source={"kind": "ALPHA_DIVISIBILITY", "band_index": n},
   340	        )
   341	        rows.extend(new_rows)
   342	        denominators.extend(new_denominators)
   343	        audit["emitted_compatibility_count"] = len(new_rows)
   344	        alpha_audits.append(audit)
   345	
   346	    residual_audits: list[dict[str, Any]] = []
   347	    for n in range(6, 14):
   348	        residual = cp_add(
   349	            beta_square_band(n, pbands),
   350	            cp_scale(h_alpha_band(n, hbands, alpha_bands), -1),
   351	        )
   352	        degree = 14 - n
   353	        if n <= 10:
   354	            family = "RHO_HIGH_ZERO"
   355	            target_index: int | None = None
   356	        else:
   357	            target_index = n - 11
   358	            residual = cp_add(residual, cp_scale(qbands[target_index], -sp.Rational(1, 3)))
   359	            family = "RHO_POSITIVE_MATCH"
   360	        new_rows, new_denominators = rows_from_coordinate_band(
   361	            residual,
   362	            prefix=f"{family}_n{n}",
   363	            band=f"r{n:02d}_{family}",
   364	            degree=degree,
   365	            source={
   366	                "kind": family,
   367	                "band_index": n,
   368	                "rho_q_index": target_index,
   369	            },
   370	        )
   371	        rows.extend(new_rows)
   372	        denominators.extend(new_denominators)
   373	        residual_audits.append(
   374	            {
   375	                "band_index": n,
   376	                "total_degree": degree,
   377	                "condition": "zero" if n <= 10 else f"q{target_index}/3",
   378	                "coordinate_count": len(residual),
   379	                "emitted_row_count": len(new_rows),
   380	            }
   381	        )
   382	
   383	    # n=14 is the scalar rho_0 band and is intentionally unconstrained.
   384	    declared = set(variables)
   385	    for row in rows:
   386	        free = sp.sympify(row.expr.replace("^", "**")).free_symbols
   387	        if not free <= declared:
   388	            raise AssertionError(
   389	                f"row {row.label} uses undeclared symbols {sorted(map(str, free-declared))}"
   390	            )
   391	    denominator_value = math.lcm(terminal_chart.denominator_lcm, *denominators)
   392	    ring, solver_variables, solver_weights = ordered_ring(variables, weights)
   393	    fingerprint_payload = json.dumps(
   394	        {
   395	            "K": 9,
   396	            "branch": branch,
   397	            "scope": "RREF_SPARSE_ALPHA_RHO_NECESSARY_SUBSYSTEM",
   398	            "variables": solver_variables,
   399	            "weights": solver_weights,
   400	            "rows": [(row.label, row.band, row.degree, row.expr) for row in rows],
   401	            "global": [("mu_localizer", "mu*mu_inv-1")],
   402	        },
   403	        sort_keys=True,
   404	        separators=(",", ":"),
   405	    )
   406	    chart_sha256 = sha256_text(fingerprint_payload)
   407	
   408	    output = RUNS / tag / f"K9_{branch}" / "build"
   409	    manifest = emit_staged_band_files(
   410	        rows,
   411	        BandEmitConfig(
   412	            output_dir=output / "emitted_Q",
   413	            ring=ring,
   414	            option_lines=("option(redSB);", "short=0;"),
   415	            global_generators=(("mu_localizer", "mu*mu_inv-1"),),
   416	            manifest_name="bands-manifest.json",
   417	        ),
   418	    )
   419	    family_counts = Counter(row.source["kind"] for row in rows)
   420	    metadata = {
   421	        "type": "K4RAY-K9-RREF-SPARSE-ALPHA-RHO",
   422	        "K": 9,
   423	        "branch": branch,
   424	        "scope": "RREF_SPARSE_ALPHA_RHO_NECESSARY_SUBSYSTEM",
   425	        "normalization": {
   426	            "CST": 1,
   427	            "mu": "variable",
   428	            "mu_localizer": "mu*mu_inv-1",
   429	            "y_or_y_minus_x_localized": False,
   430	        },
   431	        "coverage": {
   432	            "terminal": "N4=0, N5=0, N6=+Theta9 after exact h4/h5/h6 RREF",
   433	            "alpha_solved_bands": list(range(6)),
   434	            "rho_high_zero_band_indices": list(range(6, 11)),
   435	            "rho_positive_matches": {"11": "q0/3=rho3", "12": "q1/3=rho2", "13": "q2/3=rho1"},
   436	            "rho_scalar_band_14": "free (absorbed by lambda); no q3/3 equation",
   437	            "E_MASTER_ID6_rows": 0,
   438	        },
   439	        "split_coverage": {
   440	            "A": "y|v, parameterized as v=y*w",
   441	            "B": "y|(y-x)v^2-12mu*p2, parameterized with y*zeta",
   442	            "union": "exhaustive because y is prime; intersection retained in both",
   443	            "this_chart": branch,
   444	        },
   445	        "variables": solver_variables,
   446	        "weights": solver_weights,
   447	        "variable_count": len(solver_variables),
   448	        "row_count": len(rows),
   449	        "global_generator_count": 1,
   450	        "row_family_counts": dict(sorted(family_counts.items())),
   451	        "terminal_rref_audit": state["formula_controls"].get("terminal_RREF"),
   452	        "alpha_rref_audit": alpha_audits,
   453	        "residual_band_audit": residual_audits,
   454	        "formula_controls": {
   455	            key: value
   456	            for key, value in state["formula_controls"].items()
   457	            if key != "terminal_RREF"
   458	        },
   459	        "denominator_lcm": denominator_value,
   460	        "reconstruction": {
   461	            "h": terminal_chart.h,
   462	            "beta": terminal_chart.beta,
   463	            "alpha_bands": {
   464	                str(index): coordinate_encoding(poly)
   465	                for index, poly in alpha_bands.items()
   466	            },
   467	            "rho_positive_target_bands": {
   468	                "3": coordinate_encoding(cp_scale(qbands[0], sp.Rational(1, 3))),
   469	                "2": coordinate_encoding(cp_scale(qbands[1], sp.Rational(1, 3))),
   470	                "1": coordinate_encoding(cp_scale(qbands[2], sp.Rational(1, 3))),
   471	                "0": "FREE",
   472	            },
   473	        },
   474	        "solver_ring": ring,
   475	        "band_manifest": manifest["manifest_path"],
   476	        "band_union_checksum": manifest["generator_union_checksum"],
   477	        "chart_sha256": chart_sha256,
   478	        "build_seconds": round(time.monotonic() - started, 6),
   479	        "fallacy_v2": {
   480	            "unit_mod_p": "F_p-only until exact-Q confirmation",
   481	            "posdim": "necessary subsystem only; not a point or counterexample",
   482	        },
   483	    }
   484	    metadata_path = output / "sparse-rho-chart.json"
   485	    atomic_write(metadata_path, json.dumps(metadata, indent=2, sort_keys=True) + "\n")
   486	    result = {
   487	        "K": 9,
   488	        "branch": branch,
   489	        "variables": len(solver_variables),
   490	        "rows": len(rows),
   491	        "row_family_counts": dict(sorted(family_counts.items())),
   492	        "denominator_lcm": denominator_value,
   493	        "chart_sha256": chart_sha256,
   494	        "band_union_checksum": manifest["generator_union_checksum"],
   495	        "build_seconds": metadata["build_seconds"],
   496	        "metadata": str(metadata_path),
   497	    }
   498	    print(json.dumps(result, sort_keys=True))
   499	    return result
   500	
   501	
   502	def main() -> None:
   503	    parser = argparse.ArgumentParser(description=__doc__)
   504	    parser.add_argument("tag")
   505	    parser.add_argument("--branch", choices=("A", "B"), required=True)
   506	    args = parser.parse_args()
   507	    build(args.branch, args.tag)
   508	

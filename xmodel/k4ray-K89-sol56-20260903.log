   267	    fraction_matrix = [
   268	        [Fraction(int(value.p), int(value.q)) for value in row] for row in matrix
   269	    ]
   270	    rref, transform, pivots = exact_rref_with_transform(fraction_matrix)
   271	    transformed_right = transform_vector(transform, right)
   272	    free_columns = [column for column in range(len(h_symbols)) if column not in pivots]
   273	    substitutions: dict[sp.Symbol, sp.Expr] = {}
   274	    for row, pivot in enumerate(pivots):
   275	        value = transformed_right[row]
   276	        for column in free_columns:
   277	            if rref[row][column]:
   278	                value -= spq(rref[row][column]) * h_symbols[column]
   279	        substitutions[h_symbols[pivot]] = sp.expand(value)
   280	    compatibility = [
   281	        sp.expand(transformed_right[row])
   282	        for row in range(len(pivots), len(equations))
   283	        if sp.expand(transformed_right[row]) != 0
   284	    ]
   285	    resolved = cp_clean(
   286	        {monomial: coefficient.xreplace(substitutions) for monomial, coefficient in h_band.items()}
   287	    )
   288	    audit = {
   289	        "engine": "sparse_xy_constant_Q_RREF",
   290	        "equation_count": len(equations),
   291	        "h_variable_count": len(h_symbols),
   292	        "rank": len(pivots),
   293	        "pivot_variables": [str(h_symbols[column]) for column in pivots],
   294	        "free_h_variables": [str(h_symbols[column]) for column in free_columns],
   295	        "compatibility_count": len(compatibility),
   296	        "row_transform_exact": True,
   297	    }
   298	    return resolved, [h_symbols[column] for column in free_columns], compatibility, audit
   299	
   300	
   301	def zero_rational(expr: sp.Expr) -> bool:
   302	    numerator, _denominator = sp.fraction(sp.cancel(expr))
   303	    return sp.expand(numerator) == 0
   304	
   305	
   306	def localize_mu(expr: sp.Expr, mu: sp.Symbol, mu_inv: sp.Symbol) -> sp.Expr:
   307	    """Replace negative Laurent powers of mu by powers of mu_inv."""
   308	
   309	    numerator, denominator = sp.fraction(sp.cancel(expr))
   310	    if denominator != 1:
   311	        # The only nonconstant denominator allowed is a monomial in mu.
   312	        coefficient, powers = denominator.as_coeff_Mul(), denominator.as_powers_dict()
   313	        exponent = powers.get(mu, sp.Integer(0))
   314	        residual = sp.cancel(denominator / mu**exponent)
   315	        if residual.free_symbols:
   316	            raise ValueError(f"non-Laurent denominator encountered: {denominator}")
   317	        expr = sp.expand(numerator / residual * mu ** (-int(exponent)))
   318	    result: sp.Expr = sp.Integer(0)
   319	    for term in sp.expand(expr).as_ordered_terms():
   320	        exponent_value = term.as_powers_dict().get(mu, sp.Integer(0))
   321	        if not exponent_value.is_Integer:
   322	            raise ValueError(f"nonintegral mu exponent in {term}")
   323	        exponent = int(exponent_value)
   324	        coefficient = sp.cancel(term / mu**exponent)
   325	        result += coefficient * (mu**exponent if exponent >= 0 else mu_inv ** (-exponent))
   326	    return sp.expand(result)
   327	
   328	
   329	def polynomial_coefficients(expr: sp.Expr, x: sp.Symbol, y: sp.Symbol) -> list[sp.Expr]:
   330	    return [sp.expand(coefficient) for _monomial, coefficient in sp.Poly(sp.expand(expr), x, y).terms()]


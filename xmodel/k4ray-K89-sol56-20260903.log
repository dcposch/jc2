   256	def _emit_one_analysis(
   257	    run_id: str,
   258	    generators: Sequence[str],
   259	    hint: HilbertHint | None,
   260	    expected_length: int | None,
   261	) -> list[str]:
   262	    basis = f"GG_G_{run_id}"
   263	    ideal = f"GG_I_{run_id}"
   264	    lines = [
   265	        f'print("GG__RUN {run_id} START");',
   266	        f"ideal {ideal}=" + ",".join(f"({generator})" for generator in generators) + ";",
   267	        f'print("GG__GENERATOR_COUNT {run_id} "+string(size({ideal})));',
   268	        f'print("GG__STD_BEGIN {run_id}");',
   269	        "timer=1;",
   270	        f"int GG_TIMER_{run_id}=timer;",
   271	    ]
   272	    if hint is None:
   273	        lines.append(f"ideal {basis}=std({ideal});")
   274	    else:
   275	        hvar = f"GG_HNUM_{run_id}"
   276	        wvar = f"GG_WTS_{run_id}"
   277	        lines.extend(
   278	            [
   279	                f"intvec {hvar}={intvec(hint.numerator)};",
   280	                f"intvec {wvar}={intvec(hint.weights)};",
   281	                f'print("GG__TARGET_HNUM {run_id} "+string({hvar}));',
   282	                f'print("GG__WEIGHTS {run_id} "+string({wvar}));',
   283	                f"ideal {basis}=std({ideal},{hvar},{wvar});",
   284	            ]
   285	        )
   286	    lines.extend(
   287	        [
   288	            f'print("GG__STD_SECONDS {run_id} "+string(timer-GG_TIMER_{run_id}));',
   289	            f"int GG_NF_ALL_{run_id}=1;",
   290	        ]
   291	    )
   292	    for index, generator in enumerate(generators):
   293	        lines.extend(
   294	            [
   295	                f"poly GG_NF_{run_id}_{index}=reduce(({generator}),{basis});",
   296	                f"int GG_NFZ_{run_id}_{index}=(GG_NF_{run_id}_{index}==0);",
   297	                f"if (GG_NFZ_{run_id}_{index}==0) {{ GG_NF_ALL_{run_id}=0; }}",
   298	                f'print("GG__NF_ZERO {run_id} {index} "+string(GG_NFZ_{run_id}_{index}));',
   299	                f'print("GG__NF_SIZE {run_id} {index} "+string(size(GG_NF_{run_id}_{index})));',
   300	            ]
   301	        )
   302	    lines.extend(
   303	        [
   304	            f'print("GG__NF_ALL_ZERO {run_id} "+string(GG_NF_ALL_{run_id}));',
   305	            f"poly GG_NF1_{run_id}=reduce(1,{basis});",
   306	            f"int GG_UNIT_{run_id}=(GG_NF1_{run_id}==0);",
   307	            f'print("GG__UNIT {run_id} "+string(GG_UNIT_{run_id}));',
   308	            f'print("GG__NF1_SIZE {run_id} "+string(size(GG_NF1_{run_id})));',
   309	            f'print("GG__BASIS_SIZE {run_id} "+string(size({basis})));',
   310	            f"int GG_DIM_{run_id}=dim({basis});",
   311	            f'print("GG__DIM {run_id} "+string(GG_DIM_{run_id}));',
   312	            f"int GG_VDIM_{run_id}=-1;",
   313	            f"if (GG_DIM_{run_id}==0)",
   314	            "{",
   315	            f"  GG_VDIM_{run_id}=vdim({basis});",
   316	            f'  print("GG__VDIM {run_id} "+string(GG_VDIM_{run_id}));',
   317	            "}",
   318	            "else",
   319	            "{",
   320	            f'  print("GG__VDIM {run_id} NONTERMINATING");',
   321	            "}",
   322	            f"ideal GG_LEADRAW_{run_id}=lead({basis});",
   323	            f"ideal GG_LEADMIN_{run_id}=minbase(GG_LEADRAW_{run_id});",
   324	            f"ideal GG_GLEAD_{run_id}=std(GG_LEADMIN_{run_id});",
   325	            f'print("GG__LEAD_MIN_COUNT {run_id} "+string(size(GG_LEADMIN_{run_id})));',
   326	            f"int GG_LEAD_DIM_{run_id}=dim(GG_GLEAD_{run_id});",
   327	            f'print("GG__LEAD_DIM {run_id} "+string(GG_LEAD_DIM_{run_id}));',
   328	            f"int GG_LEAD_VDIM_{run_id}=-1;",
   329	            f"if (GG_LEAD_DIM_{run_id}==0)",
   330	            "{",
   331	            f"  GG_LEAD_VDIM_{run_id}=vdim(GG_GLEAD_{run_id});",
   332	            f'  print("GG__LEAD_VDIM {run_id} "+string(GG_LEAD_VDIM_{run_id}));',
   333	            "}",
   334	            "else",
   335	            "{",
   336	            f'  print("GG__LEAD_VDIM {run_id} NONTERMINATING");',
   337	            "}",
   338	        ]
   339	    )
   340	    if expected_length is not None:
   341	        lines.extend(
   342	            [
   343	                f"int GG_VDIM_MATCH_{run_id}="
   344	                f"(GG_LEAD_DIM_{run_id}==0 and GG_LEAD_VDIM_{run_id}=={expected_length});",
   345	                f'print("GG__VDIM_MATCH_PREDICTED {run_id} "+string(GG_VDIM_MATCH_{run_id}));',
   346	                f"int GG_ACCEPT_{run_id}=(GG_NF_ALL_{run_id}==1 and "
   347	                f"GG_LEAD_DIM_{run_id}==0 and GG_LEAD_VDIM_{run_id}=={expected_length});",
   348	                f'print("GG__ACCEPT {run_id} "+string(GG_ACCEPT_{run_id}));',
   349	            ]
   350	        )
   351	    else:
   352	        lines.extend(
   353	            [
   354	                f"int GG_ACCEPT_{run_id}=(GG_NF_ALL_{run_id}==1);",
   355	                f'print("GG__VDIM_MATCH_PREDICTED {run_id} NA");',
   356	                f'print("GG__ACCEPT {run_id} "+string(GG_ACCEPT_{run_id}));',
   357	            ]
   358	        )
   359	    lines.append(f'print("GG__RUN {run_id} END");')
   360	    return lines
   361	

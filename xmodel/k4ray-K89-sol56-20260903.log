   390	    def rows_from_poly(
   391	        self,
   392	        poly: Mapping[tuple[int, int], sp.Expr],
   393	        *,
   394	        stage: str,
   395	        family: str,
   396	        include_zero: bool = False,
   397	    ) -> list[BandRow]:
   398	        rows: list[BandRow] = []
   399	        for (i, j), coefficient in sorted(poly.items(), key=lambda item: (-(sum(item[0])), item[0])):
   400	            coefficient = clean_coefficient(coefficient)
   401	            if coefficient == 0 and not include_zero:
   402	                continue
   403	            # Singular finite-characteristic rings do not accept a polynomial
   404	            # divided by a number (``p/2``).  Clearing a row by its positive
   405	            # rational denominator is ideal-preserving away from the recorded
   406	            # bad primes and is also harmless over Q.
   407	            row_denominator = denominator_lcm((coefficient,))
   408	            coefficient = clean_coefficient(row_denominator * coefficient)
   409	            self.row_denominators.append(row_denominator)
   410	            rows.append(
   411	                BandRow(
   412	                    label=f"{family}_x{i}_y{j}",
   413	                    band=f"{stage}_{family}",
   414	                    degree=i + j,
   415	                    expr=singular_expr(coefficient),
   416	                    source={
   417	                        "kind": family,
   418	                        "stage": stage,
   419	                        "x_power": i,
   420	                        "y_power": j,
   421	                        "xy_degree": i + j,
   422	                        "cleared_rational_denominator": row_denominator,
   423	                    },
   424	                )
   425	            )
   426	        return rows
   427	
   428	    def row_from_expression(
   429	        self,
   430	        expression: sp.Expr,
   431	        *,
   432	        stage: str,
   433	        family: str,
   434	        index: int,
   435	        source: Mapping[str, Any],
   436	    ) -> BandRow:
   437	        expression = clean_coefficient(expression)
   438	        row_denominator = denominator_lcm((expression,))
   439	        expression = clean_coefficient(row_denominator * expression)
   440	        self.row_denominators.append(row_denominator)
   441	        return BandRow(
   442	            label=f"{family}_compat_{index}",
   443	            band=f"{stage}_{family}",
   444	            degree=int(source.get("recurrence_index", 0)),
   445	            expr=singular_expr(expression),
   446	            source={
   447	                **source,
   448	                "kind": family,
   449	                "stage": stage,
   450	                "compatibility_index": index,
   451	                "cleared_rational_denominator": row_denominator,
   452	            },
   453	        )

   572	def main() -> None:
   573	    parser = argparse.ArgumentParser(description=__doc__)
   574	    sub = parser.add_subparsers(dest="cmd", required=True)
   575	
   576	    p_meta = sub.add_parser("meta")
   577	    p_meta.add_argument("K", type=int)
   578	    p_meta.add_argument("--b", type=int)
   579	    p_meta.add_argument("--s", type=int)
   580	
   581	    p_count = sub.add_parser("count")
   582	    p_count.add_argument("tag")
   583	    p_count.add_argument("K", type=int)
   584	    p_count.add_argument("--b", type=int)
   585	    p_count.add_argument("--s", type=int)
   586	    p_count.add_argument("--char", type=int, default=0)
   587	    p_count.add_argument("--tk", type=int, default=4)
   588	    p_count.add_argument("--timeout", type=int, default=240)
   589	    p_count.add_argument("--no-theorem", action="store_true")
   590	    p_count.add_argument("--no-rho-level4", action="store_true")
   591	
   592	    p_run = sub.add_parser("run")
   593	    p_run.add_argument("tag")
   594	    p_run.add_argument("K", type=int)
   595	    p_run.add_argument("--b", type=int)
   596	    p_run.add_argument("--s", type=int)
   597	    p_run.add_argument("--chars", default="0")
   598	    p_run.add_argument("--tk", type=int, default=4)
   599	    p_run.add_argument("--timeout", type=int, default=900)
   600	    p_run.add_argument("--count-timeout", type=int, default=240)
   601	    p_run.add_argument("--cores", type=int, default=4)
   602	    p_run.add_argument("--no-theorem", action="store_true")
   603	    p_run.add_argument("--no-rho-level4", action="store_true")
   604	
   605	    p_batch = sub.add_parser("batch-main")
   606	    p_batch.add_argument("--timeout", type=int, default=900)
   607	    p_batch.add_argument("--count-timeout", type=int, default=240)
   608	    p_batch.add_argument("--cores", type=int, default=4)
   609	
   610	    p_ctrl = sub.add_parser("controls")
   611	    p_ctrl.add_argument("--timeout", type=int, default=300)
   612	    p_ctrl.add_argument("--cores", type=int, default=4)
   613	
   614	    sub.add_parser("summarize")
   615	
   616	    args = parser.parse_args()
   617	    if args.cmd == "meta":
   618	        print(json.dumps(pinned_metadata(args.K, args.b, args.s), indent=2, sort_keys=True))
   619	    elif args.cmd == "count":
   620	        prelude, _names, _weights, meta = pinned_prelude(
   621	            args.K,
   622	            b=args.b,
   623	            s=args.s,
   624	            ch=args.char,
   625	            tk=args.tk,
   626	            theorem_cut=not args.no_theorem,
   627	            rho_level4=not args.no_rho_level4,
   628	        )
   629	        info = run_singular_count(prelude, f"{args.tag}_p{args.char}", args.timeout)
   630	        print(json.dumps({"metadata": meta, "count": info}, indent=2, sort_keys=True))
   631	    elif args.cmd == "run":
   632	        run_chart(
   633	            args.tag,
   634	            args.K,
   635	            b=args.b,
   636	            s=args.s,
   637	            chars=parse_chars(args.chars),
   638	            tk=args.tk,
   639	            timeout=args.timeout,
   640	            count_timeout=args.count_timeout,
   641	            cores=args.cores,
   642	            theorem_cut=not args.no_theorem,
   643	            rho_level4=not args.no_rho_level4,
   644	        )

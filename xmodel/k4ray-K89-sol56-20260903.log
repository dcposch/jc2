   147	def localize_mu(expr: sp.Expr, mu: sp.Symbol, mu_inv: sp.Symbol) -> sp.Expr:
   148	    """Replace negative Laurent powers of mu by powers of mu_inv."""
   149	
   150	    numerator, denominator = sp.fraction(sp.cancel(expr))
   151	    if denominator != 1:
   152	        # The only nonconstant denominator allowed is a monomial in mu.
   153	        coefficient, powers = denominator.as_coeff_Mul(), denominator.as_powers_dict()
   154	        exponent = powers.get(mu, sp.Integer(0))
   155	        residual = sp.cancel(denominator / mu**exponent)
   156	        if residual.free_symbols:
   157	            raise ValueError(f"non-Laurent denominator encountered: {denominator}")
   158	        expr = sp.expand(numerator / residual * mu ** (-int(exponent)))
   159	    result: sp.Expr = sp.Integer(0)
   160	    for term in sp.expand(expr).as_ordered_terms():
   161	        exponent_value = term.as_powers_dict().get(mu, sp.Integer(0))
   162	        if not exponent_value.is_Integer:
   163	            raise ValueError(f"nonintegral mu exponent in {term}")
   164	        exponent = int(exponent_value)
   165	        coefficient = sp.cancel(term / mu**exponent)
   166	        result += coefficient * (mu**exponent if exponent >= 0 else mu_inv ** (-exponent))
   167	    return sp.expand(result)
   168	
   169	
   170	def polynomial_coefficients(expr: sp.Expr, x: sp.Symbol, y: sp.Symbol) -> list[sp.Expr]:
   171	    return [sp.expand(coefficient) for _monomial, coefficient in sp.Poly(sp.expand(expr), x, y).terms()]

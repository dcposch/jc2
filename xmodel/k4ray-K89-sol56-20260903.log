   559	def summarize() -> dict[str, Any]:
   560	    summaries: dict[str, Any] = {}
   561	    for path in sorted(RUNS.glob("*/summary.json")):
   562	        summaries[path.parent.name] = json.loads(path.read_text(encoding="utf-8"))
   563	    atomic_write(HERE / "summary-all.json", json.dumps(summaries, indent=2, sort_keys=True) + "\n")
   564	    print(json.dumps({"summary_count": len(summaries), "tags": sorted(summaries)}, sort_keys=True))

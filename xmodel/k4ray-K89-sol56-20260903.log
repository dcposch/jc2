+internal B
+  metadata file sha256  4312d20c5c7f986dd7ce81321d4afe12e49b6ff3da4dbeab702eb98b29b499b2
+  semantic chart sha256 b9ba580e7f81991a9dae0e08efe17271a68e884535b45e97c1bd9d96b236c1ff
+  manifest sha256       bc481516a62a23f2138d8dcecb8c0c0a9ca0e3cb1c27272e6d470d3cf1748cd6

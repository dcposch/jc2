   870	            tuple(int(piece) for piece in args.weights.split(",") if piece),
   871	            args.length,
   872	        )
   873	    weights = tuple(int(piece) for piece in args.weights.split(",") if piece) if args.weights else ()
   874	    system = SingularSystem(
   875	        name=args.name,
   876	        prelude=args.prelude.read_text(encoding="utf-8"),
   877	        generators=tuple(piece.strip() for piece in args.generators.split(",") if piece.strip()),
   878	        characteristic=args.char,

   260	
   261	def run_singular_count(prelude: str, tag: str, timeout: int) -> dict[str, Any]:
   262	    RUNS.mkdir(parents=True, exist_ok=True)
   263	    cache = RUNS / f"{tag}.rowcount.json"
   264	    script = RUNS / f"{tag}.count.sing"
   265	    atomic_write(script, prelude + '\nprint("PRE__ROWS_FINAL "+string(size(ROWS)));\nquit;\n')
   266	    t0 = time.time()
   267	    cmd = ["stdbuf", "-oL", "-eL", "Singular", "--no-rc", "-q", str(script)]
   268	    try:
   269	        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=False)
   270	        stdout = proc.stdout
   271	        stderr = proc.stderr
   272	        timed_out = False
   273	        returncode = proc.returncode
   274	    except subprocess.TimeoutExpired as exc:
   275	        stdout = exc.stdout or ""
   276	        stderr = exc.stderr or ""
   277	        if isinstance(stdout, bytes):
   278	            stdout = stdout.decode("utf-8", errors="replace")
   279	        if isinstance(stderr, bytes):
   280	            stderr = stderr.decode("utf-8", errors="replace")
   281	        timed_out = True
   282	        returncode = None
   283	    atomic_write(RUNS / f"{tag}.count.out", stdout)
   284	    atomic_write(RUNS / f"{tag}.count.err", stderr)
   285	    markers: dict[str, str] = {}
   286	    for line in stdout.splitlines():
   287	        if line.startswith("PRE__"):
   288	            parts = line.split(maxsplit=1)
   289	            markers[parts[0]] = parts[1] if len(parts) > 1 else ""
   290	    info = {
   291	        "tag": tag,
   292	        "wall": round(time.time() - t0, 3),
   293	        "timed_out": timed_out,
   294	        "returncode": returncode,
   295	        "n": int(markers["PRE__ROWS_FINAL"]) if "PRE__ROWS_FINAL" in markers else None,
   296	        "markers": markers,
   297	    }
   298	    atomic_write(cache, json.dumps(info, indent=2, sort_keys=True) + "\n")
   299	    return info
   300	

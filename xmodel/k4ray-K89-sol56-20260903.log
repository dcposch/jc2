   442	                assert zeta is not None
   443	                omega = cp_mul(v, zeta)
   444	            h3_numerator = cp_add(
   445	                omega,
   446	                cp_scale(cp_mul(cp_mul(chi, v), Y(3)), 36),
   447	                cp_scale(cp_mul(pbands[3], Y(2)), 24 * mu**2),
   448	                cp_scale(cp_mul(cp_pow(v, 2), tau), -18),
   449	                cp_scale(Y(6), -8 * kappa),
   450	            )
   451	            hbands[3] = cp_scale(h3_numerator, sp.Rational(1, 16) * mi**3)
   452	
   453	        for index in range(4, K + 1):
   454	            hbands[index] = self.form(f"h{index}", K - index, index)
   455	
   456	        # The monic equation from PIN12 has been used as a parametrization.
   457	        if hbands[1].get((0, K - 1), 0) != 0:
   458	            raise AssertionError("the pure y^(K-1) h coefficient was not eliminated")
   459	
   460	        sb, tb = self.recurrence_parts(hbands, pbands)
   461	        q: dict[int, CoordPoly] = {
   462	            0: cp_scale(cp_shift(self.L, 0, K - 7), mu**3),
   463	            1: cp_scale(tau, 3 * mu**2),
   464	            2: cp_scale(chi, 3 * mu),
   465	        }
   466	        if K == 8:
   467	            q[3] = {}
   468	        else:
   469	            assert kappa is not None
   470	            q[3] = {(0, 0): kappa}
   471	            q[4] = {}
   472	            q[5] = {}
   473	
   474	        def recurrence_n(n: int) -> CoordPoly:
   475	            pieces = [tb(n)]
   476	            for index in range(1, n + 1):
   477	                qband = q.get(n - index, {})
   478	                if qband:
   479	                    pieces.append(cp_scale(cp_mul(sb(index), qband), -1))
   480	            return cp_add(*pieces)
   481	
   482	        controls: dict[str, Any] = {
   483	            "source_note": str(HERE / "structure-note.md"),
   484	            "beta_scale_not_B_scale": True,
   485	            "PIN12_monic_relation_built_in": True,
   486	            "mu_not_fixed": True,
   487	        }
   488	        controls["REC1"] = self.assert_localized_zero(
   489	            cp_add(recurrence_n(1), cp_scale(cp_mul(cp_pow(self.H, 2), q[1]), -1)),
   490	            "REC1",
   491	        )
   492	        controls["REC2"] = self.assert_localized_zero(
   493	            cp_add(recurrence_n(2), cp_scale(cp_mul(cp_pow(self.H, 2), q[2]), -1)),
   494	            "REC2",
   495	        )
   496	        if K == 8:
   497	            controls["K8_H3_REC3"] = self.assert_localized_zero(recurrence_n(3), "K8-H3")
   498	            theta = cp_scale(
   499	                cp_mul(
   500	                    cp_shift(cp_pow(self.L, 2), 0, 8),
   501	                    {
   502	                        (4, 0): 195,
   503	                        (3, 1): 240,
   504	                        (2, 2): 320,
   505	                        (1, 3): 512,
   506	                        (0, 4): 2048,
   507	                    },
   508	                ),
   509	                sp.Rational(1, 6630),
   510	            )
   511	            terminal_polys = [("K8_REC4_THETA", cp_add(recurrence_n(4), cp_scale(theta, -1)))]
   512	        else:
   513	            controls["K9_H3_REC3"] = self.assert_localized_zero(
   514	                cp_add(recurrence_n(3), cp_scale(cp_mul(cp_pow(self.H, 2), q[3]), -1)),
   515	                "K9-H3",
   516	            )
   517	            split_left = cp_mul(v, cp_add(cp_mul(self.L, cp_pow(v, 2)), cp_scale(pbands[2], -12 * mu)))
   518	            if self.branch == "A":
   519	                controls["K9_SPLIT"] = "A:v=y*w_BUILT_IN"
   520	            else:
   521	                assert zeta is not None
   522	                controls["K9_SPLIT"] = self.assert_localized_zero(
   523	                    cp_add(split_left, cp_scale(cp_mul(cp_mul(v, Y(1)), zeta), -1)),
   524	                    "K9-SPLIT-B",
   525	                )
   526	            theta = cp_scale(
   527	                cp_mul(
   528	                    cp_shift(cp_pow(self.L, 2), 0, 9),
   529	                    {
   530	                        (4, 0): 35,
   531	                        (3, 1): 42,
   532	                        (2, 2): 54,
   533	                        (1, 3): 81,
   534	                        (0, 4): 243,
   535	                    },
   536	                ),
   537	                sp.Rational(1, 1365),
   538	            )
   539	            terminal_polys = [
   540	                ("K9_REC4_ZERO", recurrence_n(4)),
   541	                ("K9_REC5_ZERO", recurrence_n(5)),
   542	                ("K9_REC6_THETA", cp_add(recurrence_n(6), cp_scale(theta, -1))),
   543	            ]
   544	
   545	        rows_by_stage: dict[str, list[BandRow]] = {"terminal": [], "rho": [], "jacobian": []}
   546	        for family, polynomial in terminal_polys:
   547	            rows_by_stage["terminal"].extend(
   548	                self.rows_from_poly(polynomial, stage="terminal", family=family)
   549	            )
   550	
   551	        h = self.band_sum(hbands)
   552	        beta = self.band_sum(pbands)
   553	        alpha: CoordPoly = {}
   554	        rho: CoordPoly = {}
   555	        if self.through in ("rho", "jacobian"):
   556	            alpha, rho = cp_quoy(cp_mul(beta, beta), h, K)
   557	            if rho and max(j for _i, j in rho) >= K:
   558	                raise AssertionError("quoy remainder did not have y-degree < K")
   559	            controls["QUOY_IDENTITY"] = "PASS_BY_EXACT_DICTIONARY_DIVISION"
   560	            controls["RHO_Y_DEGREE_LT_K"] = max((j for _i, j in rho), default=-1)
   561	
   562	            if K == 8:
   563	                rho_forced = cp_add(
   564	                    cp_scale(cp_shift(self.L, 0, 1), sp.Rational(1, 3) * mu**3),
   565	                    cp_scale(tau, mu**2),
   566	                )
   567	                lowest_pinned = 1
   568	            else:
   569	                rho_forced = cp_add(
   570	                    cp_scale(cp_shift(self.L, 0, 2), sp.Rational(1, 3) * mu**3),
   571	                    cp_scale(tau, mu**2),
   572	                    cp_scale(chi, mu),
   573	                )
   574	                lowest_pinned = 1
   575	            rho_difference = cp_add(rho, cp_scale(rho_forced, -1))
   576	            pinned_rho_difference = {
   577	                monomial: coefficient
   578	                for monomial, coefficient in rho_difference.items()
   579	                if sum(monomial) >= lowest_pinned
   580	            }
   581	            rows_by_stage["rho"] = self.rows_from_poly(
   582	                pinned_rho_difference, stage="rho", family="ACTUAL_RHO_MATCH"
   583	            )
   584	            controls["rho_matches_added_through_degree"] = lowest_pinned
   585	            controls["rho_degree_bound"] = K - 6
   586	
   587	        if self.through == "jacobian":
   588	            jb_a = cp_add(
   589	                cp_mul(cp_diff(beta, "x"), cp_diff(alpha, "y")),
   590	                cp_scale(cp_mul(cp_diff(beta, "y"), cp_diff(alpha, "x")), -1),
   591	            )
   592	            jh_r = cp_add(
   593	                cp_mul(cp_diff(h, "x"), cp_diff(rho, "y")),
   594	                cp_scale(cp_mul(cp_diff(h, "y"), cp_diff(rho, "x")), -1),
   595	            )
   596	            jacobian = cp_scale(cp_add(jb_a, cp_scale(jh_r, -1)), 3)
   597	            target_seen = (4, 0) in jacobian
   598	            if not target_seen:
   599	                raise AssertionError("the x^4 Jacobian coefficient is absent")
   600	            jacobian_rows_poly = dict(jacobian)
   601	            jacobian_rows_poly[(4, 0)] = jacobian_rows_poly[(4, 0)] - 1
   602	            rows_by_stage["jacobian"] = self.rows_from_poly(
   603	                jacobian_rows_poly, stage="jacobian", family="FULL_ID6_CST1"
   604	            )
   605	            controls["ID6_formula"] = "3*(J(beta,alpha)-J(h,rho))"
   606	            controls["CST_equation"] = "coeff_x4(J)-1"
   607	            controls["all_other_J_coefficients_zero"] = True
   608	
   609	        all_expressions = [
   610	            sp.sympify(row.expr.replace("^", "**"))
   611	            for stage_rows in rows_by_stage.values()
   612	            for row in stage_rows
   613	        ]
   614	        all_expressions.append(mu * mi - 1)
   615	        den_lcm = denominator_lcm(all_expressions)
   616	        x, y = self.x, self.y
   617	        reconstruction = {
   618	            "h": singular_expr(cp_expr(h, x, y)),
   619	            "beta": singular_expr(cp_expr(beta, x, y)),
   620	            "alpha": singular_expr(cp_expr(alpha, x, y)) if alpha else "NOT_BUILT",
   621	            "rho": singular_expr(cp_expr(rho, x, y)) if rho else "NOT_BUILT",
   622	            "theta": singular_expr(cp_expr(theta, x, y)),
   623	        }
   624	        fingerprint_payload = json.dumps(
   625	            {
   626	                "K": K,
   627	                "branch": self.branch,
   628	                "variables": [str(symbol) for symbol in self.variables],
   629	                "weights": [self.weights[symbol] for symbol in self.variables],
   630	                "rows": [
   631	                    (stage, row.label, row.degree, row.expr)
   632	                    for stage, stage_rows in rows_by_stage.items()
   633	                    for row in stage_rows
   634	                ],
   635	                "localizer": singular_expr(mu * mi - 1),
   636	            },
   637	            sort_keys=True,
   638	            separators=(",", ":"),
   639	        )
   640	        return ExplicitChart(
   641	            K=K,
   642	            branch=self.branch,
   643	            variables=[str(symbol) for symbol in self.variables],
   644	            weights=[self.weights[symbol] for symbol in self.variables],
   645	            rows_by_stage=rows_by_stage,
   646	            h=reconstruction["h"],
   647	            beta=reconstruction["beta"],
   648	            alpha=reconstruction["alpha"],
   649	            rho=reconstruction["rho"],
   650	            theta=reconstruction["theta"],
   651	            formula_controls=controls,
   652	            denominator_lcm=den_lcm,
   653	            chart_sha256=sha256_text(fingerprint_payload),
   654	            build_seconds=round(time.monotonic() - started, 6),
   655	        )
   656	
   657	
   658	def ordered_ring(chart: ExplicitChart, characteristic: int) -> tuple[str, list[str], list[int]]:
   659	    pairs = sorted(
   660	        zip(chart.variables, chart.weights), key=lambda item: (-item[1], item[0])
   661	    )
   662	    names = [name for name, _weight in pairs]
   663	    weights = [weight for _name, weight in pairs]
   664	    ring = f"ring SS={characteristic},({','.join(names)}),wp({','.join(str(w) for w in weights)});"
   665	    return ring, names, weights
   666	
   667	
   668	def emit_chart(chart: ExplicitChart, output_dir: Path, characteristic: int) -> dict[str, Any]:
   669	    if characteristic and chart.denominator_lcm % characteristic == 0:
   670	        raise ValueError(f"bad prime {characteristic} divides denominator lcm")
   671	    ring, names, weights = ordered_ring(chart, characteristic)
   672	    rows = chart.rows_through("jacobian")
   673	    config = BandEmitConfig(
   674	        output_dir=output_dir,
   675	        ring=ring,
   676	        option_lines=("option(redSB);", "short=0;"),
   677	        global_generators=(("mu_localizer", "mu*mu_inv-1"),),
   678	        manifest_name="bands-manifest.json",
   679	    )
   680	    manifest = emit_staged_band_files(rows, config)
   681	    metadata = chart.metadata()
   682	    metadata.update(
   683	        {
   684	            "characteristic": characteristic,
   685	            "solver_ring": ring,
   686	            "solver_variables": names,
   687	            "solver_weights": weights,
   688	            "band_manifest": manifest["manifest_path"],
   689	            "generator_union_checksum": manifest["generator_union_checksum"],
   690	        }
   691	    )
   692	    atomic_write(output_dir / "explicit-chart.json", json.dumps(metadata, indent=2, sort_keys=True) + "\n")
   693	    return manifest
   694	
   695	
   696	def summarize(result: GuidedGBResult) -> dict[str, Any]:
   697	    runs = result.certificate["runs"]
   698	    return {
   699	        "verdict": result.verdict.value,
   700	        "promotion_note": result.certificate["promotion_note"],
   701	        "accepted_run_count": result.certificate["accepted_run_count"],
   702	        "runs": [
   703	            {
   704	                "characteristic": run["characteristic"],
   705	                "returncode": run["returncode"],
   706	                "timed_out": run["timed_out"],
   707	                "elapsed_seconds": run["elapsed_seconds"],
   708	                "unit": run["main"]["unit"],
   709	                "dimension": run["main"]["dimension"],
   710	                "vdim": run["main"]["vdim"],
   711	                "basis_size": run["main"]["basis_size"],
   712	                "nf_all_zero": run["main"]["nf_all_zero"],
   713	                "accepted": run["main"]["accepted"],
   714	                "missing_markers": run["main"]["missing_markers"],
   715	                "script": run["script"],
   716	                "stdout": run["stdout"],
   717	            }
   718	            for run in runs
   719	        ],
   720	    }
   721	
   722	
   723	def run_one_prefix(
   724	    chart: ExplicitChart,
   725	    stage: str,
   726	    characteristic: int,
   727	    output_dir: Path,
   728	    timeout: int,
   729	) -> GuidedGBResult:
   730	    ring, names, _weights = ordered_ring(chart, characteristic)
   731	    rows = chart.rows_through(stage)
   732	    generators = [row.expr for row in rows] + ["mu*mu_inv-1"]
   733	    system = SingularSystem(
   734	        name=f"K{chart.K}_{chart.branch}_{stage}_p{characteristic}",
   735	        prelude="\n".join(("option(redSB); short=0;", ring, 'print("EXPLICIT__PRELUDE_DONE 1");')),
   736	        generators=tuple(generators),
   737	        characteristic=characteristic,
   738	        variables=tuple(names),
   739	        homogeneous=False,
   740	        positive_weights=(),
   741	        metadata={
   742	            "K": chart.K,
   743	            "branch": chart.branch,
   744	            "stage": stage,
   745	            "row_count_without_localizer": len(rows),
   746	            "chart_sha256": chart.chart_sha256,
   747	            "inhomogeneous_localization": True,
   748	            "CST1_included": stage == "jacobian",
   749	        },
   750	    )
   751	    return guided_groebner(
   752	        system,
   753	        hint=None,
   754	        policy=PromotionPolicy.exact_q(
   755	            "inhomogeneous explicit lower-band chart; modular units are F_p-only"
   756	        ),
   757	        config=RunConfig(
   758	            output_dir=output_dir,
   759	            timeout_seconds=timeout,
   760	            total_cores=1,
   761	            max_parallel_jobs=1,
   762	            run_perturbed_control=False,
   763	            no_rc=True,
   764	        ),
   765	    )
   766	
   767	
   768	def run_stages(
   769	    chart: ExplicitChart,
   770	    tag: str,
   771	    primes: Sequence[int],
   772	    timeout: int,
   773	    through: str,
   774	    exact_confirm: bool,
   775	) -> dict[str, Any]:
   776	    if not 1 <= timeout <= MAX_TIMEOUT:
   777	        raise ValueError(f"timeout must lie in [1,{MAX_TIMEOUT}]")
   778	    for prime in primes:
   779	        if prime in (2, 3) or chart.denominator_lcm % prime == 0:
   780	            raise ValueError(f"bad prime {prime}")
   781	    base = RUNS / tag
   782	    emit_chart(chart, base / "emitted_Q", 0)
   783	    for prime in primes:
   784	        emit_chart(chart, base / f"emitted_p{prime}", prime)
   785	
   786	    order = ("terminal", "rho", "jacobian")
   787	    endpoint = order.index(through)
   788	    stage_summaries: list[dict[str, Any]] = []
   789	    exact_result: dict[str, Any] | None = None
   790	    first_all_prime_unit: dict[str, Any] | None = None
   791	    started = time.monotonic()
   792	    for stage in order[: endpoint + 1]:
   793	        prime_results: list[dict[str, Any]] = []
   794	        for prime in primes:
   795	            result = run_one_prefix(
   796	                chart,
   797	                stage,
   798	                prime,
   799	                base / "modular" / stage / f"p{prime}",
   800	                timeout,
   801	            )
   802	            prime_results.append(summarize(result))
   803	            atomic_write(
   804	                base / "stage-progress.json",
   805	                json.dumps(stage_summaries + [{"stage": stage, "prime_results": prime_results}], indent=2, sort_keys=True)
   806	                + "\n",
   807	            )
   808	        runs = [item for summary in prime_results for item in summary["runs"]]
   809	        all_prime_unit = bool(runs) and len(runs) == len(primes) and all(
   810	            run["characteristic"] > 0
   811	            and run["returncode"] == 0
   812	            and not run["timed_out"]
   813	            and run["unit"]
   814	            and run["nf_all_zero"]
   815	            and not run["missing_markers"]
   816	            for run in runs
   817	        )
   818	        stage_summary = {
   819	            "stage": stage,
   820	            "cumulative_row_count": len(chart.rows_through(stage)),
   821	            "prime_results": prime_results,
   822	            "all_requested_primes_unit": all_prime_unit,
   823	            "modular_scope": "F_p-only",
   824	        }
   825	        stage_summaries.append(stage_summary)
   826	        atomic_write(base / "stage-progress.json", json.dumps(stage_summaries, indent=2, sort_keys=True) + "\n")
   827	        if all_prime_unit:
   828	            first_all_prime_unit = {
   829	                "stage": stage,
   830	                "primes": list(primes),
   831	                "status": "UNIT_IN_EVERY_REQUESTED_FIBRE__FP_ONLY",
   832	            }
   833	            if exact_confirm:
   834	                exact = run_one_prefix(chart, stage, 0, base / "exact" / stage, timeout)
   835	                exact_result = {"stage": stage, **summarize(exact)}
   836	            break
   837	
   838	    verdict = "OPEN"
   839	    if exact_result is not None:
   840	        verdict = exact_result["verdict"]
   841	    elif first_all_prime_unit is not None:
   842	        verdict = "MODULAR_ONLY"
   843	    elif any(
   844	        run["timed_out"]
   845	        for stage in stage_summaries
   846	        for result in stage["prime_results"]
   847	        for run in result["runs"]
   848	    ):
   849	        verdict = "INCONCLUSIVE_TIMEOUT"
   850	    summary = {
   851	        "type": "K4RAY-EXPLICIT-STAGED-GUIDED-GB",
   852	        "tag": tag,
   853	        "K": chart.K,
   854	        "branch": chart.branch,
   855	        "chart_sha256": chart.chart_sha256,
   856	        "primes": list(primes),
   857	        "per_call_timeout_seconds": timeout,
   858	        "total_cores": 1,
   859	        "stage_summaries": stage_summaries,
   860	        "first_all_prime_unit": first_all_prime_unit,
   861	        "exact_result": exact_result,
   862	        "verdict": verdict,
   863	        "elapsed_seconds": round(time.monotonic() - started, 6),
   864	        "no_modular_promotion": True,
   865	    }
   866	    atomic_write(base / "summary.json", json.dumps(summary, indent=2, sort_keys=True) + "\n")
   867	    return summary
   868	
   869	
   870	def parse_primes(text: str) -> tuple[int, ...]:
   871	    return tuple(int(piece) for piece in text.split(",") if piece)
   872	
   873	
   874	def normalized_branch(K: int, branch: str | None) -> str:
   875	    if K == 8:
   876	        return "single"
   877	    if branch not in ("A", "B"):
   878	        raise ValueError("K=9 requires --branch A or --branch B")
   879	    return branch
   880	
   881	
   882	def command_build(args: argparse.Namespace) -> None:
   883	    branch = normalized_branch(args.K, args.branch)
   884	    chart = ChartBuilder(args.K, branch, args.through).build()
   885	    out = RUNS / args.tag / "build"
   886	    atomic_write(out / "explicit-chart.json", json.dumps(chart.metadata(), indent=2, sort_keys=True) + "\n")
   887	    emit_chart(chart, out / "emitted_Q", 0)
   888	    print(
   889	        json.dumps(
   890	            {
   891	                "K": chart.K,
   892	                "branch": chart.branch,
   893	                "variables": len(chart.variables),
   894	                "row_counts": {key: len(value) for key, value in chart.rows_by_stage.items()},
   895	                "denominator_lcm": chart.denominator_lcm,
   896	                "chart_sha256": chart.chart_sha256,
   897	                "build_seconds": chart.build_seconds,
   898	                "metadata": str(out / "explicit-chart.json"),
   899	            },
   900	            sort_keys=True,
   901	        )
   902	    )
   903	
   904	
   905	def command_run(args: argparse.Namespace) -> None:
   906	    branch = normalized_branch(args.K, args.branch)
   907	    chart = ChartBuilder(args.K, branch, args.through).build()
   908	    summary = run_stages(
   909	        chart,
   910	        args.tag,
   911	        parse_primes(args.primes),
   912	        args.timeout,
   913	        args.through,
   914	        args.exact_confirm,
   915	    )
   916	    print(
   917	        json.dumps(
   918	            {
   919	                "tag": args.tag,
   920	                "K": args.K,
   921	                "branch": branch,
   922	                "verdict": summary["verdict"],
   923	                "summary": str(RUNS / args.tag / "summary.json"),
   924	            },
   925	            sort_keys=True,
   926	        )
   927	    )
   928	
   929	
   930	def main() -> None:
   931	    parser = argparse.ArgumentParser(description=__doc__)
   932	    subparsers = parser.add_subparsers(dest="command", required=True)
   933	    for name in ("build", "run"):
   934	        sub = subparsers.add_parser(name)
   935	        sub.add_argument("tag")
   936	        sub.add_argument("K", type=int, choices=(8, 9))
   937	        sub.add_argument("--branch", choices=("A", "B"))
   938	        sub.add_argument("--through", choices=("terminal", "rho", "jacobian"), default="jacobian")
   939	        if name == "run":
   940	            sub.add_argument("--primes", default=",".join(str(prime) for prime in GOOD_PRIMES))


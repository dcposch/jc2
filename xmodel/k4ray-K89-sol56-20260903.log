   341	def run_chart(
   342	    tag: str,
   343	    K: int,
   344	    *,
   345	    b: int | None = None,
   346	    s: int | None = None,
   347	    chars: tuple[int, ...] = (0,),
   348	    tk: int = 4,
   349	    timeout: int = 900,
   350	    count_timeout: int = 240,
   351	    cores: int = 4,
   352	    theorem_cut: bool = True,
   353	    rho_level4: bool = True,
   354	) -> dict[str, Any]:
   355	    if cores < 1 or cores > 4:
   356	        raise ValueError("cores must be between 1 and 4")
   357	    systems: list[SingularSystem] = []
   358	    counts: list[dict[str, Any]] = []
   359	    metas: list[dict[str, Any]] = []
   360	    for ch in chars:
   361	        system, info, meta = build_system(
   362	            tag,
   363	            K,
   364	            b=b,
   365	            s=s,
   366	            ch=ch,
   367	            tk=tk,
   368	            theorem_cut=theorem_cut,
   369	            rho_level4=rho_level4,
   370	            count_timeout=count_timeout,
   371	        )
   372	        counts.append(info)
   373	        metas.append(meta)
   374	        if system is not None:
   375	            systems.append(system)
   376	    if not systems:
   377	        summary = {"tag": tag, "K": K, "verdict": "PRELUDE_FAILED", "counts": counts, "metadata": metas}
   378	        out_dir = RUNS / tag
   379	        atomic_write(out_dir / "summary.json", json.dumps(summary, indent=2, sort_keys=True) + "\n")
   380	        print(json.dumps(summary, sort_keys=True))
   381	        return summary
   382	
   383	    cfg = RunConfig(
   384	        output_dir=RUNS / tag,
   385	        timeout_seconds=timeout,
   386	        total_cores=cores,
   387	        max_parallel_jobs=min(len(systems), cores),
   388	        run_perturbed_control=False,
   389	    )
   390	    t0 = time.time()
   391	    result = guided_groebner(
   392	        systems,
   393	        hint=None,
   394	        policy=PromotionPolicy.exact_q("pinned k4 ray dehomogenised/localised residual chart"),
   395	        config=cfg,
   396	    )
   397	    wall = round(time.time() - t0, 3)
   398	    summary = {
   399	        "tag": tag,
   400	        "K": K,
   401	        "b": metas[0]["b"],
   402	        "s": metas[0]["s"],
   403	        "chars": list(chars),
   404	        "target": f"x^{tk}",
   405	        "theorem_cut": theorem_cut,
   406	        "rho_level4": rho_level4,
   407	        "counts": counts,
   408	        "metadata": metas[0],
   409	        "extra_generators": ["CSTP-1", "mu*mu_inv-1"],
   410	        "wall": wall,
   411	        "verdict": result.verdict.value,
   412	        "promotion_note": result.certificate["promotion_note"],
   413	        "accepted_run_count": result.certificate["accepted_run_count"],
   414	        "runs": [
   415	            {
   416	                "label": run["label"],
   417	                "char": run["characteristic"],
   418	                "unit": run["main"]["unit"],
   419	                "dimension": run["main"]["dimension"],
   420	                "vdim": run["main"]["vdim"],
   421	                "basis_size": run["main"]["basis_size"],
   422	                "nf_all_zero": run["main"]["nf_all_zero"],
   423	                "timed_out": run["timed_out"],
   424	                "returncode": run["returncode"],
   425	                "elapsed_seconds": run["elapsed_seconds"],
   426	                "stdout_sha256": run["stdout_sha256"],
   427	                "script_sha256": run["script_sha256"],
   428	            }
   429	            for run in result.certificate["runs"]
   430	        ],
   431	        "crt_rational_reconstruction": result.certificate["crt_rational_reconstruction"],
   432	    }
   433	    atomic_write(RUNS / tag / "summary.json", json.dumps(summary, indent=2, sort_keys=True) + "\n")
   434	    print(json.dumps(summary, sort_keys=True))
   435	    return summary

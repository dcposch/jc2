   241	def prelude_from_script(path: Path, stop_regex: str = r"^intvec TARGET_HNUM=") -> str:
   242	    """Return a script prefix ending before the first matching line."""
   243	
   244	    pattern = re.compile(stop_regex)
   245	    lines: list[str] = []
   246	    with path.open(encoding="utf-8", errors="replace") as handle:
   247	        for line in handle:
   248	            if pattern.search(line):
   249	                break
   250	            lines.append(line.rstrip("\n"))
   251	    if not lines:
   252	        raise ValueError(f"no prelude read from {path}")
   253	    return "\n".join(lines).rstrip() + "\n"

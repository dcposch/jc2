   225	        "h_variable_count": len(h_symbols),
   226	        "rank": len(pivots),
   227	        "pivot_variables": [str(h_symbols[column]) for column in pivots],
   228	        "free_h_variables": [str(h_symbols[column]) for column in free_columns],
   229	        "compatibility_count": len(compatibility),
   230	    }
   231	    return substitutions, compatibility, audit

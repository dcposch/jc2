   214	def sha256_text(text: str) -> str:
   215	    return hashlib.sha256(text.encode("utf-8")).hexdigest()
   216	
   217	
   218	def sha256_file(path: Path) -> str:
   219	    digest = hashlib.sha256()
   220	    with path.open("rb") as handle:
   221	        for block in iter(lambda: handle.read(1 << 20), b""):
   222	            digest.update(block)
   223	    return digest.hexdigest()
   224	
   225	
   226	def atomic_write(path: Path, payload: str) -> None:
   227	    path.parent.mkdir(parents=True, exist_ok=True)
   228	    temporary = path.with_name(path.name + ".tmp")
   229	    temporary.write_text(payload, encoding="utf-8")
   230	    temporary.replace(path)
   231	

   340	def quotient_remainder_y(
   341	    numerator: sp.Expr, denominator: sp.Expr, y: sp.Symbol, degree_y: int
   342	) -> tuple[sp.Expr, sp.Expr]:
   343	    """Monic long division in y, with all other symbols in the coefficient ring."""
   344	
   345	    quotient: sp.Expr = sp.Integer(0)
   346	    remainder = sp.expand(numerator)
   347	    while remainder != 0:
   348	        polynomial = sp.Poly(remainder, y)
   349	        degree = int(polynomial.degree())
   350	        if degree < degree_y:
   351	            break
   352	        leader = polynomial.coeff_monomial(y**degree)
   353	        term = leader * y ** (degree - degree_y)
   354	        quotient += term
   355	        remainder = sp.expand(remainder - term * denominator)
   356	    return sp.expand(quotient), sp.expand(remainder)

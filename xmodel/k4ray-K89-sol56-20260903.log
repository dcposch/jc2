   438	def positive_control(timeout: int, cores: int) -> dict[str, Any]:
   439	    tag = "CTRL_TAME_K1"
   440	    prelude = "\n".join(
   441	        [
   442	            "option(redSB); short=0;",
   443	            "ring RR = 0,(x,y,mu,mu_inv),dp;",
   444	            "poly h = y-x;",
   445	            "poly beta = mu*x;",
   446	            "poly f = h^2 + 2*beta;",
   447	            "poly g = h^3 + 3*beta*h;",
   448	            "poly JJ = diff(f,x)*diff(g,y)-diff(f,y)*diff(g,x);",
   449	            'print("PRE__CTRL_J "+string(JJ));',
   450	            "matrix CJ = coef(JJ,x*y);",
   451	            "ideal I0; poly CST=0; int ii;",
   452	            "for (ii=1; ii<=ncols(CJ); ii++)",
   453	            "{",
   454	            "  if (CJ[1,ii]==x) { CST=CJ[2,ii]; }",
   455	            "  else { if (CJ[2,ii] != 0) { I0=I0+ideal(CJ[2,ii]); } }",
   456	            "}",
   457	            "I0=simplify(I0,2);",
   458	            'print("PRE__NROWS "+string(size(I0)));',
   459	            "ring SS = 0,(mu,mu_inv),dp;",
   460	            "ideal ROWS=imap(RR,I0); poly CSTP=imap(RR,CST);",
   461	            'print("PRE__CST_ZERO "+string(CSTP==0));',
   462	            'print("PRE__PRELUDE_DONE 1");',
   463	        ]
   464	    )
   465	    info = run_singular_count(prelude, f"{tag}_p0", 60)
   466	    generators = [f"ROWS[{idx}]" for idx in range(1, (info["n"] or 0) + 1)]
   467	    generators.extend(["CSTP-1", "mu*mu_inv-1"])
   468	    system = SingularSystem(
   469	        name=f"{tag}_p0",
   470	        prelude=prelude,
   471	        generators=tuple(generators),
   472	        characteristic=0,
   473	        variables=("mu", "mu_inv"),
   474	        homogeneous=False,
   475	        metadata={"control": "tame two-point survivor", "J": "6*mu^2*x"},
   476	    )
   477	    result = guided_groebner(
   478	        system,
   479	        policy=PromotionPolicy.exact_q("tame two-point survivor must not be killed"),
   480	        config=RunConfig(RUNS / tag, timeout_seconds=timeout, total_cores=cores, run_perturbed_control=False),
   481	    )
   482	    summary = {
   483	        "tag": tag,
   484	        "verdict": result.verdict.value,
   485	        "promotion_note": result.certificate["promotion_note"],
   486	        "counts": info,
   487	        "runs": [
   488	            {
   489	                "dimension": run["main"]["dimension"],
   490	                "vdim": run["main"]["vdim"],
   491	                "unit": run["main"]["unit"],
   492	                "timed_out": run["timed_out"],
   493	                "elapsed_seconds": run["elapsed_seconds"],
   494	            }
   495	            for run in result.certificate["runs"]
   496	        ],
   497	    }
   498	    atomic_write(RUNS / tag / "summary.json", json.dumps(summary, indent=2, sort_keys=True) + "\n")
   499	    print(json.dumps(summary, sort_keys=True))
   500	    return summary

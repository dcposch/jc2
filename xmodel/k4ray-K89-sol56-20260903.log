   840	
   841	def _properness_allowed(systems: Sequence[SingularSystem], policy: PromotionPolicy) -> bool:
   842	    if policy.scope != PromotionScope.HOMOGENEOUS_POSITIVE_WEIGHTS_PROPERNESS:
   843	        return False
   844	    return all(system.homogeneous and all(weight > 0 for weight in system.positive_weights) for system in systems)

   876	def summarized(result: GuidedGBResult) -> dict[str, Any]:
   877	    return {
   878	        "verdict": result.verdict.value,
   879	        "promotion_note": result.certificate["promotion_note"],
   880	        "accepted_run_count": result.certificate["accepted_run_count"],
   881	        "crt_rational_reconstruction": result.certificate["crt_rational_reconstruction"],
   882	        "runs": [
   883	            {
   884	                "label": run["label"],
   885	                "characteristic": run["characteristic"],
   886	                "returncode": run["returncode"],
   887	                "timed_out": run["timed_out"],
   888	                "elapsed_seconds": run["elapsed_seconds"],
   889	                "unit": run["main"]["unit"],
   890	                "dimension": run["main"]["dimension"],
   891	                "vdim": run["main"]["vdim"],
   892	                "basis_size": run["main"]["basis_size"],
   893	                "nf_all_zero": run["main"]["nf_all_zero"],
   894	                "missing_markers": run["main"]["missing_markers"],
   895	                "script": run["script"],
   896	                "script_sha256": run["script_sha256"],
   897	                "stdout": run["stdout"],
   898	                "stdout_sha256": run["stdout_sha256"],
   899	            }
   900	            for run in result.certificate["runs"]
   901	        ],
   902	    }

   186	            add("matrix CR = coef(Rh - Rh_forced_top, x*y);")
   187	            add("for (ii=1; ii<=ncols(CR); ii++)")
   188	            add("{")
   189	            add("  dde = deg(CR[1,ii]);")
   190	            add(f"  if (dde>{rdeg}) {{ if (CR[2,ii] != 0) {{ RHOROWS=RHOROWS+ideal(CR[2,ii]); }} }}")
   191	            add(f"  if (dde=={rdeg}) {{ if (CR[2,ii] != 0) {{ RHOROWS=RHOROWS+ideal(CR[2,ii]); }} }}")
   192	            add("}")
   193	            add("RHOROWS = simplify(RHOROWS,2);")
   194	            add(f'print("PRE__RHO_RDEG {rdeg}");')
   195	            add('print("PRE__RHOLEVEL4_ROWS "+string(size(RHOROWS)));')
   196	            add("I0 = I0 + RHOROWS;")
   197	    else:
   198	        add('print("PRE__RHOLEVEL4_SKIPPED disabled");')
   199	
   200	    add(
   201	        "poly JJ = (3/8)*(diff(B,x)*diff(Al,y)-diff(B,y)*diff(Al,x))"
   202	        " - (3/4)*(diff(h,x)*diff(Rh,y)-diff(h,y)*diff(Rh,x));"
   203	    )
   204	    add('print("PRE__DEG_J "+string(deg(JJ)));')
   205	    add('print("PRE__SIZE_J "+string(size(JJ)));')
   206	    add("matrix CJ = coef(JJ, x*y);")
   207	    add("poly CST = 0; int TARGET_FOUND = 0;")
   208	    add("for (ii=1; ii<=ncols(CJ); ii++)")
   209	    add("{")
   210	    add(f"  if (CJ[1,ii]==x^{tk}) {{ CST=CJ[2,ii]; TARGET_FOUND=1; }}")
   211	    add("  else { if (CJ[2,ii] != 0) { JROWS=JROWS+ideal(CJ[2,ii]); } }")
   212	    add("}")
   213	    add("JROWS = simplify(JROWS,2);")
   214	    add('print("PRE__J_ROWS "+string(size(JROWS))+" TARGET_FOUND "+string(TARGET_FOUND));')
   215	    add("I0 = I0 + JROWS;")
   216	
   217	    if theorem_cut:
   218	        add("poly E64 = 8*B^3 - 48*Rh*h^2 - 72*B*Rh + 9*Al^2;")
   219	        add("poly ELAM = E64 - lam*f;")
   220	        add('print("PRE__DEG_ELAM "+string(deg(ELAM))+" SIZE_ELAM "+string(size(ELAM)));')
   221	        add("matrix CE = coef(ELAM, x*y);")
   222	        add("for (ii=1; ii<=ncols(CE); ii++)")
   223	        add("{")
   224	        add("  dde = deg(CE[1,ii]);")
   225	        add(f"  if (dde>{K+6}) {{ if (CE[2,ii] != 0) {{ EROWS=EROWS+ideal(CE[2,ii]); }} }}")
   226	        add("}")
   227	        add("EROWS = simplify(EROWS,2);")
   228	        add(f'print("PRE__THEOREM_CUTOFF {K+6}");')
   229	        add('print("PRE__THEOREM_ROWS "+string(size(EROWS)));')
   230	        add("I0 = I0 + EROWS;")
   231	    else:
   232	        add('print("PRE__THEOREM_SKIPPED disabled");')
   233	
   234	    add("I0 = simplify(I0,2);")
   235	    add('print("PRE__NROWS "+string(size(I0)));')
   236	    add(f'print("PRE__NPARAMS_GEOM {meta["geometric_parameter_count"]}");')
   237	    add(f'print("PRE__NPARAMS_GB {len(names)}");')
   238	    add(f"ring SS = {ch},({','.join(names)}),wp({','.join(str(weight) for weight in weights)});")
   239	    add("ideal ROWS = imap(RR,I0); poly CSTP = imap(RR,CST);")
   240	    add('print("PRE__CST_ZERO "+string(CSTP==0));')
   241	    add('print("PRE__CST_WT "+string(deg(CSTP)));')
   242	    add('print("PRE__HOMOG_I "+string(homog(ROWS)));')
   243	    add('print("PRE__HOMOG_CST "+string(homog(CSTP)));')
   244	    add('print("PRE__LOCALIZER mu*mu_inv-1");')
   245	    add('print("PRE__PRELUDE_DONE 1");')
   246	    meta = {
   247	        **meta,
   248	        "names": names,
   249	        "weights": weights,
   250	        "gb_parameter_count_without_localizer": len(names) - 1,
   251	        "gb_parameter_count_with_localizer": len(names),
   252	        "lambda_variable_included": theorem_cut,
   253	        "theorem_cut": theorem_cut,
   254	        "rho_level4": rho_level4,
   255	        "target_power": tk,
   256	        "characteristic": ch,
   257	    }
   258	    return "\n".join(lines), names, weights, meta

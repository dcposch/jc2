   455	    def eliminate_terminal_band(
   456	        self,
   457	        polynomial: Mapping[tuple[int, int], sp.Expr],
   458	        pivot_variables: Sequence[sp.Symbol],
   459	        *,
   460	        recurrence_index: int,
   461	    ) -> tuple[dict[sp.Symbol, sp.Expr], list[sp.Expr], dict[str, Any]]:
   462	        """Eliminate a complete h_i band by the invertible mu^3 matrix.
   463	
   464	        The coefficient matrix is mu^3 times a rational constant matrix.
   465	        Pivot formulae use ``mu_inv^3`` and are therefore exact on the retained
   466	        ``mu*mu_inv-1`` localization.  Compatibility rows are not divided by
   467	        mu and remain polynomial over Z after their numeric denominators are
   468	        cleared at emission.
   469	        """
   470	
   471	        equations = [
   472	            clean_coefficient(value)
   473	            for _monomial, value in sorted(polynomial.items())
   474	            if clean_coefficient(value) != 0
   475	        ]
   476	        zero_pivots = {variable: sp.Integer(0) for variable in pivot_variables}
   477	        matrix: list[list[Fraction]] = []
   478	        right: list[sp.Expr] = []
   479	        for equation in equations:
   480	            coefficients = [clean_coefficient(equation.coeff(variable)) for variable in pivot_variables]
   481	            rest = clean_coefficient(equation.xreplace(zero_pivots))
   482	            reconstructed = clean_coefficient(
   483	                rest
   484	                + sum(
   485	                    (coefficient * variable for coefficient, variable in zip(coefficients, pivot_variables)),
   486	                    sp.Integer(0),
   487	                )
   488	            )
   489	            if clean_coefficient(equation - reconstructed) != 0:
   490	                raise AssertionError(f"REC{recurrence_index} is nonlinear in its h-band")
   491	            constant_row: list[Fraction] = []
   492	            for coefficient in coefficients:
   493	                normalized = sp.cancel(coefficient / self.mu**3)
   494	                if not normalized.is_Rational:
   495	                    raise AssertionError(
   496	                        f"REC{recurrence_index} pivot is not mu^3 times Q: {normalized}"
   497	                    )
   498	                normalized = sp.Rational(normalized)
   499	                constant_row.append(Fraction(int(normalized.p), int(normalized.q)))
   500	            matrix.append(constant_row)
   501	            right.append(-rest)
   502	
   503	        rref, transform, pivots = exact_rref_with_transform(matrix)
   504	        transformed_right = transform_expressions(transform, right)
   505	        free_columns = [column for column in range(len(pivot_variables)) if column not in pivots]
   506	        substitutions: dict[sp.Symbol, sp.Expr] = {}
   507	        for row, pivot_column in enumerate(pivots):
   508	            solution = self.mu_inv**3 * transformed_right[row]
   509	            for column in free_columns:
   510	                value = rref[row][column]
   511	                if value:
   512	                    solution -= sp.Rational(value.numerator, value.denominator) * pivot_variables[column]
   513	            substitutions[pivot_variables[pivot_column]] = clean_coefficient(solution)
   514	
   515	        compatibility = [
   516	            clean_coefficient(transformed_right[row])
   517	            for row in range(len(pivots), len(equations))
   518	            if clean_coefficient(transformed_right[row]) != 0
   519	        ]
   520	        audit = {
   521	            "recurrence_index": recurrence_index,
   522	            "equation_count": len(equations),
   523	            "pivot_candidate_count": len(pivot_variables),
   524	            "rank": len(pivots),
   525	            "pivot_variables": [str(pivot_variables[column]) for column in pivots],
   526	            "free_variables": [str(pivot_variables[column]) for column in free_columns],
   527	            "compatibility_count": len(compatibility),
   528	            "matrix_factor": "mu^3",
   529	            "inverse_used": "mu_inv^3",
   530	        }
   531	        return substitutions, compatibility, audit
   532	
   533	    def build(self) -> ExplicitChart:

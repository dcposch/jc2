    97	def homogeneous_form(
    98	    prefix: str, degree: int, weight: int
    99	) -> tuple[sp.Expr, list[sp.Symbol], dict[sp.Symbol, int]]:
   100	    x, y = sp.symbols("x y")
   101	    symbols: list[sp.Symbol] = []
   102	    terms: list[sp.Expr] = []
   103	    weights: dict[sp.Symbol, int] = {}
   104	    for j in range(degree + 1):
   105	        i = degree - j
   106	        symbol = sp.Symbol(f"{prefix}_{i}_{j}")
   107	        symbols.append(symbol)
   108	        weights[symbol] = weight
   109	        terms.append(symbol * x**i * y**j)
   110	    return sp.Add(*terms), symbols, weights
   111	
   112	
   113	def theta(K: int, x: sp.Symbol, y: sp.Symbol) -> sp.Expr:
   114	    coefficients = [sp.Rational(1, 5 * K - 6)]
   115	    for index in range(1, 5):
   116	        factor = 5 - index
   117	        coefficients.append(sp.cancel(factor * K * coefficients[-1] / (factor * K - 6)))
   118	    theta_one = sum(coefficients[index] * x ** (4 - index) * y**index for index in range(5))
   119	    return sp.expand(y**K * (y - x) ** 2 * theta_one)
   120	
   121	
   122	def S(n: int, h: Mapping[int, sp.Expr]) -> sp.Expr:
   123	    return sp.expand(sum((h.get(a, 0) * h.get(n - a, 0) for a in range(n + 1)), sp.Integer(0)))
   124	
   125	
   126	def T(n: int, p: Mapping[int, sp.Expr]) -> sp.Expr:
   127	    result: sp.Expr = sp.Integer(0)
   128	    for a in range(n + 1):
   129	        for b in range(n - a + 1):
   130	            c = n - a - b
   131	            result += p.get(a, 0) * p.get(b, 0) * p.get(c, 0)
   132	    return sp.expand(result)
   133	
   134	
   135	def N(n: int, h: Mapping[int, sp.Expr], p: Mapping[int, sp.Expr], q: Mapping[int, sp.Expr]) -> sp.Expr:
   136	    result = T(n, p)
   137	    for index in range(1, n + 1):
   138	        result -= S(index, h) * q.get(n - index, 0)
   139	    return sp.expand(result)
   140	
   141	
   142	def zero_rational(expr: sp.Expr) -> bool:
   143	    numerator, _denominator = sp.fraction(sp.cancel(expr))
   144	    return sp.expand(numerator) == 0
   145	

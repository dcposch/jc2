   549	def run_controls(timeout: int, cores: int) -> list[dict[str, Any]]:
   550	    outputs = []
   551	    outputs.append(run_chart("CTRL_PIN_K4_B3", 4, b=3, s=2, timeout=timeout, count_timeout=120, cores=cores))
   552	    outputs.append(run_chart("CTRL_PIN_K5_B4", 5, b=4, s=3, timeout=timeout, count_timeout=120, cores=cores))
   553	    outputs.append(positive_control(timeout=120, cores=1))
   554	    outputs.append(perturbed_hint_control(timeout=300, cores=1))
   555	    atomic_write(RUNS / "controls.summary.json", json.dumps(outputs, indent=2, sort_keys=True) + "\n")
   556	    return outputs

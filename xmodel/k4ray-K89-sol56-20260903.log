   904	
   905	def run_prefix(
   906	    chart: ScreenChart,
   907	    rows: Sequence[BandRow],
   908	    characteristics: Sequence[int],
   909	    strategy: str,
   910	    output_dir: Path,
   911	    timeout: int,
   912	    cores: int,
   913	    hint_path: Path | None,
   914	    stage: str,
   915	) -> GuidedGBResult:
   916	    systems: list[SingularSystem] = []
   917	    hint: HilbertHint | None = None
   918	    for characteristic in characteristics:
   919	        ring, names, weights = ring_for(chart, characteristic, strategy)
   920	        if hint is None:
   921	            hint = load_hint(hint_path, stage, weights)
   922	        generators = [row.expr for row in rows] + [expression for _label, expression in chart.global_generators]
   923	        systems.append(
   924	            SingularSystem(
   925	                name=f"QREC_K{chart.K}_{chart.branch}_{stage}_{strategy}_p{characteristic}",
   926	                prelude="\n".join(("option(redSB); short=0;", ring, 'print("QREC__PRELUDE 1");')),
   927	                generators=tuple(generators),
   928	                characteristic=characteristic,
   929	                variables=tuple(names),
   930	                homogeneous=False,
   931	                positive_weights=(),
   932	                metadata={
   933	                    "scope": chart.scope,
   934	                    "K": chart.K,
   935	                    "branch": chart.branch,
   936	                    "stage": stage,
   937	                    "chart_sha256": chart.chart_sha256,
   938	                    "single_normalization": "c=1; mu localized",
   939	                },
   940	            )
   941	        )
   942	    return guided_groebner(
   943	        systems,
   944	        hint=hint,
   945	        policy=PromotionPolicy.exact_q("inhomogeneous localized quotient-recurrence screen"),
   946	        config=RunConfig(
   947	            output_dir=output_dir,
   948	            timeout_seconds=timeout,
   949	            total_cores=cores,
   950	            max_parallel_jobs=min(len(systems), cores),
   951	            run_perturbed_control=False,
   952	            no_rc=True,
   953	        ),
   954	    )

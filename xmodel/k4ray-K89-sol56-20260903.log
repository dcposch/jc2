   333	          " Moh's table has %d rows / 4 classes.  Excess %d."
   334	          % (len(got), len(set((r[0],r[1]) for r in got)), len(printed), len(got-printed)))
   335	    print("   => the printed list (1)-(13) is NOT the whole of Moh's program.")

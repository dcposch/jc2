   151	def cp_quoy(
   152	    numerator: Mapping[tuple[int, int], sp.Expr],
   153	    monic_divisor: Mapping[tuple[int, int], sp.Expr],
   154	    y_degree: int,
   155	) -> tuple[CoordPoly, CoordPoly]:
   156	    """Long division in y over Q[parameters,x]; divisor leading coeff is 1."""
   157	

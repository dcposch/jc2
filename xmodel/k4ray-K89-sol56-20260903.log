   363	def emit_guided_script(
   364	    system: SingularSystem,
   365	    hint: HilbertHint | None = None,
   366	    include_perturbed_control: bool = True,
   367	) -> str:
   368	    """Emit a standalone Singular script with mandatory controls."""
   369	
   370	    lines = [
   371	        "// generated by box/lib/guided_gb.py",
   372	        f"// system={system.name}",
   373	        f"// characteristic={system.characteristic}",
   374	        f"// homogeneous={int(system.homogeneous)}",
   375	    ]
   376	    lines.append(system.prelude.rstrip())
   377	    lines.extend(
   378	        _emit_one_analysis(
   379	            "main",
   380	            system.generators,
   381	            hint,
   382	            None if hint is None else hint.predicted_length,
   383	        )
   384	    )
   385	    if hint is not None and include_perturbed_control:
   386	        bad = hint.perturbed()
   387	        lines.extend(
   388	            _emit_one_analysis(
   389	                "perturbed",
   390	                system.generators,
   391	                bad,
   392	                bad.predicted_length,
   393	            )
   394	        )
   395	        lines.extend(
   396	            [
   397	                "int GG_PERTURBED_FAILED=(GG_ACCEPT_perturbed==0);",
   398	                'print("GG__PERTURBED_FAILED control "+string(GG_PERTURBED_FAILED));',
   399	            ]
   400	        )
   401	    lines.extend(['print("GG__SCRIPT_DONE main 1");', "quit;", ""])
   402	    return "\n".join(lines)
   403	
   404	
   405	def _stream_pipe(pipe: Any, path: Path, sink: list[str]) -> None:
   406	    with path.open("w", encoding="utf-8", errors="replace") as output:
   407	        while True:
   408	            chunk = pipe.readline()
   409	            if chunk == "":
   410	                break
   411	            sink.append(chunk)
   412	            output.write(chunk)
   413	            output.flush()
   414	
   415	
   416	def run_singular_script(
   417	    script_path: Path,
   418	    output_prefix: Path,
   419	    config: RunConfig,
   420	    cpus: int,
   421	) -> tuple[list[str], str, str, int | None, bool, float]:
   422	    """Run Singular under ``stdbuf -oL`` and stream stdout/stderr to disk."""
   423	
   424	    env = os.environ.copy()
   425	    thread_count = str(max(1, cpus))
   426	    for key in (
   427	        "OMP_NUM_THREADS",
   428	        "OPENBLAS_NUM_THREADS",
   429	        "MKL_NUM_THREADS",
   430	        "NUMEXPR_NUM_THREADS",
   431	    ):
   432	        env[key] = thread_count
   433	
   434	    cmd = [
   435	        "stdbuf",
   436	        "-oL",
   437	        "-eL",
   438	        config.singular,
   439	        f"--cpus={cpus}",
   440	        f"--threads={cpus}",
   441	        f"--flint-threads={cpus}",
   442	    ]
   443	    if config.no_rc:
   444	        cmd.append("--no-rc")
   445	    cmd.extend(["-q", str(script_path)])
   446	
   447	    stdout_path = output_prefix.with_suffix(".out")
   448	    stderr_path = output_prefix.with_suffix(".err")
   449	    stdout_chunks: list[str] = []
   450	    stderr_chunks: list[str] = []
   451	    started = time.monotonic()
   452	    process = subprocess.Popen(
   453	        cmd,
   454	        stdout=subprocess.PIPE,
   455	        stderr=subprocess.PIPE,
   456	        text=True,
   457	        bufsize=1,
   458	        env=env,
   459	        start_new_session=True,
   460	    )
   461	    assert process.stdout is not None
   462	    assert process.stderr is not None
   463	    threads = [
   464	        threading.Thread(
   465	            target=_stream_pipe,
   466	            args=(process.stdout, stdout_path, stdout_chunks),
   467	            daemon=True,
   468	        ),
   469	        threading.Thread(
   470	            target=_stream_pipe,
   471	            args=(process.stderr, stderr_path, stderr_chunks),
   472	            daemon=True,
   473	        ),
   474	    ]
   475	    for thread in threads:
   476	        thread.start()
   477	    timed_out = False
   478	    returncode: int | None
   479	    try:
   480	        returncode = process.wait(timeout=config.timeout_seconds)
   481	    except subprocess.TimeoutExpired:
   482	        timed_out = True
   483	        os.killpg(process.pid, signal.SIGTERM)
   484	        try:
   485	            returncode = process.wait(timeout=10)
   486	        except subprocess.TimeoutExpired:
   487	            os.killpg(process.pid, signal.SIGKILL)
   488	            returncode = process.wait()
   489	    for thread in threads:
   490	        thread.join(timeout=5)
   491	    elapsed = time.monotonic() - started
   492	    return cmd, "".join(stdout_chunks), "".join(stderr_chunks), returncode, timed_out, elapsed
   493	
   494	
   495	def _parse_int_token(value: str) -> int | None:
   496	    value = value.strip()
   497	    if value in {"NA", "NONTERMINATING", ""}:
   498	        return None
   499	    try:
   500	        return int(value)
   501	    except ValueError:
   502	        return None
   503	
   504	
   505	def parse_marker_controls(stdout: str, run_id: str) -> RunControls:
   506	    controls = RunControls()
   507	    markers: dict[str, str] = {}
   508	    nf_seen = False
   509	    pattern = re.compile(rf"^GG__([A-Z0-9_]+) {re.escape(run_id)}(?: (.*))?$")
   510	    for line in stdout.splitlines():
   511	        match = pattern.match(line.strip())
   512	        if not match:
   513	            continue
   514	        key = match.group(1)
   515	        rest = (match.group(2) or "").strip()
   516	        markers[key] = rest
   517	        if key == "NF_ALL_ZERO":
   518	            controls.nf_all_zero = rest == "1"
   519	        elif key == "UNIT":
   520	            controls.unit = rest == "1"
   521	        elif key == "DIM":
   522	            controls.dimension = _parse_int_token(rest)
   523	        elif key == "VDIM":
   524	            controls.vdim = _parse_int_token(rest)
   525	        elif key == "BASIS_SIZE":
   526	            controls.basis_size = _parse_int_token(rest)
   527	        elif key == "LEAD_DIM":
   528	            controls.lead_dim = _parse_int_token(rest)
   529	        elif key == "LEAD_VDIM":
   530	            controls.lead_vdim = _parse_int_token(rest)
   531	        elif key == "VDIM_MATCH_PREDICTED":
   532	            controls.vdim_matches_predicted = None if rest == "NA" else rest == "1"
   533	        elif key == "ACCEPT":
   534	            controls.accepted = rest == "1"
   535	        elif key == "NF_ZERO":
   536	            nf_seen = True
   537	    required = ["NF_ALL_ZERO", "UNIT", "DIM", "BASIS_SIZE", "LEAD_DIM", "ACCEPT"]
   538	    controls.missing_markers = [key for key in required if key not in markers]
   539	    if not nf_seen:
   540	        controls.missing_markers.append("NF_ZERO")
   541	    return controls
   542	
   543	
   544	def parse_perturbed_failed(stdout: str) -> bool | None:
   545	    for line in stdout.splitlines():
   546	        if line.strip().startswith("GG__PERTURBED_FAILED control "):
   547	            return line.strip().endswith(" 1")
   548	    return None
   549	
   550	
   551	def run_one(
   552	    system: SingularSystem,
   553	    hint: HilbertHint | None,
   554	    policy: PromotionPolicy,
   555	    config: RunConfig,
   556	    cpus: int,
   557	) -> SingularRunResult:
   558	    config.output_dir.mkdir(parents=True, exist_ok=True)
   559	    stem = re.sub(r"[^A-Za-z0-9_.-]+", "_", system.name).strip("_") or "guided"
   560	    suffix = "Q" if system.characteristic == 0 else f"p{system.characteristic}"
   561	    prefix = config.output_dir / f"{stem}_{suffix}"
   562	    script_path = prefix.with_suffix(".sing")
   563	    script = emit_guided_script(
   564	        system,
   565	        hint,
   566	        include_perturbed_control=(hint is not None and config.run_perturbed_control),
   567	    )
   568	    atomic_write(script_path, script)
   569	    command, stdout, stderr, returncode, timed_out, elapsed = run_singular_script(
   570	        script_path,
   571	        prefix,
   572	        config,
   573	        cpus,
   574	    )
   575	    main = parse_marker_controls(stdout, "main")
   576	    perturbed = (
   577	        parse_marker_controls(stdout, "perturbed")
   578	        if hint is not None and config.run_perturbed_control
   579	        else None
   580	    )
   581	    result = SingularRunResult(
   582	        label=system.name,
   583	        characteristic=system.characteristic,
   584	        command=command,
   585	        script=str(script_path),
   586	        stdout=str(prefix.with_suffix(".out")),
   587	        stderr=str(prefix.with_suffix(".err")),
   588	        returncode=returncode,
   589	        elapsed_seconds=round(elapsed, 6),
   590	        timed_out=timed_out,
   591	        main=main,
   592	        perturbed=perturbed,
   593	        stdout_sha256=sha256_file(prefix.with_suffix(".out")),
   594	        stderr_sha256=sha256_file(prefix.with_suffix(".err")),
   595	        script_sha256=sha256_file(script_path),
   596	    )
   597	    json_path = prefix.with_suffix(".guided.json")
   598	    atomic_write(json_path, json.dumps(result.to_json(), indent=2, sort_keys=True) + "\n")
   599	    return result

   302	def build_system(
   303	    tag: str,
   304	    K: int,
   305	    *,
   306	    b: int | None,
   307	    s: int | None,
   308	    ch: int,
   309	    tk: int,
   310	    theorem_cut: bool,
   311	    rho_level4: bool,
   312	    count_timeout: int,
   313	) -> tuple[SingularSystem | None, dict[str, Any], dict[str, Any]]:
   314	    prelude, names, weights, meta = pinned_prelude(
   315	        K,
   316	        b=b,
   317	        s=s,
   318	        ch=ch,
   319	        tk=tk,
   320	        theorem_cut=theorem_cut,
   321	        rho_level4=rho_level4,
   322	    )
   323	    info = run_singular_count(prelude, f"{tag}_p{ch}", count_timeout)
   324	    if info["n"] is None:
   325	        return None, info, meta
   326	    generators = [f"ROWS[{idx}]" for idx in range(1, info["n"] + 1)]
   327	    generators.extend(["CSTP-1", "mu*mu_inv-1"])
   328	    system = SingularSystem(
   329	        name=f"{tag}_p{ch}",
   330	        prelude=prelude,
   331	        generators=tuple(generators),
   332	        characteristic=ch,
   333	        variables=tuple(names),
   334	        homogeneous=False,
   335	        positive_weights=(),
   336	        metadata=meta,
   337	    )
   338	    return system, info, meta
   339	

+poly f=h^2+2*beta;
+poly g=h^3+3*beta*h+(3/2)*alpha;
+poly JJ=diff(f,x)*diff(g,y)-diff(f,y)*diff(g,x);
+print("PRE__TAME_F "+string(f));
+print("PRE__TAME_G "+string(g));
+print("PRE__TAME_J "+string(JJ));

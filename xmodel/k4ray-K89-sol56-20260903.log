   467	        if (i, j) == (4, 0):
   468	            target_coefficient = coefficient
   469	        elif coefficient != 0:
   470	            grouped_j.setdefault(i + j, []).append((i, j, coefficient))
   471	    if target_coefficient == 0:
   472	        raise AssertionError("full reduced chart lost its x^4 target coefficient")
   473	    for degree in sorted(grouped_j, reverse=True):
   474	        for index, (i, j, coefficient) in enumerate(grouped_j[degree]):
   475	            localized = localize_mu(coefficient, mu, mu_inv)
   476	            integral, denominator = clear_rational_denominators(localized)
   477	            extra_denominators.append(denominator)
   478	            extra_rows.append(
   479	                BandRow(
   480	                    label=f"ID6_J_d{degree}_x{i}_y{j}",
   481	                    band=f"j00_J_d{degree:02d}",
   482	                    degree=degree,
   483	                    expr=singular_expr(integral),
   484	                    source={
   485	                        "kind": "ID6_J",
   486	                        "xy_degree": degree,
   487	                        "x_power": i,
   488	                        "y_power": j,
   489	                        "row_in_band": index,
   490	                        "cleared_denominator": denominator,
   491	                    },
   492	                )
   493	            )
   494	
   495	    target_localized = localize_mu(target_coefficient - 1, mu, mu_inv)
   496	    target_integral, target_denominator = clear_rational_denominators(target_localized)
   497	    extra_denominators.append(target_denominator)
   498	    chart.global_generators = [
   499	        ("mu_nonzero", "mu*mu_inv-1"),
   500	        ("jacobian_target_c1", singular_expr(target_integral)),
   501	    ]
   502	    chart.rows = [*chart.rows, *extra_rows]
   503	    chart.scope = "FULL_REDUCED_PINNED_CHART"
   504	    chart.variables = []
   505	    chart.weights = []
   506	    seen: set[sp.Symbol] = set()
   507	    for symbol in [mu, *variables, mu_inv]:
   508	        if symbol in seen:
   509	            continue
   510	        seen.add(symbol)
   511	        chart.variables.append(str(symbol))
   512	        chart.weights.append(variable_weights.get(symbol, 1))
   513	    chart.denominator_lcm = math.lcm(chart.denominator_lcm, *extra_denominators)
   514	    chart.reconstruction.update(
   515	        {
   516	            "h_full": singular_expr(localize_mu(h_full, mu, mu_inv)),
   517	            "beta_full": singular_expr(localize_mu(beta, mu, mu_inv)),
   518	            "alpha": singular_expr(localize_mu(alpha, mu, mu_inv)),
   519	            "rho": singular_expr(localize_mu(rho, mu, mu_inv)),
   520	            "rho_positive_target": singular_expr(localize_mu(rho_positive, mu, mu_inv)),
   521	        }
   522	    )
   523	    fingerprint = json.dumps(
   524	        {
   525	            "K": K,
   526	            "branch": chart.branch,
   527	            "scope": chart.scope,
   528	            "variables": chart.variables,
   529	            "weights": chart.weights,
   530	            "rows": [(row.label, row.band, row.expr) for row in chart.rows],
   531	            "globals": chart.global_generators,
   532	        },
   533	        sort_keys=True,
   534	        separators=(",", ":"),
   535	    )
   536	    chart.chart_sha256 = hashlib.sha256(fingerprint.encode()).hexdigest()
   537	    return chart

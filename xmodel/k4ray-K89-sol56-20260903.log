            target_index: int | None = None
        else:
            target_index = n - 11
            residual = cp_add(residual, cp_scale(qbands[target_index], -sp.Rational(1, 3)))
            family = "RHO_POSITIVE_MATCH"
        new_rows, new_denominators = rows_from_coordinate_band(
            residual,
            prefix=f"{family}_n{n}",


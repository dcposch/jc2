   539	
   540	def build_k8(full: bool = False) -> ScreenChart:
   541	    K = 8
   542	    x, y, mu, mu_inv = sp.symbols("x y mu mu_inv")
   543	    L = y - x
   544	    variable_weights: dict[sp.Symbol, int] = {mu: K + 2, mu_inv: 1}
   545	    variables: list[sp.Symbol] = []
   546	
   547	    tau, tau_symbols, weights = homogeneous_form("tau", 1, K + 3)
   548	    variable_weights.update(weights)
   549	    variables.extend(tau_symbols)
   550	    tau_y = sp.Symbol("tau_0_1")
   551	    v_x = sp.Symbol("v_1_0")
   552	    variable_weights[v_x] = K + 3
   553	    variables.append(v_x)
   554	    v = v_x * x + 2 * tau_y * y
   555	    phi = y * v
   556	    chi = sp.Symbol("chi_0_0")
   557	    variable_weights[chi] = 2 * K + 6
   558	    variables.append(chi)
   559	
   560	    p: dict[int, sp.Expr] = {0: mu * y ** (K - 3) * L}
   561	    p_symbols: dict[int, list[sp.Symbol]] = {}
   562	    for index in (2, 3, 4):
   563	        form, symbols, weights = homogeneous_form(f"p{index}", K - 2 - index, K + 2 + index)
   564	        p[index] = form
   565	        p_symbols[index] = symbols
   566	        variables.extend(symbols)
   567	        variable_weights.update(weights)
   568	    p[1] = sp.expand(y**2 * (3 * y**2 * tau - L * phi))
   569	
   570	    h: dict[int, sp.Expr] = {0: y ** (K - 1) * L}
   571	    h[1] = sp.expand(3 * y**6 * tau / mu - sp.Rational(3, 2) * y**4 * L * phi / mu)
   572	    h[2] = sp.expand(
   573	        sp.Rational(3, 2) / mu**2 * (mu * y**2 * p[2] + sp.Rational(1, 4) * y * L * phi**2 - y**6 * chi)
   574	    )
   575	    h[3] = sp.expand(
   576	        (L * y * v**3 + 36 * chi * v * y**4 + 24 * mu**2 * p[3] * y**2 - 12 * mu * p[2] * v - 18 * v**2 * tau * y**2)
   577	        / (16 * mu**3)
   578	    )
   579	    q = {
   580	        0: mu**3 * y ** (K - 7) * L,
   581	        1: 3 * mu**2 * tau,
   582	        2: 3 * mu * chi,
   583	        3: sp.Integer(0),
   584	    }
   585	    checks = {
   586	        "N1_minus_H2q1": N(1, h, p, q) - h[0] ** 2 * q[1],
   587	        "N2_minus_H2q2": N(2, h, p, q) - h[0] ** 2 * q[2],
   588	        "N3": N(3, h, p, q),
   589	    }
   590	
   591	    h4, h4_symbols, h4_weights = homogeneous_form("h4", K - 4, 4)
   592	    variable_weights.update(h4_weights)
   593	    h[4] = h4
   594	    residual4 = sp.expand(N(4, h, p, q) - theta(K, x, y))
   595	    substitutions4, compatibility4, audit4 = solve_h_band(residual4, h4_symbols, mu, x, y)
   596	    h[4] = sp.expand(h4.xreplace(substitutions4))
   597	    free_h4 = [symbol for symbol in h4_symbols if symbol not in substitutions4]
   598	    variables.extend(free_h4)
   599	    audit4.update({"n": 4, "terminal": True})
   600	
   601	    reconstruction = {
   602	        "H": h[0],
   603	        "p0": p[0],
   604	        "p1": p[1],
   605	        "p2": p[2],
   606	        "p3": p[3],
   607	        "p4": p[4],
   608	        "h1": h[1],
   609	        "h2": h[2],
   610	        "h3": h[3],
   611	        "h4": h[4],
   612	        "q1": q[1],
   613	        "q2": q[2],
   614	        "Theta": theta(K, x, y),
   615	    }
   616	    chart = finalize_chart(
   617	        K,
   618	        "single",
   619	        variables,
   620	        variable_weights,
   621	        [(4, compatibility4)],
   622	        checks,
   623	        [audit4],
   624	        reconstruction,
   625	        mu,
   626	        mu_inv,
   627	    )
   628	    if full:
   629	        return extend_full_chart(chart, h, p, q, variables, variable_weights, mu, mu_inv, x, y)
   630	    return chart
   631	
   632	
   633	def build_k9(branch: str, full: bool = False) -> ScreenChart:
   634	    if branch not in ("A", "B"):
   635	        raise ValueError("K=9 branch must be A or B")
   636	    K = 9
   637	    x, y, mu, mu_inv = sp.symbols("x y mu mu_inv")
   638	    L = y - x
   639	    variable_weights: dict[sp.Symbol, int] = {mu: K + 2, mu_inv: 1}
   640	    variables: list[sp.Symbol] = []
   641	
   642	    tau, tau_symbols, tau_weights = homogeneous_form("tau", 2, K + 3)
   643	    variable_weights.update(tau_weights)
   644	    variables.extend(tau_symbols)
   645	    tau_y2 = sp.Symbol("tau_0_2")
   646	    chi, chi_symbols, chi_weights = homogeneous_form("chi", 1, 2 * K + 6)
   647	    variable_weights.update(chi_weights)
   648	    variables.extend(chi_symbols)
   649	    kappa = sp.Symbol("kappa")
   650	    variable_weights[kappa] = 4 * K
   651	    variables.append(kappa)
   652	
   653	    p: dict[int, sp.Expr] = {0: mu * y ** (K - 3) * L}
   654	    if branch == "A":
   655	        w_x = sp.Symbol("w_1_0")
   656	        variable_weights[w_x] = K + 3
   657	        variables.append(w_x)
   658	        w = w_x * x + 2 * tau_y2 * y
   659	        v = y * w
   660	        p2, p2_symbols, p2_weights = homogeneous_form("p2", K - 4, K + 4)
   661	        p[2] = p2
   662	        variables.extend(p2_symbols)
   663	        variable_weights.update(p2_weights)
   664	        omega = sp.expand(w * (L * y**2 * w**2 - 12 * mu * p[2]))
   665	        branch_reconstruction: dict[str, sp.Expr] = {"w": w, "omega": omega}
   666	    else:
   667	        v_x2, v_xy = sp.symbols("v_2_0 v_1_1")
   668	        variable_weights[v_x2] = K + 3
   669	        variable_weights[v_xy] = K + 3
   670	        variables.extend((v_x2, v_xy))
   671	        v = v_x2 * x**2 + v_xy * x * y + 2 * tau_y2 * y**2
   672	        zeta, zeta_symbols, zeta_weights = homogeneous_form("zeta", 4, 2 * K + 6)
   673	        variables.extend(zeta_symbols)
   674	        variable_weights.update(zeta_weights)
   675	        p[2] = sp.expand((L * v**2 - y * zeta) / (12 * mu))
   676	        omega = sp.expand(v * zeta)
   677	        branch_reconstruction = {"zeta": zeta, "omega": omega}
   678	    phi = y * v
   679	
   680	    for index in (3, 4, 5, 6):
   681	        form, symbols, weights = homogeneous_form(f"p{index}", K - 2 - index, K + 2 + index)
   682	        p[index] = form
   683	        variables.extend(symbols)
   684	        variable_weights.update(weights)
   685	    p[1] = sp.expand(y**2 * (3 * y**2 * tau - L * phi))
   686	
   687	    h: dict[int, sp.Expr] = {0: y ** (K - 1) * L}
   688	    h[1] = sp.expand(3 * y**6 * tau / mu - sp.Rational(3, 2) * y**4 * L * phi / mu)
   689	    h[2] = sp.expand(
   690	        sp.Rational(3, 2) / mu**2 * (mu * y**2 * p[2] + sp.Rational(1, 4) * L * phi**2 - y**6 * chi)
   691	    )
   692	    h[3] = sp.expand(
   693	        (omega + 36 * chi * v * y**3 + 24 * mu**2 * p[3] * y**2 - 18 * v**2 * tau - 8 * kappa * y**6)
   694	        / (16 * mu**3)
   695	    )
   696	    q = {
   697	        0: mu**3 * y ** (K - 7) * L,
   698	        1: 3 * mu**2 * tau,
   699	        2: 3 * mu * chi,
   700	        3: kappa,
   701	        4: sp.Integer(0),
   702	        5: sp.Integer(0),
   703	    }
   704	    checks = {
   705	        "N1_minus_H2q1": N(1, h, p, q) - h[0] ** 2 * q[1],
   706	        "N2_minus_H2q2": N(2, h, p, q) - h[0] ** 2 * q[2],
   707	        "N3_minus_H2q3": N(3, h, p, q) - h[0] ** 2 * q[3],
   708	    }
   709	
   710	    compatibility_by_n: list[tuple[int, Sequence[sp.Expr]]] = []
   711	    audits: list[dict[str, Any]] = []
   712	    for n in (4, 5, 6):
   713	        hn, hn_symbols, hn_weights = homogeneous_form(f"h{n}", K - n, n)
   714	        variable_weights.update(hn_weights)
   715	        h[n] = hn
   716	        residual = N(n, h, p, q)
   717	        if n == 6:
   718	            residual = sp.expand(residual - theta(K, x, y))
   719	        substitutions, compatibility, audit = solve_h_band(residual, hn_symbols, mu, x, y)
   720	        h[n] = sp.expand(hn.xreplace(substitutions))
   721	        free_h = [symbol for symbol in hn_symbols if symbol not in substitutions]
   722	        variables.extend(free_h)
   723	        audit.update({"n": n, "terminal": n == 6})
   724	        audits.append(audit)
   725	        compatibility_by_n.append((n, compatibility))
   726	
   727	    reconstruction: dict[str, sp.Expr] = {
   728	        "H": h[0],
   729	        "p0": p[0],
   730	        "p1": p[1],
   731	        "p2": p[2],
   732	        "p3": p[3],
   733	        "p4": p[4],
   734	        "p5": p[5],
   735	        "p6": p[6],
   736	        "h1": h[1],
   737	        "h2": h[2],
   738	        "h3": h[3],
   739	        "h4": h[4],
   740	        "h5": h[5],
   741	        "h6": h[6],
   742	        "q1": q[1],
   743	        "q2": q[2],
   744	        "q3": q[3],
   745	        "Theta": theta(K, x, y),
   746	        "v": v,
   747	        **branch_reconstruction,
   748	    }
   749	    chart = finalize_chart(
   750	        K,
   751	        branch,
   752	        variables,
   753	        variable_weights,
   754	        compatibility_by_n,
   755	        checks,
   756	        audits,
   757	        reconstruction,
   758	        mu,
   759	        mu_inv,
   760	    )
   761	    if full:
   762	        return extend_full_chart(chart, h, p, q, variables, variable_weights, mu, mu_inv, x, y)
   763	    return chart
   764	
   765	
   766	def build_chart(K: int, branch: str | None, full: bool = False) -> ScreenChart:
   767	    if K == 8:
   768	        return build_k8(full=full)
   769	    if K == 9:
   770	        return build_k9(branch or "A", full=full)
   771	    raise ValueError("the closed recurrence screen is implemented only for K=8 and K=9")
   772	
   773	
   774	def order_chart(chart: ScreenChart, strategy: str) -> tuple[list[str], list[int]]:
   775	    pairs = list(zip(chart.variables, chart.weights))
   776	    # Keep mu_inv last so the reverse-lex tie breaker does not lead with the
   777	    # Rabinowitsch variable.  mu itself may move with the geometric variables.
   778	    localizer = [pair for pair in pairs if pair[0] == "mu_inv"]
   779	    pairs = [pair for pair in pairs if pair[0] != "mu_inv"]
   780	    if strategy == "native":
   780	    if strategy == "native":
   781	        pass
   782	    elif strategy == "reverse":
   783	        pairs.reverse()
   784	    elif strategy == "weight-asc":
   785	        pairs.sort(key=lambda item: (item[1], item[0]))
   786	    elif strategy == "weight-desc":
   787	        pairs.sort(key=lambda item: (-item[1], item[0]))
   788	    else:
   789	        raise ValueError(f"unknown tie order {strategy}")
   790	    pairs.extend(localizer)
   791	    return [name for name, _weight in pairs], [weight for _name, weight in pairs]
   792	
   793	
   794	def ring_for(chart: ScreenChart, characteristic: int, strategy: str) -> tuple[str, list[str], list[int]]:
   795	    if characteristic in (2, 3) or (characteristic and chart.denominator_lcm % characteristic == 0):
   796	        raise ValueError(f"bad characteristic {characteristic}; denominator lcm={chart.denominator_lcm}")
   797	    names, weights = order_chart(chart, strategy)
   798	    ring = f"ring SS={characteristic},({','.join(names)}),wp({','.join(str(weight) for weight in weights)});"
   799	    return ring, names, weights
   800	

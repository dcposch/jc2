   601	
   602	def _controls_accepted(
   603	    run: SingularRunResult,
   604	    hint: HilbertHint | None,
   605	    policy: PromotionPolicy,
   606	    require_perturbed: bool,
   607	) -> bool:
   608	    if run.timed_out or run.returncode != 0:
   609	        return False
   610	    main = run.main
   611	    if policy.require_controls and main.missing_markers:
   612	        return False
   613	    if not main.accepted or not main.nf_all_zero:
   614	        return False
   615	    if hint is not None and hint.predicted_length is not None:
   616	        if main.lead_dim != 0 or main.lead_vdim != hint.predicted_length:
   617	            return False
   618	        if main.vdim_matches_predicted is not True:
   619	            return False
   620	    if require_perturbed and hint is not None:
   621	        failed = parse_perturbed_failed(Path(run.stdout).read_text(encoding="utf-8", errors="replace"))
   622	        if failed is not True:
   623	            return False
   624	    return True
   625	
   626	
   627	def crt_pair(a: int, m: int, b: int, n: int) -> tuple[int, int]:
   628	    """Combine two congruences, returning ``(residue, modulus)``."""
   629	
   630	    g = math.gcd(m, n)
   631	    if (b - a) % g:
   632	        raise ValueError("inconsistent residues")
   633	    m1 = m // g
   634	    n1 = n // g
   635	    inv = pow(m1, -1, n1)
   636	    t = ((b - a) // g * inv) % n1
   637	    modulus = m * n1
   638	    return (a + m * t) % modulus, modulus
   639	
   640	
   641	def crt_many(items: Iterable[tuple[int, int]]) -> tuple[int, int]:
   642	    iterator = iter(items)
   643	    try:
   644	        residue, modulus = next(iterator)
   645	    except StopIteration as exc:
   646	        raise ValueError("empty CRT input") from exc
   647	    for next_residue, next_modulus in iterator:
   648	        residue, modulus = crt_pair(residue, modulus, next_residue, next_modulus)
   649	    return residue, modulus
   650	
   651	
   652	def rational_reconstruct(
   653	    residue: int,
   654	    modulus: int,
   655	    max_numerator: int | None = None,
   656	    max_denominator: int | None = None,
   657	) -> Fraction | None:
   658	    """Small rational reconstruction by bounded denominator scan."""
   659	
   660	    if modulus <= 1:
   661	        raise ValueError("modulus must be > 1")
   662	    residue %= modulus
   663	    default_bound = math.isqrt(max(1, (modulus - 1) // 2))
   664	    max_numerator = default_bound if max_numerator is None else max_numerator
   665	    max_denominator = default_bound if max_denominator is None else max_denominator
   666	    for denominator in range(1, max_denominator + 1):
   667	        numerator = (residue * denominator) % modulus
   668	        if numerator > modulus // 2:
   669	            numerator -= modulus
   670	        if abs(numerator) <= max_numerator and math.gcd(numerator, denominator) == 1:
   671	            return Fraction(numerator, denominator)
   672	    return None
   673	
   674	
   675	def reconstruct_invariants(runs: Sequence[SingularRunResult]) -> dict[str, Any]:
   676	    """CRT/rational-reconstruct small integer invariants from modular runs."""
   677	
   678	    modular = [run for run in runs if run.characteristic > 1 and not run.timed_out]
   679	    out: dict[str, Any] = {
   680	        "method": "CRT plus bounded rational reconstruction for scalar invariants",
   681	        "available": len(modular) >= 2,
   682	        "items": {},
   683	    }
   684	    if len(modular) < 2:
   685	        return out
   686	    for key in ("dimension", "lead_dim", "lead_vdim", "basis_size"):
   687	        residues = []
   688	        for run in modular:
   689	            value = getattr(run.main, key)
   690	            if value is None:
   691	                break
   692	            residues.append((value % run.characteristic, run.characteristic))
   693	        else:
   694	            residue, modulus = crt_many(residues)
   695	            reconstructed = rational_reconstruct(residue, modulus)
   696	            out["items"][key] = {
   697	                "residue": residue,
   698	                "modulus": modulus,
   699	                "rational_reconstruction": (
   700	                    None if reconstructed is None else str(reconstructed)
   701	                ),
   702	                "direct_singular_values": [getattr(run.main, key) for run in modular],
   703	                "direct_values_agree": len({getattr(run.main, key) for run in modular}) == 1,
   704	            }
   705	    return out
   706	
   707	
   708	def guided_groebner(
   709	    systems: SingularSystem | Sequence[SingularSystem],
   710	    hint: HilbertHint | None = None,
   711	    policy: PromotionPolicy | None = None,
   712	    config: RunConfig | None = None,
   713	) -> GuidedGBResult:
   714	    """Run one or more Singular systems and return a typed verdict.
   715	
   716	    Pass multiple systems to run good-prime fibres in parallel.  The aggregate
   717	    verdict is promoted to characteristic zero only by exact-Q computation or by
   718	    the homogeneous/properness policy for modular dimension zero.
   719	    """
   720	
   721	    if config is None:
   722	        config = RunConfig(Path("guided-gb-runs"))
   723	    if policy is None:
   724	        policy = PromotionPolicy.exact_q() if _as_list(systems)[0].characteristic == 0 else PromotionPolicy()
   725	    job_list = _as_list(systems)
   726	    max_jobs = config.max_parallel_jobs or min(len(job_list), max(1, config.total_cores))
   727	    max_jobs = max(1, min(max_jobs, len(job_list)))
   728	    cpus = max(1, config.total_cores // max_jobs)
   729	
   730	    runs: list[SingularRunResult] = []
   731	    with ThreadPoolExecutor(max_workers=max_jobs) as executor:
   732	        futures = [
   733	            executor.submit(run_one, system, hint, policy, config, cpus)
   734	            for system in job_list
   735	        ]
   736	        for future in as_completed(futures):
   737	            runs.append(future.result())
   738	    runs.sort(key=lambda run: (run.label, run.characteristic))
   739	
   740	    require_perturbed = bool(hint is not None and config.run_perturbed_control)
   741	    accepted = [
   742	        run
   743	        for run in runs
   744	        if _controls_accepted(run, hint, policy, require_perturbed)
   745	    ]
   746	    timeouts = [run for run in runs if run.timed_out or run.returncode == 124]
   747	    any_exact = any(run.characteristic == 0 for run in accepted)
   748	    any_modular = any(run.characteristic > 1 for run in accepted)
   749	    all_exact_posdim = (
   750	        bool(runs)
   751	        and all(run.characteristic == 0 for run in runs)
   752	        and all(run.main.dimension is not None and run.main.dimension > 0 for run in runs)
   753	    )
   754	
   755	    verdict = Verdict.MODULAR_ONLY
   756	    promotion_note = ""
   757	    if accepted:
   758	        if any(run.characteristic == 0 and run.main.unit for run in accepted):
   759	            verdict = Verdict.UNIT_IDEAL_CHAR0
   760	            promotion_note = "exact Q standard basis reduced 1 to 0"
   761	        elif any(run.characteristic == 0 and run.main.dimension == 0 for run in accepted):
   762	            verdict = Verdict.DIM0_CHAR0
   763	            promotion_note = "exact Q standard basis has dimension zero"
   764	        elif all_exact_posdim:
   765	            verdict = Verdict.POSDIM
   766	            promotion_note = "exact Q standard basis has positive dimension"
   767	        elif any_modular and any(run.main.dimension == 0 for run in accepted):
   768	            if _properness_allowed(job_list, policy):
   769	                verdict = Verdict.DIM0_CHAR0
   770	                promotion_note = (
   771	                    "modular dimension zero promoted only for a homogeneous "
   772	                    "positive-weight ideal by the properness scope"
   773	                )
   774	            else:
   775	                verdict = Verdict.MODULAR_ONLY
   776	                promotion_note = "modular dimension zero lacks declared properness scope"
   777	        elif any(run.main.unit for run in accepted):
   778	            if policy.allow_modular_unit_promotion and _properness_allowed(job_list, policy):
   779	                verdict = Verdict.UNIT_IDEAL_CHAR0
   780	                promotion_note = "modular unit promoted under explicit caller policy"
   781	            else:
   782	                verdict = Verdict.MODULAR_ONLY
   783	                promotion_note = "modular unit ideal was not promoted to characteristic zero"
   784	    elif all_exact_posdim:
   785	        verdict = Verdict.POSDIM
   786	        promotion_note = "exact Q standard basis has positive dimension"
   787	    elif timeouts:
   788	        verdict = Verdict.INCONCLUSIVE_TIMEOUT
   789	        promotion_note = "no accepted result before timeout"
   790	    else:
   791	        verdict = Verdict.MODULAR_ONLY
   792	        promotion_note = "controls did not accept a characteristic-zero conclusion"
   793	
   794	    certificate = {
   795	        "policy": {
   796	            "scope": policy.scope.value,
   797	            "require_controls": policy.require_controls,
   798	            "allow_modular_unit_promotion": policy.allow_modular_unit_promotion,
   799	            "note": policy.note,
   800	        },
   801	        "properness_scope": {
   802	            "statement": (
   803	                "A modular dimension-zero result for an ideal homogeneous in "
   804	                "positive weights certifies characteristic-zero dimension zero "
   805	                "through the properness lemma.  A modular positive-dimensional "
   806	                "result proves no characteristic-zero statement.  A modular "
   807	                "unit ideal is not promoted unless exact-Q or an explicit "
   808	                "caller policy supplies the missing scope."
   809	            ),
   810	            "systems_declared_homogeneous": all(system.homogeneous for system in job_list),
   811	            "positive_weights": [list(system.positive_weights) for system in job_list],
   812	        },
   813	        "promotion_note": promotion_note,
   814	        "hilbert_hint": None
   815	        if hint is None
   816	        else {
   817	            "numerator_sha256": sha256_text(json.dumps(list(hint.numerator))),
   818	            "weights": list(hint.weights),
   819	            "predicted_length": hint.predicted_length,
   820	            "perturbed_control": config.run_perturbed_control,
   821	        },
   822	        "runs": [run.to_json() for run in runs],
   823	        "accepted_run_count": len(accepted),
   824	        "crt_rational_reconstruction": reconstruct_invariants(runs),
   825	    }
   826	    result = GuidedGBResult(verdict, certificate)
   827	    config.output_dir.mkdir(parents=True, exist_ok=True)
   828	    atomic_write(
   829	        config.output_dir / "guided_gb_result.json",
   830	        json.dumps(result.to_json(), indent=2, sort_keys=True) + "\n",
   831	    )
   832	    return result
   833	

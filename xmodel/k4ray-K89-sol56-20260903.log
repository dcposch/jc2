   169	def cp_shift(poly: Mapping[tuple[int, int], sp.Expr], i: int, j: int) -> CoordPoly:
   170	    return {(a + i, b + j): coefficient for (a, b), coefficient in poly.items()}
   171	
   172	
   173	def cp_mul(left: Mapping[tuple[int, int], sp.Expr], right: Mapping[tuple[int, int], sp.Expr]) -> CoordPoly:
   174	    result: CoordPoly = {}
   175	    for (i, j), a in left.items():
   176	        for (k, ell), b in right.items():
   177	            monomial = (i + k, j + ell)
   178	            result[monomial] = result.get(monomial, sp.Integer(0)) + a * b
   179	    return cp_clean(result)
   180	
   181	
   182	def cp_pow(poly: Mapping[tuple[int, int], sp.Expr], exponent: int) -> CoordPoly:
   183	    result: CoordPoly = {(0, 0): sp.Integer(1)}
   184	    for _index in range(exponent):
   185	        result = cp_mul(result, poly)
   186	    return result
   187	
   188	
   189	def cp_expr(poly: Mapping[tuple[int, int], sp.Expr], x: sp.Symbol, y: sp.Symbol) -> sp.Expr:
   190	    return sp.Add(*(coefficient * x**i * y**j for (i, j), coefficient in sorted(poly.items())))
   191	
   192	
   193	def cp_form(
   194	    prefix: str, degree: int, weight: int
   195	) -> tuple[CoordPoly, list[sp.Symbol], dict[sp.Symbol, int]]:
   196	    polynomial: CoordPoly = {}
   197	    symbols: list[sp.Symbol] = []
   198	    weights: dict[sp.Symbol, int] = {}
   199	    for i in range(degree + 1):
   200	        j = degree - i
   201	        symbol = sp.Symbol(f"{prefix}_{i}_{j}")
   202	        polynomial[(i, j)] = symbol
   203	        symbols.append(symbol)
   204	        weights[symbol] = weight
   205	    return polynomial, symbols, weights
   206	
   207	
   208	def cp_recurrence(
   209	    n: int,
   210	    h: Mapping[int, CoordPoly],
   211	    p: Mapping[int, CoordPoly],
   212	    q: Mapping[int, CoordPoly],
   213	) -> CoordPoly:
   214	    triple: list[CoordPoly] = []
   215	    for a in range(n + 1):
   216	        for b in range(n - a + 1):
   217	            c = n - a - b
   218	            if a in p and b in p and c in p:
   219	                triple.append(cp_mul(cp_mul(p[a], p[b]), p[c]))
   220	    pieces: list[CoordPoly] = [cp_add(*triple)]
   221	    for index in range(1, n + 1):
   222	        qband = q.get(n - index, {})
   223	        if not qband:
   224	            continue
   225	        square = cp_add(
   226	            *(cp_mul(h[a], h[index - a]) for a in range(index + 1) if a in h and index - a in h)

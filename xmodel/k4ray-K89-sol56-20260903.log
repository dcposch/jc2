   352	    def recurrence_parts(
   353	        self, hbands: Mapping[int, CoordPoly], pbands: Mapping[int, CoordPoly]
   354	    ) -> tuple[Any, Any]:
   355	        s_cache: dict[int, CoordPoly] = {}
   356	        t_cache: dict[int, CoordPoly] = {}
   357	
   358	        def sb(n: int) -> CoordPoly:
   359	            if n not in s_cache:
   360	                s_cache[n] = cp_add(
   361	                    *(cp_mul(hbands[a], hbands[n - a]) for a in range(n + 1))
   362	                )
   363	            return s_cache[n]
   364	
   365	        def tb(n: int) -> CoordPoly:
   366	            if n not in t_cache:
   367	                pieces = []
   368	                for a in range(n + 1):
   369	                    for b in range(n - a + 1):
   370	                        c = n - a - b
   371	                        if a in pbands and b in pbands and c in pbands:
   372	                            pieces.append(cp_mul(cp_mul(pbands[a], pbands[b]), pbands[c]))
   373	                t_cache[n] = cp_add(*pieces)
   374	            return t_cache[n]
   375	
   376	        return sb, tb

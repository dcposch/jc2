   859	def load_hint(path: Path | None, stage: str, weights: Sequence[int]) -> HilbertHint | None:
   860	    if path is None:
   861	        return None
   862	    payload = json.loads(path.read_text(encoding="utf-8"))
   863	    selected = payload.get("stages", {}).get(stage) if "stages" in payload else payload
   864	    if selected is None:
   865	        return None
   866	    selected_weights = tuple(int(value) for value in selected.get("weights", weights))
   867	    if len(selected_weights) != len(weights):
   868	        raise ValueError("Hilbert hint weight length does not match the selected ring")
   869	    return HilbertHint(
   870	        tuple(int(value) for value in selected["numerator"]),
   871	        selected_weights,
   872	        None if selected.get("predicted_length") is None else int(selected["predicted_length"]),
   873	    )

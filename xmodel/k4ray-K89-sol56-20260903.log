   802	def chart_json(chart: ScreenChart) -> dict[str, Any]:
   803	    return {
   804	        "type": "K4RAY-QUOTIENT-RECURRENCE-NECESSARY-SCREEN",
   805	        "K": chart.K,
   806	        "branch": chart.branch,
   807	        "scope": chart.scope,
   808	        "normalization": {
   809	            "jacobian_coefficient": 1,
   810	            "mu": "variable",
   811	            "mu_localizer": "mu*mu_inv-1",
   812	            "warning": (
   813	                "one torus normalization only; a POSDIM result is not a full-chart survivor"
   814	                if chart.scope == "NECESSARY_RECURRENCE_SUBSYSTEM"
   815	                else "one torus normalization only; POSDIM requires point extraction and exact J rebuild"
   816	            ),
   817	        },
   818	        "variables": chart.variables,
   819	        "weights": chart.weights,
   820	        "row_count": len(chart.rows),
   821	        "global_generators": chart.global_generators,
   822	        "bands": sorted({row.band for row in chart.rows}),
   823	        "denominator_lcm": chart.denominator_lcm,
   824	        "formula_checks": chart.formula_checks,
   825	        "elimination_audit": chart.elimination_audit,
   826	        "reconstruction": chart.reconstruction,
   827	        "chart_sha256": chart.chart_sha256,
   828	    }

   539	        "perturbed_lead_vdim": None if run["perturbed"] is None else run["perturbed"]["lead_vdim"],
   540	        "main_accepted": run["main"]["accepted"],
   541	        "perturbed_accepted": None if run["perturbed"] is None else run["perturbed"]["accepted"],
   542	        "elapsed_seconds": run["elapsed_seconds"],
   543	    }
   544	    atomic_write(RUNS / tag / "summary.json", json.dumps(summary, indent=2, sort_keys=True) + "\n")
   545	    print(json.dumps(summary, sort_keys=True))
   546	    return summary

import json
from fractions import Fraction as F

def norm(p):
    return {m:F(c) for m,c in p.items() if c}
def add(*ps):
    out={}
    for p in ps:
        for m,c in p.items(): out[m]=out.get(m,F(0))+c
    return norm(out)
def scale(c,p): return norm({m:F(c)*v for m,v in p.items()})
def mul(p,q):
    out={}
    for (i,j),a in p.items():
        for (k,l),b in q.items():
            m=(i+k,j+l); out[m]=out.get(m,F(0))+a*b
    return norm(out)
def power(p,n):
    out={(0,0):F(1)}
    for _ in range(n): out=mul(out,p)
    return out
def deriv(p,var):
    out={}
    for (i,j),c in p.items():
        e=(i,j)[var]
        if e:
            m=(i-1,j) if var==0 else (i,j-1)
            out[m]=c*e
    return norm(out)
def jac(p,q): return add(mul(deriv(p,0),deriv(q,1)),scale(-1,mul(deriv(p,1),deriv(q,0))))
def degree(p): return max((i+j for i,j in p),default=-1)
def top(p):
    n=degree(p)

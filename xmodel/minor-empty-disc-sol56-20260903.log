   233	dim std(I)                       = 10        (raw chart nonempty)
   234	dim std(I + <Z*cst - 1>)         = -1        (Keller-localised chart EMPTY)
   235	size(GB) = 1,  GB[1] = 1,  reduce(1,GB) = 0

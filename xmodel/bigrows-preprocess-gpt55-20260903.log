+INPUTS = Path("/tmp/jc2-lane.PIFGo9/inputs")
+RECEIPT = ROOT / "xmodel/bigrows-preprocess-gpt55-20260903.run.v2"
+PRIMES = (32003, 32009, 32027)
+
+

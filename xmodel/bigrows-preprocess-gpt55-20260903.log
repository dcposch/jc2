+
+UNFINISHED_24_16: list[tuple[str, tuple[int, ...]]] = [
+    ("24_16", (3, 1, 1, 1)),
+    ("24_16", (2, 2, 2)),
+    ("24_16", (2, 1, 1, 1, 1)),
+    ("24_16", (1, 1, 1, 1, 1, 1)),

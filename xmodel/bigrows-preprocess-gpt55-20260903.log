+            "strata_open_or_counting_bound": sum(1 for rec in records if rec.get("verdict") != "SATURATED-EMPTY"),
+            "rows_saturated_empty": sum(1 for bucket in row_summary.values() if bucket["verdict"] == "SATURATED-EMPTY"),

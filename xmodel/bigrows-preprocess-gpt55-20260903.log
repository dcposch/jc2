+    body = "\n".join(lines) + "\n"
+    nbytes, digest = body_seal(body)
+    seal = "\n".join(
+        [
+            "",
+            "## Seal",
+            "",
+            "- Body definition: every byte through the unique standalone `<!-- BODY-END -->` line, including its terminating newline.",
+            "- Body bytes: `%d`." % nbytes,

+def singular_expr(expr: sp.Expr, variables: Sequence[sp.Symbol] | None = None) -> str:
+    expr = sp.together(sp.expand(expr))
+    num, den = sp.fraction(expr)
+    num = sp.expand(num)
+    den = sp.expand(den)
+    if den == 1:
+        out = str(num)
+    elif den == -1:
+        out = str(-num)
+    else:
+        out = "(%s)/(%s)" % (num, den)
+    return out.replace("**", "^")

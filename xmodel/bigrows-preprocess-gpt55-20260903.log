+        key = row.get("key") or rec.get("meta", {}).get("row_key") or "unknown"
+        bucket = row_summary.setdefault(key, {"total": 0, "empty": 0, "open": [], "verdict": None})
+        bucket["total"] += 1
+        if rec.get("verdict") == "SATURATED-EMPTY":
+            bucket["empty"] += 1
+        else:

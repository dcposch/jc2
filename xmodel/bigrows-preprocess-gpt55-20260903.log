+            part = tuple(int(x) for x in re.split(r"[+_]", part_s) if x)
+            strata.append((row_key, part))
+    else:
+        strata.extend(LARGE_STRATA)
+        strata.extend(UNFINISHED_24_16)
+    inventory = []
+    for row_key, part in strata:
+        C = shape_for(ROWS[row_key])
+        est = {

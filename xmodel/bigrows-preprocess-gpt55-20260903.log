+                    "verdict": rec.get("verdict"),
+                    "reason": rec.get("reason"),
+                }
+            )
+    for key, bucket in row_summary.items():
+        bucket["verdict"] = "SATURATED-EMPTY" if bucket["total"] == bucket["empty"] else "COUNTING-BOUND"
+    summary = {

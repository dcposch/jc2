+    return {
+        "meta": meta,
+        "x": sp.Symbol("gamma"),
+        "y": sp.Symbol("pi"),
+        "h": data["h"],
+        "rows": rows,
+        "params": list(data["params"]),
+        "c": data["c"],
+        "sat": data["c"],
+        "slopes": [],

+def print_inventory() -> None:
+    rows = []
+    for key, row in ROWS.items():
+        C = shape_for(row)
+        for part in allowed_partitions(row):
+            if key != "24_16" and (key, part) not in LARGE_STRATA:
+                continue
+            if key == "24_16" and (key, part) not in UNFINISHED_24_16:
+                continue
+            rows.append(

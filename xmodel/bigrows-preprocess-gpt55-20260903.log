+    path.write_text(json.dumps(to_jsonable(rec), indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps({"verdict": rec.get("verdict"), "path": str(path.relative_to(ROOT))}, sort_keys=True))
+    return rec

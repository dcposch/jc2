+    V2: int
+    k: int
+
+
+@dataclass
+class TaggedRow:
+    source_index: int
+    h_power: int
+    monomial: tuple[int, int]
+    expr: sp.Expr
+
+
+@dataclass
+class Pivot:
+    step: int
+    source_index: int
+    h_power: int
+    monomial: tuple[int, int]
+    variable: sp.Symbol
+    coefficient: sp.Expr
+    rhs: sp.Expr
+    final_rhs: sp.Expr | None = None
+
+
+@dataclass
+class Reduction:
+    original_variables: list[sp.Symbol]
+    remaining_variables: list[sp.Symbol]
+    c: sp.Symbol
+    rows: list[TaggedRow]
+    original_rows: list[TaggedRow]
+    pivots: list[Pivot]
+    substitutions: dict[sp.Symbol, sp.Expr]
+    zero_source_indices: list[int]
+    elapsed: float
+
+
+class TimeLimitExceeded(TimeoutError):
+    pass

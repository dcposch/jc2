+def corrected_h_lower(C: dict) -> list[tuple[int, int]]:
+    """Lower h monomials using ord h(sigma_1) >= V2*d1 + u*d2."""
+    delta1: F = C["delta1"]
+    bound = C["V2"] * C["delta1"] + C["u"] * C["delta2"]
+    out = []
+    for j in range(C["K"], -1, -1):
+        for i in range(0, C["u"] + 1):
+            if i + j >= C["K"]:
+                continue
+            if -F(i, 1) + delta1 * F(j, 1) >= bound:
+                out.append((i, j))
+    return out
+

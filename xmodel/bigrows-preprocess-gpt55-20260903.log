+                "%s/%s" % (q.get("residual_unknowns", "?"), q.get("residual_equations", "?")),
+                gr.get("status", "?"),
+                factors,
+                rec.get("verdict", "?"),
+            ]
+        )
+    lines.append(markdown_table(table))
+    lines.extend(["", "## Row Verdicts", ""])

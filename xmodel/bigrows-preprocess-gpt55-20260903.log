+
+
+@dataclass
+class Pivot:
+    step: int
+    source_index: int
+    h_power: int
+    monomial: tuple[int, int]
+    variable: sp.Symbol
+    coefficient: sp.Expr
+    rhs: sp.Expr
+    final_rhs: sp.Expr | None = None
+
+
+@dataclass
+class Reduction:

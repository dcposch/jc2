+def run_batch(args) -> dict:
+    strata = []
+    if args.only:
+        for item in args.only.split(","):
+            row_key, part_s = item.split(":", 1)
+            part = tuple(int(x) for x in re.split(r"[+_]", part_s) if x)
+            strata.append((row_key, part))
+    else:

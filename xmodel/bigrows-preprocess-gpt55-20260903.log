+                gr.get("status", "?"),
+                factors,
+                rec.get("verdict", "?"),
+            ]
+        )
+    lines.append(markdown_table(table))
+    lines.extend(["", "## Row Verdicts", ""])
+    row_table = [["row", "verdict", "empty/total", "open strata"]]
+    for key, bucket in sorted(summary["rows"].items()):

+    if args.k16_control:
+        run_k16_control(args)
+    if args.run_batch:
+        run_batch(args)
+    if not any((args.verify, args.inventory, args.k16_control, args.run_batch)):
+        parser.print_help()
+
+
+if __name__ == "__main__":
+    main()


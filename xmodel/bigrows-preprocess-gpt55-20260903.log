+    ("24_16", (2, 2, 2)),
+    ("24_16", (2, 1, 1, 1, 1)),
+    ("24_16", (1, 1, 1, 1, 1, 1)),
+    ("24_16", (4, 1, 1)),
+    ("24_16", (3, 2, 1)),
+    ("24_16", (2, 2, 1, 1)),
+]

+        ]
+    else:
+        rec["verdict"] = "COUNTING-BOUND"
+        rec["reason"] = rec.get("reason") or (
+            "one or more irreducible base branches remain open"
+            if not any_survive
+            else "a nonunit branch lacks a representative/Jacobian check"
+        )
+    rec["elapsed"] = round(time.time() - started, 3)
+    return rec
+

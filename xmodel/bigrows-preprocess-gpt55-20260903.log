+def clean_name(value: str) -> str:
+    out = re.sub(r"[^A-Za-z0-9_]+", "_", value)
+    out = re.sub(r"_+", "_", out).strip("_")
+    if not out:
+        out = "v"
+    if out[0].isdigit():
+        out = "v" + out
+    return out

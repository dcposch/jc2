+                bucket["verdict"],
+                "%d/%d" % (bucket["empty"], bucket["total"]),
+                "; ".join("%s:%s" % (item["partition"], item.get("reason", item["verdict"])) for item in bucket["open"])[:180],
+            ]
+        )
+    lines.append(markdown_table(row_table))
+    lines.extend(
+        [
+            "",
+            "## Tally",
+            "",
+            "**MEASURED.** `%s`" % json.dumps(summary["tally"], sort_keys=True),
+            "",
+            "## FALLACY-v2",

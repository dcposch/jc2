+            "- Body bytes: `%d`." % nbytes,
+            "- Body SHA-256: `%s`." % digest,
+            "",
+        ]
+    )
+    (ROOT / "xmodel/bigrows-preprocess-gpt55-20260903.md").write_text(body + seal, encoding="utf-8")
+
+
+def run_batch(args) -> dict:
+    strata = []
+    if args.only:

+    "49_14": RowSpec("49_14", "(49,14;46;4;k=1)", 49, 14, 46, 4, 1),
+    "50_30": RowSpec("50_30", "(50,30;47;7;k=1)", 50, 30, 47, 7, 1),
+    "24_16": RowSpec("24_16", "(24,16;17;2;k=5)", 24, 16, 17, 2, 5),
+}
+
+LARGE_STRATA: list[tuple[str, tuple[int, ...]]] = [
+    ("25_15", (3,)),
+    ("25_15", (2, 1)),
+    ("25_15", (1, 1, 1)),
+    ("35_20", (3,)),

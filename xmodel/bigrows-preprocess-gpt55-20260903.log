+        run["script"] = str(sing_path.relative_to(ROOT))
+    rec = {
+        "typing": "MEASURED",
+        "manifest": verify_inputs(),
+        "actual_pair_control": actual_pair_control(),
+        "meta": {
+            "kind": "k16-t3-control",
+            "row": "(40,28;37;3;k=1)",
+            "expected": "36 -> residual -> K quadratic -> [1]",
+        },
+        "stages": {

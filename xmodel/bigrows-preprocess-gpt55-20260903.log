def affine_candidates(rows: list[SliceRow], remaining: list[sp.Symbol],
                      K: QuadraticField):
    occurrences = {
        variable: sum(variable in row.expr.free_symbols for row in rows)
        for variable in remaining
    }
    candidates = []
    for row_index, row in enumerate(rows):
        terms = sp.Add.make_args(row.expr)
        for variable_index, variable in enumerate(remaining):
            if variable not in row.expr.free_symbols:
                continue
            coefficient_terms = []
            remainder_terms = []
            nonlinear = False
            for term in terms:
                exponent = term.as_powers_dict().get(variable, 0)
                if exponent == 0:
                    remainder_terms.append(term)
                elif exponent == 1:
                    coefficient_terms.append(term / variable)
                else:
                    nonlinear = True
                    break
            if nonlinear:
                continue
            coefficient = sp.Add(*coefficient_terms)
            remainder = sp.Add(*remainder_terms)
            if coefficient.free_symbols - {K.y} or coefficient == 0:
                continue
            if K.reduce(row.expr - coefficient*variable - remainder) != 0:
                raise AssertionError("affine decomposition failed")
            # Favor short remainders and variables occurring in few rows.
            # The inverse and expanded right side are computed only for the
            # chosen candidate, avoiding dozens of large speculative expands.
            score = (
                len(str(remainder)) * occurrences[variable],
                len(str(remainder)),
                occurrences[variable],
                len(str(row.expr)),
                row.source_index,
                variable_index,
            )
            candidates.append((score, row_index, variable_index, coefficient,
                               remainder))
    return candidates


def eliminate_over_k(rows: list[SliceRow], auxiliary: list[sp.Symbol],
                     K: QuadraticField, max_seconds: float = 600.0,
                     max_bytes: int = 12_000_000):
    started = time.monotonic()
    remaining = list(auxiliary)
    rows, initial_dropped = deduplicate_k(rows, K, remaining)
    pivots: list[KPivot] = []
    dropped = list(initial_dropped)
    terminal_unit = None

    while True:
        if time.monotonic() - started > max_seconds:
            raise RuntimeError("quadratic-field elimination time bound exceeded")
        constants = [row for row in rows
                     if not (row.expr.free_symbols - {K.y})]
        if constants:
            row = min(constants, key=lambda item: (len(str(item.expr)),
                                                   item.source_index))
            inverse = K.inverse(row.expr)
            terminal_unit = {
                "source_index": row.source_index,
                "constant": str(row.expr),
                "inverse": str(inverse),
                "identity_verified_mod_H": K.reduce(row.expr*inverse - 1) == 0,
            }
            break
        candidates = affine_candidates(rows, remaining, K)
        if not candidates:
            break
        (_score, row_index, variable_index, coefficient, remainder) = min(
            candidates, key=lambda item: item[0]
        )
        pivot_row = rows[row_index]
        variable = remaining[variable_index]
        inverse = K.inverse(coefficient)
        rhs = K.reduce(-inverse * remainder)
        if variable in rhs.free_symbols:
            raise AssertionError("pivot right side contains pivot variable")
        if K.reduce(pivot_row.expr.subs(variable, rhs)) != 0:
            raise AssertionError("K pivot does not kill its row")
        del rows[row_index]
        del remaining[variable_index]
        next_rows = []
        for row in rows:
            expr = row.expr
            if variable in expr.free_symbols:
                expr = K.reduce(expr.subs(variable, rhs))
            else:
                expr = K.reduce(expr)
            next_rows.append(dataclasses.replace(row, expr=expr))
        rows, newly_dropped = deduplicate_k(next_rows, K, remaining)
        dropped.extend(newly_dropped)
        expression_bytes = sum(len(str(row.expr)) for row in rows)
        if expression_bytes > max_bytes:
            raise RuntimeError("quadratic-field residual byte bound exceeded: %d"
                               % expression_bytes)
        pivots.append(KPivot(
            step=len(pivots) + 1,
            source_index=pivot_row.source_index,
            h_power=pivot_row.h_power,
            monomial=pivot_row.monomial,
            variable=variable,
            coefficient=coefficient,
            inverse=inverse,
            step_rhs=rhs,
            remaining_rows_after=len(rows),
            expression_bytes_after=expression_bytes,
        ))
        print("K_PIVOT step=%d source=%d variable=%s rows=%d vars=%d bytes=%d" % (
            len(pivots), pivot_row.source_index, variable, len(rows),
            len(remaining), expression_bytes), flush=True)
    return rows, remaining, pivots, dropped, terminal_unit, time.monotonic()-started


def emit_k_system(rows: list[SliceRow], remaining: list[sp.Symbol],
                  y: sp.Symbol, method: str, terminal_unit: dict | None) -> str:
    if method not in ("std", "slimgb"):
        raise ValueError(method)
    polynomial_variables = [y] + remaining
    generators = [singular_expr(row.expr, polynomial_variables) for row in rows]
    if terminal_unit is not None:
        # A checked nonzero coefficient-field constant is a unit.  Emitting 1
        # makes the final certificate explicit; the pivot table records its
        # preimage through the quotient isomorphisms.
        generators.append("1")
    if not generators:
        generators = ["0"]
    lines = [
        "// exact t=3 system over K=Q(y)/(147*y^2-84*y+11)",
        "// y denotes q7_1 after the rigorously normalized q4_1=1 slice",
        "// c=10*y*(2-21*y)/343 is a coefficient-field unit and is eliminated",
    ]
    emit_actual_pair(lines)
    lines.extend([
        "ring RC=(0,%s),(u,W),dp;" % y,
        "minpoly=147*%s^2-84*%s+11;" % (y, y),
        "number cbar=(10*%s*(2-21*%s))/343;" % (y, y),
        "number cbar_inverse=1/cbar;",
        'if (cbar*cbar_inverse==1) { print("CONTROL_C_UNIT_PASS"); }'
        ' else { print("CONTROL_C_UNIT_FAIL"); }',
        "ideal CE=u,W*u-1;",
        "ideal GE=std(CE);",
        'if (reduce(1,GE)==0) { print("CONTROL_EMPTY_PASS"); }'
        ' else { print("CONTROL_EMPTY_FAIL"); }',
        "ideal CN=u-1,W*u-1;",
        "ideal GN=std(CN);",
        'if (reduce(1,GN)!=0) { print("CONTROL_NONEMPTY_PASS"); }'
        ' else { print("CONTROL_NONEMPTY_FAIL"); }',
        "ring RK=(0,%s),(%s),dp;" % (y, ",".join(map(str, remaining))),
        "minpoly=147*%s^2-84*%s+11;" % (y, y),
        "option(redSB);",
        'if (nameof(basering)=="RK") { print("CONTROL_RING_PASS RK"); }'
        ' else { print("CONTROL_RING_FAIL"); }',
        'print("MAIN_START t=3 normalized_q4_1=1 coefficient_field=quadratic '
        'residual_equations=%d residual_unknowns=%d");'
        % (len(rows) + (1 if terminal_unit else 0), len(remaining)),
        "ideal I=%s;" % ",\n".join(generators),
        "ideal G=%s(I);" % method,
        'print("MAIN_DONE basis_size=");',
        "size(G);",
        'if (reduce(1,G)==0) { print("MAIN_QUADRATIC_FIELD_EMPTY"); G; }'
        ' else { print("MAIN_QUADRATIC_FIELD_NONTRIVIAL");'
        ' print("BASIS_OUTPUT_TRUNCATED_TO_20");'
        ' int basis_cap=size(G); if (basis_cap>20) { basis_cap=20; }'
        ' for (int basis_i=1; basis_i<=basis_cap; basis_i++)'
        ' { G[basis_i]; } }',
        "quit;",
    ])
    return "\n".join(lines) + "\n"


def main() -> None:
    if HERE != ROOT / "box/k16t3-20260903/preprocessed":
        raise RuntimeError("output directory invariant failed")
    if sha256_file(HERE / "triangular_preprocess.py") != EXPECTED_TRIANGULAR_DRIVER_SHA256:
        raise RuntimeError("triangular_preprocess.py hash differs from audited input")

    generic = tp.load_module(tp.GENERIC_DRIVER, "normalized_slice_generic")
    data = generic.build(t=3, gauged=True)
    reduction = tp.reduce_chart(data, 256, 600.0, 5_000_000)
    if len(reduction.rows) != 37 or len(reduction.remaining_variables) + 1 != 23:
        raise AssertionError("unexpected t=3 triangular reduction dimensions")

    all_variables = reduction.remaining_variables + [reduction.c]
    if set(map(str, all_variables)) != set(WEIGHTS):
        raise AssertionError("weight table does not match residual variables")
    homogeneity = []
    for row in reduction.rows:
        homogeneity.append({
            "source_index": row.source_index,
            "h_power": row.h_power,
            "monomial": list(row.monomial),
            "weighted_degree": weighted_degree(row.expr, all_variables),
        })

    by_name = {str(variable): variable for variable in all_variables}
    x = by_name["q4_1"]
    y = by_name["q7_1"]
    c = reduction.c
    Hhom = 11*x**4 - 84*x**2*y + 147*y**2
    H = Hhom.subs(x, 1)
    c_image = 10*x*y*(2*x**2 - 21*y) / 343

    c_rows = [row for row in reduction.rows if c in row.expr.free_symbols]
    if len(c_rows) != 1:
        raise AssertionError("expected exactly one c row")
    c_row = c_rows[0]
    c_coefficient = sp.diff(c_row.expr, c)
    c_remainder = sp.expand(c_row.expr - c_coefficient*c)
    if not c_coefficient.is_Rational or c_coefficient == 0:
        raise AssertionError("c row does not have a Q-constant pivot")
    solved_c = sp.expand(-c_remainder/c_coefficient)
    if sp.expand(solved_c - c_image) != 0:
        raise AssertionError("c-row closed form differs")

    base_matches = []
    for row in reduction.rows:
        if row is c_row:
            continue
        if row.expr.free_symbols <= {x, y}:
            ratio = rational_associate(row.expr, Hhom, all_variables)
            if ratio is not None:
                base_matches.append((row, ratio))
    if len(base_matches) != 1:
        raise AssertionError("expected one quadratic base row")
    base_row, base_ratio = base_matches[0]

    auxiliary = [variable for variable in reduction.remaining_variables
                 if variable not in (x, y)]
    q_variables = auxiliary + [y]
    sliced_raw = []
    for row in reduction.rows:
        if row is c_row:
            continue
        expr = sp.expand(row.expr.subs({x: 1, c: c_image.subs(x, 1)},
                                       simultaneous=True))
        sliced_raw.append(SliceRow(row.source_index, row.h_power,
                                  row.monomial, expr))

    # Replace each Q row by a primitive integral Q* associate and delete only
    # literal repeats of that canonical representative.
    q_rows: list[SliceRow] = []
    q_row_map = []
    canonical_to_index: dict[str, int] = {}
    for row in sliced_raw:
        primitive, multiplier = primitive_expr(row.expr, q_variables)
        key = str(primitive)
        if key not in canonical_to_index:
            canonical_to_index[key] = len(q_rows)
            q_rows.append(dataclasses.replace(row, expr=primitive))
            q_row_map.append({
                "source_index": row.source_index,
                "representative_source_index": row.source_index,
                "status": "kept",
                "integer_row_multiplier": str(multiplier),
            })
        else:
            representative = q_rows[canonical_to_index[key]]
            q_row_map.append({
                "source_index": row.source_index,
                "representative_source_index": representative.source_index,
                "status": "duplicate_dropped",
                "integer_row_multiplier": str(multiplier),
            })
    if not any(sp.expand(row.expr-H) == 0 for row in q_rows):
        # Primitive sign normalization may have chosen -H.
        if not any(sp.expand(row.expr+H) == 0 for row in q_rows):
            raise AssertionError("quadratic base row missing from Q slice")

    generated = []
    for method in ("std", "slimgb"):
        path = HERE / ("t3_normalized_Q_%s.sing" % method)
        path.write_text(emit_q_slice(q_rows, auxiliary, y, method),
                        encoding="utf-8")
        generated.append(path)

    # Pass to the exact quadratic coefficient field and remove H, which is now
    # the field's minimal polynomial rather than an ideal generator.
    K = QuadraticField(y, auxiliary)
    if K.reduce(H) != 0:
        raise AssertionError("quadratic reduction does not kill H")
    y_inverse = K.inverse(y)
    d_inverse = K.inverse(2 - 21*y)
    if K.reduce(y*y_inverse - 1) != 0 or K.reduce((2-21*y)*d_inverse - 1) != 0:
        raise AssertionError("base unit identities failed")
    k_input = []
    k_base_dropped = []
    for row in q_rows:
        expr = K.reduce(row.expr)
        if expr == 0:
            k_base_dropped.append(row.source_index)
        else:
            k_input.append(dataclasses.replace(row, expr=expr))
    if base_row.source_index not in k_base_dropped:

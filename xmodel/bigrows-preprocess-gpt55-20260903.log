+                "polynomial": audit["base_row"]["slice_minpoly"],
+                "factors": [
+                    {
+                        "factor": audit["base_row"]["slice_minpoly"],
+                        "degree": 2,
+                        "multiplicity": 1,
+                    }
+                ],
+            },
+            "K_elimination": {

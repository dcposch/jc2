+                "strictly_positive": True,
+                "weights": audit["homogeneity"]["weights"],
+            },
+            "normalization": {
+                "status": "SLICED",
+                "normalizing_variable": audit["normalization"]["normalizing_variable"],
+                "covering": audit["covering_argument"]["torus_slice"],
+            },
+            "univariate_base": {
+                "variable": audit["normalization"]["base_variable"],
+                "polynomial": audit["normalization"]["base_equation"],
+                "factors": audit["normalization"]["base_factorization"],
+            },

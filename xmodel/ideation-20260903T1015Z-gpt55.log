I’m doing one small census analysis now: compare the 658 `(1)-(13)` survivors with Moh’s six rows on transformed/top-level invariants. This is not a proof; it is meant to identify the cheapest discriminator a real lane should test.
exec
/bin/bash -lc "python3 - <<'PY'
import sys, os
sys.path.insert(0,'/home/ubuntu/jc2/box')
from moh_skeleton_full import census, Skel, MOH_TABLE
from collections import Counter, defaultdict
printed=set()
for n,m,Ms,Vs,lab,*rest in MOH_TABLE:
    printed.add((n,m,tuple(Ms),tuple(sorted(Vs.items()))))
rows=[]
for n in range(1,101):
  for m,Ms,V in census(n,Kmin=2,full=True):
    S=Skel(n,m,list(Ms),V)
    key=(n,m,tuple(Ms),tuple(sorted(V.items())))
    rows.append((S,key in printed))
print('rows',len(rows),'printed',sum(p for _,p in rows))
# summarize exact invariants and how printed sits
invars=[]
for S,p in rows:
    ds=S.d[S.s]
    us=ds-S.V[S.s]
    Mprev=S.M[S.s-1] if S.s>=2 else None
    trans_last_num = Mprev/ds if Mprev is not None else None
    invars.append((S,p,ds,us,trans_last_num))
for name, func in [
    ('s', lambda S: S.s),
    ('K', lambda S: S.K),
    ('ds', lambda S: S.d[S.s]),
    ('us=ds-Vs', lambda S: S.d[S.s]-S.V[S.s]),
    ('d,e', lambda S: (S.dd,S.e)),
    ('V_s', lambda S: S.V[S.s]),
    ('M2modK', lambda S: S.M[2] % S.K if S.s>=2 else None),
    ('last/ds integer', lambda S: S.M[S.s-1] % S.d[S.s] == 0 if S.s>=2 else None),
    ('Mprev/ds > m/K?', lambda S: S.M[S.s-1]//S.d[S.s] > S.m//S.K if S.s>=2 and S.M[S.s-1] % S.d[S.s]==0 else None),
    ('Mprev/ds >= m/K?', lambda S: S.M[S.s-1]//S.d[S.s] >= S.m//S.K if S.s>=2 and S.M[S.s-1] % S.d[S.s]==0 else None),
    ('any10', lambda S: S.any10()),
    ('A1', lambda S: S.A(1)),
    ('q', lambda S: S.q()),
]:
    c=Counter(func(S) for S,_ in rows)
    pc=Counter(func(S) for S,p in rows if p)
    print('\\n',name,'top',c.most_common(8),'printed',pc)
# simple predicates that keep printed; count survivors
preds={
 'us==1': lambda S: S.d[S.s]-S.V[S.s]==1,
 's==3': lambda S: S.s==3,
 'last_div_ds': lambda S: S.M[S.s-1] % S.d[S.s]==0,
 'last_div_ds_and_gt_mK': lambda S: S.s>=2 and S.M[S.s-1] % S.d[S.s]==0 and S.M[S.s-1]//S.d[S.s] > S.m//S.K,
 'last_div_ds_and_ge_mK': lambda S: S.s>=2 and S.M[S.s-1] % S.d[S.s]==0 and S.M[S.s-1]//S.d[S.s] >= S.m//S.K,
 'last_div_ds_and_lt_n2': lambda S: S.s>=2 and S.M[S.s-1] % S.d[S.s]==0 and S.M[S.s-1]//S.d[S.s] < S.n//S.d[S.s]-2,
 'us==1_and_gt': lambda S: S.d[S.s]-S.V[S.s]==1 and S.M[S.s-1] % S.d[S.s]==0 and S.M[S.s-1]//S.d[S.s] > S.m//S.K,
 'us==1_and_between': lambda S: S.d[S.s]-S.V[S.s]==1 and S.M[S.s-1] % S.d[S.s]==0 and S.m//S.K < S.M[S.s-1]//S.d[S.s] < S.n//S.d[S.s]-2,
}
for name,pred in preds.items():
    keep=[(S,p) for S,p in rows if pred(S)]
    print('\\nPRED',name,'keeps',len(keep),'printed',sum(p for _,p in keep),'classes',len({(S.n,S.m) for S,_ in keep}))
    if sum(p for _,p in keep)==6 and len(keep)<100:
        for S,p in keep[:40]: print(' ',('*' if p else ' '),S.n,S.m,[S.M[i] for i in range(2,S.s+1)],S.V,'ds',S.d[S.s],'us',S.d[S.s]-S.V[S.s])
# Specific (75,50)
print('\\n(75,50) rows')
for S,p in rows:
    if S.n==75 and S.m==50:
        ds=S.d[S.s]
        print('*' if p else ' ', [S.M[i] for i in range(2,S.s+1)], S.V, 'ds',ds,'us',ds-S.V[S.s], 'M2/ds', S.M[2]/ds, 'q', S.q(), 'A1',S.A(1),'any10',S.any10())

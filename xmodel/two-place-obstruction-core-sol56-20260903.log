/bin/bash -lc "timeout 1800 python3 - <<'PY'
import importlib.util,itertools,sys,subprocess,time
from pathlib import Path
import sympy as sp
p=Path(\"box/g108band-20260903/band_engine.py\")
sys.path.insert(0,str(p.parent.resolve()))
spec=importlib.util.spec_from_file_location(\"g108m\",p)
m=importlib.util.module_from_spec(spec)
sys.modules[\"g108m\"]=m
spec.loader.exec_module(m)
raw_rows,_=m.minor_incidence_rows()
rows=[(lab,e) for lab,e in raw_rows if e"'!=0]
variables=["Hc_1_7","Hc_1_8","Hc_2_6","Hc_2_7","Hc_3_6","Hc_4_5","Hc_5_4","jet1","jet2","c","Zc"]
def ss(e):
    return str(sp.expand(e)).replace("**","''^")
decl=["ring R=0,("+",".join(variables)+"),dp;"]
for lab,e in rows:
    decl.append("poly "+lab+"="+ss(e)+";")
decl.append("poly L=Zc*c-1;")
decl.append("proc unit(ideal I) { ideal S=std(I); return(reduce(1,S)==0); }")
labels=[lab for lab,_ in rows]
print("labels",len(labels),labels,flush=True)
for k in range(1,len(labels)+1):
    lines=list(decl)
    combos=list(itertools.combinations(range(len(labels)),k))
    for n,ind in enumerate(combos):
        gens=[labels[i] for i in ind]+["L"]
        lines.append("ideal I"+str(n)+"="+",".join(gens)+";")
        lines.append('"'if (unit(I'+str(n)+')) { \"UNIT '+','.join(map(str,ind))+'\"; }')
        lines.append(\"kill I\"+str(n)+\";\")
    started=time.time()
    proc=subprocess.run([\"Singular\",\"-q\"],input=\"\\n\".join(lines)+\"\\n\",text=True,capture_output=True,check=True)
    hits=[x for x in proc.stdout.splitlines() if x.startswith(\"UNIT\")]
    print(\"k\",k,\"tested\",len(combos),\"seconds\",round(time.time()-started,3),\"hits\",len(hits),flush=True)
    if hits:
        for hit in hits[:30]:
            ind=tuple(map(int,hit.split()[1].split(\",\")))
            print(\"  \",[labels[i] for i in ind],flush=True)
        break

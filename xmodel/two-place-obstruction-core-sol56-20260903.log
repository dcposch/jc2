+    expected_substitutions = {
+        "Hc_1_7": "0",
+        "Hc_1_8": "0",
+        "Hc_2_6": "0",
+        "Hc_2_7": "2*jet1",
+        "Hc_3_6": "0",
+        "Hc_4_5": "jet1**2",
+        "Hc_5_4": "0",

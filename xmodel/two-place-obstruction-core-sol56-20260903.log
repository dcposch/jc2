   300	            continue
   301	        pivot_closure.add(pivot_label)
   302	        pending.update(raw[pivot_label].free_symbols.intersection(hvars))
   303	    assert pivot_closure == {pivot.row for pivot in pivots}
   304	
   305	    # Perturb the n=8, pi^0 incidence row by deleting its -c term.  The
   306	    # displayed certificate ceases to be 1, and the explicit point below
   307	    # satisfies every perturbed support row plus the localization wrapper.
   308	    perturbed_raw = dict(raw)
   309	    perturbed_raw["minor_n8_pi0"] = sp.expand(raw["minor_n8_pi0"] + c)
   310	    perturbed_identity = minimal_wrapper_coefficient * wrapper + sum(
   311	        minimal_raw_coefficients[label] * perturbed_raw[label]
   312	        for label in minimal_raw_coefficients
   313	    )
   314	    assert sp.expand(perturbed_identity - 1) != 0
   315	    witness = {**{variable: 0 for variable in hvars}, jet1: 0, jet2: 0, c: 1, Zc: 1}
   316	    assert all(
   317	        sp.expand(perturbed_raw[label].subs(witness)) == 0
   318	        for label in minimal_raw_coefficients
   319	    )
   320	    assert sp.expand(wrapper.subs(witness)) == 0
   321	
   322	    output = {
   323	        "case": "D108-delta3",
   324	        "ring": "Q[Hc_1_7,Hc_1_8,Hc_2_6,Hc_2_7,Hc_3_6,Hc_4_5,Hc_5_4,jet1,jet2,c,Zc]",
   325	        "provenance": {"incidence": 9, "localization": 1, "outer": 0, "pole": 0, "Jacobian": 0},
   326	        "deepest_t_power": 8,
   327	        "raw_label_count": len(rows),
   328	        "raw_nonzero_count": sum(value != 0 for _, value in rows),
   329	        "qstar_pivots": [
   330	            {
   331	                "row": pivot.row,
   332	                "variable": str(pivot.variable),
   333	                "coefficient": str(pivot.coefficient),
   334	                "resolved_value": str(substitutions[pivot.variable]),
   335	            }
   336	            for pivot in pivots
   337	        ],
   338	        "pivot_dependency_closure": sorted(pivot_closure),
   339	        "residual": {label: str(value) for label, value in residual.items()},
   340	        "readable_three_residue_certificate": {
   341	            **{label: expression_text(value) for label, value in readable_reduced_coefficients.items()},
   342	            "Zc*c-1": "-1",
   343	        },
   344	        "readable_prepivot_certificate": {
   345	            **{label: expression_text(value) for label, value in readable_raw_coefficients.items()},
   346	            "Zc*c-1": "-1",
   347	        },
   348	        "minimal_reduced_certificate": {
   349	            **{label: expression_text(value) for label, value in minimal_reduced_coefficients.items()},
   350	            "Zc*c-1": expression_text(minimal_wrapper_coefficient),
   351	        },
   352	        "minimal_prepivot_certificate": {
   353	            **{label: expression_text(value) for label, value in minimal_raw_coefficients.items()},
   354	            "Zc*c-1": expression_text(minimal_wrapper_coefficient),
   355	        },
   356	        "minimal_prepivot_support_rows": len(minimal_raw_coefficients) + 1,
   357	        "readable_prepivot_support_rows": len(readable_raw_coefficients) + 1,
   358	        "identity": str(sp.expand(minimal_raw_identity)),
   359	        "outer_A2_A3_B2_touched": False,
   360	        "T2_T3_bridge_touched": False,
     1	#!/usr/bin/env python3
     2	"""Exact checks for the symbolic first-point block of the obstruction map.
     3	
     4	This is deliberately a matrix/ODE check, not a new chart computation.  It
     5	instantiates Fable's L_n on coefficient vectors and verifies the claimed
     6	kernel in the two skeletons used by the certificate slice.
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	import json
    12	import sympy as sp
    13	from sympy.polys.matrices import DomainMatrix
    14	
    15	
    16	w = sp.symbols("w")
    17	
    18	
    19	def coefficient_vector(poly: sp.Expr, degree: int) -> sp.Matrix:
    20	    expanded = sp.Poly(sp.expand(poly), w, domain=sp.QQ)
    21	    return sp.Matrix([expanded.nth(index) for index in range(degree + 1)])
    22	
    23	
    24	def first_point_matrix(
    25	    d2: int, d3: int, u3: int, v3: int, level: int
    26	) -> tuple[sp.Matrix, sp.Expr, sp.Expr]:
    27	    """Matrix of L_level on Q[w]_{<=d2} in ascending monomial bases."""
    28	    assert d2 % d3 == 0
    29	    assert u3 + v3 == d3
    30	    degree_f = 3 * d2
    31	    top_h3 = w**u3 * (w - 1) ** v3
    32	    A0 = sp.expand(top_h3 ** (d2 // d3))
    33	
    34	    def L(poly: sp.Expr) -> sp.Expr:
    35	        return sp.expand(
    36	            degree_f * A0 * sp.diff(poly, w)
    37	            - (degree_f - 3 * level) * sp.diff(A0, w) * poly
    38	        )
    39	
    40	    image_degree = 2 * d2 - 1
    41	    columns = [coefficient_vector(L(w**index), image_degree) for index in range(d2 + 1)]
    42	    matrix = sp.Matrix.hstack(*columns)
    43	
    44	    # Check the closed coefficient formula.  If A0=sum_a p_a*w^a, then
    45	    # [w^ell]L(w^k)=(N*k-(N-3n)*a)*p_a, a=ell-k+1.
    46	    A_poly = sp.Poly(A0, w, domain=sp.QQ)
    47	    for ell in range(image_degree + 1):
    48	        for k in range(d2 + 1):
    49	            a = ell - k + 1
    50	            p_a = A_poly.nth(a) if 0 <= a <= d2 else 0
    51	            expected = (degree_f * k - (degree_f - 3 * level) * a) * p_a
    52	            assert matrix[ell, k] == expected
    53	    return matrix, top_h3, A0
    54	
    55	
    56	def kernel_case(d2: int, d3: int, u3: int, v3: int, level: int) -> dict:
    57	    matrix, top_h3, _A0 = first_point_matrix(d2, d3, u3, v3, level)
    58	    rank = DomainMatrix.from_Matrix(matrix).to_field().rank()
    59	    expected_dimension = 1 if level % d3 == 0 and level <= d2 else 0
    60	    kernel_dimension = matrix.cols - rank
    61	    assert kernel_dimension == expected_dimension
    62	    expected_generator = None
    63	    if expected_dimension:
    64	        exponent = d2 // d3 - level // d3
    65	        expected_generator = sp.expand(top_h3**exponent)
    66	        expected_vector = coefficient_vector(expected_generator, d2)
    67	        assert matrix * expected_vector == sp.zeros(matrix.rows, 1)
    68	        # The rank computation gives nullity one, so membership proves equality
    69	        # of the two one-dimensional spans without computing a costly rref.
    70	    return {
    71	        "d2": d2,
    72	        "d3": d3,
    73	        "u3": u3,
    74	        "v3": v3,
    75	        "level": level,
    76	        "matrix_shape": list(matrix.shape),
    77	        "rank": rank,
    78	        "kernel_dimension": kernel_dimension,
    79	        "kernel_generator": None if expected_generator is None else str(sp.factor(expected_generator)),
    80	    }
    81	
    82	
    83	def schur_identity() -> str:
    84	    """Verify the scalar block-elimination identity used in the report."""
    85	    a, b, c0, d = sp.symbols("a b c0 d", nonzero=True)
    86	    obstruction = sp.Matrix([[a, b], [c0, d]])
    87	    eliminator = sp.Matrix([[1, 0], [-c0 / a, 1]])
    88	    reduced = sp.simplify(eliminator * obstruction)
    89	    assert reduced == sp.Matrix([[a, b], [0, d - c0 * b / a]])
    90	    assert sp.factor(obstruction.det()) == sp.factor(a * (d - c0 * b / a))
    91	    return "det([[A,B],[C,D]])=det(A)*det(D-C*A^(-1)*B)"
    92	
    93	
    94	def main() -> None:
    95	    cases = [
    96	        kernel_case(33, 11, 3, 8, 4),
    97	        kernel_case(33, 11, 3, 8, 11),
    98	        kernel_case(36, 9, 2, 7, 9),
    99	    ]
   100	    output = {
   101	        "operator": "L_n(B)=N*A0*B'-(N-3*n)*A0'*B, N=3*d2, A0=(top_h3)^(d2/d3)",
   102	        "entry_formula": "L[n]_(ell,k)=(N*k-(N-3*n)*(ell-k+1))*[w^(ell-k+1)]A0",
   103	        "schur_identity": schur_identity(),
   104	        "cases": cases,
   105	    }
   106	    print(json.dumps(output, indent=2, sort_keys=True))
   107	
   108	
   109	if __name__ == "__main__":
   110	    main()


   407	            "engine_pivot_rows_touched": 8,
   408	            "support_minimal_rows_for_B1c_3_21_zero": 7,
   409	            "support_labels": [f"B1_D1_s0_k{k}" for k in range(1, 8)],
   410	            "B1c_3_21_step": {
   411	                "row": "B1_D1_s0_k6",
   412	                "coefficient": "5103",

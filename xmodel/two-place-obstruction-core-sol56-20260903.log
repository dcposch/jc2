   274	        "minor_n8_pi1": {jet1: 1, jet2: 0, c: -1, Zc: -1},
   275	        "Zc*c-1": {jet1: 0, jet2: 0, c: 0, Zc: 0},
   276	    }
   277	    minimal_three = {
   278	        "minor_n8_pi0": residual["minor_n8_pi0"],
   279	        "minor_n8_pi1": residual["minor_n8_pi1"],
   280	        "Zc*c-1": wrapper,
   281	    }
   282	    for dropped, witness0 in drop_witnesses.items():
   283	        assert all(
   284	            sp.expand(value.subs(witness0)) == 0
   285	            for label, value in minimal_three.items()
   286	            if label != dropped
   287	        )
   288	
   289	    # Every recorded Q* pivot lies in the dependency closure of either the
   290	    # readable three-residue support or the strictly pruned two-residue support.
   291	    pivot_by_variable = {pivot.variable: pivot.row for pivot in pivots}
   292	    pending = set().union(
   293	        *(raw[label].free_symbols.intersection(hvars) for label in minimal_reduced_coefficients)
   294	    )

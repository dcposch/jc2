   360	                   if v.startswith("Hc_"))
   361	incidence_labels = [step_by_h[v]["label"] for v in sorted(incidence_variables)]
   362	assert len(incidence_labels) == 17
   363	assert "Hc_11_0" not in incidence_variables
   364	
   365	
   366	# The seven h2-D1 pivot variables are absent from the terminal/Jacobian core.
   367	h2_pivots = {
   368	    "K2c_11_16", "K2c_15_13", "K2c_19_10", "K2c_23_7",
   369	    "K2c_27_4", "K2c_10_17", "K2c_14_14",
   370	}
   371	core_symbols = set(pole_sym.free_symbols)
   372	for _label, row in all_rows:
   373	    core_symbols.update(row.free_symbols)
   374	assert not h2_pivots.intersection(map(str, core_symbols))
   375	
   376	# No live A2/A3/B2 coefficient or T2/T3 bridge row is present post-D2.
   377	assert not any(str(x).startswith(("A2c_", "A3c_", "B2c_"))
   378	               for x in core_symbols)
   379	assert not any("T2" in label or "T3" in label
   380	               for label, _row in all_rows)
   381	

+"""
+
+from __future__ import annotations
+
+from collections import defaultdict
+from dataclasses import dataclass
+from math import ceil, comb, factorial
+import json
+
+import sympy as sp
+
+
+jet1, jet2, pi, c, Zc = sp.symbols("jet1 jet2 pi c Zc")

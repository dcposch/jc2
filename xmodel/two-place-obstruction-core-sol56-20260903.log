+A = -9*jet1*jet2^2*Zc^2-Zc,
+B = -(9/2)*jet1^3*jet2^2*Zc^2
+    +(81/2)*jet2^4*Zc^2-(1/2)*jet1^2*Zc,
+C = -9*jet1*jet2^2*Zc-1.

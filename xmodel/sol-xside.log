   848	# ------------------------------------------------------------- per point
   849	GATES = []
   850	def chk(name, cond, hard=True):
   851	    GATES.append((name, bool(cond), hard))
   852	    print(("PASS " if cond else ("FAIL " if hard else "WARN ")) + name,
   853	          flush=True)
   854	    if hard and not cond:
   855	        raise SystemExit("EULER-E GATE FAILS at " + name)

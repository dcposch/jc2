   204	
   205	def smul(a, b, p):
   206	    """Dual series product: a = (v, g), g (S, GD) or None."""
   207	    va, ga = a
   208	    vb, gb = b
   209	    Ta = toep(va)
   210	    v = np.mod(Ta @ vb, p)
   211	    g = None
   212	    if gb is not None or ga is not None:
   213	        g = np.zeros((_S, GD))
   214	        if gb is not None:
   215	            g += Ta @ gb
   216	        if ga is not None:
   217	            g += toep(vb) @ ga
   218	        g %= p
   219	    return (v, g)
   220	
   221	def sscal(a, c, p):
   222	    va, ga = a
   223	    return (np.mod(va * c, p), None if ga is None else np.mod(ga * c, p))
   224	
   225	def sadd(a, b, p):
   226	    va, ga = a
   227	    vb, gb = b
   228	    g = None
   229	    if ga is not None or gb is not None:
   230	        g = np.zeros((_S, GD))
   231	        if ga is not None:
   232	            g += ga
   233	        if gb is not None:
   234	            g += gb
   235	        g %= p
   236	    return (np.mod(va + vb, p), g)

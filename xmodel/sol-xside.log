   242	def ext_subst(poly, forms, p, gb=None, cap=TERM_STOP):
   243	    """Substitute solved variables (forms: name -> RESOLVED ext poly,
   244	    free of solved names) into poly; optional final NF."""
   245	    out = {}
   246	    for (s, l), c in poly.items():
   247	        base = {(s, ()): c}
   248	        freel = []
   249	        for nm, e in l:
   250	            if nm in forms:
   251	                for _ in range(e):
   252	                    base = ext_mul(base, forms[nm], p)
   253	                    if len(base) > cap:
   254	                        raise StopReport("term cap %d exceeded in subst"
   255	                                         % cap)
   256	            else:
   257	                freel.append((nm, e))
   258	        freel = tuple(sorted(freel))
   259	        for (s2, l2), c2 in base.items():
   260	            k = (s2, lift_mul(l2, freel))
   261	            nc = (out.get(k, 0) + c2) % p
   262	            if nc: out[k] = nc
   263	            else: out.pop(k, None)
   264	        if gb is not None and len(out) > 150000:
   265	            out, _ = ext_nf(out, gb, p)      # interim reduction
   266	        if len(out) > 4 * cap:
   267	            raise StopReport("accumulated term cap exceeded in subst")
   268	    if gb is not None:
   269	        out, _ = ext_nf(out, gb, p)
   270	    return out

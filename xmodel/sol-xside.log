   838	
   839	def gate_filter30_f(E, p, point, wit72, env):
   840	    """eplus_certify.gate_filter30 with the PER-SIDE HW law (the only
   841	    fiber-dependent audit): HW_i = h_ir W_i with 2 h_ir^2 = 3."""
   842	    Gg = E.G.astype(np.int64)
   843	    checks = {}
   844	    viol = 0
   845	    for (f, r), col in V2.GIDX.items():
   846	        if Gg[:30, :min(r, V2._S), col].any():
   847	            viol += 1
   848	    checks["f1_causality_no_entry_below_r"] = bool(viol == 0)
   849	    first = next((n for n in range(V2._S) if Gg[:30, n].any()), None)
   850	    checks["f2_no_negative_shift"] = bool(first is None or
   851	                                          first >= min(EC.S30))
   852	    pt, r3, h32 = V.radical_env(p)
   853	    fx = point["fixed"]
   854	    u = {}
   855	    u["r3_sq_3"] = pow(r3, 2, p) == 3 % p
   856	    u["h32_2h2_3"] = (2 * h32 * h32 - 3) % p == 0

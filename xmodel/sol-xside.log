   440	    h1 = min(T1.h, HMAX)
   441	    E.V[:h1] += T1.V[:h1]
   442	    E.G[:h1] += T1.G[:h1]
   443	    h2 = min(T2.h, HMAX)
   444	    E.V[:h2] -= T2.V[:h2]
   445	    E.G[:h2] -= T2.G[:h2]

  1016	def run_all(primes, out_path, light=False):
  1017	    print("== VALUATION-E2 FULL RUN (%s) ==" % EXP)
  1018	    print("   " + BLOCKNOTE)
  1019	    t00 = time.time()
  1020	    results = []
  1021	    for p in primes:
  1022	        for widx, kdraw, wit72, deep in iter_points(p):
  1023	            tag = "p%d w%d k%d " % (p, widx, kdraw)
  1024	            res, E = run_point(p, wit72, deep, tag=tag, light=light,
  1025	                               quiet=True)
  1026	            ec = res["e_candidate"]
  1027	            print("%s: e_cand=%s (%s; %d consistent blocks) "
  1028	                  "delta5[min..max over blocks]=%s ell[max]=%s %s (%.0fs)"

   890	def frontier_solve(E, p):
   891	    """The band-24 rank-4 frontier completion: solve the nine k = 24
   892	    residual cells over the ten frontier columns (A24 y = -b24, kernel
   893	    frees = 0).  Guarded by the measured level-cap: the frontier
   894	    columns must carry NO operator entry below band 24 (the promoted
   895	    9.S2/sect-9 finding 'bands <= 22 carry no new-at-D25 variables',
   896	    re-measured here); returns (y dict or None, diag)."""
   897	    Vv = E.V.astype(np.int64)
   898	    Gg = E.G.astype(np.int64)
   899	    cols = [V2.GIDX[fr] for fr in FRONTIER10]
   900	    belowcap = int(Gg[:30, :24, :][:, :, cols].any())
   901	    diag = {"frontier_entries_below_band24": bool(belowcap)}
   902	    if belowcap:
   903	        return None, diag
   904	    A = [[int(Gg[a][24][c]) for c in cols] for a in ROWS24]
   905	    b = [(-int(Vv[a][24])) % p for a in ROWS24]
   906	    y, rk = solve_deep_zero_completion(A, b, p)
   907	    diag["frontier_rank"] = rk
   908	    if y is None:
   909	        diag["frontier_inconsistent"] = True
   910	        return None, diag
   911	    if rk != 4:
   912	        return None, diag
   913	    diag["frontier_nonzero"] = sum(1 for v in y if v)
   914	    return {FRONTIER10[j]: v for j, v in enumerate(y)}, diag

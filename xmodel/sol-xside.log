   492	def structure_gates(E, p, chk):
   493	    """sol-round5.md 1.3 step 2 assertions (band <= 41 regression of the
   494	    all-depth cyclic-character lemma; NOT an all-depth proof).  The
   495	    lemma's eta29 == 0 assert is MEASURED-REFUTED (see ETA29_* above):
   496	    it is recorded, warned, and the spec-literal 29-row object proceeds
   497	    with the refutation attached to every output."""
   498	    Vv = E.V.astype(np.int64)
   499	    Gg = E.G.astype(np.int64)
   500	    chk("G2a eta^30..33 components vanish identically (value and "
   501	        "derivative)", not Vv[30:].any() and not Gg[30:].any())
   502	    inv_gidx = {v: k for k, v in GIDX.items()}
   503	    e29_bands = sorted({int(n) for n in range(_S)
   504	                        if Vv[29][n] or Gg[29][n].any()})
   505	    e29_entries = {}
   506	    for n in e29_bands:
   507	        cols = {("%s_%d" % (f, 32 + r)): int(Gg[29][n][GIDX[(f, r)]])
   508	                for (f, r) in GIDX if Gg[29][n][GIDX[(f, r)]]}
   509	        e29_entries[str(n)] = {"value": int(Vv[29][n]), "d/dc": cols}
   510	    chk("G2b SPEC LEMMA eta29 == 0 (sol-round5 1.2/1.3): "
   511	        "%s -- REFUTED: E_29 support %s, six residue-4 columns"
   512	        % ("holds" if not e29_bands else "FAILS", e29_bands),
   513	        not e29_bands, hard=False)
   514	    chk("G2c eta^29 confinement: support exactly {t^36}, value 0 at the "
   515	        "witness, derivative only in the six (fam, r=16) columns",
   516	        e29_bands == [S_29] and Vv[29][S_29] == 0 and
   517	        all(set(d["d/dc"]) <= {"%s_48" % f for f in FAMS}
   518	            for d in e29_entries.values()))
   519	    odd = [n for n in range(_S) if n % 2 == 1]
   520	    chk("G3a all odd bands vanish (value and derivative)",
   521	        not Vv[:, odd].any() and not Gg[:, odd].any())
   522	    ok_cong = True
   523	    starts = []
   524	    for a in range(29):
   525	        nz = [n for n in range(_S)
   526	              if Vv[a][n] or Gg[a][n].any()]
   527	        bad = [n for n in nz if n % 6 != S_A[a] % 6 or n < S_A[a]]
   528	        if bad:
   529	            ok_cong = False
   530	        gstart = next((n for n in range(_S) if Gg[a][n].any()), None)
   531	        starts.append(gstart)
   532	    cong29 = all(n % 6 == S_29 % 6 and n >= S_29 for n in e29_bands)
   533	    chk("G3b raw-label bijection: nonzero (n,a) only at n == s_a mod 6, "
   534	        "n >= s_a  [(n,a) <-> (a,(n-s_a)/6)]; extra row a=29 graded at "
   535	        "s_29 = 36", ok_cong and cong29)
   536	    chk("G4 the 29 support starts: derivative support of class a starts "
   537	        "exactly at s_a (s_a = 6+2((a+1)%%3), s_28 = 16); sum = 240",
   538	        starts == S_A and sum(S_A) == 240)
   539	    chk("G5 witness rows vanish: E value = 0 at every band <= 22 "
   540	        "(re-verifies the banked D23 witness through the measured "
   541	        "deep-label identification, incl. +42 t^20 gauge row)",
   542	        not Vv[:, :23].any())
   543	    b24 = sorted(a for a in range(29) if Vv[a][24])
   544	    return {"starts": starts, "band24_nonzero_etas": b24,
   545	            "value_residual_bands": sorted({int(n) for n in range(_S)
   546	                                            if Vv[:, n].any()}),
   547	            "eta29_refutation": {
   548	                "spec_assert": "eta29 == 0 (sol-round5 1.2/1.3 step 2)",
   549	                "measured": "FAILS: E_29 != 0, first occurrence t^36",
   550	                "support_bands": e29_bands,
   551	                "entries": e29_entries,
   552	                "char0_exact_tf1_48_coeff":
   553	                    "%d/%d (r1_experiment+directionb_strike, depth 37, "
   554	                    "all-zero-tails configuration, trivial radkey)"
   555	                    % (ETA29_NUM, ETA29_DEN),

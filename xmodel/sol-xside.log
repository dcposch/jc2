   287	def inv_monomial(s):
   288	    """Invert a pure W/uW monomial on the chart (W <-> uW swap)."""
   289	    e = list(unpack(s))
   290	    assert all(x == 0 for i, x in enumerate(e)
   291	               if i not in (IW1, IW2, IUW1, IUW2)), \
   292	        "inv_monomial: not a W-monomial"
   293	    em = [0] * NV
   294	    em[IUW1], em[IW1] = e[IW1], e[IUW1]
   295	    em[IUW2], em[IW2] = e[IW2], e[IUW2]
   296	    return pack(em)

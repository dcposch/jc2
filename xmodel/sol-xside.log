   465	# --------------------------------------- full chart point reconstruction
   466	# The banked 22-pivot back-solve (valuation_e.PIV22_SEQ) grouped by its
   467	# band-triangular affine groups 1+2+3+4+4+4+4 (8.S6 T4 discipline):
   468	# within a group the pristine window rows are affine in the group's
   469	# pivots (verified per point by the exact vanishing assert after the
   470	# square solve; any hidden nonlinearity or triangularity failure fires
   471	# it), and every earlier-band pivot is already substituted.
   472	PIV_GROUPS = [
   473	    [("tf1_38", (6, 2))],
   474	    [("tf1_40", (8, 0)), ("tf2_40", (8, 3))],
   475	    [("tf1_44", (12, 2)), ("tf2_44", (12, 5)), ("tf1_39", (12, 8))],
   476	    [("tf1_46", (14, 0)), ("tf2_46", (14, 3)), ("tf1_41", (14, 6)),
   477	     ("tf2_41", (14, 9))],
   478	    [("tf1_43", (16, 1)), ("tf1_48", (16, 4)), ("tf2_43", (16, 7)),
   479	     ("tf2_48", (16, 10))],
   480	    [("tf1_45", (18, 2)), ("tf1_50", (18, 5)), ("tf2_45", (18, 8)),
   481	     ("tf2_50", (18, 11))],
   482	    [("tf1_47", (20, 0)), ("tf1_52", (20, 3)), ("tf2_47", (20, 6)),
   483	     ("tf2_52", (20, 9))],
   484	]
   485	
   486	_OCC = {}
   487	_X2TF = None
   488	
   489	
   490	def x2tf_cached():
   491	    """x-registry (x-name -> tail name), computed once: V2.x_registry
   492	    re-unpickles the frozen state on every call."""
   493	    global _X2TF
   494	    if _X2TF is None:
   495	        _X2TF = V2.x_registry()
   496	    return _X2TF
   497	
   498	
   499	def _occ_names(p):
   500	    """All tail names occurring in the pristine rows (raw D21 VExpr +
   501	    Row_22), for the deterministic zero fill of aux frees."""
   502	    if p not in _OCC:
   503	        rows21, vars_ = V.raw_rows21()
   504	        occ = set()
   505	        for _lab, v in rows21:
   506	            for vk in v:
   507	                for vid in vk:
   508	                    occ.add(vars_[vid])
   509	        for _lab, d in V.row22_rows(p):
   510	            for k in d:
   511	                for nm, _e in k:
   512	                    if nm not in ("A1", "A2", "W1", "W2", "HW1", "HW2"):
   513	                        occ.add(nm)
   514	        _OCC[p] = occ
   515	    return _OCC[p]

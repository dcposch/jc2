   577	def ore_affinity_gate(E, p):
   578	    """(O): entries dRow_(n,a)/dc_(fam,r) affine in r within each
   579	    (a, fam, d = n - r) bin -- the action of A + B*Theta.  Returns
   580	    (#bins with >= 3 samples, #affine, support pattern set)."""
   581	    Gg = E.G.astype(np.int64)
   582	    bins = collections.defaultdict(dict)
   583	    for (fam, r), col in GIDX.items():
   584	        rho = r % 6
   585	        arr = Gg[:, :, col]
   586	        for a, n in zip(*np.nonzero(arr)):
   587	            bins[(int(a), fam, rho, int(n) - r)][r] = int(arr[a][n])
   588	    n3 = naff = 0
   589	    support = set()
   590	    for key, ent in bins.items():
   591	        support.add(key)
   592	        if len(ent) < 3:
   593	            continue
   594	        n3 += 1
   595	        rs = sorted(ent)
   596	        aff = True
   597	        s0 = (ent[rs[1]] - ent[rs[0]]) * pow(rs[1] - rs[0], p - 2, p) % p
   598	        for i in range(1, len(rs) - 1):
   599	            si = (ent[rs[i + 1]] - ent[rs[i]]) * \
   600	                pow(rs[i + 1] - rs[i], p - 2, p) % p
   601	            if si != s0:
   602	                aff = False
   603	        naff += aff
   604	    return n3, naff, support

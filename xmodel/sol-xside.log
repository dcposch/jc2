   348	def add_nolog_pin(rows, p):
   349	    """The jets bank omits the +42 t^20 no-log pin constant (the
   350	    Keller action residue; sol-round5 E-object '+ 42 t^20').  Verified
   351	    this session: the folded bank cell (20,0) at a00pp/p105337 equals
   352	    the frozen core23 pristine pivot row (20,0) dict-exactly at scale
   353	    1 EXCEPT for the bare constant 42.  Restore it (fiber-independent)."""
   354	    k = (0, ())
   355	    row = rows[(20, 0)]
   356	    row[k] = (row.get(k, 0) + 42) % p
   357	    if not row[k]:
   358	        del row[k]

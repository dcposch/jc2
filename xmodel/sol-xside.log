   360	def certify_point(p, wit72, deep_tails, D=DEPTH_DEFAULT, heavy=False,
   361	                  tag=""):
   362	    t0 = time.time()
   363	    pt, r3, h32 = V.radical_env(p)
   364	    Z = [pow(pt["z"], m, p) for m in range(42)]
   365	    point = V2.build_point(p, wit72, deep_tails)
   366	    jf, jg = V2.build_jets(point, p, Z)
   367	    E = V2.euler_rows(jf, jg, p)
   368	    res = {"tool": TOOL, "prime": p, "depth_D": D,
   369	           "zc_hash": point["zc_hash"],
   370	           "operator_hash": V2.operator_hash(E, p)}
   371	    gates = {}
   372	    gates["CYCLIC-30"] = gate_cyclic30(E, p)
   373	    gates["BRIDGE-30"] = gate_bridge30(E, p, point, D)
   374	    gates["FILTER-30"] = gate_filter30(E, p, point, wit72)
   375	    gates["PARAM-30"] = gate_param30(E, p, D)
   376	    if heavy:
   377	        Z2r = pow(pt["z"], 5, p)
   378	        Z2 = [pow(Z2r, m, p) for m in range(42)]
   379	        jf2, jg2 = V2.build_jets(point, p, Z2)
   380	        E2 = V2.euler_rows(jf2, jg2, p)
   381	        gates["FILTER-30"]["checks"]["f6_zeta_branch_invariance"] = bool(
   382	            V2.operator_hash(E2, p) == res["operator_hash"])
   383	        DG = V2.path_A_rows(jf, jg, p)
   384	        gates["FILTER-30"]["checks"]["f7_second_diff_path"] = bool(
   385	            np.array_equal(DG, E.G))
   386	        ok = all(gates["FILTER-30"]["checks"].values())
   387	        gates["FILTER-30"]["check_pass"] = ok
   388	        gates["FILTER-30"]["status"] = CAND if ok else "FAIL"
   389	    res["gates"] = gates
   390	    pr = gates["PARAM-30"]
   391	    nu = gates["BRIDGE-30"]["nu_window"]
   392	    thresh = pr["threshold_floor_Dm1_2"]
   393	    ell_lb = pr["ell_lb_certified"]
   394	    res["residual"] = {
   395	        "nu_window": nu,
   396	        "nu_note": ("nu = actual residual order (7.1); a nonzero band "
   397	                    "<= 41 is exact, so nu_window is exact when not None"),
   398	        "nu_ge_D": bool(nu is None or nu >= D)}
   399	    res["e_plus"] = {
   400	        "certified": None,
   401	        "certified_note": ("fail-closed: no exact all-depth causal "
   402	                           "section is constructed (PARAM-30 pending); "
   403	                           "there is NO promoted e+ at this point"),
   404	        "candidate_window_floor": ell_lb,
   405	        "tag": CAND,
   406	        "semantics": ("certified LOWER bound on ell(L_s^+) at the named "
   407	                      "zero completion (literal n >= 0 in (2.1)); the "
   408	                      "all-depth loss can only be >= this"),
   409	        "threshold_2e1_le_D": thresh,
   410	        "at_or_below_threshold": bool(ell_lb <= thresh)}
   411	    all_cand = all(g["check_pass"] for g in gates.values())
   412	    blockers = [k for k, g in gates.items() if g["status"] != "PROVED"]
   413	    res["certification"] = {
   414	        "formal_germ_certified": False,
   415	        "condition": ("Theorem 6.1: ALL four gates at the PROVED tier + "
   416	                      "legal completion + nu >= D + certified e+ with "
   417	                      "2 e+ + 1 <= D (D = %d: e+ <= %d)" % (D, thresh)),
   418	        "blockers": blockers,
   419	        "param30_refuted_at_completion": bool(ell_lb > thresh),
   420	        "executable_checks_all_pass": bool(all_cand)}
   421	    res["seconds"] = round(time.time() - t0, 1)
   422	    return res, E

   374	def frac_mod(c, r3v, p):
   375	    c0, c1 = Fraction(c[0]), Fraction(c[1])
   376	    return (c0.numerator % p * pow(c0.denominator % p, p - 2, p)
   377	            + c1.numerator % p * pow(c1.denominator % p, p - 2, p)
   378	            * r3v) % p

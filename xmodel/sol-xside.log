   430	def euler_rows(jf, jg, p):
   431	    """E = (theta Phi - 12 Phi) Gamma_eta - Phi_eta (theta Gamma - 18
   432	    Gamma) + 42 t^20  (gauge c_f c_g = 1; directionb_strike.jrows)."""

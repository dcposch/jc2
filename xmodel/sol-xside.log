   245	    u["A1_cube"] = pow(pt["A1"], 3, p) == (3 + r3) % p
   246	    u["A2_cube"] = pow(pt["A2"], 3, p) == (3 - r3) % p
   247	    u["W_units"] = fx["W1"] % p != 0 and fx["W2"] % p != 0
   248	    u["uW_saturation"] = all(
   249	        int(wit72["uW%d" % i]) * int(wit72["W%d" % i]) % p == 1
   250	        for i in (1, 2))
   251	    u["HW_law"] = all(fx["HW%d" % i] == h32 * fx["W%d" % i] % p
   252	                      for i in (1, 2))
   253	    u["z_order_42"] = (pow(pt["z"], 42, p) == 1 and
   254	                       all(pow(pt["z"], 42 // q, p) != 1 for q in (2, 3, 7)))
   255	    u["scalar_denoms_units"] = all(p % q for q in (2, 3, 5, 7)) and p > 7
   256	    checks["f3_unit_audit"] = all(u.values())

   158	def gate_cyclic30(E, p):
   159	    """Executable band-41 regression of the corrected 30-output grading."""
   160	    Vv = E.V.astype(np.int64)
   161	    Gg = E.G.astype(np.int64)
   162	    checks = {}
   163	    checks["c1_eta30_33_vanish"] = bool(not Vv[30:].any() and
   164	                                        not Gg[30:].any())
   165	    odd = [n for n in range(V2._S) if n % 2 == 1]
   166	    checks["c2_odd_bands_vanish"] = bool(not Vv[:, odd].any() and
   167	                                         not Gg[:, odd].any())
   168	    ok_cong = True
   169	    starts = []
   170	    for a in range(30):
   171	        nz = [n for n in range(V2._S) if Vv[a][n] or Gg[a][n].any()]
   172	        if any(n % 6 != S30[a] % 6 or n < S30[a] for n in nz):
   173	            ok_cong = False
   174	        starts.append(next((n for n in range(V2._S) if Gg[a][n].any()),
   175	                           None))
   176	    checks["c3_graded_support_bijection"] = bool(ok_cong)
   177	    checks["c4_support_starts_exact"] = bool(starts == S30)
   178	    lad = stream_ladders()
   179	    allr = sorted((f, r) for (f, rho), rs in lad.items() for r in rs)
   180	    checks["c5_input_ladder_partition"] = bool(
   181	        allr == sorted(V2.GIDX.keys()) and
   182	        all(min(rs) == V2.r_start(rho) and
   183	            all(b - a == 6 for a, b in zip(rs, rs[1:]))
   184	            for (f, rho), rs in lad.items()))
   185	    checks["c6_constants_30x30"] = bool(
   186	        len(V2.STREAMS) == 30 and len(S30) == 30 and
   187	        SUM_R30 == 288 and SUM_S30 == 276 and
   188	        S30[28] == 16 and S30[29] == 36)
   189	    ok = all(checks.values())
   190	    return {"checks": checks, "check_pass": ok,
   191	            "status": CAND if ok else "FAIL",
   192	            "pending": PENDING["CYCLIC-30"],
   193	            "support_starts": starts}

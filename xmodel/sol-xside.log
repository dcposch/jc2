   577	def band22_system(p, dval, env):
   578	    """The 10 PRISTINE Row_22 rows as an affine system A y = b on the
   579	    ten deep tails (evaluated at deep = 0; tg already in dval)."""
   580	    deepn = [V.DEEPMAP[x] for x in V.DEEPX]
   581	    dv = dict(dval)
   582	    for nm in deepn:
   583	        dv[nm] = 0

   229	def gate_filter30(E, p, point, wit72):
   230	    """Executable syntax/causality/unit audit of the window operator."""
   231	    Gg = E.G.astype(np.int64)
   232	    checks = {}
   233	    viol = 0
   234	    for (f, r), col in V2.GIDX.items():
   235	        if Gg[:30, :min(r, V2._S), col].any():
   236	            viol += 1
   237	    checks["f1_causality_no_entry_below_r"] = bool(viol == 0)
   238	    first = next((n for n in range(V2._S) if Gg[:30, n].any()), None)
   239	    checks["f2_no_negative_shift"] = bool(first is None or first >= min(S30))
   240	    pt, r3, h32 = V.radical_env(p)
   241	    fx = point["fixed"]

   558	def zero_config_crosscheck(p):
   559	    """Gate G2d: at the all-zero-tails configuration (uf = vf = tails =
   560	    0) the numeric engine's d(eta^29 t^36)/d(tf1_48) must equal the
   561	    banked char-0 exact coefficient -147880611647231905314470776689/1024
   562	    mod p (measured through r1_experiment + directionb_strike; trivial
   563	    radkey, so independent of A/W/zeta branches)."""
   564	    pt, r3, h32 = V.radical_env(p)
   565	    Z = [pow(pt["z"], m, p) for m in range(42)]
   566	    fixed = {"uf18": 0, "uf24": 0, "uf30": 0, "vf1_34": 0, "vf1_36": 0,
   567	             "vf2_34": 0, "vf2_36": 0, "A1": pt["A1"], "A2": pt["A2"],
   568	             "W1": pt["W1"], "W2": pt["W2"], "HW1": pt["HW1"],
   569	             "HW2": pt["HW2"], "r3": r3, "h32": h32}
   570	    point = {"tails": {f: {} for f in FAMS}, "fixed": fixed, "zc_hash": ""}
   571	    jf, jg = build_jets(point, p, Z)
   572	    E = euler_rows(jf, jg, p)
   573	    got = int(E.G[29][S_29][GIDX[("tf1", 16)]])
   574	    want = ETA29_NUM % p * pow(ETA29_DEN, p - 2, p) % p
   575	    return got, want

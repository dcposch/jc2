   882	# The banked band-24 frontier (cases/d25_reduce.FRONTIER, sol-round6
   883	# 2.3 order): the ten first-occurrence tangent directions of Row 24.
   884	FRONTIER10 = [("tf1", 19), ("tf1", 24), ("tf2", 19), ("tf2", 24),
   885	              ("tg1", 19), ("tg1", 24), ("tg2", 19), ("tg2", 24),

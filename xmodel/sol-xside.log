   250	def build_point(p, wit72, deep_tails):
   251	    """Witness + deep draw -> numeric source point.  Returns dict with
   252	    per-family tail values {fam: {r: val}}, fixed data, completion hash."""
   253	    x2tf = x_registry()
   254	    pt, r3, h32 = V.radical_env(p)
   255	    tails = {f: {} for f in FAMS}
   256	    fixed = {"uf30": 0}
   257	    for xn, val in wit72.items():
   258	        val = int(val)
   259	        if xn in ("W1", "W2"):
   260	            fixed[xn] = val
   261	            continue
   262	        if xn in ("uW1", "uW2"):
   263	            assert val == pow(int(wit72[xn.replace("u", "")]), p - 2, p), \
   264	                "chart saturation broken (uW != W^-1)"
   265	            continue
   266	        nm = x2tf[xn]
   267	        if nm.startswith("uf") or nm.startswith("vf"):
   268	            fixed[nm] = val
   269	            continue
   270	        fam, lvl = nm.rsplit("_", 1)
   271	        tails[fam][int(lvl) - 32] = val
   272	    for nm, val in deep_tails.items():
   273	        nm2 = DEEP_RELABEL.get(nm, nm)         # measured identification
   274	        fam, lvl = nm2.rsplit("_", 1)
   275	        tails[fam][int(lvl) - 32] = int(val)
   276	    for f in FAMS:
   277	        assert 10 not in tails[f], "PIN42 slot carries a value (wrong point)"
   278	        assert all(6 <= r <= 22 for r in tails[f]), "tail r out of range"
   279	    fixed.update({"A1": pt["A1"], "A2": pt["A2"], "r3": r3, "h32": h32,
   280	                  "HW1": h32 * fixed["W1"] % p, "HW2": h32 * fixed["W2"] % p})
   281	    blob = json.dumps({"prime": p, "tails": {f: sorted(tails[f].items())
   282	                                             for f in FAMS},
   283	                       "fixed": sorted((k, v) for k, v in fixed.items()),
   284	                       "completion": ZC_RULE,
   285	                       "deep_relabel": sorted(DEEP_RELABEL.items())},
   286	                      sort_keys=True)
   287	    zc_hash = hashlib.sha256(blob.encode()).hexdigest()
   288	    return {"tails": tails, "fixed": fixed, "zc_hash": zc_hash}

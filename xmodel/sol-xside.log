   482	def operator_hash(E, p):
   483	    h = hashlib.sha256()
   484	    Vv = E.V.astype(np.int64)
   485	    Gg = E.G.astype(np.int64)
   486	    h.update(json.dumps({"p": p, "V": Vv.tolist()}).encode())
   487	    nz = np.argwhere(Gg)
   488	    h.update(json.dumps([[int(x) for x in row] + [int(Gg[tuple(row)])]
   489	                         for row in nz]).encode())
   490	    return h.hexdigest()

   771	def banked_row_match_f(E, p, point, env):
   772	    """valuation_e2.banked_row_match against the FIBER-frame pristine
   773	    pipeline (window_partials_f), same exact/unit-ratio discipline."""
   774	    dval23 = V2.dval_for_banked(p, point)
   775	    rowdata = window_partials_f(p, dval23, 23, env)
   776	    Gg = E.G.astype(np.int64)
   777	    n_exact = n_rows = 0
   778	    ratios = {}
   779	    ok = True
   780	    for (n, a), (val, pr) in rowdata.items():
   781	        n_rows += 1
   782	        mine = {}
   783	        for (fam, r), col in V2.GIDX.items():
   784	            c = int(Gg[a][n][col])
   785	            if c:
   786	                mine["%s_%d" % (fam, 32 + r)] = c
   787	        theirs = {V2.DEEP_RELABEL.get(k, k): v for k, v in pr.items()
   788	                  if k[:3] in ("tf1", "tf2", "tg1", "tg2") or
   789	                  k[:4] in ("tg01", "tg02")}
   790	        if val != 0:
   791	            ok = False
   792	        if mine == theirs:
   793	            n_exact += 1
   794	            continue
   795	        if set(mine) != set(theirs) or not mine:
   796	            ok = False
   797	            continue
   798	        ks = sorted(mine)
   799	        r0 = theirs[ks[0]] * pow(mine[ks[0]], p - 2, p) % p
   800	        if all(theirs[k] == mine[k] * r0 % p for k in ks):
   801	            ratios[str((n, a))] = r0
   802	        else:
   803	            ok = False
   804	    return ok, n_exact, n_rows, ratios

   193	def wcancel(s):
   194	    """uW_i*W_i == 1 mod I23 (chart saturation): cancel mixed pairs."""
   195	    e = None
   196	    a = min((s >> (SH * IW1)) & 0xFF, (s >> (SH * IUW1)) & 0xFF)
   197	    b = min((s >> (SH * IW2)) & 0xFF, (s >> (SH * IUW2)) & 0xFF)
   198	    if not (a or b):
   199	        return s
   200	    e = list(unpack(s))
   201	    e[IW1] -= a; e[IUW1] -= a; e[IW2] -= b; e[IUW2] -= b
   202	    return pack(e)
   203	

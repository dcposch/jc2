   974	        "(r_4 = 16), sum = 288",
   975	        len(STREAMS) == 30 and
   976	        sum(r_start(rho) for _, rho in STREAMS) == 288)
   977	    chk("G1b output streams: 29 classes, s_a = 6+2((a+1)%3), s_28 = 16, "
   978	        "sum = 240", len(S_A) == 29 and sum(S_A) == 240)
   979	    chk("G1c square block: every B_c is 29 outputs x 29 input streams "
   980	        "(one free stream); M_c(N) is 29N x 29N (asserted per block)",
   981	        all(len([s for s in STREAMS if s != c]) == 29 for c in STREAMS))
   982	    for p in primes:

   424	# --------------------------------------------------------------- selftest
   425	def selftest():
   426	    p = 105337
   427	    # scanner control 1: L = t^e * id on one shift-0 stream has loss e
   428	    for e in (0, 1, 3):
   429	        K = 12
   430	        row_lv = np.arange(K + 1)
   431	        col_lv = np.arange(K + 1)
   432	        M = np.zeros((K + 1, K + 1), dtype=np.int64)
   433	        for r in range(K + 1 - e):
   434	            M[r + e][r] = 1
   435	        ell, rank, _ = delayed_loss_scan(row_lv, col_lv, M, p)
   436	        assert ell == e, "diag t^e control broken (e=%d got %d)" % (e, ell)
   437	    # scanner control 2: the (4.5) resonance -- (Theta+1) u^j has entry
   438	    # (j+1); over F_q with window K < q-1 every truncation is invertible,
   439	    # ell_window = 0, but the TRUE all-depth loss is infinite (the u^{q-1}
   440	    # target is missed).  The scan must return 0 on the short window
   441	    # (proving the window reading is only ever a lower bound) and must
   442	    # DETECT the resonance once the window contains it.
   443	    q = 5
   444	    for K, want in ((3, 0), (6, 5)):
   445	        row_lv = np.arange(K + 1)
   446	        col_lv = np.arange(K + 1)
   447	        M = np.zeros((K + 1, K + 1), dtype=np.int64)
   448	        for j in range(K + 1):
   449	            M[j][j] = (j + 1) % q
   450	        ell, rank, _ = delayed_loss_scan(row_lv, col_lv, M, q)
   451	        assert ell == want, "resonance control broken (K=%d)" % K
   452	    # control 3: uncovered target strictly between column levels uses the
   453	    # interval lower endpoint (n = 0 here), not the column level
   454	    row_lv = np.array([0, 4])
   455	    col_lv = np.array([2])
   456	    M = np.array([[1], [0]], dtype=np.int64)
   457	    ell, rank, _ = delayed_loss_scan(row_lv, col_lv, M, p)
   458	    assert ell == 5, "n>=0 literal convention broken (got %d)" % ell
   459	    print("PASS selftest: diag-t^e exact loss (e = 0,1,3); char-p (4.5) "
   460	          "resonance invisible at K=3 (ell=0) and detected at K=6 "
   461	          "(ell=5); literal n>=0 interval endpoints")
   462	
   463	# ------------------------------------------------------------ gate suite
   464	def run_gates(primes, quiet=False):
   465	    print("== EPLUS-CERTIFY GATE SUITE (corrected 30x30 Euler/Ore) ==")
   466	    print("   " + BANNER)
   467	    selftest()
   468	    rec("A1 corrected constants: 30 inputs sum r_q = 288; 30 outputs "
   469	        "H_0..H_29, s_28 = 16, s_29 = 36, sum s_a = 276; index formula "
   470	        "6 d+ - 12", SUM_R30 == 288 and SUM_S30 == 276 and
   471	        6 * 2 - 12 == 0 and S30[29] == 36)
   472	    lad = stream_ladders()
   473	    rec("A2 input ladder partition: 170 tangent coords = 30 disjoint "
   474	        "6-step ladders starting at r_q; PIN42 (level 10) absent",
   475	        sorted((f, r) for (f, rho), rs in lad.items() for r in rs) ==
   476	        sorted(V2.GIDX.keys()) and
   477	        all(r != 10 for (_f, r) in V2.GIDX))
   478	    rec("A3 window shape: 174 output x 170 input coordinates at bands "
   479	        "<= %d (= the Round-6 banked weighted-window shape)" % RMAX,
   480	        sum((RMAX - s) // 6 + 1 for s in S30) == 174 and V2.GD == 170)
   481	    for p in primes:
   482	        got, want = V2.zero_config_crosscheck(p)
   483	        rec("A4-p%d char-0 crosscheck: d(eta29 t^36)/d(tf1_48) at the "
   484	            "zero configuration == %d/%d mod p" %
   485	            (p, V2.ETA29_NUM, V2.ETA29_DEN), got == want)
   486	    per_prime = {}
   487	    for p in primes:
   488	        print("-- p = %d: witness 0 / kernel draw 0 full battery --" % p)
   489	        w0 = next(V2.iter_points(p))
   490	        res, E = certify_point(p, w0[2], w0[3], heavy=True,
   491	                               tag="p%d " % p)
   492	        for gname, g in res["gates"].items():
   493	            for cname, ok in g["checks"].items():

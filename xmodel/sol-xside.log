   517	
   518	def full_point_f(p, cellval, env, tg=(0, 0)):
   519	    """28-var cell point -> full chart dval (tail names), fiber frame:
   520	    the 22 shallow pivots back-solved GROUPWISE from the PRISTINE raw
   521	    D21 window rows through the fiber-frame evaluator (vexpr_vp_f with
   522	    A1r, A2r, h1r W1, h2r W2); every group row is asserted to vanish
   523	    exactly after its square affine solve, and PIV22_SEQ coverage is
   524	    asserted against the banked sequence.  Aux frees = 0 (draw 0 zero
   525	    completion), PIN42 = 0.  tg = the (tg1_44, tg2_44) pair: the
   526	    level-44 tangent coordinates feed the band >= 12 pivot rows, so
   527	    the pivots are (affine) functions of tg; reconstruct_point solves
   528	    the pair by exact affine probing of the band-22 compatibility."""
   529	    seq = {nm: lab for nm, lab in V.PIV22_SEQ()}
   530	    grp = {nm: lab for g in PIV_GROUPS for nm, lab in g}
   531	    assert grp == seq, "pivot groups do not match the banked PIV22_SEQ"
   532	    rows21, vars_ = V.raw_rows21()
   533	    rowmap = {lab: v for lab, v in rows21}
   534	    _, r3, _ = V.radical_env(p)
   535	    x2tf = x2tf_cached()
   536	    dval = {}
   537	    for xn, x in cellval.items():
   538	        if xn.startswith("x"):
   539	            dval[x2tf[xn]] = int(x)
   540	    for nm in _occ_names(p):
   541	        dval.setdefault(nm, 0)              # PIN42 + aux frees (draw 0)
   542	    dval["uf30"] = 0
   543	    dval["tg1_44"], dval["tg2_44"] = int(tg[0]) % p, int(tg[1]) % p
   544	    W1v, W2v = int(cellval["W1"]) % p, int(cellval["W2"]) % p
   545	    dval.update({"A1": env["A1"], "A2": env["A2"], "W1": W1v, "W2": W2v,
   546	                 "HW1": env["h1"] * W1v % p, "HW2": env["h2"] * W2v % p})
   547	    for group in PIV_GROUPS:
   548	        unk = [nm for nm, _lab in group]
   549	        assert all(dval[nm] == 0 for nm in unk)
   550	        A, b = [], []
   551	        for _nm, lab in group:
   552	            v0, pr = vexpr_vp_f(rowmap[lab], vars_, dval, p, r3, env)
   553	            A.append([pr.get(u, 0) for u in unk])
   554	            b.append((-v0) % p)
   555	        n = len(unk)
   556	        M = [row[:] + [bb] for row, bb in zip(A, b)]
   557	        for c in range(n):
   558	            piv = next((i for i in range(c, n) if M[i][c]), None)
   559	            assert piv is not None, \
   560	                "pivot group singular at band %d" % group[0][1][0]
   561	            M[c], M[piv] = M[piv], M[c]
   562	            iv = pow(M[c][c], p - 2, p)
   563	            M[c] = [x * iv % p for x in M[c]]
   564	            for i in range(n):
   565	                if i != c and M[i][c]:
   566	                    f = M[i][c]
   567	                    M[i] = [(x - f * y) % p for x, y in zip(M[i], M[c])]
   568	        for j, nm in enumerate(unk):
   569	            dval[nm] = M[j][n]
   570	        for _nm, lab in group:
   571	            v0, _pr = vexpr_vp_f(rowmap[lab], vars_, dval, p, r3, env)
   572	            assert v0 == 0, ("pivot row nonzero after group solve "
   573	                             "(affinity/triangularity broken)", lab)
   574	    return dval
   575	
   576	
   577	def band22_system(p, dval, env):
   578	    """The 10 PRISTINE Row_22 rows as an affine system A y = b on the
   579	    ten deep tails (evaluated at deep = 0; tg already in dval)."""
   580	    deepn = [V.DEEPMAP[x] for x in V.DEEPX]
   581	    dv = dict(dval)
   582	    for nm in deepn:
   583	        dv[nm] = 0
   584	    A, b = [], []
   585	    for _lab, d in V.row22_rows(p):
   586	        val0, pr = msrow_vp_f(d, dv, p, env)
   587	        A.append([pr.get(nm, 0) for nm in deepn])
   588	        b.append((-val0) % p)
   589	    return A, b
   590	
   591	
   592	def left_kernel(A, p):
   593	    """Canonical left kernel of the 10x10 deep matrix (RREF of A^T with
   594	    identity carried): rows k with k.A = 0."""
   595	    n = len(A)
   596	    m = len(A[0])
   597	    M = []
   598	    for i in range(n):
   599	        M.append(A[i][:] + [1 if j == i else 0 for j in range(n)])
   600	    r = 0
   601	    for c in range(m):
   602	        piv = next((i for i in range(r, n) if M[i][c]), None)
   603	        if piv is None:
   604	            continue
   605	        M[r], M[piv] = M[piv], M[r]
   606	        iv = pow(M[r][c], p - 2, p)
   607	        M[r] = [x * iv % p for x in M[r]]
   608	        for i in range(n):
   609	            if i != r and M[i][c]:
   610	                f = M[i][c]
   611	                M[i] = [(x - f * y) % p for x, y in zip(M[i], M[r])]
   612	        r += 1
   613	    K = [row[m:] for row in M[r:]]
   614	    return K, r
   615	
   616	
   617	def solve_deep_zero_completion(A, b, p):
   618	    """A y = b on the ten deep tails, kernel frees = 0 (the banked zero
   619	    completion); returns y or None on inconsistency."""
   620	    n = len(A[0])
   620	    n = len(A[0])
   621	    M = [A[i][:] + [b[i]] for i in range(len(A))]
   622	    rk, pivcols = 0, []
   623	    for cidx in range(n):
   624	        prw = next((i for i in range(rk, len(M)) if M[i][cidx]), None)
   625	        if prw is None:
   626	            continue
   627	        M[rk], M[prw] = M[prw], M[rk]
   628	        iv = pow(M[rk][cidx], p - 2, p)
   629	        M[rk] = [x * iv % p for x in M[rk]]
   630	        for i in range(len(M)):
   631	            if i != rk and M[i][cidx]:
   632	                f = M[i][cidx]
   633	                M[i] = [(a - f * bb) % p for a, bb in zip(M[i], M[rk])]
   634	        pivcols.append(cidx)
   635	        rk += 1
   636	    for i in range(rk, len(M)):
   637	        if M[i][n]:
   638	            return None, rk
   639	    y = [0] * n
   640	    for i, cidx in enumerate(pivcols):
   641	        y[cidx] = M[i][n]
   642	    return y, rk
   643	
   644	
   645	def reconstruct_point(p, cellval, env):
   646	    """Cell point -> full chart point (fiber frame), the exact affine
   647	    tg-probe pipeline: the (tg1_44, tg2_44) pair feeds the band >= 12
   648	    pivot rows, so the band-22 compatibility residual c(tg) = K.b(tg)
   649	    (K = the canonical left kernel of the CONSTANT deep-column matrix)
   650	    is an affine function of tg -- measured at probes (0,0), (1,0),
   651	    (0,1) and VERIFIED at (1,1); the rank-2 affine solve pins tg, the
   652	    pipeline reruns at tg*, the deep tails solve with kernel frees = 0
   653	    (zero completion), and every band <= 22 row is re-verified exactly.
   654	    Returns (dval, diag) or raises (fail-closed)."""
   655	    probes = {}
   656	    A0 = None
   657	    for t in ((0, 0), (1, 0), (0, 1), (1, 1)):
   658	        dv = full_point_f(p, cellval, env, tg=t)
   659	        A, b = band22_system(p, dv, env)
   660	        if A0 is None:
   661	            A0 = A
   662	        else:
   663	            assert A == A0, "deep-column matrix depends on tg (!)"
   664	        probes[t] = b
   665	    K, deep_rank = left_kernel(A0, p)
   666	    assert deep_rank == 4, "deep Schur rank %d != 4" % deep_rank
   667	    assert len(K) == 6
   668	    c = {t: [sum(kk * bb for kk, bb in zip(krow, probes[t])) % p
   669	             for krow in K] for t in probes}
   670	    # exact affinity check at (1,1)
   671	    aff11 = [(c[(1, 0)][i] + c[(0, 1)][i] - c[(0, 0)][i]) % p
   672	             for i in range(6)]
   673	    assert aff11 == c[(1, 1)], \
   674	        "band-22 compat residual is NOT affine in tg (fail-closed)"
   675	    # rank-2 affine solve: [c10-c00 | c01-c00] t = -c00
   676	    col1 = [(c[(1, 0)][i] - c[(0, 0)][i]) % p for i in range(6)]
   677	    col2 = [(c[(0, 1)][i] - c[(0, 0)][i]) % p for i in range(6)]
   678	    rhs = [(-c[(0, 0)][i]) % p for i in range(6)]
   679	    M = [[col1[i], col2[i], rhs[i]] for i in range(6)]
   680	    r = 0
   681	    for cc in range(2):
   682	        piv = next((i for i in range(r, 6) if M[i][cc]), None)
   683	        if piv is None:
   684	            continue
   685	        M[r], M[piv] = M[piv], M[r]
   686	        iv = pow(M[r][cc], p - 2, p)
   687	        M[r] = [x * iv % p for x in M[r]]
   688	        for i in range(6):
   689	            if i != r and M[i][cc]:
   690	                f = M[i][cc]
   691	                M[i] = [(x - f * y) % p for x, y in zip(M[i], M[r])]
   692	        r += 1
   693	    assert r == 2, "tg system rank %d != 2" % r
   694	    assert all(M[i][2] == 0 for i in range(2, 6)), \
   695	        "tg system inconsistent: NOT_IN_DOMAIN at band 22"
   696	    t1, t2 = M[0][2], M[1][2]
   697	    dval = full_point_f(p, cellval, env, tg=(t1, t2))
   698	    A, b = band22_system(p, dval, env)
   699	    assert A == A0
   700	    ck = [sum(kk * bb for kk, bb in zip(krow, b)) % p for krow in K]
   701	    assert not any(ck), "compat residual nonzero at solved tg"
   702	    y, rk = solve_deep_zero_completion(A, b, p)
   703	    assert y is not None and rk == 4, "deep solve failed at solved tg"
   704	    deepn = [V.DEEPMAP[x] for x in V.DEEPX]
   705	    for nm, vv in zip(deepn, y):
   706	        dval[nm] = vv
   707	    for _lab, d in V.row22_rows(p):
   708	        val0, _ = msrow_vp_f(d, dval, p, env)
   709	        assert val0 == 0, "Row_22 nonzero after deep solve"
   710	    diag = {"tg1_44": t1, "tg2_44": t2, "deep_rank": rk,
   711	            "tg_rank": r}
   712	    return dval, diag
   713	
   714	
   715	def verify_full_point(p, dval, env, a00pp_frozen):
   716	    """The fail-closed verification block.  Returns dict of checks;
   717	    every entry must be True for the point to be accepted."""
   718	    checks = {}
   719	    wp = window_partials_f(p, dval, 21, env)
   720	    checks["raw_D21_rows_vanish"] = not any(v for v, _ in wp.values())
   721	    r22 = [msrow_vp_f(d, dval, p, env)[0] for _, d in V.row22_rows(p)]
   722	    checks["pristine_row22_vanish"] = not any(r22)
   723	    if a00pp_frozen:
   724	        nz, nr, cvals = V.verify_row22compat(p, dval)
   725	        checks["row22compat_48"] = (nz == nr == 48)
   726	        checks["compat_c_zero"] = not any(cvals)
   727	        nz23, nr23 = V.verify_core23(p, dval)
   728	        checks["core23_77"] = (nz23 == nr23 == 77)
   729	        # frozen row22red emission (32 rows, x-named)
   730	        hdr, rr = V.parse_ms_rows(
   731	            os.path.join(HERE, "directionb_row22red_p%d.ms" % p), p)
   732	        xval = V._xval_from_point(p, dval)
   733	        vals = [V.eval_ms_row(d, xval, p) for d in rr]
   734	        checks["row22red_32"] = not any(vals)
   735	    return checks

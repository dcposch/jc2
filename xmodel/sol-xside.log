ZC_RULE = ("deterministic zero completion (sol-round5.md 1.3 step 1): "
           "uf30 = 0; tf1_51 = tf2_51 = tg1_51 = tg2_51 = 0; "
           "tf1_53 = tf2_53 = tg1_53 = tg2_53 = 0; every unspecified "

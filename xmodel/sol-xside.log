   989	        print("-- p = %d: witness 0 / kernel draw 0 full battery --" % p)
   990	        w0 = next(iter_points(p))
   991	        res, E = run_point(p, w0[2], w0[3], tag="p%d " % p)
   992	        per_prime[p] = res
   993	        print("   operator %s...  zc %s...  (%.0fs)"
   994	              % (res["operator_hash"][:16], res["zc_hash"][:16],
   995	                 res["seconds"]))
   996	    if len(per_prime) == 2:
   997	        a, b = (per_prime[p] for p in primes)
   998	        chk("G11a cross-prime: support starts identical",
   999	            a["starts"] == b["starts"])
  1000	        chk("G11b cross-prime: Ore support pattern identical "
  1001	            "(same (a,fam,rho,d) bins)",
  1002	            a["ore_support_hash"] == b["ore_support_hash"])
  1003	        chk("G11c cross-prime: per-block defect profiles + e-index "
  1004	            "diagnostics identical on witness 0/draw 0",
  1005	            [(bl["delta_profile_N1..%d" % NMAX], bl["e_index_V"],
  1006	              bl["ell_window"]) for bl in a["blocks"]] ==
  1007	            [(bl["delta_profile_N1..%d" % NMAX], bl["e_index_V"],
  1008	              bl["ell_window"]) for bl in b["blocks"]], hard=False)
  1009	    bad = [n for n, c, h in GATES if h and not c]
  1010	    print("RESULT: %d/%d gates pass%s" % (
  1011	        sum(1 for _, c, _ in GATES if c), len(GATES),
  1012	        "" if not bad else "; HARD FAIL %s" % bad))
  1013	    print(BLOCKNOTE)
  1014	    return not bad

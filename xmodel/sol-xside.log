   738	def witness72_of(p, dval):
   739	    """dval -> (witness72 dict, deep_tails dict) in the banked d23
   740	    JSON shapes (x-registry + conventional deep names); cached-registry
   741	    equivalent of valuation_e._xval_from_point."""
   742	    x2tf = x2tf_cached()
   743	    xs = ["x%d" % i for i in range(74)
   744	          if i not in (46, 51, 56, 61, 64, 67)]
   745	    wit72 = {x: int(dval[x2tf[x]]) for x in xs}
   746	    wit72["W1"], wit72["W2"] = int(dval["W1"]), int(dval["W2"])
   747	    wit72["uW1"] = pow(int(dval["W1"]), p - 2, p)
   748	    wit72["uW2"] = pow(int(dval["W2"]), p - 2, p)
   749	    deep = {V.DEEPMAP[x]: int(dval[V.DEEPMAP[x]]) for x in V.DEEPX}
   750	    return wit72, deep

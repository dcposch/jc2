   450	
   451	def window_partials_f(p, dval, Dw, env):
   452	    """Fiber-frame window rows: 76 raw D21 + (D >= 23) 10 pristine
   453	    Row_22; rowdata[(band, eta)] = (value, partials)."""
   454	    rows21, vars_ = V.raw_rows21()
   455	    _, r3, _ = V.radical_env(p)
   456	    out = {}
   457	    for lab, v in rows21:
   458	        out[lab] = vexpr_vp_f(v, vars_, dval, p, r3, env)
   459	    if Dw >= 23:
   460	        for lab, d in V.row22_rows(p):
   461	            out[lab] = msrow_vp_f(d, dval, p, env)
   462	    return out

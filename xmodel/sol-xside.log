   291	def orbit_levels(point, fam, p):
   292	    """Level -> (value, grad-col-or-None) for one Aside orbit's series Y,
   293	    zero-completed.  fam in FAMS; the paired fixed data follows
   294	    r1_experiment.build_generators exactly (g shares uf/vf with f)."""
   295	    fx = point["fixed"]
   296	    side = "1" if fam.endswith("1") else "2"
   297	    lv = {12: (1, None), 18: (fx["uf18"], None), 24: (fx["uf24"], None),
   298	          30: (fx["uf30"], None), 32: (fx["A" + side], None),
   299	          34: (fx["vf%s_34" % side], None), 36: (fx["vf%s_36" % side], None)}
   300	    if fam in ("tf1", "tf2"):
   301	        lv[37] = (fx["W" + side], None)
   302	    elif fam in ("tg1", "tg2"):
   303	        lv[37] = (fx["HW" + side], None)
   304	    vals = point["tails"][fam]
   305	    for r in allowed_r(fam):
   306	        lv[32 + r] = (vals.get(r, 0), GIDX[(fam, r)])
   307	    return lv

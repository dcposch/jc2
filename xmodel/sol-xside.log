   205	def ext_add(dst, src, p, scale=1):
   206	    for k, c in src.items():
   207	        nc = (dst.get(k, 0) + scale * c) % p
   208	        if nc: dst[k] = nc
   209	        else: dst.pop(k, None)
   210	    return dst

   592	def left_kernel(A, p):
   593	    """Canonical left kernel of the 10x10 deep matrix (RREF of A^T with
   594	    identity carried): rows k with k.A = 0."""
   595	    n = len(A)
   596	    m = len(A[0])
   597	    M = []
   598	    for i in range(n):
   599	        M.append(A[i][:] + [1 if j == i else 0 for j in range(n)])
   600	    r = 0
   601	    for c in range(m):
   602	        piv = next((i for i in range(r, n) if M[i][c]), None)
   603	        if piv is None:
   604	            continue
   605	        M[r], M[piv] = M[piv], M[r]
   606	        iv = pow(M[r][c], p - 2, p)
   607	        M[r] = [x * iv % p for x in M[r]]
   608	        for i in range(n):
   609	            if i != r and M[i][c]:
   610	                f = M[i][c]
   611	                M[i] = [(x - f * y) % p for x, y in zip(M[i], M[r])]
   612	        r += 1
   613	    K = [row[m:] for row in M[r:]]
   614	    return K, r
   615	

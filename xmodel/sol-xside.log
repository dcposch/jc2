   152	# ----------------------------------------------------------- reduction
   153	def nf_trace(poly, gb, p):
   154	    """Full normal form of poly (dict packed_s -> coeff) against the
   155	    monic grevlex GB.  Returns (nf_dict, trace {gk_idx: {q_s: coeff}},
   156	    steps).  Identity: poly == nf + sum_k trace[k]*gb[k]  in F_p[x]."""
   157	    H = dict(poly)
   158	    heap = [-gkey(s, degof(s)) for s in H]
   159	    heapq.heapify(heap)
   160	    out, trace, steps = {}, {}, 0
   161	    nlt = len(gb)
   162	    while heap:
   163	        K = -heapq.heappop(heap)
   164	        s, deg = from_gkey(K)
   165	        c = H.get(s)
   166	        if not c:
   167	            continue
   168	        gi = -1
   169	        X = s | GUARD
   170	        for j in range(nlt):
   171	            lt_s, lt_deg, _ = gb[j]
   172	            if lt_deg <= deg and ((X - lt_s) & GUARD) == GUARD:
   173	                gi = j
   174	                break
   175	        if gi < 0:
   176	            out[s] = c
   177	            del H[s]
   178	            continue
   179	        lt_s, lt_deg, tail = gb[gi]
   180	        q = s - lt_s
   181	        qdeg = deg - lt_deg
   182	        tr = trace.setdefault(gi, {})
   183	        tr[q] = (tr.get(q, 0) + c) % p
   184	        del H[s]
   185	        for ts, tdeg, tc in tail:
   186	            m = q + ts
   187	            nc = (H.get(m, 0) - c * tc) % p
   188	            if nc:
   189	                if m not in H:
   190	                    heapq.heappush(heap, -gkey(m, qdeg + tdeg))
   191	                H[m] = nc
   192	            else:
   193	                H.pop(m, None)
   194	        steps += 1
   195	    assert not H
   196	    return out, trace, steps

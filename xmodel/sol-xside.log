   140	def rec(name, cond, hard=True, quiet=False):
   141	    _RESULTS.append((name, bool(cond), hard))
   142	    if not quiet or not cond:
   143	        print(("PASS " if cond else ("FAIL " if hard else "WARN ")) + name,
   144	              flush=True)

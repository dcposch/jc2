   645	def reconstruct_point(p, cellval, env):
   646	    """Cell point -> full chart point (fiber frame), the exact affine
   647	    tg-probe pipeline: the (tg1_44, tg2_44) pair feeds the band >= 12
   648	    pivot rows, so the band-22 compatibility residual c(tg) = K.b(tg)
   649	    (K = the canonical left kernel of the CONSTANT deep-column matrix)
   650	    is an affine function of tg -- measured at probes (0,0), (1,0),
   651	    (0,1) and VERIFIED at (1,1); the rank-2 affine solve pins tg, the
   652	    pipeline reruns at tg*, the deep tails solve with kernel frees = 0
   653	    (zero completion), and every band <= 22 row is re-verified exactly.
   654	    Returns (dval, diag) or raises (fail-closed)."""
   655	    probes = {}
   656	    A0 = None
   657	    for t in ((0, 0), (1, 0), (0, 1), (1, 1)):
   658	        dv = full_point_f(p, cellval, env, tg=t)
   659	        A, b = band22_system(p, dv, env)
   660	        if A0 is None:
   661	            A0 = A
   662	        else:
   663	            assert A == A0, "deep-column matrix depends on tg (!)"
   664	        probes[t] = b
   665	    K, deep_rank = left_kernel(A0, p)
   666	    assert deep_rank == 4, "deep Schur rank %d != 4" % deep_rank
   667	    assert len(K) == 6
   668	    c = {t: [sum(kk * bb for kk, bb in zip(krow, probes[t])) % p
   669	             for krow in K] for t in probes}
   670	    # exact affinity check at (1,1)
   671	    aff11 = [(c[(1, 0)][i] + c[(0, 1)][i] - c[(0, 0)][i]) % p
   672	             for i in range(6)]
   673	    assert aff11 == c[(1, 1)], \
   674	        "band-22 compat residual is NOT affine in tg (fail-closed)"
   675	    # rank-2 affine solve: [c10-c00 | c01-c00] t = -c00
   676	    col1 = [(c[(1, 0)][i] - c[(0, 0)][i]) % p for i in range(6)]
   677	    col2 = [(c[(0, 1)][i] - c[(0, 0)][i]) % p for i in range(6)]
   678	    rhs = [(-c[(0, 0)][i]) % p for i in range(6)]
   679	    M = [[col1[i], col2[i], rhs[i]] for i in range(6)]
   680	    r = 0
   681	    for cc in range(2):
   682	        piv = next((i for i in range(r, 6) if M[i][cc]), None)
   683	        if piv is None:

   807	def gate_bridge30_f(E, p, point, env):
   808	    """eplus_certify.gate_bridge30 with the fiber-frame banked match."""
   809	    Vv = E.V.astype(np.int64)
   810	    Gg = E.G.astype(np.int64)
   811	    checks = {}
   812	    below = sorted({int(n) for n in range(min(D, V2._S))
   813	                    if Vv[:30, n].any()})
   814	    checks["b1_residual_below_D_vanishes"] = bool(not below)
   815	    val_bands = sorted({int(n) for n in range(V2._S) if Vv[:30, n].any()})
   816	    nu_window = val_bands[0] if val_bands else None
   817	    checks["b2_nu_window_ge_D"] = bool(nu_window is None or
   818	                                       nu_window >= D)
   819	    ok6, nex, nrows, ratios = banked_row_match_f(E, p, point, env)
   820	    checks["b3_banked_86row_match"] = bool(ok6 and nrows == 86)
   821	    deepcols = [(f, 17) for f in ("tf1", "tf2", "tg1", "tg2")] + \
   822	               [(f, 22) for f in V2.FAMS]
   823	    rows22 = [a for a in range(29) if V2.S_A[a] == 10] + [28]
   824	    M22 = np.zeros((10, 10), dtype=np.int64)
   825	    for i, a in enumerate(rows22):
   826	        for j, (f, r) in enumerate(deepcols):
   827	            M22[i][j] = Gg[a][22][V2.GIDX[(f, r)]]
   828	    checks["b4_deep_schur_rank_4"] = bool(V2.rankp(M22, p) == 4)
   829	    ok = all(checks.values())
   830	    return {"checks": checks, "check_pass": ok,
   831	            "status": CAND if ok else "FAIL",
   832	            "pending": EC.PENDING["BRIDGE-30"],
   833	            "banked_match": {"rows": nrows, "exact": nex,
   834	                             "unit_rescaled": len(ratios)},
   835	            "nu_window": nu_window,
   836	            "value_bands_le41": val_bands}

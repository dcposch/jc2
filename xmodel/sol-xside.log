   148	def stream_ladders():
   149	    """The 30 input ladders: stream (fam, rho) owns the tangent levels
   150	    r == rho (mod 6) of allowed_r(fam).  Must partition GIDX exactly with
   151	    starts r_start(rho) and step 6 (PIN42 level 10 absent by census)."""
   152	    lad = {}
   153	    for (f, rho) in V2.STREAMS:
   154	        lad[(f, rho)] = sorted(r for r in V2.allowed_r(f)
   155	                               if r % 6 == rho % 6)
   156	    return lad

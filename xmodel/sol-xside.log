   984	        chk("G2d-p%d char-0 crosscheck: numeric d(eta29 t^36)/d(tf1_48) "
   985	            "at the zero configuration == exact %d/%d mod p (= %d)"
   986	            % (p, ETA29_NUM, ETA29_DEN, want), got == want)
   987	    per_prime = {}

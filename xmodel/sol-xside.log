   764	        # weighted-pivot checksum on M_c(NMAX): greedy min-loss pivots
   765	        rowsN = [(a, j) for a in range(29) for j in range(nmax)]
   766	        colsN = [(f, rho, i) for (f, rho) in instreams for i in range(nmax)]
   767	        rlv = [S_A[a] + 6 * j for (a, j) in rowsN]
   768	        clv = [r_start(rho) + 6 * i for (f, rho, i) in colsN]
   769	        MN = np.zeros((len(rowsN), len(colsN)), dtype=np.int64)
   770	        for ri, (a, j) in enumerate(rowsN):

   273	def ext_eval(poly, val, p):
   274	    tot = 0
   275	    for (s, l), c in poly.items():
   276	        m = c
   277	        e = unpack(s)
   278	        for i, ei in enumerate(e):
   279	            if ei:
   280	                m = m * pow(val[P22[i]], ei, p) % p
   281	        for nm, ei in l:
   282	            m = m * pow(val[nm], ei, p) % p
   283	        tot = (tot + m) % p
   284	    return tot

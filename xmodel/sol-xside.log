   361	def fold_radmono(rk, fv, p):
   362	    """radkey -> (packed W-monomial, scalar) at the fiber."""
   363	    za, e1, e2, pw, h1, qw, h2, eB = rk
   364	    assert za == 0 and eB == 0
   365	    c = pow(fv["A1"], e1, p) * pow(fv["A2"], e2, p) % p
   366	    c = c * pow(fv["HW1_over_W1"], h1, p) % p \
   367	        * pow(fv["HW2_over_W2"], h2, p) % p
   368	    e = [0] * NV
   369	    e[IW1] = pw + h1
   370	    e[IW2] = qw + h2
   371	    return pack(e), c

   267	# ---------------------------------------------- PARAM-30: the loss scan
   268	def window_object(E):
   269	    """The corrected square operator's exact window: 174 output coords
   270	    (a, j), s_a + 6j <= 40, x 170 tangent coords (GIDX order).  Entries
   271	    are the ACTUAL gradient values (causality is measured, not imposed)."""
   272	    Gg = E.G.astype(np.int64)
   273	    rows = [(a, j) for a in range(30)
   274	            for j in range((RMAX - S30[a]) // 6 + 1)]
   275	    row_lv = np.array([S30[a] + 6 * j for a, j in rows])
   276	    ncol = len(V2.GIDX)
   277	    col_lv = np.zeros(ncol, dtype=np.int64)
   278	    for (f, r), i in V2.GIDX.items():
   279	        col_lv[i] = r
   280	    M = np.zeros((len(rows), ncol), dtype=np.int64)
   281	    for ri, (a, j) in enumerate(rows):
   282	        M[ri, :] = Gg[a][S30[a] + 6 * j][:]
   283	    return rows, row_lv, col_lv, M
   284	
   285	def delayed_loss_scan(row_lv, col_lv, M, p):
   286	    """Certified lower bound on ell(L) per (2.1) with the LITERAL n >= 0
   287	    convention: for every n, the window part of L(F^nX) is spanned by the
   288	    columns of level >= n (causality); an in-window unit target of level
   289	    b >= n outside that span certifies ell > b - n, i.e. ell >= b - n + 1.
   290	    Scan evaluates every constant-coverage interval at its LOWER endpoint
   291	    (incl. n = 0), so the bound is the sharpest the window supports."""
   292	    levels = sorted({int(v) for v in col_lv}, reverse=True)
   293	    order = np.argsort(-col_lv, kind="stable")
   294	    cs = V2.Colspace(len(row_lv), p)
   295	    oi = 0
   296	    ell_lb = 0
   297	    profile = []
   298	    for k, v in enumerate(levels):
   299	        while oi < len(order) and col_lv[order[oi]] >= v:
   300	            cs.add(M[:, order[oi]].copy())
   301	            oi += 1
   302	        n_eval = (levels[k + 1] + 1) if k + 1 < len(levels) else 0
   303	        cov = cs.covered_rows()
   304	        bad = row_lv[(~cov) & (row_lv >= n_eval)]
   305	        bound = (int(bad.max()) - n_eval + 1) if len(bad) else 0
   306	        profile.append([int(n_eval), int(v), int((~cov).sum()),
   307	                        (int(bad.max()) if len(bad) else None),
   308	                        max(0, bound)])
   309	        ell_lb = max(ell_lb, bound)
   310	    return int(ell_lb), len(cs.basis), profile
   311	
   312	def gate_param30(E, p, D):
   313	    """Executable PARAM-30 content: the square object, M+(1), and the
   314	    certified delayed-loss floor.  FAIL direction fully certified at the
   315	    named completion; PASS direction only ever candidate-tier."""
   316	    Gg = E.G.astype(np.int64)
   317	    checks = {}
   318	    rows, row_lv, col_lv, M = window_object(E)
   319	    checks["p1_square_object_174x170"] = bool(
   320	        M.shape == (174, 170) and len(V2.STREAMS) == 30)
   321	    # M+(1): leading 30x30 truncation of (8.1)
   322	    M1 = np.zeros((30, 30), dtype=np.int64)
   323	    for a in range(30):
   324	        for q, (f, rho) in enumerate(V2.STREAMS):
   325	            M1[a][q] = Gg[a][S30[a]][V2.GIDX[(f, V2.r_start(rho))]]
   326	    rank1 = V2.rankp(M1.copy(), p)
   327	    delta1 = 30 - rank1
   328	    checks["p2_M1_computed"] = True
   329	    ell_lb, wrank, profile = delayed_loss_scan(row_lv, col_lv, M, p)
   330	    checks["p3_loss_scan_ran"] = bool(len(profile) > 0)
   331	    thresh = (D - 1) // 2
   332	    # The threshold comparison is the per-point VERDICT, not an integrity
   333	    # check: ell_lb > thresh is the certified refutation direction.
   334	    refuted = ell_lb > thresh
   335	    if not all(checks.values()):
   336	        status = "FAIL"
   337	    elif refuted:
   338	        status = ("FAIL-CERTIFIED (ell+ >= %d > %d at the named zero "
   339	                  "completion; no causal section of loss <= %d exists "
   340	                  "for this operator)" % (ell_lb, thresh, thresh))
   341	    else:
   342	        status = CAND
   343	    return {"checks": checks, "check_pass": all(checks.values()),
   344	            "verdict_ell_le_threshold": bool(not refuted),
   345	            "status": status, "pending": PENDING["PARAM-30"],
   346	            "window_rank_174x170": int(wrank),
   347	            "delta_plus_N1": int(delta1),
   348	            "delta_plus_N2plus": ("NOT COMPUTABLE from the pure-y build: "
   349	                                  "H_29 row j >= 1 sits at band >= 42 = "
   350	                                  "the unbanked x-side (sol-round6 1.1); "
   351	                                  "fail-closed"),
   352	            "d_plus_stabilized": None, "e_plus_idx": None,
   353	            "ell_lb_certified": int(ell_lb),
   354	            "ell_scan_profile": profile,
   355	            "ell_profile_key": ("[n_eval, cols>=level, n_uncovered, "
   356	                                "max_uncovered_level, ell_ge]"),
   357	            "threshold_floor_Dm1_2": thresh}

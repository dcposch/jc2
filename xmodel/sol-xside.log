   430	def euler_rows(jf, jg, p):
   431	    """E = (theta Phi - 12 Phi) Gamma_eta - Phi_eta (theta Gamma - 18
   432	    Gamma) + 42 t^20  (gauge c_f c_g = 1; directionb_strike.jrows)."""
   433	    jA = theta_shift(jf, 12, p)
   434	    jBg = theta_shift(jg, 18, p)
   435	    jfH = eta_deriv(jf, p)
   436	    jgH = eta_deriv(jg, p)
   437	    T1 = jmul(jA, jgH, p)
   438	    T2 = jmul(jfH, jBg, p)
   439	    E = Jet(HMAX, True)
   440	    h1 = min(T1.h, HMAX)
   441	    E.V[:h1] += T1.V[:h1]
   442	    E.G[:h1] += T1.G[:h1]
   443	    h2 = min(T2.h, HMAX)
   444	    E.V[:h2] -= T2.V[:h2]
   445	    E.G[:h2] -= T2.G[:h2]
   446	    E.V %= p
   447	    E.G %= p
   448	    E.V[0][20] = (E.V[0][20] + 42) % p
   449	    return E
   450	
   451	def path_A_rows(jf, jg, p):
   452	    """Second direct differentiation path (gate G9): assemble (L) of
   453	    sol-round5.md by hand -- (theta dPhi - 12 dPhi) Gamma_eta + (theta
   454	    Phi - 12 Phi) (dGamma)_eta - (dPhi)_eta (theta Gamma - 18 Gamma)
   455	    - Phi_eta (theta dGamma - 18 dGamma) -- multiplying VALUE-only jets
   456	    against GRADIENT-only jets (a different product-rule grouping than
   457	    the dual-jet path)."""
   458	    def vonly(J):
   459	        K = Jet(J.h, False)
   460	        K.V = J.V.copy()
   461	        return K
   462	    def gonly(J):
   463	        K = Jet(J.h, True)
   464	        K.G = J.G.copy()
   465	        return K
   466	    fV, gV = vonly(jf), vonly(jg)
   467	    fD, gD = gonly(jf), gonly(jg)
   468	    terms = [jmul(theta_shift(fD, 12, p), eta_deriv(gV, p), p),
   469	             jmul(theta_shift(fV, 12, p), eta_deriv(gD, p), p)]
   470	    neg = [jmul(eta_deriv(fD, p), theta_shift(gV, 18, p), p),
   471	           jmul(eta_deriv(fV, p), theta_shift(gD, 18, p), p)]
   472	    DG = np.zeros((HMAX, _S, GD))
   473	    for T in terms:
   474	        h = min(T.h, HMAX)
   475	        DG[:h] += T.G[:h]
   476	    for T in neg:
   477	        h = min(T.h, HMAX)
   478	        DG[:h] -= T.G[:h]
   479	    return np.mod(DG, p)

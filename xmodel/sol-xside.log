   753	# ----------------------------------------------- fiber-frame certification
   754	def build_point_f(p, wit72, deep_tails, env):
   755	    """valuation_e2.build_point with the fiber's selector frame in the
   756	    fixed data (A_i = A_ir, HW_i = h_ir W_i)."""
   757	    point = V2.build_point(p, wit72, deep_tails)
   758	    fx = point["fixed"]
   759	    fx["A1"], fx["A2"] = env["A1"], env["A2"]
   760	    fx["HW1"] = env["h1"] * fx["W1"] % p
   761	    fx["HW2"] = env["h2"] * fx["W2"] % p
   762	    blob = json.dumps({"prime": p, "base_zc": point["zc_hash"],
   763	                       "fiber": {k: env[k] for k in
   764	                                 ("label", "A1", "A2", "h1", "h2")}},
   765	                      sort_keys=True)
   766	    import hashlib
   767	    point["zc_hash"] = hashlib.sha256(blob.encode()).hexdigest()
   768	    return point

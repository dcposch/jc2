   226	def ext_nf(poly, gb, p, want_trace=False):
   227	    """Coefficientwise NF: group by lift monomial, reduce the 22-var
   228	    part through the fiber GB."""
   229	    bylift = {}
   230	    for (s, l), c in poly.items():
   231	        bylift.setdefault(l, {})[s] = c
   232	    out, traces = {}, {}
   233	    for l, zpoly in bylift.items():
   234	        nf, tr, _ = nf_trace(zpoly, gb, p)
   235	        for s, c in nf.items():
   236	            out[(s, l)] = c
   237	        if want_trace and tr:
   238	            traces[l] = tr
   239	    return out, (traces if want_trace else None)

   213	def ext_mul(a, b, p):
   214	    out = {}
   215	    if len(a) > len(b):
   216	        a, b = b, a
   217	    for (sa, la), ca in a.items():
   218	        for (sb, lb), cb in b.items():
   219	            k = (wcancel(sa + sb), lift_mul(la, lb))
   220	            nc = (out.get(k, 0) + ca * cb) % p
   221	            if nc: out[k] = nc
   222	            else: out.pop(k, None)
   223	    return out

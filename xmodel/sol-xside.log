   877	def run_point(p, wit72, deep_tails, tag="", light=False, quiet=False):
   878	    t0 = time.time()
   879	    pt, r3, h32 = V.radical_env(p)
   880	    Zroot = pt["z"]
   881	    assert pow(Zroot, 42, p) == 1 and all(
   882	        pow(Zroot, 42 // q, p) != 1 for q in (2, 3, 7)), \
   883	        "banked z is not a primitive 42nd root"
   884	    Z = [pow(Zroot, m, p) for m in range(42)]
   885	    point = build_point(p, wit72, deep_tails)
   886	    jf, jg = build_jets(point, p, Z)
   887	    E = euler_rows(jf, jg, p)
   888	    op_hash = operator_hash(E, p)
   889	    res = {"zc_hash": point["zc_hash"], "operator_hash": op_hash,
   890	           "zeta": Zroot}
   891	    def qchk(name, cond, hard=True):
   892	        if quiet:
   893	            if not cond:
   894	                chk(tag + name, cond, hard)
   895	            else:
   896	                GATES.append((tag + name, True, hard))
   897	        else:
   898	            chk(tag + name, cond, hard)
   899	    # structure gates (sec 1.3 step 2)
   900	    def _chk(name, cond, hard=True):
   901	        qchk(name, cond, hard)
   902	    st = structure_gates(E, p, _chk)
   903	    res.update(st)
   904	    n3, naff, support = ore_affinity_gate(E, p)
   905	    qchk("G7 Ore structure (O): all %d (a,fam,d) bins with >=3 stream "
   906	         "samples affine in r (A + B*Theta action)" % n3, naff == n3)
   907	    res["ore_bins_3plus"] = [n3, naff]
   908	    res["ore_support_hash"] = hashlib.sha256(
   909	        json.dumps(sorted(map(list, support))).encode()).hexdigest()
   910	    ok6, nex, nrows, ratios = banked_row_match(E, p, dval_for_banked(p, point))
   911	    qchk("G6 banked-pipeline cross-check: %d/%d window rows match "
   912	         "(%d exact, %d up to a recorded per-row unit)"
   913	         % (nrows, nrows, nex, len(ratios)), ok6)
   914	    res["banked_match"] = {"rows": nrows, "exact": nex,
   915	                           "unit_rescaled": ratios}
   916	    # G10: the certified Row_22 Schur rank through the new operator
   917	    Gg = E.G.astype(np.int64)
   918	    deepcols = [(f, 17) for f in ("tf1", "tf2", "tg1", "tg2")] + \
   919	               [(f, 22) for f in FAMS]
   920	    rows22 = [a for a in range(29) if S_A[a] == 10] + [28]
   921	    M22 = np.zeros((10, 10), dtype=np.int64)
   922	    for i, a in enumerate(rows22):
   923	        for j, (f, r) in enumerate(deepcols):
   924	            M22[i][j] = Gg[a][22][GIDX[(f, r)]]
   925	    rk22 = rankp(M22, p)
   926	    qchk("G10 band-22 deep block rank == 4 (the certified Schur rank)",
   927	         rk22 == 4)
   928	    res["deep_schur_rank"] = int(rk22)
   929	    if not light:
   930	        # G8 zeta-branch invariance (second primitive 42nd root)
   931	        Z2r = pow(Zroot, 5, p)
   932	        Z2 = [pow(Z2r, m, p) for m in range(42)]
   933	        jf2, jg2 = build_jets(point, p, Z2)
   934	        E2 = euler_rows(jf2, jg2, p)
   935	        qchk("G8 zeta-branch invariance: operator identical under "
   936	             "zeta -> zeta^5 rebuild", operator_hash(E2, p) == op_hash)
   937	        # G9 second direct differentiation path: (L) assembled by hand
   938	        DG = path_A_rows(jf, jg, p)
   939	        qchk("G9 second differentiation path: hand-assembled (L) == "
   940	             "dual-jet derivative", np.array_equal(DG, E.G))
   941	    blocks = block_diagnostics(E, p)
   942	    cands = [b for b in blocks if b["consistent_diagnostics"]]
   943	    e_cand = min((b["e_index_V"] for b in cands), default=None)
   944	    argmin = next((b["stream"] for b in cands
   945	                   if b["e_index_V"] == e_cand), None)
   946	    res["blocks"] = blocks
   947	    res["depth_e_strict"] = None
   948	    res["depth_e_strict_note"] = ("no block promotes (no Ore certificate; "
   949	                                  "CONJECTURE E-HENSEL unproved): strictly "
   950	                                  "NO DEPTH e")
   951	    res["e_candidate"] = {"tag": EXP, "value": e_cand,
   952	                          "argmin_stream": argmin,
   953	                          "n_consistent_blocks": len(cands),
   954	                          "promoted": False}
   955	    res["seconds"] = round(time.time() - t0, 1)
   956	    return res, E

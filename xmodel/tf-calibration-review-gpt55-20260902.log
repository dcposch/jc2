   512	def build_parser() -> argparse.ArgumentParser:
   513	    parser = argparse.ArgumentParser(description=__doc__)
   514	    sub = parser.add_subparsers(dest="command", required=True)
   515	    verify = sub.add_parser("verify", help="verify one or more sealed reports")
   516	    verify.add_argument(
   517	        "--expected-basis",
   518	        "--expect-basis",
   519	        dest="expected_basis",
   520	        help="require this exact 40-character frozen basis (never inferred)",
   521	    )
   522	    verify.add_argument("files", nargs="+", type=Path)
   523	    stamp = sub.add_parser("stamp", help="append a canonical seal atomically")
   524	    stamp.add_argument("file", type=Path)
   525	    stamp.add_argument("--basis", required=True)
   526	    divert = sub.add_parser(
   527	        "divert",
   528	        help="bank non-whitespace overflow after a sole BODY-END, truncating "
   529	        "the charged report to its body; never repairs zero/multiple markers",
   530	    )
   531	    divert.add_argument("file", type=Path)
   532	    divert.add_argument("--overflow", required=True, type=Path)
   533	    divert.add_argument("--raw", type=Path)
   534	    return parser
   535	
   536	
   537	def main(argv: list[str] | None = None) -> int:
   538	    args = build_parser().parse_args(argv)
   539	    if args.command == "verify":
   540	        if args.expected_basis is not None:
   541	            try:
   542	                _validate_basis(args.expected_basis, label="expected basis")
   543	            except SealError as exc:
   544	                print(f"seal: INVALID: {exc}", file=sys.stderr)
   545	                return 1
   546	        failures = 0
   547	        for path in args.files:
   548	            try:
   549	                size, digest, basis = verify_path(
   550	                    path, expected_basis=args.expected_basis
   551	                )
   552	                print(
   553	                    f"PASS path={path} body_bytes={size} "
   554	                    f"body_sha256={digest} basis={basis}"
   555	                )
   556	            except (SealError, OSError) as exc:
   557	                failures += 1
   558	                print(f"seal: INVALID path={path}: {exc}", file=sys.stderr)
   559	        return 1 if failures else 0
   560	
   561	    if args.command == "divert":
   562	        try:
   563	            result = divert_path(args.file, args.overflow, args.raw)
   564	        except (SealError, OSError) as exc:
   565	            print(f"seal: INVALID path={args.file}: {exc}", file=sys.stderr)
   566	            return 1
   567	        detail = " ".join(
   568	            f"{key}={value}" for key, value in result.items() if key != "status"
   569	        )
   570	        line = f"DIVERT path={args.file} status={result['status']}"
   571	        print(f"{line} {detail}" if detail else line)
   572	        return 0
   573	
   574	    try:
   575	        size, digest, basis = stamp_path(args.file, args.basis)
   576	        print(
   577	            f"STAMPED path={args.file} body_bytes={size} "
   578	            f"body_sha256={digest} basis={basis}"
   579	        )
   580	        return 0
   581	    except SealDurabilityWarning as exc:
   582	        print(f"seal: DURABILITY_WARNING path={args.file}: {exc}", file=sys.stderr)
   583	        return 2
   584	    except SealError as exc:
   585	        print(f"seal: INVALID path={args.file}: {exc}", file=sys.stderr)
   586	        return 1
   587	    except OSError as exc:
   588	        print(f"seal: INVALID path={args.file}: operating-system error: {exc}", file=sys.stderr)
   589	        return 1
   590	
   591	
   592	if __name__ == "__main__":
   593	    raise SystemExit(main())


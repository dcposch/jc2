     1	#!/usr/bin/env python3
     2	"""The order-nu operator of the bottom-disc Jacobian expansion.
     3	
     4	  y = sigma_1 + pi x^{-delta_1},  f = x^A Phi(x,pi), g = x^B Gamma(x,pi),
     5	  A = d kappa, B = e kappa, kappa = (1-delta_1)/(d+e), A + B - 1 + delta_1 = 0.
     6	  [f,g] = A Phi Gamma' - B Phi' Gamma + x(Phi_x Gamma' - Phi' Gamma_x) = c.
     7	  Order x^{-nu}:   L_nu(Phi_nu, Gamma_nu) = -R_nu   with
     8	  L_nu(F,G) = (A-nu) F P' - B F' P + A Q G' - (B-nu) Q' G,  P = Gamma_0, Q = Phi_0.
     9	  Dividing by kappa and putting nut = nu/kappa:
    10	  Lt(F,G) = (d-nut) F P' - e F' P + d Q G' - (e-nut) Q' G.
    11	"""
    12	import sympy as sp
    13	pi, nut = sp.symbols('pi nut')
    14	
    15	def Lt(F, G, P, Q, d, e):
    16	    return sp.expand((d-nut)*F*sp.diff(P,pi) - e*sp.diff(F,pi)*P
    17	                     + d*Q*sp.diff(G,pi) - (e-nut)*sp.diff(Q,pi)*G)
    18	
    19	def kernel(P, Q, d, e, degF, degG):
    20	    aa = sp.symbols('aa0:%d' % (degF+1)); bb = sp.symbols('bb0:%d' % (degG+1))
    21	    F = sum(aa[i]*pi**i for i in range(degF+1))
    22	    G = sum(bb[i]*pi**i for i in range(degG+1))
    23	    L = sp.Poly(Lt(F,G,P,Q,d,e), pi)
    24	    eqs = [sp.expand(c) for c in L.all_coeffs()]
    25	    unk = list(aa)+list(bb)
    26	    M = sp.Matrix([[sp.expand(sp.diff(q,v)) for v in unk] for q in eqs])
    27	    return M, unk, F, G
    28	
    29	if __name__ == "__main__":
    30	    d, e = 2, 3
    31	    P = pi**3 + 3*pi; Q = pi**2 + 2          # the V=1 solution of (BOTTOM)
    32	    gam = sp.expand(d*Q*sp.diff(P,pi) - e*sp.diff(Q,pi)*P)
    33	    print("(BOTTOM) check: d Q P' - e Q' P =", gam, " (P=%s, Q=%s)" % (P,Q))
    34	    for (degF, degG) in [(3,4)]:
    35	        M, unk, F, G = kernel(P,Q,d,e,degF,degG)
    36	        print("\n-- kernel of Lt on deg F <= %d, deg G <= %d (%d unknowns) --" % (degF,degG,len(unk)))
    37	        ns = M.nullspace()
    38	        print("   generic nut: nullity =", len(ns))
    39	        for v in ns:
    40	            Fv = sp.simplify(F.subs(dict(zip(unk, list(v)))))
    41	            Gv = sp.simplify(G.subs(dict(zip(unk, list(v)))))
    42	            print("     F =", sp.factor(sp.simplify(Fv)), "   G =", sp.factor(sp.simplify(Gv)))
    43	        # where does the rank drop?
    44	        r = M.rank()
    45	        print("   generic rank =", r, "of", M.shape)
    46	        mins = set()
    47	        for c in sp.Matrix(M).minor_submatrix(0,0).shape and []: pass
    48	        # find special nut by det of a maximal square submatrix system
    49	        import itertools
    50	        rows = list(range(M.shape[0]))
    51	        specials = set()
    52	        for cols in itertools.combinations(range(M.shape[1]), r):
    53	            for rws in itertools.combinations(rows, r):
    54	                sub = M[list(rws), list(cols)]
    55	                dt = sp.factor(sp.expand(sub.det()))
    56	                if dt != 0:
    57	                    for f_, _m in sp.factor_list(dt)[1]:
    58	                        if nut in f_.free_symbols:
    59	                            for s in sp.solve(f_, nut): specials.add(sp.nsimplify(s))
    60	                    break
    61	            else:
    62	                continue
    63	            break
    64	        print("   nut values where the rank can drop (from one maximal minor):", sorted(specials, key=str))


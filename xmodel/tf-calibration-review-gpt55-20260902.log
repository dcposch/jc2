    11	Nlo, Nhi = 6, 16
    12	def knap_alive(items, u, CAP=200000):
    13	    cand = sorted(set((v,q) for (v,q) in items if v*q <= Nhi))
    14	    reach = {0:{F(0)}}
    15	    for tv in range(0,u+1):
    16	        if tv not in reach: continue
    17	        for s0 in list(reach[tv]):
    18	            for (v,q) in cand:
    19	                if tv+v>u: continue
    20	                s1=s0+v*q
    21	                if s1>Nhi: continue
    22	                tgt=reach.setdefault(tv+v,set())
    23	                if len(tgt)>=CAP: return True   # capped -> count as ALIVE (floor on kills)
    24	                tgt.add(s1)
    25	                if s1.denominator==1 and Nlo<=s1<=Nhi: return True
    26	    return False
    27	
    28	lo=int(sys.argv[1]); hi=int(sys.argv[2])
    29	print("== sweep D in [%d,%d]: base census -> Moh(10) -> +(10)_1 -> +knapsack N in [%d,%d] ==" % (lo,hi,Nlo,Nhi))
    30	print("   %5s %10s %10s %10s %10s %10s %10s %10s" %
    31	      ("D","V-skel","grp","g:(10)","g:+(10)_1","g:+knap","V:(10)","V:+(10)_1"))
    32	T=[0]*7
    33	for n in range(lo,hi+1):
    34	    t0=time.time()
    35	    g0={}; g1={}; g2={}; nv=0; n1=0; n2=0
    36	    for (m,Ms,V) in census(n):
    37	        S=Skel(n,m,list(Ms),V)
    38	        if not S.windows_ok(): continue
    39	        nv+=1; key=(m,Ms,S.V[S.s]); g0.setdefault(key,[]).append((S.V[2],qval(S),S.u))
    40	        if moh10(S):
    41	            n1+=1; g1.setdefault(key,[]).append((S.V[2],qval(S),S.u))
    42	            if star_congruence(S):
    43	                n2+=1; g2.setdefault(key,[]).append((S.V[2],qval(S),S.u))
    44	    if not nv: continue
    45	    alive=0
    46	    for key,items in g2.items():
    47	        u=int(items[0][2])
    48	        if knap_alive([(v,q) for (v,q,_) in items], u): alive+=1
    49	    T[0]+=nv; T[1]+=len(g0); T[2]+=len(g1); T[3]+=len(g2); T[4]+=alive; T[5]+=n1; T[6]+=n2
    50	    print("   %5d %10d %10d %10d %10d %10d %10d %10d   %.0fs" %
    51	          (n,nv,len(g0),len(g1),len(g2),alive,n1,n2,time.time()-t0)); sys.stdout.flush()
    52	print("   TOTAL: V-skel %d ; groups %d -> (10) %d -> (10)_1 %d -> knapsack-alive %d"
    53	      % (T[0],T[1],T[2],T[3],T[4]))
    54	print("   V-assignments: %d -> (10) %d -> (10)_1 %d" % (T[0],T[5],T[6]))


   441	                  f"{str(mnr):>10} {str(mx):>12}")
   442	    print(f"\n   TOTAL n<={nmax}: (n,m,M)={G[0]}  V-skeletons={G[1]}  "
   443	          f"branch-robust groups (n,m,M,V_s)={G[2]}")
   444	    print(f"   U_rob<=0 (would force N=0, impossible): {G[3]}")
   445	    print(f"   U_rob<2  KILLED unconditionally:        {G[4]}")
   446	    print(f"   U_rob<4  KILLED under H2 (4<=N<=16):    {G[5]}")
   447	    print(f"   surviving groups at U_rob>=4:           {G[2]-G[5]}")
   448	    print(f"   global min U_rob = {GMIN} at n = {smallrow[0] if smallrow else '-'}")
   449	    print(f"   global max U_tower = {GMAX} (= {float(GMAX):.2f}) at {bigrow}")

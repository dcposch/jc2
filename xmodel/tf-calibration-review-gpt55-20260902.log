   397	def run_filter(nmax, nmin_geom=(2, 4), verbose_upto=100):
   398	    """Two readings of the ceiling per skeleton.
   399	
   400	    U_tower : the bound for ONE tower, i.e. for one row of Moh's search table.
   401	    U_rob   : the BRANCH-ROBUST bound.  Only V_s is a global datum of the pair
   402	              (it is the multiplicity split u:v of the top form); V_{s-1},...,V_2
   403	              are per-branch, and a pair may carry several inequivalent major
   404	              branches.  Since the total number of g-roots in bottom-major discs
   405	              is <= a_{s-1} = u*e whatever the branch mix, the branch-robust bound
   406	              is  U_rob(n,m,M_*,V_s) = u*d*max over (V_{s-1}..V_2) of (-lambda_g(delta_1))^+.
   407	    Kills are computed on U_rob (the weaker, safe one).
   408	    """
   409	    print(f"\n== FILTER: N <= U(skeleton) = u*d*(-lambda_g(delta_1))^+ , n <= {nmax} ==")
   410	    print(f"   kills on the BRANCH-ROBUST U_rob:  U_rob < {nmin_geom[0]}"
   411	          f" (N>=2, unconditional: non-invertible)"
   412	          f" | U_rob < {nmin_geom[1]} (N>=4, campaign H2 residual 4<=N<=16)")
   413	    print(f"   {'n=D':>5} {'#(n,m,M)':>9} {'#V-skel':>10} {'#groups':>8} {'kill<2':>7} {'kill<4':>7}"
   414	          f" {'min U_rob':>10} {'max U_tow':>12}")
   415	    G = [0,0,0,0,0,0]; GMAX = F(0); GMIN = None; bigrow = None; smallrow = None
   416	    killed = []
   417	    t0 = time.time()
   418	    for n in range(48, nmax+1):
   419	        seen = set(); cV = 0; mx = F(0)
   420	        groups = {}
   421	        for (m, Ms, V) in census(n):
   422	            cV += 1; seen.add((m, Ms))
   423	            S = Skel(n, m, list(Ms), V)
   424	            U = S.N_upper()
   425	            if U > mx: mx = U; row = (n, m, Ms, tuple(V[i] for i in sorted(V)), U)
   426	            key = (m, Ms, V[S.s])
   427	            if key not in groups or U > groups[key][0]:
   428	                groups[key] = (U, tuple(V[i] for i in sorted(V)))
   429	        if not cV: continue
   430	        k2 = sum(1 for (U, _) in groups.values() if U < nmin_geom[0])
   431	        k4 = sum(1 for (U, _) in groups.values() if U < nmin_geom[1])
   432	        k0 = sum(1 for (U, _) in groups.values() if U <= 0)
   433	        mnr = min(U for (U, _) in groups.values())
   434	        for key, (U, Vt) in groups.items():
   435	            if U < nmin_geom[1]: killed.append((n, key[0], key[1], key[2], Vt, U))
   436	        G[0] += len(seen); G[1] += cV; G[2] += len(groups); G[3] += k0; G[4] += k2; G[5] += k4
   437	        if mx > GMAX: GMAX = mx; bigrow = row
   438	        if GMIN is None or mnr < GMIN: GMIN = mnr; smallrow = (n, mnr)

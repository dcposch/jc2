   175	def control_6_extremes():
   176	    print("\n-- CONTROL 6: closed-form window extremes vs brute force (n <= 72) --")
   177	    tested = 0
   178	    for n in range(48, 73):
   179	        groups = set()
   180	        for (m, Ms, V) in census(n):
   181	            S = Skel(n, m, list(Ms), V)
   182	            if S.windows_ok(): groups.add((m, Ms, S.V[S.s]))
   183	        for (m, Ms, Vs_top) in sorted(groups):
   184	            Vlo, Vhi = lower_V_extremes(n, m, list(Ms), Vs_top)
   185	            blo, bhi = brute_extremes(n, m, list(Ms), Vs_top)
   186	            if Vlo is None or blo is None: continue
   187	            Slo = Skel(n, m, list(Ms), Vlo); Shi = Skel(n, m, list(Ms), Vhi)
   188	            tested += 1
   189	            if not check("min V_2 q  n=%d m=%d %s Vs=%d"%(n,m,Ms,Vs_top),
   190	                         Slo.V[2]*qval(Slo) == blo[0], "%s vs %s"%(Slo.V[2]*qval(Slo), blo[0])): return
   191	            if not check("max q     n=%d m=%d %s Vs=%d"%(n,m,Ms,Vs_top),
   192	                         qval(Shi) == bhi[0], "%s vs %s"%(qval(Shi), bhi[0])): return
   193	    print("   %d groups, 0 mismatches" % tested)

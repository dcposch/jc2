   246	    basis = _unique(FROZEN_BASIS_RE, post, "Frozen basis")
   247	    actual_sha = hashlib.sha256(body).hexdigest()
   248	    if declared_bytes != len(body):
   249	        raise SealError(
   250	            f"body byte mismatch: declared {declared_bytes}, actual {len(body)}"
   251	        )
   252	    if declared_sha != actual_sha:
   253	        raise SealError(
   254	            f"body SHA-256 mismatch: declared {declared_sha}, actual {actual_sha}"
   255	        )
   256	    if expected_basis is not None and basis != expected_basis:
   257	        raise SealError(
   258	            f"frozen basis mismatch: declared {basis}, expected {expected_basis}"
   259	        )
   260	    canonical = _canonical_seal(len(body), actual_sha, basis)
   261	    if data[boundary:] != canonical:
   262	        raise SealError("post-body seal is not the canonical LF serialization")

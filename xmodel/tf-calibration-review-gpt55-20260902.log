   263	# ------------------------------------------------------- INTEGRALITY (pinned N)
   264	def achievable(S, Nlo=None, Nhi=None):
   265	    """Under (UNI) -- all bottom-major discs carry the same lower-V datum -- the pinned
   266	       value is  N = k * V_2 * q  with k = #bottom-major discs and  k*V_2 <= u.
   267	       Return the integers so achievable (optionally clipped to [Nlo,Nhi])."""
   268	    q = qval(S); v = S.V[2]; u = S.u
   269	    out = []
   270	    kmax = int(u // v) if v else 0
   271	    for k in range(1, kmax+1):
   272	        val = k*v*q
   273	        if val.denominator == 1:
   274	            iv = int(val)
   275	            if (Nlo is None or iv >= Nlo) and (Nhi is None or iv <= Nhi): out.append(iv)
   276	    return out
   277	
   278	def run_integrality(nmax, nmin=48, Nlo=4, Nhi=16):
   279	    print("\n== INTEGRALITY FILTER under (UNI):  N = k V_2 q in Z, k V_2 <= u ==")
   280	    print("   %5s %9s %9s %9s %9s %9s" %
   281	          ("D","assign","kill(uncond)","kill(H2)","groups","grp kill(H2)"))
   282	    T = dict(a=0, ka=0, kh=0, g=0, kg=0); rows={}
   283	    for n in range(nmin, nmax+1):
   284	        na=ka=kh=0; grp={}
   285	        for (m, Ms, V) in census(n):
   286	            S = Skel(n, m, list(Ms), V)
   287	            if not S.windows_ok(): continue
   288	            na += 1
   289	            allv = achievable(S)
   290	            h2   = [x for x in allv if Nlo <= x <= Nhi]
   291	            unc  = [x for x in allv if x >= 2]
   292	            if not unc: ka += 1
   293	            if not h2:  kh += 1
   294	            key = (m, Ms, S.V[S.s])
   295	            grp.setdefault(key, [False, False])
   296	            if unc: grp[key][0] = True
   297	            if h2:  grp[key][1] = True
   298	        kg = sum(1 for k in grp if not grp[k][1])
   299	        if na:
   300	            rows[n] = (na, ka, kh, len(grp), kg)
   301	            T['a']+=na; T['ka']+=ka; T['kh']+=kh; T['g']+=len(grp); T['kg']+=kg
   302	    for n in sorted(rows):
   303	        if n in (105,108,112,117,120) or n % 25 == 0 or n == nmax:
   304	            na, ka, kh, ng, kg = rows[n]
   305	            print("   %5d %9d %9d %9d %9d %9d" % (n, na, ka, kh, ng, kg))
   306	    print("   ---- totals over D in [%d,%d] ----" % (nmin, nmax))
   307	    print("   V-assignments %d ; killed unconditionally (no integer N>=2): %d (%.2f%%)"
   308	          % (T['a'], T['ka'], 100.0*T['ka']/max(1,T['a'])))
   309	    print("   V-assignments killed under H2 (no integer N in [4,16]): %d (%.2f%%)"
   310	          % (T['kh'], 100.0*T['kh']/max(1,T['a'])))
   311	    print("   groups (n,m,M_*,V_s) %d ; killed under H2 (every assignment dead): %d (%.2f%%)"
   312	          % (T['g'], T['kg'], 100.0*T['kg']/max(1,T['g'])))
   313	    dead = [n for n in rows if rows[n][4] == rows[n][3]]
   314	    print("   degrees D with EVERY group killed under (UNI)+H2: %s" % (dead if dead else "NONE"))
   315	    return rows
   316	
   317	def run_general(nmax, nmin=48, Nlo=4, Nhi=16, CAP=40000):
   318	    """HYPOTHESIS-FREE version: bottom-major discs may carry DIFFERENT lower-V data.
   319	       N = sum_B V_2(B) q(B) with sum_B V_2(B) <= u.  Exact knapsack over Fractions,
   320	       pruned to sums <= Nhi; CAP guards the state count (capped groups -> UNDECIDED,
   321	       counted as SURVIVING, so the reported kill is a floor)."""
   322	    print("\n== GENERAL (no (UNI)) knapsack:  N = sum_B V_2(B) q(B), sum V_2(B) <= u ==")
   323	    tot=dict(g=0,k=0,c=0)
   324	    rows={}
   325	    for n in range(nmin, nmax+1):
   326	        groups={}
   327	        for (m, Ms, V) in census(n):
   328	            S = Skel(n, m, list(Ms), V)
   329	            if not S.windows_ok(): continue
   330	            groups.setdefault((m, Ms, S.V[S.s]), []).append((S.V[2], qval(S), S.u))
   331	        ng=nk=nc=0
   332	        for key, items in groups.items():
   333	            ng += 1
   334	            u = int(items[0][2])
   335	            cand = sorted(set((v, q) for (v, q, _) in items if v*q <= Nhi))
   336	            reach = {0: {F(0)}}
   337	            capped = False; hit = False
   338	            for tv in range(0, u+1):
   339	                if tv not in reach: continue
   340	                for s0 in list(reach[tv]):
   341	                    for (v, q) in cand:
   342	                        if tv+v > u: continue
   343	                        s1 = s0 + v*q
   344	                        if s1 > Nhi: continue
   345	                        reach.setdefault(tv+v, set())
   346	                        if len(reach[tv+v]) >= CAP: capped=True; continue
   347	                        reach[tv+v].add(s1)
   348	                        if s1.denominator == 1 and Nlo <= s1 <= Nhi: hit = True
   349	                if hit: break
   350	            if hit: continue
   351	            if capped: nc += 1; continue
   352	            nk += 1
   353	        rows[n]=(ng,nk,nc); tot['g']+=ng; tot['k']+=nk; tot['c']+=nc
   354	    print("   %5s %9s %12s %10s" % ("D","groups","killed(H2)","capped"))
   355	    for n in sorted(rows):
   356	        ng,nk,nc = rows[n]
   357	        if n in (105,108,112,117,120) or n%25==0 or n==nmax:
   358	            print("   %5d %9d %12d %10d" % (n,ng,nk,nc))
   359	    print("   totals D in [%d,%d]: groups %d, killed %d (%.2f%%), capped/UNDECIDED %d"
   360	          % (nmin,nmax,tot['g'],tot['k'],100.0*tot['k']/max(1,tot['g']),tot['c']))
   361	    return rows


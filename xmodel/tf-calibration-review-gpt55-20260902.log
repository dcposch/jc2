   145	    M = {i+1: full[i] for i in range(s)}
   146	    d = [n]
   147	    for Mi in full: d.append(gcd(d[-1], Mi))
   148	    d = {i+1: d[i] for i in range(len(d))}
   149	    # top of window (max q)
   150	    Vhi = {s+1: d[s+1], s: Vs_top}
   151	    for i in range(s-1, 1, -1):
   152	        hi = F(Vhi[i+1]*d[i], d[i+1]); Vhi[i] = hi.numerator//hi.denominator
   153	        if Vhi[i]*(n-M[i]) <= d[i]: return None, None
   154	    # bottom of window (min V_2*q), top-down: V_i as small as its own window allows
   155	    Vlo = {s+1: d[s+1], s: Vs_top}
   156	    for i in range(s-1, 1, -1):
   157	        lo = F(d[i], n-M[i]); v = lo.numerator//lo.denominator + 1
   158	        hi = F(Vlo[i+1]*d[i], d[i+1])
   159	        if v > hi: return None, None
   160	        Vlo[i] = v
   161	    return ({i: Vlo[i] for i in range(2, s+1)}, {i: Vhi[i] for i in range(2, s+1)})
   162	
   163	def brute_extremes(n, m, Ms, Vs_top):
   164	    """exhaustive cross-check of lower_V_extremes."""
   165	    best_lo, best_hi = None, None
   166	    for (mm, MM, V) in census(n):
   167	        if mm != m or MM != tuple(Ms): continue
   168	        S = Skel(n, m, list(Ms), V)
   169	        if not S.windows_ok() or S.V[S.s] != Vs_top: continue
   170	        q = qval(S); lo = S.V[2]*q
   171	        if best_lo is None or lo < best_lo[0]: best_lo = (lo, V)
   172	        if best_hi is None or q > best_hi[0]: best_hi = (q, V)
   173	    return best_lo, best_hi

     1	#!/usr/bin/env python3
     2	"""(BOTTOM) / STAR condition at level 1 of Moh's tower:
     3	      d Q P' - e Q' P = gamma  (nonzero constant),  deg P = eV, deg Q = dV.
     4	   P = p_g = leading form of g at the general point of D_1 (a_1 = eV roots),
     5	   Q = p_f = leading form of f there (b_1 = dV roots).
     6	   Solve exactly (Groebner) for small (d,e,V); report #solutions mod the
     7	   pi -> alpha pi scaling, and whether P, Q have simple roots."""
     8	import sys, time
     9	import sympy as sp
    10	
    11	pi = sp.symbols('pi')
    12	
    13	def solve_star(d, e, V, verbose=True):
    14	    dP, dQ = e*V, d*V
    15	    # P monic, no pi^{dP-1} term (translation used); Q monic.
    16	    a = sp.symbols('a0:%d' % (dP-1))      # P = pi^dP + a_{dP-2} pi^{dP-2} + ... + a_0
    17	    b = sp.symbols('b0:%d' % dQ)          # Q = pi^dQ + b_{dQ-1} pi^{dQ-1} + ... + b_0
    18	    P = pi**dP + sum(a[i]*pi**i for i in range(dP-1))
    19	    Q = pi**dQ + sum(b[i]*pi**i for i in range(dQ))
    20	    W = sp.expand(d*Q*sp.diff(P,pi) - e*sp.diff(Q,pi)*P)
    21	    Wp = sp.Poly(W, pi)
    22	    eqs = [sp.expand(Wp.nth(j)) for j in range(1, (d+e)*V-1)]
    23	    gamma = sp.expand(Wp.nth(0))
    24	    unk = list(a)+list(b)
    25	    t0 = time.time()
    26	    sols = sp.solve(eqs, unk, dict=True)
    27	    el = time.time()-t0
    28	    out = []
    29	    for s in sols:
    30	        Ps = sp.expand(P.subs(s)); Qs = sp.expand(Q.subs(s)); gs = sp.expand(gamma.subs(s))
    31	        free = sorted((Ps.free_symbols | Qs.free_symbols) - {pi}, key=str)
    32	        out.append((Ps, Qs, gs, free))
    33	    if verbose:
    34	        print("  (d,e,V)=(%d,%d,%d): deg P=%d deg Q=%d, %d eqs, %d unknowns -> %d solution branches (%.1fs)"
    35	              % (d,e,V,dP,dQ,len(eqs),len(unk),len(out),el))
    36	    return out
    37	
    38	def report(d, e, V):
    39	    out = solve_star(d, e, V)
    40	    good = 0
    41	    for (Ps, Qs, gs, free) in out:
    42	        # specialise remaining free parameters (the pi->alpha pi scaling) to 1
    43	        sub = {f: 1 for f in free}
    44	        P1 = sp.expand(Ps.subs(sub)); Q1 = sp.expand(Qs.subs(sub)); g1 = sp.simplify(gs.subs(sub))

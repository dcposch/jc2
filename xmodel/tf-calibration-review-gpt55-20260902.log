    63	        T[0]+=c; T[1]+=p; T[2]+=len(grp); T[3]+=len(grpp)
    64	        if c: print("   %5d %10d %10d %10d %10d" % (n,c,p,len(grp),len(grpp)))
    65	    print("   TOTAL 48..100: V-skeletons %d -> %d ; groups %d -> %d" % tuple(T))
    66	    print("\n   surviving (n,m,M_*) sets after (10), n<=100:")
    67	    ss = sorted(set((n,m,Ms) for (n,m,Ms,_) in survivors))
    68	    for r in ss: print("      n=%d m=%d M=%s" % r)
    69	    print("   (%d distinct (n,m,M); %d V-skeletons)" % (len(ss), len(survivors)))
    70	
    71	# ------------------------------------------------------------------ level-1 form
    72	def star_congruence(S):
    73	    """(10)_1  [this lane, = Moh (8)-(11) at r = 1 combined with D1-STAR(d)].
    74	       The order-Delta_1 automorphism x^{1/Delta_1} -> omega x^{1/Delta_1} fixes
    75	       sigma_1 (its exponents have denominators dividing L_1, by the characteristic-
    76	       exponent structure) and multiplies pi by a primitive Delta_1-th root of unity.
    77	       So the root set of p_1 = g_sigma1 is invariant under that multiplication.
    78	       By Moh Prop 4.6 (r=1) / D1-STAR(d) those a_1 roots are SIMPLE, so pi = 0 is a
    79	       root at most once:   a_1 = e V_2  ==  0 or 1  (mod Delta_1)."""
    80	    D1 = Delta(S, 1); a1 = S.e*S.V[2]
    81	    return (a1 % D1) in (0, 1)
    82	
    83	def moh_all(S):
    84	    return moh10(S) and star_congruence(S)


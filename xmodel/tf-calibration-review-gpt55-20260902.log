    41	def ord_diff(r1, r2):
    42	    """ord_t(r1-r2) for roots given as {exponent-in-x : coeff}; ord_t = -exp_x."""
    43	    from sympy import simplify
    44	    for e in sorted(set(r1) | set(r2), reverse=True):
    45	        if simplify(r1.get(e, 0) - r2.get(e, 0)) != 0:
    46	            return -e
    47	    return INF
    48	
    49	def lam(delta, ords):
    50	    """lambda(delta) = sum_j min(delta, ord_j)."""
    51	    return sum(min(delta, o) for o in ords)
    52	
    53	def frontier(ords):
    54	    """least delta with lam(delta,ords) = 0.  lam is continuous, piecewise linear,
    55	       nondecreasing, lam(-1) = -len(ords) and slope #{o > delta} >= 1 here."""
    56	    lo = F(-1); cur = lam(lo, ords)
    57	    assert cur <= 0
    58	    for nxt in sorted(set(o for o in ords if o < INF)) + [INF]:
    59	        if nxt <= lo: continue
    60	        slope = sum(1 for o in ords if o > lo)
    61	        assert slope > 0, "lambda saturates below 0: g has a repeated root"
    62	        if nxt >= INF or cur + slope*(nxt-lo) >= 0:
    63	            return lo + F(-cur, 1)/slope
    64	        cur += slope*(nxt-lo); lo = nxt
    65	    raise AssertionError("no frontier")

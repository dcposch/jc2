    67	# ---- explicit two-tower families: factor (a,p,b,q) = (y-a*x)^p - b*x^q --------
    68	def _factor(a, p, b, q):
    69	    from sympy import expand, symbols
    70	    x, y = symbols('x y')
    71	    return expand((y - a*x)**p - b*x**q)
    72	
    73	def _roots(a, p, b, q):
    74	    from sympy import sympify, Rational, exp, pi, I
    75	    return [{F(1,1): sympify(a), F(q,p): (sympify(b)**Rational(1,p))*exp(2*pi*I*Rational(k,p))}
    76	            for k in range(p)]

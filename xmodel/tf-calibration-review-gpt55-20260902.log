   265	
   266	def verify_path(
   267	    path: Path, *, expected_basis: str | None = None
   268	) -> tuple[int, str, str]:
   269	    data, _, _ = _read_regular(path)
   270	    return verify_bytes(data, expected_basis=expected_basis)
   271	
   272	
   273	def _canonical_seal(body_bytes: int, body_sha: str, basis: str) -> bytes:
   274	    return (
   275	        "\n## Seal\n\n"
   276	        "- Body definition: every byte through the unique standalone "
   277	        "`<!-- BODY-END -->` line,\n"
   278	        "  including its terminating newline; this seal is outside the body.\n"
   279	        f"- Body bytes: `{body_bytes}`.\n"
   280	        "- Body SHA-256:\n"
   281	        f"  `{body_sha}`.\n"
   282	        f"- Frozen basis: `{basis}`.\n"
   283	    ).encode("utf-8")
   284	
   285	
   286	def stamp_path(path: Path, basis: str) -> tuple[int, str, str]:
   287	    _validate_basis(basis)
   288	    parent_fd, name, parent, parent_info = _open_parent(path)
   289	    temp_name: str | None = None
   290	    durability_error: OSError | None = None
   291	    try:
   292	        data, original = _read_regular_at(parent_fd, name)
   293	        boundary = _body_boundary(data)
   294	        if data[boundary:].strip():
   295	            raise SealError(
   296	                "refusing to stamp: non-whitespace content already follows BODY-END"
   297	            )
   298	        body = data[:boundary]
   299	        digest = hashlib.sha256(body).hexdigest()
   300	        sealed = body + _canonical_seal(len(body), digest, basis)
   301	
   302	        try:
   303	            current = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
   304	        except OSError as exc:
   305	            raise SealError(f"cannot recheck target before replacement: {exc}") from exc
   306	        if stat.S_ISLNK(current.st_mode) or not stat.S_ISREG(current.st_mode):
   307	            raise SealError("target changed to a symlink or non-regular file")
   308	        if _identity(current) != _identity(original):
   309	            raise SealError("target identity changed while preparing seal")
   310	
   311	        temp_fd, temp_name = _create_temp_at(
   312	            parent_fd, name, stat.S_IMODE(original.st_mode)
   313	        )
   314	        with os.fdopen(temp_fd, "wb") as handle:
   315	            handle.write(sealed)
   316	            handle.flush()
   317	            os.fsync(handle.fileno())
   318	
   319	        # Detect both replacement and same-inode rewrites immediately before
   320	        # the atomic install.  This is not a substitute for cooperative locks,
   321	        # but it closes the ordinary concurrent-lane lost-update window.
   322	        latest_data, latest = _read_regular_at(parent_fd, name)
   323	        if _snapshot(latest) != _snapshot(original):
   324	            raise SealError("target metadata changed before atomic replacement")
   325	        if latest_data != data:
   326	            raise SealError("target content changed before atomic replacement")
   327	        _check_parent_path(parent, parent_info)
   328	
   329	        os.replace(
   330	            temp_name,
   331	            name,
   332	            src_dir_fd=parent_fd,
   333	            dst_dir_fd=parent_fd,
   334	        )
   335	        temp_name = None
   336	
   337	        installed, _ = _read_regular_at(parent_fd, name)
   338	        if installed != sealed:
   339	            raise SealError("installed seal differs from staged bytes")
   340	        verify_bytes(installed, expected_basis=basis)
   341	
   342	        try:
   343	            _check_parent_path(parent, parent_info)
   344	        except SealError as exc:
   345	            durability_error = OSError(str(exc))
   346	        try:
   347	            os.fsync(parent_fd)
   348	        except OSError as exc:
   349	            durability_error = durability_error or exc
   350	    finally:
   351	        if temp_name is not None:
   352	            try:
   353	                os.unlink(temp_name, dir_fd=parent_fd)
   354	            except FileNotFoundError:
   355	                pass
   356	        os.close(parent_fd)
   357	    if durability_error is not None:
   358	        raise SealDurabilityWarning(
   359	            "seal was installed and verified, but directory fsync failed: "
   360	            f"{durability_error}"
   361	        )
   362	    return len(body), digest, basis
   363	
   364	
   365	def _write_exclusive(path: Path, data: bytes, mode: int = 0o444) -> str:
   366	    """Create ``path`` exclusively with ``data``; return its SHA-256."""
   367	    parent_fd, name, _parent, _parent_info = _open_parent(path)
   368	    try:
   369	        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
   370	        if hasattr(os, "O_NOFOLLOW"):
   371	            flags |= os.O_NOFOLLOW
   372	        try:
   373	            fd = os.open(name, flags, mode, dir_fd=parent_fd)
   374	        except OSError as exc:
   375	            raise SealError(f"cannot create {path} exclusively: {exc}") from exc
   376	        with os.fdopen(fd, "wb") as handle:
   377	            handle.write(data)
   378	            handle.flush()
   379	            os.fsync(handle.fileno())
   380	        try:
   381	            os.fsync(parent_fd)
   382	        except OSError:
   383	            pass
   384	        return hashlib.sha256(data).hexdigest()
   385	    finally:
   386	        os.close(parent_fd)
   387	
   388	
   389	def divert_path(
   390	    path: Path, overflow_path: Path, raw_path: Path | None = None
   391	) -> dict[str, object]:
   392	    """Split non-whitespace overflow after a sole BODY-END out of a report.
   393	
   394	    The charged report keeps every byte through the marker line; the exact
   395	    overflow bytes land in overflow_path and, when raw_path is given, the
   396	    untouched original is preserved there first.  A report whose post-marker
   397	    content is whitespace or exactly one canonical seal is left unmodified.
   398	    Zero, multiple, and unterminated markers are reported, never repaired.
   399	    """
   400	    parent_fd, name, parent, parent_info = _open_parent(path)
   401	    temp_name: str | None = None
   402	    created_paths: list[Path] = []
   403	    reclassified = False
   404	
   405	    def cleanup_created() -> None:
   406	        for artifact in reversed(created_paths):
   407	            try:
   408	                artifact.unlink()
   409	            except FileNotFoundError:
   410	                pass
   411	        created_paths.clear()
   412	
   413	    try:
   414	        while True:
   415	            data, original = _read_regular_at(parent_fd, name)
   416	            try:
   417	                markers = _marker_boundaries(data, require_newline=True)
   418	            except SealError:
   419	                return {"status": "UNTERMINATED_MARKER", "bytes": len(data)}
   420	            if not markers:
   421	                return {"status": "NO_MARKER", "bytes": len(data)}
   422	            if len(markers) > 1:
   423	                return {"status": "MULTI_MARKER", "markers": len(markers)}
   424	            boundary = markers[0]
   425	            body = data[:boundary]
   426	            tail = data[boundary:]
   427	            body_sha = hashlib.sha256(body).hexdigest()
   428	            if not tail.strip():
   429	                return {
   430	                    "status": "CLEAN",
   431	                    "body_bytes": len(body),
   432	                    "body_sha256": body_sha,
   433	                }
   434	            try:
   435	                verify_bytes(data)
   436	                return {
   437	                    "status": "CLEAN_SEALED",
   438	                    "body_bytes": len(body),
   439	                    "body_sha256": body_sha,
   440	                }
   441	            except SealError:
   442	                pass
   443	
   444	            result: dict[str, object] = {
   445	                "status": "DIVERTED",
   446	                "body_bytes": len(body),
   447	                "body_sha256": body_sha,
   448	                "overflow": str(overflow_path),
   449	                "overflow_bytes": len(tail),
   450	            }
   451	            try:
   452	                if raw_path is not None:
   453	                    result["raw"] = str(raw_path)
   454	                    result["raw_sha256"] = _write_exclusive(raw_path, data)
   455	                    created_paths.append(raw_path)
   456	                result["overflow_sha256"] = _write_exclusive(overflow_path, tail)
   457	                created_paths.append(overflow_path)
   458	
   459	                temp_fd, temp_name = _create_temp_at(
   460	                    parent_fd, name, stat.S_IMODE(original.st_mode)
   461	                )
   462	                with os.fdopen(temp_fd, "wb") as handle:
   463	                    handle.write(body)
   464	                    handle.flush()
   465	                    os.fsync(handle.fileno())
   466	
   467	                # Re-read immediately before replacement.  A cooperative late
   468	                # writer gets one fresh classification rather than stale
   469	                # truncation; repeated mutation fails closed.
   470	                latest_data, latest = _read_regular_at(parent_fd, name)
   471	                if _snapshot(latest) != _snapshot(original) or latest_data != data:
   472	                    os.unlink(temp_name, dir_fd=parent_fd)
   473	                    temp_name = None
   474	                    cleanup_created()
   475	                    if reclassified:
   476	                        raise SealError(
   477	                            "target changed repeatedly before atomic truncation"
   478	                        )
   479	                    reclassified = True
   480	                    continue
   481	                _check_parent_path(parent, parent_info)
   482	                os.replace(
   483	                    temp_name,
   484	                    name,
   485	                    src_dir_fd=parent_fd,
   486	                    dst_dir_fd=parent_fd,
   487	                )
   488	                temp_name = None
   489	                created_paths.clear()
   490	
   491	                installed, _ = _read_regular_at(parent_fd, name)
   492	                if installed != body:
   493	                    raise SealError("installed body differs from staged bytes")
   494	                try:
   495	                    os.fsync(parent_fd)
   496	                except OSError:
   497	                    pass
   498	                return result
   499	            except Exception:
   500	                cleanup_created()
   501	                raise
   502	    finally:
   503	        if temp_name is not None:
   504	            try:
   505	                os.unlink(temp_name, dir_fd=parent_fd)
   506	            except FileNotFoundError:
   507	                pass
   508	        cleanup_created()
   509	        os.close(parent_fd)

   184	def band_record(band: Band) -> dict[str, object]:
   185	    return {
   186	        "layer": band.layer,
   187	        "source_i_range": [band.source_i_min, band.source_i_max],
   188	        "source_j": list(band.source_j),
   189	        "source_count": band.source_count,
   190	        "translation_basis": "t^layer*(1+t)^source_j",
   191	        "jet_vanishing_order": band.jet_vanishing_order,
   192	        "dimension": band.dimension,
   193	        "active_t_exponent_interval": [
   194	            band.t_exponent_min,
   195	            band.t_exponent_max,
   196	        ],
   197	        "active_kummer_characters": sorted(
   198	            {exponent % 5 for exponent in band.active_t_exponents}
   199	        ),
   200	    }

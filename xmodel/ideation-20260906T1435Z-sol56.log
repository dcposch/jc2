   129	def coordinate_bracket_regression() -> dict[str, object]:
   130	    X, y, t, z = sp.symbols("X y t z")
   131	    t_xy = X * y
   132	    z_xy = y**-1
   133	    coordinate_bracket = sp.simplify(
   134	        sp.diff(t_xy, X) * sp.diff(z_xy, y)
   135	        - sp.diff(t_xy, y) * sp.diff(z_xy, X)
   136	    )
   137	    if coordinate_bracket != -z_xy:
   138	        raise AssertionError("the coordinate bracket is not -z")
   139	
   140	    p_bands = {2: t**3 + 2 * t, -1: t**2}
   141	    q_bands = {3: t**2 - t, 0: 3 * t}
   142	    P_tz = sum(polynomial * z**layer for layer, polynomial in p_bands.items())
   143	    Q_tz = sum(polynomial * z**layer for layer, polynomial in q_bands.items())
   144	    predicted = sp.expand(
   145	        sum(
   146	            z ** (p_layer + q_layer)
   147	            * (
   148	                p_layer * p_polynomial * sp.diff(q_polynomial, t)
   149	                - q_layer * sp.diff(p_polynomial, t) * q_polynomial
   150	            )
   151	            for p_layer, p_polynomial in p_bands.items()
   152	            for q_layer, q_polynomial in q_bands.items()
   153	        )
   154	    )
   155	    direct = sp.simplify(
   156	        (
   157	            sp.diff(P_tz.subs({t: t_xy, z: z_xy}), X)
   158	            * sp.diff(Q_tz.subs({t: t_xy, z: z_xy}), y)
   159	            - sp.diff(P_tz.subs({t: t_xy, z: z_xy}), y)
   160	            * sp.diff(Q_tz.subs({t: t_xy, z: z_xy}), X)
   161	        ).subs({X: t * z, y: z**-1})
   162	    )
   163	    if sp.simplify(direct - predicted) != 0:
   164	        raise AssertionError("the corrected Laurent recurrence failed")
   165	    return {
   166	        "chart": {"t": "X*y", "z": "y^-1"},
   167	        "coordinate_bracket": "[t,z]_(X,y)=-z",
   168	        "band_recurrence": (
   169	            "J_L(t)=sum_(i+j=L)(i*p_i(t)*q_j'(t)-"
   170	            "j*p_i'(t)*q_j(t))"
   171	        ),
   172	        "bracket_term": (
   173	            "[p_i(t)z^i,q_j(t)z^j]="
   174	            "(i*p_i*q_j'-j*p_i'*q_j)z^(i+j)"
   175	        ),
   176	        "formal_top_layer": 40,
   177	        "zero_layers": [39, 5],
   178	        "zero_layer_count": 35,
   179	        "target_layer": 4,
   180	        "target": "X^4=t^4*z^4",
   181	    }
   182	

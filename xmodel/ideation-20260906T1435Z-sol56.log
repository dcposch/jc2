    81	def make_band(side: str, degree: int, height: int, layer: int) -> Band:
    82	    source_i_min = max(0, ceil_div(layer, 5))
    83	    source_i_max = (degree + layer) // 6
    84	    if source_i_max < source_i_min:
    85	        raise AssertionError(f"empty {side} band {layer}")
    86	    source_j = tuple(
    87	        5 * source_i - layer
    88	        for source_i in range(source_i_min, source_i_max + 1)
    89	    )
    90	    t_exponent_min = max(layer, ceil_div(17 * layer - height, 12))
    91	    jet_order = t_exponent_min - layer
    92	    if jet_order > len(source_j):
    93	        raise AssertionError(f"terminal edge kills {side} band {layer}")
    94	    jet_rows = [
    95	        [comb(source_power, order) for source_power in source_j]
    96	        for order in range(jet_order)
    97	    ]
    98	    jet_rank = rational_rank(jet_rows)
    99	    if jet_rank != jet_order:
   100	        raise AssertionError(f"jet matrix lost rank on {side} band {layer}")
   101	    active_exponents: list[int] = []
   102	    for order in range(jet_order, max(source_j) + 1):
   103	        row = [comb(source_power, order) for source_power in source_j]
   104	        if rational_rank(jet_rows + [row]) > jet_rank:
   105	            active_exponents.append(layer + order)
   106	    expected_dimension = len(source_j) - jet_order
   107	    if expected_dimension <= 0:
   108	        raise AssertionError(f"unexpected zero-dimensional {side} band {layer}")
   109	    if active_exponents != list(
   110	        range(t_exponent_min, layer + max(source_j) + 1)
   111	    ):
   112	        raise AssertionError(f"noninterval coefficient support on {side} band {layer}")
   113	    return Band(
   114	        side=side,
   115	        degree=degree,
   116	        terminal_height=height,
   117	        layer=layer,
   118	        source_i_min=source_i_min,
   119	        source_i_max=source_i_max,
   120	        source_j=source_j,
   121	        jet_vanishing_order=jet_order,
   122	        dimension=expected_dimension,
   123	        t_exponent_min=t_exponent_min,
   124	        t_exponent_max=layer + max(source_j),
   125	        active_t_exponents=tuple(active_exponents),
   126	    )

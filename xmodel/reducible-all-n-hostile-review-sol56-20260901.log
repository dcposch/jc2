from functools import lru_cache
from collections import defaultdict

def parts(set_items):
    # unlabeled set partitions of indices, canonical restricted growth strings
    n=len(set_items)
    if n==0: return
    a=[0]*n
    def rec(i,mx):
        if i==n:
            blocks=[[] for _ in range(mx+1)]
            for j,b in enumerate(a): blocks[b].append(set_items[j])
            yield blocks
            return
        for b in range(mx+2):
            a[i]=b
            yield from rec(i+1,max(mx,b))
    a[0]=0
    yield from rec(1,0)

def nontrivial_multisets(budget,min_key=(2,0)):
    # sorted tuples (mu,k), total cost <= budget; nonempty
    types=[(mu,k) for mu in range(2,budget+1) for k in range(budget+1) if mu+k<=budget]
    types.sort()
    def rec(rem,start,cur):
        if cur: yield tuple(cur)
        for j in range(start,len(types)):
            t=types[j]; c=sum(t)
            if c>rem: continue
            cur.append(t); yield from rec(rem-c,j,cur); cur.pop()
    yield from rec(budget,0,[])

def canon_blocks(blocks):
    return tuple(sorted(tuple(sorted(bl)) for bl in blocks))

def cls_of(profile):
    br=[]
    for bl in profile:
        nts=[x for x in bl if x[0]>1]
        if nts:
            mus=tuple(sorted(x[0] for x in nts))
            kk=sum(x[1] for x in nts)
            br.append((mus,kk))
    return tuple(sorted(br))

def fmt(cl):
    return ' + '.join(''.join(map(str,mus))+(f'"'^({k})'"' if k else '') for mus,k in cl)

for N in range(4,9):
    B=N-1
    profiles=set()
    for nts in nontrivial_multisets(B-1):
        gamma=sum(mu+k for mu,k in nts)
        T=B-gamma
        if T<1: continue
        items=list(nts)+[(1,0)]*T
        for blocks in parts(items):
            if len(blocks)<2: continue
            cp=canon_blocks(blocks)
            # all carriers assigned; gates
            brbl=[bl for bl in cp if any(mu>1 for mu,k in bl)]
            b=len(brbl)
            ok=True
            for bl in cp:
                W=sum(mu for mu,k in bl)
                corrfree=all(k==0 for mu,k in bl)
                if corrfree and 2*W>N: ok=False
            if b==1:
                W=sum(mu for mu,k in brbl[0])
                if 2*W>N: ok=False
            if ok: profiles.add(cp)
    by=defaultdict(set)
    for p in profiles: by[cls_of(p)].add(p)
    print('N',N,'profiles',len(profiles),'classes',len(by))
    for cl,ps in sorted(by.items()): print(' ',fmt(cl),len(ps))

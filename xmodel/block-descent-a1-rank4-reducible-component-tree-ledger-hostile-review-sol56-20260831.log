   236	--mutate-allow-h-two-finite-t31     accept h=2 with e(T31)>=0
   237	--mutate-apply-one-node-to-T2       apply ONE-NODE to m=2
   238	--mutate-drop-overlapping-screen    treat pair-aligned T2 as generating S4

        if i <= t:
            spaces[i] = [one]
        elif i <= 2 * t:
            spaces[i] = [one, A]
        elif i <= 3 * t:
            spaces[i] = [one, A, B]
        else:
            assert i == e
            spaces[i] = [one, gamma, A, B, z]
    return spaces


def build(t=3, gauged=False):
    if not isinstance(t, int) or t < 1:
        raise ValueError("t must be a positive integer")
    e, q = 3 * t + 1, 2 * t + 1
    b1, b2, b3, b4 = bs = sp.symbols("b1:5")

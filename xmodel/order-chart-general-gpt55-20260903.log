  err="box/orderchart-20260903/logs/${stem}.err"
  tlog="box/orderchart-20260903/logs/${stem}.time"
  /usr/bin/time -v -o "$tlog" timeout --kill-after=10s 1200s Singular --cpus=1 --threads=1 --flint-threads=1 -q --no-rc "$script" > "$out" 2> "$err"

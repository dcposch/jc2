+ROOT = Path(__file__).resolve().parents[2]
+OUT = Path(__file__).resolve().parent
+INPUTS = Path("/tmp/jc2-lane.YtvJBb/inputs")
+RECEIPT = ROOT / "xmodel/order-chart-general-gpt55-20260903.run.v2"
+PRIMES = (32003, 32009, 32027)

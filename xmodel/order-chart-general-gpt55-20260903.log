The corrected native equation counts are smaller as expected. The delta1-zero row now fails the sanity gate (`deg_x J0=2<k=4`), so any unit ideal there is a degenerate-chart obstruction rather than a promoted row kill; I’ll still record the bounded CAS result.
exec
/bin/bash -lc 'set +e
mkdir -p box/orderchart-20260903/logs
scripts=(
  box/orderchart-20260903/systems/16_12_13_3_k1_part_1_Q_std.sing
  box/orderchart-20260903/systems/28_20_25_3_k1_part_1_Q_std.sing
  box/orderchart-20260903/systems/33_22_30_8_k1_part_3_Q_std.sing
  box/orderchart-20260903/systems/33_22_30_8_k1_part_2_1_Q_std.sing
  box/orderchart-20260903/systems/45_30_42_11_k1_part_4_Q_std.sing
  box/orderchart-20260903/systems/45_30_42_11_k1_part_3_1_Q_std.sing
  box/orderchart-20260903/systems/45_30_42_11_k1_part_2_2_Q_std.sing
  box/orderchart-20260903/systems/15_10_11_3_k2_part_2_Q_std.sing
  box/orderchart-20260903/systems/15_10_11_3_k2_part_1_1_Q_std.sing
  box/orderchart-20260903/systems/21_14_18_5_k1_part_2_Q_std.sing
  box/orderchart-20260903/systems/21_14_18_5_k1_part_1_1_Q_std.sing
)
for script in "${scripts[@]}"; do
  stem=$(basename "$script" .sing)
  out="box/orderchart-20260903/logs/${stem}.out"
  err="box/orderchart-20260903/logs/${stem}.err"
  tlog="box/orderchart-20260903/logs/${stem}.time"
  /usr/bin/time -v -o "$tlog" timeout --kill-after=10s 1200s Singular --cpus=1 --threads=1 --flint-threads=1 -q --no-rc "$script" > "$out" 2> "$err"
  code=$?
  verdict=$(rg -o '"'MAIN_SATURATED_EMPTY|MAIN_NONTRIVIAL|CONTROL_[A-Z_]+FAIL' \""'$out" "$err" 2>/dev/null | tr '"'\\n' ';' )
  printf '%s exit=%s %s\\n' \""'$stem" "$code" "$verdict"
  if [ "$code" -eq 124 ] || [ "$code" -eq 137 ]; then
    break
  fi
done' in /home/ubuntu/jc2
diff --git a/box/orderchart-20260903/order_chart.py b/box/orderchart-20260903/order_chart.py

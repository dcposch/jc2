+                    "tmpLower = (%d)*(%s)*(diff((%s),x)*diff(h,y)-diff((%s),y)*diff(h,x))"
+                    "+(%d)*(%s)*(diff(h,x)*diff((%s),y)-diff(h,y)*diff((%s),x));"
+                    % (s, bb, aa, aa, r, aa, bb, bb)

+def read_native_rows(path: Path) -> List[dict]:
+    rows = []
+    with path.open(encoding="utf-8") as handle:
+        header = next(handle, None)
+        if header is None:
+            return rows
+        for line in handle:
+            line = line.rstrip("\n")
+            if not line:
+                continue
+            src, hpow, xp, yp, expr = line.split("|", 4)
+            rows.append({
+                "source_index": int(src),
+                "h_power": int(hpow),
+                "monomial": [int(xp), int(yp)],
+                "expr": expr,
+            })
+    return rows

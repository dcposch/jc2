import sympy as sp
from math import gcd
cases=[(16,12,13,3,1),(28,20,25,3,1),(33,22,30,8,1),(45,30,42,11,1),(15,10,11,3,2),(21,14,18,5,1),(25,15,21,2,2),(21,14,15,6,4)]
for n,m,M,V,k in cases:
 K=gcd(n,m); u=K-V; e=n//K; q=m//K; R=n-M-1; Pi=e+q
 from fractions import Fraction as F
 d2=F(-(k+1),R)
 d1=F((k+1)*(Pi*u-R), R*(Pi*V-1))
 bu=V*d1+u*d2
 print((n,m,M,V,k),'K,u,e,q,R,Pi',K,u,e,q,R,Pi,'delta',d2,d1,'B',bu,'common?', bu)
PY" in /home/ubuntu/jc2

    low_poly = batch.sum_h_terms(low_terms, h, expand=True).subs(sample)
    high_poly = batch.sum_h_terms(high_terms, h, expand=True).subs(sample)
    direct = sp.expand(batch.jac(low_poly, high_poly, x, y))

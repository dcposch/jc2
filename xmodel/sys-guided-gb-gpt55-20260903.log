print("EMPTY_CONTROL_NF1"); reduce(1,SE);
ideal PointControl=c-1,Zc*c-1;
ideal SP=std(PointControl);
print("POINT_CONTROL_DIM"); dim(SP);
print("POINT_CONTROL_NF1"); reduce(1,SP);
quit;


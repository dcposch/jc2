   423	def matrix_rank(matrix, p):
   424	    if not matrix:
   425	        return 0
   426	    work = [list(map(lambda x: x % p, row)) for row in matrix]
   427	    nr, nc = len(work), len(work[0])
   428	    rank = 0
   429	    for col in range(nc):
   430	        pivot = next((i for i in range(rank, nr) if work[i][col]), None)
   431	        if pivot is None:
   432	            continue
   433	        work[rank], work[pivot] = work[pivot], work[rank]
   434	        inv = pow(work[rank][col], p - 2, p)
   435	        work[rank] = [x * inv % p for x in work[rank]]
   436	        for i in range(nr):
   437	            if i != rank and work[i][col]:
   438	                scale = work[i][col]
   439	                work[i] = [(x - scale * y) % p
   440	                           for x, y in zip(work[i], work[rank])]
   441	        rank += 1
   442	        if rank == nr:
   443	            break
   444	    return rank

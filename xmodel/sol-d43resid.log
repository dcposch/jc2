    blob = json.dumps({"base_zc": point["zc_hash"],
                       "rung_tails": sorted(
                           ("%s_%d" % (f, 32 + r), int(v))
                           for f in FAMS
                           for r, v in point["tails"][f].items())},
                      sort_keys=True)
    point["zc_hash"] = hashlib.sha256(blob.encode()).hexdigest()

   467	def affine_numeric(rows, selected, lower_assignment, p):
   468	    """Evaluate lower variables and split rows as A*selected+b."""
   469	    selected = tuple(sorted(selected))
   470	    col = {name: i for i, name in enumerate(selected)}
   471	    A = [[0] * len(selected) for _ in rows]
   472	    b = [0] * len(rows)
   473	    for ri, row in enumerate(rows):
   474	        for mono, coeff in row.items():
   475	            hits = [name for name in mono if name in col]
   476	            if len(hits) > 1:
   477	                return None
   478	            value = coeff
   479	            skipped = False
   480	            for name in mono:
   481	                if name in col:
   482	                    if skipped:
   483	                        return None
   484	                    skipped = True
   485	                else:
   486	                    value = value * lower_assignment[name] % p
   487	            if hits:
   488	                A[ri][col[hits[0]]] = (A[ri][col[hits[0]]] + value) % p
   489	            else:
   490	                b[ri] = (b[ri] + value) % p
   491	    return A, b

   555	def split_affine_groups(groups, selected):
   556	    """Grouped checkpoint analogue of d43_family2.split_affine."""
   557	    selected = set(selected)
   558	    coeffs = {name: {} for name in selected}
   559	    for deep, basepoly in groups.items():
   560	        hits = [name for name in deep if name in selected]
   561	        if not hits:
   562	            continue
   563	        assert len(hits) == 1 and deep.count(hits[0]) == 1, \
   564	            ("nonaffine rung occurrence", hits, deep)
   565	        name = hits[0]
   566	        rest = list(deep)
   567	        rest.remove(name)
   568	        rest = tuple(rest)
   569	        target = coeffs[name]
   570	        for pk, coeff in basepoly.items():
   571	            key = (pk, rest)
   572	            target[key] = coeff
   573	    return coeffs

   412	def eval_named_poly(poly, names, values, p):
   413	    total = 0
   414	    for mono, coeff in poly.items():
   415	        term = coeff
   416	        for name, power in zip(names, mono):
   417	            if power:
   418	                term = term * pow(values[name], power, p) % p
   419	        total = (total + term) % p
   420	    return total

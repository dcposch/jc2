   625	def eval_group_row(groups, base_values, cell_values, p, t2x, unpack):
   626	    """Specialize one checkpoint row to a D25 cell point exactly."""
   627	    base_cache = {}
   628	    out = {}
   629	    for deep, basepoly in groups.items():
   630	        base_value = 0
   631	        for pk, coeff in basepoly.items():
   632	            if pk not in base_cache:
   633	                value = 1
   634	                for name, power in zip(base_values, unpack(pk)):
   635	                    if power:
   636	                        value = value * pow(name, power, p) % p
   637	                base_cache[pk] = value
   638	            base_value = (base_value + coeff * base_cache[pk]) % p
   639	        if not base_value or "uf30" in deep:
   640	            continue
   641	        external = []
   642	        value = base_value
   643	        for semantic in deep:
   644	            name = t2x.get(semantic, semantic)
   645	            if name in cell_values:
   646	                value = value * cell_values[name] % p
   647	            else:
   648	                external.append(name)
   649	        key = tuple(sorted(external))
   650	        out[key] = (out.get(key, 0) + value) % p
   651	        if not out[key]:
   652	            del out[key]
   653	    return out

   402	def eval_free_poly(poly, values, p):
   403	    total = 0
   404	    for mono, coeff in poly.items():
   405	        term = coeff
   406	        for value, power in zip(values, mono):
   407	            term = term * pow(value, power, p) % p
   408	        total = (total + term) % p
   409	    return total

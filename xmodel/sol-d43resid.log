   575	
   576	def proportional_dict(left, right, p):
   577	    if not right:
   578	        return 0
   579	    if not left or set(left) != set(right):
   580	        return None
   581	    key = next(iter(left))
   582	    scale = right[key] * pow(left[key], p - 2, p) % p
   583	    if any(right[k] != value * scale % p for k, value in left.items()):
   584	        return None
   585	    return scale

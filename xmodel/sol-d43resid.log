   961	        structure_hash.update(b",\n")
   962	    rows_path = os.path.splitext(out_path)[0] + "_rows.pkl"
   963	    with open(rows_path, "wb") as fh:
   964	        pickle.dump({"prime": p, "fiber": "a00pp", "W1": W1, "W2": W2,
   965	                     "free": dict(zip(FREE, free_values)), "rows": compat,
   966	                     "rung_sizes": [6, 6, 5, 6, 6, 6, 6, 6, 5]},
   967	                    fh, protocol=4)
   968	    report = {
   969	        "status": "INTERNAL / UNREVIEWED", "prime": p, "fiber": "a00pp",
   970	        "method": "D43 rows already NF mod G23; exact D25 cell substitution",
   971	        "cell": {"W1": W1, "W2": W2,

    # final replay: bands <= 42 all zero
    E = _build_E(point, p, Z)
    Vv = E.V.astype(np.int64)
    resid = sorted({int(n) for n in range(V43._S) if Vv[:30, n].any()})
    assert not resid, ("prolongation replay: bands nonzero", resid)

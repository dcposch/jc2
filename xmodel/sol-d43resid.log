   828	def quickshot(root, ckdir, p, free_values, out_path):
   829	    """Point-specialized NF quickshot used to locate the exact affine tail."""
   830	    sys.path.insert(0, root)
   831	    import d25_reduce as DR
   832	    import d43_family2 as F
   833	    replay_path = os.path.join(root, "d25_certificate_replay.json")
   834	    record = json.load(open(replay_path))["parked_fibers"][str(p)]["a00pp"]
   835	    W1 = int(record["derived_witness"]["W1"])
   836	    W2 = int(record["derived_witness"]["W2"])
   837	    parked = os.path.join(root, "d25fam_p%d_a00pp.ms" % p)
   838	    cell = build_cell_map(parked, replay_path, W1, W2)
   839	    free_values = tuple(x % p for x in free_values)
   840	    cell_values = {name: value for name, value in zip(FREE, free_values)}
   841	    cell_values.update(cell["fixed"])

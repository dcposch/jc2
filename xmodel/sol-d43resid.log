    low = sorted({int(n) for n in range(26) if Vv[:30, n].any()})
    assert not low, ("bands below 26 nonzero at the D25 completion",
                     low)
    assert not Gg[:30, :26, :][:, :, cidx].any(), \
        "an undetermined column occurs below band 26 (level cap)"

def analyze(p, upto, trials=3000):
 rows=pickle.load(open(f'cases/d43_nf_quickshot_p{p}_rows.pkl','rb'))['rows'][:upto]
 vv=sorted({x for r in rows for m in r for x in m})
 loops=set();nb={x:set() for x in vv}
 for r in rows:
  for m in r:
   c=collections.Counter(m);loops.update(x for x,n in c.items() if n>1)
   for a,b in itertools.combinations(set(m),2):nb[a].add(b);nb[b].add(a)
 elig=[x for x in vv if x not in loops]
 rng=random.Random(p*1000+upto)
 ass={x:rng.randrange(1,p) for x in vv}
 # coefficient col for any single var
 cols={}
 for x in elig:
  col=[]
  for row in rows:
   z=0
   for mono,c in row.items():
    if x in mono:
     assert mono.count(x)==1
     q=c
     for y in mono:
      if y"'!=x:q=q*ass[y]%p
     z=(z+q)%p
   col.append(z)
  cols[x]=col
 best=(0,[])
 deg={x:len(nb[x]&set(elig)) for x in elig}
 for t in range(trials):
  # diversity of orders: prioritize sparse conflict and random; rank gain mandatory
  cand=list(elig);rng.shuffle(cand)
  cand.sort(key=lambda x:(deg[x]+rng.random()*((t%7)+1)))
  S=[];blocked=set();M=[];rank=0
  while True:
   options=[]
   for x in cand:
    if x in blocked or x in S:continue
    nr=matrix_rank(M+[cols[x]],p)
    if nr>rank:
     options.append(x)
   if not options:break
   if t%3==0:
    x=min(options,key=lambda z:(len((nb[z]&set(elig))-blocked),rng.random()))
   else:x=rng.choice(options[:max(1,min(len(options),10))])
   S.append(x);blocked.add(x);blocked.update(nb[x]);M.append(cols[x]);rank+=1
   if rank==len(rows):break
  if rank>best[0]:
   best=(rank,S);print('"'p',p,'rows',upto,'trial',t,'BEST rank',rank,'n',len(S),S,flush=True)
  if rank==len(rows):break
 return best
for p in (105337,105673):
 for upto in (6,12,17,23,29,35):
  b=analyze(p,upto,2000)
  print('FINAL',p,upto,b)

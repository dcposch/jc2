   142	def left_kernel_const(C, p):
   143	    R = len(C)
   144	    Cc = np.array(C, dtype=np.int64) % p
   145	    M = np.concatenate([Cc, np.eye(R, dtype=np.int64)], axis=1)
   146	    r = 0
   147	    for c in range(Cc.shape[1]):
   148	        piv = next((i for i in range(r, R) if M[i][c]), None)
   149	        if piv is None:
   150	            continue
   151	        M[[r, piv]] = M[[piv, r]]
   152	        M[r] = M[r] * pow(int(M[r][c]), p - 2, p) % p
   153	        nz = np.nonzero(M[:, c])[0]
   154	        nz = nz[nz != r]
   155	        if len(nz):
   156	            M[nz] = (M[nz] - np.outer(M[nz, c], M[r])) % p
   157	        r += 1
   158	    return M[r:, Cc.shape[1]:].tolist(), r

   538	def emit_external_ms(path, variables, rows, p):
   539	    """Emit a small expanded .ms system from tuple-of-name monomials."""
   540	    with open(path, "w") as fh:
   541	        fh.write(", ".join(variables) + "\n%d\n" % p)
   542	        lines = []
   543	        for row in rows:
   544	            terms = []
   545	            for mono, coeff in sorted(row.items(), key=lambda x: (len(x[0]), x[0])):
   546	                powers = []
   547	                for name, group in itertools.groupby(mono):
   548	                    power = sum(1 for _ in group)
   549	                    powers.append(name if power == 1 else "%s^%d" % (name, power))
   550	                terms.append(str(coeff) + ("*" + "*".join(powers) if powers else ""))
   551	            lines.append("+".join(terms) if terms else "0")
   552	        fh.write(",\n".join(lines) + "\n")

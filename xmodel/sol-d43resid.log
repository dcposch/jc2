   843	        cell_values[name] = eval_free_poly(poly, free_values, p)
   844	    assert set(DR.GBVARS) <= set(cell_values)
   845	    base_values = [cell_values[name] for name in DR.GBVARS]
   846	
   847	    compat = []
   848	    rung_reports = {}
   849	    for k in range(26, 43, 2):
   850	        path = os.path.join(ckdir, "d43red_p%d_a00pp_band%d.pkl" % (p, k))
   851	        with open(path, "rb") as fh:
   852	            bank = pickle.load(fh)
   853	        grouped = {h: groups for (h, _s), groups in bank["rows"].items()}
   854	        hs, ynames, rows, C, L, rank = rung_kernel(grouped, k, p)
   855	        evaluated = [eval_group_row(row, base_values, cell_values, p,
   856	                                    F.T2X, DR.unpack) for row in rows]
   857	        rung_compat = []
   858	        for vector in L:
   859	            result = {}
   860	            for scale, row in zip(vector, evaluated):
   861	                poly_add_scaled(result, row, scale, p)
   862	            # The rung variables were killed symbolically by L; make that a
   863	            # second, representation-independent gate after specialization.
   864	            mapped_y = {F.T2X.get(x, x) for x in ynames}
   865	            assert not any(any(name in mapped_y for name in mono)
   866	                           for mono in result)
   867	            rung_compat.append(result)
   868	        compat.extend(rung_compat)
   869	        rung_reports[str(k)] = {
   870	            "rows": len(rows), "rank_C": rank, "n_compat": len(L),
   871	            "terms_after_cell_specialization": [len(x) for x in rung_compat],
   872	            "max_external_degree": [max(map(len, x), default=0)
   873	                                    for x in rung_compat]
   874	        }
   875	
   876	    assert len(compat) == 52
   877	    variables = sorted({name for row in compat for mono in row for name in mono})
   878	    x2tail = dict(F.X2T)
   879	    affine_profiles = []
   880	    exact_factorization = None
   881	    rng = random.Random((p << 17) ^ sum(free_values) ^ 0xD43)
   882	    for threshold in range(43, 75):
   883	        selected = {name for name in variables
   884	                    if (deep_level(name, x2tail) or -1) >= threshold}
   885	        if not selected:
   886	            continue
   887	        affine = all(sum(name in selected for name in mono) <= 1
   888	                     for row in compat for mono in row)
   889	        profile = {"threshold": threshold, "n_selected": len(selected),
   890	                   "affine": affine}
   891	        if affine:
   892	            lower = [name for name in variables if name not in selected]
   893	            ranks, augmented = [], []
   894	            for trial in range(4):
   895	                assignment = {name: (0 if trial == 0 else rng.randrange(p))
   896	                              for name in lower}
   897	                A, b = affine_numeric(compat, selected, assignment, p)
   898	                ranks.append(matrix_rank(A, p))
   899	                augmented.append(matrix_rank([row + [rhs]
   900	                                              for row, rhs in zip(A, b)], p))
   901	            profile.update({"rank_A": ranks, "rank_augmented": augmented,
   902	                            "selected": sorted(selected)})
   903	            if threshold == 53:
   904	                selected_order, columns, constants = affine_split_rows(
   905	                    compat, selected)
   906	                factored, failure = cdiag_factor(columns, p)
   907	                factor_report = {"threshold": 53,
   908	                                 "n_selected": len(selected_order),
   909	                                 "factorization": "FAIL" if failure else "PASS"}
   910	                if failure:
   911	                    factor_report["failure"] = failure
   912	                else:
   913	                    C, factors = factored
   914	                    L, rank_C = rref_left_kernel(C, p)
   915	                    residuals = []
   916	                    for vector in L:
   917	                        residual = {}
   918	                        for scale, const in zip(vector, constants):
   919	                            poly_add_scaled(residual, const, scale, p)

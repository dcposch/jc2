   516	def cdiag_factor(columns, p):
   517	    """Test every polynomial column as C_col times one scalar polynomial."""
   518	    Ccols = []
   519	    factors = []
   520	    for name in sorted(columns):
   521	        column = columns[name]
   522	        first = next((i for i, value in enumerate(column) if value), None)
   523	        assert first is not None, ("zero affine column", name)
   524	        scales = []
   525	        for value in column:
   526	            scale = proportional_dict(column[first], value, p)
   527	            if scale is None:
   528	                return None, {"variable": name, "row": len(scales),
   529	                              "reason": "not scalar-proportional"}
   530	            scales.append(scale)
   531	        Ccols.append(scales)
   532	        factors.append(column[first])
   533	    C = [[Ccols[j][i] for j in range(len(Ccols))]
   534	         for i in range(len(Ccols[0]))]
   535	    return (C, factors), None

   983	        json.dump(report, fh, indent=1, sort_keys=True)
   984	        fh.write("\n")
   985	    print("D43 NF QUICKSHOT p=%d: PASS; 52 rows; %d external vars -> %s"
   986	          % (p, len(variables), out_path))
   987	    return report

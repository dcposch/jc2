   538	def emit_external_ms(path, variables, rows, p):
   539	    """Emit a small expanded .ms system from tuple-of-name monomials."""
   540	    with open(path, "w") as fh:
   541	        fh.write(", ".join(variables) + "\n%d\n" % p)
   542	        lines = []
   543	        for row in rows:

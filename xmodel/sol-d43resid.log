   656	def monomial_times(poly, mono, coeff, p):
   657	    out = {}
   658	    for key, value in poly.items():
   659	        shifted = tuple(x + y for x, y in zip(key, mono))
   660	        scalar = value * coeff % p
   661	        if scalar:
   662	            out[shifted] = scalar
   663	    return out

   494	def affine_split_rows(rows, selected):
   495	    """Exact split rows = A(selected)+b over the lower-variable ring."""
   496	    selected = tuple(sorted(selected))
   497	    selected_set = set(selected)
   498	    columns = {name: [{} for _ in rows] for name in selected}
   499	    constants = [{} for _ in rows]
   500	    for ri, row in enumerate(rows):
   501	        for mono, coeff in row.items():
   502	            hits = [name for name in mono if name in selected_set]
   503	            assert len(hits) <= 1, (ri, mono, hits)
   504	            if not hits:
   505	                constants[ri][mono] = coeff
   506	                continue
   507	            name = hits[0]
   508	            rest = list(mono)
   509	            rest.remove(name)
   510	            rest = tuple(rest)
   511	            target = columns[name][ri]
   512	            target[rest] = coeff
   513	    return selected, columns, constants

   772	def zero_tail(root, ckdir, p, out_prefix):
   773	    """Build the exact all-new-tails-zero D43 slice on all 16 D25 cells."""
   774	    sys.path.insert(0, root)
   775	    import d25_reduce as DR
   776	    import d43_family2 as F
   777	    replay_path = os.path.join(root, "d25_certificate_replay.json")
   778	    replay = json.load(open(replay_path))["parked_fibers"][str(p)]["a00pp"]
   779	    hint = replay["derived_witness"]
   780	    roots1 = fourth_roots(p, int(replay["W1^4"]), int(hint["W1"]))
   781	    roots2 = fourth_roots(p, int(replay["W2^4"]), int(hint["W2"]))
   782	    parked = os.path.join(root, "d25fam_p%d_a00pp.ms" % p)
   783	    reports = []
   784	    for ci, (W1, W2) in enumerate(itertools.product(roots1, roots2)):
   785	        cell = build_cell_map(parked, replay_path, W1, W2)
   786	        reducer = CellReducer(cell, DR.GBVARS, DR.unpack, p)
   787	        compat = []
   788	        for k in range(26, 43, 2):
   789	            path = os.path.join(ckdir,
   790	                                "d43red_p%d_a00pp_band%d.pkl" % (p, k))
   791	            with open(path, "rb") as fh:
   792	                bank = pickle.load(fh)
   793	            grouped = {h: groups for (h, _s), groups in bank["rows"].items()}
   794	            _hs, _ynames, rows, _C, L, _rank = rung_kernel(grouped, k, p)
   795	            reduced = [zero_tail_group_row(row, reducer, F.T2X)
   796	                       for row in rows]
   797	            for vector in L:
   798	                result = {}
   799	                for scale, row in zip(vector, reduced):
   800	                    poly_add_scaled(result, row, scale, p)
   801	                compat.append(result)
   802	        assert len(compat) == 52
   803	        nonzero = [row for row in compat if row]
   804	        ms_path = "%s_cell%02d.ms" % (out_prefix, ci)
   805	        emit_free_ms(ms_path, nonzero, p)
   806	        reports.append({
   807	            "cell": ci, "W1": W1, "W2": W2,
   808	            "n_rows": len(compat), "n_nonzero_rows": len(nonzero),
   809	            "terms": [len(row) for row in nonzero],
   810	            "degrees": [max((sum(m) for m in row), default=0)
   811	                        for row in nonzero],
   812	            "ms": ms_path, "base_monomial_cache": len(reducer.base_cache)
   813	        })
   814	        print("zero-tail p=%d cell=%02d W=(%d,%d): %d/%d nonzero -> %s"
   815	              % (p, ci, W1, W2, len(nonzero), len(compat), ms_path),
   816	              flush=True)
   817	    report_path = out_prefix + "_report.json"
   818	    with open(report_path, "w") as fh:
   819	        json.dump({"status": "INTERNAL / UNREVIEWED", "prime": p,
   820	                   "slice": "all 144 non-D25 D43 coordinates = 0",
   821	                   "cells": reports}, fh, indent=1, sort_keys=True)
   822	        fh.write("\n")
   823	    print("D43 ZERO-TAIL EXACT NF p=%d: PASS 16/16 -> %s" %
   824	          (p, report_path))
   825	    return reports

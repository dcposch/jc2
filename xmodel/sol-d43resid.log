  1045	def main():
  1046	    parser = argparse.ArgumentParser()
  1047	    parser.add_argument("--root", default=os.path.dirname(os.path.abspath(__file__)))
  1048	    parser.add_argument("--selftest", action="store_true")
  1049	    parser.add_argument("--quickshot", action="store_true")
  1050	    parser.add_argument("--zero-tail", action="store_true")
  1051	    parser.add_argument("--prime", type=int, choices=PRIMES)
  1052	    parser.add_argument("--ckdir")
  1053	    parser.add_argument("--free", choices=("zero", "sequence"), default="sequence")
  1054	    parser.add_argument("--out")
  1055	    args = parser.parse_args()
  1056	    if args.selftest:
  1057	        selftest(args.root, args.out)
  1058	        return
  1059	    if args.quickshot:
  1060	        if not args.prime or not args.ckdir or not args.out:
  1061	            parser.error("--quickshot requires --prime, --ckdir, and --out")
  1062	        values = ([0] * len(FREE) if args.free == "zero"
  1063	                  else list(range(1, len(FREE) + 1)))
  1064	        quickshot(args.root, args.ckdir, args.prime, values, args.out)
  1065	        return


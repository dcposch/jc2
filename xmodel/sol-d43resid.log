import pickle,sys,collections,itertools,random,time

def invbasis_add(basis,v,p):
 w=list(v)
 for k in sorted(basis):
  if w[k]:
   a=w[k]
   row=basis[k]
   w=[(x-a*y)%p for x,y in zip(w,row)]
 piv=next((i for i,x in enumerate(w) if x),None)
 if piv is None:return None
 iv=pow(w[piv],p-2,p);w=[x*iv%p for x in w]
 # no need eliminate new pivot in old basis for independence
 nb=dict(basis);nb[piv]=w
 return nb

def prep(p,upto):
 rows=pickle.load(open(f'cases/d43_nf_quickshot_p{p}_rows.pkl','rb'))['rows'][:upto]
 vv=sorted({x for r in rows for m in r for x in m}); loops=set();nb={x:set() for x in vv}
 for r in rows:
  for m in r:
   c=collections.Counter(m);loops.update(x for x,n in c.items() if n>1)
   for a,b in itertools.combinations(set(m),2):nb[a].add(b);nb[b].add(a)
 elig=[x for x in vv if x not in loops];eset=set(elig)
 rng=random.Random(999*p+upto);ass={x:rng.randrange(1,p) for x in vv}
 cols={}
 for x in elig:
  col=[]
  for row in rows:
   z=0
   for mono,c in row.items():
    if x in mono:
     q=c
     for y in mono:
      if y"'!=x:q=q*ass[y]%p
     z=(z+q)%p
   col.append(z)
  cols[x]=col
 return rows,elig,nb,cols,rng

def run(p,upto,trials):
 rows,elig,nb,cols,rng=prep(p,upto);eset=set(elig);deg={x:len(nb[x]&eset) for x in elig};best=(0,[])
 t0=time.time()
 for t in range(trials):
  # randomized scores, favor low conflict sometimes and deliberately high conflict sometimes
  temp=(t%13+1)/5
  order=sorted(elig,key=lambda x:(deg[x]*temp+rng.random()*30))
  if t%5==1: rng.shuffle(order)
  if t%5==2: order=sorted(elig,key=lambda x:(-sum(bool(z) for z in cols[x])+rng.random()*20))
  S=[];blocked=set();basis={}
  for x in order:
   if x in blocked:continue
   nbasis=invbasis_add(basis,cols[x],p)
   if nbasis is None:continue
   basis=nbasis;S.append(x);blocked.add(x);blocked.update(nb[x])
   if len(basis)==len(rows):break
  if len(basis)>best[0]:
   best=(len(basis),S);print('"'BEST',p,upto,t,best[0],best[1],flush=True)
  if best[0]==len(rows):break
 print('FINAL',p,upto,best[0],best[1],'trials',t+1,'sec',time.time()-t0)
 return best
for p in (105337,105673):
 run(p,35,200000)

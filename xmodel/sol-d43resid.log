   666	class CellReducer:
   667	    """Exact substitution normal form on one certified D25 A^14 cell."""
   668	
   669	    def __init__(self, cell, gbvars, unpack, p):
   670	        self.cell = cell
   671	        self.gbvars = tuple(gbvars)
   672	        self.unpack = unpack
   673	        self.p = p
   674	        self.free_pos = {name: i for i, name in enumerate(FREE)}
   675	        self.base_cache = {}
   676	        self.pattern_cache = {}
   677	        self.power_cache = {}
   678	
   679	    def power(self, name, exponent):
   680	        key = name, exponent
   681	        if key not in self.power_cache:
   682	            self.power_cache[key] = poly_pow(
   683	                self.cell["maps"][name], exponent, self.p, len(FREE))
   684	        return self.power_cache[key]
   685	
   686	    def base_monomial(self, packed):
   687	        if packed in self.base_cache:
   688	            return self.base_cache[packed]
   689	        exps = self.unpack(packed)
   690	        free_exp = [0] * len(FREE)
   691	        coeff = 1
   692	        dependencies = []
   693	        for name, exponent in zip(self.gbvars, exps):
   694	            if not exponent:
   695	                continue
   696	            if name in self.cell["fixed"]:
   697	                coeff = coeff * pow(self.cell["fixed"][name], exponent,
   698	                                    self.p) % self.p
   699	            elif name in self.free_pos:
   700	                free_exp[self.free_pos[name]] += exponent
   701	            else:
   702	                assert name in DEP_BASE, (name, packed)
   703	                dependencies.append((name, exponent))
   704	        result = {tuple(free_exp): coeff}
   705	        for name, exponent in dependencies:
   706	            result = poly_mul(result, self.power(name, exponent), self.p)
   707	        self.base_cache[packed] = result
   708	        return result
   709	
   710	    def cell_pattern(self, names):
   711	        names = tuple(sorted(names))
   712	        if names in self.pattern_cache:
   713	            return self.pattern_cache[names]
   714	        counts = {name: names.count(name) for name in set(names)}
   715	        free_exp = [0] * len(FREE)
   716	        result = {(0,) * len(FREE): 1}
   717	        for name, exponent in counts.items():
   718	            if name in self.free_pos:
   719	                free_exp[self.free_pos[name]] += exponent
   720	            elif name in DEP_LIFT:
   721	                result = poly_mul(result, self.power(name, exponent), self.p)
   722	            else:
   723	                raise AssertionError(("not a D25 cell variable", name))
   724	        result = monomial_times(result, tuple(free_exp), 1, self.p)
   725	        self.pattern_cache[names] = result
   726	        return result
   727	
   728	    def base_polynomial(self, poly):
   729	        result = {}
   730	        for packed, coeff in poly.items():
   731	            poly_add_scaled(result, self.base_monomial(packed), coeff, self.p)
   732	        return result

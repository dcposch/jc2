   735	def zero_tail_group_row(groups, reducer, t2x):
   736	    """Exact row NF after setting every non-D25 deep coordinate to zero."""
   737	    result = {}
   738	    cell_names = set(FREE + DEP)
   739	    for deep, basepoly in groups.items():
   740	        if "uf30" in deep:
   741	            continue
   742	        mapped = tuple(t2x.get(name, name) for name in deep)
   743	        if any(name not in cell_names for name in mapped):
   744	            continue
   745	        base_nf = reducer.base_polynomial(basepoly)
   746	        if not base_nf:
   747	            continue
   748	        pattern_nf = reducer.cell_pattern(mapped)
   749	        poly_add_scaled(result, poly_mul(base_nf, pattern_nf, reducer.p),
   750	                        1, reducer.p)
   751	    return result

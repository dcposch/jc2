   449	    if semantic in ("Xf_alpha", "Xg_beta"):
   450	        return 42
   451	    if "_" not in semantic:
   452	        return None
   453	    suffix = semantic.rsplit("_", 1)[1]
   454	    return int(suffix) if suffix.isdigit() else None

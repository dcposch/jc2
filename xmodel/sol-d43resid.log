   941	                    neg_factored, _neg_failure = cdiag_factor(neg_columns, p)
   942	                    assert neg_factored is None
   943	                    factor_report.update({
   944	                        "rank_C": rank_C, "left_kernel_dimension": len(L),
   945	                        "factor_terms": [len(x) for x in factors],
   946	                        "residual_terms": [len(x) for x in residuals],
   947	                        "residual_degrees": [max(map(len, x), default=0)
   948	                                             for x in residuals],
   949	                        "n_lower_variables": len(lower_variables),
   950	                        "lower_variables": lower_variables,
   951	                        "residual_ms": residual_path,
   952	                        "negative_control": "injected monomial rejected"
   953	                    })
   954	                exact_factorization = factor_report
   955	            affine_profiles.append(profile)
   956	
   957	    structure_hash = hashlib.sha256()
   958	    for row in compat:
   959	        for mono in sorted(row):

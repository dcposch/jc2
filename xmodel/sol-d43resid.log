   126	def proportional(pa, pb, p):
   127	    # Decide pb = lambda * pa.  The zero polynomial is 0 * pa.
   128	    if not pb:
   129	        return 0
   130	    if not pa:
   131	        return None
   132	    if set(pa) != set(pb):
   133	        return None
   134	    m0 = next(iter(pa))
   135	    lam = pb[m0] * pow(pa[m0], p - 2, p) % p
   136	    for m, c in pa.items():
   137	        if pb[m] != c * lam % p:
   138	            return None
   139	    return lam

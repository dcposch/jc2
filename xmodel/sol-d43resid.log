   161	def analyze(ckdir, p, lab, parked_ms, out_prefix, run_gb=True):
   162	    t0 = time.time()
   163	    SM = pow(7, 12, p) * pow(pow(2, 6, p), p - 2, p) % p
   164	    GM = (-pow(7, 18, p)) * pow(pow(2, 9, p), p - 2, p) % p
   165	    compat = []
   166	    report = {"prime": p, "fiber": lab, "rungs": {}}
   167	    for k in range(26, 43, 2):
   168	        rows = load_band(ckdir, p, lab, k)
   169	        hs = rung_rows_idx(k)
   170	        assert sorted(rows) == sorted(hs) or set(rows) <= set(hs), \
   171	            ("band %d rows outside selected census" % k, sorted(rows))
   172	        ynames = rung_tails(k)
   173	        rrows = []
   174	        for h in hs:
   175	            poly = dict(rows.get(h, {}))
   176	            if k == 42 and h in P4P1:
   177	                base = 42 * SM * GM % p * (P4P1[h] % p) % p
   178	                za = (DR.pack([0] * NV), ("Xf_alpha",))
   179	                zb = (DR.pack([0] * NV), ("Xg_beta",))
   180	                poly[za] = (poly.get(za, 0) + 3 * base) % p
   181	                poly[zb] = (poly.get(zb, 0) - 2 * base) % p
   182	            rrows.append(poly)
   183	        ycols = ynames + (["Xf_alpha", "Xg_beta"] if k == 42 else [])
   184	        consts, Amat = [], []
   185	        for poly in rrows:
   186	            const, coeffs = split_affine(poly, ycols, p)
   187	            consts.append(const)
   188	            Amat.append([coeffs[nm] for nm in ycols])
   189	        ncol = len(ycols)
   190	        Ccols, dinfo = [], []
   191	        for j in range(ncol):
   192	            col = [Amat[i][j] for i in range(len(hs))]
   193	            i0 = next((i for i in range(len(col)) if col[i]), None)
   194	            if i0 is None:

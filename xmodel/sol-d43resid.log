   990	def selftest(root, out_path=None):
   991	    replay_path = os.path.join(root, "d25_certificate_replay.json")
   992	    replay = json.load(open(replay_path))
   993	    report = {"status": "INTERNAL / UNREVIEWED", "gate": "PASS",
   994	              "components": []}
   995	    for p in PRIMES:
   996	        parked = os.path.join(root, "d25fam_p%d_a00pp.ms" % p)
   997	        parked_names, parked_prime, parked_rows = parse_ms(parked)
   998	        assert parked_prime == p and len(parked_rows) == 34
   999	        record = replay["parked_fibers"][str(p)]["a00pp"]
  1000	        hint = record["derived_witness"]
  1001	        roots1 = fourth_roots(p, int(record["W1^4"]), int(hint["W1"]))
  1002	        roots2 = fourth_roots(p, int(record["W2^4"]), int(hint["W2"]))
  1003	        for W1, W2 in itertools.product(roots1, roots2):
  1004	            cell = build_cell_map(parked, replay_path, W1, W2)
  1005	            # Negative control on the maps themselves: a nonzero perturbation
  1006	            # of any solved coordinate must violate its defining graph row.
  1007	            rng = random.Random((p << 32) ^ (W1 << 16) ^ W2)
  1008	            free_values = [rng.randrange(p) for _ in FREE]
  1009	            dep_values = {name: eval_free_poly(poly, free_values, p)
  1010	                          for name, poly in cell["maps"].items()}
  1011	            point = dict(zip(FREE, free_values))
  1012	            point.update(cell["fixed"])
  1013	            point.update(dep_values)
  1014	            assert all(eval_named_poly(row, parked_names, point, p) == 0
  1015	                       for row in parked_rows)
  1016	            bad_name = DEP[(W1 + W2) % len(DEP)]
  1017	            before = dep_values[bad_name]
  1018	            dep_values[bad_name] = (before + 1) % p
  1019	            assert dep_values[bad_name] != before
  1020	            bad_point = dict(point)
  1021	            bad_point[bad_name] = dep_values[bad_name]
  1022	            nbad = sum(eval_named_poly(row, parked_names, bad_point, p) != 0
  1023	                       for row in parked_rows)
  1024	            assert nbad > 0, ("negative control escaped", p, W1, W2,
  1025	                              bad_name)
  1026	            report["components"].append({
  1027	                "prime": p, "W1": W1, "W2": W2,
  1028	                "n_maps": len(cell["maps"]),
  1029	                "map_terms": {x: len(cell["maps"][x]) for x in DEP},
  1030	                "pivot_order": [x["var"] for x in cell["transcript"]],
  1031	                "parked_rows_zero_as_polynomials": 34,
  1032	                "negative_control": {"perturbed": bad_name,
  1033	                                     "nonzero_parked_rows": nbad}
  1034	            })
  1035	    assert len(report["components"]) == 32
  1036	    if out_path:
  1037	        with open(out_path, "w") as fh:
  1038	            json.dump(report, fh, indent=1, sort_keys=True)
  1039	            fh.write("\n")
  1040	    print("D43 NF CERTIFICATE SELFTEST: PASS (32/32 prime-cells; "
  1041	          "34/34 parked identities each)")
  1042	    return report

   109	def split_affine(poly, names, p):
   110	    nset = set(names)
   111	    const = {}
   112	    coeffs = {nm: {} for nm in names}
   113	    for (pk, deep), c in poly.items():
   114	        hit = [nm for nm in deep if nm in nset]
   115	        if not hit:
   116	            const[(pk, deep)] = c
   117	            continue
   118	        assert len(hit) == 1, ("nonaffine rung occurrence", hit)
   119	        nm = hit[0]
   120	        d2 = list(deep)
   121	        d2.remove(nm)
   122	        coeffs[nm][(pk, tuple(d2))] = c
   123	    return const, coeffs

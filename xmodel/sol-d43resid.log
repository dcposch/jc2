_ATLAS = {}


def fiber_env(p, lab):
    """(A1r, A2r, h1r, h2r) of the fiber from the banked d23 atlas;
    legitimacy re-verified against the chart radicals."""
    if p not in _ATLAS:
        _ATLAS[p] = json.load(open(
            os.path.join(HERE, "d23_atlas_p%d.json" % p)))
    f = _ATLAS[p]["fibers"][lab]["fiber"]

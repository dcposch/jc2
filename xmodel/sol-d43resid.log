   588	def rung_kernel(group_rows, k, p):
   589	    """Recompute the exact constant C and left kernel for one rung."""
   590	    import d43_family2 as F
   591	    import d25_reduce as DR
   592	    hs = F.rung_rows_idx(k)
   593	    ynames = F.rung_tails(k) + (["Xf_alpha", "Xg_beta"] if k == 42 else [])
   594	    rows = []
   595	    zero_pk = DR.pack([0] * DR.NV)
   596	    SM = pow(7, 12, p) * pow(pow(2, 6, p), p - 2, p) % p
   597	    GM = (-pow(7, 18, p)) * pow(pow(2, 9, p), p - 2, p) % p
   598	    for h in hs:
   599	        groups = {deep: dict(base) for deep, base in group_rows.get(h, {}).items()}
   600	        if k == 42 and h in F.P4P1:
   601	            base = 42 * SM * GM % p * (F.P4P1[h] % p) % p
   602	            groups[("Xf_alpha",)] = {zero_pk: 3 * base % p}
   603	            groups[("Xg_beta",)] = {zero_pk: -2 * base % p}
   604	        rows.append(groups)
   605	    matrices = [split_affine_groups(row, ynames) for row in rows]
   606	    columns = []
   607	    for name in ynames:
   608	        column = [matrix[name] for matrix in matrices]
   609	        first = next((i for i, value in enumerate(column) if value), None)
   610	        if first is None:
   611	            columns.append([0] * len(rows))
   612	            continue
   613	        scales = []
   614	        for value in column:
   615	            scale = proportional_dict(column[first], value, p)
   616	            assert scale is not None, ("C-diag failure", k, name)
   617	            scales.append(scale)
   618	        columns.append(scales)
   619	    C = [[columns[j][i] for j in range(len(columns))]
   620	         for i in range(len(rows))]
   621	    L, rank = rref_left_kernel(C, p)
   622	    return hs, ynames, rows, C, L, rank
   623	

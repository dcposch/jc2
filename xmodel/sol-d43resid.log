   110	
   111	def substitute(poly, var_index, replacement, p):
   112	    """Substitute one variable by ``replacement`` in the same sparse ring."""
   113	    if not poly:
   114	        return {}
   115	    nvars = len(next(iter(poly)))
   116	    powers = {0: {(0,) * nvars: 1}, 1: replacement}
   117	    out = {}
   118	    for mono, coeff in poly.items():
   119	        power = mono[var_index]
   120	        if power not in powers:
   121	            powers[power] = poly_pow(replacement, power, p, nvars)
   122	        rest = list(mono)
   123	        rest[var_index] = 0
   124	        rest = tuple(rest)
   125	        shifted = {tuple(x + y for x, y in zip(rest, mr)): cr
   126	                   for mr, cr in powers[power].items()}
   127	        poly_add_scaled(out, shifted, coeff, p)
   128	    return out
   129	
   130	
   131	def rref_left_kernel(matrix, p):
   132	    """Return a canonical basis of the left kernel of a numeric matrix."""
   133	    nr = len(matrix)
   134	    nc = len(matrix[0]) if nr else 0
   135	    aug = [list(row) + [1 if i == j else 0 for j in range(nr)]
   136	           for i, row in enumerate(matrix)]
   137	    rank = 0
   138	    for col in range(nc):
   139	        pivot = next((i for i in range(rank, nr) if aug[i][col] % p), None)
   140	        if pivot is None:
   141	            continue
   142	        aug[rank], aug[pivot] = aug[pivot], aug[rank]
   143	        inv = pow(aug[rank][col] % p, p - 2, p)
   144	        aug[rank] = [x * inv % p for x in aug[rank]]
   145	        for i in range(nr):
   146	            if i != rank and aug[i][col] % p:
   147	                scale = aug[i][col] % p
   148	                aug[i] = [(x - scale * y) % p
   149	                          for x, y in zip(aug[i], aug[rank])]
   150	        rank += 1
   151	    return [row[nc:] for row in aug[rank:]], rank
   152	
   153	
   154	def fourth_roots(p, value, hint):
   155	    assert pow(hint, 4, p) == value % p
   156	    root4 = None
   157	    candidate = 2
   158	    while root4 is None:
   159	        z = pow(candidate, (p - 1) // 4, p)
   160	        if z != 1 and pow(z, 2, p) == p - 1:
   161	            root4 = z
   162	        candidate += 1
   163	    roots = sorted({hint * pow(root4, j, p) % p for j in range(4)})
   164	    assert len(roots) == 4
   165	    assert all(pow(x, 4, p) == value % p for x in roots)
   166	    return roots
   167	
   168	
   169	def specialize_fixed(rows, names, fixed, p):
   170	    """Substitute W/uW constants but retain the original exponent width."""
   171	    pos = {x: i for i, x in enumerate(names)}
   172	    out = []
   173	    for poly in rows:
   174	        result = {}
   175	        for mono, coeff in poly.items():
   176	            key = list(mono)
   177	            value = coeff
   178	            for name, scalar in fixed.items():
   179	                i = pos[name]
   180	                value = value * pow(scalar, key[i], p) % p
   181	                key[i] = 0
   182	            key = tuple(key)
   183	            result[key] = (result.get(key, 0) + value) % p
   184	            if not result[key]:
   185	                del result[key]
   186	        out.append(result)
   187	    return out

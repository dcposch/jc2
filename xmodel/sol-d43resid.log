   190	def numeric_linear_coeff(poly, index, p):
   191	    """Coefficient of a variable known to occur as a bare linear term."""
   192	    value = 0
   193	    for mono, coeff in poly.items():
   194	        if mono[index]:
   195	            assert mono[index] == 1
   196	            assert sum(mono) == 1, (index, mono)
   197	            value = (value + coeff) % p
   198	    return value
   199	
   200	
   201	def only_unknowns(poly, positions):
   202	    return {i for i in positions if any(mono[i] for mono in poly)}
   203	
   204	
   205	def solve_single(poly, index, p):
   206	    """Solve a constant-unit affine pivot row for one variable."""
   207	    coeff = 0
   208	    const = {}
   209	    for mono, value in poly.items():
   210	        power = mono[index]
   211	        if power:
   212	            assert power == 1
   213	            rest = list(mono)
   214	            rest[index] = 0
   215	            assert not any(rest), (index, mono, "nonconstant pivot")
   216	            coeff = (coeff + value) % p
   217	        else:
   218	            const[mono] = value
   219	    assert coeff
   220	    scale = -pow(coeff, p - 2, p)
   221	    return {mono: value * scale % p for mono, value in const.items()}
   222	
   223	
   224	def split_constant_affine(poly, indices, p):
   225	    """Split a row as sum(coeff[j]*x_j)+const with scalar coeffs."""
   226	    coeffs = [0] * len(indices)
   227	    const = {}
   228	    iset = set(indices)
   229	    for mono, value in poly.items():
   230	        hit = [j for j, index in enumerate(indices) if mono[index]]
   231	        if not hit:
   232	            const[mono] = value
   233	            continue
   234	        if len(hit) != 1 or mono[indices[hit[0]]] != 1 or sum(mono) != 1:
   235	            return None
   236	        coeffs[hit[0]] = (coeffs[hit[0]] + value) % p
   237	    return coeffs, const
   238	
   239	
   240	def build_cell_map(parked_path, replay_path, W1, W2):
   241	    """Rebuild one A^14 component's ten triangular substitutions."""
   242	    names, p, raw_rows = parse_ms(parked_path)
   243	    assert len(raw_rows) == 34
   244	    assert set(names) == set(FREE + DEP + FIXED)
   245	    pos = {x: i for i, x in enumerate(names)}
   246	    fixed = {"W1": W1 % p, "W2": W2 % p,
   247	             "uW1": pow(W1, p - 2, p), "uW2": pow(W2, p - 2, p)}
   248	    rows = specialize_fixed(raw_rows, names, fixed, p)
   249	
   250	    # The last five pristine rows are affine in the two lift pivots.
   251	    residual = rows[29:34]
   252	    lift_matrix = [[numeric_linear_coeff(row, pos[x], p)
   253	                    for x in DEP_LIFT] for row in residual]
   254	    left_kernel, rank = rref_left_kernel(lift_matrix, p)
   255	    assert rank == 2 and len(left_kernel) == 3
   256	    compat = []
   257	    for vector in left_kernel:
   258	        row = {}
   259	        for scale, source in zip(vector, residual):
   260	            poly_add_scaled(row, source, scale, p)
   261	        assert not only_unknowns(row, (pos["x33"], pos["x38"]))
   262	        compat.append(row)
   263	
   264	    work = list(rows) + compat
   265	    unknown = {pos[x] for x in DEP}
   266	    maps = {}
   267	    transcript = []
   268	
   269	    # Unit-linear single pivots solve the eight base variables.  The order is
   270	    # discovered from the pristine rows plus exact Schur compatibilities.
   271	    while len(unknown) > 2:
   272	        choice = None
   273	        for ri, row in enumerate(work):
   274	            live = only_unknowns(row, unknown)
   275	            if len(live) != 1:
   276	                continue
   277	            index = next(iter(live))
   278	            try:
   279	                replacement = solve_single(row, index, p)
   280	            except AssertionError:
   281	                continue
   282	            choice = ri, index, replacement
   283	            break
   284	        if choice is not None:
   285	            ri, index, replacement = choice
   286	            maps[names[index]] = replacement
   287	            transcript.append({"var": names[index], "row": ri,
   288	                               "terms": len(replacement)})
   289	            work = [substitute(row, index, replacement, p) for row in work]
   290	            unknown.remove(index)
   291	            continue
   292	
   293	        # The sparse parked presentation has one genuine 2x2 base pivot
   294	        # (x47,x52 on the current a00pp files).  Accept it only when both
   295	        # rows are scalar-affine in exactly the selected pair.
   296	        base_unknown = [i for i in unknown if names[i] in DEP_BASE]
   297	        pair_choice = None
   298	        for ia, ib in itertools.combinations(base_unknown, 2):
   299	            candidates = []
   300	            for ri, row in enumerate(work):
   301	                if not only_unknowns(row, unknown) <= {ia, ib}:
   302	                    continue
   303	                split = split_constant_affine(row, (ia, ib), p)
   304	                if split is not None and any(split[0]):
   305	                    candidates.append((ri, split[0], split[1]))
   306	            for left, right in itertools.combinations(candidates, 2):
   307	                a, b = left[1]
   308	                d, e = right[1]
   309	                det = (a * e - b * d) % p
   310	                if det:
   311	                    pair_choice = ia, ib, left, right, det
   312	                    break
   313	            if pair_choice:
   314	                break
   315	        assert pair_choice is not None, ("triangular base pass stuck",
   316	                                         [names[i] for i in sorted(unknown)],
   317	                                         transcript)
   318	        ia, ib, left, right, det = pair_choice
   319	        invdet = pow(det, p - 2, p)
   320	        a, b = left[1]
   321	        d, e = right[1]
   322	        sola, solb = {}, {}
   323	        poly_add_scaled(sola, right[2], b * invdet, p)
   324	        poly_add_scaled(sola, left[2], -e * invdet, p)
   325	        poly_add_scaled(solb, left[2], d * invdet, p)
   326	        poly_add_scaled(solb, right[2], -a * invdet, p)
   327	        maps[names[ia]], maps[names[ib]] = sola, solb
   328	        transcript.extend([
   329	            {"var": names[ia], "rows": [left[0], right[0]],
   330	             "terms": len(sola)},
   331	            {"var": names[ib], "rows": [left[0], right[0]],
   332	             "terms": len(solb)}])
   333	        work = [substitute(row, ia, sola, p) for row in work]
   334	        work = [substitute(row, ib, solb, p) for row in work]
   335	        unknown.remove(ia)
   336	        unknown.remove(ib)
   337	
   338	    assert {names[i] for i in unknown} == set(DEP_LIFT)
   339	    ia, ib = pos["x33"], pos["x38"]
   340	    affine = []
   341	    for ri, row in enumerate(work[:34]):
   342	        a = numeric_linear_coeff(row, ia, p)
   343	        b = numeric_linear_coeff(row, ib, p)
   344	        if a or b:
   345	            const = {m: c for m, c in row.items() if not m[ia] and not m[ib]}
   346	            affine.append((ri, a, b, const))
   347	    pair = None
   348	    for left, right in itertools.combinations(affine, 2):
   349	        det = (left[1] * right[2] - left[2] * right[1]) % p
   350	        if det:
   351	            pair = left, right, det
   352	            break
   353	    assert pair is not None
   354	    left, right, det = pair
   355	    invdet = pow(det, p - 2, p)
   356	    # a*x33+b*x38+r = d*x33+e*x38+s = 0
   357	    sol33 = {}
   358	    poly_add_scaled(sol33, right[3], left[2] * invdet, p)
   359	    poly_add_scaled(sol33, left[3], -right[2] * invdet, p)
   360	    sol38 = {}
   361	    poly_add_scaled(sol38, left[3], right[1] * invdet, p)
   362	    poly_add_scaled(sol38, right[3], -left[1] * invdet, p)
   363	    maps["x33"] = sol33
   364	    maps["x38"] = sol38
   365	    transcript.extend([{"var": "x33", "rows": [left[0], right[0]],
   366	                        "terms": len(sol33)},
   367	                       {"var": "x38", "rows": [left[0], right[0]],
   368	                        "terms": len(sol38)}])
   369	    work = [substitute(row, ia, sol33, p) for row in work]
   370	    work = [substitute(row, ib, sol38, p) for row in work]
   371	
   372	    # Fixed W roots put us on one factor of the certified product; all 34
   373	    # pristine generators must vanish identically in F_p[free_14].
   374	    failures = [(i, len(row)) for i, row in enumerate(work[:34]) if row]
   375	    assert not failures, failures
   376	
   377	    # Convert maps from the original 28-wide ring to the canonical free ring.
   378	    free_pos = {name: i for i, name in enumerate(FREE)}
   379	    compact = {}
   380	    for name, poly in maps.items():
   381	        result = {}
   382	        for mono, coeff in poly.items():
   383	            assert not any(mono[pos[x]] for x in DEP + FIXED)
   384	            exps = [0] * len(FREE)
   385	            for free_name, j in free_pos.items():
   386	                exps[j] = mono[pos[free_name]]
   387	            key = tuple(exps)
   388	            result[key] = (result.get(key, 0) + coeff) % p
   389	            if not result[key]:
   390	                del result[key]
   391	        compact[name] = result
   392	
   393	    replay = json.load(open(replay_path))["parked_fibers"][str(p)]["a00pp"]
   394	    assert pow(W1, 4, p) == int(replay["W1^4"])
   395	    assert pow(W2, 4, p) == int(replay["W2^4"])
   396	    return {"prime": p, "W1": W1, "W2": W2, "fixed": fixed,
   397	            "maps": compact, "transcript": transcript,
   398	            "lift_matrix": lift_matrix, "left_kernel": left_kernel,
   399	            "raw_names": names}
   400	

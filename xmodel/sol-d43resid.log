   754	def emit_free_ms(path, rows, p):
   755	    with open(path, "w") as fh:
   756	        fh.write(", ".join(FREE) + "\n%d\n" % p)
   757	        lines = []
   758	        for row in rows:
   759	            terms = []
   760	            for mono, coeff in sorted(row.items(), key=lambda x: (sum(x[0]), x[0])):
   761	                factors = []
   762	                for name, exponent in zip(FREE, mono):
   763	                    if exponent:
   764	                        factors.append(name if exponent == 1 else
   765	                                       "%s^%d" % (name, exponent))
   766	                terms.append(str(coeff) + ("*" + "*".join(factors)
   767	                                           if factors else ""))
   768	            lines.append("+".join(terms) if terms else "0")
   769	        fh.write(",\n".join(lines) + "\n")

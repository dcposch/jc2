+def page_controls() -> dict:
+    """Exact controls for the same direct consecutive-moment projection.
+
+    For g=x+y^k-c2 and H=tau (Jacobian -1), the page entries are
+    sum tau_i^(r+1)/g_y(tau_i).  The monic-root identity makes all

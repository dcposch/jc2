import sympy as sp
from math import gcd
x,y,z,A,B=sp.symbols('x y z A B')
print('Sympy', sp.__version__)
for k in range(1,5):
    e=2*k+1
    V=x*y**3-y
    P=x+V**e
    Q=V**2
    J=sp.factor(sp.diff(P,x)*sp.diff(Q,y)-sp.diff(P,y)*sp.diff(Q,x))
    cusp=A**2-B**e
    dA=sp.diff(cusp,A); dB=sp.diff(cusp,B)
    sing_gb=sp.groebner([cusp,dA,dB], A,B, order='lex')
    h=7-5*z**2-3*z**e
    face_gcd=sp.gcd(h, sp.diff(h,z))
    # sample finite count at target (7,1): v=+-1, x=7-v"'^e, cubic discrim
    discr=[]
    for vv in [1,-1]:
        xx=7-vv**e
        poly=xx*y**3-y-vv
        discr.append(sp.factor(sp.discriminant(poly,y)))
    pts=[(0,1),(1,0),(e,3),(0,3)]
    area2=0; bd=0
    for p,q in zip(pts, pts[1:]+pts[:1]):
        area2 += p[0]*q[1]-q[0]*p[1]
        bd += gcd(abs(q[0]-p[0]), abs(q[1]-p[1]))
    interior=(abs(area2)-bd+2)//2
    print({'"'k':k,'e':e,'N':6,'n':e,'delta_aff':k,'jac':str(J),'sing_gb':str(sing_gb),'top_face_gcd':str(face_gcd),'sample_discriminants':discr,'newton_area2':abs(area2),'boundary':bd,'gL':interior})

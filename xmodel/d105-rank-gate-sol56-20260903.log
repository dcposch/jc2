+cd /home/ubuntu/jc2
+python3 /tmp/jc2-lane.syVtTr/inputs/globalinterp.py controls
+python3 /tmp/jc2-lane.syVtTr/inputs/globalinterp.py selftest
+
+tmp_json=$(mktemp)
+python3 /tmp/jc2-lane.syVtTr/inputs/globalinterp.py example > "$tmp_json"

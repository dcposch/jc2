def sealed_checks(gi) -> dict[str, Any]:
    controls = gi.run_controls(verbose=False)
    selftest = gi._selftest(verbose=False)
    return {
        "controls": {"checks": controls.count, "failures": len(controls.failures), "expected": "40/0"},

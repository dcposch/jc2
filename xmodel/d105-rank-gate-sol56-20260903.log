                self.registry.get(f"degree_witness_{degree}", 0, "degree_witness")
                for degree in range(self.x_degree_caps[self.m] + 1)
            ]
            self._add(
                "degree_exact",
                "degree_exact",
                0,
                sum(
                    witnesses[degree] * apoly[(self.m, degree)]
                    for degree in range(self.x_degree_caps[self.m] + 1)

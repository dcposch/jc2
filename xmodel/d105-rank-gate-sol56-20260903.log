def requested_k(raw: dict[str, Any]) -> list[int]:
    values = []
    for N in raw["N"]:
        k = Fraction(N, 1) / raw["q"]
        if k.denominator != 1:
            raise AssertionError(f"nonintegral k at N={N}")
        values.append(int(k))
    return values



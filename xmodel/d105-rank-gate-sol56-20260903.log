   352	def cubic_tame_mutation() -> dict[str, Any]:
   353	    """Mutate one independent, Galois-covariant cubic root-tail coefficient."""
   354	    z, yvar, tame = sp.symbols("z y_mut a")
   355	    omega = (-1 + sp.sqrt(3) * sp.I) / 2
   356	    original = [-omega ** (-j) / z for j in range(3)]
   357	    # One independent q=1 coefficient; covariance forces its two conjugates.
   358	    mutated = [original[j] + tame * omega**j * z for j in range(3)]
   359	    covariance = [
   360	        sp.simplify(mutated[j].subs(z, omega * z) - mutated[(j + 1) % 3]) == 0
   361	        for j in range(3)
   362	    ]
   363	    fibre_polynomial = sp.simplify(sp.expand(sp.prod(yvar - root for root in mutated)))
   364	    expected_fibre = yvar**3 + 3 * tame * yvar + z**-3 - tame**3 * z**3

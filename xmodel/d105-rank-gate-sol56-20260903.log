def cubic_tame_mutation() -> dict[str, Any]:
    """Mutate one branch of the exact cubic shear and locate NO-RESIDUE failure."""
    z, tame = sp.symbols("z a")
    roots = [
        -sp.Integer(1),
        (1 + sp.sqrt(3) * sp.I) / 2,
        (1 - sp.sqrt(3) * sp.I) / 2,
    ]
    original = [root / z for root in roots]
    mutated = copy.copy(original)
    mutated[0] += tame

    def residues(branches: list[sp.Expr]) -> list[sp.Expr]:
        answer = []
        for i in range(3):
            denominator = sp.prod(branches[i] - branches[j] for j in range(3) if j != i)
            inverse = sp.series(1 / denominator, z, 0, 4).removeO().expand()
            answer.append(sp.factor(sp.radsimp(inverse.coeff(z, 3))))
        return answer

    before = residues(original)
    after = residues(mutated)
    sat_witness = sp.symbols("sat_witness")
    saturation_basis = sp.groebner(
        [after[0], sat_witness * tame - 1],
        tame,
        sat_witness,
        order="lex",
        domain=sp.QQ,
    )
    basis_strings = [sp.sstr(polynomial.as_expr()) for polynomial in saturation_basis.polys]
    return {
        "control": "(f,g)=(y,x+y^3)",
        "uniformizer": "x=z^-3, so t=x^-1=z^3",
        "mutation": "tau_0 -> tau_0 + a*z^0; tau_1,tau_2 unchanged",
        "branches_after_mutation": [sp.sstr(value) for value in mutated],
        "no_residue_test": "[z^3](1/D_i)=0",
        "failure_order_z": 3,
        "failure_order_t": "1",
        "coefficients_before": [qstr(value) for value in before],
        "coefficients_after": [qstr(value) for value in after],
        "saturation_open_condition": "a != 0",
        "rabinowitsch_saturation": {
            "ring": "QQ[a,sat_witness], lex(a,sat_witness)",
            "ideal": ["a/3", "sat_witness*a-1"],
            "groebner_basis": basis_strings,
            "empty": basis_strings == ["1"],
        },
        "fails_on_open_set": all(value != 0 for value in after),
        "status": "EXPECTED-FAIL",
        "qualification": "This is a vacuity guard on the branch-series input, not a new polynomial map.",
    }


def bad_g_negative_control() -> dict[str, Any]:
    z = sp.symbols("z")
    tau_plus = z**-1 * sp.sqrt(1 + z)
    W_plus = sp.series(1 / (2 * tau_plus), z, 0, 4).removeO().expand()
    residue_plus = sp.factor(W_plus.coeff(z, 1))
    residue_minus = -residue_plus
    return {
        "g": "y^2-x^2-x",
        "uniformizer": "x=z^-1=t^-1",
        "no_residue_coefficients": [qstr(residue_plus), qstr(residue_minus)],
        "failure_order_z": 1,
        "failure_order_t": "1",
        "status": "EXPECTED-FAIL",
    }



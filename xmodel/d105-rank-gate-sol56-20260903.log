+```bash
+cd /home/ubuntu/jc2
+/usr/bin/time -f 'elapsed=%e maxrss_kb=%M exit=%x' \
+  python3 box/d105rank-drivers-20260903/probe_d105_wrapper.py \
+  > /tmp/d105-rank-gate.json
+sha256sum /tmp/d105-rank-gate.json

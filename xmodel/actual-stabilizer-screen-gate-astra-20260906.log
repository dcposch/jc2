   124	        P = integral(F(high[0] * self.d[j], self.d[j+1]))
   125	        Q = integral(F(high[0] * (self.n - self.M[j]), self.d[j+1]))
   126	        target_v = self.target[j-2]
   127	
   128	        def factor(v, zero, mark=False):

   130	                return None
   131	            major = v * (self.n - self.M[j]) > self.d[j]
   132	            if not major:
   133	                return dict(V=v, major=False) if not mark else None
   134	            danger2 = dangerous and (zero or
   135	                        (radius.denominator == 1 and radius <= 0))
   136	            child = self.solve(j-1, (v,) + high, self.next_L(L, radius, zero),
   137	                               danger2, mark)
   138	            return None if child is None else dict(V=v, major=True, child=child)
   139	
   140	        # A coin has mass v (one whole A-orbit), cost one orbit and two bits:
   141	        # some major exists; the distinguished source path is present.
   142	        nonzero = {}
   143	        for v in range(1, P // A + 1):
   144	            witness = factor(v, False)
   145	            if witness is None:
   146	                continue

   151	            zero = factor(b, True) if b else None
   152	            if b and zero is None:
   153	                continue
   154	            zero_marked = (factor(b, True, True)
   155	                           if selected and b == target_v else None)
   156	            zero_choices = [(zero, bool(zero and zero['major']))]
   157	            if zero_marked is not None:
   158	                zero_choices.append((zero_marked, 3))
   159	            slots = (Q - bool(b)) // A
   160	            mass = (P - b) // A
   161	            if slots < 0:
   162	                continue
   163	            for z_witness, initial in zero_choices:
   164	                dp = {(0, int(initial)): (0, ())}
   165	                for total in range(1, mass + 1):

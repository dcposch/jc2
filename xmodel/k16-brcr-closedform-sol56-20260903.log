    35	
    36	def modular_roots(t: int, prime: int) -> list[int]:
    37	    yy = sp.Symbol("yy")
    38	    poly = sp.Poly(h_polynomial(t, yy), yy, modulus=prime)
    39	    roots = sorted({int(root) % prime for root in range(prime)
    40	                    if int(poly.eval(root)) % prime == 0})
    41	    if len(roots) != 2:
    42	        raise ValueError(f"H_{t} has {len(roots)} distinct roots modulo {prime}")
    43	    return roots
    44	
    45	
    46	def split_roots(t: int) -> list[sp.Rational]:
    47	    quotient, remainder = divmod(t + 1, 3)
    48	    root = math.isqrt(quotient)
    49	    if remainder or root * root != quotient:
    50	        raise ValueError(f"t={t} is not of the form 3*s^2-1")
    51	    q = 2 * t + 1
    52	    return sorted({sp.Rational(t + 1 - root, 2 * q),
    53	                   sp.Rational(t + 1 + root, 2 * q)})
    54	
    55	
    56	def singular_rational(value: sp.Rational) -> str:
    57	    return f"({int(value.p)}/{int(value.q)})"

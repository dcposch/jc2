    i=$1; sub(/^charged_input_/,"",i); sub(/_sha256$/,"",i); hash[i]=$2; if (i>n) n=i
  }
  /^charged_input_[0-9]+_basename=/ {
    i=$1; sub(/^charged_input_/,"",i); sub(/_basename$/,"",i); base[i]=$2; if (i>n) n=i
  }

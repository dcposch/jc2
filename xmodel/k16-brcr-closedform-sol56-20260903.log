+\[
+ a_0=-{t(3t+1)\{(27t^3-30t^2+t-2)d+
+                    6t^3+13t^2-3t+2\}
+       \over12(2t+1)^2(3t-1)^2(3t+2)}.                                  \tag{1.5}

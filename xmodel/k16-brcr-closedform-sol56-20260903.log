    77	    if mode == "mod":
    78	        if prime is None or prime <= 2:
    79	            raise ValueError("--prime is required in modular mode")
    80	        value = modular_roots(t, prime)[branch]
    81	        lines = [f"ring R={prime},({','.join(variables)}),dp;",
    82	                 f"number yy={value};"]
    83	        return lines, f"F_{prime}, y={value}"
    84	    raise ValueError(mode)

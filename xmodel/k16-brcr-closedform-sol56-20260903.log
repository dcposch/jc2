    30	def h_polynomial(t: int, yy: sp.Symbol) -> sp.Expr:
    31	    q = 2 * t + 1
    32	    return sp.expand(12 * q * q * yy**2 - 12 * q * (t + 1) * yy
    33	                     + (t + 1) * (3 * t + 2))

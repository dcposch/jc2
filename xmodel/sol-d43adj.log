def load_band(ckdir, p, lab, k):
    path = os.path.join(ckdir, "d43red_p%d_%s_band%d.pkl" % (p, lab, k))
    with open(path, "rb") as fh:
        d = pickle.load(fh)
    rows = {}
    for (h, s), groups in d["rows"].items():
        poly = {}
        for deep, nf in groups.items():
            for pk, c in nf.items():
                poly[(pk, deep)] = c
        rows[h] = poly

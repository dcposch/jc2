                poly[za] = (poly.get(za, 0) + 3 * base) % p
                poly[zb] = (poly.get(zb, 0) - 2 * base) % p
            rrows.append(poly)
        ycols = ynames + (["Xf_alpha", "Xg_beta"] if k == 42 else [])
        consts, Amat = [], []
        for poly in rrows:
            const, coeffs = split_affine(poly, ycols, p)
            consts.append(const)

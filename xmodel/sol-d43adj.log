+| 19 | 95047 | 55161 | 9539 | 46556 |
+| 22 | 35469 | 2081 | 48746 | 61953 |
+| 25 | 30243 | 968 | 30997 | 101406 |
+| 28 | **0** | **0** | 14263 | 65837 |
+| **\(p=105673\)** ||||
+| 1  | 1 | 1 | 1 | 1 |
+| 4  | 75813 | 29841 | 90737 | 67751 |
+| 7  | 101337 | 74836 | 82002 | 76573 |
+| 10 | 51337 | 36657 | 81599 | 76814 |

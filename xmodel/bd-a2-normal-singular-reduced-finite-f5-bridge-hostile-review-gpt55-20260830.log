/bin/zsh -lc "python3 - <<'PY'
from fractions import Fraction
from itertools import product

def inv_solve(C,a):
    n=len(C)
    A=[[Fraction(C[i][j]) for j in range(n)]+[Fraction(a[i])] for i in range(n)]
    for col in range(n):
        piv=next(r for r in range(col,n) if A[r][col])
        A[col],A[piv]=A[piv],A[col]
        p=A[col][col]
        A[col]=[x/p for x in A[col]]
        for r in range(n):
            if r"'!=col and A[r][col]:
                f=A[r][col]
                A[r]=[A[r][c]-f*A[col][c] for c in range(n+1)]
    return [A[i][-1] for i in range(n)]

def cartan_A(r):
    C=[[0]*r for _ in range(r)]
    for i in range(r):
        C[i][i]=2
        if i: C[i][i-1]=-1
        if i<r-1: C[i][i+1]=-1
    return C

def cartan_D(r):
    C=[[0]*r for _ in range(r)]
    for i in range(r): C[i][i]=2
    for i in range(r-3):
        C[i][i+1]=C[i+1][i]=-1
    j=r-3
    C[j][r-2]=C[r-2][j]=-1
    C[j][r-1]=C[r-1][j]=-1
    return C

def vectors(n,total):
    if n==1:
        yield (total,); return
    for x in range(total+1):
        for rest in vectors(n-1,total-x):
            yield (x,)+rest

def canon_A(a):
    return min(a, tuple(reversed(a)))

def canon_D(a):
    # only spin swap; for D4 also permute three arms? print raw then coarse manually
    b=list(a); c=list(a)
    c[-2],c[-1]=c[-1],c[-2]
    return min(tuple(b),tuple(c))

for typ in ['"'A','D']:
  print(typ)
  rows=[]
  rs=range(1,9) if typ=='A' else range(4,10)
  for r in rs:
    C=cartan_A(r) if typ=='A' else cartan_D(r)
    seen=set()
    for a in vectors(r,3):
        h=inv_solve(C,a)
        if all(x.denominator==1 and x>0 for x in h):
            q=sum(Fraction(h[i])*a[i] for i in range(r))
            if q<=8:
                ca=canon_A(a) if typ=='A' else canon_D(a)
                if ca not in seen:
                    seen.add(ca)
                    rows.append((r,ca,int(q),tuple(int(x) for x in h)))
  for row in rows:
    print(row)

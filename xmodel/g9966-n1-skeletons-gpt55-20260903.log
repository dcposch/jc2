    Ks = SUPPORTED_K if args.command == "all" else (args.K,)
    if args.optimized and (args.command == "all" or Ks != (8,)):
        parser.error("--optimized currently requires --K 8 and build/run")
    outputs: list[dict[str, Any]] = []
    for K in Ks:

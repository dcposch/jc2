+
+
+def run_script(script: Path, timeout: int) -> dict[str, Any]:
+    env = os.environ.copy()
+    for key in (
+        "OMP_NUM_THREADS",
+        "OPENBLAS_NUM_THREADS",
+        "MKL_NUM_THREADS",
+        "NUMEXPR_NUM_THREADS",
+        "FLINT_NUM_THREADS",
+    ):
+        env[key] = "1"

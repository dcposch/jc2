   274	def h3_adic_derived() -> dict:
   275	    """h3-adic D2 bounds on F_j, G_j after the triangular chart expansion.
   276	
   277	    F = (h3^3 + C2 h3 + C3)^3 + A2 (h3^3 + C2 h3 + C3) + A3
   278	    G = (h3^3 + C2 h3 + C3)^2 + B1 (h3^3 + C2 h3 + C3) + B2

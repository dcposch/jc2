   397	def parse_singular_output(out: str):
   398	    def after(label):
   399	        lines = out.splitlines()
   400	        for i, line in enumerate(lines):
   401	            if line.strip() == label and i + 1 < len(lines):
   402	                return lines[i + 1].strip()
   403	        return None
   404	    if "MAIN_SATURATED_EMPTY" in out:
   405	        verdict = "SATURATED-EMPTY"
   406	    elif "MAIN_NONTRIVIAL" in out:
   407	        verdict = "SURVIVES"
   408	    else:
   409	        verdict = "ERROR"
   410	    return {
   411	        "verdict": verdict,
   412	        "basis_size": after("MAIN_DONE basis_size="),
   413	        "control_empty_pass": "CONTROL_EMPTY_PASS" in out,
   414	        "control_nonempty_pass": "CONTROL_NONEMPTY_PASS" in out,
   415	        "unsat_empty": None,
   416	        "unsat_nontrivial": None,
   417	        "unsat_size": None,
   418	    }

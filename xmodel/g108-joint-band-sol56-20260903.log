+        (args.output_dir / "death_certificate.json").write_text(
+            json.dumps(certificate, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+        )
+    print(payload, end="")
+
+
+if __name__ == "__main__":
+    main()

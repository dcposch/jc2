@dataclass(frozen=True)
class Row:
    src: str
    n: int
    m: int
    M2: int
    V2: int
    k: int
    tag: str = ""


ROWS: List[Row] = [
    Row("(64,48)", 16, 12, 13, 3, 1, "MOH-K16-t1"),

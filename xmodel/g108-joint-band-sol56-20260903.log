     1	#!/usr/bin/env python3
     2	"""D=108 principal-minor split classification.  Lane g108-minor-classification-opus5.
     3	
     4	Everything is derived from the skeleton (n,m,M,V) alone.  The (99,66) row is the
     5	CONTROL: the same code must reproduce {2 [2,1], 5/2 [1,1,1]} with Xu's printed
     6	q-vectors and Xu's printed (-mu_2,-mu_3) = (55,145).
     7	"""
     8	from fractions import Fraction as F
     9	from math import gcd

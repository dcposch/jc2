   354	def write_singular(path: str, row: Row, eqs: Sequence[sp.Expr], params: Sequence[sp.Symbol],
   355	                   T: sp.Symbol, char: int, meta: dict):
   356	    names = []
   357	    rename = {}
   358	    for sym in list(params) + [T]:
   359	        base = clean_name(str(sym))
   360	        if base[0].isdigit():
   361	            base = "v" + base
   362	        nm = base
   363	        i = 1
   364	        while nm in names:
   365	            i += 1
   366	            nm = "%s_%d" % (base, i)
   367	        names.append(nm)
   368	        rename[sym] = sp.Symbol(nm)
   369	    c_name = str(rename[params[-1]])
   370	    T_name = str(rename[T])
   371	    os.makedirs(os.path.dirname(path), exist_ok=True)
   372	    with open(path, "w") as fh:
   373	        fh.write("// row %s descended (%d,%d;%d;%d;k=%d)\n" %
   374	                 (row.src, row.n, row.m, row.M2, row.V2, row.k))
   375	        fh.write("// chart %s\n" % meta.get("chart", "?"))
   376	        fh.write("ring R=%s,(%s),dp;\n" % (char, ",".join(names)))
   377	        fh.write("option(redSB);\n")
   378	        fh.write('print("CONTROL_EMPTY_START");\n')
   379	        fh.write("ideal CE=%s,%s*%s-1;\n" % (c_name, T_name, c_name))
   380	        fh.write("ideal GE=std(CE);\n")
   381	        fh.write('if (reduce(1,GE)==0) { print("CONTROL_EMPTY_PASS"); } else { print("CONTROL_EMPTY_FAIL"); }\n')
   382	        fh.write('print("CONTROL_NONEMPTY_START");\n')
   383	        fh.write("ideal CN=%s-1,%s*%s-1;\n" % (c_name, T_name, c_name))
   384	        fh.write("ideal GN=std(CN);\n")
   385	        fh.write('if (reduce(1,GN)!=0) { print("CONTROL_NONEMPTY_PASS"); } else { print("CONTROL_NONEMPTY_FAIL"); }\n')
   386	        fh.write('print("MAIN_START equations=%d unknowns=%d char=%s");\n' %
   387	                 (len(eqs), len(params), char))
   388	        gens = [sstr(e.subs(rename)) for e in eqs] + ["%s*%s-1" % (T_name, c_name)]
   389	        fh.write("ideal I=%s;\n" % ",\n".join(gens))
   390	        fh.write("ideal G=std(I);\n")
   391	        fh.write('print("MAIN_DONE basis_size="); size(G);\n')
   392	        fh.write('if (reduce(1,G)==0) { print("MAIN_SATURATED_EMPTY"); } else { print("MAIN_NONTRIVIAL"); }\n')
   393	        fh.write("quit;\n")
   394	    return names

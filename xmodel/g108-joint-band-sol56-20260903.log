   197	def k16_flag_basis(row: Row, x, y):
   198	    C = shape_bundle(row.n, row.m, row.M2, row.V2, row.k)
   199	    if not (C["ok"] and C["K"] == 4 and C["u"] == 1 and C["V2"] == 3):
   200	        raise ValueError("not K16 u=1,V2=3")
   201	    b1, b2, b3, b4 = hpars = sp.symbols("b1:5")
   202	    z = y - x
   203	    B = sp.expand(y * z + b1 * y + b2)
   204	    A = sp.expand(y * B + b3)
   205	    h = sp.expand(y * A + b4)
   206	    e = C["eprime"]
   207	    bound_unit = C["V2"] * C["delta1"] + C["u"] * C["delta2"]
   208	    if bound_unit >= 0:
   209	        raise ValueError("K16 bound_unit is not negative")
   210	    cut_a = math.ceil(F(e, C["V2"]))
   211	    cut_b = math.ceil(F(2 * e, C["V2"]))
   212	    weights = [
   213	        (sp.Integer(1), F(0), "1"),
   214	        (A, cut_a * bound_unit, "A"),
   215	        (B, cut_b * bound_unit, "B"),
   216	        (z, e * bound_unit, "z"),
   217	        (x, e * bound_unit, "x"),
   218	    ]
   219	    return C, h, list(hpars), weights, bound_unit

+    d1_rank = 4
+    assert (ambient, d2_rank, ambient - d2_rank - d1_rank) == (628, 565, 59)
+    return {
+        "conventions": {
+            "K3": "t^9*h3(t^-1,w/t)",
+            "K2": "t^36*h2(t^-1,w/t)",
+            "major_coordinate": "z=w-1",
+            "D2": "t=s^4, z=pi*s^6; weight 4*r+6*q",
+            "D1": "s=e^2, t=e^8, z=e^12*(1+Pi*e)",
+            "top_K3": "z^7*(1+z)^2",
+            "top_K2": "z^28*(1+z)^8",
+            "D2_K2_face": "pi^12*(pi^2-1)^8",
+        },
+        "h3_D2": {

   421	def run_singular(path: str, timeout: int):
   422	    t0 = time.time()
   423	    try:
   424	        r = subprocess.run(["Singular", "-q", "--no-rc", path],
   425	                           capture_output=True, text=True, timeout=timeout)
   426	    except subprocess.TimeoutExpired as e:
   427	        return {
   428	            "verdict": "TIMEOUT",
   429	            "elapsed": round(time.time() - t0, 3),
   430	            "timeout": timeout,

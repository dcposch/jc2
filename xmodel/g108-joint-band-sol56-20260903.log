    33	def support(D: int, ycap: int) -> list[tuple[int, int]]:
    34	    """(r,q) with r >= 0, 0 <= q < ycap, r+q <= D."""
    35	    return [(r, q) for q in range(ycap) for r in range(D - q + 1)]
    36	

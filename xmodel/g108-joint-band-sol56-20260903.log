   154	def build_beta_ab(h, x, y):
   155	    p, q, r, s = sp.symbols("bp bq br bs")
   156	    h0 = sp.expand(h.subs(y, 0))
   157	    A = sp.expand(sp.together((h - h0) / y))
   158	    beta = sp.expand(p * A + q * y + r * x + s)
   159	    return beta, [p, q, r, s], A
   160	

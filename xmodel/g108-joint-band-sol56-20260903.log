    38	# Bound data for the four outer blocks.  D2_s is the strict vanishing
    39	# threshold on 3r+4q; D1_e is the strict vanishing threshold on e-power.
    40	# D2_s = 3*(D + bound_t), D1_e = 9*(D + bound_t).
    41	BLOCKS = {
    42	    "A2": {
    43	        "D": 65,
    44	        "ycap": 33,
    45	        "bound_t_D2": Fraction(-2),
    46	        "bound_t_D1": Fraction(-2, 9),
    47	        "thm12_j": 2,
    48	        "base": "h2",
    49	    },
    50	    "A3": {
    51	        "D": 98,
    52	        "ycap": 33,
    53	        "bound_t_D2": Fraction(-3),
    54	        "bound_t_D1": Fraction(-1, 3),
    55	        "thm12_j": 3,
    56	        "base": "h2",
    57	    },
    58	    "B1": {
    59	        "D": 32,
    60	        "ycap": 33,
    61	        "bound_t_D2": Fraction(-1),
    62	        "bound_t_D1": Fraction(-1, 9),
    63	        "thm12_j": 1,
    64	        "base": "h2",
    65	    },
    66	    "B2": {
    67	        "D": 65,
    68	        "ycap": 33,
    69	        "bound_t_D2": Fraction(-2),
    70	        "bound_t_D1": Fraction(-2, 9),
    71	        "thm12_j": 2,
    72	        "base": "h2",
    73	    },

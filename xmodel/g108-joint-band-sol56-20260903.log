   288	        1: "0",
   289	        2: "3*C2",
   290	        3: "3*C3",
   291	        4: "3*C2^2",
   292	        5: "6*C2*C3",
   293	        6: "3*C3^2 + C2^3 + A2",
   294	        7: "3*C2^2*C3",
   295	        8: "3*C2*C3^2 + A2*C2",
   296	        9: "C3^3 + A2*C3 + A3",

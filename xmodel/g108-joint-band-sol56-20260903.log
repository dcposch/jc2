+    h_equal = {p for p in h_all_lower if 4 * p[0] + 6 * p[1] == 42}
+    h_tail = {p for p in h_all_lower if 4 * p[0] + 6 * p[1] > 42}
+    assert (len(h_all_lower), len(h_below), len(h_equal), len(h_tail)) == (45, 36, 2, 7)
+    assert h_equal == {(3, 5), (6, 3)}

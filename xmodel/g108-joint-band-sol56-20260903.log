    21	def sha256(path: Path) -> str:
    22	    digest = hashlib.sha256()
    23	    with path.open("rb") as handle:
    24	        for block in iter(lambda: handle.read(1 << 20), b""):
    25	            digest.update(block)
    26	    return digest.hexdigest()

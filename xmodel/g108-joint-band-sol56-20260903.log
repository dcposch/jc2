   131	def d1_matrix(
   132	    remain: list[tuple[int, int]], ebound: int
   133	) -> tuple[list[tuple[int, int]], list[list[Fraction]]]:
   134	    """Rows (e, Pi-power j) with e < ebound; columns the D2-remaining (r,q)."""
   135	    slots: list[tuple[int, int]] = []
   136	    slot_index: dict[tuple[int, int], int] = {}
   137	    for r, q in remain:
   138	        base = 9 * r + 12 * q
   139	        for j in range(q + 1):
   140	            exponent = base + j
   141	            if exponent < ebound:
   142	                key = (exponent, j)
   143	                if key not in slot_index:
   144	                    slot_index[key] = len(slots)
   145	                    slots.append(key)
   146	    matrix = [[Fraction(0)] * len(remain) for _ in slots]
   147	    for col, (r, q) in enumerate(remain):
   148	        base = 9 * r + 12 * q
   149	        for j in range(q + 1):
   150	            exponent = base + j
   151	            if exponent < ebound:
   152	                matrix[slot_index[(exponent, j)]][col] = Fraction(comb(q, j))
   153	    return slots, matrix

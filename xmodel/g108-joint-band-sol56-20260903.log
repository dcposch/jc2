    85	def exact_q_rref(matrix: list[list[Fraction]]) -> tuple[int, list[int], list[int]]:
    86	    """Exact Gaussian elimination over Q.  Returns (rank, pivot_cols, pivot_rows)."""
    87	    if not matrix:
    88	        return 0, [], []
    89	    n_rows = len(matrix)
    90	    n_cols = len(matrix[0])
    91	    work = [row[:] for row in matrix]
    92	    rank = 0
    93	    pivot_cols: list[int] = []
    94	    pivot_rows: list[int] = []
    95	    used_rows: set[int] = set()
    96	    for col in range(n_cols):
    97	        pivot = None
    98	        for row in range(n_rows):
    99	            if row in used_rows:
   100	                continue
   101	            if work[row][col] != 0:
   102	                pivot = row
   103	                break
   104	        if pivot is None:
   105	            continue
   106	        pivot_val = work[pivot][col]
   107	        inv = Fraction(1, 1) / pivot_val
   108	        work[pivot] = [inv * value for value in work[pivot]]
   109	        for row in range(n_rows):
   110	            if row == pivot:
   111	                continue
   112	            scalar = work[row][col]
   113	            if scalar == 0:
   114	                continue
   115	            work[row] = [
   116	                work[row][c] - scalar * work[pivot][c] for c in range(n_cols)
   117	            ]
   118	        used_rows.add(pivot)
   119	        pivot_cols.append(col)
   120	        pivot_rows.append(pivot)
   121	        rank += 1
   122	        if rank == n_rows:
   123	            break
   124	    for row in range(n_rows):
   125	        if row in used_rows:
   126	            continue
   127	        assert all(value == 0 for value in work[row]), "inhomogeneous D1 obstruction"
   128	    return rank, pivot_cols, pivot_rows

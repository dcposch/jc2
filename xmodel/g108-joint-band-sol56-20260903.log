   201	        "bound_t_D1": str(block["bound_t_D1"]),
   202	        "D2_s_threshold": sbound,
   203	        "D1_e_threshold": ebound,
   204	        "ambient": len(positions),
   205	        "D2_unit_rows": d2_unit,
   206	        "D2_remaining": len(remain),
   207	        "D1_gap_support": len(d1_support),
   208	        "D1_raw_slots": len(slots),
   209	        "D1_rows_by_e": {str(k): by_e[k] for k in sorted(by_e)},
   210	        "D1_Qstar_rank": rank,
   211	        "D1_dependent_slots": len(slots) - rank,
   212	        "D1_e_range": [min(by_e), max(by_e)] if by_e else None,
   213	        "remain_r_min": min((r for r, _q in remain), default=None),
   214	        "sample_D2_vanish": [list(item) for item in vanish[:5]],
   215	        "sample_D2_remain": [list(item) for item in remain[:5]],
   216	        "D1_pivot_columns_rq": [

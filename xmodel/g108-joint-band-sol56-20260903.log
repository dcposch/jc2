   110	def coeff(prefix: str, idx: int, basis: Sequence[sp.Expr], params: List[sp.Symbol]):
   111	    if not basis:
   112	        return sp.Integer(0)
   113	    out = sp.Integer(0)
   114	    for j, base in enumerate(basis):
   115	        v = sp.Symbol("%s%d_%d" % (prefix, idx, j))
   116	        params.append(v)
   117	        out += v * base
   118	    return sp.expand(out)
   119	

   121	def automorphism_control() -> dict:
   122	    a, x, y, A, C = sp.symbols("a x y A C")
   123	    F = a * x + y
   124	    G = (a - 1) * x + y
   125	    J = sp.expand(sp.diff(F, x) * sp.diff(G, y) - sp.diff(F, y) * sp.diff(G, x))
   126	    Fans = A * x + y
   127	    Gans = C * x + y
   128	    Jans = sp.expand(
   129	        sp.diff(Fans, x) * sp.diff(Gans, y) - sp.diff(Fans, y) * sp.diff(Gans, x)
   130	    )
   131	    row = sp.expand(Jans - 1)
   132	    witness_F = Fans.subs({A: 2})
   133	    witness_G = Gans.subs({C: 1})
   134	    Jw = sp.expand(
   135	        sp.diff(witness_F, x) * sp.diff(witness_G, y)
   136	        - sp.diff(witness_F, y) * sp.diff(witness_G, x)
   137	    )
   138	    return {
   139	        "type": "EXACT-AUTOMORPHISM / SURVIVES[UNIVERSAL-GLOBAL-CHECKS]",
   140	        "pair": "F=a*x+y, G=(a-1)*x+y",
   141	        "J_identically": str(J),
   142	        "J_is_1": J == 1,
   143	        "shared_ansatz_row": str(row),
   144	        "row_is_A_minus_C_minus_1": sp.expand(row - (A - C - 1)) == 0,
   145	        "slice_A2_witness": {"F": str(witness_F), "G": str(witness_G), "J": str(Jw)},
   146	        "s3_tower": "NOT-APPLICABLE[degrees (1,1)]",
   147	        "outer_D1_D2_bands": "NOT-APPLICABLE[degrees (1,1)]",
   148	        "T2_T3_bridge": "NOT-APPLICABLE[degrees (1,1); no mu2=55]",
   149	        "survives": J == 1 and Jw == 1,
   150	    }

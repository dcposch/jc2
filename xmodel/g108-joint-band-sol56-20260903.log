    26	def reject_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    27	    out: dict[str, Any] = {}
    28	    for key, value in pairs:
    29	        if key in out:
    30	            raise ValueError(f"duplicate JSON key: {key}")
    31	        out[key] = value
    32	    return out
    33	
    34	
    35	def load_json(path: Path) -> dict[str, Any]:
    36	    return json.loads(path.read_bytes(), object_pairs_hook=reject_duplicates)
    37	
    38	
    39	def digest(path: Path) -> str:
    40	    return hashlib.sha256(path.read_bytes()).hexdigest()
    41	
    42	
    43	def require(condition: bool, message: str) -> None:
    44	    if not condition:
    45	        raise RuntimeError(message)
    46	
    47	
    48	def singular_sections(path: Path) -> dict[str, Any]:
    49	    text = path.read_text(encoding="utf-8")
    50	    def section(name: str) -> str:
    51	        match = re.search(rf"BEGIN_{name}\n(.*?)\nEND_{name}", text, re.DOTALL)
    52	        require(match is not None, f"missing Singular section {name}: {path}")
    53	        return match.group(1).strip()
    54	    result = {"dimension": int(section("DIM")), "basis": section("GB"),
    55	              "controls": section("CONTROLS").splitlines(),
    56	              "output_sha256": digest(path)}
    57	    require(result["dimension"] == -1, f"Singular dimension is not -1: {path}")
    58	    require(result["basis"] == "1", f"Singular basis is not 1: {path}")
    59	    require(result["controls"] == ["0", "1", "0"], f"Singular controls failed: {path}")
    60	    return result

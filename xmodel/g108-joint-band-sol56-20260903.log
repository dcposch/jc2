    62	
    63	def verify_singular_input(stage: dict[str, Any], path: Path) -> dict[str, Any]:
    64	    expressions = [sp.expand(sp.sympify(row["expression"]))
    65	                   for row in stage["joint_elimination"]["residual_rows"]]
    66	    variables = sorted(set().union(*(expr.free_symbols for expr in expressions)), key=str)
    67	    localized = sp.Symbol("rho" if stage["branch"] == "delta2" else "c")
    68	    wrapper = sp.Symbol("Zrho" if stage["branch"] == "delta2" else "Zc")
    69	    if localized not in variables:
    70	        variables.append(localized)
    71	        variables.sort(key=str)
    72	    ringvars = variables + [wrapper]
    73	    singular_expr = lambda expr: str(expr).replace("**", "^")
    74	    ideal_entries = [singular_expr(expr) for expr in expressions] + [f"{wrapper}*{localized}-1"]
    75	    expected = (
    76	        f"ring R=0,({','.join(map(str, ringvars))}),dp;\n"
    77	        f"ideal I={','.join(ideal_entries)};\n"
    78	        "ideal S=std(I);\n"
    79	        'print("BEGIN_DIM"); print(dim(S)); print("END_DIM");\n'
    80	        'print("BEGIN_GB"); print(S); print("END_GB");\n'
    81	        f"ideal EmptyControl={localized},{wrapper}*{localized}-1;\n"
    82	        f"ideal PointControl={localized}-1,{wrapper}*{localized}-1;\n"
    83	        f"ideal RawControl={','.join(singular_expr(expr) for expr in expressions)};\n"
    84	        'print("BEGIN_CONTROLS"); print(reduce(1,std(EmptyControl))); '
    85	        'print(reduce(1,std(PointControl))); print(reduce(1,std(RawControl))); '
    86	        'print("END_CONTROLS");\n'
    87	        "quit;\n"
    88	    )
    89	    require(path.read_text(encoding="utf-8") == expected,
    90	            f"emitted Singular input does not match stage JSON: {path}")
    91	    return {"path": str(path), "sha256": digest(path),
    92	            "byte_identical_reconstruction_from_stage_json": True}

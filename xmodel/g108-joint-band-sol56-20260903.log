   222	def k16_order_system(row: Row, gauged: bool = True):
   223	    x, y = sp.symbols("gamma pi")
   224	    c, T = sp.symbols("c T")
   225	    C, h, hpars, weighted, bu = k16_flag_basis(row, x, y)
   226	    e, q = C["eprime"], C["dprime"]
   227	
   228	    def space(i: int):
   229	        threshold = i * bu
   230	        return [p for p, w, _name in weighted if w >= threshold]
   231	
   232	    alpha_spaces = {i: list(space(i)) for i in range(1, e + 1)}
   233	    beta_spaces = {i: list(space(i)) for i in range(2, q + 1)}
   234	    gauges: List[str] = []
   235	    safe_shear = False
   236	    shear = e - q
   237	    if gauged and 1 <= shear <= e and alpha_spaces.get(shear) == [sp.Integer(1)]:
   238	        safe_shear = True
   239	        for i, bspace in beta_spaces.items():
   240	            target = alpha_spaces.get(i + shear, [])
   241	            if not all(any(sp.expand(b - a) == 0 for a in target) for b in bspace):
   242	                safe_shear = False
   243	                break
   244	        if safe_shear:
   245	            alpha_spaces[shear] = []
   246	            gauges.append("P -> P - alpha_%d Q" % shear)
   247	    if gauged and q in beta_spaces and any(b == 1 for b in beta_spaces[q]):
   248	        beta_spaces[q] = [b for b in beta_spaces[q] if b != 1]
   249	        gauges.append("Q -> Q - const(beta_%d)" % q)
   250	    if gauged and e in alpha_spaces and any(b == 1 for b in alpha_spaces[e]):
   251	        alpha_spaces[e] = [b for b in alpha_spaces[e] if b != 1]
   252	        gauges.append("P -> P - const(alpha_%d)" % e)
   253	
   254	    params = list(hpars)
   255	    alpha = {i: coeff("a", i, alpha_spaces[i], params) for i in range(1, e + 1)}
   256	    beta = {i: coeff("b", i, beta_spaces[i], params) for i in range(2, q + 1)}
   257	    high_terms = [(sp.Integer(1), e)] + [(alpha[i], e - i) for i in range(1, e + 1)]
   258	    low_terms = [(sp.Integer(1), q)] + [(beta[i], q - i) for i in range(2, q + 1)]
   259	    eqs, levels = hadic_eqs(h, low_terms, high_terms, c, row.k, x, y)
   260	    params.append(c)
   261	    meta = {
   262	        "chart": "k16_hadic_order",
   263	        "top_policy": "fixed",
   264	        "h_free_count": len(hpars),
   265	        "basis_weights": [(name, frac_s(w)) for _p, w, name in weighted],
   266	        "bound_unit": frac_s(bu),
   267	        "alpha_dims": [len(alpha_spaces[i]) for i in range(1, e + 1)],
   268	        "beta_dims": [len(beta_spaces[i]) for i in range(2, q + 1)],
   269	        "gauges": gauges,
   270	        "shear_checked": safe_shear,
   271	        "dprime": q,
   272	        "eprime": e,
   273	        "levels": levels,
   274	        "ring": "Q[%d params,c,T]" % (len(params) - 1),
   275	    }
   276	    return eqs, params, T, meta
   277	
   278	
   279	def hadic_eqs(h, low_terms, high_terms, c, kexp, x, y):
   280	    by_power: Dict[int, sp.Expr] = {}
   281	    for aa, r in low_terms:
   282	        for bb, s in high_terms:
   283	            v = jac(aa, bb, x, y)
   284	            if v != 0:
   285	                by_power[r + s] = by_power.get(r + s, 0) + v
   286	            v = s * bb * jac(aa, h, x, y) + r * aa * jac(h, bb, x, y)
   287	            if v != 0:
   288	                by_power[r + s - 1] = by_power.get(r + s - 1, 0) + v
   289	    if 0 not in by_power:
   290	        by_power[0] = sp.Integer(0)
   291	    level = 0
   292	    kmax = max(by_power) if by_power else 0
   293	    while level <= kmax:
   294	        rem = sp.expand(by_power.get(level, 0))
   295	        if rem != 0:
   296	            qdiv, rdiv = sp.div(sp.Poly(rem, y), sp.Poly(h, y), y)
   297	            by_power[level] = sp.expand(rdiv.as_expr())
   298	            if qdiv != 0:
   299	                by_power[level + 1] = by_power.get(level + 1, 0) + sp.expand(qdiv.as_expr())
   300	                kmax = max(kmax, level + 1)
   301	        level += 1
   302	    by_power[0] = sp.expand(by_power.get(0, 0) - c * x**kexp)
   303	    eqs: List[sp.Expr] = []
   304	    levels: List[int] = []
   305	    for level in sorted(by_power):
   306	        rem = sp.expand(by_power[level])
   307	        if rem == 0:
   308	            continue
   309	        levels.append(level)
   310	        P = sp.Poly(rem, x, y)
   311	        eqs.extend(sp.expand(co) for co in P.coeffs() if sp.expand(co) != 0)
   312	    return eqs, levels
   313	
   314	
   315	def generic_d1_count(row: Row, no_top: bool = False):
   316	    C = shape_bundle(row.n, row.m, row.M2, row.V2, row.k)
   317	    if not C["ok"]:
   318	        return {"chart": "none", "verdict": "SHAPE-FAIL", "reason": C["reason"]}
   319	    K = C["K"]
   320	    e, q = C["eprime"], C["dprime"]

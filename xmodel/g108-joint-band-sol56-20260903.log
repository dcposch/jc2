    29	def verify_frozen() -> dict:
    30	    fields: dict[str, str] = {}
    31	    for line in RECEIPT.read_text(encoding="utf-8").splitlines():
    32	        if "=" in line:
    33	            key, value = line.split("=", 1)
    34	            fields[key] = value
    35	    count = int(fields["charged_inputs"])
    36	    frozen = Path(fields["lane_inputs_dir"])
    37	    checked = []
    38	    for index in range(1, count + 1):
    39	        name = fields[f"charged_input_{index}_basename"]
    40	        expected = fields[f"charged_input_{index}_sha256"]
    41	        actual = sha256(frozen / name)
    42	        if actual != expected:
    43	            raise SystemExit(f"hash mismatch: {name}")
    44	        checked.append({"basename": name, "sha256": actual})
    45	    manifest = HERE / "inputs.sha256"
    46	    proc = subprocess.run(
    47	        ["sha256sum", "-c", str(manifest)],
    48	        capture_output=True,
    49	        text=True,
    50	        check=False,
    51	    )
    52	    ok_lines = [line for line in proc.stdout.splitlines() if line.endswith(": OK")]
    53	    return {
    54	        "receipt": str(RECEIPT),
    55	        "lane_inputs_dir": str(frozen),
    56	        "charged_inputs": count,
    57	        "all_hashes_match": True,
    58	        "manifest_ok_count": len(ok_lines),
    59	        "files": checked,
    60	    }

    77	def thresholds(block: dict) -> tuple[int, int]:
    78	    D = block["D"]
    79	    d2 = 3 * (D + block["bound_t_D2"])  # min 3r+4q
    80	    d1 = 9 * (D + block["bound_t_D1"])  # min e-power of K
    81	    assert d2.denominator == 1 and d1.denominator == 1
    82	    return int(d2), int(d1)

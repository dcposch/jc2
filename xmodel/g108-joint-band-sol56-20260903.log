   181	def analyse_block(name: str) -> dict:
   182	    block = BLOCKS[name]
   183	    D, ycap = block["D"], block["ycap"]
   184	    sbound, ebound = thresholds(block)
   185	    positions = support(D, ycap)
   186	    assert len(positions) == dim_S(D, ycap)
   187	    vanish = [(r, q) for r, q in positions if 3 * r + 4 * q < sbound]
   188	    remain = [(r, q) for r, q in positions if 3 * r + 4 * q >= sbound]
   189	    slots, matrix = d1_matrix(remain, ebound)
   190	    rank, pivot_cols, pivot_rows = exact_q_rref(matrix)
   191	    by_e = Counter(exponent for exponent, _j in slots)
   192	    d1_support = [(r, q) for r, q in remain if 9 * r + 12 * q < ebound]
   193	    # Unit-triangular check: each vanished (r,q) is its own D2 row.

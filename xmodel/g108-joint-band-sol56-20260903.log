+def determinant(rows: list[list[int]]) -> Fraction:
+    work = [[Fraction(value) for value in row] for row in rows]
+    result = Fraction(1)
+    for col in range(len(work)):
+        pivot = next((row for row in range(col, len(work)) if work[row][col]), None)
+        if pivot is None:

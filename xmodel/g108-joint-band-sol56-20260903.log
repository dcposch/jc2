/bin/bash -lc "python3 - <<'PY'
from math import comb
# Fixed-top lower supports: K_D=sum c_(r,q)t"'^r(w-1)''^q, r>=1, r+q<=D.
def supp(D): return [(r,q) for r in range(1,D+1) for q in range(D-r+1)]
H=supp(9)
strict_H=[p for p in H if 4*p[0]+6*p[1]>42]
eq_H=[p for p in H if 4*p[0]+6*p[1]==42]
below_H=[p for p in H if 4*p[0]+6*p[1]<42]
print('"'H ambient/below/equality/strict',len(H),len(below_H),eq_H,len(strict_H))
S=supp(36)
eq=[p for p in S if 4*p[0]+6*p[1]==168]
below=[p for p in S if 4*p[0]+6*p[1]<168]
strict=[p for p in S if 4*p[0]+6*p[1]>168]
print('h2 ambient/below/equality/strict',len(S),len(below),len(eq),len(strict))
print('h2 equality positions',eq)
want=[(6*k,28-4*k,(-1)**k*comb(7,k)) for k in range(1,8)]
print('desired lower equality terms',want)
print('unsupported desired terms',[x for x in want if (x[0],x[1]) not in S])
PY" in /home/ubuntu/jc2

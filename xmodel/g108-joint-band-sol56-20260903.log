    97	    # ---- (8): the increment denominators A_j -----------------------------
    98	    def A(self, j):
    99	        """A_j = reduced denominator of L_j*delta_j,  L_j = lcm{den delta_s,...,den delta_{j+1}}."""
   100	        L = 1
   101	        for i in range(j+1, self.s+1): L = lcm(L, self.delta[i].denominator)
   102	        return (L*self.delta[j]).denominator
   103	
   104	    def L(self, j):
   105	        L = 1
   106	        for i in range(j+1, self.s+1): L = lcm(L, self.delta[i].denominator)
   107	        return L
   108	
   109	    # ---- (9),(10),(11) at level j = r-1 (j = s-1,...,2) -------------------
   110	    def div9(self, j):

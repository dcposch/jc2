   183	                    # R_i = prod_{j>i} P_j/Q_j  ;  delta_i = 1 - (n-M_i) R_i/(n-M_s-1)
   184	                    def delta_of(i, R): return 1 - F(n-M[i])*R/F(n-M[s]-1)
   185	                    def Vrec(i, R, Lcm):

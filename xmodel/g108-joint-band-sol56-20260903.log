     1	#!/usr/bin/env python3
     2	"""Restore the pinned engine's read-only legacy input view and seed a new run.
     3	
     4	All source paths, basenames, and digests are taken mechanically from the
     5	legacy receipt.  Existing destinations are accepted only when their contents
     6	already have the required digest; nothing is overwritten.
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	import hashlib
    12	import json
    13	from pathlib import Path
    14	import re
    15	
    16	
    17	ROOT = Path(__file__).resolve().parents[2]
    18	ENGINE = ROOT / "box/g9966band-20260903/band_engine.py"
    19	RECEIPT = ROOT / "xmodel/g9966-global-band-sol56-20260903.run.v2"
    20	SOURCE_RUN = ROOT / "box/g9966band-20260903/runs/delta52"
    21	RUN = ROOT / "box/g9966s8-20260903/runs/delta52"
    22	PINNED_ENGINE_SHA256 = (
    23	    "3bd2937d75d59d59edeca1b89eba286fd2711f2d608109e7fd8971b64e059ac9"
    24	)
    25	
    26	
    27	def digest(path: Path) -> str:
    28	    h = hashlib.sha256()
    29	    with path.open("rb") as stream:
    30	        for block in iter(lambda: stream.read(1024 * 1024), b""):
    31	            h.update(block)
    32	    return h.hexdigest()
    33	
    34	
    35	def fields(path: Path) -> dict[str, str]:
    36	    out: dict[str, str] = {}
    37	    for line in path.read_text(encoding="utf-8").splitlines():
    38	        if "=" in line:
    39	            key, value = line.split("=", 1)
    40	            out[key] = value
    41	    return out
    42	
    43	
    44	def require(condition: bool, message: str) -> None:
    45	    if not condition:
    46	        raise RuntimeError(message)
    47	
    48	
    49	def safe_link(source: Path, destination: Path, expected: str) -> str:
    50	    require(source.is_file(), f"missing source: {source}")
    51	    require(digest(source) == expected, f"source digest mismatch: {source}")
    52	    if destination.exists():
    53	        require(destination.is_file(), f"destination is not a file: {destination}")
    54	        require(digest(destination) == expected, f"existing destination mismatch: {destination}")
    55	        return "existing"
    56	    if destination.is_symlink():
    57	        raise RuntimeError(f"dangling destination symlink: {destination}")
    58	    destination.symlink_to(source)
    59	    require(digest(destination) == expected, f"linked destination mismatch: {destination}")
    60	    return "linked"
    61	
    62	
    63	def main() -> None:
    64	    require(digest(ENGINE) == PINNED_ENGINE_SHA256, "pinned engine digest mismatch")
    65	    receipt = fields(RECEIPT)
    66	    count = int(receipt["charged_inputs"])
    67	    require(count == 20, f"unexpected legacy charged-input count: {count}")
    68	
    69	    engine_text = ENGINE.read_text(encoding="utf-8")
    70	    match = re.search(r'^FROZEN = Path\("([^\"]+)"\)$', engine_text, re.MULTILINE)
    71	    require(match is not None, "cannot recover FROZEN path from pinned engine")
    72	    frozen = Path(match.group(1))
    73	    require(str(frozen).startswith("/tmp/jc2-lane."), f"unsafe frozen target: {frozen}")
    74	    frozen.mkdir(parents=True, exist_ok=True)
    75	
    76	    linked = []
    77	    seen_names: set[str] = set()
    78	    for index in range(1, count + 1):
    79	        source_rel = receipt[f"charged_input_{index}"]
    80	        basename = receipt[f"charged_input_{index}_basename"]
    81	        expected = receipt[f"charged_input_{index}_sha256"]
    82	        require(Path(source_rel).name == basename, f"basename mismatch at input {index}")
    83	        require(basename not in seen_names, f"duplicate frozen basename: {basename}")
    84	        seen_names.add(basename)
    85	        source = ROOT / source_rel
    86	        destination = frozen / basename
    87	        action = safe_link(source, destination, expected)
    88	        linked.append({"index": index, "basename": basename, "sha256": expected,
    89	                       "source": str(source), "destination": str(destination),
    90	                       "action": action})
    91	
    92	    RUN.mkdir(parents=True, exist_ok=True)
    93	    seeded = []
    94	    for stage in range(8):
    95	        for suffix in ("json", "time", "sing", "err"):
    96	            name = f"stage{stage}.{suffix}"
    97	            source = SOURCE_RUN / name
    98	            require(source.is_file(), f"missing accepted prefix artifact: {source}")
    99	            expected = digest(source)
   100	            action = safe_link(source, RUN / name, expected)
   101	            seeded.append({"file": name, "sha256": expected, "action": action})
   102	
   103	    print(json.dumps({
   104	        "status": "READY",
   105	        "engine": str(ENGINE),
   106	        "engine_sha256": PINNED_ENGINE_SHA256,
   107	        "legacy_receipt": str(RECEIPT),
   108	        "frozen_directory": str(frozen),
   109	        "charged_inputs": linked,
   110	        "run_directory": str(RUN),
   111	        "seeded_prefix_artifacts": seeded,
   112	    }, indent=2, sort_keys=True))
   113	
   114	
   115	if __name__ == "__main__":
   116	    main()


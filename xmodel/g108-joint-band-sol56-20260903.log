+    c3 = lower_positions(27, 8)
+    c4 = lower_positions(36, 8)
+    assert (len(c2), len(c3), len(c4)) == (126, 207, 288)
+
+    h_squared = {
+        (r1 + r2, q1 + q2)
+        for r1, q1 in h_support
+        for r2, q2 in h_support

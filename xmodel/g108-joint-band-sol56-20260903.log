    81	        self.delta = {i: self._delta(i) for i in range(1, s+1)}
    82	        self.u = F(self.V[s]*self.K, self.d[s])
    83	
    84	    def _delta(self, i):                              # Def 5.1(3), p.179
    85	        n, M, d, V, s = self.n, self.M, self.d, self.V, self.s
    86	        num = F(n-M[i]); den = F(n-M[s]-1)
    87	        for j in range(i+1, s+1):
    88	            num *= (V[j]*(n-M[j]) - d[j]); den *= (V[j]*(n-M[j-1]) - d[j])
    89	        return 1 - num/den
    90	
    91	    def windows_ok(self):                             # search (7) = Def 5.1(2)
    92	        for i in range(2, self.s+1):
    93	            lo = F(self.d[i], self.n-self.M[i]); hi = F(self.V[i+1]*self.d[i], self.d[i+1])
    94	            if not (self.V[i] > lo and self.V[i] <= hi): return False
    95	        return True

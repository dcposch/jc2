+
+    h_squared = {
+        (r1 + r2, q1 + q2)
+        for r1, q1 in h_support
+        for r2, q2 in h_support
+    }
+    h_fourth = {
+        (r1 + r2, q1 + q2)
+        for r1, q1 in h_squared
+        for r2, q2 in h_squared
+    }
+    c2_h2 = {
+        (r1 + r2, q1 + q2)
+        for r1, q1 in c2
+        for r2, q2 in h_squared
+    }
+    c3_h = {

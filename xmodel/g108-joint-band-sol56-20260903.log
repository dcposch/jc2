import sympy as s
from collections import defaultdict
from math import comb,factorial,ceil
j1,j2,pi,c=s.symbols('jet1 jet2 pi c')
# z basis
K={(0,7):s.Integer(1),(0,8):s.Integer(2),(0,9):s.Integer(1)}
vars=[]
for r in range(1,10):
 vmin=max(0,ceil((43-4*r)/6)); cap=9-r
 for d in range(vmin,cap+1):
  h=s.symbols(f'Hc_{r}_{d}');vars.append(h)
  for q in range(vmin,d+1):K[(r,q)]=K.get((r,q),0)+h*comb(d-vmin,q-vmin)
print(vars,K)
# z->w
W=defaultdict(lambda:s.Integer(0))
for (r,q),coef in K.items():
 for j in range(q+1):W[(r,j)]+=coef*comb(q,j)*(-1)**(q-j)
rows=defaultdict(lambda:s.Integer(0))
for (r,j),coef in W.items():
 for a in range(j+1):
  for b in range(j-a+1):
   k=j-a-b
   n=r+2*a+3*b+4*k
   if n<=8:
    mult=factorial(j)//factorial(a)//factorial(b)//factorial(k)
    rows[(n,k)]+=coef*mult*j1**a*j2**b
rows[(8,0)]-=c
rows[(8,2)]+=1
for tag,row in sorted(rows.items()):
 row=s.expand(row)
 if row"'!=0:print(tag,row)
print('"'nonzero',sum(s.expand(v)"'!=0 for v in rows.values()),'"'labels',len(rows))
# qstar simple
work=[(str(tag),s.expand(row)) for tag,row in sorted(rows.items()) if s.expand(row)"'!=0]
elig=set(vars);subs={}; piv=[]
while 1:
 ch=None
 for idx,(lab,row) in enumerate(work):
  row=s.expand(row.subs(subs,simultaneous=True))
  for v in sorted(row.free_symbols&elig,key=str):
   co=s.diff(row,v)
   if co.is_Rational and co and v not in s.expand(row-co*v).free_symbols:
    ch=(idx,lab,v,co,s.expand(row-co*v));break
  if ch:break
 if not ch:break
 idx,lab,v,co,rem=ch;rhs=s.cancel(-rem/co);subs[v]=rhs;elig.remove(v);piv.append((lab,v,co,rhs));del work[idx]
 work=[(l,s.expand(rr.subs(v,rhs))) for l,rr in work if s.expand(rr.subs(v,rhs))!=0]
print('"'pivs');
for x in piv:print(x)
print('res')
for l,r in work: print(l,s.factor(s.expand(r.subs(subs, simultaneous=True))))

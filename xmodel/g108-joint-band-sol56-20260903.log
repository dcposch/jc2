+        if pivot != col:
+            work[col], work[pivot] = work[pivot], work[col]
+            result *= -1
+        value = work[col][col]
+        result *= value
+        for row in range(col + 1, len(work)):
+            scalar = work[row][col] / value
+            for column in range(col, len(work)):
+                work[row][column] -= scalar * work[col][column]
+    return result

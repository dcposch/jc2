+            "face_incidence_rows": len(equality_slots),
+            "face_sites": [list(p) for p in sorted(equality_slots)],
+            "face_values": [str((-1) ** k * comb(8, k)) for k in range(1, 9)],
+            "nominal_rows": len(slots),

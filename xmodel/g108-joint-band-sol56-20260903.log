    24	def build_1612(repeated_c5: bool):
    25	    x, y = sp.symbols("x y")
    26	    b1, b2, b3, b4, a1 = sp.symbols("b1 b2 b3 b4 a1")
    27	    c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13 = sp.symbols(
    28	        "c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13"
    29	    )
    30	    kappa, T = sp.symbols("kappa T")
    31	    h = y**3 * (y - x) + b1 * y**3 + b2 * y**2 + b3 * y + b4
    32	    A = y**2 * (y - x) + b1 * y**2 + b2 * y + b3
    33	    Bpoly = y * (y - x) + b1 * y + b2
    34	    if repeated_c5:
    35	        alpha3 = c5 * A + c5 * Bpoly + c7
    36	        gens = [b1, b2, b3, b4, a1, c1, c2, c3, c4, c5, c7, c8, c9, c10, c11, c12, c13, kappa, T]
    37	        alpha1 = a1
    38	        variant = "printed_repeated_c5"
    39	    else:
    40	        alpha3 = c5 * A + c6 * Bpoly + c7
    41	        gens = [b1, b2, b3, b4, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, kappa, T]
    42	        alpha1 = 0
    43	        variant = "absorbed_alpha1_distinct_c6"
    44	    alpha2 = c1 * A + c2
    45	    beta2 = c3 * A + c4
    46	    beta3 = c8 * A + c9 * Bpoly + c10
    47	    alpha4 = c11 * A + c12 * Bpoly + c13 * (y - x)
    48	    g = sp.expand(h**4 + alpha1 * h**3 + alpha2 * h**2 + alpha3 * h + alpha4)
    49	    f = sp.expand(h**3 + beta2 * h + beta3)
    50	    J = sp.expand(
    51	        sp.diff(f, x) * sp.diff(g, y) - sp.diff(f, y) * sp.diff(g, x) - kappa
    52	    )
    53	    poly = sp.Poly(J, x, y, domain=sp.QQ[tuple(gens)])
    54	    eqs = [sp.Poly(coeff, gens).as_expr() for coeff in poly.coeffs()]
    55	    n_J = len(eqs)
    56	    eqs.append(T * kappa - 1)
    57	    return {
    58	        "variant": variant,
    59	        "gens": gens,
    60	        "eqs": eqs,
    61	        "n_J_rows": n_J,
    62	        "n_coeff_variables": 17,
    63	        "n_unknowns_with_kappa": 18,
    64	        "wrapper": "T*kappa-1",
    65	        "ring": f"GF({P})[gens], grevlex",
    66	        "f": f,
    67	        "g": g,
    68	        "x": x,
    69	        "y": y,
    70	        "kappa": kappa,
    71	        "T": T,
    72	        "u_s": 1,
    73	        "bridge": "TRIVIAL[u_s=1]",
    74	    }
    75	

   167	def d2e3_ab_system(row: Row, top_policy: str):
   168	    C = shape_bundle(row.n, row.m, row.M2, row.V2, row.k)
   169	    if not (C["ok"] and C["two_point"] and C["dprime"] == 2 and C["eprime"] == 3):
   170	        raise ValueError("not a d'=2,e'=3 two-point row")
   171	    x, y = sp.symbols("x y")
   172	    c, T = sp.symbols("c T")
   173	    h, hpars, hfree, top_note = h_two_point(C, x, y, "h", top_policy)
   174	    beta, bpars, A = build_beta_ab(h, x, y)
   175	    qdiv, _ = sp.div(sp.Poly(sp.expand(beta**2), y), sp.Poly(h, y), y)
   176	    alpha = sp.expand(qdiv.as_expr())
   177	    # Use the exact h-adic recurrence instead of expanding h^3.  This is the
   178	    # same polynomial identity after monic division by h in y.
   179	    low_terms = [(sp.Integer(1), 2), (2 * beta, 0)]
   180	    high_terms = [(sp.Integer(1), 3), (3 * beta, 1), (sp.Rational(3, 2) * alpha, 0)]
   181	    eqs, levels = hadic_eqs(h, low_terms, high_terms, c, row.k, x, y)
   182	    params = hpars + bpars + [c]
   183	    meta = {
   184	        "chart": "d2e3_ab",
   185	        "top_policy": top_policy,
   186	        "top_note": top_note,
   187	        "h_free_count": len(hfree),
   188	        "ab_forced": True,
   189	        "dprime": 2,
   190	        "eprime": 3,
   191	        "levels": levels,
   192	        "ring": "Q[h(%d),bp,bq,br,bs,c,T]" % len(hpars),
   193	    }
   194	    return eqs, params, T, meta

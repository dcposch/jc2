   154	def census(n, Kmin=16, with_V=True, full=False):
   155	    """(1)-(7) [+ (8)-(13) if full] enumeration at degree n = deg g.
   156	       Yields (m, (M_2..M_s), {i: V_i}).  full=True prunes with (10)/(11) inside the
   157	       recursion and applies (12)/(13) at the bottom."""
   158	    for K in range(Kmin, n//3+1):
   159	        if n % K: continue
   160	        e = n//K
   161	        if e < 3: continue
   162	        for ch in divisor_chains(K, 4):
   163	            dfull = [n, K]+ch; dfull.append(gcd(dfull[-1], n-2))
   164	            s = 2+len(ch)
   165	            d = {i+1: dfull[i] for i in range(len(dfull))}
   166	            dlist = ([K]+ch)[:-1]; tg = ch
   167	            for dd in range(2, e):
   168	                if gcd(dd, e) != 1: continue

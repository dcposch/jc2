    28	def dim_S(D: int, ycap: int) -> int:
    29	    """dim {A : deg A <= D, deg_y A < ycap} = ycap*(D+1) - ycap*(ycap-1)/2."""
    30	    return ycap * (D + 1) - ycap * (ycap - 1) // 2
    31	

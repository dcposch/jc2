    95	def constant_certificate(stage: dict[str, Any], expected_branch: str,
    96	                         expected_stage: int, expected_label: str,
    97	                         expected_constant: int, singular_input: Path,
    98	                         singular_output: Path) -> dict[str, Any]:
    99	    require(stage["branch"] == expected_branch, "branch mismatch")
   100	    require(stage["stage_spec"]["stage"] == expected_stage, "stage mismatch")
   101	    require(stage["driver_sha256"] == digest(ENGINE), "engine hash mismatch")
   102	    rows = stage["joint_elimination"]["residual_rows"]
   103	    selected = [row for row in rows if row["label"] == expected_label]
   104	    require(len(selected) == 1, f"missing unique residue row: {expected_label}")
   105	    value = sp.sympify(selected[0]["expression"])
   106	    require(not value.free_symbols and value == expected_constant, "constant residue mismatch")
   107	    inverse = sp.Rational(1, expected_constant)
   108	    require(sp.cancel(inverse * value) == 1, "unit-ideal membership check failed")
   109	

   130	def h_two_point(C: dict, x, y, prefix: str, top_policy: str):
   131	    """Return h, h-parameters, and the effective top policy.
   132	
   133	    top_policy=fixed uses shape.leading_support and D1 lower terms.  top_policy=d1
   134	    keeps every D1-allowed h monomial except the monic y^K term free.
   135	    """
   136	    K = C["K"]
   137	    params: List[sp.Symbol] = []
   138	    h = y**K
   139	    if top_policy == "fixed":
   140	        h = sp.Integer(0)
   141	        for (a, b), cc in C["lead"].items():
   142	            h += int(cc) * x**a * y**b
   143	        free = list(C["h_free"])
   144	        note = "fixed split top face"
   145	    elif top_policy == "d1":
   146	        free = [m for m in C["h_all"] if m != (0, K)]
   147	        note = "D1-only top face; monic y^K fixed"
   148	    else:
   149	        raise ValueError("bad top_policy %s" % top_policy)
   150	    h += poly_from_mons(free, x, y, prefix, params)
   151	    return sp.expand(h), params, free, note

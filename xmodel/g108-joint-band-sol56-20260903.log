    94	def wrapper_controls() -> dict:
    95	    k, T = sp.symbols("kappa T")
    96	    G_neg = sp.groebner([k, T * k - 1], [k, T], domain=sp.QQ)
    97	    G_pos = sp.groebner([k - 1, T * k - 1], [k, T], domain=sp.QQ)
    98	    return {
    99	        "ring": "Q[kappa, T]",
   100	        "negative_kappa_and_wrapper": [str(g) for g in G_neg],
   101	        "positive_kappa_minus_1_and_wrapper": [str(g) for g in G_pos],
   102	        "negative_is_one": list(G_neg) == [1],
   103	        "positive_not_one": list(G_pos) != [1],
   104	    }

import sympy as sp
from collections import defaultdict
from math import comb,factorial,ceil

def compute(cutoff):
 jet1,jet2,c=sp.symbols('jet1 jet2 c')
 K={(0,7):sp.Integer(1),(0,8):sp.Integer(2),(0,9):sp.Integer(1)}; vs=[]
 for r in range(1,10):
  vm=max(0,ceil((cutoff-4*r)/6));cap=9-r
  for d in range(vm,cap+1):
   x=sp.symbols(f'Hc_{r}_{d}');vs.append(x)
   for q in range(vm,d+1): K[(r,q)]=K.get((r,q),0)+x*comb(d-vm,q-vm)
 W=defaultdict(lambda:sp.Integer(0))
 for (r,q),co in K.items():
  for j in range(q+1):W[(r,j)]+=co*comb(q,j)*(-1)**(q-j)
 C=defaultdict(lambda:sp.Integer(0))
 for (r,j),co in W.items():
  for a in range(j+1):
   for b in range(j-a+1):
    k=j-a-b;n=r+2*a+3*b+4*k
    if n<=8:
     mult=factorial(j)//(factorial(a)*factorial(b)*factorial(k))
     C[(n,k)]+=co*mult*jet1**a*jet2**b
 C[(8,0)]-=c;C[(8,2)]+=1
 work=[(tag,sp.expand(v)) for tag,v in sorted(C.items()) if sp.expand(v)"'!=0]
 avail=set(vs); subs={};p=[]
 while True:
  sel=None
  for idx,(tag,row) in enumerate(work):
   for var in sorted(row.free_symbols&avail,key=str):
    co=sp.diff(row,var);rem=sp.expand(row-co*var)
    if co.is_Rational and co!=0 and var not in rem.free_symbols:
     sel=(idx,tag,var,co,rem);break
   if sel:break

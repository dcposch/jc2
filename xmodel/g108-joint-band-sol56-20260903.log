+    assert count == 18
+    manifest_lines = []
+    checked = []
+    for index in range(1, count + 1):
+        basename = fields[f"charged_input_{index}_basename"]
+        expected = fields[f"charged_input_{index}_sha256"]
+        assert Path(basename).name == basename
+        path = frozen / basename

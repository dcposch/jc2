+        "stop_reason": "explicit localized unit certificate" if run_stage else None,
+    }
+    result = {
+        "type": "D108-JOINT-BAND-ENGINE / EXACT-Q",
+        "mode": "stage-0" if run_stage else "skeleton-only",
+        "driver_provenance": {

    96	def sstr(expr) -> str:
    97	    expr = sp.together(sp.expand(expr))
    98	    num, den = sp.fraction(expr)
    99	    num = sp.expand(num)
   100	    den = sp.expand(den)
   101	    if den == 1:
   102	        out = str(num)
   103	    elif den == -1:
   104	        out = str(-num)
   105	    else:
   106	        out = "(%s)/(%s)" % (num, den)
   107	    return out.replace("**", "^")

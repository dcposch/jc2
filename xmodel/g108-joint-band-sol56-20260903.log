+            "raw_blocks": {"H": 54, "C2": 135, "C3": 216, "C4": 297, "A2": 1998, "A3": 3294, "B1": 702, "B2": 1998},
+            "fixed_top_blocks": {"H": 45, "C2": 126, "C3": 207, "C4": 288, "A2": 1962, "A3": 3258, "B1": 666, "B2": 1962},

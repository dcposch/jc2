   121	def poly_from_mons(mons: Iterable[Tuple[int, int]], x, y, prefix: str, params: List[sp.Symbol]):
   122	    out = sp.Integer(0)
   123	    for a, b in mons:
   124	        v = sp.Symbol("%s_%d_%d" % (prefix, a, b))
   125	        params.append(v)
   126	        out += v * x**a * y**b
   127	    return sp.expand(out)

   190	            (row.negmu[row.s]+row.n-2, (row.W()+row.Kg())*row.us, row.ord_T3f(dl)),
   191	        ]:
   192	            if -(deg-mult) + mult*dl != val: ok = False
   193	    ck("%s five orders == direct root-contact count" % name, ok)

+def lower_positions(degree: int, y_cap: int) -> set[tuple[int, int]]:
+    """Fixed-top positions in t^degree Q(t^-1,w/t), excluding r=0."""
+    return {
+        (r, q)
+        for r in range(1, degree + 1)
+        for q in range(min(y_cap, degree - r) + 1)

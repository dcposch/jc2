    20	# ---------------------------------------------------------------- skeleton
    21	class Row:
    22	    def __init__(self, n, m, Ms, Vs, label):
    23	        self.label, self.n, self.m = label, n, m
    24	        full = [-m] + list(Ms)
    25	        self.s = s = len(full)
    26	        self.M = {i+1: full[i] for i in range(s)}
    27	        d = [n]
    28	        for M in full: d.append(gcd(d[-1], M))
    29	        self.d = {i+1: d[i] for i in range(len(d))}
    30	        self.V = dict(Vs); self.V[s+1] = self.d[s+1]
    31	        self.ds = self.d[s]
    32	        self.vs = self.V[s]
    33	        self.us = self.ds - self.vs
    34	        # Def 5.1(3) radii
    35	        self.delta = {i: self._delta(i) for i in range(1, s+1)}
    36	        # Moh p.150 semigroup: q_1 = M_1, q_i = M_i - M_{i-1},
    37	        #                      lam_1 = q_1 d_1, lam_i = lam_{i-1} + q_i d_i, mu_i = lam_i/d_i
    38	        self.q = {1: self.M[1]}
    39	        for i in range(2, s+1): self.q[i] = self.M[i] - self.M[i-1]
    40	        lam = {1: self.q[1]*self.d[1]}
    41	        for i in range(2, s+1): lam[i] = lam[i-1] + self.q[i]*self.d[i]
    42	        self.lam = lam
    43	        self.mu = {}
    44	        for i in range(1, s+1):
    45	            assert lam[i] % self.d[i] == 0, (label, i, lam[i], self.d[i])
    46	            self.mu[i] = lam[i]//self.d[i]
    47	        self.negmu = {i: -self.mu[i] for i in self.mu}   # -mu_1 = m, -mu_2, -mu_3
    48	
    49	    def _delta(self, i):
    50	        n, M, d, V, s = self.n, self.M, self.d, self.V, self.s
    51	        num = F(n-M[i]); den = F(n-M[s]-1)
    52	        for j in range(i+1, s+1):
    53	            num *= (V[j]*(n-M[j]) - d[j]); den *= (V[j]*(n-M[j-1]) - d[j])
    54	        return 1 - num/den
    55	
    56	    # ---- Xu 7.3 principal-minor data (p-exponents; multiplicity = exponent*u_s)
    57	    def Kg(self): return F(self.n, self.ds)          # g   = T_0
    58	    def Kf(self): return F(self.m, self.ds)          # f   = T_1
    59	    def K2(self): return F(self.negmu[2], self.ds)   # T_2
    60	    def W(self):  return F(self.negmu[self.s]-2, self.ds)   # T_s : deg q = W*u_s + 1
    61	    def degq(self): return self.W()*self.us + 1
    62	    def X(self, dl): return self.us*dl - self.vs                 # the universal factor
    63	    def ord_g(self, dl): return self.Kg()*self.X(dl)
    64	    def ord_f(self, dl): return self.Kf()*self.X(dl)
    65	    def ord_T2(self, dl): return self.K2()*self.X(dl)
    66	    def ord_T3(self, dl): return self.W()*self.X(dl) - 1 + dl
    67	    def ord_T3f(self, dl): return (self.W()+self.Kg())*self.X(dl)
    68	    def ceiling(self): return F(self.vs, self.us)     # detector window top
    69	    def cor75(self): return F(self.vs+1, self.us+1)   # Xu Cor 7.5 threshold
    70	    def cface(self): return self.Kg()*(self.vs-self.us)   # ODE right-hand constant
    71	    def rho(self, dl):  return self.Kg()*self.ord_T3(dl)/self.ord_g(dl)
    72	
    73	def parts(k):
    74	    """partitions of k as sorted tuples, descending"""
    75	    def rec(k, mx):
    76	        if k == 0: yield ()
    77	        for p in range(min(k, mx), 0, -1):
    78	            for rest in rec(k-p, p): yield (p,)+rest
    79	    return list(rec(k, k))
    80	
    81	def candidates(row):
    82	    """reduced delta in (1, v_s/u_s) with den(delta) <= u_s   [N5, PROVED]"""
    83	    out = []
    84	    lo, hi = F(1), row.ceiling()
    85	    for e in range(1, row.us+1):
    86	        p = e+1
    87	        while F(p, e) < hi:
    88	            dl = F(p, e)
    89	            if dl > lo and dl.denominator == e: out.append(dl)
    90	            p += 1
    91	    return sorted(set(out))
    92	
    93	def screen(row, verbose=True):
    94	    """resonance/degree screen of the face ODE  Kg*a*q*p' - b*q'*p = c*p^{W+1}
    95	       at a root of p of multiplicity mm with ord_q = r:
    96	         non-resonant  r = W*mm+1     (leading coefficients do not cancel)
    97	         resonant      r = rho*mm     (they do; needs r integral and r <= W*mm)
    98	       budget  sum r_i <= deg q."""
    99	    W, dq, us = row.W(), row.degq(), row.us
   100	    res = {}
   101	    for dl in candidates(row):
   102	        rho = row.rho(dl)
   103	        rows = []
   104	        for part in parts(us):
   105	            if len(part) < 2:     # a single part = p is a power of one linear factor
   106	                continue          #   -> unsplit (Moh's linear-power alternative)
   107	            opts = []
   108	            for mm in part:
   109	                o = [W*mm+1]
   110	                r = rho*mm
   111	                if r.denominator == 1 and r > 0 and r <= W*mm: o.append(int(r))
   112	                opts.append(sorted(set(int(v) for v in o)))
   113	            # multiplicity vectors are attached to the parts of `part`; two vectors that
   114	            # differ only by relabelling equal parts are the same face, so dedupe on the
   115	            # multiset grouped by part size.
   116	            seen, vecs = set(), []
   117	            for v in product(*opts):
   118	                if sum(v) > dq: continue
   119	                key = tuple(sorted(zip(part, v)))
   120	                if key in seen: continue
   121	                seen.add(key); vecs.append(v)
   122	            if vecs: rows.append((part, sorted(vecs, reverse=True)))
   123	        res[dl] = dict(rho=str(rho), alive={str(p): v for p, v in rows})
   124	    return res
   125	
   126	def galois(row, dl, part):
   127	    """mu_e action pi -> zeta_e^num pi (num/e = dl in lowest terms) must fix the root
   128	       multiset of p with multiplicities.  The pre-delta jet has integral exponents
   129	       (N5 lemma), so the action is a pure scaling: 0 is the unique fixed point."""
   130	    e = dl.denominator
   131	    if e == 1: return True, "e=1, no constraint (translation in pi is a gauge)"
   132	    nz = [mm for mm in part]
   133	    # orbits of nonzero roots have size e; at most one root (any multiplicity) sits at 0
   134	    # so: the multiset of multiplicities of the NONZERO roots must be a union of
   135	    # e-element blocks of EQUAL multiplicity.
   136	    from collections import Counter
   137	    for at0 in set(part) | {0}:
   138	        rest = list(part)
   139	        if at0:
   140	            rest.remove(at0)
   141	        cnt = Counter(rest)
   142	        if all(v % e == 0 for v in cnt.values()):
   143	            return True, "root at 0 of multiplicity %s; nonzero roots in mu_%d orbits" % (at0, e)
   144	    return False, "no mu_%d-stable arrangement of partition %s" % (e, part)

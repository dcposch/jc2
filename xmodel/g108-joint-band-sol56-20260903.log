   107	def order_spine_identity() -> dict:
   108	    z = sp.symbols("z")
   109	    left = (20 * z - sp.Rational(10, 3)) * (sp.Rational(27, 10) - sp.Rational(27, 5) * z) - 1
   110	    right = -2 * (54 * z**2 - 36 * z + 5)
   111	    diff = sp.expand(left - right)
   112	    return {
   113	        "identity": "(20z-10/3)(27/10-27z/5)-1 = -2(54z^2-36z+5)",
   114	        "difference": str(diff),
   115	        "holds_over_Q": diff == 0,
   116	        "modulus": "Q[z]/(54z^2-36z+5)",
   117	        "terminal_unit": "20z-10/3",
   118	    }

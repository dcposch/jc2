   258	def residual(row, dl, p, q):
   259	    a = sp.Rational(row.ord_T3(dl)); b = sp.Rational(row.ord_g(dl))
   260	    Kg = sp.Rational(row.Kg()); C = sp.Rational(row.cface()); W = int(row.W())
   261	    return sp.simplify(sp.expand(Kg*a*q*sp.diff(p,pi) - b*sp.diff(q,pi)*p - C*p**(W+1)))

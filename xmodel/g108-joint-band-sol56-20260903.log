    77	def groebner_modp(eqs, gens, p=P):
    78	    reduced = []
    79	    for e in eqs:
    80	        pe = sp.Poly(e, gens, domain=sp.QQ)
    81	        pe = pe.set_domain(sp.ZZ)
    82	        content = pe.content()
    83	        if content != 0:
    84	            pe = pe.quo_ground(content)
    85	        pe = pe.set_modulus(p)
    86	        if pe != 0:
    87	            reduced.append(pe.as_expr())
    88	    if not reduced:
    89	        return [0]
    90	    G = sp.groebner(reduced, gens, domain=sp.GF(p), order="grevlex")
    91	    return [sp.expand(item) for item in G]
    92	

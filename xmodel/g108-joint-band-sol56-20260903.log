import sympy as s
from math import comb,factorial
from collections import defaultdict

def add(*its):
 o=defaultdict(lambda:s.Integer(0))
 for it in its:
  for k,v in it.items():o[k]+=v
 return {k:s.expand(v) for k,v in o.items() if v"'!=0}

def h3(wq):
 B=wq*7
 o={(0,7):1,(0,8):2,(0,9):1};vs=[]
 for r in range(1,10):
  cap=9-r;vmin=max(0,(B+1-4*r+wq-1)//wq)
  for d in range(vmin,cap+1):
   x=s.Symbol(f'"'H_{r}_{d}');vs.append(x)
   for j in range(d-vmin+1):o[r,vmin+j]=o.get((r,vmin+j),0)+x*comb(d-vmin,j)
 return o,vs

def to_w(item):
 out=defaultdict(lambda:s.Integer(0))
 for (r,q),v0 in item.items():
  for j in range(q+1):out[r,j]+=v0*comb(q,j)*(-1)**(q-j)
 return out

def local(item,N):
 u,v=s.symbols('u v');out=defaultdict(lambda:s.Integer(0))
 for (r,j),co in to_w(item).items():
  for b in range(j+1):
   for k in range(j-b+1):
    a=j-b-k;n=r+2*j+b+2*k
    if n<=N:
     multi=factorial(j)//factorial(a)//factorial(b)//factorial(k)
     out[n,k]+=co*multi*u**a*v**b
 return {x:s.expand(y) for x,y in out.items() if y"'!=0}

def qreduce(rows,elig):
 work=[(l,s.expand(e)) for l,e in rows if e!=0];sub={};p=[];zeros=len(rows)-len(work)
 while 1:
  choice=None
  for ii,(l,e) in enumerate(work):
   for x in sorted(e.free_symbols&elig,key=str):
    co=s.diff(e,x)
    if co.is_Rational and co!=0 and x not in s.expand(e-co*x).free_symbols:
     choice=ii,l,x,s.Rational(co),s.expand(e-co*x);break
   if choice:break
  if not choice:break
  ii,l,x,co,rem=choice;rhs=s.cancel(-rem/co);sub[x]=rhs;p.append((l,x,co,rhs));elig.remove(x);work.pop(ii)
  nw=[]
  for lab,e in work:
   e=s.expand(e.subs(x,rhs))
   if e==0:zeros+=1
   else:nw.append((lab,e))
  work=nw
 return work,sub,p,zeros
for wq in [5,6]:
 H,vars=h3(wq);loc=local(H,8);c=s.Symbol('"'c')
 rows=[]
 for n in range(9):
  ks=set(k for (nn,k) in loc if nn==n)
  if n==8:ks|={0,2}
  for k in sorted(ks):
   target=(c if k==0 else -1 if k==2 else 0) if n==8 else 0
   rows.append((f'n{n}k{k}',loc.get((n,k),0)-target))
 residual,sub,piv,z=qreduce(rows,set(vars))
 print('\\nWEIGHT',wq,'vars',len(vars),[str(x) for x in vars])
 print('rows',len(rows),'nonzero',sum(e"'!=0 for _,e in rows),'"'piv',len(piv),'zero',z,'residual',len(residual))
 print('pivots',[(a,str(b),str(c0)) for a,b,c0,d in piv])
 print('resid',[(l,s.factor(e)) for l,e in residual])

+            "M": [-72, 81, 106],
+            "d": [108, 36, 9, 1],
+            "V": [7, 7],
+            "u3": 2,
+            "v3": 7,
+            "split": {
+                "delta": 3,
+                "partition": [1, 1],
+                "p": "pi^2-c",
+                "q": "p^23*U",
+                "U_prime": "5*p^2",
+                "degree_U": 5,

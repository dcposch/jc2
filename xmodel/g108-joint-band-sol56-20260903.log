 res=[(tag,sp.factor(sp.expand(row.subs(subs,simultaneous=True)))) for tag,row in work]
 print('"'cut',cutoff,'vars',len(vs),[str(x) for x in vs],'piv',len(p),'res',len(res))
 print('subs',{str(x):z for x,z in subs.items()})
 for x in res:print(x)
compute(43);compute(42)

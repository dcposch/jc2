 f.write('ring s=%d,(%s),ds;\\n'%(p,','.join(vs)))
 imgs=','.join(v+('+'+str(a[v]) if a[v] else '') for v in vs)
 f.write('map phi=r,%s;\\n'%imgs)
 f.write('ideal J=phi(I);\\noption(redSB);\\nideal G=std(J);\\n')
 f.write('print(\"LOCAL_DIM\");\\nprint(dim(G));\\nprint(\"STD_SIZE\");\\nprint(size(G));\\n')
 f.write('quit;\\n')
print(path,os.path.getsize(path),sum(bool(r) for r in b['rows']))

def interpolate_rows(perfiber, labs, basis, Minv, p):
    """perfiber: {label: extpoly} -> {key: {bexp: c}} over basis."""
    sup = sorted({k for d in perfiber.values() for k in d})
    out = {}
    n = len(labs)
    for k in sup:
        v = [perfiber[lb].get(k, 0) for lb in labs]

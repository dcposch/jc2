LOW6 = [("tf1_38", (6, 2)), ("tf1_40", (8, 0)), ("tf2_40", (8, 3)),
        ("tf1_39", (12, 8)), ("tf1_41", (14, 6)), ("tf2_41", (14, 9))]
HIGH6 = [("tf2_45", (18, 8)), ("tf2_50", (18, 11)),
         ("tf1_47", (20, 0)), ("tf1_52", (20, 3)),

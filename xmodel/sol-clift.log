+                            for r, value in point["tails"][family].items()}
+                  for family in FAMS},
+        "fixed": {name: int(value) for name, value in point["fixed"].items()},
+    }
+    alpha = beta = 0
+    for label, delta in zip(labels, correction):
+        if not delta:
+            continue
+        if label[0] in FAMS:
+            family, r = label
+            value = (lifted["tails"][family].get(r, 0) + p * delta) % modulus

def lift_mul(a, b):
    if not a: return b
    if not b: return a
    d = dict(a)
    for nm, e in b:
        d[nm] = d.get(nm, 0) + e
    return tuple(sorted(d.items()))


def wcancel(s):
    """uW_i*W_i == 1 mod I23 (chart saturation): cancel mixed pairs."""
    e = None
    a = min((s >> (SH * IW1)) & 0xFF, (s >> (SH * IUW1)) & 0xFF)
    b = min((s >> (SH * IW2)) & 0xFF, (s >> (SH * IUW2)) & 0xFF)
    if not (a or b):
        return s
    e = list(unpack(s))
    e[IW1] -= a; e[IUW1] -= a; e[IW2] -= b; e[IUW2] -= b
    return pack(e)


def ext_add(dst, src, p, scale=1):
    for k, c in src.items():
        nc = (dst.get(k, 0) + scale * c) % p
        if nc: dst[k] = nc
        else: dst.pop(k, None)
    return dst


def ext_mul(a, b, p):

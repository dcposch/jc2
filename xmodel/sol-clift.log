+FAMS = ("tf1", "tf2", "tg1", "tg2", "tg01", "tg02")
+FIXED_COORDS = ("W1", "W2", "uf18", "uf24", "vf1_34", "vf1_36",
+                "vf2_34", "vf2_36")

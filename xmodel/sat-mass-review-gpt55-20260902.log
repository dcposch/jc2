+(x^2y,xy):                  ell=2, D=3, T=0, kappa=1, 2(T+kappa)=2, 2Lambda=4
+(x,x(x-1)(x-2)y^2):         ell=3, D=5, T=0, kappa=2, 2(T+kappa)=4, 2Lambda=6

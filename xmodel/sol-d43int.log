+                  if index not in set(selected_columns)]
+    local_variables = pivot_names + free_names
+    # The normalized degree-one parts are pivot_i plus free variables only.
+    for index, row in enumerate(basis):
+        linear = {monomial: coefficient for monomial, coefficient in row.items()
+                  if len(monomial) == 1}
+        assert linear.get((pivot_names[index],)) == 1
+        assert not any(name in set(pivot_names) and name != pivot_names[index]

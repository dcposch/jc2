@@ -349,8 +349,10 @@
   "pointbank_sha256": "bb0f13b61616c486116027e284483a4fb0f529f8df2dca7f728d56584d98fcbb"
  },
  "interpretation": "This proves smoothness/dimension 45 only for the fixed parked graph fiber; total-space generation and p-flatness are separate gates.",

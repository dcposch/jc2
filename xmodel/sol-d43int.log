sys.path.insert(0,'cases');import d43_local_fiber as L
p=105337;b=pickle.load(open('cases/d43_full_pointbank_p105337.pkl','rb'));c=json.load(open('cases/d43_full_certificate_p105337.json'));V=b['variables'];pos={x:i for i,x in enumerate(V)};pt=c['point']['graph_156'];R=[L.translate(r,pt,p) for r in b['rows']];J=L.jacobian(b['rows'],V,pt,p);sr,sc=L.independent_minor(J,p);Ai=L.inverse_matrix([[J[i][j] for j in sc] for i in sr]);G=[]
for co in Ai:
 d={}

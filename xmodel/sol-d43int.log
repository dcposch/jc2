+        "ideal H=reduce(F,G);",
+        "int nonzero=0;",
+        "int terms=0;",
+        "int i;",
+        "for (i=1; i<=size(H); i++) {",
+        "  if (H[i] != 0) { nonzero=nonzero+1; terms=terms+size(H[i]); }",
+        "}",

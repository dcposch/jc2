 print(p, sorted(d), {k:type(v).__name__ for k,v in d.items()})
 print('rows',len(d['rows']), 'keys sample', list(d['rows'])[:2])
 row=next(iter(d['rows'].values()))
 print('row groups',len(row),'first deep',next(iter(row)) if row else None,'base terms',len(next(iter(row.values()))) if row else None)
 print('trace-like', [k for k in d if 'tr' in k.lower()], any(isinstance(v,dict) and any('tr' in str(x).lower() for x in v) for v in d.values()))
 del d

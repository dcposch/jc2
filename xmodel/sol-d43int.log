P22 = DR.GBVARS
NV = DR.NV
pack, unpack, degof = DR.pack, DR.unpack, DR.degof
nf_trace = DR.nf_trace

OCCX = ["x33", "x38", "x16", "x19", "x24", "x27"]   # occ_lift aliases,
# sorted-tail order tg01_46, tg02_46, tg1_43, tg1_46, tg2_43, tg2_46
SELVARS = ["A1r", "A2r", "h1r", "h2r"]

    80	t=gamma^(k+1),
    81	P_bar=P(t^(1/(k+1)),pi), Q_bar=Q(t^(1/(k+1)),pi),
    82	[P_bar,Q_bar]_(t,pi)=c/(k+1).                           (PU)

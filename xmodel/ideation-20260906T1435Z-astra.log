+print('D125_DIAGONAL_BLOCKS_PASS', both)
+print('RESTORED_GAUGE_CONTROLS_PASS', restore_constant[4], restore_p[4], restore_both[4])
+print('TOP_BRACKET_AND_SIGN_MUTATION_PASS')

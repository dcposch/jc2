+from __future__ import annotations
+
+import contextlib
+import hashlib
+import importlib.util
+import pathlib
+import sys
+
+
+ROOT = pathlib.Path("/home/ubuntu/jc2")
+OUT = ROOT / "box/k16t4-gate-20260903"

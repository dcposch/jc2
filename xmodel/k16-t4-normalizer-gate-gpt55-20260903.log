+#!/usr/bin/env python3
+"""Run the charged normalizer extractor for t=1..6 with lane-local paths."""
+
+from __future__ import annotations
+
+import contextlib
+import hashlib
+import importlib.util
+import pathlib
+import sys
+
+
+ROOT = pathlib.Path("/home/ubuntu/jc2")

# O1s/DET
E2=S['E2']; E1=S['E1']; C2=S['C2']; D1=S['D1']
O1s=8*s*C2*dz(r)-8*E2*(q*dz(r)-kappa/2)+4*s*(C1*dz(E1)-dz(C1)*E1)+6*D1*s*dz(s)-2*dz(D1)*s**2+4*Z*s*(q*dz(s)-dz(q)*s)
print('O1s_identity', norm(O1s-(s*R['O1']-4*E2*R['E0'])))
W=q*dz(s)-dz(q)*s
T=-(C1*dz(E1)-dz(C1)*E1)/2-sp.Rational(3,4)*D1*dz(s)+dz(D1)*s/4-Z*W/2

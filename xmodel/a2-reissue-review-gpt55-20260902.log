R0=q*dz(r)-s*dz(p)-kappa/2
R1=C1*dz(r)-E1*dz(p)+W/2
R2=C2*dz(r)-E2*dz(p)-T
DETmat=-sp.det(sp.Matrix([[q,-s,R0],[C1,-E1,R1],[C2,-E2,R2]]))
print('DET_EO_syzygy', norm(DET-DETmat))

C1=sp.Function('C1')(Z); q=sp.Function('q')(Z); r=sp.Function('r')(Z); G=sp.Function('G')(Z)

def dz(x,n=1): return sp.diff(x,Z,n)
def norm(x): return sp.cancel(sp.together(sp.expand(x)))
def coeff(x,n): return sp.Poly(sp.expand(x),A,domain='EX').nth(n)

def st(c1=C1,c5v=c5,sx=s):
    E2=b*Z*eta**2
    D2=a*Z*eta**3
    C2=Z*eta*(3*a*sx+c5v*eta)/(2*b)
    E1=dz(E2)+G
    D1=dz(D2)+sp.Rational(3,2)*a*eta*G/b
    return dict(C1=c1,C2=C2,D1=D1,D2=D2,E1=E1,E2=E2)

def eo(S):
    P=p+A*S['C1']+A**2*S['C2']
    Q=q+A*S['D1']+A**2*S['D2']
    R=r+A*S['E1']+A**2*S['E2']
    H=A+A**2*Z; chi=2+4*A*Z
    J=lambda X,Y: sp.diff(X,A)*dz(Y)-dz(X)*sp.diff(Y,A)
    WA=lambda X,Y: sp.diff(X,A)*Y-X*sp.diff(Y,A)
    WZ=lambda X,Y: dz(X)*Y-X*dz(Y)
    Even=2*A**2*(sp.diff(P,A)*s-Q*sp.diff(R,A))+4*H*(J(P,s)+J(Q,R))+chi*(Q*dz(R)-dz(P)*s)
    Odd=2*A**2*WA(Q,s)+4*J(P,R)+4*H*J(Q,s)-chi*WZ(Q,s)
    return sp.expand(Even),sp.expand(Odd)

def rows(S):
    C1x,C2,D1,D2,E1,E2=[S[k] for k in ('C1','C2','D1','D2','E1','E2')]
    return {
      'O0':4*(C1x*dz(r)-dz(p)*E1)+2*(q*dz(s)-dz(q)*s),

Next I’m running an independent capped-deviation generator for `e=1,2`. It derives the three s-free rows from the corrected source residuals, applies the `4e-1` cap, adds explicit Rabinowitsch rows for the main and `c=0` strata, then asks both SymPy and Singular whether the ideal is `(1)`.
exec
/bin/zsh -lc "python3 - <<'PY'
import sympy as sp, subprocess, time, textwrap, re, sys
A,Z=sp.symbols('A Z')
a,b,c5,kappa=sp.symbols('a b c5 kappa')
eta=sp.Function('eta')(Z); s=sp.Function('s')(Z); p=sp.Function('p')(Z)
C1=sp.Function('C1')(Z); q=sp.Function('q')(Z); r=sp.Function('r')(Z); G=sp.Function('G')(Z)
X=sp.Function('X')(Z); Y=sp.Function('Y')(Z)

def dz(x,n=1): return sp.diff(x,Z,n)
def norm(x): return sp.cancel(sp.together(sp.expand(x)))
def coeffs_in_Z(expr):
    poly=sp.Poly(sp.expand(expr),Z,domain='EX')
    if poly.is_zero: return []
    return [sp.expand(poly.nth(j)) for j in range(poly.degree()+1) if poly.nth(j)"'!=0]

def structure(c1_expr,c5v=0):
    E2=b*Z*eta**2; D2=a*Z*eta**3
    C2=Z*eta*(3*a*s+c5v*eta)/(2*b)
    E1=dz(E2)+G
    D1=dz(D2)+sp.Rational(3,2)*a*eta*G/b
    return C2,D1,D2,E1,E2,c1_expr

def residual_rows(c1_expr,c5v=0):
    C2,D1,D2,E1,E2,C1x=structure(c1_expr,c5v)
    EQ1=6*D1*dz(r)-4*dz(q)*E1+2*q*dz(E1)+4*C1x*dz(s)-2*dz(C1x)*s+4*Z*(q*dz(r)-dz(p)*s)
    EQ2=10*D2*dz(r)-8*dz(q)*E2+2*q*dz(E2)+6*D1*dz(E1)-4*dz(D1)*E1+2*C1x*s+8*C2*dz(s)-2*dz(C2)*s+8*Z*D1*dz(r)+4*Z*(q*dz(E1)-dz(q)*E1+C1x*dz(s)-dz(C1x)*s)-2*q*E1
    EQ3=4*C2*s-4*q*E2-2*D1*E1+6*D1*dz(E2)-8*dz(D1)*E2+10*D2*dz(E1)-4*dz(D2)*E1+Z*(8*C2*dz(s)-4*dz(C2)*s-8*dz(q)*E2+4*q*dz(E2)+8*D1*dz(E1)-4*dz(D1)*E1+12*D2*dz(r))
    return EQ1,EQ2,EQ3

def source_dev_rows():
    d=sp.Rational(3,2)*a/b
    c1_live=d*(dz(Z*eta)*s + s*G/(2*b*eta))
    EQ1,EQ2,EQ3=residual_rows(c1_live,0)
    rdev=(s**2+X)/(4*b*eta**2)
    qdev=(3*a*s**2+Y)/(4*b**2*eta)
    repl={r:rdev,q:qdev}
    # E0 turns q*r'"' - p'*s into kappa/2 in EQ1 only.
    C2,D1,D2,E1,E2,C1x=structure(c1_live,0)
    EQ1_mod=(6*D1*dz(r)-4*dz(q)*E1+2*q*dz(E1)+4*C1x*dz(s)-2*dz(C1x)*s+2*kappa*Z).subs(repl).doit()
    F1=norm(4*b**2*eta**2*EQ1_mod)
    F2=norm(2*b**2*eta**2*EQ2.subs(repl).doit())
    F3=norm(b*EQ3.subs(repl).doit())
    return F1,F2,F3

F_SOURCE=source_dev_rows()
print('source-derived deviation rows ready')

def make_box(e, branch):
    etas=sp.symbols(' '.join(f'eta{j}' for j in range(e)))
    if e==1: etas=(etas,)
    gs=sp.symbols(' '.join(f'G{j}' for j in range(2*e)))
    if 2*e==1: gs=(gs,)
    xs=sp.symbols(' '.join(f'X{j}' for j in range(4*e)))
    ys=sp.symbols(' '.join(f'Y{j}' for j in range(4*e)))
    kap,tt,c=sp.symbols('kappa tt c')
    eta_poly=sum(etas[j]*Z**j for j in range(e))+Z**e
    if branch=='main':
        ctop=c
        vars=tuple(etas)+tuple(gs)+tuple(xs)+tuple(ys)+(kap,tt,c)
        rab=kap*c*(c+2*e)*tt-1
        strat=f'c*kappa*(c+{2*e}) "'!= 0, c free'"'
    elif branch=='c0':
        ctop=sp.Integer(0)
        vars=tuple(etas)+tuple(gs)+tuple(xs)+tuple(ys)+(kap,tt)
        rab=kap*tt-1
        strat='c = 0, kappa "'!= 0'"'
    else:
        raise ValueError(branch)
    G_poly=sum(gs[j]*Z**j for j in range(2*e))+ctop*Z**(2*e)
    X_poly=sum(xs[j]*Z**j for j in range(4*e))
    Y_poly=sum(ys[j]*Z**j for j in range(4*e))
    subs={a:1,b:1,kappa:kap,eta:eta_poly,G:G_poly,X:X_poly,Y:Y_poly}
    rows=[]; degs=[]
    for F in F_SOURCE:
        row=norm(F.subs(subs).doit())
        num,den=sp.fraction(sp.together(row))
        if sp.expand(den)"'!=1:
            raise RuntimeError(f'"'uncleared denominator e={e} {branch}: {den}')
        row=sp.expand(num)
        degs.append(sp.Poly(row,Z,domain='EX').degree())
        rows.extend(coeffs_in_Z(row))
    rows.append(sp.expand(rab))
    return vars, rows, tuple(degs), strat

def sympy_unit(vars, gens):
    t=time.time()
    Gbasis=sp.groebner(gens,*vars,order='grevlex',domain=sp.QQ)
    elapsed=time.time()-t
    unit=(len(Gbasis.polys)==1 and Gbasis.polys[0].as_expr()==1)
    return unit, elapsed, len(Gbasis.polys), str(Gbasis.polys[0].as_expr()) if Gbasis.polys else '<empty>'

def sing_poly(expr, vars):
    poly=sp.Poly(expr,*vars,domain=sp.QQ)
    den, integral = poly.clear_denoms(convert=True)
    return sp.sstr(sp.expand(integral.as_expr())).replace('**','"'^'"')

def singular_unit(vars, gens):
    varlist=','.join(map(str,vars))
    genlist=',\\n'.join(sing_poly(g,vars) for g in gens)
    script=f\"\"\"ring R=0,({varlist}),dp;
option(redSB);
ideal I={genlist};
ideal S=std(I);
print(size(S));
print(S[1]);
quit;
\"\"\"
    t=time.time()
    proc=subprocess.run(['Singular','-q'],input=script,text=True,capture_output=True,timeout=120)
    elapsed=time.time()-t
    out=(proc.stdout+'\\n'+proc.stderr).strip()
    unit=bool(re.search(r'("'^|'"\\n)1\\s*(\\n|"'$)'"',out)) and proc.returncode==0
    return unit, elapsed, proc.returncode, out.splitlines()[-6:]


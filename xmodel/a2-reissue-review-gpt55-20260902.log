reg={a:1,b:1,eta:Z,G:Z**2,s:0,q:0,r:0}
print('T2_regression_corrected', norm((Z**2*Xi-3*a*br/b).subs(reg).doit()))
print('T2_regression_old', norm((Z**2*Xi-3*a*br_old/b).subs(reg).doit()))

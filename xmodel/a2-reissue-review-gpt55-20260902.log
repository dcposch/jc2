      'O2':4*(C1x*dz(E2)-2*dz(C1x)*E2+2*C2*dz(E1)-dz(C2)*E1)+10*D2*dz(s)-2*dz(D2)*s+2*D1*s+8*Z*D1*dz(s)-4*Z*dz(D1)*s,
      'E0':2*(q*dz(r)-dz(p)*s)-kappa,
      'EQ1_even':6*D1*dz(r)-4*dz(q)*E1+2*q*dz(E1)+4*C1x*dz(s)-2*dz(C1x)*s+4*Z*(q*dz(r)-dz(p)*s),
      'EQ2_even':10*D2*dz(r)-8*dz(q)*E2+2*q*dz(E2)+6*D1*dz(E1)-4*dz(D1)*E1+2*C1x*s+8*C2*dz(s)-2*dz(C2)*s+8*Z*D1*dz(r)+4*Z*(q*dz(E1)-dz(q)*E1+C1x*dz(s)-dz(C1x)*s)-2*q*E1,
      'EQ3_even':4*C2*s-4*q*E2-2*D1*E1+6*D1*dz(E2)-8*dz(D1)*E2+10*D2*dz(E1)-4*dz(D2)*E1+Z*(8*C2*dz(s)-4*dz(C2)*s-8*dz(q)*E2+4*q*dz(E2)+8*D1*dz(E1)-4*dz(D1)*E1+12*D2*dz(r))
    }
S=st(); Even,Odd=eo(S); R=rows(S)
source={'O0':coeff(Odd,0),'O1':coeff(Odd,1),'O2':coeff(Odd,2),'E0':coeff(Even,0)-kappa,'EQ1_even':coeff(Even,1),'EQ2_even':coeff(Even,2),'EQ3_even':coeff(Even,3)}
print('seven source-minus-row diffs:')
for name in ['O0','O1','O2','E0','EQ1_even','EQ2_even','EQ3_even']:
    print(name, norm(source[name]-R[name]))
old_eq2=R['EQ2_even']+2*q*S['E1']
print('actual_EQ2_minus_old_SPEC', norm(source['EQ2_even']-old_eq2))
print('minus_expected_-2qE1', norm(source['EQ2_even']-old_eq2 + 2*q*S['E1']))
print('high_coeffs', {'A3_Odd':norm(coeff(Odd,3)), 'A4_Even':norm(coeff(Even,4)), 'A5_Even':norm(coeff(Even,5))})

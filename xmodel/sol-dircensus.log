import re,sys,math
sys.path.insert(0,'cases')
from sheet6_campaign import tdu_rows
import book_enum as be
lines=open('xmodel/sol-dircensus.md').read().splitlines()
base=re.compile(r'\\[(\\d+);(\\d+),(\\d+),(\\d+)\\]')
exp=re.compile(r'"'^'"\\\\\\(\\"'^('"\\d+)\\\\\\)')
def packets(s):
    out=[]
    for m in base.finditer(s):
        L,a,b,n=map(int,m.groups()); z=exp.match(s[m.end():]); k=int(z.group(1)) if z else 1
        out += [(L,a,b,n)]*k
    return tuple(sorted(out))
S=[]; M=[]
for line in lines:
    if not re.match(r'"'^'"\\| [SM]\\d+ \\|',line): continue
    c=[x.strip() for x in line.strip('|').split('|')]
    ident=c[0]; td=int(c[1].split('/')[0]); al,bt=map(int,re.findall(r'\\d+',c[2]))
    ps=tuple(map(int,re.findall(r'\\d+',c[4])))
    assert sum(ps)==td,(ident,ps,td)
    row=(td,al,bt,packets(c[3]))
    (S if ident.startswith('S') else M).append(row)
expS=[]
for td in range(4,13):
  for (al,bt),(D,Dg),(P,Pg),nu,L in tdu_rows(td):
    a,b=D//al,P//al
    if b>=2 and math.gcd(a,nu)==1: expS.append((td,al,bt,((L,a,b,nu),)))
expM=[]
for td in range(6,13):
  for m in range(2,td//3+1):
    for al,bt,poles in be.entries(td,m): expM.append((td,al,bt,tuple(sorted(poles))))
assert sorted(S)==sorted(expS),(set(S)"'^set(expS))
assert sorted(M)==sorted(expM),(set(M)''^set(expM))
print(f'"'PASS: {len(S)} single-pole rows, {len(M)} multi-pole rows; every profile sums to td and every packet matches the filed generators')

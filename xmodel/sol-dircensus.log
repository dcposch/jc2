import re,sys,math
sys.path.insert(0,'cases')
from sheet6_campaign import tdu_rows
import book_enum as be
text=open('xmodel/sol-dircensus.md').read().splitlines()
pat=re.compile(r'\\[(\\d+);(\\d+),(\\d+),(\\d+)\\](?:\\\\\\(\\\\\\"'^('"\\d+)\\\\\\))?')
def packets(s):
    out=[]
    for L,a,b,n,k in pat.findall(s): out += [(int(L),int(a),int(b),int(n))]*int(k or 1)
    return tuple(sorted(out))
S=[]; M=[]
for line in text:
    if line.startswith('| S') or line.startswith('| M'):
        c=[x.strip() for x in line.strip('|').split('|')]
        ident=c[0]
        td=int(c[1].split('/')[0])
        al,bt=map(int,re.findall(r'\\d+',c[2]))
        ps=tuple(map(int,re.findall(r'\\d+',c[4])))
        assert sum(ps)==td,(ident,ps,td)
        row=(td,al,bt,packets(c[3]))
        (S if ident.startswith('S') else M).append(row)
expS=[]

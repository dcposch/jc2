+        fh.write("\t".join(["row", "parent", "partition", "unknowns", "equations", "deg_x_J", "mod_32003", "mod_32009", "mod_32027", "Q", "verdict"]) + "\n")
+        for rec in summary["strata"]:
+            by_char = {run["char"]: run["verdict"] for run in rec["runs"]}
+            vals = [
+                rec["row"]["label"],

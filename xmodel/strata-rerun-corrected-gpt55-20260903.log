+def xpoly_from_expr_trunc(expr, x, maxdeg: int):
+    poly = sp.Poly(sp.expand(expr), x)
+    out = [sp.Integer(0)] * (maxdeg + 1)
+    if poly.is_zero:
+        return out
+    for mon, coeff in poly.terms():
+        deg = int(mon[0])
+        if deg <= maxdeg:
+            out[deg] += coeff
+    return [sp.expand(v) for v in out]

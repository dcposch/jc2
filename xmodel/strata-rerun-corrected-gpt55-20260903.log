+def partitions(n: int, ceiling: int | None = None) -> Iterable[Tuple[int, ...]]:
+    if n == 0:
+        yield ()
+        return
+    top = n if ceiling is None else min(n, ceiling)
+    for first in range(top, 0, -1):
+        for tail in partitions(n - first, first):
+            yield (first,) + tail

+                rec = build_system(row, part)
+                summary["strata"].append({k: v for k, v in rec.items() if k not in {"eqs", "params", "T", "sat"}})
+        print(json.dumps(summary, indent=2, sort_keys=True, default=str))
+        return
+    print_summary(summary)

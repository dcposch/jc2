+            monomial_list_s([tuple(m) for m in comp["h_all"]["new_minus_old"]]),
+            monomial_list_s([tuple(m) for m in comp["beta"]["2"]["old_minus_new"]]),
+            monomial_list_s([tuple(m) for m in comp["beta"]["2"]["new_minus_old"]]),

                str(rec["equations"]),
                str(rec["sanity_gate"].get("deg_x_J")),
                by_char.get(32003, ""),
                by_char.get(32009, ""),
                by_char.get(32027, ""),
                by_char.get(0, ""),
                rec["verdict"],
            ]
            fh.write("\t".join(vals) + "\n")



+    out = []
+    for j in range(deg_y, -1, -1):
+        for i in range(0, deg_x + 1):
+            if total is not None and i + j > total:
+                continue
+            if order_allowed(delta1, threshold, i, j):
+                out.append((i, j))
+    return out

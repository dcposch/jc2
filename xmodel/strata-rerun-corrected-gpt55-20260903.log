+        "ring R=%d,(%s),dp;" % (char, ",".join(names)),
+        "option(redSB);",
+        'print("CONTROL_EMPTY_START");',
+        "ideal CE=(%s),%s*(%s)-1;" % (sat_s, T_s, sat_s),

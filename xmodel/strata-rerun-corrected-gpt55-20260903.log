+def relation(old: Sequence[Tuple[int, int]], new: Sequence[Tuple[int, int]]) -> dict:
+    os, ns = set(old), set(new)
+    if os == ns:
+        rel = "equal"
+    elif os <= ns:
+        rel = "old_subset_new"
+    elif ns <= os:
+        rel = "new_subset_old"
+    else:
+        rel = "incomparable"
+    return {
+        "relation": rel,
+        "old_count": len(old),
+        "new_count": len(new),
+        "old_minus_new": sorted(os - ns, key=lambda z: (-z[1], z[0])),
+        "new_minus_old": sorted(ns - os, key=lambda z: (-z[1], z[0])),
+    }

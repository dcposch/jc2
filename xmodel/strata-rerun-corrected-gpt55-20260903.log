    reports.append(("(15,10) V2=2 n_h=11", C2["n_h"] == 11, C2["n_h"]))
    reports.append(("(15,10) V2=2 n_h+4=15 [bracket]", C2["n_h"] + 4 == 15, C2["n_h"] + 4))
    reports.append(("(15,10) V2=2 (12) holds", C2["b12"] and not C2["b13"], (C2["b12"], C2["b13"])))


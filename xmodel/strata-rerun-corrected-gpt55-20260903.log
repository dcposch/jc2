+def xpoly_mul_trunc(a, b, maxdeg: int):
+    out = [sp.Integer(0)] * (maxdeg + 1)
+    for i, av in enumerate(a):
+        if av == 0:
+            continue
+        for j, bv in enumerate(b):
+            if i + j > maxdeg:

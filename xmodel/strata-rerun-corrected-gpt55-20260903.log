+                by_char.get(32027, ""),
+                by_char.get(0, ""),
+                rec["verdict"],
+            ]
+            fh.write("\t".join(vals) + "\n")
+
+
+def support_table_md(summary: dict, primary_only: bool) -> str:
+    rows = []
+    for comp in summary["support_comparison"]:

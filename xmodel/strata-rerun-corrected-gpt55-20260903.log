+        return {
+            "verdict": "TIMEOUT",
+            "elapsed": round(time.time() - started, 3),
+            "timeout": timeout,
+            "stdout_tail": (stdout or "")[-1600:],
+            "stderr_tail": (stderr or "")[-1600:],
+        }
+    output = (proc.stdout or "") + (proc.stderr or "")
+    parsed = parse_singular_output(output)
+    parsed.update({
+        "elapsed": round(time.time() - started, 3),
+        "rc": proc.returncode,
+        "stdout_tail": output[-1600:],

+def xpoly_pow_trunc(a, power: int, maxdeg: int):
+    out = [sp.Integer(1)] + [sp.Integer(0)] * maxdeg
+    base = list(a)
+    p = power
+    while p:
+        if p & 1:
+            out = xpoly_mul_trunc(out, base, maxdeg)
+        p >>= 1
+        if p:
+            base = xpoly_mul_trunc(base, base, maxdeg)
+    return out

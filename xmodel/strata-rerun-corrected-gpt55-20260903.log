+"""
+    REPORT.write_text(text)
+
+
+def run_all(timeout: int) -> dict:
+    if shutil.which("Singular") is None:
+        raise SystemExit("Singular not found")
+    manifest = manifest_check()
+    if not manifest["ok"]:

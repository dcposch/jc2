+
+def detail_diff_md(summary: dict) -> str:
+    chunks = []
+    for comp in summary["support_comparison"]:
+        if comp["row"]["key"] not in PRIMARY_KEYS:
+            continue
+        chunks.append("`%s`: h old-new = %s; h new-old = %s. beta_2 old-new = %s; beta_2 new-old = %s." % (

+        "partition_label": "+".join(map(str, part)),
+        "K": C["K"],
+        "u": C["u"],
+        "dprime": C["dprime"],
+        "eprime": C["eprime"],
+        "delta2": frac_s(C["delta2"]),
+        "delta1": frac_s(C["delta1"]),
+        "B": frac_s(C["bound_unit"]),
+        "top_face_factored": factored_face(row, part),
+        "slope_symbols": [str(s) for s in slopes],
+        "omega": str(omega),

+        by_char = {run["char"]: run for run in rec["runs"]}
+        rows.append("| `%s` | `%s` | %d | %d | %s | %s | %s | %s | %s | `%s` |" % (
+            rec["row"]["label"],
+            rec["partition_label"],
+            rec["unknowns"],
+            rec["equations"],
+            rec["sanity_gate"].get("deg_x_J"),
+            by_char[32003]["verdict"],
+            by_char[32009]["verdict"],
+            by_char[32027]["verdict"],
+            by_char[0]["verdict"],

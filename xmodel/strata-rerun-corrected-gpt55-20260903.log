+
+def run_table_md(records: Sequence[dict]) -> str:
+    rows = ["| row | stratum | unk | eq | deg_x J | 32003 | 32009 | 32027 | Q | verdict |",
+            "|---|---:|---:|---:|---:|---|---|---|---|---|"]

import sys, sympy as sp
out=sys.argv[1]; e=int(sys.argv[2]); z=sp.Symbol('Z')
eta_cs=sp.symbols(f'eta0:{e}')
g_cs=sp.symbols(f'G0:{2*e}')
x_cs=sp.symbols(f'X0:{4*e}')
y_cs=sp.symbols(f'Y0:{4*e}')
kappa,tt,c=sp.symbols('kappa tt c')
eta=sum(eta_cs[i]*z**i for i in range(e))+z**e
G=sum(g_cs[i]*z**i for i in range(2*e))+c*z**(2*e)
X=sum(x_cs[i]*z**i for i in range(4*e)); Y=sum(y_cs[i]*z**i for i in range(4*e))
d=lambda f:sp.diff(f,z)
N=lambda W:eta*d(W)-2*W*d(eta)
E1=d(z*eta**2)+G
V=2*z*eta**2*d(eta,2)-2*z*eta*d(eta)**2+2*eta**2*d(eta)-2*G*d(eta)+eta*d(G)
F1=8*z*kappa*eta**2+3*(3*E1-eta**2)*N(X)-4*E1*N(Y)+2*V*Y
A=3*z*(4*z*eta*d(eta)+3*eta**2+2*G)
B=-2*z*(2*z*eta*d(eta)+3*eta**2+G)
W2=4*z**2*eta**2*d(eta,2)+2*z*eta**2*d(eta)-2*z*G*d(eta)+2*z*eta*d(G)-G*eta
Psi2=6*eta**2*(4*z**2*eta**3*d(eta)*d(eta,2)-4*z**2*eta**2*d(eta)**3+4*z*eta**3*d(eta)**2+2*z*G*eta**2*d(eta,2)-6*z*G*eta*d(eta)**2+2*z*eta**2*d(G)*d(eta)+2*G*eta**2*d(eta)-2*G**2*d(eta)+G*eta*d(G))
F2=A*N(X)+B*N(Y)+W2*Y+Psi2
Xi0=12*eta**3*d(eta)*(d(eta)+2*z*d(eta,2))+12*eta*((eta*d(eta,2)-d(eta)**2)*G+eta*d(eta)*d(G))
K=eta*G**2+2*z*d(eta)*G**2-2*z*eta*G*d(G)
F3=z**2*Xi0+z**2*(3*N(X)-2*N(Y))-3*K
polys=[]
for F in (F1,F2,F3):
    P=sp.Poly(sp.expand(F),z)
    polys += [sp.expand(v) for v in reversed(P.all_coeffs()) if v "'!= 0]
polys.append(kappa*c*(c+2*e)*tt-1)
vars=list(eta_cs)+list(g_cs)+list(x_cs)+list(y_cs)+[kappa,tt,c]
with open(out+'"'/e1.ms','w') as f:
    f.write(','.join(map(str,vars))+'\\n0\\n')
    f.write(',\\n'.join(str(p).replace('**','"'^'"') for p in polys)+'\\n')
print(out)
print('vars',len(vars),'gens',len(polys),'degrees',[sp.Poly(F,z).degree() for F in (F1,F2,F3)])
print('bytes',__import__('os').path.getsize(out+'/e1.ms'))

+            raise
+        return {
+            "msolve_sha256": None,
+            "msolve_adapter": "unavailable; install msolveio==0.2.1 for payload emission",
+        }
+    return {
+        "msolve_sha256": hashlib.sha256(payload.encode()).hexdigest(),
+        "msolve_adapter": "msolveio==0.2.1",
+    }

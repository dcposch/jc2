+                "artifact": "SUBSYSTEM_POINT", "attainment": "NECESSARY",
+                "msolve_sha256": hashlib.sha256(payload.encode()).hexdigest(),
+            })
+        return 0
+
+    box = make_devbox(args.e, args.branch)
+    if args.format == "msolve":

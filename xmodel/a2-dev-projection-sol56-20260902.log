+  + 8Z D1 s' - 4Z D1' s = 0.
+
+E0:
+  2(q r' - p' s) - kappa = 0.
+
+EQ1_even:
+  6D1 r' - 4q' E1 + 2q E1'
+  + 4C1 s' - 2C1' s
+  + 4Z(q r' - p' s) = 0.
+
+EQ2_even:
+  10D2 r' - 8q' E2 + 2q E2'
+  + 6D1 E1' - 4D1' E1
+  + 2C1 s + 8C2 s' - 2C2' s
+  + 8Z D1 r'
+  + 4Z(q E1' - q' E1 + C1 s' - C1' s)
+  - 2q E1 = 0.

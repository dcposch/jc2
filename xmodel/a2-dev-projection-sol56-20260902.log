+EQ3_even:
+  4C2 s - 4q E2 - 2D1 E1
+  + 6D1 E2' - 8D1' E2
+  + 10D2 E1' - 4D2' E1
+  + Z(8C2 s' - 4C2' s - 8q' E2 + 4q E2'
+      + 8D1 E1' - 4D1' E1 + 12D2 r') = 0.

   396	    c_top = c if c_value is None else c_value
   397	    G_p = sum(g_cs[j] * Z**j for j in range(2 * e)) + c_top * Z**(2 * e)
   398	    X_p = sum(x_cs[j] * Z**j for j in range(4 * e))

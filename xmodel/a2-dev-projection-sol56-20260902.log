+AX = 3aZ(4Zb eta eta' + 3b eta^2 + 2G),
+AY = -2Z(2Zb eta eta' + 3b eta^2 + G),
+W2 = 4Z^2b eta^2 eta'' + 2Zb eta^2 eta'
+   - 2ZG eta' + 2Z eta G' - G eta,

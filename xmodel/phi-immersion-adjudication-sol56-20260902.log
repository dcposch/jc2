   391	N=18: (12, 6, 6,2)          N=21: (13, 8,5,3) (15,6, 9,2)
   392	N=19: (13, 6, 7,2)          N=22: (14, 8,6,3) (16,6,10,2)
   393	                            N=23: (13,10,3,4) (15,8,7,3) (17,6,11,2)

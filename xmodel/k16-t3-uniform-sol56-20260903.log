import importlib.util,re,sympy as sp
p='box/k16t3-20260903/generic/generic_order_system.py'
s=importlib.util.spec_from_file_location('g',p);g=importlib.util.module_from_spec(s);s.loader.exec_module(g)

def canon(d,expr):
 mp={}
 for v in d['params']:
  z=str(v)
  ma=re.fullmatch(r'a(\\d+)_(\\d+)',z)
  mq=re.fullmatch(r'q(\\d+)_(\\d+)',z)
  if ma: mp[v]=sp.Symbol(f'p{d[\"e\"]-int(ma.group(1))}_{ma.group(2)}')
  elif mq: mp[v]=sp.Symbol(f'u{d[\"q\"]-int(mq.group(1))}_{mq.group(2)}')
 return sp.expand(expr.xreplace(mp))
Ds={t:g.build(t,True) for t in (2,3,4,5)}
for H in range(0,5):
 print('H',H)
 for t,u in ((3,4),(4,5)):
  x=[(h,m,canon(Ds[t],e)) for h,m,e in Ds[t]['tagged'] if h<=H]
  y=[(h,m,canon(Ds[u],e)) for h,m,e in Ds[u]['tagged'] if h<=H]
  print(t,u,len(x),len(y),x==y)
PY" in /home/ubuntu/jc2

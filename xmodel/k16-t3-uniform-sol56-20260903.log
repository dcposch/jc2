#!/usr/bin/env python3
"""Prepare proof-preserving q4_1=1 and quadratic-field t=3 systems.

This driver starts from the already audited constant-pivot reduction, verifies
the positive grading on every residual generator, and uses the induced G_m
action to take the q4_1=1 slice on the c != 0 locus.  It then emits both:

* an exact-Q slice retaining a Rabinowitsch equation for the image of c; and
* an exact quadratic coefficient-field system over
  Q(y)/(147*y^2-84*y+11), where y=q7_1 and c is automatically a unit.

The optional quadratic-field affine pass divides only by explicitly checked
nonzero elements of that field.  Every inverse is verified modulo the
quadratic, and every pivot substitution is checked before it is accepted.
This program prepares Singular inputs but never invokes Singular.
"""

from __future__ import annotations

import dataclasses
import hashlib
import json
import math
import pathlib
import sys
import time

import sympy as sp


HERE = pathlib.Path(__file__).resolve().parent
ROOT = HERE.parents[2]
sys.path.insert(0, str(HERE))
import triangular_preprocess as tp  # noqa: E402


EXPECTED_TRIANGULAR_DRIVER_SHA256 = (
    "f2defb76d36172c541431b2fff04b34770438eef81167210fec404344fefbf93"
)

WEIGHTS = {
    "b1": 1,
    "b2": 2,
    "b3": 3,
    "b4": 4,
    "a1_0": 4,
    "a2_0": 8,
    "a4_0": 16,
    "a5_0": 20,
    "a6_0": 24,
    "a7_0": 28,
    "a8_0": 32,
    "a9_0": 36,
    "q2_0": 8,
    "q3_0": 12,
    "q4_0": 16,
    "q4_1": 13,
    "q5_0": 20,
    "q5_1": 17,
    "q6_0": 24,
    "q6_1": 21,
    "q7_0": 25,
    "q7_1": 26,
    "c": 65,
}


@dataclasses.dataclass
class SliceRow:
    source_index: int
    h_power: int
    monomial: tuple[int, int]
    expr: sp.Expr


@dataclasses.dataclass
class KPivot:
    step: int
    source_index: int
    h_power: int
    monomial: tuple[int, int]
    variable: sp.Symbol
    coefficient: sp.Expr
    inverse: sp.Expr
    step_rhs: sp.Expr
    remaining_rows_after: int
    expression_bytes_after: int


def sha256_file(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def weighted_degree(expr: sp.Expr, variables: list[sp.Symbol]) -> int:
    degrees = set()
    for monomial, _coefficient in sp.Poly(expr, *variables, domain=sp.QQ).terms():
        degrees.add(
            sum(exponent * WEIGHTS[str(variable)]
                for exponent, variable in zip(monomial, variables))
        )
    if len(degrees) != 1:
        raise AssertionError("row is not homogeneous: %s" % sorted(degrees))
    return degrees.pop()


def rational_associate(left: sp.Expr, right: sp.Expr,
                       variables: list[sp.Symbol]) -> sp.Rational | None:
    pleft = sp.Poly(left, *variables, domain=sp.QQ)
    pright = sp.Poly(right, *variables, domain=sp.QQ)
    if pleft.is_zero or pright.is_zero:
        return None
    ratio = sp.Rational(pleft.LC(), pright.LC())
    if (pleft - ratio * pright).is_zero:
        return ratio
    return None


def primitive_expr(expr: sp.Expr,
                   variables: list[sp.Symbol]) -> tuple[sp.Expr, sp.Rational]:
    poly, multiplier, _denominator, _content = (
        tp.primitive_integer_polynomial(expr, variables)
    )
    return poly.as_expr(), multiplier


def singular_expr(expr: sp.Expr, variables: list[sp.Symbol]) -> str:
    return tp.singular_polynomial(expr, variables)


def emit_actual_pair(lines: list[str]) -> None:
    lines.extend([
        "ring RAC=0,(gamma,pi),dp;",
        "poly FAC=pi;",
        "poly GAC=pi-(gamma^2)/2;",
        "poly JAC=diff(FAC,gamma)*diff(GAC,pi)-diff(FAC,pi)*diff(GAC,gamma);",
        'if (JAC==gamma) { print("CONTROL_ACTUAL_PAIR_PASS J=gamma"); }'
        ' else { print("CONTROL_ACTUAL_PAIR_FAIL"); }',
    ])


def emit_q_slice(rows: list[SliceRow], auxiliary: list[sp.Symbol], y: sp.Symbol,
                 method: str) -> str:
    if method not in ("std", "slimgb"):
        raise ValueError(method)
    T = sp.Symbol("T")
    variables = auxiliary + [y, T]
    polynomial_variables = auxiliary + [y]
    generators = [singular_expr(row.expr, polynomial_variables) for row in rows]
    # c = 10*y*(2-21*y)/343.  This primitive row is -343*(T*c-1).
    rab = 210 * T * y**2 - 20 * T * y + 343
    if sp.expand(rab + 343 * (T * 10 * y * (2 - 21*y) / 343 - 1)) != 0:
        raise AssertionError("slice Rabinowitsch image identity failed")
    generators.append(singular_expr(rab, variables))

    lines = [
        "// exact-Q normalized t=3 slice generated by t3_normalized_slice.py",
        "// q4_1=1 is existence-equivalent over Qbar on c!=0 by the verified grading",
        "// c=10*q7_1*(2-21*q7_1)/343; its nonvanishing is retained by T*c-1",
    ]
    emit_actual_pair(lines)
    lines.extend([
        "ring R=0,(%s),dp;" % ",".join(map(str, variables)),
        "option(redSB);",
        'if (nameof(basering)=="R") { print("CONTROL_RING_PASS R"); }'
        ' else { print("CONTROL_RING_FAIL"); }',
        'print("CONTROL_EMPTY_START");',
        "ideal CE=%s,T*%s-1;" % (y, y),
        "ideal GE=std(CE);",
        'if (typeof(GE)=="ideal" && nameof(basering)=="R")'
        ' { print("CONTROL_EMPTY_EXTRACT_RING_PASS"); }'
        ' else { print("CONTROL_EMPTY_EXTRACT_RING_FAIL"); }',
        'if (reduce(1,GE)==0) { print("CONTROL_EMPTY_PASS"); }'
        ' else { print("CONTROL_EMPTY_FAIL"); }',
        'print("CONTROL_NONEMPTY_START");',
        "ideal CN=%s-1,T*%s-1;" % (y, y),
        "ideal GN=std(CN);",
        'if (typeof(GN)=="ideal" && nameof(basering)=="R")'
        ' { print("CONTROL_NONEMPTY_EXTRACT_RING_PASS"); }'
        ' else { print("CONTROL_NONEMPTY_EXTRACT_RING_FAIL"); }',
        'if (reduce(1,GN)!=0) { print("CONTROL_NONEMPTY_PASS"); }'
        ' else { print("CONTROL_NONEMPTY_FAIL"); }',
        'print("MAIN_START t=3 normalized_q4_1=1 coefficient_field=Q '
        'slice_equations=%d chart_unknowns=%d plus_T=1");'
        % (len(rows), len(auxiliary) + 1),
        "ideal I=%s;" % ",\n".join(generators),
        "ideal G=%s(I);" % method,
        'print("MAIN_DONE basis_size=");',
        "size(G);",
        'if (reduce(1,G)==0) { print("MAIN_NORMALIZED_SLICE_EMPTY"); G; }'
        ' else { print("MAIN_NORMALIZED_SLICE_NONTRIVIAL");'
        ' print("BASIS_OUTPUT_TRUNCATED_TO_20");'
        ' int basis_cap=size(G); if (basis_cap>20) { basis_cap=20; }'
        ' for (int basis_i=1; basis_i<=basis_cap; basis_i++)'
        ' { G[basis_i]; } }',
        "quit;",
    ])
    return "\n".join(lines) + "\n"


class QuadraticField:
    def __init__(self, y: sp.Symbol, auxiliary: list[sp.Symbol]):
        self.y = y
        self.auxiliary = list(auxiliary)
        self.H = 147*y**2 - 84*y + 11
        self.domain = sp.QQ[tuple(self.auxiliary)]
        self.hpoly = sp.Poly(self.H, y, domain=self.domain)

    def reduce(self, expr: sp.Expr) -> sp.Expr:
        poly = sp.Poly(sp.expand(expr), self.y, domain=self.domain)
        return sp.expand(poly.rem(self.hpoly).as_expr())

    def inverse(self, coefficient: sp.Expr) -> sp.Expr:
        coefficient = self.reduce(coefficient)
        if coefficient.free_symbols - {self.y}:
            raise AssertionError("putative K coefficient contains chart variables")
        if coefficient == 0:
            raise ZeroDivisionError("zero coefficient in K")
        inverse = sp.invert(
            sp.Poly(coefficient, self.y, domain=sp.QQ),
            sp.Poly(self.H, self.y, domain=sp.QQ),
        ).as_expr()
        inverse = self.reduce(inverse)
        if self.reduce(coefficient * inverse - 1) != 0:
            raise AssertionError("quadratic-field inverse identity failed")
        return inverse


def field_associate(left: sp.Expr, right: sp.Expr, K: QuadraticField,
                    variables: list[sp.Symbol]) -> sp.Expr | None:
    """Return a in K* with left=a*right, or None.

    This is used only for exact duplicate removal and its identity is checked
    modulo H; it never guesses from names or leading monomials alone.
    """
    pleft = sp.Poly(left, *variables, domain=sp.QQ.frac_field(K.y))
    pright = sp.Poly(right, *variables, domain=sp.QQ.frac_field(K.y))


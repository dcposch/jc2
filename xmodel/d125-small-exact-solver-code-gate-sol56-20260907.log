+def must_reject(label, action, reasons):
+    try:
+        action()
+    except Exception as exc:
+        need(any(piece in str(exc) for piece in reasons), label + ': wrong rejection: ' + repr(exc))
+        return label
+    raise GateFailure(label + ': accepted corruption')

+def injected_failure(E, D, name):
+    V = ['x', 'y']
+    p = lambda text: E.polynomial(text, V)
+    if name == 'cofactor':
+        E.unit_certificate([p('x'), p('1-x')], [p('x'), p('1-x')], [p('2'), p('1')])
+    elif name == 'buchberger':

import sympy as s
x=s.symbols('x')
print('sympy',s.__version__)
def trunc_prod(types,deg):
    q=s.Integer(1)
    for weight in types:
        q=s.series(q/(1-x**weight),x,0,deg+1).removeO().expand()
    return q
# C includes one color at every positive K; subtract all-no-cusp term after multiplying.
def cell_poly(N,a):
    W=N-a; total=a-1
    C=trunc_prod(range(1,total+1),total)
    mb=[]
    for r in range(2,N+1):
        for K in range(1,total+1):
            if N-r*W-K>=0: mb.append((r,K))
    M=trunc_prod([K for r,K in mb],total)
    count=s.expand((C-1)*M).coeff(x,total)
    return W,mb,s.expand((C-1)*M),int(count)
for N in [5,6,7]:
    for a in range((N+1)//2,N-1):
        print(N,a,cell_poly(N,a))

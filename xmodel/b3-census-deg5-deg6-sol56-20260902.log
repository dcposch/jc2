        if len(p)+len(q)+len(r)==m+2:
         rows.append((p,q,r)); sig[tuple(sorted((len(p),len(q),len(r))))]+=1
    print('m',m,'P',len(ps),'bylen',dict(by))
    print('signatures',dict(sig),'rows',len(rows))
PY" in /tmp

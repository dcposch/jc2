from collections import defaultdict

def parts(n, hi=None):
    if n==0:
        yield ()
        return
    if hi is None or hi>n: hi=n
    for x in range(hi,0,-1):
        for rest in parts(n-x,x):
            yield (x,)+rest
for m in range(2,8):
    ps=list(parts(m))
    by=defaultdict(list)
    for p in ps: by[len(p)].append(p)
    sig=defaultdict(int)
    rows=[]
    for p in ps:
      for q in ps:

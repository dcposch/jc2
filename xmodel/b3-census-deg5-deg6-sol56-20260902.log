+| 2 | `1:{2}; 2:{11}` | `(1,1,2):3` | 3 |
+| 3 | `1:{3}; 2:{21}; 3:{111}` | `(1,1,3):3; (1,2,2):3` | 6 |
+| 4 | `1:{4}; 2:{31,22}; 3:{211}; 4:{1111}` | `(1,1,4):3; (1,2,3):12; (2,2,2):8` | 23 |

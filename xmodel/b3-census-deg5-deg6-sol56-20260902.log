from itertools import product

def parts(t, hi=None):
    if t == 0:
        yield ()
        return
    hi = min(t, t if hi is None else hi)
    for q in range(hi, 0, -1):
        for tail in parts(t-q, q):
            yield (q,) + tail

def census(N):
    for m in range(2,N+1):
        P=tuple(parts(m))
        for n in range(1,N//m+1):
            for L,R,D in product(P,repeat=3):
                if len(L)+len(R)+len(D)==m+2:
                    yield m,n,L,R,D
for N in (5,6):
    counts={}
    total=0
    for m,n,L,R,D in census(N):
        for p in L+R+D:
            counts[n*p]=counts.get(n*p,0)+1
            total+=1
    print(N,total,[counts[q] for q in range(1,N+1)],sum(v*v for v in counts.values()))

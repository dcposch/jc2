import sympy as sp
x=sp.symbols('x')
print('sympy',sp.__version__)
def trunc_prod(weights,deg):
    q=sp.Integer(1)
    for weight in weights:
        q=sp.series(q/(1-x**weight),x,0,deg+1).removeO().expand()
    return q

def cell_count(N,a):
    W=N-a; total=a-1
    C=trunc_prod(range(1,total+1),total)
    mb=[]
    for r in range(2,N+1):
        for K in range(1,total+1):
            if N-r*W-K>=0: mb.append((r,K))
    M=trunc_prod([K for r,K in mb],total)
    poly=sp.expand((C-1)*M)
    return W,mb,int(poly.coeff(x,total)),sp.series(poly,x,0,total+1)
for N in (5,6,7):
    print('N',N)
    for a in range((N+1)//2,N-1): print(' ',a,cell_count(N,a))

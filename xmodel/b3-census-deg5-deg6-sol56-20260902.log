from collections import Counter
from itertools import product

def parts(t,hi=None):
 if t==0: yield (); return
 hi=min(t,t if hi is None else hi)
 for q in range(hi,0,-1):
  for tail in parts(t-q,q): yield (q,)+tail
for N in (4,5,6,7):
 ports=Counter(); rows=0
 for m in range(2,N+1):
  P=tuple(parts(m))
  for n in range(1,N//m+1):
   for L,R,D in product(P,repeat=3):
    if len(L)+len(R)+len(D)==m+2:
     rows+=1
     for e in L+R+D: ports[n*e]+=1

import sys
from fractions import Fraction as Fr
from math import gcd

NUMAX, NPMAX = 24, 8      # chain-step caps (menu is nuF-independent)
CNUMAX, CLMAX = 48, 12    # merge-cell sweep caps
FAIL = []

def ok(cond, msg):
    print(('PASS ' if cond else 'FAIL ') + msg)
    if not cond:

def w_of(rho, nu, kap):
    return Fr(kap - rho, 1) / nu

# ----------------------------------------------------------- chain step
def chain_children(rho, nu, kap, numax=NUMAX, npmax=NPMAX):
    """All admissible M=1 single-orbit children (rhoF,nuF,kapF,n,npat)."""
    out = []

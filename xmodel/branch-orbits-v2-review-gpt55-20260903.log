    hit = set()
    for N in range(int(Nlo), int(Nhi) + 1):
        if bits & (1 << (N * D)):
            hit.add(N)
    return hit, False

# ---------------------------------------------------------------------------
# collect
# ---------------------------------------------------------------------------
def collect(n):
    G = {}
    for (m, Ms, V) in census(n, Kmin=16, full=True):
        S = Skel(n, m, list(Ms), V)
        key = (m, Ms, S.V[S.s])
        G.setdefault(key, []).append(S)
    return G

# ---------------------------------------------------------------------------

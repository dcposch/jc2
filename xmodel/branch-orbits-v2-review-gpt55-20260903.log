    scaled = [(w, int(c * D)) if False else (w, int(c * dens)) for (w, c) in items]
    D = dens
    NhiS = int(Nhi) * D
    mask = (1 << (NhiS + 1)) - 1
    reach = [0] * (u + 1)
    reach[0] = 1
    for (w, n) in scaled:
        if n > NhiS:
            continue
        for tw in range(w, u + 1):
            src = reach[tw - w]

def _fracsets(items, u, Nlo, Nhi, CAP):
    reach = [set() for _ in range(u + 1)]
    reach[0].add(F(0))
    nstates = 1
    capped = False
    for (w, c) in items:
        for tw in range(w, u + 1):
            if not reach[tw - w]:

   154	def census(n, Kmin=16, with_V=True, full=False):
   155	    """(1)-(7) [+ (8)-(13) if full] enumeration at degree n = deg g.
   156	       Yields (m, (M_2..M_s), {i: V_i}).  full=True prunes with (10)/(11) inside the
   157	       recursion and applies (12)/(13) at the bottom."""

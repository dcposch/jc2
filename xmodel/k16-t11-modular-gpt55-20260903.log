    flags=[s for s in ['FULL_UNIT','B4ONE_FULL_UNIT','TOP_TAIL_UNIT','B4ZERO_FULL_UNIT','FULL_NONUNIT','B4ONE_FULL_NONUNIT','TOP_TAIL_NONUNIT','B4ZERO_FULL_NONUNIT','RECURRENCE_PASS','DRIVER_DONE'] if s in text]
    return flags
records=[]
for p in sorted(base.glob('*.json')):
    if p.name in ('good_prime_audit.json','status_summary.json'): continue
    try: meta=json.loads(p.read_text())

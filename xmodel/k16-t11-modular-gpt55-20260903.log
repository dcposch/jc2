choices={7:[47,1009,1031,1033],8:[59,1009,1031,1033],11:[53,1009,1031,1033]}
summary={}
for t, primes in choices.items():
    rows=[]
    for p in primes:
        roots=mod.roots(t,p)
        piv=[]
        for branch,y in enumerate(roots):
            zero=[]
            for w in range(1,2*t+2):
                try:
                    c=mod.closed_pivot(t,w,y,p)%p
                except Exception as e:
                    zero.append({'weight':w,'error':str(e)})
                    continue
                if c==0:
                    zero.append({'weight':w,'coefficient':0})
            piv.append({'branch':branch,'y':y,'zero_pivots':zero})
        rows.append({'prime':p,'roots':roots,'distinct_two_roots':len(roots)==2,'pivot_checks':piv,'good':len(roots)==2 and all(not x['zero_pivots'] for x in piv)})
    summary[str(t)]=rows
print(json.dumps({'typing':'good-prime audit: H_t split roots and nonzero closed pivots (2.10)-(2.12)','choices':summary}, indent=2, sort_keys=True))

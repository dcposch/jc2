    if not p.name.startswith(('terminal_t','top_tail_fast')): continue
    status=meta.get('status') or meta.get('run',{}).get('status')
    elapsed=meta.get('elapsed_seconds') or meta.get('run',{}).get('elapsed_seconds')
    records.append({

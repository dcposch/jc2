        'algorithm':meta.get('algorithm'),'status':status,'elapsed_seconds':elapsed,
        'flags':run_flags(meta)})
artifacts=[]
for p in sorted(base.iterdir()):
    if p.is_file(): artifacts.append({'name':p.name,'bytes':p.stat().st_size,'sha256':sha(p)})

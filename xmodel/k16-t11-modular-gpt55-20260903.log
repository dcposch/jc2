def run_flags(meta):
    out=None
    if 'stdout' in meta: out=pathlib.Path(meta['stdout'])
    elif isinstance(meta.get('run'), dict): out=pathlib.Path(meta['run'].get('out',''))
    text=''
    if out and str(out):
        if not out.is_absolute(): out=base/out

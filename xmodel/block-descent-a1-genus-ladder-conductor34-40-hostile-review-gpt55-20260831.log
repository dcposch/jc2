def gcds(seq):
    out=[seq[0]]
    for x in seq[1:]:
        out.append(math.gcd(out[-1], x))
    return tuple(out)

def semigroup_contains(gens, value):
    seen=[False]*(value+1)
    seen[0]=True
    for n in range(value+1):
        if not seen[n]:
            continue
        for g in gens:
            m=n+g
            if m<=value:
                seen[m]=True
    return seen[value]

def conductor(seq):
    d=gcds(seq)
    return 1 - seq[0] + sum((d[i-1]//d[i]-1)*seq[i] for i in range(1,len(seq)))

def valid(seq):
    if len(seq)<2 or any(x<=0 for x in seq): return False
    d=gcds(seq)
    if d[-1]"'!=1: return False
    if not (seq[0] > seq[1] > d[1]): return False
    if any(d[i-1] <= d[i] for i in range(1,len(d))): return False
    for i in range(1,len(seq)):
        e=d[i-1]//d[i]
        if not semigroup_contains(seq[:i], e*seq[i]): return False
    for i in range(1,len(seq)-1):
        if seq[i]*d[i-1] <= seq[i+1]*d[i]: return False
    return True

@functools.lru_cache(None)
def enum(C):
    ans=set()
    for a in range(1, math.isqrt(C)+1):
        if C%a: continue
        for x,y in ((a,C//a),(C//a,a)):
            s=(x+1,y+1)
            if valid(s) and conductor(s)==C:
                ans.add(s)
    for rh in range(2, max(2,C-1)):
        for dh in range(2, C//(rh-1)+2):
            if math.gcd(dh,rh)!=1: continue
            rem=C-(dh-1)*(rh-1)
            if rem<=0 or rem%dh: continue
            Cp=rem//dh
            if not (0<Cp<C): continue
            for p in enum(Cp):
                s=tuple(dh*v for v in p)+(rh,)
                if valid(s) and conductor(s)==C:
                    ans.add(s)
    return tuple(sorted(ans))


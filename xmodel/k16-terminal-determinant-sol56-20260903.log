x=s.symbols('x')
vals={}
for t in range(3,21):
 vals[t]=s.Rational(solve(t)['norm3'])
print('computed')
for step,label in [(1,'all'),(2,'odd'),(2,'even')]:
 starts=list(range(3 if label"'!='"'even' else 4,21-step,step))
 data=[(t,s.cancel(vals[t+step]/vals[t])) for t in starts]
 print(label,'ratios',len(data))
 for trainn in range(4,len(data)):
  found=[]
  for deg in range(trainn):
   f=s.factor(s.rational_interpolate(data[:trainn],deg,X=x))
   if all(s.cancel(f.subs(x,t)-v)==0 for t,v in data[trainn:]):
    found.append((deg,s.factor(f)))
  if found:
   print(' train',trainn,'found',found[:2]); break
PY" in /home/ubuntu/jc2

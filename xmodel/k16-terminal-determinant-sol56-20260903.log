+ F0= 7(16b3-35)/640,
+ F1=-7(88b3-295)/640.
+
+d=+1, y=2/5:
+ F0=-18(287156086b3^2-27046560b3+106639425)/74352915125,
+ F1=-14(1189646642b3^2+304374720b3-1207034325)/371764575625. (3.3)

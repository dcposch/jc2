diff --git a/box/k16det-20260903/top_tail/probe_top_tail.py b/box/k16det-20260903/top_tail/probe_top_tail.py
index 365213621875b3785b6225f4ff5d1e3fb924bac0..beb667fad751f60798ad08594abe0dad1b444708
--- a/box/k16det-20260903/top_tail/probe_top_tail.py
+++ b/box/k16det-20260903/top_tail/probe_top_tail.py
@@ -68,7 +68,9 @@
     injected = "\n".join([
         f"ideal J={generators};",

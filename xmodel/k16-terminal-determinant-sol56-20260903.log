@@ -68,7 +68,9 @@
     injected = "\n".join([
         f"ideal J={generators};",
         "ideal GJ=std(J);",
-        'print("PROBE_DIM"); dim(GJ); vdim(GJ); size(GJ);',
+        'print("PROBE_DIM"); int PROBE_D=dim(GJ); PROBE_D;',
+        'if (PROBE_D!=0) { print("PROBE_NOT_ZERO_DIMENSION"); quit; }',
+        "vdim(GJ); size(GJ);",
         "ideal KB=kbase(GJ);",

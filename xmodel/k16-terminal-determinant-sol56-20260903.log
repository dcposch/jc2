  names=['b3','b4']+[f'q{i}_0' for i in range(2,t)]+[f'q{2*t+1}_1']
  loc={n:s.Symbol(n) for n in names}
  ex=s.sympify(row['expr'],locals=loc)
  sub={loc['b3']:0,loc['b4']:0}
  for i in range(2,t):
   if i "'!= j: sub[loc[f'"'q{i}_0']]=0
  coeff=s.Poly(s.expand(ex.subs(sub)),loc[f'q{j}_0']).coeff_monomial(loc[f'q{j}_0']**power)
  d=s.Symbol('d'); y=loc[f'q{2*t+1}_1']; coeff=s.cancel(coeff.subs(y,(d+t+1)/(2*(2*t+1))))
  num,den=s.fraction(coeff); coeff=s.cancel(s.rem(num,3*d*d-(t+1),domain=s.QQ)/den)
  expected=s.Rational(val.a.numerator,val.a.denominator)*d+s.Rational(val.b.numerator,val.b.denominator)
  print('t,j,power,band',t,j,power,band,'match',s.cancel(coeff-expected)==0,flush=True)

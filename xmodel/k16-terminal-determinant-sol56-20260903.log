 v,_=solve(T,T-1)
 a=s.Rational(v.a.numerator,v.a.denominator); bb=s.Rational(v.b.numerator,v.b.denominator)
 assert s.cancel(ns['lam'].a.subs(ns['t'],T)-a)==0
 assert s.cancel(ns['lam'].b.subs(ns['t'],T)-bb)==0
 print(T,'PASS')

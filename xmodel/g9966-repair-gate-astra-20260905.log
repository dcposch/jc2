    35	def sha256(path: Path) -> str:
    36	    digest = hashlib.sha256()
    37	    with path.open("rb") as handle:
    38	        for block in iter(lambda: handle.read(1024 * 1024), b""):
    39	            digest.update(block)
    40	    return digest.hexdigest()

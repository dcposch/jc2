   227	               for _tag, row in tagged_rows)
   228	
   229	    raw_by_band = Counter(tag[0] for tag, _row in tagged_rows)
   230	    pivot_by_band = Counter(tag[0] for tag, *_rest in pivots)
   231	    cumulative_rank = 0
   232	    ledger = []

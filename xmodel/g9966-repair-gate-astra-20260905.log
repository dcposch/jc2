    97	
    98	def qstar_reduce(
    99	    tagged_rows: list[tuple[tuple[int, int], sp.Expr]],
   100	    variables: list[sp.Symbol],
   101	) -> tuple[
   102	    list[tuple[tuple[int, int], sp.Expr]],
   103	    list[sp.Symbol],
   104	    list[tuple[tuple[int, int], sp.Symbol, sp.Rational, sp.Expr]],
   105	]:
   106	    """Deterministically eliminate only affine pivots in Q*."""
   107	    rows = list(tagged_rows)
   108	    remaining = list(variables)
   109	    pivots = []
   110	    while True:
   111	        choice = None
   112	        for row_index, (tag, expression) in enumerate(rows):
   113	            for variable_index, variable in enumerate(remaining):
   114	                coefficient = sp.expand(sp.diff(expression, variable))
   115	                remainder = sp.expand(expression - coefficient * variable)
   116	                if (
   117	                    coefficient.is_Rational
   118	                    and coefficient != 0
   119	                    and variable not in remainder.free_symbols
   120	                ):
   121	                    choice = (
   122	                        row_index,
   123	                        variable_index,
   124	                        tag,
   125	                        variable,
   126	                        sp.Rational(coefficient),
   127	                        remainder,
   128	                    )
   129	                    break
   130	            if choice is not None:
   131	                break
   132	        if choice is None:
   133	            break
   134	        row_index, variable_index, tag, variable, coefficient, remainder = choice
   135	        rhs = sp.expand(-remainder / coefficient)
   136	        assert sp.expand(rows[row_index][1].subs(variable, rhs)) == 0
   137	        pivots.append((tag, variable, coefficient, rhs))
   138	        del rows[row_index]
   139	        del remaining[variable_index]
   140	        reduced_rows = []
   141	        for old_tag, expression in rows:
   142	            image = sp.expand(expression.subs(variable, rhs))
   143	            if image != 0:
   144	                reduced_rows.append((old_tag, image))
   145	        rows = reduced_rows
   146	    return rows, remaining, pivots
   147	
   148	
   149	def resolve_pivots(
   150	    pivots: list[tuple[tuple[int, int], sp.Symbol, sp.Rational, sp.Expr]]
   151	) -> dict[sp.Symbol, sp.Expr]:
   152	    resolved: dict[sp.Symbol, sp.Expr] = {}
   153	    pivot_variables = {pivot[1] for pivot in pivots}
   154	    for _tag, variable, _coefficient, rhs in reversed(pivots):
   155	        image = sp.expand(rhs.subs(resolved, simultaneous=True))
   156	        assert not image.free_symbols.intersection(pivot_variables)
   157	        resolved[variable] = image
   158	    return resolved
   159	
   160	
   161	def build_major_K():
   162	    x, w = sp.symbols("x w")
   163	    K = w**3 * (w - 1) ** 8
   164	    parameters = []
   165	    support = []
   166	    for r in range(1, 12):
   167	        cap = 11 - r
   168	        vanish_at_one = max(0, ceil((33 - 3 * r) / 4))
   169	        for degree in range(vanish_at_one, cap + 1):
   170	            coefficient = sp.Symbol(f"c_{r}_{degree}")
   171	            parameters.append(coefficient)
   172	            support.append((r, degree, vanish_at_one))
   173	            K += (
   174	                coefficient
   175	                * x**r
   176	                * (w - 1) ** vanish_at_one
   177	                * w ** (degree - vanish_at_one)
   178	            )
   179	    K = sp.expand(K)
   180	    assert len(parameters) == 21
   181	    return x, w, K, parameters, support
   182	
   183	
   184	def delta2_probe(x, w, K, parameters):
   185	    z, a, u = sp.symbols("z a u")
   186	    H = sp.expand(z**2 * (z + 3 * a))
   187	    expansion = sp.Poly(sp.expand(K.subs(w, u * x**2 + x**3 * z)), x, z)
   188	    tagged_rows = []
   189	    for x_degree in range(10):
   190	        for z_degree in range(12):
   191	            coefficient = expansion.coeff_monomial(x**x_degree * z**z_degree)
   192	            target = H.coeff(z, z_degree) if x_degree == 9 else 0
   193	            equation = sp.expand(coefficient - target)
   194	            if equation != 0:
   195	                tagged_rows.append(((x_degree, z_degree), equation))
   196	
   197	    residual, free, pivots = qstar_reduce(tagged_rows, parameters)
   198	    resolved = resolve_pivots(pivots)
   199	    assert not residual
   200	    assert [str(item) for item in free] == ["c_7_4", "c_10_1", "c_11_0"]
   201	    assert len(tagged_rows) == len(pivots) == 18
   202	    assert all(
   203	        sp.expand(expression.subs(resolved, simultaneous=True)) == 0
   204	        for _tag, expression in tagged_rows
   205	    )
   206	
   207	    # Exact shared h-jet in the straightened u=0 slice.  In particular the
   208	    # fixed W_3 and W_6 used by the branch-B lift are recovered mechanically.
   209	    straight = sp.expand(

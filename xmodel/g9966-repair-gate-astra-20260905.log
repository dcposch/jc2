    77	def laurent_coefficients(expression: sp.Expr, variable: sp.Symbol) -> dict[int, sp.Expr]:
    78	    """Return an exact exponent -> coefficient map, allowing negative powers."""
    79	    answer: dict[int, sp.Expr] = {}
    80	    for term in sp.Add.make_args(sp.expand(expression)):
    81	        exponent = int(term.as_powers_dict().get(variable, 0))
    82	        answer[exponent] = sp.expand(
    83	            answer.get(exponent, 0) + term / variable**exponent
    84	        )
    85	    return answer

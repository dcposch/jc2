    88	def polynomial_rows(
    89	    expression: sp.Expr, variable: sp.Symbol, outer_tag: int
    90	) -> list[tuple[tuple[int, int], sp.Expr]]:
    91	    return [
    92	        ((outer_tag, monomial[0]), sp.expand(coefficient))
    93	        for monomial, coefficient in sp.Poly(sp.expand(expression), variable).terms()
    94	        if coefficient != 0
    95	    ]

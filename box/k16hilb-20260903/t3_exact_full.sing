// Closed Laurent/Euler recurrence; T[k]=[X^k]E.
ring R=(0,yy),(h,s,b1,b2,b3,b4,B0,C1,C2,q2_0,q3_0,q4_0,q5_0,q6_0),dp;
minpoly=588*yy^2-336*yy+44;
option(redSB);
proc hcoef(poly f, int k)
{
  matrix M=coef(f,h); int ii;
  for (ii=1; ii<=ncols(M); ii++)
  { if (M[1,ii]==h^k) { return(M[2,ii]); } }
  return(0);
}
proc eulerInverse(poly f)
{
  matrix M=coef(f,s); poly answer=0; int ii; int mm;
  for (ii=1; ii<=ncols(M); ii++)
  { mm=deg(M[1,ii]); answer=answer+M[2,ii]*M[1,ii]/((2*mm+1)*yy); }
  return(answer);
}
number g1=10/7;
number g2=(10/7)*yy+(30/98);
number g3=(30/49)*yy-(120/2058);
number cc=-yy*g3;
poly Uh=h^7+q2_0*h^5+q3_0*h^4+q4_0*h^3+q5_0*h^2+q6_0*h^1;
poly Ch=h^2+C1*h^1+C2*h^0;
poly U=subst(Uh,h,s+b4);
poly Cp=subst(Ch,h,s+b4);
poly A=s*Cp;
poly Bprime=g3*(5*Cp+3*s*diff(Cp,s))/(2*yy);
matrix MB=coef(Bprime,s); poly B=B0; int ii; int mm;
for (ii=1; ii<=ncols(MB); ii++)
{ mm=deg(MB[1,ii]); B=B+MB[2,ii]*s*MB[1,ii]/(mm+1); }
if (diff(B,s)-Bprime!=0) { ERROR("B derivative"); }
poly rhsD=3*g3*diff(U,s)+A*B-s*A*diff(B,s)+2*s*diff(A,s)*B+g3*b3*(A/s+(5/2)*diff(A,s));
poly D=eulerInverse(rhsD);
if (yy*(D+2*s*diff(D,s))-rhsD!=0) { ERROR("Euler inverse"); }
poly Q1=s*A-yy*b3; poly Y=s*D-b3*B-g3*b2; poly Z=s*B-g3*b3;
poly numD1=yy*g3*b1-Q1*diff(Y,s)+diff(Q1,s)*Y+2*diff(U,s)*Z;
poly constantS=subst(numD1,s,0); poly pb1=diff(constantS,b1);
poly b1rhs=-subst(constantS,b1,0)/pb1;
numD1=subst(numD1,b1,b1rhs);
if (subst(numD1,s,0)!=0) { ERROR("b1 divisibility"); }
poly Xprime=numD1/(2*yy*s);
poly gauge=hcoef(subst(Xprime,s,h-b4),6);
poly pB0=diff(gauge,B0); poly B0rhs=-subst(gauge,B0,0)/pB0;
B=subst(B,B0,B0rhs); D=subst(D,B0,B0rhs);
Y=subst(Y,B0,B0rhs); Z=subst(Z,B0,B0rhs);
Xprime=subst(Xprime,B0,B0rhs); b1rhs=subst(b1rhs,B0,B0rhs);
if (subst(gauge,B0,B0rhs)!=0) { ERROR("B0 gauge"); }
poly RR=Q1*Xprime-diff(U,s)*Y-yy*g3;
poly Rh=subst(RR,s,h-b4);
poly W1=hcoef(Rh,12);
poly p1=diff(W1,C1);
poly v1rhs=-subst(W1,C1,0)/p1;
if (subst(W1,C1,v1rhs)!=0) { ERROR("pivot 1"); }
Rh=subst(Rh,C1,v1rhs);
poly W2=hcoef(Rh,11);
poly p2=diff(W2,C2);
poly v2rhs=-subst(W2,C2,0)/p2;
if (subst(W2,C2,v2rhs)!=0) { ERROR("pivot 2"); }
Rh=subst(Rh,C2,v2rhs);
poly W3=hcoef(Rh,10);
poly p3=diff(W3,q3_0);
poly v3rhs=-subst(W3,q3_0,0)/p3;
if (subst(W3,q3_0,v3rhs)!=0) { ERROR("pivot 3"); }
Rh=subst(Rh,q3_0,v3rhs);
poly W4=hcoef(Rh,9);
poly p4=diff(W4,q4_0);
poly v4rhs=-subst(W4,q4_0,0)/p4;
if (subst(W4,q4_0,v4rhs)!=0) { ERROR("pivot 4"); }
Rh=subst(Rh,q4_0,v4rhs);
poly W5=hcoef(Rh,8);
poly p5=diff(W5,q5_0);
poly v5rhs=-subst(W5,q5_0,0)/p5;
if (subst(W5,q5_0,v5rhs)!=0) { ERROR("pivot 5"); }
Rh=subst(Rh,q5_0,v5rhs);
poly W6=hcoef(Rh,7);
poly p6=diff(W6,q6_0);
poly v6rhs=-subst(W6,q6_0,0)/p6;
if (subst(W6,q6_0,v6rhs)!=0) { ERROR("pivot 6"); }
Rh=subst(Rh,q6_0,v6rhs);
poly W7=hcoef(Rh,6);
poly p7=diff(W7,b2);
poly v7rhs=-subst(W7,b2,0)/p7;
if (subst(W7,b2,v7rhs)!=0) { ERROR("pivot 7"); }
Rh=subst(Rh,b2,v7rhs);
if (hcoef(Rh,6)!=0) { ERROR("high band 6"); }
if (hcoef(Rh,7)!=0) { ERROR("high band 7"); }
if (hcoef(Rh,8)!=0) { ERROR("high band 8"); }
if (hcoef(Rh,9)!=0) { ERROR("high band 9"); }
if (hcoef(Rh,10)!=0) { ERROR("high band 10"); }
if (hcoef(Rh,11)!=0) { ERROR("high band 11"); }
if (hcoef(Rh,12)!=0) { ERROR("high band 12"); }
if (hcoef(Rh,13)!=0) { ERROR("high band 13"); }
poly T0=-hcoef(Rh,0);
poly T1=-hcoef(Rh,1);
poly T2=-hcoef(Rh,2);
poly T3=-hcoef(Rh,3);
poly T4=-hcoef(Rh,4);
poly T5=-hcoef(Rh,5);
ideal RAW=T0,T1,T2,T3,T4,T5;
ring S=(0,yy),(b4,q2_0,b3),wp(1,2,4);
minpoly=588*yy^2-336*yy+44;
ideal TT=imap(R,RAW);
setring R; ideal BACK=imap(S,TT); int jj;
for (jj=1; jj<=size(RAW); jj++)
{ if (BACK[jj]-RAW[jj]!=0) { ERROR("residual ring map"); } }
setring S; option(redSB);
intvec WTS=1,2,4;
print("META t=3 vars=b4,q2_0,b3 weights=1,2,4");
if (homog(TT[2])!=1) { ERROR("inhomogeneous T1"); }
if (deg(TT[2])!=12) { ERROR("degree T1"); }
if (homog(TT[3])!=1) { ERROR("inhomogeneous T2"); }
if (deg(TT[3])!=11) { ERROR("degree T2"); }
if (homog(TT[4])!=1) { ERROR("inhomogeneous T3"); }
if (deg(TT[4])!=10) { ERROR("degree T3"); }
if (homog(TT[5])!=1) { ERROR("inhomogeneous T4"); }
if (deg(TT[5])!=9) { ERROR("degree T4"); }
if (homog(TT[6])!=1) { ERROR("inhomogeneous T5"); }
if (deg(TT[6])!=8) { ERROR("degree T5"); }
ideal J=TT[2],TT[3],TT[4],TT[5],TT[6];
print("FULL_ROWS=1,2,3,4,5");
int tm=timer; ideal G=std(J);
print("FULL_STD_SECONDS="+string(timer-tm));
print("FULL_GB_SIZE="+string(size(G)));
print("FULL_DIM="+string(dim(G)));
print("FULL_HILB_NUMERATOR_BEGIN");
intvec HNUM=hilb(G,1,WTS); HNUM;
print("FULL_HILB_NUMERATOR_END");
print("FULL_HILB_REDUCED_BEGIN");
intvec HRED=hilb(G,2,WTS); HRED;
print("FULL_HILB_REDUCED_END");
if (dim(G)==0) { print("FULL_LENGTH="+string(vdim(G))); }
ideal LM=minbase(lead(G)); ideal GLM=std(LM);
print("FULL_INITIAL_MIN_GENS_BEGIN"); LM;
print("FULL_INITIAL_MIN_GENS_END");
int foundb4=0; int powb4;
for (powb4=1; powb4<=128; powb4++)
{ if (reduce(b4^powb4,GLM)==0) { foundb4=powb4; break; } }
print("FULL_PURE_POWER b4="+string(foundb4));
int foundq20=0; int powq20;
for (powq20=1; powq20<=128; powq20++)
{ if (reduce(q2_0^powq20,GLM)==0) { foundq20=powq20; break; } }
print("FULL_PURE_POWER q2_0="+string(foundq20));
int foundb3=0; int powb3;
for (powb3=1; powb3<=128; powb3++)
{ if (reduce(b3^powb3,GLM)==0) { foundb3=powb3; break; } }
print("FULL_PURE_POWER b3="+string(foundb3));
print("JOB_DONE t=3 label=FULL");
quit;

ring R=(13),(b4,q2_0),wp(1,2);
poly D1=11*(11*b4^9+8*b4^7*q2_0^1+1*b4^5*q2_0^2+8*b4^3*q2_0^3+11*b4^1*q2_0^4) - 10*b4^1*(8*b4^8+11*b4^6*q2_0^1+10*b4^4*q2_0^2+6*b4^2*q2_0^3+4*q2_0^4);
poly D2=11*(4*b4^10+9*b4^8*q2_0^1+1*b4^6*q2_0^2+7*b4^4*q2_0^3+5*b4^2*q2_0^4) - 6*b4^2*(8*b4^8+11*b4^6*q2_0^1+10*b4^4*q2_0^2+6*b4^2*q2_0^3+4*q2_0^4);
ideal I=D1,D2;
print("size D1="+string(size(D1))+" deg="+string(deg(D1)));
print("size D2="+string(size(D2))+" deg="+string(deg(D2)));
ideal G=std(I); print("dim="+string(dim(G))); if(dim(G)==0){print("vdim="+string(vdim(G)));}
ideal C0=8*b4^8+11*b4^6*q2_0^1+10*b4^4*q2_0^2+6*b4^2*q2_0^3+4*q2_0^4; print("cbar0 terms="+string(size(C0)));
quit;

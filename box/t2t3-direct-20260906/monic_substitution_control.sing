// Small exact-Q control for acyclic monic unit-leader substitution.
//
// Semantic variables: x,y.  Graph leaders: u,v,w, topologically defined by
//   u=x+y, v=u*x+1, w=v+y^2.
// Replacing u,v,w in downstream rows by their recursive semantic expressions
// must preserve the extended ideal once the three graph definitions remain.

option(redSB);
ring R=0,(w,v,u,x,y),(lp(3),dp(2));

poly du=u-x-y;
poly dv=v-u*x-1;
poly dw=w-v-y2;
ideal D=du,dv,dw;

// Two representative downstream constraints in the circuit presentation.
poly r1=w+u*y-3;
poly r2=v*y-x2;
ideal Icircuit=D,r1,r2;

// Recursive substitution into the semantic variables only.
poly su=x+y;
poly sv=x*su+1;
poly sw=sv+y2;
poly q1=subst(subst(subst(r1,w,sw),v,sv),u,su);
poly q2=subst(subst(subst(r2,w,sw),v,sv),u,su);
ideal Idirect=D,q1,q2;

print("CONTROL_RING="+string(basering));
print("GRAPH_LEADERS="+string(lead(du))+","+string(lead(dv))+","+string(lead(dw)));
print("GRAPH_LEADCOEFS="+string(leadcoef(du))+","+string(leadcoef(dv))+","+string(leadcoef(dw)));
print("SUBSTITUTED_ROWS="+string(q1)+","+string(q2));

ideal Gc=std(Icircuit);
ideal Gd=std(Idirect);
int circuit_in_direct=(size(reduce(Icircuit,Gd))==0);
int direct_in_circuit=(size(reduce(Idirect,Gc))==0);
int proper_circuit=(reduce(1,Gc)<>0);
int failures=0;

// Positive control: mutual containment proves equality in the extended ring.
if ((circuit_in_direct<>1) || (direct_in_circuit<>1) || (proper_circuit<>1))
{
  print("MONIC_SUBSTITUTION_POSITIVE=FAIL");
  failures=failures+1;
}
else
{
  print("MONIC_SUBSTITUTION_POSITIVE=PASS");
}

// Each definition must really expose its designated leader with coefficient 1.
if ((lead(du)<>u) || (lead(dv)<>v) || (lead(dw)<>w) ||
    (leadcoef(du)<>1) || (leadcoef(dv)<>1) || (leadcoef(dw)<>1))
{
  print("UNIT_LEADER_CHECK=FAIL");
  failures=failures+1;
}
else
{
  print("UNIT_LEADER_CHECK=PASS");
}

// The graph variables disappear entirely: the semantic elimination ideal of
// the circuit is exactly the ideal generated by q1,q2.
ideal E=eliminate(Gc,w*v*u);
ideal Q=q1,q2;
ideal Ge=std(E);
ideal Gq=std(Q);
int elimination_forward=(size(reduce(E,Gq))==0);
int elimination_reverse=(size(reduce(Q,Ge))==0);
if ((elimination_forward<>1) || (elimination_reverse<>1))
{
  print("SEMANTIC_ELIMINATION_CHECK=FAIL");
  failures=failures+1;
}
else
{
  print("SEMANTIC_ELIMINATION_CHECK=PASS");
}

// Negative control: changing one substituted row by 1 must be detected.
ideal Iwrong=D,q1+1,q2;
ideal Gw=std(Iwrong);
int wrong_forward=(size(reduce(Icircuit,Gw))==0);
int wrong_reverse=(size(reduce(Iwrong,Gc))==0);
if ((wrong_forward==1) && (wrong_reverse==1))
{
  print("MONIC_SUBSTITUTION_NEGATIVE=FAIL_FALSE_ACCEPT");
  failures=failures+1;
}
else
{
  print("MONIC_SUBSTITUTION_NEGATIVE=PASS_REJECTED_PERTURBATION");
}

if (failures==0)
{
  print("CONTROL_RESULT=PASS");
}
else
{
  print("CONTROL_RESULT=FAIL failures="+string(failures));
}
quit;

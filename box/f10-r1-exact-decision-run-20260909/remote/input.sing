if(nrows(U)!=1 || ncols(U)!=1 || nrows(T)!=20 || ncols(T)!=1){print("ERROR|lift dimensions");quit;}
print("BRANCH|UNIT");
emitpoly(U[1,1],"U");
for(i=1;i<=20;i++){emitpoly(T[i,1],"T/"+string(i-1));}
}else{
print("BRANCH|PROPER");
int index=0;
for(i=1;i<=size(G);i++){if(G[i]!=0){emitpoly(G[i]/leadcoef(G[i]),"G/"+string(index));index++;}}
}
print("DONE");
quit;

ring R=0,(z,b4,b3),dp;
ideal Ipos=192*b3^2*b4^2 - 8960*b3*b4^5 + 28925*b4^8,-16*b3*b4^4 + 35*b4^7,88*b3*b4^3 - 295*b4^6;

ideal GR=std(Rab);
printf("T2_CONE branch=0 y=1/5 RABINOWITSCH_tau_in_radical=%s", (size(GR)==1 && GR[1]==1));
ideal Ifull=-19200*b3^2*b4^3 + 191000*b3*b4^6 - 406875*b4^9 - 1024,192*b3^2*b4^2 - 8960*b3*b4^5 + 28925*b4^8,-16*b3*b4^4 + 35*b4^7,88*b3*b4^3 - 295*b4^6;

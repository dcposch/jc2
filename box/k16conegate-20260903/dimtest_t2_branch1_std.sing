ring R=0,(b4,b3),wp(1,3);
option(redSB);
ideal I=-30500078563*b3^2*b4^2 - 17702528580*b3*b4^5 + 59091781800*b4^8,
287156086*b3^2*b4 - 27046560*b3*b4^4 + 106639425*b4^7,
1189646642*b3^2 + 304374720*b3*b4^3 - 1207034325*b4^6;

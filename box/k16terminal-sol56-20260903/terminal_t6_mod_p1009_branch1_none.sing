if (subst(W10,q10_0,v10rhs)!=0) { print("FAIL pivot 10"); exit(2); }
Rh=subst(Rh,q10_0,v10rhs);
print("PIVOT weight=10 band=15 variable=q10_0"); p10;
poly W11=hcoef(Rh,14);
poly p11=diff(W11,q11_0);
poly v11rhs=-subst(W11,q11_0,0)/p11;
if (subst(W11,q11_0,v11rhs)!=0) { print("FAIL pivot 11"); exit(2); }
Rh=subst(Rh,q11_0,v11rhs);
print("PIVOT weight=11 band=14 variable=q11_0"); p11;
poly W12=hcoef(Rh,13);
poly p12=diff(W12,q12_0);
poly v12rhs=-subst(W12,q12_0,0)/p12;
if (subst(W12,q12_0,v12rhs)!=0) { print("FAIL pivot 12"); exit(2); }
Rh=subst(Rh,q12_0,v12rhs);
print("PIVOT weight=12 band=13 variable=q12_0"); p12;
poly W13=hcoef(Rh,12);
poly p13=diff(W13,b2);
poly v13rhs=-subst(W13,b2,0)/p13;
if (subst(W13,b2,v13rhs)!=0) { print("FAIL pivot 13"); exit(2); }
Rh=subst(Rh,b2,v13rhs);
print("PIVOT weight=13 band=12 variable=b2"); p13;
if (hcoef(Rh,12)!=0) { print("FAIL high band 12"); exit(2); }
if (hcoef(Rh,13)!=0) { print("FAIL high band 13"); exit(2); }

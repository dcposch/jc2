if (subst(W5,C5,v5rhs)!=0) { print("FAIL pivot 5"); exit(2); }
Rh=subst(Rh,C5,v5rhs);
print("PIVOT weight=5 band=20 variable=C5"); p5;
poly W6=hcoef(Rh,19);
poly p6=diff(W6,q6_0);
poly v6rhs=-subst(W6,q6_0,0)/p6;
if (subst(W6,q6_0,v6rhs)!=0) { print("FAIL pivot 6"); exit(2); }
Rh=subst(Rh,q6_0,v6rhs);
print("PIVOT weight=6 band=19 variable=q6_0"); p6;
poly W7=hcoef(Rh,18);

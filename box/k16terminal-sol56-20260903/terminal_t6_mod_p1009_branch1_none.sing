if (subst(W4,C4,v4rhs)!=0) { print("FAIL pivot 4"); exit(2); }
Rh=subst(Rh,C4,v4rhs);
print("PIVOT weight=4 band=21 variable=C4"); p4;
poly W5=hcoef(Rh,20);

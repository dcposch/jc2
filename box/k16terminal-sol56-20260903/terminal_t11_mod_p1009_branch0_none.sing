if (hcoef(Rh,43)!=0) { print("FAIL high band 43"); exit(2); }
if (hcoef(Rh,44)!=0) { print("FAIL high band 44"); exit(2); }
if (hcoef(Rh,45)!=0) { print("FAIL high band 45"); exit(2); }
poly T0=-hcoef(Rh,0);
print("TERMINAL band=0"); deg(T0); size(T0);
poly T1=-hcoef(Rh,1);
print("TERMINAL band=1"); deg(T1); size(T1);
poly T2=-hcoef(Rh,2);
print("TERMINAL band=2"); deg(T2); size(T2);

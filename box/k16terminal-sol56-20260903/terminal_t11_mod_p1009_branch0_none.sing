// Generated Laurent/Euler terminal recurrence.
// t=11 mode=mod branch=0 charts=none
ring R=1009,(h,s,b1,b2,b3,b4,B0,C1,C2,C3,C4,C5,C6,C7,C8,C9,C10,q2_0,q3_0,q4_0,q5_0,q6_0,q7_0,q8_0,q9_0,q10_0,q11_0,q12_0,q13_0,q14_0,q15_0,q16_0,q17_0,q18_0,q19_0,q20_0,q21_0,q22_0),dp;
number yy=439;
option(redSB);
proc hcoef(poly f, int k)
{
  matrix M=coef(f,h);
  int ii;
  for (ii=1; ii<=ncols(M); ii++)
  { if (M[1,ii]==h^k) { return(M[2,ii]); } }
  return(0);
}
proc eulerInverse(poly f)
{
  matrix M=coef(f,s);
  poly answer=0; int ii; int mm;
  for (ii=1; ii<=ncols(M); ii++)
  { mm=deg(M[1,ii]); answer=answer+M[2,ii]*M[1,ii]/((2*mm+1)*yy); }
  return(answer);
}
number g1=34/23;
number g2=(34/23)*yy+(374/1058);
number g3=(374/529)*yy-(4488/73002);
number cc=-yy*g3;
poly Uh=h^23+q2_0*h^21+q3_0*h^20+q4_0*h^19+q5_0*h^18+q6_0*h^17+q7_0*h^16+q8_0*h^15+q9_0*h^14+q10_0*h^13+q11_0*h^12+q12_0*h^11+q13_0*h^10+q14_0*h^9+q15_0*h^8+q16_0*h^7+q17_0*h^6+q18_0*h^5+q19_0*h^4+q20_0*h^3+q21_0*h^2+q22_0*h^1;
poly Ch=h^10+C1*h^9+C2*h^8+C3*h^7+C4*h^6+C5*h^5+C6*h^4+C7*h^3+C8*h^2+C9*h^1+C10*h^0;
poly U=subst(Uh,h,s+b4);
poly Cp=subst(Ch,h,s+b4);
poly A=s*Cp;
poly Bprime=g3*(5*Cp+3*s*diff(Cp,s))/(2*yy);
matrix MB=coef(Bprime,s);
poly B=B0; int ii; int mm;
for (ii=1; ii<=ncols(MB); ii++)
{ mm=deg(MB[1,ii]); B=B+MB[2,ii]*s*MB[1,ii]/(mm+1); }
if (diff(B,s)-Bprime!=0) { print("FAIL B derivative"); exit(2); }
poly rhsD=3*g3*diff(U,s)+A*B-s*A*diff(B,s)+2*s*diff(A,s)*B
          +g3*b3*(A/s+(5/2)*diff(A,s));
poly D=eulerInverse(rhsD);
if (yy*(D+2*s*diff(D,s))-rhsD!=0) { print("FAIL Euler inverse"); exit(2); }
poly Q1=s*A-yy*b3;
poly Y=s*D-b3*B-g3*b2;
poly Z=s*B-g3*b3;
poly numD1=yy*g3*b1-Q1*diff(Y,s)+diff(Q1,s)*Y+2*diff(U,s)*Z;
poly constantS=subst(numD1,s,0);
poly pb1=diff(constantS,b1);
poly b1rhs=-subst(constantS,b1,0)/pb1;
numD1=subst(numD1,b1,b1rhs);
if (subst(numD1,s,0)!=0) { print("FAIL b1 divisibility"); exit(2); }
poly Xprime=numD1/(2*yy*s);
poly gauge=hcoef(subst(Xprime,s,h-b4),22);
poly pB0=diff(gauge,B0);
poly B0rhs=-subst(gauge,B0,0)/pB0;
B=subst(B,B0,B0rhs);
D=subst(D,B0,B0rhs);
Y=subst(Y,B0,B0rhs);
Z=subst(Z,B0,B0rhs);
Xprime=subst(Xprime,B0,B0rhs);
b1rhs=subst(b1rhs,B0,B0rhs);
if (subst(gauge,B0,B0rhs)!=0) { print("FAIL B0 gauge"); exit(2); }
// RR is -E.  The requested terminal row is T[k]=-hcoef(RR,h,k).
poly RR=Q1*Xprime-diff(U,s)*Y-yy*g3;
poly Rh=subst(RR,s,h-b4);
poly W1=hcoef(Rh,44);
poly p1=diff(W1,C1);
poly v1rhs=-subst(W1,C1,0)/p1;
if (subst(W1,C1,v1rhs)!=0) { print("FAIL pivot 1"); exit(2); }
Rh=subst(Rh,C1,v1rhs);
print("PIVOT weight=1 band=44 variable=C1"); p1;
poly W2=hcoef(Rh,43);
poly p2=diff(W2,C2);
poly v2rhs=-subst(W2,C2,0)/p2;
if (subst(W2,C2,v2rhs)!=0) { print("FAIL pivot 2"); exit(2); }
Rh=subst(Rh,C2,v2rhs);
print("PIVOT weight=2 band=43 variable=C2"); p2;
poly W3=hcoef(Rh,42);
poly p3=diff(W3,C3);
poly v3rhs=-subst(W3,C3,0)/p3;
if (subst(W3,C3,v3rhs)!=0) { print("FAIL pivot 3"); exit(2); }
Rh=subst(Rh,C3,v3rhs);
print("PIVOT weight=3 band=42 variable=C3"); p3;
poly W4=hcoef(Rh,41);
poly p4=diff(W4,C4);
poly v4rhs=-subst(W4,C4,0)/p4;
if (subst(W4,C4,v4rhs)!=0) { print("FAIL pivot 4"); exit(2); }
Rh=subst(Rh,C4,v4rhs);
print("PIVOT weight=4 band=41 variable=C4"); p4;
poly W5=hcoef(Rh,40);
poly p5=diff(W5,C5);
poly v5rhs=-subst(W5,C5,0)/p5;
if (subst(W5,C5,v5rhs)!=0) { print("FAIL pivot 5"); exit(2); }
Rh=subst(Rh,C5,v5rhs);
print("PIVOT weight=5 band=40 variable=C5"); p5;
poly W6=hcoef(Rh,39);
poly p6=diff(W6,C6);
poly v6rhs=-subst(W6,C6,0)/p6;
if (subst(W6,C6,v6rhs)!=0) { print("FAIL pivot 6"); exit(2); }
Rh=subst(Rh,C6,v6rhs);
print("PIVOT weight=6 band=39 variable=C6"); p6;
poly W7=hcoef(Rh,38);
poly p7=diff(W7,C7);
poly v7rhs=-subst(W7,C7,0)/p7;
if (subst(W7,C7,v7rhs)!=0) { print("FAIL pivot 7"); exit(2); }
Rh=subst(Rh,C7,v7rhs);
print("PIVOT weight=7 band=38 variable=C7"); p7;
poly W8=hcoef(Rh,37);
poly p8=diff(W8,C8);
poly v8rhs=-subst(W8,C8,0)/p8;
if (subst(W8,C8,v8rhs)!=0) { print("FAIL pivot 8"); exit(2); }
Rh=subst(Rh,C8,v8rhs);
print("PIVOT weight=8 band=37 variable=C8"); p8;
poly W9=hcoef(Rh,36);
poly p9=diff(W9,C9);
poly v9rhs=-subst(W9,C9,0)/p9;
if (subst(W9,C9,v9rhs)!=0) { print("FAIL pivot 9"); exit(2); }
Rh=subst(Rh,C9,v9rhs);
print("PIVOT weight=9 band=36 variable=C9"); p9;
poly W10=hcoef(Rh,35);
poly p10=diff(W10,C10);
poly v10rhs=-subst(W10,C10,0)/p10;
if (subst(W10,C10,v10rhs)!=0) { print("FAIL pivot 10"); exit(2); }
Rh=subst(Rh,C10,v10rhs);
print("PIVOT weight=10 band=35 variable=C10"); p10;
poly W11=hcoef(Rh,34);
poly p11=diff(W11,q11_0);
poly v11rhs=-subst(W11,q11_0,0)/p11;
if (subst(W11,q11_0,v11rhs)!=0) { print("FAIL pivot 11"); exit(2); }
Rh=subst(Rh,q11_0,v11rhs);
print("PIVOT weight=11 band=34 variable=q11_0"); p11;
poly W12=hcoef(Rh,33);
poly p12=diff(W12,q12_0);
poly v12rhs=-subst(W12,q12_0,0)/p12;
if (subst(W12,q12_0,v12rhs)!=0) { print("FAIL pivot 12"); exit(2); }
Rh=subst(Rh,q12_0,v12rhs);
print("PIVOT weight=12 band=33 variable=q12_0"); p12;
poly W13=hcoef(Rh,32);
poly p13=diff(W13,q13_0);
poly v13rhs=-subst(W13,q13_0,0)/p13;
if (subst(W13,q13_0,v13rhs)!=0) { print("FAIL pivot 13"); exit(2); }
Rh=subst(Rh,q13_0,v13rhs);
print("PIVOT weight=13 band=32 variable=q13_0"); p13;
poly W14=hcoef(Rh,31);
poly p14=diff(W14,q14_0);
poly v14rhs=-subst(W14,q14_0,0)/p14;
if (subst(W14,q14_0,v14rhs)!=0) { print("FAIL pivot 14"); exit(2); }
Rh=subst(Rh,q14_0,v14rhs);
print("PIVOT weight=14 band=31 variable=q14_0"); p14;
poly W15=hcoef(Rh,30);
poly p15=diff(W15,q15_0);
poly v15rhs=-subst(W15,q15_0,0)/p15;
if (subst(W15,q15_0,v15rhs)!=0) { print("FAIL pivot 15"); exit(2); }
Rh=subst(Rh,q15_0,v15rhs);
print("PIVOT weight=15 band=30 variable=q15_0"); p15;
poly W16=hcoef(Rh,29);
poly p16=diff(W16,q16_0);
poly v16rhs=-subst(W16,q16_0,0)/p16;
if (subst(W16,q16_0,v16rhs)!=0) { print("FAIL pivot 16"); exit(2); }
Rh=subst(Rh,q16_0,v16rhs);
print("PIVOT weight=16 band=29 variable=q16_0"); p16;
poly W17=hcoef(Rh,28);
poly p17=diff(W17,q17_0);
poly v17rhs=-subst(W17,q17_0,0)/p17;
if (subst(W17,q17_0,v17rhs)!=0) { print("FAIL pivot 17"); exit(2); }
Rh=subst(Rh,q17_0,v17rhs);
print("PIVOT weight=17 band=28 variable=q17_0"); p17;
poly W18=hcoef(Rh,27);
poly p18=diff(W18,q18_0);
poly v18rhs=-subst(W18,q18_0,0)/p18;
if (subst(W18,q18_0,v18rhs)!=0) { print("FAIL pivot 18"); exit(2); }
Rh=subst(Rh,q18_0,v18rhs);
print("PIVOT weight=18 band=27 variable=q18_0"); p18;
poly W19=hcoef(Rh,26);
poly p19=diff(W19,q19_0);
poly v19rhs=-subst(W19,q19_0,0)/p19;
if (subst(W19,q19_0,v19rhs)!=0) { print("FAIL pivot 19"); exit(2); }
Rh=subst(Rh,q19_0,v19rhs);
print("PIVOT weight=19 band=26 variable=q19_0"); p19;
poly W20=hcoef(Rh,25);
poly p20=diff(W20,q20_0);
poly v20rhs=-subst(W20,q20_0,0)/p20;
if (subst(W20,q20_0,v20rhs)!=0) { print("FAIL pivot 20"); exit(2); }
Rh=subst(Rh,q20_0,v20rhs);
print("PIVOT weight=20 band=25 variable=q20_0"); p20;
poly W21=hcoef(Rh,24);
poly p21=diff(W21,q21_0);
poly v21rhs=-subst(W21,q21_0,0)/p21;
if (subst(W21,q21_0,v21rhs)!=0) { print("FAIL pivot 21"); exit(2); }
Rh=subst(Rh,q21_0,v21rhs);
print("PIVOT weight=21 band=24 variable=q21_0"); p21;
poly W22=hcoef(Rh,23);
poly p22=diff(W22,q22_0);
poly v22rhs=-subst(W22,q22_0,0)/p22;
if (subst(W22,q22_0,v22rhs)!=0) { print("FAIL pivot 22"); exit(2); }
Rh=subst(Rh,q22_0,v22rhs);
print("PIVOT weight=22 band=23 variable=q22_0"); p22;
poly W23=hcoef(Rh,22);
poly p23=diff(W23,b2);
poly v23rhs=-subst(W23,b2,0)/p23;
if (subst(W23,b2,v23rhs)!=0) { print("FAIL pivot 23"); exit(2); }
Rh=subst(Rh,b2,v23rhs);
print("PIVOT weight=23 band=22 variable=b2"); p23;
if (hcoef(Rh,22)!=0) { print("FAIL high band 22"); exit(2); }
if (hcoef(Rh,23)!=0) { print("FAIL high band 23"); exit(2); }
if (hcoef(Rh,24)!=0) { print("FAIL high band 24"); exit(2); }

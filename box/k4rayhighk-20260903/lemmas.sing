poly Rw = r0*x^30*y^0 + r1*x^29*y^1 + r2*x^28*y^2 + r3*x^27*y^3 + r4*x^26*y^4 + r5*x^25*y^5 + r6*x^24*y^6 + r7*x^23*y^7 + r8*x^22*y^8;
poly Jw = diff(Hw,x)*diff(Rw,y)-diff(Hw,y)*diff(Rw,x);
matrix Cw = coef(Jw,x*y); ideal Iw; int iw;
for(iw=1;iw<=ncols(Cw);iw++){ Iw=Iw+ideal(Cw[2,iw]); }
ideal Gw = std(Iw); int okw = 1;
if (reduce(r0,Gw)!=0) { okw = 0; }
if (reduce(r1,Gw)!=0) { okw = 0; }
if (reduce(r2,Gw)!=0) { okw = 0; }
if (reduce(r3,Gw)!=0) { okw = 0; }
if (reduce(r4,Gw)!=0) { okw = 0; }
if (reduce(r5,Gw)!=0) { okw = 0; }
if (reduce(r6,Gw)!=0) { okw = 0; }
if (reduce(r7,Gw)!=0) { okw = 0; }
if (reduce(r8,Gw)!=0) { okw = 0; }
print("V3_INJ K=9 d=30 nvars 9 only_trivial "+string(okw));
kill Rv_9_30;

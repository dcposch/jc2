ring R6 = 0,(x,y,mu),dp;
poly P6 = mu*y^4*(y-x); poly A6 = mu^2*(y-x); poly H6 = y^8*(y-x);
poly chk6 = P6^2 - A6*H6;
poly J6 = diff(P6,x)*diff(A6,y)-diff(P6,y)*diff(A6,x);
print("V6_K9B5 P2minusAH "+string(chk6)+" JPA "+string(J6)+" resid "+string(J6 - 4*mu^3*y^3*(y-x)));

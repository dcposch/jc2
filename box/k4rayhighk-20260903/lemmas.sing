poly Rw = r0*x^15*y^0 + r1*x^14*y^1 + r2*x^13*y^2 + r3*x^12*y^3;
poly Jw = diff(Hw,x)*diff(Rw,y)-diff(Hw,y)*diff(Rw,x);
matrix Cw = coef(Jw,x*y); ideal Iw; int iw;
for(iw=1;iw<=ncols(Cw);iw++){ Iw=Iw+ideal(Cw[2,iw]); }
ideal Gw = std(Iw); int okw = 1;
if (reduce(r0,Gw)!=0) { okw = 0; }
if (reduce(r1,Gw)!=0) { okw = 0; }
if (reduce(r2,Gw)!=0) { okw = 0; }
if (reduce(r3,Gw)!=0) { okw = 0; }
print("V3_INJ K=4 d=15 nvars 4 only_trivial "+string(okw));

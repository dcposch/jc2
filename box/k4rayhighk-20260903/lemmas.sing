poly Rw = r0*x^14*y^0 + r1*x^13*y^1 + r2*x^12*y^2 + r3*x^11*y^3 + r4*x^10*y^4 + r5*x^9*y^5 + r6*x^8*y^6 + r7*x^7*y^7 + r8*x^6*y^8;
poly Jw = diff(Hw,x)*diff(Rw,y)-diff(Hw,y)*diff(Rw,x);
matrix Cw = coef(Jw,x*y); ideal Iw; int iw;
for(iw=1;iw<=ncols(Cw);iw++){ Iw=Iw+ideal(Cw[2,iw]); }

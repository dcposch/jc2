option(redSB); short=0;
// k-ray chart K=5 Bdeg=4 char=0 target=x^4
ring R = 0,(x,y,h_0_0,h_1_0,h_2_0,h_3_0,h_4_0,h_0_1,h_1_1,h_2_1,h_3_1,h_0_2,h_1_2,h_2_2,h_0_3,h_1_3,h_0_4,B_0_0,B_1_0,B_2_0,B_3_0,B_4_0,B_0_1,B_1_1,B_2_1,B_3_1,B_0_2,B_1_2,B_2_2,B_0_3,B_1_3,B_0_4),dp;
proc quoy(poly p, poly hh, int K)
{ poly q=0; poly ld; matrix cp; int d;
  while(1){ if(p==0){break;} cp=coeffs(p,y); d=nrows(cp)-1; if(d<K){break;}
    ld=cp[d+1,1]; q=q+ld*y^(d-K); p=p-ld*y^(d-K)*hh; } return(q); }
poly h = y^4*(y-x) + h_0_0*x^0*y^0 + h_1_0*x^1*y^0 + h_2_0*x^2*y^0 + h_3_0*x^3*y^0 + h_4_0*x^4*y^0 + h_0_1*x^0*y^1 + h_1_1*x^1*y^1 + h_2_1*x^2*y^1 + h_3_1*x^3*y^1 + h_0_2*x^0*y^2 + h_1_2*x^1*y^2 + h_2_2*x^2*y^2 + h_0_3*x^0*y^3 + h_1_3*x^1*y^3 + h_0_4*x^0*y^4;
poly B = B_0_0*x^0*y^0 + B_1_0*x^1*y^0 + B_2_0*x^2*y^0 + B_3_0*x^3*y^0 + B_4_0*x^4*y^0 + B_0_1*x^0*y^1 + B_1_1*x^1*y^1 + B_2_1*x^2*y^1 + B_3_1*x^3*y^1 + B_0_2*x^0*y^2 + B_1_2*x^1*y^2 + B_2_2*x^2*y^2 + B_0_3*x^0*y^3 + B_1_3*x^1*y^3 + B_0_4*x^0*y^4;
poly f = h^2 + B;
poly Al = quoy(B^2, h, 5);
poly g = h^3 + (3/2)*B*h + (3/8)*Al;
poly J = diff(f,x)*diff(g,y) - diff(f,y)*diff(g,x);
"MARK_DEGS"; deg(f); deg(g); deg(J);
matrix C = coef(J, x*y);
ideal I; poly cst = 0; int i;
for (i=1;i<=ncols(C);i++){ if(C[1,i]==x^4){cst=C[2,i];} else {I=I+ideal(C[2,i]);} }
I = simplify(I,2);
"MARK_NROWS"; size(I); "MARK_NPARAMS"; 30;
ring S = 0,(h_0_0,h_1_0,h_2_0,h_3_0,h_4_0,h_0_1,h_1_1,h_2_1,h_3_1,h_0_2,h_1_2,h_2_2,h_0_3,h_1_3,h_0_4,B_0_0,B_1_0,B_2_0,B_3_0,B_4_0,B_0_1,B_1_1,B_2_1,B_3_1,B_0_2,B_1_2,B_2_2,B_0_3,B_1_3,B_0_4),wp(5,4,3,2,1,4,3,2,1,3,2,1,2,1,1,10,9,8,7,6,9,8,7,6,8,7,6,7,6,6);
ideal I = imap(R,I); poly cst = imap(R,cst);
"MARK_CST_ZERO"; cst==0;
"MARK_CST_WT"; deg(cst); "MARK_HOMOG_I"; homog(I); "MARK_HOMOG_CST"; homog(cst);
"MARK_STDI_START"; ideal GI = std(I); "MARK_STDI_DONE"; "MARK_STDI_SIZE"; size(GI);
"MARK_CTRL_RAW_DIM"; dim(GI);
"MARK_REDUCE_CST"; poly rr = reduce(cst,GI); "MARK_CST_IN_I"; rr==0;
if (rr==0) { matrix Q = lift(I,cst); poly chk = cst - (matrix(I)*Q)[1,1];
  "MARK_LIFT_VERIFY"; chk==0; "MARK_LIFT_NCOF"; size(ideal(Q));
  int nz=0; for(i=1;i<=nrows(Q);i++){ if(Q[i,1]!=0){nz++;} } "MARK_LIFT_SUPPORT"; nz; }
"MARK_RADPOW"; int N; poly rp;
for (N=2; N<=6; N++) { rp = reduce(cst^N, GI); "POW",N,"in_I:",rp==0; if (rp==0) { break; } }
"MARK_CTRL_UNIT"; dim(std(ideal(1)));
"MARK_CTRL_ORIGIN"; dim(std(maxideal(1)));
ring T = 0,(Z,h_0_0,h_1_0,h_2_0,h_3_0,h_4_0,h_0_1,h_1_1,h_2_1,h_3_1,h_0_2,h_1_2,h_2_2,h_0_3,h_1_3,h_0_4,B_0_0,B_1_0,B_2_0,B_3_0,B_4_0,B_0_1,B_1_1,B_2_1,B_3_1,B_0_2,B_1_2,B_2_2,B_0_3,B_1_3,B_0_4),dp;
ideal I=imap(S,I); poly cst=imap(S,cst); ideal L=I,Z*cst-1;
"MARK_RAB_START"; ideal G=std(L); "MARK_RAB_DONE"; "MARK_DIM"; dim(G); "MARK_GB1"; G[1]; "MARK_RED1"; reduce(1,G);
"MARK_DONE"; quit;

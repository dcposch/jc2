if (T5 == 0) { print("HOM k=5 ZERO"); } else { print("HOM k=5 homog=" + string(homog(T5)) + " deg=" + string(deg(T5)) + " expected=20"); }
if (T6 == 0) { print("HOM k=6 ZERO"); } else { print("HOM k=6 homog=" + string(homog(T6)) + " deg=" + string(deg(T6)) + " expected=19"); }
if (T7 == 0) { print("HOM k=7 ZERO"); } else { print("HOM k=7 homog=" + string(homog(T7)) + " deg=" + string(deg(T7)) + " expected=18"); }
if (T8 == 0) { print("HOM k=8 ZERO"); } else { print("HOM k=8 homog=" + string(homog(T8)) + " deg=" + string(deg(T8)) + " expected=17"); }
if (T9 == 0) { print("HOM k=9 ZERO"); } else { print("HOM k=9 homog=" + string(homog(T9)) + " deg=" + string(deg(T9)) + " expected=16"); }
if (T10 == 0) { print("HOM k=10 ZERO"); } else { print("HOM k=10 homog=" + string(homog(T10)) + " deg=" + string(deg(T10)) + " expected=15"); }
if (T11 == 0) { print("HOM k=11 ZERO"); } else { print("HOM k=11 homog=" + string(homog(T11)) + " deg=" + string(deg(T11)) + " expected=14"); }
poly T0hom = T0 - subst(T0, b3,0, b4,0, q(2),0, q(3),0, q(4),0, q(5),0);
poly T0con = T0 - T0hom;
print("T0CONST=" + string(T0con));
if (T0con == 0) { print("T0CONST_IS_ZERO -- UNIT CLAIM FAILS"); } else { print("T0CONST_NONZERO=yes"); }
if (T0 == 0) { print("T0 ZERO"); } else { print("T0_homog=" + string(homog(T0)) + " (expected 0: T0 is INHOMOGENEOUS)"); }
if (T0hom == 0) { print("T0HOM ZERO"); } else { print("T0HOM_homog=" + string(homog(T0hom)) + " deg=" + string(deg(T0hom)) + " expected=25"); }
ideal Jp = T1,T2,T3,T4,T5,T6,T7,T8,T9,T10,T11;
int tt = timer; ideal G = std(Jp); print("JPLUS t=6 dim=" + string(dim(G)) + " size=" + string(size(G)) + " time=" + string(timer-tt));
print("JPLUS_LEAD=" + string(lead(G)));
print("JPLUS_HOMOG_IDEAL=" + string(homog(Jp)));
quit;

// A_CONTROL_PREDECESSOR; characteristic 32009
ring R=32009,(h_0_8,h_0_7,h_0_6,h_0_5,h_0_4,h_0_3,h_0_2,h_0_1,h_0_0,bp,bq,br,bs,c,T),dp;
option(redSB);
if (nameof(basering)=="R") { print("CONTROL_RING_PASS R"); } else { print("CONTROL_RING_FAIL"); }
print("RING_BEGIN"); R; print("RING_END");
ideal CE=c,T*(c)-1;
ideal GCE=std(CE);
if (reduce(1,GCE)==0) { print("CONTROL_EMPTY_PASS"); } else { print("CONTROL_EMPTY_FAIL"); }
ideal CN=c-(1),T-(1);
ideal GCN=std(CN);
if (reduce(1,GCN)!=0) { print("CONTROL_NONEMPTY_PASS"); } else { print("CONTROL_NONEMPTY_FAIL"); }
ideal E=
  -c,
  -48*br^2,
  6*bq^2 + 12*bq*br + 54*br^2,
  -6*bp*br*h_0_1 + 48*br^2*h_0_8 - 48*br*bs,
  54*bp*br*h_0_0 + 42*br^2*h_0_7,
  -18*bp^2*br + 36*br^2*h_0_6,
  30*br^2*h_0_5,
  24*br^2*h_0_4,
  18*br^2*h_0_3,
  12*br^2*h_0_2,
  6*br^2*h_0_1,
  6*bp*br*h_0_1 - 6*bq^2*h_0_8 - 6*bq*br*h_0_8 + 6*bq*bs + 54*br*bs,
  -54*bp*br*h_0_0 + 6*bp*br*h_0_1*h_0_8 - 6*bq^2*h_0_7 - 12*bq*br*h_0_7 + 48*br*bs*h_0_8,
  3*bp^2*bq + 21*bp^2*br - 48*bp*br*h_0_0*h_0_8 + 6*bp*br*h_0_1*h_0_7 + 6*bp*bs*h_0_0 - 6*bq^2*h_0_6 - 18*bq*br*h_0_6 + 42*br*bs*h_0_7,
  -3*bp^3*h_0_1 + 18*bp^2*br*h_0_8 - 6*bp^2*h_0_0^2 - 42*bp*br*h_0_0*h_0_7 + 6*bp*br*h_0_1*h_0_6 - 6*bq^2*h_0_5 - 24*bq*br*h_0_5 + 36*br*bs*h_0_6,
  -3*bp^3*h_0_0 + 15*bp^2*br*h_0_7 - 36*bp*br*h_0_0*h_0_6 + 6*bp*br*h_0_1*h_0_5 - 6*bq^2*h_0_4 - 30*bq*br*h_0_4 + 30*br*bs*h_0_5,
  12*bp^2*br*h_0_6 - 30*bp*br*h_0_0*h_0_5 + 6*bp*br*h_0_1*h_0_4 - 6*bq^2*h_0_3 - 36*bq*br*h_0_3 + 24*br*bs*h_0_4,
  9*bp^2*br*h_0_5 - 24*bp*br*h_0_0*h_0_4 + 6*bp*br*h_0_1*h_0_3 - 6*bq^2*h_0_2 - 42*bq*br*h_0_2 + 18*br*bs*h_0_3,
  6*bp^2*br*h_0_4 - 18*bp*br*h_0_0*h_0_3 + 6*bp*br*h_0_1*h_0_2 - 6*bq^2*h_0_1 - 48*bq*br*h_0_1 + 12*br*bs*h_0_2,
  3*bp^2*br*h_0_3 - 12*bp*br*h_0_0*h_0_2 + 6*bp*br*h_0_1^2 - 6*bq^2*h_0_0 - 54*bq*br*h_0_0 + 6*br*bs*h_0_1,
  -54*bp*br,
  54*bp*br,
  -3*bp^2*h_0_1 + 48*bp*br*h_0_8 - 6*bp*bs,
  6*bp^2*h_0_0 + 42*bp*br*h_0_7,
  3*bp^3 + 36*bp*br*h_0_6,
  30*bp*br*h_0_5,
  24*bp*br*h_0_4,
  18*bp*br*h_0_3,
  12*bp*br*h_0_2 + 6*bq^2 + 54*bq*br;
ideal GU=std(E);
if (reduce(1,GU)!=0) { print("UNSATURATED_NONUNIT_PASS"); } else { print("UNSATURATED_NONUNIT_FAIL"); }
ideal I=
  -c,
  -48*br^2,
  6*bq^2 + 12*bq*br + 54*br^2,
  -6*bp*br*h_0_1 + 48*br^2*h_0_8 - 48*br*bs,
  54*bp*br*h_0_0 + 42*br^2*h_0_7,
  -18*bp^2*br + 36*br^2*h_0_6,
  30*br^2*h_0_5,
  24*br^2*h_0_4,
  18*br^2*h_0_3,
  12*br^2*h_0_2,
  6*br^2*h_0_1,
  6*bp*br*h_0_1 - 6*bq^2*h_0_8 - 6*bq*br*h_0_8 + 6*bq*bs + 54*br*bs,
  -54*bp*br*h_0_0 + 6*bp*br*h_0_1*h_0_8 - 6*bq^2*h_0_7 - 12*bq*br*h_0_7 + 48*br*bs*h_0_8,
  3*bp^2*bq + 21*bp^2*br - 48*bp*br*h_0_0*h_0_8 + 6*bp*br*h_0_1*h_0_7 + 6*bp*bs*h_0_0 - 6*bq^2*h_0_6 - 18*bq*br*h_0_6 + 42*br*bs*h_0_7,
  -3*bp^3*h_0_1 + 18*bp^2*br*h_0_8 - 6*bp^2*h_0_0^2 - 42*bp*br*h_0_0*h_0_7 + 6*bp*br*h_0_1*h_0_6 - 6*bq^2*h_0_5 - 24*bq*br*h_0_5 + 36*br*bs*h_0_6,
  -3*bp^3*h_0_0 + 15*bp^2*br*h_0_7 - 36*bp*br*h_0_0*h_0_6 + 6*bp*br*h_0_1*h_0_5 - 6*bq^2*h_0_4 - 30*bq*br*h_0_4 + 30*br*bs*h_0_5,
  12*bp^2*br*h_0_6 - 30*bp*br*h_0_0*h_0_5 + 6*bp*br*h_0_1*h_0_4 - 6*bq^2*h_0_3 - 36*bq*br*h_0_3 + 24*br*bs*h_0_4,
  9*bp^2*br*h_0_5 - 24*bp*br*h_0_0*h_0_4 + 6*bp*br*h_0_1*h_0_3 - 6*bq^2*h_0_2 - 42*bq*br*h_0_2 + 18*br*bs*h_0_3,
  6*bp^2*br*h_0_4 - 18*bp*br*h_0_0*h_0_3 + 6*bp*br*h_0_1*h_0_2 - 6*bq^2*h_0_1 - 48*bq*br*h_0_1 + 12*br*bs*h_0_2,
  3*bp^2*br*h_0_3 - 12*bp*br*h_0_0*h_0_2 + 6*bp*br*h_0_1^2 - 6*bq^2*h_0_0 - 54*bq*br*h_0_0 + 6*br*bs*h_0_1,
  -54*bp*br,
  54*bp*br,
  -3*bp^2*h_0_1 + 48*bp*br*h_0_8 - 6*bp*bs,
  6*bp^2*h_0_0 + 42*bp*br*h_0_7,
  3*bp^3 + 36*bp*br*h_0_6,
  30*bp*br*h_0_5,
  24*bp*br*h_0_4,
  18*bp*br*h_0_3,
  12*bp*br*h_0_2 + 6*bq^2 + 54*bq*br,
  T*(c)-1;
ideal G=std(I);
if (typeof(G)=="ideal" && nameof(basering)=="R") { print("MAIN_IDEAL_RING_PASS"); } else { print("MAIN_IDEAL_RING_FAIL"); }
print("GENERATOR_COUNT"); size(E);
print("EXTENDED_GENERATOR_COUNT"); size(I);
print("BASIS_SIZE"); size(G);
print("BASIS_BEGIN"); G; print("BASIS_END");
if (reduce(1,G)==0) { print("MAIN_SATURATED_EMPTY"); } else { print("MAIN_NONUNIT"); }
quit;

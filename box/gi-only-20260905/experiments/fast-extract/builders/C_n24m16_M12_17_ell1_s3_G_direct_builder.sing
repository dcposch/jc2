DIRECT = DIRECT - c*x^1;
native_append_coeffs(DIRECT, 0, rowsfile, WX, WY);
print("DIRECT_DONE equations=" + string(source_idx));
print("DIRECT_DONE max_degree_x=" + string(max_nf_deg));
quit;

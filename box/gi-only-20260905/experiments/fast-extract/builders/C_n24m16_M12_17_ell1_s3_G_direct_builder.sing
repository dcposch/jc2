tmpLower = (0)*(BB2)*(diff((1),x)*diff(h,y)-diff((1),y)*diff(h,x))+(3)*(1)*(diff(h,x)*diff((BB2),y)-diff(h,y)*diff((BB2),x));
if (tmpLower != 0) { H2 = H2 + tmpLower; }
tmpSame = diff((AA1),x)*diff((1),y)-diff((AA1),y)*diff((1),x);

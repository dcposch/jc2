// EXPERIMENTAL exact ordinary-coefficient presentation.
// Same full G chart and ring; no coordinate specialization.
// Monicity of h makes this ideal equal to the h-adic coefficient ideal.
poly DIRECT = 0;
DIRECT = DIRECT*h + H5;
DIRECT = DIRECT*h + H4;

tmpSame = diff((BB3),x)*diff((AA4),y)-diff((BB3),y)*diff((AA4),x);
if (tmpSame != 0) { H0 = H0 + tmpSame; }

// Equal coefficient ideal under the monic unitriangular h-adic basis.
poly DIRECT=0;
DIRECT=DIRECT*h+H27;
DIRECT=DIRECT*h+H26;
DIRECT=DIRECT*h+H25;
DIRECT=DIRECT*h+H24;
DIRECT=DIRECT*h+H23;
DIRECT=DIRECT*h+H22;
DIRECT=DIRECT*h+H21;
DIRECT=DIRECT*h+H20;
DIRECT=DIRECT*h+H19;
DIRECT=DIRECT*h+H18;
DIRECT=DIRECT*h+H17;
DIRECT=DIRECT*h+H16;
DIRECT=DIRECT*h+H15;
DIRECT=DIRECT*h+H14;
DIRECT=DIRECT*h+H13;
DIRECT=DIRECT*h+H12;
DIRECT=DIRECT*h+H11;
DIRECT=DIRECT*h+H10;
DIRECT=DIRECT*h+H9;
DIRECT=DIRECT*h+H8;
DIRECT=DIRECT*h+H7;
DIRECT=DIRECT*h+H6;
DIRECT=DIRECT*h+H5;
DIRECT=DIRECT*h+H4;
DIRECT=DIRECT*h+H3;
DIRECT=DIRECT*h+H2;
DIRECT=DIRECT*h+H1;
DIRECT=DIRECT*h+H0;
poly target_xk = native_coeff_xy(DIRECT, 3, 0, WX, WY);
if (target_xk != 0) { print("DIRECT_GATE target_xk_nonzero=1"); } else { print("DIRECT_GATE target_xk_nonzero=0"); }
DIRECT=DIRECT-c*x^3;
native_append_coeffs(DIRECT, 0, rowsfile, WX, WY);
print("NATIVE_DONE equations="+string(source_idx));
quit;

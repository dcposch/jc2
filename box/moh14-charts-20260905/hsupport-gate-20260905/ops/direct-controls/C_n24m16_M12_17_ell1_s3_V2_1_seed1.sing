poly tmpSame;
poly tmpLower;
tmpSame = diff((1),x)*diff((1),y)-diff((1),y)*diff((1),x);
if (tmpSame != 0) { H5 = H5 + tmpSame; }
tmpLower = (3)*(1)*(diff((1),x)*diff(h,y)-diff((1),y)*diff(h,x))+(2)*(1)*(diff(h,x)*diff((1),y)-diff(h,y)*diff((1),x));
if (tmpLower != 0) { H4 = H4 + tmpLower; }
tmpSame = diff((1),x)*diff((AA1),y)-diff((1),y)*diff((AA1),x);
if (tmpSame != 0) { H4 = H4 + tmpSame; }
tmpLower = (2)*(AA1)*(diff((1),x)*diff(h,y)-diff((1),y)*diff(h,x))+(2)*(1)*(diff(h,x)*diff((AA1),y)-diff(h,y)*diff((AA1),x));
if (tmpLower != 0) { H3 = H3 + tmpLower; }
tmpSame = diff((1),x)*diff((AA2),y)-diff((1),y)*diff((AA2),x);
if (tmpSame != 0) { H3 = H3 + tmpSame; }
tmpLower = (1)*(AA2)*(diff((1),x)*diff(h,y)-diff((1),y)*diff(h,x))+(2)*(1)*(diff(h,x)*diff((AA2),y)-diff(h,y)*diff((AA2),x));
if (tmpLower != 0) { H2 = H2 + tmpLower; }
tmpSame = diff((1),x)*diff((AA3),y)-diff((1),y)*diff((AA3),x);
if (tmpSame != 0) { H2 = H2 + tmpSame; }
tmpLower = (0)*(AA3)*(diff((1),x)*diff(h,y)-diff((1),y)*diff(h,x))+(2)*(1)*(diff(h,x)*diff((AA3),y)-diff(h,y)*diff((AA3),x));
if (tmpLower != 0) { H1 = H1 + tmpLower; }
tmpSame = diff((BB2),x)*diff((1),y)-diff((BB2),y)*diff((1),x);
if (tmpSame != 0) { H3 = H3 + tmpSame; }
tmpLower = (3)*(1)*(diff((BB2),x)*diff(h,y)-diff((BB2),y)*diff(h,x))+(0)*(BB2)*(diff(h,x)*diff((1),y)-diff(h,y)*diff((1),x));
if (tmpLower != 0) { H2 = H2 + tmpLower; }
tmpSame = diff((BB2),x)*diff((AA1),y)-diff((BB2),y)*diff((AA1),x);
if (tmpSame != 0) { H2 = H2 + tmpSame; }
tmpLower = (2)*(AA1)*(diff((BB2),x)*diff(h,y)-diff((BB2),y)*diff(h,x))+(0)*(BB2)*(diff(h,x)*diff((AA1),y)-diff(h,y)*diff((AA1),x));
if (tmpLower != 0) { H1 = H1 + tmpLower; }
tmpSame = diff((BB2),x)*diff((AA2),y)-diff((BB2),y)*diff((AA2),x);
if (tmpSame != 0) { H1 = H1 + tmpSame; }
tmpLower = (1)*(AA2)*(diff((BB2),x)*diff(h,y)-diff((BB2),y)*diff(h,x))+(0)*(BB2)*(diff(h,x)*diff((AA2),y)-diff(h,y)*diff((AA2),x));
if (tmpLower != 0) { H0 = H0 + tmpLower; }
tmpSame = diff((BB2),x)*diff((AA3),y)-diff((BB2),y)*diff((AA3),x);
if (tmpSame != 0) { H0 = H0 + tmpSame; }
poly RECOMPOSED=0;
RECOMPOSED=RECOMPOSED*h+H33;
RECOMPOSED=RECOMPOSED*h+H32;

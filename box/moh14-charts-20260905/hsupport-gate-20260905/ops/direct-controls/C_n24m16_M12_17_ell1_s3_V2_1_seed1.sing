ring R=0,(y,x),lp;
poly h = (1/2) + (6/3)*y + (-6/3)*y^2 + (-5/3)*y^3 + (5/2)*y^4 + (-2/3)*y^5 + (0/3)*y^6 + (-2/2)*y^7 + (-3/1)*x*y + (-2/1)*x*y^2 + (-1/1)*x*y^3 + (-4/3)*x*y^4 + (2/1)*x*y^5 + (4/1)*x*y^6 + (2/3)*x*y^7 + (2/2)*x^2*y^2 + (3/2)*x^2*y^3 + (0/1)*x^2*y^4 + (6/2)*x^2*y^5 + (-5/2)*x^2*y^6 + (6/1)*x^2*y^7 + (4/2)*x^3*y^4 + (-3/3)*x^3*y^5 + (-1/3)*x^3*y^6 + (-3/2)*x^3*y^7 + (1/1)*x^4*y^5 + (3/1)*x^4*y^6 + (1/3)*x^4*y^7 + (-6/2)*x^5*y^6 + (5/1)*x^5*y^7 + (-4/2)*x^6*y^7 + y^8;
poly AA1 = (-5/3) + (0/1)*y + (1/1)*y^2 + (2/1)*y^3 + (-1/3)*y^4 + (5/1)*y^5 + (-6/1)*y^6 + (5/3)*y^7 + (4/2)*x*y + (5/2)*x*y^2 + (6/2)*x*y^3 + (3/1)*x*y^4 + (-4/2)*x*y^5 + (-2/2)*x*y^6 + (-4/1)*x*y^7 + (-4/3)*x^2*y^2 + (-3/3)*x^2*y^3 + (-6/2)*x^2*y^4 + (0/3)*x^2*y^5 + (2/3)*x^2*y^6 + (0/2)*x^2*y^7 + (-2/3)*x^3*y^4 + (4/1)*x^3*y^5 + (6/1)*x^3*y^6 + (4/3)*x^3*y^7 + (-5/2)*x^4*y^5 + (-3/2)*x^4*y^6 + (-5/1)*x^4*y^7 + (1/3)*x^5*y^6 + (-1/2)*x^5*y^7 + (3/3)*x^6*y^7;
poly AA2 = (-3/3) + (2/1)*y + (3/1)*y^2 + (0/3)*y^3 + (6/1)*y^4 + (-1/2)*y^5 + (1/2)*y^6 + (-1/1)*y^7 + (6/2)*x*y + (-6/2)*x*y^2 + (4/1)*x*y^3 + (-3/2)*x*y^4 + (3/3)*x*y^5 + (5/3)*x*y^6 + (3/2)*x*y^7 + (-2/3)*x^2*y^2 + (-5/2)*x^2*y^3 + (1/3)*x^2*y^4 + (-6/1)*x^2*y^5 + (-4/1)*x^2*y^6 + (-6/3)*x^2*y^7 + (-1/3)*x^3*y^3 + (5/1)*x^3*y^4 + (-2/2)*x^3*y^5 + (0/2)*x^3*y^6 + (-2/1)*x^3*y^7 + (-4/2)*x^4*y^4 + (2/3)*x^4*y^5 + (4/3)*x^4*y^6 + (2/2)*x^4*y^7 + (-5/1)*x^5*y^6 + (6/3)*x^5*y^7 + (-3/1)*x^6*y^7;
poly AA3 = (-1/3)*y + (0/3)*y^2 + (-3/2)*y^3 + (3/3)*y^4 + (5/3)*y^5 + (3/2)*y^6 + (1/1)*y^7 + (3/1)*x*y + (4/1)*x*y^2 + (1/3)*x*y^3 + (-6/1)*x*y^4 + (-4/1)*x*y^5 + (-6/3)*x*y^6 + (5/2)*x*y^7 + (-5/2)*x^2*y^2 + (5/1)*x^2*y^3 + (-2/2)*x^2*y^4 + (0/2)*x^2*y^5 + (-2/1)*x^2*y^6 + (-4/3)*x^2*y^7 + (-4/2)*x^3*y^3 + (2/3)*x^3*y^4 + (4/3)*x^3*y^5 + (2/2)*x^3*y^6 + (0/1)*x^3*y^7 + (6/1)*x^4*y^4 + (-5/1)*x^4*y^5 + (6/3)*x^4*y^6 + (4/2)*x^4*y^7 + (-1/2)*x^5*y^5 + (-3/1)*x^5*y^6 + (-5/3)*x^5*y^7 + (1/2)*x^6*y^6 + (-1/1)*x^6*y^7;
poly BB2 = (-3/2)*y + (-2/2)*y^2 + (-5/1)*y^3 + (1/2)*y^4 + (-6/3)*y^5 + (-4/3)*y^6 + (-6/2)*y^7 + (1/3)*x*y + (2/3)*x*y^2 + (-1/2)*x*y^3 + (5/3)*x*y^4 + (-2/1)*x*y^5 + (0/1)*x*y^6 + (-2/3)*x*y^7 + (6/1)*x^2*y^2 + (3/3)*x^2*y^3 + (-4/1)*x^2*y^4 + (2/2)*x^2*y^5 + (4/2)*x^2*y^6 + (2/1)*x^2*y^7 + (-6/1)*x^3*y^3 + (0/2)*x^3*y^4 + (6/3)*x^3*y^5 + (-5/3)*x^3*y^6 + (6/2)*x^3*y^7 + (4/3)*x^4*y^4 + (-3/1)*x^4*y^5 + (-1/1)*x^4*y^6 + (-3/3)*x^4*y^7 + (3/2)*x^5*y^6 + (1/1)*x^5*y^7 + (5/2)*x^6*y^7;
poly H0 = 0;

ring R=0,(B1c_2_26,B1c_2_27,B1c_2_28,B1c_2_29,B1c_2_30,B1c_2_31,B1c_2_32,B1c_2_33,K2c_3_26,c,jet2,Zc),dp;
ideal I=B1c_2_26*K2c_3_26 + 8*B1c_2_26*jet2 - B1c_2_27*K2c_3_26 - 8*B1c_2_27*jet2 + B1c_2_28*K2c_3_26 + 8*B1c_2_28*jet2 - B1c_2_29*K2c_3_26 - 8*B1c_2_29*jet2 + B1c_2_30*K2c_3_26 + 8*B1c_2_30*jet2 - B1c_2_31*K2c_3_26 - 8*B1c_2_31*jet2 + B1c_2_32*K2c_3_26 + 8*B1c_2_32*jet2 - B1c_2_33*K2c_3_26 - 8*B1c_2_33*jet2 + K2c_3_26^2 + 16*K2c_3_26*jet2 + 64*jet2^2,Zc*c-1;
ideal Sd=std(I);
print("BEGIN_DIM");print(dim(Sd));print("END_DIM");
print("BEGIN_NF");print(reduce(1,Sd));print("END_NF");
print("BEGIN_SIZE");print(size(Sd));print("END_SIZE");
ideal EmptyControl=c,Zc*c-1;
ideal PointControl=c-1,Zc*c-1;
ideal RawControl=B1c_2_26*K2c_3_26 + 8*B1c_2_26*jet2 - B1c_2_27*K2c_3_26 - 8*B1c_2_27*jet2 + B1c_2_28*K2c_3_26 + 8*B1c_2_28*jet2 - B1c_2_29*K2c_3_26 - 8*B1c_2_29*jet2 + B1c_2_30*K2c_3_26 + 8*B1c_2_30*jet2 - B1c_2_31*K2c_3_26 - 8*B1c_2_31*jet2 + B1c_2_32*K2c_3_26 + 8*B1c_2_32*jet2 - B1c_2_33*K2c_3_26 - 8*B1c_2_33*jet2 + K2c_3_26^2 + 16*K2c_3_26*jet2 + 64*jet2^2;
print("BEGIN_CTL");print(reduce(1,std(EmptyControl)));print(reduce(1,std(PointControl)));print(reduce(1,std(RawControl)));print("END_CTL");

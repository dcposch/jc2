ring R=0,(B1c_4_25,B1c_4_26,B1c_4_27,B1c_4_28,B1c_4_29,B1c_4_30,B1c_4_31,K2c_4_26,K2c_5_25,K2c_5_26,c,jet1,jet2,Zc),dp;

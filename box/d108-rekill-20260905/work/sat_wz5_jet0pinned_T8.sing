ring R=0,(Hc_5_4,K2c_3_26,K2c_4_25,K2c_4_26,K2c_5_25,K2c_5_26,c,jet1,jet2,Zc),dp;
ideal I=K2c_3_26^2 + 16*K2c_3_26*jet2 + 64*jet2^2,-2*K2c_3_26*K2c_4_25 + 2*K2c_3_26*K2c_4_26 + 40*K2c_3_26*jet1^2 - 16*K2c_4_25*jet2 + 16*K2c_4_26*jet2 + 320*jet1^2*jet2,-120*Hc_5_4*K2c_3_26 - 960*Hc_5_4*jet2 - 52*K2c_3_26^2*jet1 - 2*K2c_3_26*K2c_5_25 + 2*K2c_3_26*K2c_5_26 - 512*K2c_3_26*jet1*jet2 - 14*K2c_3_26 + K2c_4_25^2 - 2*K2c_4_25*K2c_4_26 - 40*K2c_4_25*jet1^2 + K2c_4_26^2 + 40*K2c_4_26*jet1^2 - 16*K2c_5_25*jet2 + 16*K2c_5_26*jet2 + 400*jet1^4 - 768*jet1*jet2^2 - 112*jet2,Zc*c-1;
ideal Sd=std(I);

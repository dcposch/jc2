ring R=0,(B1c_3_25,B1c_3_26,B1c_3_27,B1c_3_28,B1c_3_29,B1c_3_30,B1c_3_31,B1c_3_32,K2c_3_26,K2c_4_25,K2c_4_26,c,jet1,jet2,Zc),dp;

// exact t=3 system over K=Q(y)/(147*y^2-84*y+11)
// y denotes q7_1 after the rigorously normalized q4_1=1 slice
// c=10*y*(2-21*y)/343 is a coefficient-field unit and is eliminated
ring RAC=0,(gamma,pi),dp;
poly FAC=pi;
poly GAC=pi-(gamma^2)/2;
poly JAC=diff(FAC,gamma)*diff(GAC,pi)-diff(FAC,pi)*diff(GAC,gamma);

ideal G=std(I);
print("STD_DONE");
if(reduce(1,G)==0){print("STD_UNIT_PASS");}else{print("STD_UNIT_FAIL");}
print("POSTLIFT_START");
matrix L=lift(I,G);
print("POSTLIFT_DONE");
poly certcheck=0; for(int li=1;li<=nrows(L);li++){certcheck=certcheck+L[li,1]*I[li];}
if(certcheck-G[1]==0){print("LIFT_IDENTITY_PASS");}else{print("LIFT_IDENTITY_FAIL");}
for(li=1;li<=nrows(L);li++){if(L[li,1]!=0){print("SUPPORT_ROW");li;print("SUPPORT_CHARS");size(string(L[li,1]));}}
quit;

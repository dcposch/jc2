B2=trunc(B2+(B2c_41_18)*s^84*zp18+(B2c_41_19)*s^84*zp19+(B2c_41_20)*s^84*zp20+(B2c_41_21)*s^84*zp21+(B2c_41_22)*s^84*zp22+(B2c_41_23)*s^84*zp23+(B2c_41_24)*s^84*zp24+(B2c_42_17)*s^86*zp17+(B2c_42_18)*s^86*zp18+(B2c_42_19)*s^86*zp19+(B2c_42_20)*s^86*zp20+(B2c_42_21)*s^86*zp21+(B2c_42_22)*s^86*zp22+(B2c_42_23)*s^86*zp23+(B2c_43_16)*s^88*zp16+(B2c_43_17)*s^88*zp17+(B2c_43_18)*s^88*zp18+(B2c_43_19)*s^88*zp19+(B2c_43_20)*s^88*zp20+(B2c_43_21)*s^88*zp21+(B2c_43_22)*s^88*zp22+(21*B2c_52_9 + 112*B2c_56_6 + 378*B2c_60_3 + 1008*B2c_64_0)*s^90*zp15+(B2c_44_16)*s^90*zp16+(B2c_44_17)*s^90*zp17+(B2c_44_18)*s^90*zp18+(B2c_44_19)*s^90*zp19+(B2c_44_20)*s^90*zp20+(B2c_44_21)*s^90*zp21+(210*B2c_61_2)*s^92*zp14+(B2c_45_15)*s^92*zp15+(B2c_45_16)*s^92*zp16+(B2c_45_17)*s^92*zp17+(B2c_45_18)*s^92*zp18+(B2c_45_19)*s^92*zp19+(B2c_45_20)*s^92*zp20+(B2c_46_14)*s^94*zp14+(B2c_46_15)*s^94*zp15+(B2c_46_16)*s^94*zp16+(B2c_46_17)*s^94*zp17+(B2c_46_18)*s^94*zp18+(B2c_46_19)*s^94*zp19+(B2c_47_13)*s^96*zp13+(B2c_47_14)*s^96*zp14+(B2c_47_15)*s^96*zp15+(B2c_47_16)*s^96*zp16+(B2c_47_17)*s^96*zp17+(B2c_47_18)*s^96*zp18+(-7*B2c_52_9 - 28*B2c_56_6 - 84*B2c_60_3 - 210*B2c_64_0)*s^98*zp12+(B2c_48_13)*s^98*zp13+(B2c_48_14)*s^98*zp14+(B2c_48_15)*s^98*zp15+(B2c_48_16)*s^98*zp16+(B2c_48_17)*s^98*zp17+(-120*B2c_61_2)*s^100*zp11+(B2c_49_12)*s^100*zp12+(B2c_49_13)*s^100*zp13+(B2c_49_14)*s^100*zp14+(B2c_49_15)*s^100*zp15+(B2c_49_16)*s^100*zp16+(B2c_50_11)*s^102*zp11+(B2c_50_12)*s^102*zp12+(B2c_50_13)*s^102*zp13+(B2c_50_14)*s^102*zp14+(B2c_50_15)*s^102*zp15+(B2c_51_10)*s^104*zp10+(B2c_51_11)*s^104*zp11+(B2c_51_12)*s^104*zp12+(B2c_51_13)*s^104*zp13+(B2c_51_14)*s^104*zp14+(B2c_52_9)*s^106*zp9+(B2c_52_10)*s^106*zp10+(B2c_52_11)*s^106*zp11+(B2c_52_12)*s^106*zp12+(B2c_52_13)*s^106*zp13+(45*B2c_61_2)*s^108*zp8+(B2c_53_9)*s^108*zp9+(B2c_53_10)*s^108*zp10+(B2c_53_11)*s^108*zp11+(B2c_53_12)*s^108*zp12+(B2c_54_8)*s^110*zp8+(B2c_54_9)*s^110*zp9+(B2c_54_10)*s^110*zp10+(B2c_54_11)*s^110*zp11+(B2c_55_7)*s^112*zp7+(B2c_55_8)*s^112*zp8+(B2c_55_9)*s^112*zp9+(B2c_55_10)*s^112*zp10+(B2c_56_6)*s^114*zp6+(B2c_56_7)*s^114*zp7+(B2c_56_8)*s^114*zp8+(B2c_56_9)*s^114*zp9+(-10*B2c_61_2)*s^116*zp5+(B2c_57_6)*s^116*zp6+(B2c_57_7)*s^116*zp7+(B2c_57_8)*s^116*zp8+(B2c_58_5)*s^118*zp5+(B2c_58_6)*s^118*zp6+(B2c_58_7)*s^118*zp7+(B2c_59_4)*s^120*zp4+(B2c_59_5)*s^120*zp5+(B2c_59_6)*s^120*zp6+(B2c_60_3)*s^122*zp3+(B2c_60_4)*s^122*zp4+(B2c_60_5)*s^122*zp5+(B2c_61_2)*s^124*zp2+(B2c_61_3)*s^124*zp3+(B2c_61_4)*s^124*zp4+(B2c_62_2)*s^126*zp2+(B2c_62_3)*s^126*zp3+(B2c_63_1)*s^128*zp1+(B2c_63_2)*s^128*zp2+(B2c_64_0)*s^130*zp0+(B2c_64_1)*s^130*zp1+(B2c_65_0)*s^132*zp0);
print("COMPONENT B2 terms=242 size="+string(size(B2)));

poly H2=trunc(H*H);
poly H3=trunc(H2*H);
poly H4=trunc(H2*H2);
poly EF=trunc(A2*H+A3);
poly EG=trunc(B1*H+B2);
poly F0=1;
poly F1=trunc(H3+EF);
poly F2=trunc(F1*F1);
poly F3=trunc(F2*F1);
poly F4=trunc(F3*F1);
poly F5=trunc(F4*F1);
poly G0=1;
poly G1=trunc(H2+EG);
poly G2=trunc(G1*G1);
poly G3=trunc(G2*G1);
poly G4=trunc(G3*G1);
poly G5=trunc(G4*G1);
poly G6=trunc(G5*G1);
poly G7=trunc(G6*G1);
poly EG2=trunc(EG*EG);
poly EG3=trunc(EG2*EG);
poly EF2=trunc(EF*EF);
poly D2=trunc(3*H4*EG+3*H2*EG2+EG3-2*H3*EF-EF2);
poly U2=trunc(D2+T2_a1*s^66*F1*G1+T2_a0*s^264*G1+T2_b1*s^198*F1+T2_b0*s^396);
poly p=pi*(pi^2-c);
poly E2=trunc(U2-s^391*p^5);
poly D3=trunc(D2*(G6+G3*F2+F4));
poly U3=D3;
U3=trunc(U3+T3_a2_m0*s^264*F0*G7);
U3=trunc(U3+T3_a2_m1*s^66*F1*G7);
U3=trunc(U3+T3_a3_m0*s^396*F0*G6);
U3=trunc(U3+T3_a3_m1*s^198*F1*G6);
U3=trunc(U3+T3_a3_m2*s^0*F2*G6);
U3=trunc(U3+T3_a4_m0*s^528*F0*G5);
U3=trunc(U3+T3_a4_m1*s^330*F1*G5);
U3=trunc(U3+T3_a4_m2*s^132*F2*G5);
U3=trunc(U3+T3_a5_m0*s^660*F0*G4);
U3=trunc(U3+T3_a5_m1*s^462*F1*G4);
U3=trunc(U3+T3_a5_m2*s^264*F2*G4);
U3=trunc(U3+T3_a5_m3*s^66*F3*G4);
U3=trunc(U3+T3_a6_m0*s^792*F0*G3);
U3=trunc(U3+T3_a6_m1*s^594*F1*G3);
U3=trunc(U3+T3_a6_m2*s^396*F2*G3);
U3=trunc(U3+T3_a6_m3*s^198*F3*G3);
U3=trunc(U3+T3_a6_m4*s^0*F4*G3);
U3=trunc(U3+T3_a7_m0*s^924*F0*G2);
U3=trunc(U3+T3_a7_m1*s^726*F1*G2);
U3=trunc(U3+T3_a7_m2*s^528*F2*G2);
U3=trunc(U3+T3_a7_m3*s^330*F3*G2);
U3=trunc(U3+T3_a7_m4*s^132*F4*G2);
U3=trunc(U3+T3_a8_m0*s^1056*F0*G1);
U3=trunc(U3+T3_a8_m1*s^858*F1*G1);
U3=trunc(U3+T3_a8_m2*s^660*F2*G1);
U3=trunc(U3+T3_a8_m3*s^462*F3*G1);
U3=trunc(U3+T3_a8_m4*s^264*F4*G1);
U3=trunc(U3+T3_a8_m5*s^66*F5*G1);
U3=trunc(U3+T3_a9_m0*s^1188*F0*G0);
U3=trunc(U3+T3_a9_m1*s^990*F1*G0);
U3=trunc(U3+T3_a9_m2*s^792*F2*G0);
U3=trunc(U3+T3_a9_m3*s^594*F3*G0);
U3=trunc(U3+T3_a9_m4*s^396*F4*G0);
U3=trunc(U3+T3_a9_m5*s^198*F5*G0);
poly q1=-pi^10/5+3*c*pi^8/4-c^2*pi^6+c^3*pi^4/2;
poly E3=trunc(U3-s^1178*(kappa)*p^10*q1);

ideal Rows;
list Labels;
int js,jp,ns,kp;
poly rr;

matrix CS_T2=coef(E2,s);
matrix CP_T2;
for(js=1;js<=ncols(CS_T2);js++)
{
  // The first coef() row is a pure power of s, so total degree is its
  // s-exponent (Singular's two-argument deg expects an intvec, not a var).
  ns=deg(CS_T2[1,js]);
  if(ns<=391)
  {
    CP_T2=coef(CS_T2[2,js],pi);
    for(jp=1;jp<=ncols(CP_T2);jp++)
    {
      // Likewise this monomial is a pure power of pi.
      kp=deg(CP_T2[1,jp]);
      rr=CP_T2[2,jp];
      if(rr!=0)
      {
        if(diff(rr,s)!=0 || diff(rr,pi)!=0)
        {
          ERROR("coefficient extraction left a bookkeeping variable");
        }
        Rows[size(Rows)+1]=rr;
        Labels[size(Labels)+1]="T2_s"+string(ns)+"_pi"+string(kp);
      }
    }
  }
}


matrix CS_T3=coef(E3,s);
matrix CP_T3;
for(js=1;js<=ncols(CS_T3);js++)
{
  // The first coef() row is a pure power of s, so total degree is its
  // s-exponent (Singular's two-argument deg expects an intvec, not a var).
  ns=deg(CS_T3[1,js]);
  if(ns<=1178)
  {
    CP_T3=coef(CS_T3[2,js],pi);
    for(jp=1;jp<=ncols(CP_T3);jp++)
    {
      // Likewise this monomial is a pure power of pi.
      kp=deg(CP_T3[1,jp]);
      rr=CP_T3[2,jp];
      if(rr!=0)
      {
        if(diff(rr,s)!=0 || diff(rr,pi)!=0)
        {
          ERROR("coefficient extraction left a bookkeeping variable");
        }
        Rows[size(Rows)+1]=rr;
        Labels[size(Labels)+1]="T3_s"+string(ns)+"_pi"+string(kp);
      }
    }
  }
}

Rows[size(Rows)+1]=((-A2c_64_1*K2c_33_0 - A2c_65_0*K2c_32_1 - A3c_97_1 - 3*K2c_32_1*K2c_33_0^2)*(-B1c_31_1*K2c_33_0 + B1c_32_0*(1 - K2c_32_1) + B2c_64_0 - B2c_64_1 + 2*K2c_33_0*(1 - K2c_32_1)) + (B1c_31_1*K2c_33_0 + B1c_32_0*K2c_32_1 + B2c_64_1 + 2*K2c_32_1*K2c_33_0)*(A2c_65_0*(1 - K2c_32_1) + A3c_97_0 - A3c_97_1 + 3*K2c_33_0^2*(1 - K2c_32_1) + K2c_33_0*(A2c_64_0 - A2c_64_1)))-kappa; Labels[size(Labels)+1]="Jacobian_constant";
Rows[size(Rows)+1]=c-1; Labels[size(Labels)+1]="gauge_c";
print("raw_coefficient_rows="+string(size(Rows)));

list PivotVariable, PivotCoefficient, PivotRHS, PivotLabel;
int np=0;
int changed=1;
int ri,vi,jj;
poly ff,xx,dd,rhs;
ideal VV;
while(changed)
{
  changed=0;
  for(ri=1;ri<=size(Rows);ri++)
  {
    ff=Rows[ri];
    if(ff!=0)
    {
      VV=variables(ff);
      for(vi=1;vi<=size(VV);vi++)
      {
        xx=VV[vi];
        if(xx!=c && xx!=kappa && xx!=s && xx!=pi)
        {
          dd=diff(ff,xx);
          if(dd!=0 && deg(dd)==0)
          {
            rhs=-subst(ff,xx,0)/dd;
            np++;
            PivotVariable[np]=string(xx);
            PivotCoefficient[np]=string(dd);
            PivotRHS[np]=string(rhs);
            PivotLabel[np]=Labels[ri];
            for(jj=1;jj<=size(Rows);jj++)
            {
              if(jj!=ri)
              {
                Rows[jj]=reduce(subst(Rows[jj],xx,rhs),std(0));
              }
            }
            Rows=delete(Rows,ri);
            Labels=delete(Labels,ri);
            changed=1;
            break;
          }
        }
      }
    }
    if(changed) { break; }
  }
}
print("BEGIN_AFFINE_PIVOTS");
print("count="+string(np));
for(ri=1;ri<=np;ri++)
{
  print("label="+PivotLabel[ri]+" variable="+PivotVariable[ri]+" coefficient="+PivotCoefficient[ri]+" rhs="+PivotRHS[ri]);
}
print("END_AFFINE_PIVOTS");
ideal Residual;
for(ri=1;ri<=size(Rows);ri++)
{
  if(Rows[ri]!=0) { Residual[size(Residual)+1]=Rows[ri]; }

// Exact first nonlinear bridge row; all omitted variables are free.
// ambient_variables=907 active_variables=8 inactive_variables=899
ring R=0,(B1c_7_19,B1c_7_20,B1c_7_21,B1c_7_22,B1c_7_23,B1c_7_24,B1c_7_25,c,Zc),dp;
poly r=-98304*B1c_7_19 + 98304*B1c_7_20 - 98304*B1c_7_21 + 98304*B1c_7_22 - 98304*B1c_7_23 + 98304*B1c_7_24 - 98304*B1c_7_25;
ideal I=r,Zc*c-1;
ideal G=std(I);
print("BEGIN_RESULT");
print("unit_remainder="+string(reduce(1,G)));
print("active_localized_dimension="+string(dim(G)));
print("full_dimension_with_inactive="+string(dim(G)+899));
print("END_RESULT");
ideal Czero=c,Zc*c-1;
ideal Cone=c-1,Zc*c-1;
print("BEGIN_CONTROLS");
print(reduce(1,std(Czero)));
print(reduce(1,std(Cone)));
print("END_CONTROLS");
quit;

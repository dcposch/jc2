print("  c1: wt="+string(deg(c1))+" size="+string(size(c1))+" homog="+string(homog(c1)));
poly c2=subst(T3,b3,0);
poly b2=subst(diff(T3,b3),b3,0);
poly a2=subst(diff(diff(T3,b3),b3),b3,0)/2;
if (T3-(a2*b3^2+b2*b3+c2)!=0) { print("FAIL b3-split r=2"); }
print("STRUCT r=2 k=3: wt(T)="+string(deg(T3))+" homog="+string(homog(T3))+" deg_b3="+string(deg(T3,b3wt)));
print("  a2: wt="+string(deg(a2))+" size="+string(size(a2))+" homog="+string(homog(a2)));

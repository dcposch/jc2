int r; intvec b3wt=0,0,1;
poly c0=subst(T5,b3,0);
poly b0=subst(diff(T5,b3),b3,0);
poly a0=subst(diff(diff(T5,b3),b3),b3,0)/2;
if (T5-(a0*b3^2+b0*b3+c0)!=0) { print("FAIL b3-split r=0"); }
print("STRUCT r=0 k=5: wt(T)="+string(deg(T5))+" homog="+string(homog(T5))+" deg_b3="+string(deg(T5,b3wt)));

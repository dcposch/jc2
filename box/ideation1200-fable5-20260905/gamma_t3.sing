print("  c0: wt="+string(deg(c0))+" size="+string(size(c0))+" homog="+string(homog(c0)));
poly c1=subst(T4,b3,0);
poly b1=subst(diff(T4,b3),b3,0);
poly a1=subst(diff(diff(T4,b3),b3),b3,0)/2;
if (T4-(a1*b3^2+b1*b3+c1)!=0) { print("FAIL b3-split r=1"); }
print("STRUCT r=1 k=4: wt(T)="+string(deg(T4))+" homog="+string(homog(T4))+" deg_b3="+string(deg(T4,b3wt)));

ring P=(32003),(b4,q2_0),wp(1,2);
number yy=7608;
option(redSB);
poly B1=imap(S,B1);
poly C1=imap(S,C1);
poly W1=imap(S,W1);
poly B2=imap(S,B2);
poly C2=imap(S,C2);
poly W2=imap(S,W2);
poly a0=imap(S,a0); poly b0=imap(S,b0); poly c0=imap(S,c0);
ideal Bs=B1,B2;
ideal Cs=C1,C2;
ideal Ws=W1,W2;
ideal BC=Bs+Cs;

LIB "primdec.lib";
matrix N[2][2]=C1,B1,C2,B2;
ideal I2=minor(N,2);
int tm=timer;
ideal gI2=std(I2);
print("GAMMA t=3 I2: ngens="+string(size(I2))+" dim="+string(dim(gI2))+" mult="+string(mult(gI2))+" time="+string(timer-tm));
ideal J1=I2+ideal(b4-1);
ideal gJ1=std(J1);
print("GAMMA t=3 chart b4=1: vdim="+string(vdim(gJ1)));
tm=timer;
ideal rJ1=radical(J1);
ideal grJ1=std(rJ1);
print("GAMMA t=3 chart b4=1 REDUCED: npoints="+string(vdim(grJ1))+" time="+string(timer-tm));
ideal U1=finduni(grJ1);
int i; int j; list FL;
for(i=1;i<=size(U1);i++){
  FL=factorize(U1[i]);
  string s="";
  for(j=1;j<=size(FL[1]);j++){ s=s+" "+string(deg(FL[1][j]))+"^"+string(FL[2][j]); }
  print("GAMMA t=3 finduni var "+string(var(i))+": deg="+string(deg(U1[i]))+" factor-degrees(mod p)="+s);
}
ideal J0=I2+ideal(b4);
ideal gJ0=std(J0);
print("GAMMA t=3 slice b4=0: dim="+string(dim(gJ0)));
if (dim(gJ0)>=1) {
  ideal J01=J0+ideal(q2_0-1); ideal gJ01=std(J01);
  print("GAMMA t=3 chart b4=0,q2=1: vdim="+string(vdim(gJ01))+" reduced="+string(vdim(std(radical(J01)))));
  ideal J00=J0+ideal(q2_0); ideal gJ00=std(J00);
  print("GAMMA t=3 slice b4=0,q2=0: dim="+string(dim(gJ00)));
}
print("GAMMA_DONE t=3");
quit;

print("  c2: wt="+string(deg(c2))+" size="+string(size(c2))+" homog="+string(homog(c2)));
print("A0VALUE: "+string(a0));
if (a0==0) { print("A0_ZERO: split unavailable (a0=0)"); }
poly B1=a0*b1-a1*b0;
poly C1=a0*c1-a1*c0;
poly G1=B1*b3+C1;
if (G1-(a0*T4-a1*T5)!=0) { print("FAIL G-identity r=1"); }
poly W1=a0*C1^2-b0*B1*C1+c0*B1^2;
if (W1-(B1^2*T5-G1*(a0*G1-2*a0*C1+b0*B1))!=0) { print("FAIL eliminant certificate r=1"); }
print("SPLIT r=1: B1 wt="+string(deg(B1))+" size="+string(size(B1))+" homog="+string(homog(B1))+" lead="+string(leadmonom(B1))+" | C1 wt="+string(deg(C1))+" size="+string(size(C1))+" homog="+string(homog(C1))+" lead="+string(leadmonom(C1))+" | W1 wt="+string(deg(W1))+" size="+string(size(W1))+" homog="+string(homog(W1)));
poly B2=a0*b2-a2*b0;
poly C2=a0*c2-a2*c0;
poly G2=B2*b3+C2;
if (G2-(a0*T3-a2*T5)!=0) { print("FAIL G-identity r=2"); }
poly W2=a0*C2^2-b0*B2*C2+c0*B2^2;

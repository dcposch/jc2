ring R=0,(b3,b4),wp(3,1);
number d = 10*(2/5)-3;
intvec W = 3,1;
poly T0 = 39138724476/603745670815*b4^9-79347426/3589451075*b3*b4^6+1516828/21340375*b3^2*b4^3+42/625;
poly T1 = -255276497376/3018728354075*b4^8+454666608/17947255375*b3*b4^5+160596/3679375*b3^2*b4^2;
poly T2 = -76780386/2974116605*b4^7+115776/17682025*b3*b4^4-252/3625*b3^2*b4;
poly T3 = 675939222/14870583025*b4^6-34944/3048625*b3*b4^3-28/625*b3^2;
poly tk; poly ax; int k; int dg;
tk = T0;
print("ROW k=0 terms=" + string(size(tk)) + " wdeg=" + string(deg(tk, W)) + " b3deg=" + string(deg(tk, intvec(1,0))) + " b4deg=" + string(deg(tk, intvec(0,1))));
ax = subst(tk, b3, 0); print("  B4AXIS k=0 coef=" + string(ax/b4^9));
ax = subst(tk, b4, 0); print("  B4ZERO k=0 terms=" + string(size(ax)) + " b3deg=" + string(deg(ax, intvec(1,0))));
tk = T1;
print("ROW k=1 terms=" + string(size(tk)) + " wdeg=" + string(deg(tk, W)) + " b3deg=" + string(deg(tk, intvec(1,0))) + " b4deg=" + string(deg(tk, intvec(0,1))));
ax = subst(tk, b3, 0); print("  B4AXIS k=1 coef=" + string(ax/b4^8));
ax = subst(tk, b4, 0); print("  B4ZERO k=1 terms=" + string(size(ax)) + " b3deg=" + string(deg(ax, intvec(1,0))));
tk = T2;
print("ROW k=2 terms=" + string(size(tk)) + " wdeg=" + string(deg(tk, W)) + " b3deg=" + string(deg(tk, intvec(1,0))) + " b4deg=" + string(deg(tk, intvec(0,1))));
ax = subst(tk, b3, 0); print("  B4AXIS k=2 coef=" + string(ax/b4^7));
ax = subst(tk, b4, 0); print("  B4ZERO k=2 terms=" + string(size(ax)) + " b3deg=" + string(deg(ax, intvec(1,0))));
tk = T3;
print("ROW k=3 terms=" + string(size(tk)) + " wdeg=" + string(deg(tk, W)) + " b3deg=" + string(deg(tk, intvec(1,0))) + " b4deg=" + string(deg(tk, intvec(0,1))));
ax = subst(tk, b3, 0); print("  B4AXIS k=3 coef=" + string(ax/b4^6));
ax = subst(tk, b4, 0); print("  B4ZERO k=3 terms=" + string(size(ax)) + " b3deg=" + string(deg(ax, intvec(1,0))));
poly a2 = subst(T3, b4, 0); print("ALPHA_DATA=" + string(a2)); 
number alpha = -2*(3*2+1)*(27*d*2^3-30*d*2^2+d*2-2*d+6*2^3+13*2^2-3*2+2)/(12*(2*2+1)^2*(3*2-1)^2*(3*2+2));
print("ALPHA_CHECK=" + string(a2 - alpha*b3^2));
tk = subst(T0, b4, 1); print("  LIN k=0 dTdb3|P1=" + string(subst(diff(tk, b3), b3, 0)));
tk = subst(T1, b4, 1); print("  LIN k=1 dTdb3|P1=" + string(subst(diff(tk, b3), b3, 0)));
tk = subst(T2, b4, 1); print("  LIN k=2 dTdb3|P1=" + string(subst(diff(tk, b3), b3, 0)));
tk = subst(T3, b4, 1); print("  LIN k=3 dTdb3|P1=" + string(subst(diff(tk, b3), b3, 0)));
quit;

ring rgen=0,(h,b4,b3,b2,u2,u3,u4,c1),dp;
number d=-1;
option(redSB);
proc must(int ok,string label) { if (!ok) { print("FAIL "+label); quit; } }
proc hco(poly f,int k) { poly z=0; int ii; for(ii=1;ii<=size(f);ii++) { if(deg(f[ii],intvec(1,0,0,0,0,0,0,0))==k) { z=z+f[ii]/h^k; } } return(z); }
number y=(d+3)/10; number g=14*(3*d+6)/750;
poly U=(h+b4)^5+u2*(h+b4)^3+u3*(h+b4)^2+u4*(h+b4)^1;
poly C=(h+b4)^1+c1*(h+b4)^0;
poly BB=0; poly SS=0; poly vv; int m; int aa; int bb; poly acc;
for(m=0;m<2;m++) { BB=BB+g*(3*m+5)*hco(C,m)*h^(m+1)/(2*y*(m+1)); }
for(m=0;m<=4;m++) { acc=3*g*(m+1)*hco(U,m+1)+g*b3*(5*m+7)*hco(C,m)/2; for(aa=0;aa<m;aa++) { bb=m-1-aa; acc=acc+(3+2*aa-bb)*hco(C,aa)*hco(BB,bb); } SS=SS+acc*h^m/(y*(2*m+1)); }
poly VV=h^2*C-y*b3; poly YY=h*SS-b3*BB-g*b2; poly zpiece=h*BB-g*b3;
poly NN=-VV*diff(YY,h)+diff(VV,h)*YY+2*diff(U,h)*zpiece;
poly PP=(NN-subst(NN,h,0))/(2*y*h);
must(2*y*h*PP==NN-subst(NN,h,0),"DIVISION");
poly RR=VV*PP-diff(U,h)*YY-y*g; RR=subst(RR,h,h-b4);
poly band; number pv; poly val;
band=hco(RR,8); must(diff(diff(band,c1),c1)==0,"AFFINE1");
must(size(diff(band,c1))==1 && deg(diff(band,c1))==0,"SCALAR1"); pv=leadcoef(diff(band,c1)); must(pv!=0,"PIVOT1");
val=-subst(band,c1,0)/pv; RR=subst(RR,c1,val); print("PIVOT 1 PASS");
band=hco(RR,7); must(diff(diff(band,u2),u2)==0,"AFFINE2");
must(size(diff(band,u2))==1 && deg(diff(band,u2))==0,"SCALAR2"); pv=leadcoef(diff(band,u2)); must(pv!=0,"PIVOT2");
val=-subst(band,u2,0)/pv; RR=subst(RR,u2,val); print("PIVOT 2 PASS");
band=hco(RR,6); must(diff(diff(band,u3),u3)==0,"AFFINE3");
must(size(diff(band,u3))==1 && deg(diff(band,u3))==0,"SCALAR3"); pv=leadcoef(diff(band,u3)); must(pv!=0,"PIVOT3");
val=-subst(band,u3,0)/pv; RR=subst(RR,u3,val); print("PIVOT 3 PASS");
band=hco(RR,5); must(diff(diff(band,u4),u4)==0,"AFFINE4");
must(size(diff(band,u4))==1 && deg(diff(band,u4))==0,"SCALAR4"); pv=leadcoef(diff(band,u4)); must(pv!=0,"PIVOT4");
val=-subst(band,u4,0)/pv; RR=subst(RR,u4,val); print("PIVOT 4 PASS");
band=hco(RR,4); must(diff(diff(band,b2),b2)==0,"AFFINE5");
must(size(diff(band,b2))==1 && deg(diff(band,b2))==0,"SCALAR5"); pv=leadcoef(diff(band,b2)); must(pv!=0,"PIVOT5");
val=-subst(band,b2,0)/pv; RR=subst(RR,b2,val); print("PIVOT 5 PASS");
for(m=4;m<=9;m++) { must(hco(RR,m)==0,"HIGH_BAND"); }
must(diff(RR,c1)==0,"ELIM_c1");
must(diff(RR,u2)==0,"ELIM_u2");
must(diff(RR,u3)==0,"ELIM_u3");
must(diff(RR,u4)==0,"ELIM_u4");
must(diff(RR,b2)==0,"ELIM_b2");
ideal rows;
rows[1]=-hco(RR,0);
rows[2]=-hco(RR,1);
rows[3]=-hco(RR,2);
rows[4]=-hco(RR,3);
ring rres=0,(b4,b3),wp(1,3);
number d=-1;
ideal rows=imap(rgen,rows);
number y=(d+3)/10; number g=14*(3*d+6)/750;
poly tau=rows[1]-y*g;
poly ax=rows[4];
ax=subst(ax,b4,0);
number aexpect=-14*((96)*d+96)/60000;
must(ax==aexpect*b3^2,"AXIS_ALPHA");
poly zero=tau;
zero=subst(zero,b4,0);
zero=subst(zero,b3,0);
must(zero==0,"TAU_CONSTANT");
write("/home/ubuntu/jc2/box/k16astra-20260905/t2m_rows.sing","// Generated from frozen coefficient-array formulas; t=2");
write("/home/ubuntu/jc2/box/k16astra-20260905/t2m_rows.sing","ring rres=0,(b4,b3),wp(1,3);");
write("/home/ubuntu/jc2/box/k16astra-20260905/t2m_rows.sing","number d=-1;");
write("/home/ubuntu/jc2/box/k16astra-20260905/t2m_rows.sing","poly T0="+string(rows[1])+";");
write("/home/ubuntu/jc2/box/k16astra-20260905/t2m_rows.sing","poly T1="+string(rows[2])+";");
write("/home/ubuntu/jc2/box/k16astra-20260905/t2m_rows.sing","poly T2="+string(rows[3])+";");
write("/home/ubuntu/jc2/box/k16astra-20260905/t2m_rows.sing","poly T3="+string(rows[4])+";");
write("/home/ubuntu/jc2/box/k16astra-20260905/t2m_rows.sing","poly tau="+string(tau)+";");
print("ROWS_COMPLETE"); quit;

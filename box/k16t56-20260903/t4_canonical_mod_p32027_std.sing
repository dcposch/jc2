// t=4 terminal + H_t in GF(32027)[y, remaining]; method=std
LIB "elim.lib";
ring RAC=32027,(gamma,pi),dp;
poly FAC=pi;
poly GAC=pi-(gamma^2)/2;
poly JAC=diff(FAC,gamma)*diff(GAC,pi)-diff(FAC,pi)*diff(GAC,gamma);
if (JAC==gamma) { print("CONTROL_ACTUAL_PAIR_PASS J=gamma"); } else { print("CONTROL_ACTUAL_PAIR_FAIL"); }
if (nameof(basering)=="RAC") { print("CONTROL_RAC_RING_PASS"); } else { print("CONTROL_RAC_RING_FAIL"); }
ring R=32027,(q9_1,q5_0,q6_1,q7_1,q8_1,W),dp;
option(redSB);
if (nameof(basering)=="R") { print("CONTROL_RING_PASS R"); } else { print("CONTROL_RING_FAIL"); }
ideal RE=q9_1,W*q9_1-1;
ideal RGE=std(RE);
if (typeof(RGE)=="ideal" && nameof(basering)=="R") { print("CONTROL_R_EMPTY_EXTRACT_RING_PASS"); } else { print("CONTROL_R_EMPTY_EXTRACT_RING_FAIL"); }
if (reduce(1,RGE)==0) { print("CONTROL_R_EMPTY_PASS"); } else { print("CONTROL_R_EMPTY_FAIL"); }
ideal RN=q9_1-1,W*q9_1-1;
ideal RGN=std(RN);
if (typeof(RGN)=="ideal" && nameof(basering)=="R") { print("CONTROL_R_NONEMPTY_EXTRACT_RING_PASS"); } else { print("CONTROL_R_NONEMPTY_EXTRACT_RING_FAIL"); }
if (reduce(1,RGN)!=0) { print("CONTROL_R_NONEMPTY_PASS"); } else { print("CONTROL_R_NONEMPTY_FAIL"); }

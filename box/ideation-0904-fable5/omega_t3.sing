ring W=(0,yy),(b4,q2_0,b3),wp(1,2,4);
minpoly=588*yy^2-336*yy+44;
execute(read("/home/ubuntu/jc2/box/k16toptail-20260903/rows_t3_exact.sing"));
proc inw(poly f, intvec om) {
  int i; int j; int d; int m; poly g=0; intvec e; int first=1;
  for (i=1;i<=size(f);i++) {
    e=leadexp(f[i]); d=0;
    for (j=1;j<=size(om);j++) { d=d+e[j]*om[j]; }
    if (first==1) { m=d; g=f[i]; first=0; }
    else { if (d>m) { m=d; g=f[i]; } else { if (d==m) { g=g+f[i]; } } }
  }
  return(g);
}
int i; intvec om; ideal J; ideal G; int tm;
om=intvec(-1,-1,-1); J=0;
for (i=1;i<=size(TT);i++) { J[i]=inw(TT[i],om); }
tm=timer; G=std(J);

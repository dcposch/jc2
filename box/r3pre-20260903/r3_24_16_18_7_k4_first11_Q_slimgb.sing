// r3_24_16_18_7_k4_first11_Q_slimgb
// first nonzero reciprocal coefficient: F11=1; previous F_i=0
// open condition: h_34 != 0; c=-68*h_34
ring R=0,(T,F12,F13,F14),dp;
option(redSB);
if (nameof(basering)=="R") { print("CONTROL_RING_PASS R"); } else { print("CONTROL_RING_FAIL"); }
print("MAIN_START row=24_16_18_7_k4 first=11 char=0 method=slimgb tails=12 vars=3");
ideal I=3,
3*F12,
3*F12^2 + 6*F13,
3*F12*F13 + 3*F14,
6*F12*F14 + 3*F13^2,
3*F13*F14,
3*F14^2,
0,
0,
0,
0,
-1,
-3*F12*T - 16;
ideal G=slimgb(I);
print("MAIN_DONE basis_size=");
size(G);
if (reduce(1,G)==0) { print("BRANCH_EMPTY_UNIT"); G; } else { print("BRANCH_NONEMPTY"); print("dim_extended="); dim(G); print("vdim="); vdim(G); }
quit;

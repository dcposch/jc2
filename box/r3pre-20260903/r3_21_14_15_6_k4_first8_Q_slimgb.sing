// r3_21_14_15_6_k4_first8_Q_slimgb
// first nonzero reciprocal coefficient: F8=1; previous F_i=0
// open condition: h_29 != 0; c=-58*h_29
ring R=0,(T,F9,F10,F11,F12),dp;
option(redSB);
if (nameof(basering)=="R") { print("CONTROL_RING_PASS R"); } else { print("CONTROL_RING_FAIL"); }
print("MAIN_START row=21_14_15_6_k4 first=8 char=0 method=slimgb tails=10 vars=4");
ideal I=3*F10*F9 + 3*F11,
3*F10^2 + 6*F11*F9 + 6*F12,
3*F10*F11 + 3*F12*F9,
6*F10*F12 + 3*F11^2,
3*F11*F12,
6*F12^2 - 1,
-3*F9,
-3*F10 - 3*F9^2,
-6*F10*F9 - 3*F11 - F9^3,
-3*F10^2 - 3*F10*F9^2 - 6*F11*F9 - 3*F12,
-3*F10^2*F9*T - 6*F10*F11*T - 3*F11*F9^2*T - 6*F12*F9*T - 16;
ideal G=slimgb(I);
print("MAIN_DONE basis_size=");
size(G);
if (reduce(1,G)==0) { print("BRANCH_EMPTY_UNIT"); G; } else { print("BRANCH_NONEMPTY"); print("dim_extended="); dim(G); print("vdim="); vdim(G); }
quit;

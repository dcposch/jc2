if (nameof(basering)=="R") { print("CONTROL_RING_PASS R"); } else { print("CONTROL_RING_FAIL"); }
print("MAIN_START row=21_14_15_6_k4 first=12 char=0 method=slimgb tails=10 vars=0");
ideal I=0,
0,
0,
0,
0,
3,
0,
0,
0,
0,
-1;
ideal G=slimgb(I);
print("MAIN_DONE basis_size=");

ring R=0,(B1c_0_28,B1c_0_29,B1c_0_30,B1c_0_31,B1c_0_32,B1c_0_33,B1c_0_34,B1c_0_35,c,jet1,jet2,Zc),dp;
ideal I=-c - jet1^4,2*jet1^2,8*B1c_0_28*jet2 - 8*B1c_0_28 - 8*B1c_0_29*jet2 + 8*B1c_0_29 + 8*B1c_0_30*jet2 - 8*B1c_0_30 - 8*B1c_0_31*jet2 + 8*B1c_0_31 + 8*B1c_0_32*jet2 - 8*B1c_0_32 - 8*B1c_0_33*jet2 + 8*B1c_0_33 + 8*B1c_0_34*jet2 - 8*B1c_0_34 - 8*B1c_0_35*jet2 + 8*B1c_0_35,Zc*c-1;
ideal Sd=std(I);
print("BEGIN_DIM");print(dim(Sd));print("END_DIM");
print("BEGIN_NF");print(reduce(1,Sd));print("END_NF");
print("BEGIN_SIZE");print(size(Sd));print("END_SIZE");
ideal EmptyControl=c,Zc*c-1;
ideal PointControl=c-1,Zc*c-1;
ideal RawControl=-c - jet1^4,2*jet1^2,8*B1c_0_28*jet2 - 8*B1c_0_28 - 8*B1c_0_29*jet2 + 8*B1c_0_29 + 8*B1c_0_30*jet2 - 8*B1c_0_30 - 8*B1c_0_31*jet2 + 8*B1c_0_31 + 8*B1c_0_32*jet2 - 8*B1c_0_32 - 8*B1c_0_33*jet2 + 8*B1c_0_33 + 8*B1c_0_34*jet2 - 8*B1c_0_34 - 8*B1c_0_35*jet2 + 8*B1c_0_35;
print("BEGIN_CTL");print(reduce(1,std(EmptyControl)));print(reduce(1,std(PointControl)));print(reduce(1,std(RawControl)));print("END_CTL");
quit;

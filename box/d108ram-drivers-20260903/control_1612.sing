print("CONTROL_1612_SAT_REDUCE_ONE_REMAINDER");
reduce(1,G);
ideal N=jc-1,T*jc-1;
ideal GN=std(N);
print("CONTROL_1612_NEGATIVE_BASIS_SIZE");
size(GN);
print("CONTROL_1612_NEGATIVE_REDUCE_ONE_REMAINDER");
reduce(1,GN);
quit;

ring R=0,(Hc_5_4,K2c_5_25,K2c_5_26,c,jet1,jet2,Zc),dp;
ideal I=3600*Hc_5_4^2 + 120*Hc_5_4*K2c_5_25 - 120*Hc_5_4*K2c_5_26 - 19200*Hc_5_4*jet1*jet2 + 840*Hc_5_4 + K2c_5_25^2 - 2*K2c_5_25*K2c_5_26 - 320*K2c_5_25*jet1*jet2 + 14*K2c_5_25 + K2c_5_26^2 + 320*K2c_5_26*jet1*jet2 - 14*K2c_5_26 + 25600*jet1^2*jet2^2 - 2240*jet1*jet2 + 49,Zc*c-1;

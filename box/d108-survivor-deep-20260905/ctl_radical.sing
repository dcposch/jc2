LIB "primdec.lib";
ring Rr=0,(Hc_5_4,K2c_3_26,K2c_4_25,K2c_4_26,K2c_5_25,K2c_5_26,jet1,jet2),dp;
ideal I=K2c_3_26^2 + 16*K2c_3_26*jet2 + 64*jet2^2,-2*K2c_3_26*K2c_4_25 + 2*K2c_3_26*K2c_4_26 + 40*K2c_3_26*jet1^2 - 16*K2c_4_25*jet2 + 16*K2c_4_26*jet2 + 320*jet1^2*jet2,-120*Hc_5_4*K2c_3_26 - 960*Hc_5_4*jet2 - 52*K2c_3_26^2*jet1 - 2*K2c_3_26*K2c_5_25 + 2*K2c_3_26*K2c_5_26 - 512*K2c_3_26*jet1*jet2 - 14*K2c_3_26 + K2c_4_25^2 - 2*K2c_4_25*K2c_4_26 - 40*K2c_4_25*jet1^2 + K2c_4_26^2 + 40*K2c_4_26*jet1^2 - 16*K2c_5_25*jet2 + 16*K2c_5_26*jet2 + 400*jet1^4 - 768*jet1*jet2^2 - 112*jet2;
ideal UV=K2c_3_26+8*jet2,K2c_4_25-K2c_4_26-20*jet1^2;
ideal SI=std(I); ideal SUV=std(UV);
print("BEGIN_ICONT");                 // I contained in <u,v> ?
print(size(reduce(I,SUV)));
print("END_ICONT");
ideal Rad=radical(I); ideal SR=std(Rad);
print("BEGIN_RADEQ");                 // rad(I) == <u,v> ?  both inclusions
print(size(reduce(Rad,SUV)));
print(size(reduce(UV,SR)));
print("END_RADEQ");
print("BEGIN_DIMS");
print(dim(SI)); print(dim(SUV)); print(nvars(Rr));
print("END_DIMS");
print("BEGIN_NOTUNIT");
print(reduce(1,SI)); print(reduce(1,SUV));
print("END_NOTUNIT");
print("BEGIN_PROPER");                // <u,v> is a PROPER ideal, I != <u,v>
print(size(reduce(UV,SI)));
print("END_PROPER");
quit;

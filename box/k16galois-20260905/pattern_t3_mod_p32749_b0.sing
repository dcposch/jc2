ideal J1=I2+ideal(b4-1); list fx; fx[1]=number(1);
int ok=probe(J1,2,fx,"MAIN");
if (ok==1) { evalpoint(2..2,"MAIN"); }
ideal Bd2=I2+ideal(b4,q2_0-1); list fx2; fx2[1]=number(0); fx2[2]=number(1);
print("BDRY2 stratum b4=0,q<2=0,q2=1");
ideal gBd2=std(Bd2);
print("BDRY2 axis point in Gamma: "+string(vdim(gBd2)));
if (vdim(gBd2)>=1) { PT=fx2; PTOK=1; evalpoint(intvec(1),"BDRY2"); }
print("PATTERN_DONE t=3");
print("JOB_DONE");
quit;

intvec b3wt=0,0,0,1;
poly cc0=subst(T7,b3,0);
poly bb0=subst(diff(T7,b3),b3,0);
poly aa0=subst(diff(diff(T7,b3),b3),b3,0)/2;
if (T7-(aa0*b3^2+bb0*b3+cc0)!=0) { print("FAIL b3-split r=0"); }
if (homog(T7)==0 || deg(T7)!=10) { print("FAIL weight r=0"); }
poly cc1=subst(T6,b3,0);
poly bb1=subst(diff(T6,b3),b3,0);
poly aa1=subst(diff(diff(T6,b3),b3),b3,0)/2;
if (T6-(aa1*b3^2+bb1*b3+cc1)!=0) { print("FAIL b3-split r=1"); }
if (homog(T6)==0 || deg(T6)!=11) { print("FAIL weight r=1"); }
poly cc2=subst(T5,b3,0);
poly bb2=subst(diff(T5,b3),b3,0);
poly aa2=subst(diff(diff(T5,b3),b3),b3,0)/2;
if (T5-(aa2*b3^2+bb2*b3+cc2)!=0) { print("FAIL b3-split r=2"); }
if (homog(T5)==0 || deg(T5)!=12) { print("FAIL weight r=2"); }
poly cc3=subst(T4,b3,0);
poly bb3=subst(diff(T4,b3),b3,0);
poly aa3=subst(diff(diff(T4,b3),b3),b3,0)/2;
if (T4-(aa3*b3^2+bb3*b3+cc3)!=0) { print("FAIL b3-split r=3"); }
if (homog(T4)==0 || deg(T4)!=13) { print("FAIL weight r=3"); }
print("A0VALUE: "+string(aa0));
if (aa0==0) { print("FAIL A0_ZERO"); }
poly B1=aa0*bb1-aa1*bb0;
poly C1=aa0*cc1-aa1*cc0;
poly G1=B1*b3+C1;
if (G1-(aa0*T6-aa1*T7)!=0) { print("FAIL G-identity r=1"); }
poly W1=aa0*C1^2-bb0*B1*C1+cc0*B1^2;
if (W1-(B1^2*T7-G1*(aa0*G1-2*aa0*C1+bb0*B1))!=0) { print("FAIL eliminant r=1"); }
poly B2=aa0*bb2-aa2*bb0;
poly C2=aa0*cc2-aa2*cc0;
poly G2=B2*b3+C2;
if (G2-(aa0*T5-aa2*T7)!=0) { print("FAIL G-identity r=2"); }
poly W2=aa0*C2^2-bb0*B2*C2+cc0*B2^2;
if (W2-(B2^2*T7-G2*(aa0*G2-2*aa0*C2+bb0*B2))!=0) { print("FAIL eliminant r=2"); }
poly B3=aa0*bb3-aa3*bb0;
poly C3=aa0*cc3-aa3*cc0;
poly G3=B3*b3+C3;
if (G3-(aa0*T4-aa3*T7)!=0) { print("FAIL G-identity r=3"); }
poly W3=aa0*C3^2-bb0*B3*C3+cc0*B3^2;
if (W3-(B3^2*T7-G3*(aa0*G3-2*aa0*C3+bb0*B3))!=0) { print("FAIL eliminant r=3"); }
ideal Gs=G1,G2,G3;

int ok=probe(J1,2,fx,"MAIN");
if (ok==1) { evalpoint(2..4,"MAIN"); }
ideal Bd2=I2+ideal(b4,q2_0-1); list fx2; fx2[1]=number(0); fx2[2]=number(1);
print("BDRY2 stratum b4=0,q<2=0,q2=1");
ok=probe(Bd2,3,fx2,"BDRY2");
if (ok==1) { evalpoint(intvec(1,3,4),"BDRY2"); }
ideal Bd3=I2+ideal(b4,q2_0,q3_0-1); list fx3; fx3[1]=number(0); fx3[2]=number(0); fx3[3]=number(1);
print("BDRY3 stratum b4=0,q<3=0,q3=1");
ok=probe(Bd3,4,fx3,"BDRY3");
if (ok==1) { evalpoint(intvec(1,2,4),"BDRY3"); }
ideal Bd4=I2+ideal(b4,q2_0,q3_0,q4_0-1); list fx4; fx4[1]=number(0); fx4[2]=number(0); fx4[3]=number(0); fx4[4]=number(1);
print("BDRY4 stratum b4=0,q<4=0,q4=1");
ideal gBd4=std(Bd4);
print("BDRY4 axis point in Gamma: "+string(vdim(gBd4)));
if (vdim(gBd4)>=1) { PT=fx4; PTOK=1; evalpoint(intvec(1,2,3),"BDRY4"); }
print("PATTERN_DONE t=5");
print("JOB_DONE");
quit;

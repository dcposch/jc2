if (T5-(aa4*b3^2+bb4*b3+cc4)!=0) { print("FAIL b3-split r=4"); }
if (homog(T5)==0 || deg(T5)!=16) { print("FAIL weight r=4"); }
print("A0VALUE: "+string(aa0));
if (aa0==0) { print("FAIL A0_ZERO"); }
poly B1=aa0*bb1-aa1*bb0;
poly C1=aa0*cc1-aa1*cc0;
poly G1=B1*b3+C1;
if (G1-(aa0*T8-aa1*T9)!=0) { print("FAIL G-identity r=1"); }
poly W1=aa0*C1^2-bb0*B1*C1+cc0*B1^2;
if (W1-(B1^2*T9-G1*(aa0*G1-2*aa0*C1+bb0*B1))!=0) { print("FAIL eliminant r=1"); }
poly B2=aa0*bb2-aa2*bb0;
poly C2=aa0*cc2-aa2*cc0;
poly G2=B2*b3+C2;
if (G2-(aa0*T7-aa2*T9)!=0) { print("FAIL G-identity r=2"); }
poly W2=aa0*C2^2-bb0*B2*C2+cc0*B2^2;
if (W2-(B2^2*T9-G2*(aa0*G2-2*aa0*C2+bb0*B2))!=0) { print("FAIL eliminant r=2"); }

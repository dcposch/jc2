if (T6-(aa3*b3^2+bb3*b3+cc3)!=0) { print("FAIL b3-split r=3"); }
if (homog(T6)==0 || deg(T6)!=15) { print("FAIL weight r=3"); }
poly cc4=subst(T5,b3,0);
poly bb4=subst(diff(T5,b3),b3,0);

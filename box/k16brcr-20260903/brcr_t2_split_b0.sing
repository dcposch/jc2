// Generated Laurent/Euler terminal recurrence.
// t=2 mode=split-exact branch=0 charts=none
ring R=0,(h,s,b1,b2,b3,b4,B0,C1,q2_0,q3_0,q4_0),dp;
number yy=(1/5);
option(redSB);
proc hcoef(poly f, int k)
{
  matrix M=coef(f,h);
  int ii;
  for (ii=1; ii<=ncols(M); ii++)
  { if (M[1,ii]==h^k) { return(M[2,ii]); } }
  return(0);
}
proc eulerInverse(poly f)
{
  matrix M=coef(f,s);
  poly answer=0; int ii; int mm;
  for (ii=1; ii<=ncols(M); ii++)
  { mm=deg(M[1,ii]); answer=answer+M[2,ii]*M[1,ii]/((2*mm+1)*yy); }
  return(answer);
}
number g1=7/5;
number g2=(7/5)*yy+(14/50);
number g3=(14/25)*yy-(42/750);
number cc=-yy*g3;
poly Uh=h^5+q2_0*h^3+q3_0*h^2+q4_0*h^1;
poly Ch=h^1+C1*h^0;
poly U=subst(Uh,h,s+b4);
poly Cp=subst(Ch,h,s+b4);
poly A=s*Cp;
poly Bprime=g3*(5*Cp+3*s*diff(Cp,s))/(2*yy);
matrix MB=coef(Bprime,s);
poly B=B0; int ii; int mm;
for (ii=1; ii<=ncols(MB); ii++)
{ mm=deg(MB[1,ii]); B=B+MB[2,ii]*s*MB[1,ii]/(mm+1); }
if (diff(B,s)-Bprime!=0) { print("FAIL B derivative"); exit(2); }
poly rhsD=3*g3*diff(U,s)+A*B-s*A*diff(B,s)+2*s*diff(A,s)*B
          +g3*b3*(A/s+(5/2)*diff(A,s));
poly D=eulerInverse(rhsD);
if (yy*(D+2*s*diff(D,s))-rhsD!=0) { print("FAIL Euler inverse"); exit(2); }
poly Q1=s*A-yy*b3;
poly Y=s*D-b3*B-g3*b2;
poly Z=s*B-g3*b3;
poly numD1=yy*g3*b1-Q1*diff(Y,s)+diff(Q1,s)*Y+2*diff(U,s)*Z;
poly constantS=subst(numD1,s,0);
poly pb1=diff(constantS,b1);
poly b1rhs=-subst(constantS,b1,0)/pb1;
numD1=subst(numD1,b1,b1rhs);
if (subst(numD1,s,0)!=0) { print("FAIL b1 divisibility"); exit(2); }
poly Xprime=numD1/(2*yy*s);
poly gauge=hcoef(subst(Xprime,s,h-b4),4);
poly pB0=diff(gauge,B0);
poly B0rhs=-subst(gauge,B0,0)/pB0;
B=subst(B,B0,B0rhs);
D=subst(D,B0,B0rhs);
Y=subst(Y,B0,B0rhs);
Z=subst(Z,B0,B0rhs);
Xprime=subst(Xprime,B0,B0rhs);
b1rhs=subst(b1rhs,B0,B0rhs);
if (subst(gauge,B0,B0rhs)!=0) { print("FAIL B0 gauge"); exit(2); }
// RR is -E.  The requested terminal row is T[k]=-hcoef(RR,h,k).
poly RR=Q1*Xprime-diff(U,s)*Y-yy*g3;
poly Rh=subst(RR,s,h-b4);
poly W1=hcoef(Rh,8);
poly p1=diff(W1,C1);
poly v1rhs=-subst(W1,C1,0)/p1;
if (subst(W1,C1,v1rhs)!=0) { print("FAIL pivot 1"); exit(2); }
Rh=subst(Rh,C1,v1rhs);
print("PIVOT weight=1 band=8 variable=C1"); p1;
poly W2=hcoef(Rh,7);
poly p2=diff(W2,q2_0);
poly v2rhs=-subst(W2,q2_0,0)/p2;
if (subst(W2,q2_0,v2rhs)!=0) { print("FAIL pivot 2"); exit(2); }
Rh=subst(Rh,q2_0,v2rhs);
print("PIVOT weight=2 band=7 variable=q2_0"); p2;
poly W3=hcoef(Rh,6);
poly p3=diff(W3,q3_0);
poly v3rhs=-subst(W3,q3_0,0)/p3;
if (subst(W3,q3_0,v3rhs)!=0) { print("FAIL pivot 3"); exit(2); }
Rh=subst(Rh,q3_0,v3rhs);
print("PIVOT weight=3 band=6 variable=q3_0"); p3;
poly W4=hcoef(Rh,5);
poly p4=diff(W4,q4_0);
poly v4rhs=-subst(W4,q4_0,0)/p4;
if (subst(W4,q4_0,v4rhs)!=0) { print("FAIL pivot 4"); exit(2); }
Rh=subst(Rh,q4_0,v4rhs);
print("PIVOT weight=4 band=5 variable=q4_0"); p4;
poly W5=hcoef(Rh,4);
poly p5=diff(W5,b2);
poly v5rhs=-subst(W5,b2,0)/p5;
if (subst(W5,b2,v5rhs)!=0) { print("FAIL pivot 5"); exit(2); }
Rh=subst(Rh,b2,v5rhs);
print("PIVOT weight=5 band=4 variable=b2"); p5;
if (hcoef(Rh,4)!=0) { print("FAIL high band 4"); exit(2); }
if (hcoef(Rh,5)!=0) { print("FAIL high band 5"); exit(2); }
if (hcoef(Rh,6)!=0) { print("FAIL high band 6"); exit(2); }
if (hcoef(Rh,7)!=0) { print("FAIL high band 7"); exit(2); }
if (hcoef(Rh,8)!=0) { print("FAIL high band 8"); exit(2); }
if (hcoef(Rh,9)!=0) { print("FAIL high band 9"); exit(2); }
poly T0=-hcoef(Rh,0);
print("TERMINAL band=0"); deg(T0); size(T0);
poly T1=-hcoef(Rh,1);
print("TERMINAL band=1"); deg(T1); size(T1);
poly T2=-hcoef(Rh,2);
print("TERMINAL band=2"); deg(T2); size(T2);
poly T3=-hcoef(Rh,3);
print("TERMINAL band=3"); deg(T3); size(T3);
print("RECURRENCE_PASS t=2 rows=4");
print("BRCR_BEGIN t=2");
poly aa0=subst(diff(diff(T3,b3),b3),b3,0)/2;
poly bb0=subst(diff(T3,b3),b3,0);
poly cc0=subst(T3,b3,0);
print("BRCR_ROW r=0 k=3"); T3;
print("BRCR_A r=0 size="+string(size(aa0))); aa0;
print("BRCR_b r=0 size="+string(size(bb0))); bb0;
print("BRCR_c r=0 size="+string(size(cc0))); cc0;
if (T3-aa0*b3^2-bb0*b3-cc0!=0) { print("FAIL BRCR split r=0"); exit(2); }
poly aa1=subst(diff(diff(T2,b3),b3),b3,0)/2;
poly bb1=subst(diff(T2,b3),b3,0);
poly cc1=subst(T2,b3,0);
print("BRCR_ROW r=1 k=2"); T2;
print("BRCR_A r=1 size="+string(size(aa1))); aa1;
print("BRCR_b r=1 size="+string(size(bb1))); bb1;
print("BRCR_c r=1 size="+string(size(cc1))); cc1;
if (T2-aa1*b3^2-bb1*b3-cc1!=0) { print("FAIL BRCR split r=1"); exit(2); }
poly BB1=aa0*bb1-aa1*bb0;
poly CC1=aa0*cc1-aa1*cc0;
poly GG1=BB1*b3+CC1;
poly WW1=aa0*CC1^2-bb0*BB1*CC1+cc0*BB1^2;
if (GG1-(aa0*T2-aa1*T3)!=0) { print("FAIL BRCR G r=1"); exit(2); }
print("BRCR_B r=1 size="+string(size(BB1))); BB1;
print("BRCR_C r=1 size="+string(size(CC1))); CC1;
print("BRCR_W r=1 size="+string(size(WW1))); WW1;
print("BRCR_B4AXIS name=BB1"); BB1;
print("BRCR_B4AXIS name=CC1"); CC1;
print("BRCR_DONE");
print("DRIVER_DONE");
quit;

[{"id":"117104487642004453","created_at":"2026-08-16T09:31:14.000Z","in_reply_to_id":null,"in_reply_to_account_id":null,"sensitive":false,"spoiler_text":"","visibility":"public","language":"en","uri":"https://mastodon.online/users/KilleansRow/statuses/117104487571342477","url":"https://mastodon.online/@KilleansRow/117104487571342477","replies_count":0,"reblogs_count":1,"favourites_count":0,"quotes_count":0,"edited_at":null,"content":"<p><a href=\"https://mastodon.online/tags/Riemann\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>Riemann</span></a> and the <a href=\"https://mastodon.online/tags/JacobianConjecture\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>JacobianConjecture</span></a> are very different animals. The  in the moment bit is that <a href=\"https://mastodon.online/tags/AI\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>AI</span></a> is brute forcing paths to solutions and/or finding new bounds on the space of solutions. The added wrinkle with AI is holding out on telling folks what prompted (literally) the solution, or initial results that will have had too little time for vetting before becoming breaking news. <br>Still, it’s good to see <a href=\"https://mastodon.online/tags/Mathematics\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>Mathematics</span></a> getting showtime.The reality of <a href=\"https://mastodon.online/tags/AI\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>AI</span></a> doing the heavy lifting ? Still unsettling</p>","reblog":null,"account":{"id":"109329300364240357","username":"KilleansRow","acct":"KilleansRow@mastodon.online","display_name":"KilleansRow 🇺🇲 🇺🇦🍀","locked":false,"bot":false,"discoverable":true,"indexable":false,"group":false,"created_at":"2022-11-07T00:00:00.000Z","note":"<p>Researcher, Musician, Tennis Player</p>","url":"https://mastodon.online/@KilleansRow",
ring r=0,(A,q),dp;
ideal I=-8*A^5 - 84*A^4*q + 568*A^3*q^2 - 11*A^3 + 1488*A^2*q^3 + 120*A^2*q - 9824*A*q^4 + 172*A*q^2 + 13*A + 10752*q^5 - 800*q^3 + 2*q,23*A^6 - 120*A^5*q - 1704*A^4*q^2 - 56*A^4 + 4384*A^3*q^3 - 316*A^3*q + 19120*A^2*q^4 + 880*A^2*q^2 - 23*A^2 - 67840*A*q^5 + 2800*A*q^3 + 48*A*q + 53760*q^6 - 5440*q^4 + 92*q^2 + 8,-6*A^7 + 120*A^6*q + 288*A^5*q^2 + 34*A^5 - 4800*A^4*q^3 - 56*A^4*q + 3360*A^3*q^4 - 1144*A^3*q^2 - 23*A^3 + 49536*A^2*q^5 + 1856*A^2*q^3 - 68*A^2*q - 128256*A*q^6 + 6720*A*q^4 + 164*A*q^2 - 5*A + 92160*q^7 - 11904*q^5 + 288*q^3 + 6*q,7*A^8 - 280*A^7*q + 2408*A^6*q^2 - 70*A^6 + 12992*A^5*q^3 + 1372*A^5*q - 104272*A^4*q^4 + 2968*A^4*q^2 + 183*A^4 - 9856*A^3*q^5 - 33936*A^3*q^3 - 20*A^3*q + 1136128*A^2*q^6 + 10752*A^2*q^4 - 2436*A^2*q^2 - 40*A^2 - 2472960*A*q^7 + 178304*A*q^5 + 2048*A*q^3 - 16*A*q + 1612800*q^8 - 215040*q^6 + 3328*q^4 + 256*q^2 - 8;
ideal G=std(I);
print("RESONANT_QUADRATIC_BASIS");
G;
if (size(G)!=1 || G[1]!=1) { ERROR("unit ideal missing"); }
ring c=0,(b,a,x),dp;
poly L=-b+a*x^3;
poly P=-(L^2)/4;
poly F=x*diff(P^2,x)-3*P^2+3*L*(L+b)*P/2-3*L^3*(L+2*b)/16;
if(F!=0) { ERROR("cubic family control failed"); }
print("CUBIC_CONTROL_PASS");
quit;

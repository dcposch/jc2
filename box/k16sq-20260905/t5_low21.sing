< "/home/ubuntu/jc2/box/k16sq-20260905/t5_rows.sing";
option(redSB); intvec wv=1,2,3,4,6; int W=21;
ideal Iplus=T1,T2,T3,T4,T5,T6,T7,T8,T9;
degBound=W; int tt=timer; ideal GI=std(Iplus); print("TRUNC_STD_MS "+string(timer-tt)+" size "+string(size(GI)));
int w; string s=""; for(w=0;w<=W;w++){ int hw=size(weightKB(GI,w,wv)); s=s+string(hw)+","; kill hw; } print("HF_BY_WEIGHT_TRUNC "+s);
print("TAU_NF_ZERO "+string(reduce(tau,GI)==0)); print("TAU_NF_TERMS "+string(size(reduce(tau,GI))));
print("LOW_COMPLETE"); quit;

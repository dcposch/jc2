ring rgen=(0,d),(h,b4,b3,b2,u2,u3,u4,u5,u6,c1,c2),dp;
minpoly=3*d^2-4;
option(redSB);
proc must(int ok,string label) { if (!ok) { print("FAIL "+label); quit; } }
proc hco(poly f,int k) { matrix mm=coef(f,h); int ii; for(ii=1;ii<=ncols(mm);ii++) { if(deg(mm[1,ii])==k) { return(mm[2,ii]); } } return(poly(0)); }
number y=(d+4)/14; number g=30*(3*d+8)/2058;
poly U=(h+b4)^7+u2*(h+b4)^5+u3*(h+b4)^4+u4*(h+b4)^3+u5*(h+b4)^2+u6*(h+b4)^1;
poly C=(h+b4)^2+c1*(h+b4)^1+c2*(h+b4)^0;
poly BB=0; poly SS=0; poly vv; int m; int aa; int bb; poly acc;
for(m=0;m<3;m++) { BB=BB+g*(3*m+5)*hco(C,m)*h^(m+1)/(2*y*(m+1)); }
for(m=0;m<=6;m++) { acc=3*g*(m+1)*hco(U,m+1)+g*b3*(5*m+7)*hco(C,m)/2; for(aa=0;aa<m;aa++) { bb=m-1-aa; acc=acc+(3+2*aa-bb)*hco(C,aa)*hco(BB,bb); } SS=SS+acc*h^m/(y*(2*m+1)); }
poly VV=h^2*C-y*b3; poly YY=h*SS-b3*BB-g*b2; poly zpiece=h*BB-g*b3;
poly NN=-VV*diff(YY,h)+diff(VV,h)*YY+2*diff(U,h)*zpiece;
poly Nconst=subst(NN,h,0);
poly PP=(NN-subst(NN,h,0))/(2*y*h);
must(2*y*h*PP==NN-subst(NN,h,0),"DIVISION");
poly RR=VV*PP-diff(U,h)*YY-y*g; RR=subst(RR,h,h-b4);
poly band; number pv; poly val;
band=hco(RR,12); must(diff(diff(band,c1),c1)==0,"AFFINE1");
must(size(diff(band,c1))==1 && deg(diff(band,c1))==0,"SCALAR1"); pv=leadcoef(diff(band,c1)); must(pv!=0,"PIVOT1");
val=-subst(band,c1,0)/pv; RR=subst(RR,c1,val); print("PIVOT 1 PASS");
U=subst(U,c1,val); C=subst(C,c1,val); BB=subst(BB,c1,val); SS=subst(SS,c1,val); Nconst=subst(Nconst,c1,val);
band=hco(RR,11); must(diff(diff(band,c2),c2)==0,"AFFINE2");
must(size(diff(band,c2))==1 && deg(diff(band,c2))==0,"SCALAR2"); pv=leadcoef(diff(band,c2)); must(pv!=0,"PIVOT2");
val=-subst(band,c2,0)/pv; RR=subst(RR,c2,val); print("PIVOT 2 PASS");
U=subst(U,c2,val); C=subst(C,c2,val); BB=subst(BB,c2,val); SS=subst(SS,c2,val); Nconst=subst(Nconst,c2,val);
band=hco(RR,10); must(diff(diff(band,u3),u3)==0,"AFFINE3");
must(size(diff(band,u3))==1 && deg(diff(band,u3))==0,"SCALAR3"); pv=leadcoef(diff(band,u3)); must(pv!=0,"PIVOT3");
val=-subst(band,u3,0)/pv; RR=subst(RR,u3,val); print("PIVOT 3 PASS");
U=subst(U,u3,val); C=subst(C,u3,val); BB=subst(BB,u3,val); SS=subst(SS,u3,val); Nconst=subst(Nconst,u3,val);
band=hco(RR,9); must(diff(diff(band,u4),u4)==0,"AFFINE4");
must(size(diff(band,u4))==1 && deg(diff(band,u4))==0,"SCALAR4"); pv=leadcoef(diff(band,u4)); must(pv!=0,"PIVOT4");
val=-subst(band,u4,0)/pv; RR=subst(RR,u4,val); print("PIVOT 4 PASS");
U=subst(U,u4,val); C=subst(C,u4,val); BB=subst(BB,u4,val); SS=subst(SS,u4,val); Nconst=subst(Nconst,u4,val);
band=hco(RR,8); must(diff(diff(band,u5),u5)==0,"AFFINE5");
must(size(diff(band,u5))==1 && deg(diff(band,u5))==0,"SCALAR5"); pv=leadcoef(diff(band,u5)); must(pv!=0,"PIVOT5");
val=-subst(band,u5,0)/pv; RR=subst(RR,u5,val); print("PIVOT 5 PASS");
U=subst(U,u5,val); C=subst(C,u5,val); BB=subst(BB,u5,val); SS=subst(SS,u5,val); Nconst=subst(Nconst,u5,val);
band=hco(RR,7); must(diff(diff(band,u6),u6)==0,"AFFINE6");
must(size(diff(band,u6))==1 && deg(diff(band,u6))==0,"SCALAR6"); pv=leadcoef(diff(band,u6)); must(pv!=0,"PIVOT6");
val=-subst(band,u6,0)/pv; RR=subst(RR,u6,val); print("PIVOT 6 PASS");
U=subst(U,u6,val); C=subst(C,u6,val); BB=subst(BB,u6,val); SS=subst(SS,u6,val); Nconst=subst(Nconst,u6,val);
band=hco(RR,6); must(diff(diff(band,b2),b2)==0,"AFFINE7");
must(size(diff(band,b2))==1 && deg(diff(band,b2))==0,"SCALAR7"); pv=leadcoef(diff(band,b2)); must(pv!=0,"PIVOT7");
val=-subst(band,b2,0)/pv; RR=subst(RR,b2,val); print("PIVOT 7 PASS");
U=subst(U,b2,val); C=subst(C,b2,val); BB=subst(BB,b2,val); SS=subst(SS,b2,val); Nconst=subst(Nconst,b2,val);
for(m=6;m<=13;m++) { must(hco(RR,m)==0,"HIGH_BAND"); }
must(diff(RR,c1)==0,"ELIM_c1");
must(diff(RR,c2)==0,"ELIM_c2");
must(diff(RR,u3)==0,"ELIM_u3");
must(diff(RR,u4)==0,"ELIM_u4");
must(diff(RR,u5)==0,"ELIM_u5");
must(diff(RR,u6)==0,"ELIM_u6");
must(diff(RR,b2)==0,"ELIM_b2");
ideal rows;
rows[1]=-hco(RR,0);
rows[2]=-hco(RR,1);
rows[3]=-hco(RR,2);
rows[4]=-hco(RR,3);
rows[5]=-hco(RR,4);
rows[6]=-hco(RR,5);
poly spineB2=val; poly rootR=subst(diff(U,h),h,0)+b3*subst(C,h,0); poly spineB1=-Nconst/(y*g);
must(y*spineB1+b3*rootR==0,"LOCAL_B1");
must(-subst(RR,h,b4)-y*g+g*spineB2*rootR==0,"LOCAL_TAU");
poly abelW=h*SS/g-spineB2-h^2*C*BB/(g*y)-b3*h*C/(2*y)+3*h^3*C^2/(4*y^2);
poly eta=hco(abelW,1); poly bigA=3*h^3*C^2/(4*y^2); poly bigD=3*b3*h*C/(2*y);
must(subst(abelW,h,0)==-spineB2,"ABEL_CONSTANT"); must(eta==3*rootR/y,"ABEL_ETA");
poly abelRhs=abelW^2+(spineB2-2*bigA+bigD)*abelW+bigA*(bigA-bigD)/3-spineB2*(bigA-bigD)-b3*eta*(h^2*C-y*b3)/(2*y)-spineB2*h*eta+(b3^2*bigA/2-b3^2*(spineB2+abelW))/h;
poly abelResidual=2*(h*abelW-(b3^2)/4)*diff(abelW,h)-abelRhs;
must(g*y*abelResidual+3*h*(subst(RR,h,h+b4)-subst(RR,h,b4))==0,"ABEL_ROW_IDENTITY");
print("ABEL_ROW_IDENTITY_PASS");
ring rres=(0,d),(b4,u2,b3),wp(1,2,4);
minpoly=3*d^2-4;
ideal rows=imap(rgen,rows);
poly spineB1=imap(rgen,spineB1); poly spineB2=imap(rgen,spineB2); poly rootR=imap(rgen,rootR);
number y=(d+4)/14; number g=30*(3*d+8)/2058;
poly tau=rows[1]-y*g;
poly ax=rows[6];
ax=subst(ax,b4,0);
ax=subst(ax,u2,0);
number aexpect=-30*((460)*d+272)/413952;
must(ax==aexpect*b3^2,"AXIS_ALPHA");
poly zero=tau;
zero=subst(zero,b4,0);
zero=subst(zero,u2,0);
zero=subst(zero,b3,0);
must(zero==0,"TAU_CONSTANT");
write("/home/ubuntu/jc2/box/k16sq-20260905/t3_rows.sing","// Generated from frozen coefficient-array formulas; t=3");
write("/home/ubuntu/jc2/box/k16sq-20260905/t3_rows.sing","ring rres=(0,d),(b4,u2,b3),wp(1,2,4);");
write("/home/ubuntu/jc2/box/k16sq-20260905/t3_rows.sing","minpoly=3*d^2-4;");
write("/home/ubuntu/jc2/box/k16sq-20260905/t3_rows.sing","poly T0="+string(rows[1])+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t3_rows.sing","poly T1="+string(rows[2])+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t3_rows.sing","poly T2="+string(rows[3])+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t3_rows.sing","poly T3="+string(rows[4])+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t3_rows.sing","poly T4="+string(rows[5])+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t3_rows.sing","poly T5="+string(rows[6])+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t3_rows.sing","poly tau="+string(tau)+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t3_rows.sing","poly spineB1="+string(spineB1)+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t3_rows.sing","poly spineB2="+string(spineB2)+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t3_rows.sing","poly rootR="+string(rootR)+";");
print("LOCAL_IDENTITIES_PASS");
print("ROWS_COMPLETE"); quit;

< "/home/ubuntu/jc2/box/k16sq-20260905/t5_rows.sing";
option(redSB);
intvec wv=1,2,3,4,6; int W=42; int t=5;
ideal Iplus=T1,T2,T3,T4,T5,T6,T7,T8,T9;
degBound=42; int tt=timer; ideal GI=std(Iplus); print("TRUNC_STD_MS "+string(timer-tt)+" size "+string(size(GI)));
int w; string s=""; int mx=-1; int zeros=0; for(w=0;w<=W;w++){ int hw=size(weightKB(GI,w,wv)); s=s+string(hw)+","; if(hw>0){mx=w;} kill hw; } print("HF_BY_WEIGHT_TRUNC "+s); print("LAST_NONZERO_WEIGHT_LE_W "+string(mx));
print("TAU_NF_ZERO "+string(reduce(tau,GI)==0)); print("TAU2_NF_ZERO "+string(reduce(tau^2,GI)==0));
tt=timer; matrix M=lift(Iplus,ideal(tau^2)); print("LIFT_MS "+string(timer-tt));
poly chk=0; int k; for(k=1;k<=ncols(Iplus);k++){ chk=chk+Iplus[k]*M[k,1]; } print("LIFT_VERIFIED "+string(chk==tau^2));
string sup=""; for(k=1;k<=ncols(Iplus);k++){ if(M[k,1]!=0){ sup=sup+string(k)+"(w"+string(deg(M[k,1]))+",n"+string(size(M[k,1]))+") "; } } print("LIFT_SUPPORT "+sup);
write("/home/ubuntu/jc2/box/k16sq-20260905/t5_trunc_lift.txt",string(M));
print("TRUNC_COMPLETE"); quit;

< "/home/ubuntu/jc2/box/k16sq-20260905/t2p_rows.sing";
option(redSB);
int t=2; int q=5;
intvec wv=1,3;
number y=(d+3)/10; number g=14*(3*d+6)/750;
proc ishomog(poly f, int w) { return(f==jet(f,w,wv)-jet(f,w-1,wv)); }
proc hist(ideal KB) { int i; int w; int mx=0; for(i=1;i<=size(KB);i++){ if(deg(KB[i])>mx){mx=deg(KB[i]);} } intvec h; h[mx+1]=0; for(i=1;i<=size(KB);i++){ w=deg(KB[i]); h[w+1]=h[w+1]+1; } string s=""; for(w=0;w<=mx;w++){ s=s+string(h[w+1])+","; } print("HF_BY_WEIGHT "+s); print("SOCLE_WEIGHT "+string(mx)); }
int k;
print("ROW 0 wdeg "+string(deg(T0))+" homog "+string(ishomog(T0,9))+" nterms "+string(size(T0)));
print("ROW 1 wdeg "+string(deg(T1))+" homog "+string(ishomog(T1,8))+" nterms "+string(size(T1)));
print("ROW 2 wdeg "+string(deg(T2))+" homog "+string(ishomog(T2,7))+" nterms "+string(size(T2)));
print("ROW 3 wdeg "+string(deg(T3))+" homog "+string(ishomog(T3,6))+" nterms "+string(size(T3)));
print("TAU wdeg "+string(deg(tau))+" homog "+string(ishomog(tau,9))+" T0-tau-const "+string(T0-tau));
poly b2=spineB2; poly R=rootR; poly b1=spineB1;
print("B1_IDENTITY "+string(y*b1+b3*R==0));
poly acc=tau+g*b2*R;
acc=acc+b4^1*T1;
acc=acc+b4^2*T2;
acc=acc+b4^3*T3;
print("B2_IDENTITY "+string(acc==0));
ideal Iplus=T1,T2,T3;
int tt=timer; ideal GI=std(Iplus); print("STD_TIME_S "+string((timer-tt)/1000.0)); print("STD_SIZE "+string(size(GI)));
print("IPLUS_DIM "+string(dim(GI))); print("IPLUS_VDIM "+string(vdim(GI)));
if(dim(GI)==0){ ideal KB=kbase(GI); hist(KB); }
int N; for(N=1;N<=3;N++){ print("TAU_POWER "+string(N)+" ZERO "+string(reduce(tau^N,GI)==0)); }
list nat=list("b2",b2,"R",R,"b1",b1,"b2R",b2*R,"b2R2",b2*R^2,"b22R",b2^2*R,"b22R2",b2^2*R^2,"b1b2",b1*b2,"b1R",b1*R,"b1sq",b1^2,"b1b2R",b1*b2*R,"b2sq",b2^2,"Rsq",R^2,"b3tau",b3*tau,"b4tau",b4*tau,"Rtau",R*tau,"b2tau",b2*tau,"b1tau",b1*tau,"b3b2",b3*b2,"b3R",b3*R,"b3b1",b3*b1);
int i; for(i=1;i<=size(nat);i=i+2){ print("NAT "+string(nat[i])+" wdeg "+string(deg(nat[i+1]))+" IN_IPLUS "+string(reduce(nat[i+1],GI)==0)); }
ideal Gs=std(Iplus+ideal(b4)); print("SLICE b4 tau_in "+string(reduce(tau,Gs)==0)+" tau2_in "+string(reduce(tau^2,Gs)==0));
ideal Gs=std(Iplus+ideal(b3)); print("SLICE b3 tau_in "+string(reduce(tau,Gs)==0)+" tau2_in "+string(reduce(tau^2,Gs)==0));
tt=timer; matrix M=lift(Iplus,ideal(tau^2)); print("LIFT_TIME_S "+string((timer-tt)/1000.0));
poly chk=0; for(k=1;k<=ncols(Iplus);k++){ chk=chk+Iplus[k]*M[k,1]; } print("LIFT_VERIFIED "+string(chk==tau^2));
string sup=""; for(k=1;k<=ncols(Iplus);k++){ if(M[k,1]!=0){ sup=sup+string(k)+"(w"+string(deg(M[k,1]))+",h"+string(ishomog(M[k,1],4*t+1+k))+",n"+string(size(M[k,1]))+",b3deg"+string(deg(M[k,1],intvec(0:(t-1),1)))+") "; } } print("LIFT_SUPPORT "+sup);
write("/home/ubuntu/jc2/box/k16sq-20260905/t2p_lift.txt",string(M));
print("MAIN_COMPLETE"); quit;

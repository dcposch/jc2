< "/home/ubuntu/jc2/box/k16sq-20260905/t5p_rows.sing";
option(redSB);
int t=5; int q=11;
intvec wv=1,2,3,4,6;
number y=(d+6)/22; number g=80*(3*d+12)/7986;
proc ishomog(poly f, int w) { return(f==jet(f,w,wv)-jet(f,w-1,wv)); }
proc hist(ideal KB) { int i; int w; int mx=0; for(i=1;i<=size(KB);i++){ if(deg(KB[i])>mx){mx=deg(KB[i]);} } intvec h; h[mx+1]=0; for(i=1;i<=size(KB);i++){ w=deg(KB[i]); h[w+1]=h[w+1]+1; } string s=""; for(w=0;w<=mx;w++){ s=s+string(h[w+1])+","; } print("HF_BY_WEIGHT "+s); print("SOCLE_WEIGHT "+string(mx)); }
ideal J=T9;
int tt=timer; ideal GJ=std(J); print("STD_TIME_S "+string(timer-tt)+" ms");
print("SUB depth9 rows 9 DIM "+string(dim(GJ))+" VDIM "+string(vdim(GJ)));
if(dim(GJ)==0){ ideal KB=kbase(GJ); hist(KB); }
print("SUB depth9 TAU_IN "+string(reduce(tau,GJ)==0)+" TAU2_IN "+string(reduce(tau^2,GJ)==0)+" TAU3_IN "+string(reduce(tau^3,GJ)==0));
print("SUB_COMPLETE"); quit;

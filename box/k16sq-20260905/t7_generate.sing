write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","poly T6="+string(rows[7])+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","poly T7="+string(rows[8])+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","poly T8="+string(rows[9])+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","poly T9="+string(rows[10])+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","poly T10="+string(rows[11])+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","poly T11="+string(rows[12])+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","poly T12="+string(rows[13])+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","poly T13="+string(rows[14])+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","poly tau="+string(tau)+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","poly spineB1="+string(spineB1)+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","poly spineB2="+string(spineB2)+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","poly rootR="+string(rootR)+";");
print("LOCAL_IDENTITIES_PASS");
print("ROWS_COMPLETE"); quit;

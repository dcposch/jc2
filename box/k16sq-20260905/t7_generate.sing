ring rgen=(0,d),(h,b4,b3,b2,u2,u3,u4,u5,u6,u7,u8,u9,u10,u11,u12,u13,u14,c1,c2,c3,c4,c5,c6),dp;
minpoly=3*d^2-8;
option(redSB);
proc must(int ok,string label) { if (!ok) { print("FAIL "+label); quit; } }
proc hco(poly f,int k) { matrix mm=coef(f,h); int ii; for(ii=1;ii<=ncols(mm);ii++) { if(deg(mm[1,ii])==k) { return(mm[2,ii]); } } return(poly(0)); }
number y=(d+8)/30; number g=154*(3*d+16)/20250;
poly U=(h+b4)^15+u2*(h+b4)^13+u3*(h+b4)^12+u4*(h+b4)^11+u5*(h+b4)^10+u6*(h+b4)^9+u7*(h+b4)^8+u8*(h+b4)^7+u9*(h+b4)^6+u10*(h+b4)^5+u11*(h+b4)^4+u12*(h+b4)^3+u13*(h+b4)^2+u14*(h+b4)^1;
poly C=(h+b4)^6+c1*(h+b4)^5+c2*(h+b4)^4+c3*(h+b4)^3+c4*(h+b4)^2+c5*(h+b4)^1+c6*(h+b4)^0;
poly BB=0; poly SS=0; poly vv; int m; int aa; int bb; poly acc;
for(m=0;m<7;m++) { BB=BB+g*(3*m+5)*hco(C,m)*h^(m+1)/(2*y*(m+1)); }
for(m=0;m<=14;m++) { acc=3*g*(m+1)*hco(U,m+1)+g*b3*(5*m+7)*hco(C,m)/2; for(aa=0;aa<m;aa++) { bb=m-1-aa; acc=acc+(3+2*aa-bb)*hco(C,aa)*hco(BB,bb); } SS=SS+acc*h^m/(y*(2*m+1)); }
poly VV=h^2*C-y*b3; poly YY=h*SS-b3*BB-g*b2; poly zpiece=h*BB-g*b3;
poly NN=-VV*diff(YY,h)+diff(VV,h)*YY+2*diff(U,h)*zpiece;
poly Nconst=subst(NN,h,0);
poly PP=(NN-subst(NN,h,0))/(2*y*h);
must(2*y*h*PP==NN-subst(NN,h,0),"DIVISION");
poly RR=VV*PP-diff(U,h)*YY-y*g; RR=subst(RR,h,h-b4);
poly band; number pv; poly val;
band=hco(RR,28); must(diff(diff(band,c1),c1)==0,"AFFINE1");
must(size(diff(band,c1))==1 && deg(diff(band,c1))==0,"SCALAR1"); pv=leadcoef(diff(band,c1)); must(pv!=0,"PIVOT1");
val=-subst(band,c1,0)/pv; RR=subst(RR,c1,val); print("PIVOT 1 PASS");
U=subst(U,c1,val); C=subst(C,c1,val); BB=subst(BB,c1,val); SS=subst(SS,c1,val); Nconst=subst(Nconst,c1,val);
band=hco(RR,27); must(diff(diff(band,c2),c2)==0,"AFFINE2");
must(size(diff(band,c2))==1 && deg(diff(band,c2))==0,"SCALAR2"); pv=leadcoef(diff(band,c2)); must(pv!=0,"PIVOT2");
val=-subst(band,c2,0)/pv; RR=subst(RR,c2,val); print("PIVOT 2 PASS");
U=subst(U,c2,val); C=subst(C,c2,val); BB=subst(BB,c2,val); SS=subst(SS,c2,val); Nconst=subst(Nconst,c2,val);
band=hco(RR,26); must(diff(diff(band,c3),c3)==0,"AFFINE3");
must(size(diff(band,c3))==1 && deg(diff(band,c3))==0,"SCALAR3"); pv=leadcoef(diff(band,c3)); must(pv!=0,"PIVOT3");
val=-subst(band,c3,0)/pv; RR=subst(RR,c3,val); print("PIVOT 3 PASS");
U=subst(U,c3,val); C=subst(C,c3,val); BB=subst(BB,c3,val); SS=subst(SS,c3,val); Nconst=subst(Nconst,c3,val);
band=hco(RR,25); must(diff(diff(band,c4),c4)==0,"AFFINE4");
must(size(diff(band,c4))==1 && deg(diff(band,c4))==0,"SCALAR4"); pv=leadcoef(diff(band,c4)); must(pv!=0,"PIVOT4");
val=-subst(band,c4,0)/pv; RR=subst(RR,c4,val); print("PIVOT 4 PASS");
U=subst(U,c4,val); C=subst(C,c4,val); BB=subst(BB,c4,val); SS=subst(SS,c4,val); Nconst=subst(Nconst,c4,val);
band=hco(RR,24); must(diff(diff(band,c5),c5)==0,"AFFINE5");
must(size(diff(band,c5))==1 && deg(diff(band,c5))==0,"SCALAR5"); pv=leadcoef(diff(band,c5)); must(pv!=0,"PIVOT5");
val=-subst(band,c5,0)/pv; RR=subst(RR,c5,val); print("PIVOT 5 PASS");
U=subst(U,c5,val); C=subst(C,c5,val); BB=subst(BB,c5,val); SS=subst(SS,c5,val); Nconst=subst(Nconst,c5,val);
band=hco(RR,23); must(diff(diff(band,c6),c6)==0,"AFFINE6");
must(size(diff(band,c6))==1 && deg(diff(band,c6))==0,"SCALAR6"); pv=leadcoef(diff(band,c6)); must(pv!=0,"PIVOT6");
val=-subst(band,c6,0)/pv; RR=subst(RR,c6,val); print("PIVOT 6 PASS");
U=subst(U,c6,val); C=subst(C,c6,val); BB=subst(BB,c6,val); SS=subst(SS,c6,val); Nconst=subst(Nconst,c6,val);
band=hco(RR,22); must(diff(diff(band,u7),u7)==0,"AFFINE7");
must(size(diff(band,u7))==1 && deg(diff(band,u7))==0,"SCALAR7"); pv=leadcoef(diff(band,u7)); must(pv!=0,"PIVOT7");
val=-subst(band,u7,0)/pv; RR=subst(RR,u7,val); print("PIVOT 7 PASS");
U=subst(U,u7,val); C=subst(C,u7,val); BB=subst(BB,u7,val); SS=subst(SS,u7,val); Nconst=subst(Nconst,u7,val);
band=hco(RR,21); must(diff(diff(band,u8),u8)==0,"AFFINE8");
must(size(diff(band,u8))==1 && deg(diff(band,u8))==0,"SCALAR8"); pv=leadcoef(diff(band,u8)); must(pv!=0,"PIVOT8");
val=-subst(band,u8,0)/pv; RR=subst(RR,u8,val); print("PIVOT 8 PASS");
U=subst(U,u8,val); C=subst(C,u8,val); BB=subst(BB,u8,val); SS=subst(SS,u8,val); Nconst=subst(Nconst,u8,val);
band=hco(RR,20); must(diff(diff(band,u9),u9)==0,"AFFINE9");
must(size(diff(band,u9))==1 && deg(diff(band,u9))==0,"SCALAR9"); pv=leadcoef(diff(band,u9)); must(pv!=0,"PIVOT9");
val=-subst(band,u9,0)/pv; RR=subst(RR,u9,val); print("PIVOT 9 PASS");
U=subst(U,u9,val); C=subst(C,u9,val); BB=subst(BB,u9,val); SS=subst(SS,u9,val); Nconst=subst(Nconst,u9,val);
band=hco(RR,19); must(diff(diff(band,u10),u10)==0,"AFFINE10");
must(size(diff(band,u10))==1 && deg(diff(band,u10))==0,"SCALAR10"); pv=leadcoef(diff(band,u10)); must(pv!=0,"PIVOT10");
val=-subst(band,u10,0)/pv; RR=subst(RR,u10,val); print("PIVOT 10 PASS");
U=subst(U,u10,val); C=subst(C,u10,val); BB=subst(BB,u10,val); SS=subst(SS,u10,val); Nconst=subst(Nconst,u10,val);
band=hco(RR,18); must(diff(diff(band,u11),u11)==0,"AFFINE11");
must(size(diff(band,u11))==1 && deg(diff(band,u11))==0,"SCALAR11"); pv=leadcoef(diff(band,u11)); must(pv!=0,"PIVOT11");
val=-subst(band,u11,0)/pv; RR=subst(RR,u11,val); print("PIVOT 11 PASS");
U=subst(U,u11,val); C=subst(C,u11,val); BB=subst(BB,u11,val); SS=subst(SS,u11,val); Nconst=subst(Nconst,u11,val);
band=hco(RR,17); must(diff(diff(band,u12),u12)==0,"AFFINE12");
must(size(diff(band,u12))==1 && deg(diff(band,u12))==0,"SCALAR12"); pv=leadcoef(diff(band,u12)); must(pv!=0,"PIVOT12");
val=-subst(band,u12,0)/pv; RR=subst(RR,u12,val); print("PIVOT 12 PASS");
U=subst(U,u12,val); C=subst(C,u12,val); BB=subst(BB,u12,val); SS=subst(SS,u12,val); Nconst=subst(Nconst,u12,val);
band=hco(RR,16); must(diff(diff(band,u13),u13)==0,"AFFINE13");
must(size(diff(band,u13))==1 && deg(diff(band,u13))==0,"SCALAR13"); pv=leadcoef(diff(band,u13)); must(pv!=0,"PIVOT13");
val=-subst(band,u13,0)/pv; RR=subst(RR,u13,val); print("PIVOT 13 PASS");
U=subst(U,u13,val); C=subst(C,u13,val); BB=subst(BB,u13,val); SS=subst(SS,u13,val); Nconst=subst(Nconst,u13,val);
band=hco(RR,15); must(diff(diff(band,u14),u14)==0,"AFFINE14");
must(size(diff(band,u14))==1 && deg(diff(band,u14))==0,"SCALAR14"); pv=leadcoef(diff(band,u14)); must(pv!=0,"PIVOT14");
val=-subst(band,u14,0)/pv; RR=subst(RR,u14,val); print("PIVOT 14 PASS");
U=subst(U,u14,val); C=subst(C,u14,val); BB=subst(BB,u14,val); SS=subst(SS,u14,val); Nconst=subst(Nconst,u14,val);
band=hco(RR,14); must(diff(diff(band,b2),b2)==0,"AFFINE15");
must(size(diff(band,b2))==1 && deg(diff(band,b2))==0,"SCALAR15"); pv=leadcoef(diff(band,b2)); must(pv!=0,"PIVOT15");
val=-subst(band,b2,0)/pv; RR=subst(RR,b2,val); print("PIVOT 15 PASS");
U=subst(U,b2,val); C=subst(C,b2,val); BB=subst(BB,b2,val); SS=subst(SS,b2,val); Nconst=subst(Nconst,b2,val);
for(m=14;m<=29;m++) { must(hco(RR,m)==0,"HIGH_BAND"); }
must(diff(RR,c1)==0,"ELIM_c1");
must(diff(RR,c2)==0,"ELIM_c2");
must(diff(RR,c3)==0,"ELIM_c3");
must(diff(RR,c4)==0,"ELIM_c4");
must(diff(RR,c5)==0,"ELIM_c5");
must(diff(RR,c6)==0,"ELIM_c6");
must(diff(RR,u7)==0,"ELIM_u7");
must(diff(RR,u8)==0,"ELIM_u8");
must(diff(RR,u9)==0,"ELIM_u9");
must(diff(RR,u10)==0,"ELIM_u10");
must(diff(RR,u11)==0,"ELIM_u11");
must(diff(RR,u12)==0,"ELIM_u12");
must(diff(RR,u13)==0,"ELIM_u13");
must(diff(RR,u14)==0,"ELIM_u14");
must(diff(RR,b2)==0,"ELIM_b2");
ideal rows;
rows[1]=-hco(RR,0);
rows[2]=-hco(RR,1);
rows[3]=-hco(RR,2);
rows[4]=-hco(RR,3);
rows[5]=-hco(RR,4);
rows[6]=-hco(RR,5);
rows[7]=-hco(RR,6);
rows[8]=-hco(RR,7);
rows[9]=-hco(RR,8);
rows[10]=-hco(RR,9);
rows[11]=-hco(RR,10);
rows[12]=-hco(RR,11);
rows[13]=-hco(RR,12);
rows[14]=-hco(RR,13);
poly spineB2=val; poly rootR=subst(diff(U,h),h,0)+b3*subst(C,h,0); poly spineB1=-Nconst/(y*g);
must(y*spineB1+b3*rootR==0,"LOCAL_B1");
must(-subst(RR,h,b4)-y*g+g*spineB2*rootR==0,"LOCAL_TAU");
poly abelW=h*SS/g-spineB2-h^2*C*BB/(g*y)-b3*h*C/(2*y)+3*h^3*C^2/(4*y^2);
poly eta=hco(abelW,1); poly bigA=3*h^3*C^2/(4*y^2); poly bigD=3*b3*h*C/(2*y);
must(subst(abelW,h,0)==-spineB2,"ABEL_CONSTANT"); must(eta==3*rootR/y,"ABEL_ETA");
poly abelRhs=abelW^2+(spineB2-2*bigA+bigD)*abelW+bigA*(bigA-bigD)/3-spineB2*(bigA-bigD)-b3*eta*(h^2*C-y*b3)/(2*y)-spineB2*h*eta+(b3^2*bigA/2-b3^2*(spineB2+abelW))/h;
poly abelResidual=2*(h*abelW-(b3^2)/4)*diff(abelW,h)-abelRhs;
must(g*y*abelResidual+3*h*(subst(RR,h,h+b4)-subst(RR,h,b4))==0,"ABEL_ROW_IDENTITY");
print("ABEL_ROW_IDENTITY_PASS");
ring rres=(0,d),(b4,u2,u3,u4,u5,u6,b3),wp(1,2,3,4,5,6,8);
minpoly=3*d^2-8;
ideal rows=imap(rgen,rows);
poly spineB1=imap(rgen,spineB1); poly spineB2=imap(rgen,spineB2); poly rootR=imap(rgen,rootR);
number y=(d+8)/30; number g=154*(3*d+16)/20250;
poly tau=rows[1]-y*g;
poly ax=rows[14];
ax=subst(ax,b4,0);
ax=subst(ax,u2,0);
ax=subst(ax,u3,0);
ax=subst(ax,u4,0);
ax=subst(ax,u5,0);
ax=subst(ax,u6,0);
number aexpect=-154*((7796)*d+2676)/24840000;
must(ax==aexpect*b3^2,"AXIS_ALPHA");
poly zero=tau;
zero=subst(zero,b4,0);
zero=subst(zero,u2,0);
zero=subst(zero,u3,0);
zero=subst(zero,u4,0);
zero=subst(zero,u5,0);
zero=subst(zero,u6,0);
zero=subst(zero,b3,0);
must(zero==0,"TAU_CONSTANT");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","// Generated from frozen coefficient-array formulas; t=7");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","ring rres=(0,d),(b4,u2,u3,u4,u5,u6,b3),wp(1,2,3,4,5,6,8);");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","minpoly=3*d^2-8;");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","poly T0="+string(rows[1])+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","poly T1="+string(rows[2])+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","poly T2="+string(rows[3])+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","poly T3="+string(rows[4])+";");
write("/home/ubuntu/jc2/box/k16sq-20260905/t7_rows.sing","poly T4="+string(rows[5])+";");

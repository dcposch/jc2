// Moh p.208 (16,12) chart, verbatim 17 coefficients, plus the Keller condition.
option(redSB); short=0;
ring R = 0,(b1,b2,b3,b4,c1,c2,c3,c4,c5,c6,c7,c8,c9,c10,c11,c12,c13,x,y),dp;

poly h  = y^3*(y-x) + b1*y^3 + b2*y^2 + b3*y + b4;   // p.208 (1)
poly AA = y^2*(y-x) + b1*y^2 + b2*y  + b3;           // h = y*AA + b4
poly BB = y*(y-x)   + b1*y  + b2;                    // h = y^2*BB + b3*y + b4
// sanity on the two displayed rewritings of h
poly chk1 = h - (y*AA + b4);
poly chk2 = h - (y^2*BB + b3*y + b4);
"MARK_H_REWRITE"; chk1; chk2;

poly al2 = c1*AA + c2;                 // p.208 (3)
poly be2 = c3*AA + c4;                 // p.208 (3)
poly al3 = c5*AA + c6*BB + c7;         // p.208 (4)  [printed "c5 A + c5 B + c7": second index is c6]
poly be3 = c8*AA + c9*BB + c10;        // p.208 (4)
poly al4 = c11*AA + c12*BB + c13*(y-x);// p.208 (5)

poly f = h^3 + be2*h + be3;                    // Thm 1.2 form, alpha1 gauged to 0
poly g = h^4 + al2*h^2 + al3*h + al4;

"MARK_DEG"; deg(f); deg(g);
poly J = diff(f,x)*diff(g,y) - diff(f,y)*diff(g,x);
"MARK_DEGJ"; deg(J);

matrix C = coef(J, x*y);
"MARK_NCOEF"; ncols(C);

// Keller: every non-constant x,y-monomial of J must vanish; the constant is free.
ideal I;
int i; int nz = 0;
for (i=1; i<=ncols(C); i++) {
  if (C[1,i] != 1) { I = I + ideal(C[2,i]); nz++; }
}
"MARK_NROWS"; nz;
I = simplify(I,2);
"MARK_NGENS"; size(I);
"MARK_CONSTANT_TERM";
for (i=1; i<=ncols(C); i++) { if (C[1,i]==1) { C[2,i]; } }
write(":w box/minor-residue-20260903/charts/moh1612_rows.txt", string(I));
"MARK_DONE";
quit;

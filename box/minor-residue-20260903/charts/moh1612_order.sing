option(redSB); short=0;
ring R = 0,(b1,b2,b3,b4,c1,c2,c3,c4,c5,c6,c7,c8,c9,c10,c11,c12,c13,x,y),dp;
poly h  = y^3*(y-x) + b1*y^3 + b2*y^2 + b3*y + b4;
poly AA = y^2*(y-x) + b1*y^2 + b2*y  + b3;
poly BB = y*(y-x)   + b1*y  + b2;
poly al2 = c1*AA + c2;         poly be2 = c3*AA + c4;
poly al3 = c5*AA + c6*BB + c7; poly be3 = c8*AA + c9*BB + c10;
poly al4 = c11*AA + c12*BB + c13*(y-x);
poly f = h^3 + be2*h + be3;   poly g = h^4 + al2*h^2 + al3*h + al4;
poly J = diff(f,x)*diff(g,y) - diff(f,y)*diff(g,x);
matrix C = coef(J, x*y);
ideal I; poly cst; int i;
for (i=1;i<=ncols(C);i++){ if(C[1,i]==1){cst=C[2,i];} else {I=I+ideal(C[2,i]);} }
I = simplify(I,2);
ideal S = std(I);
"MARK_DIMI"; dim(S);
"MARK_KILLORDER";
poly q = 1; int N;
for (N=1; N<=6; N++) { q = q*cst; if (reduce(q,S)==0) { "N="; N; break; } }
"MARK_RED_cst";   reduce(cst,S);
"MARK_RED_cst2";  reduce(cst^2,S);
// factor the Jacobian constant
"MARK_FACTOR"; factorize(cst);
// which factor dies?
poly cst2 = 3*b3*b4^2+b3^2*c3+b2*b4*c3+b3*c4+b2*c8+b1*c9;
"MARK_RED_c13";   reduce(c13,S);
"MARK_RED_cofac"; reduce(cst2,S);
"MARK_DIM_c13";   dim(std(I+ideal(c13)));
"MARK_DIM_cofac"; dim(std(I+ideal(cst2)));
"MARK_DONE"; quit;

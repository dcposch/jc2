ring r=(0,d),(x,Y,c1,c2,c3,b,B,eta,w1,w2,w3,w4,w5,w6,w7,w8),dp;
minpoly=3*d^2-5;
option(redSB);
proc must(int ok,string msg){ if(!ok){print("FAIL "+msg);quit;} }
proc xc(poly f,int k){matrix m=coef(f,x);int i;for(i=1;i<=ncols(m);i++){if(deg(m[1,i])==k){return(m[2,i]);}}return(poly(0));}
number y=(d+5)/18; number om=1/(4*y^2*(2*d+1));
poly C=x^3+c1*x^2+c2*x^1+c3*x^0;
poly W=om*x^9-B+w1*x^1+w2*x^2+w3*x^3+w4*x^4+w5*x^5+w6*x^6+w7*x^7+w8*x^8;
poly L=x^2*C/y-b; poly P=x*W-(b^2)/4;
poly Hdiff=2*x*diff(P,x)-3*P-B*x+(3/2)*L*(L+b);
poly Rfree=(3/16)*(L^2)*(L*(L+2*b)-4*B*x)-eta*x^2*(b*L/2+B*x);
poly UF=P*Hdiff-Rfree;
UF=subst(UF,eta,w1); W=subst(W,eta,w1);
must(xc(UF,20)==0,"top");
// ---- Toeplitz L-tail block on UNREDUCED high rows (P-jets still free) ----
poly PTD0=x*W-(b^2)/4;
poly RY0=(3/16)*Y^2*(Y*(Y+2*b)-4*B*x)-w1*x^2*(b*Y/2+B*x);
poly GY0=(3/2)*Y*(Y+b)-B*x;
poly QP0=RY0-GY0*PTD0-(x*diff(PTD0^2,x)-3*PTD0^2);
poly D0=subst(diff(QP0,Y),Y,L);
poly d3N=xc(D0,15);
print("TOEPLITZ_d3N_field="+string(deg(d3N)==0 && d3N!=0));
print("TOEPLITZ_d3N_formula="+string(d3N-(3/(4*y^3))*(1-4*om*y^2)==0));
int tok=1; int k; int m; int j; int kk; int mm; poly band; poly got; poly expect; poly ddiag; poly off;
for(k=17;k<=19;k++){
  band=xc(UF,k);
  for(m=2;m<=4;m++){
    got=0;
    if(m==2){got=y*diff(band,c3);}
    if(m==3){got=y*diff(band,c2);}
    if(m==4){got=y*diff(band,c1);}
    expect=-xc(D0,k-m);
    if(got-expect!=0){tok=0; print("TOEPLITZ_MISMATCH k="+string(k)+" m="+string(m));}
  }
}
print("TOEPLITZ_JACOBIAN_OK="+string(tok));
int tri=1; poly diagprod=1;
for(j=0;j<=2;j++){
  kk=19-j;
  band=xc(UF,kk);
  mm=4-j;
  ddiag=0;
  if(mm==2){ddiag=y*diff(band,c3);}
  if(mm==3){ddiag=y*diff(band,c2);}
  if(mm==4){ddiag=y*diff(band,c1);}
  if(ddiag+d3N!=0){tri=0; print("TOEPLITZ_DIAG_FAIL j="+string(j));}
  diagprod=diagprod*(-d3N);
  for(m=2;m<mm;m++){
    off=0;
    if(m==2){off=y*diff(band,c3);}
    if(m==3){off=y*diff(band,c2);}
    if(m==4){off=y*diff(band,c1);}
    if(off!=0){tri=0; print("TOEPLITZ_UPPER_FAIL k="+string(kk)+" m="+string(m));}
  }
}
print("TOEPLITZ_TRIANGULAR="+string(tri));
print("TOEPLITZ_DET_FORMULA="+string(diagprod-((-d3N)^3)==0));
print("TOEPLITZ_Nminus2=3");
// ---- Theorem H: eliminate P-jets (W,B) from high rows ----
poly band2,piv,val; poly solB;
band2=xc(UF,19); piv=diff(band2,w8);
must(deg(piv)==0 && piv!=0,"pivot_w8");
val=-subst(band2,w8,0)/piv; UF=subst(UF,w8,val); W=subst(W,w8,val);
band2=xc(UF,18); piv=diff(band2,w7);
must(deg(piv)==0 && piv!=0,"pivot_w7");
val=-subst(band2,w7,0)/piv; UF=subst(UF,w7,val); W=subst(W,w7,val);
band2=xc(UF,17); piv=diff(band2,w6);
must(deg(piv)==0 && piv!=0,"pivot_w6");
val=-subst(band2,w6,0)/piv; UF=subst(UF,w6,val); W=subst(W,w6,val);
band2=xc(UF,16); piv=diff(band2,w5);
must(deg(piv)==0 && piv!=0,"pivot_w5");
val=-subst(band2,w5,0)/piv; UF=subst(UF,w5,val); W=subst(W,w5,val);
band2=xc(UF,15); piv=diff(band2,w4);
must(deg(piv)==0 && piv!=0,"pivot_w4");
val=-subst(band2,w4,0)/piv; UF=subst(UF,w4,val); W=subst(W,w4,val);
band2=xc(UF,14); piv=diff(band2,w3);
must(deg(piv)==0 && piv!=0,"pivot_w3");
val=-subst(band2,w3,0)/piv; UF=subst(UF,w3,val); W=subst(W,w3,val);
band2=xc(UF,13); piv=diff(band2,w2);
must(deg(piv)==0 && piv!=0,"pivot_w2");
val=-subst(band2,w2,0)/piv; UF=subst(UF,w2,val); W=subst(W,w2,val);
band2=xc(UF,12); piv=diff(band2,w1);
must(deg(piv)==0 && piv!=0,"pivot_w1");
val=-subst(band2,w1,0)/piv; UF=subst(UF,w1,val); W=subst(W,w1,val);
band2=xc(UF,11); piv=diff(band2,B);
must(deg(piv)==0 && piv!=0,"pivot_B");
val=-subst(band2,B,0)/piv; UF=subst(UF,B,val); W=subst(W,B,val);
solB=val;
must(xc(UF,0)==0 && xc(UF,1)==0 && xc(UF,2)==0 && xc(UF,3)==0,"low_four");
for(k=11;k<=20;k++){must(xc(UF,k)==0,"high");}
poly etasol=xc(W,1); poly w2sol=xc(W,2); poly w3sol=xc(W,3);
poly target=solB*etasol; ideal rows;
for(k=2;k<=8;k++){rows[k-1]=xc(UF,k+2);}
poly PTD=x*W-(b^2)/4;
PTD=subst(PTD,B,solB);
poly RY=(3/16)*Y^2*(Y*(Y+2*b)-4*solB*x)-etasol*x^2*(b*Y/2+solB*x);
poly GY=(3/2)*Y*(Y+b)-solB*x;
poly QP=RY-GY*PTD-(x*diff(PTD^2,x)-3*PTD^2);
must(subst(QP,Y,L)+UF==0,"Q_P(x,L)=-UF");
number yv=y; poly l2=c3/yv;
poly u=4*etasol+3*b*l2;
poly T2=3*b^2*w3sol+18*solB*w2sol-10*etasol^2;
poly rr=target;
ring rsmall=(0,d),(c1,c2,c3,b),wp(1,2,3,5);
minpoly=3*d^2-5;
option(redSB);
ideal rows=imap(r,rows); poly target=imap(r,target); poly Bsol=imap(r,solB); poly eta=imap(r,etasol);
poly u=imap(r,u); poly T2=imap(r,T2); poly rr=imap(r,rr); poly w2=imap(r,w2sol); poly w3=imap(r,w3sol);
print("ROWS_BUILT nrows="+string(size(rows))+" t=4 N=5");
print("u_wt="+string(deg(u))+" rr_wt="+string(deg(rr))+" T2_wt="+string(deg(T2)));
print("u_homog="+string(homog(u))+" rr_homog="+string(homog(rr))+" T2_homog="+string(homog(T2)));
print("IDENTITY_u2_plus_4T2_plus_24E2="+string(u^2+4*T2+24*rows[1]==0));
print("E2_wt="+string(deg(rows[1]))+" E2_terms="+string(size(rows[1])));
// ---- frozen custody: identity map on (c_i,b) ----
// Direct F1--F3; coefficient map is identity on c_i,b.
ring rfro=(0,d),(c1,c2,c3,b),wp(1,2,3,5);
minpoly=3*d^2-5;
ideal rows_fro=(-1776497824793831924681661005165384722462752115671488993478372258351/10522130055137117369769963954719733282811066376564930750369804033105000*d+3674675723534260748432059853785923977457843386206214996623167528489/16835408088219387791631942327551573252497706202503889200591686452968000)*c1^16+(44482693432246824067713101613462643987505438487564009726358623/11613701896377652972671343533426488982253028527902485348252010500*d-230015960264446212441398153862668918350863531358368065734323129/46454807585510611890685374133705955929012114111609941393008042000)*c1^14*c2+(-18626455125977290888173030880683983907512878220775224244507/512740561202532112125532545266674274334854075690223522842000*d+982750414416980684662267835447791445930934495568126492851/20928186171531922943899287561905072421830778599600960116000)*c1^12*c2^2+(-127083865174887663118525408696208633961079494628659104352651/22321164513506924798522666794976915207097883005770681046035000*d+8213350980878689985804048538131308326899158324795693494369/1116058225675346239926133339748845760354894150288534052301750)*c1^13*c3+(514718772377308551969702572007798088157899862730079996809/2773069557612396496081841780782446048322628857167244580000*d-66530524508385134779274411387453195402662757744338122051/277306955761239649608184178078244604832262885716724458000)*c1^10*c2^3+(3178921562496862304899196042416514105745240446260424784/30795968744145932162065908206003403945731673775359379375*d-3287013386645196648575428169984441917446157245301140309/24636774995316745729652726564802723156585339020287503500)*c1^11*c2*c3+(-1641845162850694084355826331128391377688459997680489101/2999534405205404538758076561149211517926045275464840000*d+848817921628770503406868883616931886514821695761068511/1199813762082161815503230624459684607170418110185936000)*c1^8*c2^4+(-1772197193070569979973319874897227921788894359997986/2379353221366447667624654887275237885013650141030625*d+7329342128731703022971275517649936588316011370491849/761393030837263253
ring S=32003,(y,x,h_0_0,h_0_1,h_0_2,h_0_3,h_0_4,h_0_5,h_0_6,h_0_7,h_0_8,h_1_0,h_1_1,h_1_2,h_1_3,h_1_4,h_1_5,h_1_6,h_1_7,b_0_0,b_0_1,b_0_2,b_0_3,b_0_4,b_0_5,b_0_6,b_0_7,b_0_8,b_1_0,b_1_1,b_1_2,b_1_3,b_1_4,b_1_5,b_1_6,b_1_7,b_1_8,b_2_0,b_2_1,b_2_2,b_2_3,b_2_4,b_2_5,b_2_6,b_2_7,b_2_8,g1_0_0,g1_0_1,g1_0_2,g1_0_3,g1_0_4,g1_0_5,g1_0_6,g1_0_7,g1_0_8,g1_1_0,g1_1_1,g1_1_2,g1_1_3,g1_1_4,g1_1_5,g1_1_6,g1_1_7,g1_1_8,g2_0_0,g2_0_1,g2_0_2,g2_0_3,g2_0_4,g2_0_5,g2_0_6,g2_0_7,g2_0_8,g2_1_0,g2_1_1,g2_1_2,g2_1_3,g2_1_4,g2_1_5,g2_1_6,g2_1_7,g2_1_8,g2_2_0,g2_2_1,g2_2_2,g2_2_3,g2_2_4,g2_2_5,g2_2_6,g2_2_7,g2_2_8,g3_0_0,g3_0_1,g3_0_2,g3_0_3,g3_0_4,g3_0_5,g3_0_6,g3_0_7,g3_0_8,g3_1_0,g3_1_1,g3_1_2,g3_1_3,g3_1_4,g3_1_5,g3_1_6,g3_1_7,g3_1_8,g3_2_0,g3_2_1,g3_2_2,g3_2_3,g3_2_4,g3_2_5,g3_2_6,g3_2_7,g3_2_8,g3_3_0,g3_3_1,g3_3_2,g3_3_3,g3_3_4,g3_3_5,g3_3_6,g3_3_7,g3_3_8,c,T),(dp(1),dp(128));

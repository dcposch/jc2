// CONJECTURE 1 (free-jet reading). Is the degree-N closing ideal
//   I_close = (Phi_{2N+1},...,Phi_{4N})   contained in (T_2),
//   T_2 = -(1/4)*(4*eta+3*b*l_2)^2 = -u^2/4   (b=1, u := Lpivot) ?
// b=1 is legitimate: every object is weighted-homogeneous and b is a unit
// on the whole chart (charged: b != 0 throughout).
int N    = NNN;
int KMAX = 4*N;
ring R = 0,(x,u,B,w2,l(2..N)),dp;
proc xc(poly f,int k){matrix m=coef(f,x);int i;
  for(i=1;i<=ncols(m);i++){if(deg(m[1,i])==k){return(m[2,i]);}} return(poly(0));}
poly eta = (u - 3*l(2))/4;                 // u = 4*eta + 3*l_2
poly L = -1; int j;
for(j=2;j<=N;j++){ L = L + l(j)*(x^j); }
poly G  = 3*L*(L+1)/2 - B*x;
poly RF = 3*(L^2)*(L*(L+2)-4*B*x)/16 - eta*(x^2)*(L/2 + B*x);
poly P = -1/4 - B*x + eta*(x^2) + w2*(x^3);
list Phi; int k; poly PS,Ex,br,Pk; number cc;
for(k=4;k<=KMAX;k++){
  PS = P*P; Ex = x*diff(PS,x) - 3*PS + G*P - RF; br = xc(Ex,k);
  cc = number(2)/number(k-3); Pk = cc*br; Phi[k] = Pk; P = P + Pk*(x^k);
}
// controls against the charged closed forms (universal-series Prop. 2.1(c), b=1)
poly c4 = 2*(eta^2) - 6*B*w2 - 2*eta*l(2) - 3*(l(2)^2)/4;
print("CTRL_PHI4_diff = "+string(Phi[4]-c4));
poly c5 = 30*(B^2)*w2 - 10*B*(eta^2) + 10*B*eta*l(2) + 3*B*(l(2)^2)
          + 4*eta*w2 - eta*l(3) - 3*l(2)*w2/2 - 3*l(2)*l(3)/4;
print("CTRL_PHI5_diff = "+string(Phi[5]-c5));
// residual control: (UF) holds to order 4N by construction
poly PS2 = P*P; poly RES = x*diff(PS2,x)-3*PS2+G*P-RF; int bad=0;
for(k=0;k<=KMAX;k++){ if(xc(RES,k)!=0){ bad=bad+1; } }
print("CTRL_UF_rows_0_to_4N_nonzero = "+string(bad));
print("N= "+string(N)+"  KMAX= "+string(KMAX));
print("== u-order of Phi_k ;  Phi_k in (T_2) <=> uord >= 2 ==");
poly f; int uo; int i;
for(i=4;i<=KMAX;i++){
  f = Phi[i]; uo = -1;
  if(f!=0){ uo=0; while(subst(f,u,0)==0){ f=f/u; uo=uo+1; } }
  print("k="+string(i)+" uord="+string(uo)+" closing="+string(i>2*N)+" nterms="+string(size(Phi[i])));
}
print("== exact remainder of the FIRST closing condition mod u ==");
print("Phi_"+string(2*N+1)+"|_{u=0} = "+string(subst(Phi[2*N+1],u,0)));
print("DONE_FREEJETS_N"+string(N));
quit;

// Graded + negative controls for TEST_A: how many closing rows are needed to force
// u = 0, and do the same machinery FAIL for wrong targets (B, w2, l2)?
int N = NNN; int KMAX = 4*N;
ring R = PPP,(x,u,B,w2,l(2..N)),dp;
proc xc(poly f,int k){matrix m=coef(f,x);int i;
  for(i=1;i<=ncols(m);i++){if(deg(m[1,i])==k){return(m[2,i]);}} return(poly(0));}
poly eta=(u-3*l(2))/4;
poly L=-1; int j; for(j=2;j<=N;j++){ L=L+l(j)*(x^j); }
poly G=3*L*(L+1)/2-B*x;
poly RF=3*(L^2)*(L*(L+2)-4*B*x)/16-eta*(x^2)*(L/2+B*x);
poly P=-1/4-B*x+eta*(x^2)+w2*(x^3);
list Phi; int k; poly PS,Ex,br,Pk; number cc;
for(k=4;k<=KMAX;k++){ PS=P*P; Ex=x*diff(PS,x)-3*PS+G*P-RF; br=xc(Ex,k);
  cc=number(2)/number(k-3); Pk=cc*br; Phi[k]=Pk; P=P+Pk*(x^k); }
ideal Icl; int i; int c=0;
for(i=2*N+1;i<=KMAX;i++){ c=c+1; Icl[c]=Phi[i]; }
ring S = PPP,(z,u,B,w2,l(2..N)),dp;
map ph=R,0,u,B,w2,l(2..N);
ideal Icl=ph(Icl);
option(redSB);
int nrow=size(Icl); ideal Ipart; ideal Gp;
for(i=1;i<=nrow;i++){
  Ipart[i]=Icl[i];
  Gp=std(Ipart+ideal(1-z*u));
  print("rows 1.."+string(i)+" of "+string(nrow)+" : u-localised unit="+string(size(Gp)==1 && Gp[1]==1)+" dim="+string(dim(Gp)));
}
print("== NEGATIVE CONTROLS: wrong targets on the SAME ideal ==");
print("B  in rad(I_close)? "+string(size(std(Icl+ideal(1-z*B)))==1));
print("w2 in rad(I_close)? "+string(size(std(Icl+ideal(1-z*w2)))==1));
print("l2 in rad(I_close)? "+string(size(std(Icl+ideal(1-z*l(2))))==1));
print("u+1 in rad(I_close)? "+string(size(std(Icl+ideal(1-z*(u+1))))==1));
ideal Gi=std(Icl);
print("dim V(I_close) = "+string(dim(Gi)));
int e; int found=0;
for(e=1;e<=8;e++){ if(found==0 && reduce(u^e,Gi)==0){ print("min e with u^e in I_close = "+string(e)); found=1; } }
if(found==0){ print("no u^e in I_close for e<=8"); }
print("DONE_GRADED_N"+string(N));
quit;

// One std(I_close), then power memberships: u^e, l2^e, eta^e, B^e, (B*eta)^e.
// u^e in I_close  =>  u in rad(I_close)  =>  V(I_close) subset {T_2 = 0}.
int N=NNN; int KMAX=4*N;
ring R=FLD,(x,u,B,w2,l(2..N)),dp;
proc xc(poly f,int k){matrix m=coef(f,x);int i;
  for(i=1;i<=ncols(m);i++){if(deg(m[1,i])==k){return(m[2,i]);}} return(poly(0));}
poly eta=(u-3*l(2))/4;
poly L=-1; int j; for(j=2;j<=N;j++){ L=L+l(j)*(x^j); }
poly G=3*L*(L+1)/2-B*x;
poly RF=3*(L^2)*(L*(L+2)-4*B*x)/16-eta*(x^2)*(L/2+B*x);
poly P=-1/4-B*x+eta*(x^2)+w2*(x^3);
list Phi; int k; poly PS,Ex,br,Pk; number cc;
for(k=4;k<=KMAX;k++){ PS=P*P; Ex=x*diff(PS,x)-3*PS+G*P-RF; br=xc(Ex,k);
  cc=number(2)/number(k-3); Pk=cc*br; Phi[k]=Pk; P=P+Pk*(x^k); }
ideal Icl; int i; int c=0;
for(i=2*N+1;i<=KMAX;i++){ c=c+1; Icl[c]=Phi[i]; }
ring S=FLD,(u,B,w2,l(2..N)),dp;
map ph=R,0,u,B,w2,l(2..N); ideal Icl=ph(Icl);
poly etaS=(u-3*l(2))/4;
option(redSB);
ideal Gi=std(Icl);
print("N="+string(N)+"  |GB|="+string(size(Gi))+"  dim V(I_close)="+string(dim(Gi)));
proc mine(ideal Gx,poly f,string nm){ int e;
  for(e=1;e<=10;e++){ if(reduce(f^e,Gx)==0){ print("  "+nm+"^e in I_close : min e = "+string(e)); return(e);} }
  print("  "+nm+"^e NOT in I_close for e<=10"); return(0); }
int a=mine(Gi,u,"u (=Lpivot; T_2=-u^2/4)");
int b2=mine(Gi,l(2),"l_2");
int c2=mine(Gi,etaS,"eta");
int d2=mine(Gi,B,"B  [expected NOT in]");
int e2=mine(Gi,w2,"w_2 [expected NOT in]");
int f2=mine(Gi,B*etaS,"B*eta  [the (R) target]");
print("DONE_POW_N"+string(N));
quit;

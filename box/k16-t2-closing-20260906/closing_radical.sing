// (a) Is T_2 in the radical of the free-jet closing ideal?  i.e. is u in
//     rad(Phi_{2N+1..4N}) ?   test: 1 in (I_close, 1 - z*u).
// (b) Ray control at t=3: adjoin the (UL) conditions l_N=1/y, Phi_{2N}=omega
//     over Q(d)/(3d^2-N) and test emptiness at b=1 (banked: V(J_3)={0}).
int N    = NNN;
int KMAX = 4*N;
ring R = (0,d),(x,u,B,w2,l(2..N)),dp;
minpoly = 3*d^2 - N;
number y  = (d+N)/(2*(2*N-1));           // y=(d+t+1)/(2q), t=N-1, q=2t+1=2N-1
number om = 1/(4*y^2*(2*d+1));
proc xc(poly f,int k){matrix m=coef(f,x);int i;
  for(i=1;i<=ncols(m);i++){if(deg(m[1,i])==k){return(m[2,i]);}} return(poly(0));}
poly eta = (u - 3*l(2))/4;
poly L = -1; int j;
for(j=2;j<=N;j++){ L = L + l(j)*(x^j); }
poly G  = 3*L*(L+1)/2 - B*x;
poly RF = 3*(L^2)*(L*(L+2)-4*B*x)/16 - eta*(x^2)*(L/2 + B*x);
poly P = -1/4 - B*x + eta*(x^2) + w2*(x^3);
list Phi; int k; poly PS,Ex,br,Pk; number cc;
for(k=4;k<=KMAX;k++){
  PS = P*P; Ex = x*diff(PS,x) - 3*PS + G*P - RF; br = xc(Ex,k);
  cc = number(2)/number(k-3); Pk = cc*br; Phi[k] = Pk; P = P + Pk*(x^k);
}
ideal Icl; int i; int c=0;
for(i=2*N+1;i<=KMAX;i++){ c=c+1; Icl[c]=Phi[i]; }
poly lastP = Phi[2*N];
print("built N="+string(N)+" gens="+string(c));
ring S = (0,d),(z,u,B,w2,l(2..N)),dp;
minpoly = 3*d^2 - N;
map ph = R, 0, u, B, w2, l(2..N);
ideal Icl = ph(Icl);
poly lastP = ph(lastP);
number y  = (d+N)/(2*(2*N-1));
number om = 1/(4*y^2*(2*d+1));
// (a) u in rad(I_close)?
ideal Ta = Icl + ideal(1 - z*u);
option(redSB); ideal Ga = std(Ta);
print("TEST_A  u in rad(I_close)?  std = "+string(Ga));
print("TEST_A_UNIT = "+string(Ga[1]==1 && size(Ga)==1));
// (b) full ray system at b=1 (adjoin the two scale-invariant (UL) rows)
ideal Tb = Icl + ideal(l(N) - 1/y, lastP - om);
ideal Gb = std(Tb);
print("TEST_B  ray system at b=1, dim = "+string(dim(Gb))+"  unit = "+string(Gb[1]==1 && size(Gb)==1));
// (c) does the ray system force u=0 (degenerate tacnode)?
ideal Tc = Tb + ideal(1 - z*u);
ideal Gc = std(Tc);
print("TEST_C  ray+{u!=0} unit = "+string(Gc[1]==1 && size(Gc)==1));
print("DONE_RAD_N"+string(N));
quit;

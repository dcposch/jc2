ring r=0,(c1,b,z),dp;
ideal E=(183535650225/22400998743015424)*c1^8+(22670595/8905343104)*c1^5*b+(-26421/14161)*c1^2*b^2,(148979863575/11765230432256)*c1^7+(-192285/4677176)*c1^4*b+(-66/17)*c1*b^2,(1207034325/98867482624)*c1^6+(-195/4913)*c1^3*b+(-2)*b^2;
poly B=(-123975/74834816)*c1^5+(165/32368)*c1^2*b;
poly eta=(-186615/149669632)*c1^4+(-33/119)*c1*b;
poly D=(165/32368)*c1^2+(33/119)*c1;
poly A=(123975/74834816)*c1^5+(-186615/149669632)*c1^4;
ideal trueSlice=E, B-eta,1-z*B; ideal G=std(trueSlice); print("TRUE_SLICE_UNIT "+string(reduce(1,G)==0));
ideal bareSlice=B-eta,1-z*B; ideal GC=std(bareSlice); print("BARE_SLICE_NONUNIT "+string(reduce(1,GC)!=0));
ideal boundary=E,D,A,1-z*B; ideal GB=std(boundary); print("BOUNDARY_UNIT "+string(reduce(1,GB)==0));
poly HH=(-322341525/692072378368)*c1^6;
ideal main=(-2442158487214374375/478964176899940154343424)*c1^12+(1955537782914375/220112213648869556224)*c1^11+(-10198669449375/3236944318365728768)*c1^10,(-18794399883744375/1760897709190956449792)*c1^11+(53755762438125/1618472159182864384)*c1^10+(186973474854375/190408489315631104)*c1^9,(-570417502741875/103582218187703320576)*c1^10+(4721622283125/190408489315631104)*c1^9+(10634568924375/11200499371507712)*c1^8,1-z*D*HH; ideal GM=std(main); print("ELIM_MAIN_UNIT "+string(reduce(1,GM)==0));
quit;

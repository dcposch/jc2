// modular terminal discovery; no characteristic-zero promotion
ring R=1009,(b3,q2_0),dp;
option(redSB);
print("MAIN t=3 y=810 chart=b4zero rows=4 vars=2");
ideal I=-400,
14*b3^3 + 23*b3^2*q2_0^2 - 325*b3*q2_0^4 - 406*q2_0^6,
-161*b3^2*q2_0 - 296*b3*q2_0^3 + 441*q2_0^5,
-102*b3^2 + 135*b3*q2_0^2 - 431*q2_0^4;
ideal G=std(I);
if (reduce(1,G)==0) { print("UNIT"); } else { print("NONUNIT"); }
size(G);
quit;

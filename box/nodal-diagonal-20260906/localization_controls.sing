ring A=0,(sep,lambda,C,e,B,j,Z),dp;
ideal P=Z*sep*lambda-1;
ideal GP=std(P);
int proper_control=(reduce(1,GP)==0);
ideal D=lambda^2,Z*sep*lambda-1;
ideal GD=std(D);
int dead_control=(reduce(1,GD)==0);
ideal F99=sep-1,C-1,455*lambda+243*C,e-C,j+C,B-1,Z*sep*lambda-1;
ideal G99=std(F99);
int face99=(reduce(1,G99)==0);
ideal Wrong99=F99,e+C;
ideal GW99=std(Wrong99);
int wrong99=(reduce(1,GW99)==0);
ideal F108=sep-1,C-1,3315*lambda+2048*C,e+C,j-C,B-1,Z*sep*lambda-1;
ideal G108=std(F108);
int face108=(reduce(1,G108)==0);
ideal Wrong108=F108,e-C;
ideal GW108=std(Wrong108);
int wrong108=(reduce(1,GW108)==0);
print("CONTROL_ALL_ROWS_PARSED");
print("CONTROL_RESULT_BEGIN");
print("proper_unit_bit="+string(proper_control));
print("nilpotent_unit_bit="+string(dead_control));
print("face99_unit_bit="+string(face99));
print("wrong99_unit_bit="+string(wrong99));
print("face108_unit_bit="+string(face108));
print("wrong108_unit_bit="+string(wrong108));
print("CONTROL_RESULT_END");
quit;

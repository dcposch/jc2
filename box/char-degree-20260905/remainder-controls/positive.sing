ring R=0,(zz,tt,target_a,target_b,target_c,target_d,target_e,leader55,Z55),(lp(1),dp(8));
option(redSB);print("BEGIN_REMAINDER_BUILD");
poly h=(zz^8*(1+zz)^3)^3-tt^11*(zz^8*(1+zz)^3)^2+tt^22*(zz^8*(1+zz)^3)-tt^33;poly D=tt^43*(zz^8*(1+zz)^3)^2;poly C=(3/8)*(tt^87*(zz^8*(1+zz)^3)+tt^98);
poly H=h-(1/6)*target_b*tt^33;
poly vv=D+((1/3)*target_a+(1/18)*target_b^2)*tt^65;
poly VV=C-(1/4)*target_b*tt^33*D+((1/12)*target_a*target_b+(1/54)*target_b^3-(1/2)*target_c)*tt^98;
poly UU=(8/3)*VV/tt;if(tt*UU-(8/3)*VV!=0){ERROR("U monomial shift failed");}
poly aa=target_a+(1/4)*target_b^2;poly dd=target_d+(1/2)*target_b*target_c;
poly pp=dd-(1/3)*aa^2;poly qq=target_e+(1/4)*target_c^2-(1/3)*aa*dd+(2/27)*aa^3;
intvec tw=0,1,0,0,0,0,0,0,0;
intvec zw=1,0,0,0,0,0,0,0,0;
ideal I=target_a,target_b,target_c,target_d+(5/8),target_e,leader55+(1/4);
print("BEGIN_REMAINDER_PRODUCT");poly Rraw=vv^2-UU*H;print("END_REMAINDER_PRODUCT");
matrix cr=coef(Rraw,tt*zz);poly RR=0;int j;int charRows=0;
for(j=1;j<=ncols(cr);j++){if(deg(cr[1,j],zw)<33){RR=RR+cr[1,j]*cr[2,j];}else{I[size(I)+1]=cr[2,j];charRows++;}}
kill Rraw,cr;print("END_REMAINDER_EXTRACT");
print("BEGIN_CHARACTERISTIC_PRODUCT");poly HH=H^2;
poly Qrow=jet((3/4)*RR*HH,141,tw);print("CHAR_TERM_RH2");
Qrow=Qrow-jet((1/8)*tt*vv*UU*H,141,tw);print("CHAR_TERM_vUH");
Qrow=Qrow+jet(tt*vv*RR,141,tw);print("CHAR_TERM_vR");
Qrow=Qrow-jet((9/64)*tt^2*UU^2,141,tw);
Qrow=Qrow+jet(pp*tt^130*HH+pp*tt^131*vv+qq*tt^196,141,tw);
Qrow=Qrow-leader55*tt^141*(zz^16*(1+zz)^6)*(zz^24*(1+zz)^9);
print("END_CHARACTERISTIC_PRODUCT");matrix cq=coef(Qrow,tt*zz);
for(j=1;j<=ncols(cq);j++){I[size(I)+1]=cq[2,j];charRows++;}
I[size(I)+1]=Z55*leader55-1;
print("BEGIN_ROW_COUNTS");print(charRows);print(size(I));print("END_ROW_COUNTS");
kill cq,Qrow,HH,RR,H,h,D,C,vv,VV,UU,aa,dd,pp,qq;
print("BEGIN_GB");ideal SB=std(I);print("END_GB");print("BEGIN_RESULT");print(reduce(1,SB));print(dim(SB));print(size(SB));print("END_RESULT");
ideal neg=leader55,Z55*leader55-1;ideal pos=leader55-1,Z55*leader55-1;
print("BEGIN_CONTROLS");print(reduce(1,std(neg)));print(reduce(1,std(pos)));print("END_CONTROLS");quit;

// ---- Fable 5 desk test: staged Q*-pivot preflight + monomial-row branching, then std on the residual
LIB "polylib.lib";
int nv=nvars(basering);
int jc=0; int jT=0; int jj;
for(jj=1;jj<=nv;jj++){ if(string(var(jj))=="c"){jc=jj;} if(string(var(jj))=="T"){jT=jj;} }
print("PIVOT_PREFLIGHT_START nvars="+string(nv)+" ngens="+string(size(I))+" c_index="+string(jc)+" T_index="+string(jT));
proc pivotloop(ideal J)
{
  int npiv=0; int changed=1; int i; int j; poly f; poly d; poly rest; int S; int pass=0;
  intvec caps=1,2,3,5,8,13,21,34,55,100000;
  int ci;
  for(ci=1;ci<=size(caps);ci++){
    S=caps[ci]; changed=1;
    while(changed){
      changed=0; J=simplify(J,2);
      for(i=1;i<=size(J);i++){
        f=J[i];
        if(f!=0 && size(f)<=S){
          for(j=1;j<=nv;j++){
            if(j!=jc && j!=jT){
              d=diff(f,var(j));
              if(d!=0 && deg(d)==0){
                rest=f-d*var(j);
                J=subst(J,var(j),-rest/d);
                npiv++; changed=1; break;
              }
            }
          }
        }
      }
      pass++;
    }
  }
  J=simplify(J,2);
  print("PIVOTS="+string(npiv)+" RESIDUAL_GENS="+string(size(J))+" RESIDUAL_VARS="+string(size(variables(J))));
  return(J);
}
proc leafstd(ideal J, int depth)
{
  // branch on monomial generators (product rows) down to a depth cap, else std
  int i; int k; poly f; ideal V; int found=0;
  J=simplify(J,2);
  if(size(J)==0){ print("LEAF depth="+string(depth)+" EMPTY_IDEAL_ZERO (nontrivial)"); return(0); }
  if(depth<4){
    for(i=1;i<=size(J);i++){
      f=J[i];
      if(size(f)==1 && deg(f)>0){ V=variables(f); found=i; break; }
    }
    if(found){
      print("BRANCH depth="+string(depth)+" on monomial row with "+string(size(V))+" variables");
      int allunit=1;
      for(k=1;k<=size(V);k++){
        ideal Jk=subst(J,V[k],0);
        Jk=pivotloop(Jk);
        int r=leafstd(Jk,depth+1);
        if(r==0){allunit=0;}
      }
      return(allunit);
    }
  }
  ideal G=std(J);
  if(reduce(1,G)==0){ print("LEAF depth="+string(depth)+" UNIT"); return(1); }
  else { print("LEAF depth="+string(depth)+" NONTRIVIAL dim="+string(dim(G))+" vdim="+string(vdim(G))); return(0); }
}
ideal I0=pivotloop(I);
int i; int mx=0; int md=0;
for(i=1;i<=size(I0);i++){ if(size(I0[i])>mx){mx=size(I0[i]);} if(deg(I0[i])>md){md=deg(I0[i]);} }
print("RESIDUAL max_terms="+string(mx)+" max_deg="+string(md));
int res=leafstd(I0,0);
if(res==1){ print("MAIN_SATURATED_EMPTY_VIA_PIVOT_BRANCH"); } else { print("MAIN_NONTRIVIAL_OR_UNDECIDED"); }
print("PIVOT_PREFLIGHT_DONE");
quit;

// Follow-up: parametrize Γ by kernel ratio la (coefficient-field parameter).
option(redSB);
print("PARAM start");
poly cc0=subst(T5,b3,0);
poly bb0=subst(diff(T5,b3),b3,0);
poly aa0=subst(diff(diff(T5,b3),b3),b3,0)/2;
poly cc1=subst(T4,b3,0);
poly bb1=subst(diff(T4,b3),b3,0);
poly aa1=subst(diff(diff(T4,b3),b3),b3,0)/2;
poly cc2=subst(T3,b3,0);
poly bb2=subst(diff(T3,b3),b3,0);
poly aa2=subst(diff(diff(T3,b3),b3),b3,0)/2;
poly B1=aa0*bb1-aa1*bb0; poly C1=aa0*cc1-aa1*cc0;
poly B2=aa0*bb2-aa2*bb0; poly C2=aa0*cc2-aa2*cc0;
print("A0="+string(aa0));
ring P=(0,d,la),(b4,u2),wp(1,2);
minpoly=3*d^2-4;
poly B1=imap(rres,B1); poly B2=imap(rres,B2);
poly C1=imap(rres,C1); poly C2=imap(rres,C2);
poly P1=C1-la*B1; poly P2=C2-la*B2;
int tm=timer;
ideal g=std(ideal(P1,P2));
print("PARAM fibre: dim="+string(dim(g))+" vdim="+string(vdim(g))+" gbsize="+string(size(g))+" time="+string(timer-tm));
print("PARAM gb:");
print(g);
print("PARAM lead:");
print(lead(g));
// evaluate T5 at a point of the fibre: lift b3=la
ring S=(0,d,la),(b4,u2,b3),wp(1,2,4);
minpoly=3*d^2-4;
ideal g=imap(P,g);
poly T5=imap(rres,T5);
poly T5s=subst(T5,b3,la);
poly rT=reduce(T5s,g);
print("T5|fibre size="+string(size(rT))+" zero="+string(rT==0)+" deg="+string(deg(rT)));
print("T5|fibre = "+string(rT));
poly tau=imap(rres,tau);
poly taus=subst(tau,b3,la);
poly rtau=reduce(taus,g);
print("tau|fibre size="+string(size(rtau))+" zero="+string(rtau==0)+" deg="+string(deg(rtau)));
print("DONE_PARAM");
quit;

# Phi: band k (= h-exponent) and weight 4t+1-k
   k = 3*t + 2     weight = t - 1     
   k = 3*t         weight = t + 1     
   k = 2*t + 3     weight = 2*t - 2   
   k = 2*t + 1     weight = 2*t       
   k = 2*t - 1     weight = 2*t + 2   
   k = t + 4       weight = 3*t - 3   
   k = t + 2       weight = 3*t - 1   
   k = t           weight = 3*t + 1   
   k = t - 2       weight = 3*t + 3   
   k = 5           weight = 4*t - 4   
   k = 3           weight = 4*t - 2   
   k = 1           weight = 4*t       
   k = 0           weight = 4*t + 1   


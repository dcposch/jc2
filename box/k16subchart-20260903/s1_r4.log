   band k=2*t + 4   pivot c4 : N(coeff)=-48*b3**2*t**2*x**2*(t + 1)*(2*t + 1)**2*(3*t + 1)**2*(3*t + 2)**6*(4*t**2 + 16*t + 37)
      c4 = -(t + 5)*(2538*d*t**6 + 47757*d*t**5 + 234921*d*t**4 + 511179*d*t**3 + 675081*d*t**2 + 601452*d*t - 427152*d + 4860*t**7 + 64410*t**6 + 349187*t**5 + 1170921*t**4 + 2287073*t**3 + 2330613*t**2 + 488696*t - 436128)/(24*(2*t + 1)*(3*t - 1)*(4*t**2 + 16*t + 37)*(27*t**4 + 422*t**3 + 2231*t**2 + 4944*t + 5808))

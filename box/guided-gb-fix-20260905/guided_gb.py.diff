+def resolve_stage_timeout(config: RunConfig, stage: str) -> int | None:
+    """Internal timeout in seconds for ``stage``, or None for no internal cap.
+
+    Explicit per-stage fields win.  When ``outer_watchdog_seconds`` is set, the
+    inherited ``timeout_seconds`` std cap is not applied: the outer watchdog
+    owns the wall clock unless the caller set ``std_timeout_seconds`` or
+    ``hilbert_seed_timeout_seconds``.
+    """
+
+    if stage == STAGE_HILBERT_SEED:
+        return _positive_or_none(config.hilbert_seed_timeout_seconds)
+    if stage == STAGE_STD:
+        if config.std_timeout_seconds is not None:
+            return _positive_or_none(config.std_timeout_seconds)
+        if config.outer_watchdog_seconds is not None:
+            return None
+        return _positive_or_none(config.timeout_seconds)
+    raise ValueError(f"unknown guided_gb stage {stage!r}")
+
+
+def emit_hilbert_seed_script(system: SingularSystem) -> str:
+    """Emit a standalone Singular script: ``std`` then weighted ``hilb``."""
+
+    if not system.positive_weights or any(weight <= 0 for weight in system.positive_weights):
+        raise ValueError("Hilbert seed requires positive weights")
+    lines = [
+        "// generated by box/lib/guided_gb.py Hilbert seed",
+        f"// system={system.name}",
+        f"// characteristic={system.characteristic}",
+        system.prelude.rstrip(),
+        'print("GG__STAGE hilbert_seed START");',
+        "ideal GG_SEED_I=" + ",".join(f"({generator})" for generator in system.generators) + ";",
+        'print("GG__HILBERT_SEED_BEGIN");',
+        "timer=1;",
+        "int GG_SEED_T0=timer;",
+        "ideal GG_SEED_G=std(GG_SEED_I);",
+        'print("GG__HILBERT_SEED_STD_SECONDS "+string(timer-GG_SEED_T0));',
+        f"intvec GG_SEED_W={intvec(system.positive_weights)};",
+        "intvec GG_SEED_HNUM=hilb(GG_SEED_G,1,GG_SEED_W);",
+        'print("GG__HILBERT_NUMERATOR "+string(GG_SEED_HNUM));',
+        'print("GG__HILBERT_SEED_UNIT "+string(reduce(1,GG_SEED_G)==0));',
+        'print("GG__HILBERT_SEED_DIM "+string(dim(GG_SEED_G)));',
+        'print("GG__HILBERT_SEED_BASIS_SIZE "+string(size(GG_SEED_G)));',
+        'print("GG__HILBERT_SEED_END");',
+        'print("GG__STAGE hilbert_seed END");',
+        "quit;",
+        "",
+    ]
+    return "\n".join(lines)
+
+
+def parse_hilbert_numerator(stdout: str) -> tuple[int, ...] | None:
+    for line in stdout.splitlines():
+        stripped = line.strip()
+        if stripped.startswith("GG__HILBERT_NUMERATOR "):
+            rest = stripped.split(" ", 1)[1]
+            nums = tuple(int(tok) for tok in re.findall(r"-?\d+", rest))
+            return nums or None
+    return None
+

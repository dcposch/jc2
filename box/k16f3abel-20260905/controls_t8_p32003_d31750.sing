ring r=32003,(x,c1,c2,c3,c4,c5,c6,c7,b,B,w1,w2,w3,w4,w5,w6,w7,w8,w9,w10,w11,w12,w13,w14,w15,w16),dp;
number d=31750;
option(redSB);
proc must(int ok,string msg){ if(!ok){print("FAIL "+msg);quit;} }
proc xc(poly f,int k){matrix m=coef(f,x);int i;for(i=1;i<=ncols(m);i++){if(deg(m[1,i])==k){return(m[2,i]);}}return(poly(0));}
number y=(d+9)/34; number om=3*(2*d-1)/(4*y^2*33);
poly C=x^7+c1*x^6+c2*x^5+c3*x^4+c4*x^3+c5*x^2+c6*x^1+c7*x^0;
poly W=om*x^17-B+w1*x^1+w2*x^2+w3*x^3+w4*x^4+w5*x^5+w6*x^6+w7*x^7+w8*x^8+w9*x^9+w10*x^10+w11*x^11+w12*x^12+w13*x^13+w14*x^14+w15*x^15+w16*x^16;
poly A=3*x^3*C^2/(4*y^2); poly D=3*b*x*C/(2*y); poly K=x^2*C-y*b; poly eta=w1;
poly rhs=W^2+(B-2*A+D)*W+A*(A-D)/3-B*(A-D)-b*eta*K/(2*y)-B*eta*x+(b^2*A/2-b^2*(B+W))/x;
poly ff=2*(x*W-(b^2)/4)*diff(W,x)-rhs;
must(xc(ff,34)==0,"leading");
poly band,piv,val; poly solB;
band=xc(ff,33); piv=diff(band,w16);
must(deg(piv)==0 && piv!=0,"pivot_w16");
val=-subst(band,w16,0)/piv; ff=subst(ff,w16,val); W=subst(W,w16,val);
print("PIVOT w16 "+string(piv));
band=xc(ff,32); piv=diff(band,w15);
must(deg(piv)==0 && piv!=0,"pivot_w15");
val=-subst(band,w15,0)/piv; ff=subst(ff,w15,val); W=subst(W,w15,val);
print("PIVOT w15 "+string(piv));
band=xc(ff,31); piv=diff(band,w14);
must(deg(piv)==0 && piv!=0,"pivot_w14");
val=-subst(band,w14,0)/piv; ff=subst(ff,w14,val); W=subst(W,w14,val);
print("PIVOT w14 "+string(piv));
band=xc(ff,30); piv=diff(band,w13);
must(deg(piv)==0 && piv!=0,"pivot_w13");
val=-subst(band,w13,0)/piv; ff=subst(ff,w13,val); W=subst(W,w13,val);
print("PIVOT w13 "+string(piv));
band=xc(ff,29); piv=diff(band,w12);
must(deg(piv)==0 && piv!=0,"pivot_w12");
val=-subst(band,w12,0)/piv; ff=subst(ff,w12,val); W=subst(W,w12,val);
print("PIVOT w12 "+string(piv));
band=xc(ff,28); piv=diff(band,w11);
must(deg(piv)==0 && piv!=0,"pivot_w11");
val=-subst(band,w11,0)/piv; ff=subst(ff,w11,val); W=subst(W,w11,val);
print("PIVOT w11 "+string(piv));
band=xc(ff,27); piv=diff(band,w10);
must(deg(piv)==0 && piv!=0,"pivot_w10");
val=-subst(band,w10,0)/piv; ff=subst(ff,w10,val); W=subst(W,w10,val);
print("PIVOT w10 "+string(piv));
band=xc(ff,26); piv=diff(band,w9);
must(deg(piv)==0 && piv!=0,"pivot_w9");
val=-subst(band,w9,0)/piv; ff=subst(ff,w9,val); W=subst(W,w9,val);
print("PIVOT w9 "+string(piv));
band=xc(ff,25); piv=diff(band,w8);
must(deg(piv)==0 && piv!=0,"pivot_w8");
val=-subst(band,w8,0)/piv; ff=subst(ff,w8,val); W=subst(W,w8,val);
print("PIVOT w8 "+string(piv));
band=xc(ff,24); piv=diff(band,w7);
must(deg(piv)==0 && piv!=0,"pivot_w7");
val=-subst(band,w7,0)/piv; ff=subst(ff,w7,val); W=subst(W,w7,val);
print("PIVOT w7 "+string(piv));
band=xc(ff,23); piv=diff(band,w6);
must(deg(piv)==0 && piv!=0,"pivot_w6");
val=-subst(band,w6,0)/piv; ff=subst(ff,w6,val); W=subst(W,w6,val);
print("PIVOT w6 "+string(piv));
band=xc(ff,22); piv=diff(band,w5);
must(deg(piv)==0 && piv!=0,"pivot_w5");
val=-subst(band,w5,0)/piv; ff=subst(ff,w5,val); W=subst(W,w5,val);
print("PIVOT w5 "+string(piv));
band=xc(ff,21); piv=diff(band,w4);
must(deg(piv)==0 && piv!=0,"pivot_w4");
val=-subst(band,w4,0)/piv; ff=subst(ff,w4,val); W=subst(W,w4,val);
print("PIVOT w4 "+string(piv));
band=xc(ff,20); piv=diff(band,w3);
must(deg(piv)==0 && piv!=0,"pivot_w3");
val=-subst(band,w3,0)/piv; ff=subst(ff,w3,val); W=subst(W,w3,val);
print("PIVOT w3 "+string(piv));
band=xc(ff,19); piv=diff(band,w2);
must(deg(piv)==0 && piv!=0,"pivot_w2");
val=-subst(band,w2,0)/piv; ff=subst(ff,w2,val); W=subst(W,w2,val);
print("PIVOT w2 "+string(piv));
band=xc(ff,18); piv=diff(band,w1);
must(deg(piv)==0 && piv!=0,"pivot_w1");
val=-subst(band,w1,0)/piv; ff=subst(ff,w1,val); W=subst(W,w1,val);
print("PIVOT w1 "+string(piv));
band=xc(ff,17); piv=diff(band,B);
must(deg(piv)==0 && piv!=0,"pivot_B");
val=-subst(band,B,0)/piv; ff=subst(ff,B,val); W=subst(W,B,val);
print("PIVOT B "+string(piv));
solB=val;
must(xc(ff,0)==0 && xc(ff,1)==0,"low_two");
for(int k=17;k<=34;k++){must(xc(ff,k)==0,"high");}
eta=xc(W,1); poly target=solB*eta; ideal rows;
write("/home/ubuntu/jc2/box/k16f3abel-20260905/controls_t8_p32003_d31750_W.txt",string(W));
for(k=2;k<17;k++){rows[k-1]=xc(ff,k);}
write("/home/ubuntu/jc2/box/k16f3abel-20260905/controls_t8_p32003_d31750_raw.sing","// Direct F1--F3; coefficient map is identity on c_i,b.");
write("/home/ubuntu/jc2/box/k16f3abel-20260905/controls_t8_p32003_d31750_raw.sing","ring rsmall=32003,(c1,c2,c3,c4,c5,c6,c7,b),wp(1,2,3,4,5,6,7,9);");
write("/home/ubuntu/jc2/box/k16f3abel-20260905/controls_t8_p32003_d31750_raw.sing","number d=31750;");
write("/home/ubuntu/jc2/box/k16f3abel-20260905/controls_t8_p32003_d31750_raw.sing","ideal rows="+string(rows)+";");
write("/home/ubuntu/jc2/box/k16f3abel-20260905/controls_t8_p32003_d31750_raw.sing","poly Bsol="+string(solB)+";");
write("/home/ubuntu/jc2/box/k16f3abel-20260905/controls_t8_p32003_d31750_raw.sing","poly eta="+string(eta)+";");
write("/home/ubuntu/jc2/box/k16f3abel-20260905/controls_t8_p32003_d31750_raw.sing","poly target="+string(target)+";");
ring rsmall=32003,(c1,c2,c3,c4,c5,c6,c7,b),wp(1,2,3,4,5,6,7,9);
number d=31750;
ideal rows=imap(r,rows); poly target=imap(r,target); poly Bsol=imap(r,solB); poly eta=imap(r,eta);
print("ROWS_BUILT"); print("Bsol_terms="+string(size(Bsol))); print("eta_terms="+string(size(eta)));
print("DIRECT_RAW_DONE"); quit;

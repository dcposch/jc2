// target_before=-A3_3*B2_0*s2 + A3_3*B2_2*s2
ring R=0,(b1,b2,b3,b4,b5,s2,A2_0,A2_1,A2_2,A2_3,A3_0,A3_1,A3_2,A3_3,B2_0,B2_1,B2_2,c,T),dp;
option(redSB);

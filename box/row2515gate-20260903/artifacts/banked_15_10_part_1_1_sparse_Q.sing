-5*A2_2*B2_0*s2 + 5*A2_2*B2_2*s2,
-4*A3_0*s2 - 8*A3_0 + 8*A3_2*s2 + 8*A3_2,
2*A2_1*B2_1*s2 - 2*A2_1*B2_1 + 3*A2_2*B2_0*s2 + 7*A2_2*B2_0 - 7*A2_2*B2_2*s2 - 7*A2_2*B2_2 + 2*A2_3*B2_1*s2 + 2*A2_3*B2_1,
2*A2_0*B2_1*s2 + 4*A3_1*b5*s2 + 4*A3_3*b4*s2,
-4*A2_2*B2_1*b5*s2 + 8*A3_3*b5*s2,
-2*A3_0*s2 + 8*A3_0 - 10*A3_2,
-2*A2_1*B2_1*s2 + 2*A2_1*B2_1 + 2*A2_2*B2_0*s2 - 7*A2_2*B2_0 + 9*A2_2*B2_2 - 4*A2_3*B2_1 + 8*A3_0*b1 - 8*A3_2*b1,

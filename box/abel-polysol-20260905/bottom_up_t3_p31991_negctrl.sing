ring r=31991,(x,c1,c2,B,eta,w2),dp;
number d=14162;
option(redSB);
proc xc(poly f,int k){matrix m=coef(f,x);int i;for(i=1;i<=ncols(m);i++){if(deg(m[1,i])==k){return(m[2,i]);}}return(poly(0));}
number y=(d+4)/14; number om=1/(4*y^2*(2*d+1)); number omalt=1/(4*y^2*(1-2*d));
poly C=x^2+c1*x^1+c2*x^0;
poly L=x^2*C/y-1;   // b=1
poly G=(3/2)*L*(L+1)-B*x;
poly R=(3/16)*(L^2)*(L*(L+2)-4*B*x)-eta*x^2*(L/2+B*x);
list Pc; int k; int i; for(k=1;k<=16+1;k++){Pc[k]=poly(0);}   // Pc[k+1] = P_k
Pc[1]=-1/4; Pc[2]=-B; Pc[3]=eta; Pc[4]=w2;
poly acc;
for(k=4;k<=16;k++){
  acc=0;
  for(i=1;i<=k-1;i++){ acc=acc+(k-3)*Pc[i+1]*Pc[k-i+1]; }
  for(i=1;i<=k;i++){ acc=acc+xc(G,i)*Pc[k-i+1]; }
  acc=acc-xc(R,k);
  Pc[k+1]=acc*2/(k-3);
  print("PHI "+string(k)+" terms="+string(size(Pc[k+1]))+" deg="+string(deg(Pc[k+1])));
}
// residue check: row x^3 vanishes identically
acc=0; for(i=1;i<=2;i++){acc=acc+0*Pc[i+1]*Pc[3-i+1];} for(i=1;i<=3;i++){acc=acc+xc(G,i)*Pc[3-i+1];} acc=acc-xc(R,3);
print("ROW_X3_RESIDUE_ZERO="+string(acc==0));
ideal J0; for(k=9;k<=16;k++){J0[k-8]=Pc[k+1];}
ideal J1=J0[1]; ideal J1b=J0[1],J0[2];
ideal J2=J0[1..4];
ring rs=31991,(c1,c2,B,eta,w2),dp;
number d=14162;
ideal J0=imap(r,J0); ideal J1=imap(r,J1); ideal J2=imap(r,J2); ideal J1b=imap(r,J1b);
int tt=timer;
ideal g1=std(J1); print("NEG_one_row_std dim="+string(dim(g1))+" unit="+string(size(g1)==1 && deg(g1[1])==0)+" time="+string(timer-tt));
tt=timer; ideal g1b=std(J1b); print("NEG_two_rows_std dim="+string(dim(g1b))+" unit="+string(size(g1b)==1 && deg(g1b[1])==0)+" time="+string(timer-tt));
tt=timer; ideal g2=std(J2); print("NEG_four_rows_std dim="+string(dim(g2))+" unit="+string(size(g2)==1 && deg(g2[1])==0)+" time="+string(timer-tt));
print("BOTTOMUP_DONE"); quit;

poly se4=14/27*w^2*c^2*d4^2+28/27*w*c^2*x3*x5-16/9*w*c^2*x5^2-20/27*w*c*d2*x3+16/9*w*c*d2*x5-20/27*w*c*d4*x1+16/9*w*c*d4*x3+56/81*w*c*d4*x5^2-28/9*w*c*d4*x5-20/27*w*c*x5-8/27*w*d2^2-8/27*w*d2*d4*x5+20/27*w*d2*d4+4/9*w*d2-4/27*w*d4^2*x3+52/81*w*d4^2*x5-4/9*w*d4^2-16/27*w*d4+2/9*x1^2-16/27*x1*x3-4/27*x1*x5^2+20/27*x1*x5-4/27*x3^2*x5+10/27*x3^2+52/81*x3*x5^2-8/9*x3*x5+5/243*x5^4-140/243*x5^3+14/27*x5^2;
poly se5=-4/9*w*c^3*x5^2+20/27*w*c^2*d2*x5+20/27*w*c^2*d4*x3-20/9*w*c^2*d4*x5-8/27*w*c*d2^2+32/27*w*c*d2*d4+16/27*w*c*d4^2*x5-76/81*w*c*d4^2-16/27*w*c*d4-4/27*w*d2*d4^2+16/81*w*d4^3-16/27*c*x1*x3+32/27*c*x1*x5+16/27*c*x3^2+44/81*c*x3*x5^2-152/81*c*x3*x5-224/243*c*x5^3+4/3*c*x5^2-4/9*d2*x1-20/81*d2*x3*x5+40/81*d2*x3+40/81*d2*x5^2-44/81*d2*x5-20/81*d4*x1*x5+40/81*d4*x1-4/27*d4*x3^2+88/81*d4*x3*x5-44/81*d4*x3+16/243*d4*x5^3-328/243*d4*x5^2+16/27*d4*x5+4/9*x1-4/9*x3-8/81*x5^2+40/81*x5;
poly se6=-4/9*w^2*c^3*d4*x5+4/9*w^2*c^2*d2*d4-16/27*w^2*c^2*d4^2+4/27*w^2*c*d4^3+4/9*w*c^2*x1*x5+2/9*w*c^2*x3^2-32/27*w*c^2*x3*x5-28/81*w*c^2*x5^3+10/9*w*c^2*x5^2-4/9*w*c*d2*x1+20/27*w*c*d2*x3+32/81*w*c*d2*x5^2-28/27*w*c*d2*x5+20/27*w*c*d4*x1+8/9*w*c*d4*x3*x5-28/27*w*c*d4*x3-164/81*w*c*d4*x5^2+4/3*w*c*d4*x5-4/9*w*c*x3+20/27*w*c*x5-8/81*w*d2^2*x5+4/27*w*d2^2-20/81*w*d2*d4*x3+64/81*w*d2*d4*x5-8/27*w*d2*d4-8/27*w*d2-8/81*w*d4^2*x1+4/9*w*d4^2*x3+2/27*w*d4^2*x5^2-80/81*w*d4^2*x5+4/27*w*d4^2-4/27*w*d4*x5+8/27*w*d4+2/9*w-4/27*x1^2-16/81*x1*x3*x5+8/27*x1*x3+28/81*x1*x5^2-8/27*x1*x5-4/81*x3^3+4/9*x3^2*x5-4/27*x3^2+4/81*x3*x5^3-80/81*x3*x5^2+8/27*x3*x5-20/243*x5^4+152/243*x5^3-4/27*x5^2;
poly se7=-8/81*w^2*c^3*d4^2-16/81*w*c^3*x3*x5+8/27*w*c^3*x5^2+20/81*w*c^2*d2*x3-44/81*w*c^2*d2*x5+20/81*w*c^2*d4*x1-44/81*w*c^2*d4*x3-164/243*w*c^2*d4*x5^2+8/9*w*c^2*d4*x5+20/81*w*c^2*x5+16/81*w*c*d2^2+16/27*w*c*d2*d4*x5-40/81*w*c*d2*d4-8/27*w*c*d2+8/27*w*c*d4^2*x3-104/81*w*c*d4^2*x5+208/729*w*c*d4^2+32/81*w*c*d4-8/81*w*d2^2*d4+8/27*w*d2*d4^2+8/243*w*d4^3*x5-52/243*w*d4^3-4/81*w*d4^2-4/27*c*x1^2+32/81*c*x1*x3+20/81*c*x1*x5^2-40/81*c*x1*x5+8/27*c*x3^2*x5-20/81*c*x3^2-304/243*c*x3*x5^2+416/729*c*x3*x5-40/729*c*x5^4+820/729*c*x5^3-76/243*c*x5^2-4/27*d2*x1*x5+4/27*d2*x1-8/81*d2*x3^2+136/243*d2*x3*x5-100/729*d2*x3+8/243*d2*x5^3-140/243*d2*x5^2+92/729*d2*x5-4/27*d4*x1*x3+112/243*d4*x1*x5-100/729*d4*x1+8/27*d4*x3^2+8/81*d4*x3*x5^2-296/243*d4*x3*x5+92/729*d4*x3-152/729*d4*x5^3+2368/2187*d4*x5^2-28/243*d4*x5-4/27*x1-8/81*x3*x5+4/27*x3+40/243*x5^2-100/729*x5;
poly se8=-4/81*w^2*c^3*d2*x5-4/81*w^2*c^3*d4*x3+4/27*w^2*c^3*d4*x5+4/81*w^2*c^2*d2^2-16/81*w^2*c^2*d2*d4-76/243*w^2*c^2*d4^2*x5+34/243*w^2*c^2*d4^2+8/81*w^2*c^2*d4+4/27*w^2*c*d2*d4^2-16/81*w^2*c*d4^3+1/243*w^2*d4^4+8/81*w*c^2*x1*x3-16/81*w*c^2*x1*x5-8/81*w*c^2*x3^2-8/27*w*c^2*x3*x5^2+68/243*w*c^2*x3*x5+364/729*w*c^2*x5^3-40/243*w*c^2*x5^2+4/27*w*c*d2*x1+68/243*w*c*d2*x3*x5-40/243*w*c*d2*x3-44/81*w*c*d2*x5^2+124/729*w*c*d2*x5+68/243*w*c*d4*x1*x5-40/243*w*c*d4*x1+4/27*w*c*d4*x3^2-280/243*w*c*d4*x3*x5+124/729*w*c*d4*x3-76/729*w*c*d4*x5^3+1048/729*w*c*d4*x5^2-40/243*w*c*d4*x5-4/27*w*c*x1+4/27*w*c*x3+20/243*w*c*x5^2-40/243*w*c*x5-4/81*w*d2^2*x3+32/243*w*d2^2*x5-16/729*w*d2^2-8/81*w*d2*d4*x1+68/243*w*d2*d4*x3+4/81*w*d2*d4*x5^2-128/243*w*d2*d4*x5+28/729*w*d2*d4-4/81*w*d2*x5+4/81*w*d2+32/243*w*d4^2*x1+4/81*w*d4^2*x3*x5-68/243*w*d4^2*x3-4/27*w*d4^2*x5^2+1004/2187*w*d4^2*x5-4/243*w*d4^2-4/81*w*d4*x3+4/27*w*d4*x5-32/729*w*d4-4/81*x1^2*x5+2/81*x1^2-4/81*x1*x3^2+64/243*x1*x3*x5-32/729*x1*x3+4/243*x1*x5^3-20/81*x1*x5^2+28/729*x1*x5+4/81*x3^3+2/81*x3^2*x5^2-68/243*x3^2*x5+14/729*x3^2-8/81*x3*x5^3+1004/2187*x3*x5^2-8/243*x3*x5-4/2187*x5^5+190/2187*x5^4-1528/6561*x5^3+10/729*x5^2;
ideal SI=se1,se3,se5,se7,se2,se4;
ring L=0,(t,c,b,z,Q1,W,U2,X2,Z2),(dp(9));
option(redSB);
map leadmap=S,t^3*W,c,b+1+Q1*t,b,U2*t^2,z*t+X2*t^2,z*t+Z2*t^2;
poly le1=leadmap(se1);
poly le3=leadmap(se3);
poly le5=leadmap(se5);
poly le7=leadmap(se7);
poly le2=leadmap(se2);
poly le4=leadmap(se4);
poly l1_1=subst(diff(le1,t),t,0)/1;
poly l1_2=subst(diff(diff(le1,t),t),t,0)/2;
poly l3_1=subst(diff(le3,t),t,0)/1;
poly l3_2=subst(diff(diff(le3,t),t),t,0)/2;
poly l5_1=subst(diff(le5,t),t,0)/1;
poly l5_2=subst(diff(diff(le5,t),t),t,0)/2;
poly l7_1=subst(diff(le7,t),t,0)/1;
poly l7_2=subst(diff(diff(le7,t),t),t,0)/2;
poly l2_1=subst(diff(le2,t),t,0)/1;
poly l2_2=subst(diff(diff(le2,t),t),t,0)/2;
poly l2_3=subst(diff(diff(diff(le2,t),t),t),t,0)/6;
poly l4_1=subst(diff(le4,t),t,0)/1;
poly l4_2=subst(diff(diff(le4,t),t),t,0)/2;
poly l4_3=subst(diff(diff(diff(le4,t),t),t),t,0)/6;
ideal Lead=l1_1,l1_2,l3_1,l3_2,l5_1,l5_2,l7_1,l7_2,l2_1,l2_2,l2_3,l4_1,l4_2,l4_3;
ideal ELead=b-1,U2,3*Q1-(3*c-1)*z,3*(X2-Z2)+z^2,9*W-2*z^3;
list LLead=sat(Lead,ideal(z));ideal LeadOpen=LLead[1];ideal GLead=slimgb(LeadOpen);
ideal GELead=slimgb(ELead);
int lead_to_expected=1;for(int il=1;il<=size(GLead);il++){if(reduce(GLead[il],GELead)!=0){lead_to_expected=0;}}
int expected_to_lead=1;for(int jl=1;jl<=size(GELead);jl++){if(reduce(GELead[jl],GLead)!=0){expected_to_lead=0;}}
print("LEADING_CHART_BEGIN");
print("leading_ideal_identity="+string(lead_to_expected*expected_to_lead));
print("LEADING_BASIS_BEGIN");GLead;print("LEADING_BASIS_END");
print("LEADING_CHART_END");
ring C=0,(t,c,C1,Q2,U3,B1,B2,X3,W4,A,aux),(dp(11));
option(redSB);
map contmap=S,2/9*t^3+W4*t^4,c+C1*t,2+(B1+c-1/3)*t+(B2+Q2)*t^2,1+B1*t+B2*t^2,U3*t^3,t-1/3*t^2+X3*t^3,t;
poly ce1=contmap(se1);poly ce5=contmap(se5);poly ce7=contmap(se7);
poly C1e=subst(diff(diff(diff(ce1,t),t),t),t,0)/6;
poly C5e=subst(diff(diff(diff(ce5,t),t),t),t,0)/6;
poly C7e=subst(diff(diff(diff(ce7,t),t),t),t,0)/6;
ideal Actual=C1e,C5e,C7e,A-C1+Q2;
ideal Expected=9*(A+U3)+c+1,-26*c-27*B1+9*(A+U3)-15,83*c+81*B1+18*(A+U3)-58,A-C1+Q2;
ideal GActual=slimgb(Actual);
ideal GExpected=slimgb(Expected);
int actual_to_expected=1;for(int ia=1;ia<=size(GActual);ia++){if(reduce(GActual[ia],GExpected)!=0){actual_to_expected=0;}}
int expected_to_actual=1;for(int ja=1;ja<=size(GExpected);ja++){if(reduce(GExpected[ja],GActual)!=0){expected_to_actual=0;}}
int actual_unit=0;if(reduce(1,GActual)==0){actual_unit=1;}
poly P1=9*(A+U3)+c+1;
poly P5=-26*c-27*B1+9*(A+U3)-15;
poly P7=83*c+81*B1+18*(A+U3)-58;
ideal J12=P1,P5,A-C1+Q2;ideal G12=slimgb(J12);
poly third_residual=reduce(P7,G12);
print("Q8-W0-RANKDROP-SLOPE3-CONTINUATION");
print("engine=slimgb");
print("order=block");
print("actual_expected_ideal_identity="+string(actual_to_expected*expected_to_actual));
print("continuation_unit="+string(actual_unit));
print("third_residual="+string(third_residual));
print("ACTUAL_COEFFICIENTS_BEGIN");C1e;C5e;C7e;print("ACTUAL_COEFFICIENTS_END");
print("Q8_W0_RANKDROP_SLOPE3_CONTINUATION_PASS");
exit;

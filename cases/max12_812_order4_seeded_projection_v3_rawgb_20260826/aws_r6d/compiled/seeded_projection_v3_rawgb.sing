ring R=0,(a0,a1,a2,a3,a4,a5,a6),dp;
option(redSB);
proc ideal_is_zero(ideal A)
{
  int i;
  for (i=1; i<=size(A); i++)
  {
    if (A[i] != 0) { return(0); }
  }
  return(1);
}

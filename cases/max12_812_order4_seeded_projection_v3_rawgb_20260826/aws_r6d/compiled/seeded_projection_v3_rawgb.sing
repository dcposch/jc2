ideal GQraw=std(JQ);
ideal GQ=GQraw;
int seed_nonzero_leads=1;
int seed_i;
for (seed_i=1; seed_i<=size(GQ); seed_i++)
{
  number seed_lc=leadcoef(GQ[seed_i]);
  if (seed_lc==0)
  {
    seed_nonzero_leads=0;
  }
  else
  {
    GQ[seed_i]=GQ[seed_i]/seed_lc;
  }
}
int seed_monic=1;
for (seed_i=1; seed_i<=size(GQ); seed_i++)
{
  if (leadcoef(GQ[seed_i]) != 1) { seed_monic=0; }
}
attrib(GQ,"isSB",1);
print("SEEDED_Q_SCALAR_NORMALIZATION_SB_MARK=1");
int raw_to_norm=ideal_is_zero(reduce(GQraw,GQ));
int norm_to_raw=ideal_is_zero(reduce(GQ,GQraw));

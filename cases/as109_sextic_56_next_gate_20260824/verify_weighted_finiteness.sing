// Exact Groebner certificate for the (5,6) weighted pole gate.
// The first ideal is the five weighted-leading equations from BOTH y=0
// boundaries and the three first integrals.  The second is the coefficient
// infinity system plus the radial last-row coefficient.

option(redSB);
ring R=0,(r,A,B,C,D),dp;

poly F=r5+A*r3+B*r2+C*r+D;
poly G=125*r6+150*A*r4+150*B*r3+(15*A2+150*C)*r2
       +(30*A*B+150*D)*r-4*A3+30*A*C+15*B2;
poly J3=-2*A2*B+5*A*D+5*B*C;
poly J2=3*A4-20*A*B2-20*A2*C+50*B*D+25*C2;
poly J1=12*A3*B-10*B3-45*A*B*C-15*A2*D+75*C*D;

ideal boundary_top=F,G,J3,J2,J1;
ideal boundary_std=std(boundary_top);
int boundary_dim=dim(boundary_std);
int boundary_length=vdim(boundary_std);
if (boundary_dim!=0)
{
  ERROR("boundary leading ideal is not zero-dimensional");
}
if (boundary_length!=126)
{
  ERROR("unexpected boundary quotient length");
}
if (reduce(r21,boundary_std)!=0)
{
  ERROR("r^21 is not in the boundary leading ideal");
}

ring C0=0,(A,B,C,D),dp;
poly J3=-2*A2*B+5*A*D+5*B*C;
poly J2=3*A4-20*A*B2-20*A2*C+50*B*D+25*C2;
poly J1=12*A3*B-10*B3-45*A*B*C-15*A2*D+75*C*D;
poly H10=4*A3*C-30*A*C2-15*B2*C+25*A*B*D+125*D2;

ideal eta_top=J3,J2,J1,H10;
ideal eta_std=std(eta_top);
int eta_dim=dim(eta_std);
int eta_length=vdim(eta_std);
if (eta_dim!=0)
{
  ERROR("eta leading ideal is not zero-dimensional");
}
if (eta_length!=42)
{
  ERROR("unexpected eta quotient length");
}

print("verdict = EXACT-WEIGHTED-(5,6)-CERTIFICATE");
print("boundary_top_dim = "+string(boundary_dim));
print("boundary_top_quotient_length = "+string(boundary_length));
print("r_power_certificate = r^21 in boundary_top");
print("eta_top_dim = "+string(eta_dim));
print("eta_top_quotient_length = "+string(eta_length));
print("both_y0_boundaries_used = true");
print("enumeration_run = false");
print("jc2_inference = false");

execute(read("prelude_Q.sing"));

ideal I=r1,r2,r3,r4,r5,r6,r7;
poly f0=d0-2*d4-d4^2;
poly f1=8*d1-(1+d4)*d3;
poly f2=d2-d4-16*d3^2;
poly f5=d5-2*d3;
ideal J=f0,f1,f2,f5;
ideal GJ=std(J);
ideal RI=reduce(I,GJ);
int input_containment=(size(simplify(RI,2))==0);
poly badf2=d2-d4-15*d3^2;
ideal BAD=f0,f1,badf2,f5;
int mutation_detected=(size(simplify(reduce(I,std(BAD)),2))!=0);
print("K00_SURFACE_INPUT_CONTAINMENT="+string(input_containment));
print("K00_SURFACE_MUTATION_DETECTED="+string(mutation_detected));
print("K00_SURFACE_DIM="+string(dim(GJ)));
if ((input_containment!=1)||(mutation_detected!=1)||(dim(GJ)!=2))
{
  print("K00_SURFACE_GLOBAL_POWER_FAIL=PREFLIGHT");
  quit;
}

matrix T;
ideal G=liftstd(I,T);
matrix basis_replay=matrix(I)*T-matrix(G);
int basis_bad=0;
int basis_col;
for (basis_col=1;basis_col<=ncols(basis_replay);basis_col++)
{
  if (basis_replay[1,basis_col]!=0) { basis_bad=1; }
}
if (basis_bad)
{
  print("K00_SURFACE_GLOBAL_POWER_FAIL=BASIS_REPLAY");
  quit;
}
print("K00_SURFACE_GLOBAL_BASIS_SIZE="+string(size(G)));

intvec first=0,0,0,0;
poly target;
poly base;
int i;
int n;
for (i=1;i<=4;i++)
{
  if (i==1) { base=f0; }
  if (i==2) { base=f1; }
  if (i==3) { base=f2; }
  if (i==4) { base=f5; }
  target=base;
  first[i]=0;
  for (n=1;n<=64;n++)
  {
    if (first[i]==0)
    {
      if (reduce(target,G)==0) { first[i]=n; }
      else { target=target*base; }
    }
  }
  print("K00_SURFACE_GLOBAL_FIRST_POWER_"+string(i)+"="+string(first[i]));
}
if ((first[1]==0)||(first[2]==0)||(first[3]==0)||(first[4]==0))
{
  print("K00_SURFACE_GLOBAL_POWER_ENDPOINT=RESOURCE_CAP_NO_VERDICT");
  quit;
}

target=f0^first[1];
matrix C0=lift(G,ideal(target));
matrix L0=T*C0;
matrix R0=matrix(I)*L0-matrix(ideal(target));
if (R0[1,1]!=0) { print("K00_SURFACE_GLOBAL_POWER_FAIL=F0_REPLAY"); quit; }
if ((nrows(L0)!=7)||(ncols(L0)!=1)) { print("K00_SURFACE_GLOBAL_POWER_FAIL=F0_SHAPE"); quit; }
write("POWER_F0_LIFT_1.poly",L0[1,1]);
write("POWER_F0_LIFT_2.poly",L0[2,1]);
write("POWER_F0_LIFT_3.poly",L0[3,1]);
write("POWER_F0_LIFT_4.poly",L0[4,1]);
write("POWER_F0_LIFT_5.poly",L0[5,1]);
write("POWER_F0_LIFT_6.poly",L0[6,1]);
write("POWER_F0_LIFT_7.poly",L0[7,1]);

target=f1^first[2];
matrix C1=lift(G,ideal(target));
matrix L1=T*C1;
matrix R1=matrix(I)*L1-matrix(ideal(target));
if (R1[1,1]!=0) { print("K00_SURFACE_GLOBAL_POWER_FAIL=F1_REPLAY"); quit; }
if ((nrows(L1)!=7)||(ncols(L1)!=1)) { print("K00_SURFACE_GLOBAL_POWER_FAIL=F1_SHAPE"); quit; }
write("POWER_F1_LIFT_1.poly",L1[1,1]);
write("POWER_F1_LIFT_2.poly",L1[2,1]);
write("POWER_F1_LIFT_3.poly",L1[3,1]);
write("POWER_F1_LIFT_4.poly",L1[4,1]);
write("POWER_F1_LIFT_5.poly",L1[5,1]);
write("POWER_F1_LIFT_6.poly",L1[6,1]);
write("POWER_F1_LIFT_7.poly",L1[7,1]);

target=f2^first[3];
matrix C2=lift(G,ideal(target));
matrix L2=T*C2;
matrix R2=matrix(I)*L2-matrix(ideal(target));
if (R2[1,1]!=0) { print("K00_SURFACE_GLOBAL_POWER_FAIL=F2_REPLAY"); quit; }
if ((nrows(L2)!=7)||(ncols(L2)!=1)) { print("K00_SURFACE_GLOBAL_POWER_FAIL=F2_SHAPE"); quit; }
write("POWER_F2_LIFT_1.poly",L2[1,1]);
write("POWER_F2_LIFT_2.poly",L2[2,1]);
write("POWER_F2_LIFT_3.poly",L2[3,1]);
write("POWER_F2_LIFT_4.poly",L2[4,1]);
write("POWER_F2_LIFT_5.poly",L2[5,1]);
write("POWER_F2_LIFT_6.poly",L2[6,1]);
write("POWER_F2_LIFT_7.poly",L2[7,1]);

target=f5^first[4];
matrix C5=lift(G,ideal(target));
matrix L5=T*C5;
matrix R5=matrix(I)*L5-matrix(ideal(target));
if (R5[1,1]!=0) { print("K00_SURFACE_GLOBAL_POWER_FAIL=F5_REPLAY"); quit; }
if ((nrows(L5)!=7)||(ncols(L5)!=1)) { print("K00_SURFACE_GLOBAL_POWER_FAIL=F5_SHAPE"); quit; }
write("POWER_F5_LIFT_1.poly",L5[1,1]);
write("POWER_F5_LIFT_2.poly",L5[2,1]);
write("POWER_F5_LIFT_3.poly",L5[3,1]);
write("POWER_F5_LIFT_4.poly",L5[4,1]);
write("POWER_F5_LIFT_5.poly",L5[5,1]);
write("POWER_F5_LIFT_6.poly",L5[6,1]);
write("POWER_F5_LIFT_7.poly",L5[7,1]);

int pick=0;
for (i=1;i<=nrows(L0);i++)
{
  if ((pick==0)&&(L0[i,1]!=0)) { pick=i; }
}
if (pick==0) { print("K00_SURFACE_GLOBAL_POWER_FAIL=EMPTY_F0_LIFT"); quit; }
matrix M0=L0;
M0[pick,1]=M0[pick,1]+1;
matrix mutation_replay=matrix(I)*M0-matrix(ideal(f0^first[1]));
if (mutation_replay[1,1]==0)
{
  print("K00_SURFACE_GLOBAL_POWER_FAIL=CERTIFICATE_MUTATION_CONTROL");
  quit;
}
print("K00_SURFACE_GLOBAL_CERTIFICATE_MUTATION_INDEX="+string(pick));
print("K00_SURFACE_GLOBAL_POWER_REPLAYS=4");
print("K00_SURFACE_GLOBAL_POWER_SERIALIZED_MULTIPLIERS=28");
print("K00_SURFACE_GLOBAL_POWER_ENDPOINT=EXACT_GLOBAL_RADICAL_J");
quit;

while(step<=105){ found=0; pi=0; pj=0; for(i=step;i<=106 && found==0;i=i+1){ for(j=step;j<=105 && found==0;j=j+1){ B[i,j]=reduce(B[i,j],NODE_SB); operation_reductions=operation_reductions+1; if(B[i,j]!=0 && deg(B[i,j])==0){ found=1; pi=i; pj=j; } } } if(found==0){ step=106; } else { for(j=1;j<=105;j=j+1){ swap_entry=B[step,j]; B[step,j]=B[pi,j]; B[pi,j]=swap_entry; } for(i=1;i<=106;i=i+1){ swap_entry=B[i,step]; B[i,step]=B[i,pj]; B[i,pj]=swap_entry; } for(i=1;i<=105;i=i+1){ swap_entry=C[i,step]; C[i,step]=C[i,pj]; C[i,pj]=swap_entry; } B[step,step]=reduce(B[step,step],NODE_SB); operation_reductions=operation_reductions+1; if(B[step,step]==0 || deg(B[step,step])!=0){ invariant_failures=invariant_failures+1; } inverse_unit=1/leadcoef(B[step,step]); for(i=step+1;i<=106;i=i+1){ multiple=reduce(B[i,step]*inverse_unit,NODE_SB); operation_reductions=operation_reductions+1; for(j=step;j<=105;j=j+1){ B[i,j]=reduce(B[i,j]-multiple*B[step,j],NODE_SB); operation_reductions=operation_reductions+1; } } for(j=step+1;j<=105;j=j+1){ multiple=reduce(B[step,j]*inverse_unit,NODE_SB); operation_reductions=operation_reductions+1; for(i=step;i<=106;i=i+1){ B[i,j]=reduce(B[i,j]-multiple*B[i,step],NODE_SB); operation_reductions=operation_reductions+1; } for(i=1;i<=105;i=i+1){ C[i,j]=reduce(C[i,j]-multiple*C[i,step],NODE_SB); operation_reductions=operation_reductions+1; } } for(i=1;i<=106;i=i+1){ if(i!=step && reduce(B[i,step],NODE_SB)!=0){ invariant_failures=invariant_failures+1; } } for(j=1;j<=105;j=j+1){ if(j!=step && reduce(B[step,j],NODE_SB)!=0){ invariant_failures=invariant_failures+1; } } write(PIVOTFILE,string(step)+"|"+string(pi)+"|"+string(pj)+"|"+string(B[step,step])); pivot_count=pivot_count+1; step=step+1; } }

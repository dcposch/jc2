ring f=(0,a,b),(z),dp;
matrix MF[2][3]=1,0,a/b,0,1,0;
module KF=syz(module(MF));
matrix NF=matrix(KF);
matrix RF=MF*NF;
print("TINY_FIELD_NROWS="+string(nrows(NF))+" NCOLS="+string(ncols(NF)));
print("TINY_FIELD_KERNEL="+string(NF));
print("TINY_FIELD_REPLAY_MATRIX="+string(RF));
print("TINY_FIELD_REPLAY_SIZE="+string(size(module(RF))));
print("TINY_FIELD_REPLAY="+string(size(module(RF))==0));
poly EF=NF[1,1]*NF[2,1]+NF[3,1]^2;
number DF=denominator(leadcoef(NF[1,1]));
print("TINY_FIELD_ENDPOINT="+string(EF));
print("TINY_FIELD_DENOMINATOR="+string(DF));
ring a=0,(u,v),dp;
poly F=u;
ideal J=F;
qring q=std(J);
matrix MQ[2][3]=1,0,v,0,1,0;
module KQ=syz(module(MQ));
matrix NQ=matrix(KQ);
matrix RQ=MQ*NQ;
print("TINY_QRING_NROWS="+string(nrows(NQ))+" NCOLS="+string(ncols(NQ)));
print("TINY_QRING_RELATION="+string(F==0));
print("TINY_QRING_REPLAY="+string(size(module(RQ))==0));
poly C=NQ[1,1]*NQ[2,1]+NQ[3,1]^2;
print("TINY_QRING_PULLBACK_DEFINED="+string(C==C));
quit;

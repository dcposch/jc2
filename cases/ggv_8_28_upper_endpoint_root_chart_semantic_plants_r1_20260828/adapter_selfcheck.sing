// Tiny exact saturation/reducer/parser fixture.
ring ambient=0,(q0,q2,c6),dp;
LIB "elim.lib";
ideal NIL_IDEAL=q2^2;
poly NIL_DELTA=q2;
list NIL_SAT_RESULT=sat(NIL_IDEAL,ideal(NIL_DELTA));
print("SELFTEST_SATURATION_OBJECT_TYPE="+typeof(NIL_SAT_RESULT));
print("SELFTEST_SATURATION_OBJECT_SIZE="+string(size(NIL_SAT_RESULT)));
if(typeof(NIL_SAT_RESULT)!="list" || size(NIL_SAT_RESULT)!=1)
{
  print("FATAL_SELFTEST_SATURATION_OBJECT_SHAPE");
  quit;
}
print("SELFTEST_SATURATION_SLOT1_TYPE="+typeof(NIL_SAT_RESULT[1]));
if(typeof(NIL_SAT_RESULT[1])!="ideal")
{
  print("FATAL_SELFTEST_SATURATION_SLOT1_TYPE");
  quit;
}
ideal NIL_SAT_SB=std(NIL_SAT_RESULT[1]);
poly NIL_SAT_UNIT_NF=reduce(1,NIL_SAT_SB);
poly NIL_POWER=1;
poly NIL_POWER_NF=1;
int NIL_POWER_FOUND=0;
int NIL_POWER_EXPONENT=-1;
int ek;
for(ek=0;ek<=8;ek=ek+1)
{
  if(NIL_POWER_FOUND==0)
  {
    NIL_POWER_NF=reduce(NIL_POWER,std(NIL_IDEAL));
    if(NIL_POWER_NF==0)
    {
      NIL_POWER_FOUND=1;
      NIL_POWER_EXPONENT=ek;
    }
    else
    {
      NIL_POWER=reduce(NIL_POWER*NIL_DELTA,std(NIL_IDEAL));
    }
  }
}
if(NIL_SAT_UNIT_NF!=0)
{
  print("FATAL_NILPOTENT_OPEN_FIXTURE");
  quit;
}
if(NIL_POWER_FOUND!=1 || NIL_POWER_EXPONENT!=2 || NIL_POWER_NF!=0)
{
  print("FATAL_NILPOTENT_POWER_CERTIFICATE");
  quit;
}
ideal PROPER_IDEAL=q0*q2;
poly PROPER_DELTA=q0;
list PROPER_SAT_RESULT=sat(PROPER_IDEAL,ideal(PROPER_DELTA));
ideal PROPER_SAT_SB=std(PROPER_SAT_RESULT[1]);
poly PROPER_SAT_UNIT_NF=reduce(1,PROPER_SAT_SB);
poly PROPER_Q2_NF=reduce(q2,PROPER_SAT_SB);
list PROPER_STABLE_RESULT=sat(PROPER_SAT_SB,ideal(PROPER_DELTA));
if(typeof(PROPER_STABLE_RESULT)!="list" || size(PROPER_STABLE_RESULT)!=1 || typeof(PROPER_STABLE_RESULT[1])!="ideal")
{
  print("FATAL_PROPER_STABILITY_OBJECT");
  quit;
}
ideal PROPER_STABLE_SB=std(PROPER_STABLE_RESULT[1]);
int si;
int PROPER_STABILITY_FAILURES=0;
for(si=1;si<=size(PROPER_SAT_SB);si=si+1)
{
  if(reduce(PROPER_SAT_SB[si],PROPER_STABLE_SB)!=0)
  {
    PROPER_STABILITY_FAILURES=PROPER_STABILITY_FAILURES+1;
  }
}
for(si=1;si<=size(PROPER_STABLE_SB);si=si+1)
{
  if(reduce(PROPER_STABLE_SB[si],PROPER_SAT_SB)!=0)
  {
    PROPER_STABILITY_FAILURES=PROPER_STABILITY_FAILURES+1;
  }
}
if(PROPER_SAT_UNIT_NF==0 || PROPER_Q2_NF!=0)
{
  print("FATAL_PROPER_OPEN_FIXTURE");
  quit;
}
ideal NEXT_IDEAL=PROPER_IDEAL,PROPER_DELTA;
ideal NEXT_SB=std(NEXT_IDEAL);
poly NEXT_Q0_NF=reduce(q0,NEXT_SB);
poly NEXT_UNIT_NF=reduce(1,NEXT_SB);
if(NEXT_Q0_NF!=0 || NEXT_UNIT_NF==0)
{
  print("FATAL_CLOSED_SUCCESSOR_FIXTURE");
  quit;
}
matrix R[2][2]=q0,1,q2,q0;
matrix S[1][1]=R[1,2];
poly DELTA_NF=reduce(det(S),PROPER_SAT_SB);
poly SELFTEST_ENDPOINT_ZERO_NF=reduce(q2,PROPER_SAT_SB);
poly SELFTEST_ENDPOINT_PLUS_ONE_NF=reduce(SELFTEST_ENDPOINT_ZERO_NF+1,PROPER_SAT_SB);
poly SELFTEST_BORDERED_PLANT_NF=reduce(SELFTEST_ENDPOINT_ZERO_NF+DELTA_NF,PROPER_SAT_SB);
if(DELTA_NF!=1)
{
  print("FATAL_MINOR_FIXTURE");
  quit;
}
if(SELFTEST_ENDPOINT_ZERO_NF!=0 || SELFTEST_ENDPOINT_PLUS_ONE_NF!=1)
{
  print("FATAL_SELFTEST_ENDPOINT_PLUS_ONE_PLANT");
  quit;
}
if(SELFTEST_BORDERED_PLANT_NF==0 || SELFTEST_BORDERED_PLANT_NF!=DELTA_NF)
{
  print("FATAL_SELFTEST_BORDERED_NONZERO_PLANT");
  quit;
}
print("SELFTEST_NILPOTENT_OPEN_EMPTY="+string(NIL_SAT_UNIT_NF==0));
print("SELFTEST_EMPTY_POWER_CERTIFICATE="+string(NIL_POWER_FOUND));
print("SELFTEST_EMPTY_POWER_EXPONENT="+string(NIL_POWER_EXPONENT));
print("SELFTEST_PROPER_OPEN_SATURATION="+string(PROPER_SAT_UNIT_NF!=0));
print("SELFTEST_PROPER_SATURATION_STABILITY_FAILURES="+string(PROPER_STABILITY_FAILURES));
print("SELFTEST_CLOSED_SUCCESSOR_PROPER="+string(NEXT_UNIT_NF!=0));
print("SELFTEST_MINOR_NF_NONZERO="+string(DELTA_NF!=0));
print("SELFTEST_ENDPOINT_PLUS_ONE_PLANT_NONZERO="+string(SELFTEST_ENDPOINT_PLUS_ONE_NF!=0));
print("SELFTEST_BORDERED_NONZERO_PLANT_EQUALS_DELTA="+string(SELFTEST_BORDERED_PLANT_NF==DELTA_NF));
print("ENDPOINT_COMPLEMENT_ADAPTER_SELFCHECK_PASS=1");
quit;

if (reduce(1,H)==0)
{
  print("D1_DOUBLE_ROOT_TORIC_H_IS_UNIT=1");
}
else
{
  print("D1_DOUBLE_ROOT_TORIC_H_IS_UNIT=0");
  print("H_BASIS_BEGIN");
  H;
  print("H_BASIS_END");
}
print("FIREWALL=UNIT_EXCLUDES_THIS_CHART;NONUNIT_IS_ONLY_A_TOTAL_LOAD_SPACE_SURVIVOR");
print("PASS_D1_DOUBLE_ROOT_TORIC_B");

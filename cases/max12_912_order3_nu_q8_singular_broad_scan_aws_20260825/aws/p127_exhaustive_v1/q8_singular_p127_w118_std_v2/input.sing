ring R=127,(c,d2,d4,x1,x3,x5,inv,v),(dp(7),dp(1));
option(redSB);
poly e1=-472/9*c*d4^2-8/9*c*x3*x5+4/3*c*x5^2+4/9*d2*x3-8/9*d2*x5+4/9*d4*x1-8/9*d4*x3-4/27*d4*x5^2+4/3*d4*x5+4/9*x5;
poly e3=472/3*c^2*d4*x5-944/9*c*d2*d4+3776/27*c*d4^2-8/9*c*x1*x5-4/9*c*x3^2+64/27*c*x3*x5+20/81*c*x5^3-20/9*c*x5^2+4/9*d2*x1-20/27*d2*x3-4/27*d2*x5^2+28/27*d2*x5-472/81*d4^3-20/27*d4*x1-8/27*d4*x3*x5+28/27*d4*x3+56/81*d4*x5^2-4/3*d4*x5+4/9*x3-20/27*x5;
poly e5=-472/9*c^3*x5^2+2360/27*c^2*d2*x5+2360/27*c^2*d4*x3-2360/9*c^2*d4*x5-944/27*c*d2^2+3776/27*c*d2*d4+1888/27*c*d4^2*x5-8968/81*c*d4^2-1888/27*c*d4-16/27*c*x1*x3+32/27*c*x1*x5+16/27*c*x3^2+44/81*c*x3*x5^2-152/81*c*x3*x5-224/243*c*x5^3+4/3*c*x5^2-472/27*d2*d4^2-4/9*d2*x1-20/81*d2*x3*x5+40/81*d2*x3+40/81*d2*x5^2-44/81*d2*x5+1888/81*d4^3-20/81*d4*x1*x5+40/81*d4*x1-4/27*d4*x3^2+88/81*d4*x3*x5-44/81*d4*x3+16/243*d4*x5^3-328/243*d4*x5^2+16/27*d4*x5+4/9*x1-4/9*x3-8/81*x5^2+40/81*x5;
poly e7=-111392/81*c^3*d4^2-1888/81*c^3*x3*x5+944/27*c^3*x5^2+2360/81*c^2*d2*x3-5192/81*c^2*d2*x5+2360/81*c^2*d4*x1-5192/81*c^2*d4*x3-19352/243*c^2*d4*x5^2+944/9*c^2*d4*x5+2360/81*c^2*x5+1888/81*c*d2^2+1888/27*c*d2*d4*x5-4720/81*c*d2*d4-944/27*c*d2+944/27*c*d4^2*x3-12272/81*c*d4^2*x5+24544/729*c*d4^2+3776/81*c*d4-4/27*c*x1^2+32/81*c*x1*x3+20/81*c*x1*x5^2-40/81*c*x1*x5+8/27*c*x3^2*x5-20/81*c*x3^2-304/243*c*x3*x5^2+416/729*c*x3*x5-40/729*c*x5^4+820/729*c*x5^3-76/243*c*x5^2-944/81*d2^2*d4+944/27*d2*d4^2-4/27*d2*x1*x5+4/27*d2*x1-8/81*d2*x3^2+136/243*d2*x3*x5-100/729*d2*x3+8/243*d2*x5^3-140/243*d2*x5^2+92/729*d2*x5+944/243*d4^3*x5-6136/243*d4^3-472/81*d4^2-4/27*d4*x1*x3+112/243*d4*x1*x5-100/729*d4*x1+8/27*d4*x3^2+8/81*d4*x3*x5^2-296/243*d4*x3*x5+92/729*d4*x3-152/729*d4*x5^3+2368/2187*d4*x5^2-28/243*d4*x5-4/27*x1-8/81*x3*x5+4/27*x3+40/243*x5^2-100/729*x5;
poly e2=236/3*c^2*x5^2-944/9*c*d2*x5-944/9*c*d4*x3+944/3*c*d4*x5+236/9*d2^2-944/9*d2*d4-472/27*d4^2*x5+236/3*d4^2+472/9*d4+4/9*x1*x3-8/9*x1*x5-4/9*x3^2-4/27*x3*x5^2+4/3*x3*x5+20/81*x5^3-8/9*x5^2;
poly e4=194936/27*c^2*d4^2+3304/27*c^2*x3*x5-1888/9*c^2*x5^2-2360/27*c*d2*x3+1888/9*c*d2*x5-2360/27*c*d4*x1+1888/9*c*d4*x3+6608/81*c*d4*x5^2-3304/9*c*d4*x5-2360/27*c*x5-944/27*d2^2-944/27*d2*d4*x5+2360/27*d2*d4+472/9*d2-472/27*d4^2*x3+6136/81*d4^2*x5-472/9*d4^2-1888/27*d4+2/9*x1^2-16/27*x1*x3-4/27*x1*x5^2+20/27*x1*x5-4/27*x3^2*x5+10/27*x3^2+52/81*x3*x5^2-8/9*x3*x5+5/243*x5^4-140/243*x5^3+14/27*x5^2;
poly einv=inv*x5*(x3-2*x5)-1;
poly ev=v*x5-x3+2*x5;
ideal I=e1,e3,e5,e7,e2,e4,einv,ev;
ideal G=std(I);
print("Q8-FIXED-W-FIBRE");
print("prime=127");
print("w_value=118");
print("fibre_dim="+string(dim(G)));
print("fibre_size="+string(size(G)));
print("fibre_vdim="+string(vdim(G)));
ideal E=eliminate(G,c*d2*d4*x1*x3*x5*inv);
E=std(E);
print("v_elimination_size="+string(size(E)));
if (size(E)==1)
{
  poly H=E[1]/leadcoef(E[1]);
  print("v_eliminant_degree="+string(deg(H)));
  poly Hsquarefree=gcd(H,diff(H,v));
  print("v_eliminant_squarefree_gcd_degree="+string(deg(Hsquarefree)));
  list RF=factorize(H,1);
  print("rational_factor_entries="+string(size(RF[1])));
  RF;
}

ring R=127,(c,d2,d4,x1,x3,x5,inv,v),(dp(7),dp(1));
option(redSB);
poly e1=-48*c*d4^2-8/9*c*x3*x5+4/3*c*x5^2+4/9*d2*x3-8/9*d2*x5+4/9*d4*x1-8/9*d4*x3-4/27*d4*x5^2+4/3*d4*x5+4/9*x5;
poly e3=144*c^2*d4*x5-96*c*d2*d4+128*c*d4^2-8/9*c*x1*x5-4/9*c*x3^2+64/27*c*x3*x5+20/81*c*x5^3-20/9*c*x5^2+4/9*d2*x1-20/27*d2*x3-4/27*d2*x5^2+28/27*d2*x5-16/3*d4^3-20/27*d4*x1-8/27*d4*x3*x5+28/27*d4*x3+56/81*d4*x5^2-4/3*d4*x5+4/9*x3-20/27*x5;
poly e5=-48*c^3*x5^2+80*c^2*d2*x5+80*c^2*d4*x3-240*c^2*d4*x5-32*c*d2^2+128*c*d2*d4+64*c*d4^2*x5-304/3*c*d4^2-64*c*d4-16/27*c*x1*x3+32/27*c*x1*x5+16/27*c*x3^2+44/81*c*x3*x5^2-152/81*c*x3*x5-224/243*c*x5^3+4/3*c*x5^2-16*d2*d4^2-4/9*d2*x1-20/81*d2*x3*x5+40/81*d2*x3+40/81*d2*x5^2-44/81*d2*x5+64/3*d4^3-20/81*d4*x1*x5+40/81*d4*x1-4/27*d4*x3^2+88/81*d4*x3*x5-44/81*d4*x3+16/243*d4*x5^3-328/243*d4*x5^2+16/27*d4*x5+4/9*x1-4/9*x3-8/81*x5^2+40/81*x5;
poly e7=-1152*c^3*d4^2-64/3*c^3*x3*x5+32*c^3*x5^2+80/3*c^2*d2*x3-176/3*c^2*d2*x5+80/3*c^2*d4*x1-176/3*c^2*d4*x3-656/9*c^2*d4*x5^2+96*c^2*d4*x5+80/3*c^2*x5+64/3*c*d2^2+64*c*d2*d4*x5-160/3*c*d2*d4-32*c*d2+32*c*d4^2*x3-416/3*c*d4^2*x5+832/27*c*d4^2+128/3*c*d4-4/27*c*x1^2+32/81*c*x1*x3+20/81*c*x1*x5^2-40/81*c*x1*x5+8/27*c*x3^2*x5-20/81*c*x3^2-304/243*c*x3*x5^2+416/729*c*x3*x5-40/729*c*x5^4+820/729*c*x5^3-76/243*c*x5^2-32/3*d2^2*d4+32*d2*d4^2-4/27*d2*x1*x5+4/27*d2*x1-8/81*d2*x3^2+136/243*d2*x3*x5-100/729*d2*x3+8/243*d2*x5^3-140/243*d2*x5^2+92/729*d2*x5+32/9*d4^3*x5-208/9*d4^3-16/3*d4^2-4/27*d4*x1*x3+112/243*d4*x1*x5-100/729*d4*x1+8/27*d4*x3^2+8/81*d4*x3*x5^2-296/243*d4*x3*x5+92/729*d4*x3-152/729*d4*x5^3+2368/2187*d4*x5^2-28/243*d4*x5-4/27*x1-8/81*x3*x5+4/27*x3+40/243*x5^2-100/729*x5;
poly e2=72*c^2*x5^2-96*c*d2*x5-96*c*d4*x3+288*c*d4*x5+24*d2^2-96*d2*d4-16*d4^2*x5+72*d4^2+48*d4+4/9*x1*x3-8/9*x1*x5-4/9*x3^2-4/27*x3*x5^2+4/3*x3*x5+20/81*x5^3-8/9*x5^2;
poly e4=6048*c^2*d4^2+112*c^2*x3*x5-192*c^2*x5^2-80*c*d2*x3+192*c*d2*x5-80*c*d4*x1+192*c*d4*x3+224/3*c*d4*x5^2-336*c*d4*x5-80*c*x5-32*d2^2-32*d2*d4*x5+80*d2*d4+48*d2-16*d4^2*x3+208/3*d4^2*x5-48*d4^2-64*d4+2/9*x1^2-16/27*x1*x3-4/27*x1*x5^2+20/27*x1*x5-4/27*x3^2*x5+10/27*x3^2+52/81*x3*x5^2-8/9*x3*x5+5/243*x5^4-140/243*x5^3+14/27*x5^2;
poly einv=inv*x5*(x3-2*x5)-1;
poly ev=v*x5-x3+2*x5;
ideal I=e1,e3,e5,e7,e2,e4,einv,ev;
ideal G=std(I);
print("Q8-FIXED-W-FIBRE");
print("prime=127");
print("w_value=108");
print("fibre_dim="+string(dim(G)));
print("fibre_size="+string(size(G)));
print("fibre_vdim="+string(vdim(G)));
ideal E=eliminate(G,c*d2*d4*x1*x3*x5*inv);
E=std(E);
print("v_elimination_size="+string(size(E)));
if (size(E)==1)
{
  poly H=E[1]/leadcoef(E[1]);
  print("v_eliminant_degree="+string(deg(H)));
  poly Hsquarefree=gcd(H,diff(H,v));
  print("v_eliminant_squarefree_gcd_degree="+string(deg(Hsquarefree)));
  list RF=factorize(H,1);
  print("rational_factor_entries="+string(size(RF[1])));
  RF;
}

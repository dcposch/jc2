proc powMod(poly base,int exponent,ideal G)
{
  poly result=1;
  poly power=reduce(base,G);
  int e=exponent;
  int half;
  while(e>0)
  {
    half=e div 2;
    if(e-2*half==1){result=reduce(result*power,G);}
    e=half;
    if(e>0){power=reduce(power*power,G);}
  }
  return(result);
}
proc countFiber(number ww)
{
  poly h=buildH(ww);
  if(deg(h)!=190){print("FIBRE_DEGREE_FAILURE");exit;}
  poly hv=diff(h,v);
  poly hw=buildHw(ww);
  ideal G=h;
  G=std(G);
  poly frob=powMod(v,16129,G)-v;
  poly rationalRoots=gcd(h,frob);
  poly singularRoots=gcd(gcd(rationalRoots,hv),hw);
  int total=deg(rationalRoots);
  int singular=deg(singularRoots);
  int smooth=total-singular;
  if(total<0 || singular<0 || smooth<0){print("NEGATIVE_COUNT_FAILURE");exit;}
  return(list(total,smooth,singular));
}

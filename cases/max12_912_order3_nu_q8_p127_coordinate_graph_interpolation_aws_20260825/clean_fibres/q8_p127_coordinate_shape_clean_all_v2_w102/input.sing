ring R=127,(c,d2,d4,x1,x3,x5,inv,v),lp;
option(redSB);
poly e1=-136/3*c*d4^2-8/9*c*x3*x5+4/3*c*x5^2+4/9*d2*x3-8/9*d2*x5+4/9*d4*x1-8/9*d4*x3-4/27*d4*x5^2+4/3*d4*x5+4/9*x5;
poly e3=136*c^2*d4*x5-272/3*c*d2*d4+1088/9*c*d4^2-8/9*c*x1*x5-4/9*c*x3^2+64/27*c*x3*x5+20/81*c*x5^3-20/9*c*x5^2+4/9*d2*x1-20/27*d2*x3-4/27*d2*x5^2+28/27*d2*x5-136/27*d4^3-20/27*d4*x1-8/27*d4*x3*x5+28/27*d4*x3+56/81*d4*x5^2-4/3*d4*x5+4/9*x3-20/27*x5;
poly e5=-136/3*c^3*x5^2+680/9*c^2*d2*x5+680/9*c^2*d4*x3-680/3*c^2*d4*x5-272/9*c*d2^2+1088/9*c*d2*d4+544/9*c*d4^2*x5-2584/27*c*d4^2-544/9*c*d4-16/27*c*x1*x3+32/27*c*x1*x5+16/27*c*x3^2+44/81*c*x3*x5^2-152/81*c*x3*x5-224/243*c*x5^3+4/3*c*x5^2-136/9*d2*d4^2-4/9*d2*x1-20/81*d2*x3*x5+40/81*d2*x3+40/81*d2*x5^2-44/81*d2*x5+544/27*d4^3-20/81*d4*x1*x5+40/81*d4*x1-4/27*d4*x3^2+88/81*d4*x3*x5-44/81*d4*x3+16/243*d4*x5^3-328/243*d4*x5^2+16/27*d4*x5+4/9*x1-4/9*x3-8/81*x5^2+40/81*x5;
poly e7=-9248/9*c^3*d4^2-544/27*c^3*x3*x5+272/9*c^3*x5^2+680/27*c^2*d2*x3-1496/27*c^2*d2*x5+680/27*c^2*d4*x1-1496/27*c^2*d4*x3-5576/81*c^2*d4*x5^2+272/3*c^2*d4*x5+680/27*c^2*x5+544/27*c*d2^2+544/9*c*d2*d4*x5-1360/27*c*d2*d4-272/9*c*d2+272/9*c*d4^2*x3-3536/27*c*d4^2*x5+7072/243*c*d4^2+1088/27*c*d4-4/27*c*x1^2+32/81*c*x1*x3+20/81*c*x1*x5^2-40/81*c*x1*x5+8/27*c*x3^2*x5-20/81*c*x3^2-304/243*c*x3*x5^2+416/729*c*x3*x5-40/729*c*x5^4+820/729*c*x5^3-76/243*c*x5^2-272/27*d2^2*d4+272/9*d2*d4^2-4/27*d2*x1*x5+4/27*d2*x1-8/81*d2*x3^2+136/243*d2*x3*x5-100/729*d2*x3+8/243*d2*x5^3-140/243*d2*x5^2+92/729*d2*x5+272/81*d4^3*x5-1768/81*d4^3-136/27*d4^2-4/27*d4*x1*x3+112/243*d4*x1*x5-100/729*d4*x1+8/27*d4*x3^2+8/81*d4*x3*x5^2-296/243*d4*x3*x5+92/729*d4*x3-152/729*d4*x5^3+2368/2187*d4*x5^2-28/243*d4*x5-4/27*x1-8/81*x3*x5+4/27*x3+40/243*x5^2-100/729*x5;
poly e2=68*c^2*x5^2-272/3*c*d2*x5-272/3*c*d4*x3+272*c*d4*x5+68/3*d2^2-272/3*d2*d4-136/9*d4^2*x5+68*d4^2+136/3*d4+4/9*x1*x3-8/9*x1*x5-4/9*x3^2-4/27*x3*x5^2+4/3*x3*x5+20/81*x5^3-8/9*x5^2;
poly e4=16184/3*c^2*d4^2+952/9*c^2*x3*x5-544/3*c^2*x5^2-680/9*c*d2*x3+544/3*c*d2*x5-680/9*c*d4*x1+544/3*c*d4*x3+1904/27*c*d4*x5^2-952/3*c*d4*x5-680/9*c*x5-272/9*d2^2-272/9*d2*d4*x5+680/9*d2*d4+136/3*d2-136/9*d4^2*x3+1768/27*d4^2*x5-136/3*d4^2-544/9*d4+2/9*x1^2-16/27*x1*x3-4/27*x1*x5^2+20/27*x1*x5-4/27*x3^2*x5+10/27*x3^2+52/81*x3*x5^2-8/9*x3*x5+5/243*x5^4-140/243*x5^3+14/27*x5^2;
poly einv=inv*x5*(x3-2*x5)-1;
poly ev=v*x5-x3+2*x5;
ideal I=e1,e3,e5,e7,e2,e4,einv,ev;
LIB "standard.lib";
ideal G=stdfglm(I,"std");
print("Q8-P127-LEX-COORDINATE-RECONSTRUCTION-CLEAN");
print("w_value=102");
print("shape_basis_begin");
G;
print("shape_basis_end");
ideal original_remainders=reduce(I,G);
print("original_remainders_begin");
original_remainders;
print("original_remainders_end");
print("Q8-FIXED-W-FIBRE");
print("prime=127");
print("w_value=102");
print("fibre_dim="+string(dim(G)));
print("fibre_size="+string(size(G)));
print("fibre_vdim="+string(vdim(G)));
ideal E=eliminate(G,c*d2*d4*x1*x3*x5*inv);
E=std(E);
print("v_elimination_size="+string(size(E)));
if (size(E)==1)
{
  poly H=E[1]/leadcoef(E[1]);
  print("v_eliminant_degree="+string(deg(H)));
  poly Hsquarefree=gcd(H,diff(H,v));
  print("v_eliminant_squarefree_gcd_degree="+string(deg(Hsquarefree)));
  list RF=factorize(H,1);
  print("rational_factor_entries="+string(size(RF[1])));
  RF;
}

// Independent p=3 CAS audit of the generic Cartier coefficient and control.
ring r=3,(u1_0,u1_1,v1_0,v1_1,
          u2_0,u2_1,u2_2,v2_0,v2_1,v2_2,
          u3_0,u3_1,u3_2,u3_3,v3_0,v3_1,v3_2,v3_3,
          u4_0,u4_1,u4_2,u4_3,u4_4,v4_0,v4_1,v4_2,v4_3,v4_4,
          u5_0,u5_1,u5_2,u5_3,u5_4,u5_5,
          v5_0,v5_1,v5_2,v5_3,v5_4,v5_5,x,y),dp;
poly U=
 u1_0*y+u1_1*x
 +u2_0*y^2+u2_1*x*y+u2_2*x^2
 +u3_0*y^3+u3_1*x*y^2+u3_2*x^2*y+u3_3*x^3
 +u4_0*y^4+u4_1*x*y^3+u4_2*x^2*y^2+u4_3*x^3*y+u4_4*x^4
 +u5_0*y^5+u5_1*x*y^4+u5_2*x^2*y^3+u5_3*x^3*y^2
 +u5_4*x^4*y+u5_5*x^5;
poly V=
 v1_0*y+v1_1*x
 +v2_0*y^2+v2_1*x*y+v2_2*x^2
 +v3_0*y^3+v3_1*x*y^2+v3_2*x^2*y+v3_3*x^3
 +v4_0*y^4+v4_1*x*y^3+v4_2*x^2*y^2+v4_3*x^3*y+v4_4*x^4
 +v5_0*y^5+v5_1*x*y^4+v5_2*x^2*y^3+v5_3*x^3*y^2
 +v5_4*x^4*y+v5_5*x^5;
poly K=(diff(U,x)-x^2)*diff(V,y)-diff(U,y)*diff(V,x);
poly c=diff(diff(diff(diff(K,x),x),y),y);
c=subst(subst(c,x,0),y,0);
if (c!=0) { print("FAIL generic Cartier coefficient"); exit(1); }
poly Uc=x^3;
poly Vc=x^2*y;
poly Kc=(diff(Uc,x)-x^2)*diff(Vc,y)-diff(Uc,y)*diff(Vc,x);
if (Kc+ x^4!=0) { print("FAIL nonzero control"); exit(1); }
print("generic_cartier_coefficient:"); print(c);
print("nonzero_control_K:"); print(Kc);
print("PASS-SINGULAR-FIRST-CARRY-CARTIER-ZERO");


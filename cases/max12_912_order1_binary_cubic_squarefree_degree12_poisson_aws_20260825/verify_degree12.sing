// Original-bracket replay for the squarefree degree-12 recurrence.
ring R0=0,
  (x,y,
   a0,a1,a2,l0,l1,m0,m1,m2,m3,
   u0,u1,u2,u3,u4,u5,
   v0,v1,v2,v3,v4,z0,z1,z2,z3,
   yy0,yy1,yy2,lam,mu),dp;

proc PB(poly f, poly g)
{
  return(diff(f,x)*diff(g,y)-diff(f,y)*diff(g,x));
}

poly K=x*y*(x-y);
poly A=a0*y2+a1*x*y+a2*x2;
poly L=l0*y+l1*x;
poly M=m0*y3+m1*x*y2+m2*x2*y+m3*x3;
poly U=u0*y5+u1*x*y4+u2*x2*y3+u3*x3*y2+u4*x4*y+u5*x5;
poly V=v0*y4+v1*x*y3+v2*x2*y2+v3*x3*y+v4*x4;
poly Pthree=z0*y3+z1*x*y2+z2*x2*y+z3*x3;
poly Ytwo=yy0*y2+yy1*x*y+yy2*x2;

poly BB=(1/3)*A^2+K*L;
poly T=K*M+(1/3)*A*BB-(2/27)*A^3;
poly N=M-(1/3)*A*L;
poly Rfive=9*U-A^2*L-3*A*N-3*K*L^2;

poly P9=K^3;
poly P8=K^2*A;
poly P7=K*BB;
poly P6=T;
poly P5=U;
poly P4=V;
poly P3=Pthree;
poly P2=Ytwo;

poly Q12=K^4;
poly Q11=(4/3)*K^3*A;
poly Q10=(4/3)*K^2*BB+(2/9)*K^2*A^2;
poly Q9=(4/3)*K*T+(4/9)*K*A*BB-(4/81)*K*A^3+(lam/3)*K^3;
poly Q8=(4/3)*K*U+(4/9)*A*T-(4/27)*A^2*BB
        +(2/9)*BB^2+(5/243)*A^4+(lam/3)*K^2*A;
poly Q7=(4/3)*K*V+(4/9)*A*U+(4/9)*K*L*M+(lam/3)*K*BB;
poly Q6=(4/3)*K*Pthree+(4/9)*A*V+(4/9)*L*U
        +(2/9)*M^2-(4/27)*A*L*M-(4/81)*K*L^3
        +(lam/3)*T+mu*K^2;

// K*Q5, so the sole possible denominator is explicit.
poly N5=(4/3)*K^2*Ytwo+(4/9)*K*A*Pthree+(4/9)*K*L*V
        -(4/243)*K*A*L^3+(4/81)*N*Rfive
        +(lam/3)*K*U+(2*mu/3)*K^2*A;

poly Other12=PB(P8,Q6)+PB(P7,Q7)+PB(P6,Q8)+PB(P5,Q9)
             +PB(P4,Q10)+PB(P3,Q11)+PB(P2,Q12);
// [K^3,N5/K]=3*K*[K,N5].
poly E12cleared=3*K*PB(K,N5)+Other12;
if (E12cleared!=0)
{
  print("FAIL_RATIONAL_DEGREE12_ORIGINAL_ROW"); quit;
}

poly ExpandedPole=27*N*U-A*K*L^3-3*A^2*L*N-9*K*L^2*N-9*A*N^2;
poly FactoredPole=3*N*Rfive-A*K*L^3;
if (ExpandedPole-FactoredPole!=0)
{
  print("FAIL_DEGREE12_POLE_FACTORIZATION"); quit;
}

print("RATIONAL_DEGREE12_CLEARED_ORIGINAL_ROW_ZERO");
print("DEGREE12_POLE_FACTORIZATION_ZERO");
print("ROOT_ALLOCATION_BRANCH_COUNT 8");
print("PREDICTED_REDUCED_BASE_DIMENSION 23");
print("FRESH_P2_DIMENSION 3");
print("PREDICTED_REDUCED_FULL_DIMENSION 26");
print("PASS_DEGREE12");
quit;

ring r=(3,h),(P,Q,fa,fb,fv,s,w),lp;
LIB "primdec.lib";
option(redSB);
ideal I=
  s^3*h^3+P*s*fa,
  -s^2*h^3*fv+P*s*fa/h^3+P*s*h*fv+Q*s*fa+P*w*fa+P*s*fb,
  s*w*h^3*fv+Q*s*fa/h^3+P*w*fa/h^3+h^2*fa*fv^2+Q*s*h*fv+P*w*h*fv-h*fa*fb*fv-P*h*fv^2+Q*w*fa+Q*s*fb+P*w*fb+fa*fb^2-P*fb*fv,
  w^3*h^3-w^2*h^3*fv+Q*w*fa/h^3+Q*w*h*fv-Q*h*fv^2+Q*w*fb-Q*fb*fv;
list L=minAssGTZ(I);
print("minass_count");size(L);
if(size(L)!=8){print("FAIL-localized-count");quit;}
ideal G6=s,fa,fv-w;
ideal G8=s,w,fb+h*fv;
int i; int d3=0; int d4=0; int seenG6=0; int seenG8=0;
for(i=1;i<=size(L);i++){
  ideal J=std(L[i]);
  if(dim(J)==3){d3++;}
  if(dim(J)==4){d4++;}
  if(size(reduce(J,std(G6)))==0 && size(reduce(std(G6),J))==0){seenG6++;}
  if(size(reduce(J,std(G8)))==0 && size(reduce(std(G8),J))==0){seenG8++;}
  print("component");i;size(J);dim(J);J;
}
print("localized_dimension_counts");d3;d4;
if(d3!=6 || d4!=2){print("FAIL-localized-dimensions");quit;}
print("identified_dimension4_linear_components");seenG6;seenG8;
if(seenG6!=1 || seenG8!=1){print("FAIL-localized-linear-identification");quit;}
print("PASS-D7-HGENERIC-BASE-SL");
quit;

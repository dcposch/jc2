LIB "primdec.lib";
ring R=127,(c,d2,d4,x1,x3,x5,inv,inu,iq,v),(dp(9),dp(1));
option(redSB);
poly e1=-8/9*c*x3*x5+4/3*c*x5^2+4/9*d2*x3-8/9*d2*x5+4/9*d4*x1-8/9*d4*x3-4/27*d4*x5^2+4/3*d4*x5+4/9*x5;
poly e3=-8/9*c*x1*x5-4/9*c*x3^2+64/27*c*x3*x5+20/81*c*x5^3-20/9*c*x5^2+4/9*d2*x1-20/27*d2*x3-4/27*d2*x5^2+28/27*d2*x5-20/27*d4*x1-8/27*d4*x3*x5+28/27*d4*x3+56/81*d4*x5^2-4/3*d4*x5+4/9*x3-20/27*x5;
poly e5=-16/27*c*x1*x3+32/27*c*x1*x5+16/27*c*x3^2+44/81*c*x3*x5^2-152/81*c*x3*x5-224/243*c*x5^3+4/3*c*x5^2-4/9*d2*x1-20/81*d2*x3*x5+40/81*d2*x3+40/81*d2*x5^2-44/81*d2*x5-20/81*d4*x1*x5+40/81*d4*x1-4/27*d4*x3^2+88/81*d4*x3*x5-44/81*d4*x3+16/243*d4*x5^3-328/243*d4*x5^2+16/27*d4*x5+4/9*x1-4/9*x3-8/81*x5^2+40/81*x5;
poly e7=-4/27*c*x1^2+32/81*c*x1*x3+20/81*c*x1*x5^2-40/81*c*x1*x5+8/27*c*x3^2*x5-20/81*c*x3^2-304/243*c*x3*x5^2+416/729*c*x3*x5-40/729*c*x5^4+820/729*c*x5^3-76/243*c*x5^2-4/27*d2*x1*x5+4/27*d2*x1-8/81*d2*x3^2+136/243*d2*x3*x5-100/729*d2*x3+8/243*d2*x5^3-140/243*d2*x5^2+92/729*d2*x5-4/27*d4*x1*x3+112/243*d4*x1*x5-100/729*d4*x1+8/27*d4*x3^2+8/81*d4*x3*x5^2-296/243*d4*x3*x5+92/729*d4*x3-152/729*d4*x5^3+2368/2187*d4*x5^2-28/243*d4*x5-4/27*x1-8/81*x3*x5+4/27*x3+40/243*x5^2-100/729*x5;
poly e2=4/9*x1*x3-8/9*x1*x5-4/9*x3^2-4/27*x3*x5^2+4/3*x3*x5+20/81*x5^3-8/9*x5^2;
poly e4=2/9*x1^2-16/27*x1*x3-4/27*x1*x5^2+20/27*x1*x5-4/27*x3^2*x5+10/27*x3^2+52/81*x3*x5^2-8/9*x3*x5+5/243*x5^4-140/243*x5^3+14/27*x5^2;
poly e6=-4/27*x1^2-16/81*x1*x3*x5+8/27*x1*x3+28/81*x1*x5^2-8/27*x1*x5-4/81*x3^3+4/9*x3^2*x5-4/27*x3^2+4/81*x3*x5^3-80/81*x3*x5^2+8/27*x3*x5-20/243*x5^4+152/243*x5^3-4/27*x5^2;
poly e8=-4/81*x1^2*x5+2/81*x1^2-4/81*x1*x3^2+64/243*x1*x3*x5-32/729*x1*x3+4/243*x1*x5^3-20/81*x1*x5^2+28/729*x1*x5+4/81*x3^3+2/81*x3^2*x5^2-68/243*x3^2*x5+14/729*x3^2-8/81*x3*x5^3+1004/2187*x3*x5^2-8/243*x3*x5-4/2187*x5^5+190/2187*x5^4-1528/6561*x5^3+10/729*x5^2;
poly ev=v*x5-x3+2*x5;
poly einv=inv*x5*(x3-2*x5)-1;
poly eq8=(24)*(1)+(296)*(v)+(1548)*(v^2)+(4428)*(v^3)+(7320)*(v^4)+(6498)*(v^5)+(1782)*(v^6)+(-1539)*(v^7)+(-999)*(v^8);
ideal Ibase=e1,e3,e5,e7,e2,e4,ev,einv;
matrix J[8][8];
J[1,1]=diff(e1,c);
J[1,2]=diff(e1,d2);
J[1,3]=diff(e1,d4);
J[1,4]=diff(e1,x1);
J[1,5]=diff(e1,x3);
J[1,6]=diff(e1,x5);
J[1,7]=diff(e1,inv);
J[1,8]=diff(e1,v);
J[2,1]=diff(e3,c);
J[2,2]=diff(e3,d2);
J[2,3]=diff(e3,d4);
J[2,4]=diff(e3,x1);
J[2,5]=diff(e3,x3);
J[2,6]=diff(e3,x5);
J[2,7]=diff(e3,inv);
J[2,8]=diff(e3,v);
J[3,1]=diff(e5,c);
J[3,2]=diff(e5,d2);
J[3,3]=diff(e5,d4);
J[3,4]=diff(e5,x1);
J[3,5]=diff(e5,x3);
J[3,6]=diff(e5,x5);
J[3,7]=diff(e5,inv);
J[3,8]=diff(e5,v);
J[4,1]=diff(e7,c);
J[4,2]=diff(e7,d2);
J[4,3]=diff(e7,d4);
J[4,4]=diff(e7,x1);
J[4,5]=diff(e7,x3);
J[4,6]=diff(e7,x5);
J[4,7]=diff(e7,inv);
J[4,8]=diff(e7,v);
J[5,1]=diff(e2,c);
J[5,2]=diff(e2,d2);
J[5,3]=diff(e2,d4);
J[5,4]=diff(e2,x1);
J[5,5]=diff(e2,x3);
J[5,6]=diff(e2,x5);
J[5,7]=diff(e2,inv);
J[5,8]=diff(e2,v);
J[6,1]=diff(e4,c);
J[6,2]=diff(e4,d2);
J[6,3]=diff(e4,d4);
J[6,4]=diff(e4,x1);
J[6,5]=diff(e4,x3);
J[6,6]=diff(e4,x5);
J[6,7]=diff(e4,inv);
J[6,8]=diff(e4,v);
J[7,1]=diff(ev,c);
J[7,2]=diff(ev,d2);
J[7,3]=diff(ev,d4);
J[7,4]=diff(ev,x1);
J[7,5]=diff(ev,x3);
J[7,6]=diff(ev,x5);
J[7,7]=diff(ev,inv);
J[7,8]=diff(ev,v);
J[8,1]=diff(einv,c);
J[8,2]=diff(einv,d2);
J[8,3]=diff(einv,d4);
J[8,4]=diff(einv,x1);
J[8,5]=diff(einv,x3);
J[8,6]=diff(einv,x5);
J[8,7]=diff(einv,inv);
J[8,8]=diff(einv,v);
poly detJ=det(J);
ideal I=e1,e3,e5,e7,e2,e4,ev,einv,inu*e6-1,iq*eq8-1,detJ;
ideal G=std(I);
int remzero=1;
for (int remindex=1; remindex<=size(I); remindex++)
{
  if (reduce(I[remindex],G)!=0){remzero=0;}
}
print("Q8-W0-FIBRE-STRATUM");
print("prime=127");
print("mode=nonq8_singular");
print("engine=std");
print("order=block");
print("original_remainder_zero="+string(remzero));
print("dim="+string(dim(G)));
print("size="+string(size(G)));
print("vdim="+string(vdim(G)));
if (dim(G)==0)
{
  ideal E=eliminate(G,c*d2*d4*x1*x3*x5*inv*inu*iq);
  E=std(E);
  print("v_elimination_size="+string(size(E)));
  if (size(E)==1)
  {
    poly H=E[1]/leadcoef(E[1]);
    print("v_eliminant_degree="+string(deg(H)));
    poly Hsf=gcd(H,diff(H,v));
    print("v_eliminant_squarefree_gcd_degree="+string(deg(Hsf)));
    poly HQ=gcd(H,eq8);
    print("v_eliminant_q8_gcd_degree="+string(deg(HQ)));
    list RF=factorize(H,1);
    print("rational_factor_entries="+string(size(RF[1])));
    RF;
  }
}
print("Q8_W0_FIBRE_STRATUM_PASS");
exit;

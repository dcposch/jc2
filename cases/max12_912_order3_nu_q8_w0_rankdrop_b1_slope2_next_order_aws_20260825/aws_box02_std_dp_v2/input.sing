LIB "elim.lib";
ring S=0,(w,c,d2,d4,x1,x3,x5),dp;
poly se1=-4/9*w*c*d4^2-8/9*c*x3*x5+4/3*c*x5^2+4/9*d2*x3-8/9*d2*x5+4/9*d4*x1-8/9*d4*x3-4/27*d4*x5^2+4/3*d4*x5+4/9*x5;

poly se8=-4/81*w^2*c^3*d2*x5-4/81*w^2*c^3*d4*x3+4/27*w^2*c^3*d4*x5+4/81*w^2*c^2*d2^2-16/81*w^2*c^2*d2*d4-76/243*w^2*c^2*d4^2*x5+34/243*w^2*c^2*d4^2+8/81*w^2*c^2*d4+4/27*w^2*c*d2*d4^2-16/81*w^2*c*d4^3+1/243*w^2*d4^4+8/81*w*c^2*x1*x3-16/81*w*c^2*x1*x5-8/81*w*c^2*x3^2-8/27*w*c^2*x3*x5^2+68/243*w*c^2*x3*x5+364/729*w*c^2*x5^3-40/243*w*c^2*x5^2+4/27*w*c*d2*x1+68/243*w*c*d2*x3*x5-40/243*w*c*d2*x3-44/81*w*c*d2*x5^2+124/729*w*c*d2*x5+68/243*w*c*d4*x1*x5-40/243*w*c*d4*x1+4/27*w*c*d4*x3^2-280/243*w*c*d4*x3*x5+124/729*w*c*d4*x3-76/729*w*c*d4*x5^3+1048/729*w*c*d4*x5^2-40/243*w*c*d4*x5-4/27*w*c*x1+4/27*w*c*x3+20/243*w*c*x5^2-40/243*w*c*x5-4/81*w*d2^2*x3+32/243*w*d2^2*x5-16/729*w*d2^2-8/81*w*d2*d4*x1+68/243*w*d2*d4*x3+4/81*w*d2*d4*x5^2-128/243*w*d2*d4*x5+28/729*w*d2*d4-4/81*w*d2*x5+4/81*w*d2+32/243*w*d4^2*x1+4/81*w*d4^2*x3*x5-68/243*w*d4^2*x3-4/27*w*d4^2*x5^2+1004/2187*w*d4^2*x5-4/243*w*d4^2-4/81*w*d4*x3+4/27*w*d4*x5-32/729*w*d4-4/81*x1^2*x5+2/81*x1^2-4/81*x1*x3^2+64/243*x1*x3*x5-32/729*x1*x3+4/243*x1*x5^3-20/81*x1*x5^2+28/729*x1*x5+4/81*x3^3+2/81*x3^2*x5^2-68/243*x3^2*x5+14/729*x3^2-8/81*x3*x5^3+1004/2187*x3*x5^2-8/243*x3*x5-4/2187*x5^5+190/2187*x5^4-1528/6561*x5^3+10/729*x5^2;
ideal SI=se1,se3,se5,se7,se2,se4;
ring T=(0,c),(t,W,U,X1,X3,X5),(dp(6));
option(redSB);
map psi=S,t^2*W,c,2+t*U,1,t*X1,t*X3,t*X5;
ideal J=psi(SI);
ideal In;poly q;poly q0;
for(int i=1;i<=size(J);i++){q=J[i];while(subst(q,t,0)==0){q=q/t;}q0=subst(q,t,0);In=In,q0;}
ideal LeadLoad=W*X5*(X3-2*X5);
list LW=sat(In,LeadLoad);ideal CW=LW[1];
ideal GW=slimgb(CW);
int loaded_initial_empty=0;if(reduce(1,GW)==0){loaded_initial_empty=1;}
print("Q8-W0-RANKDROP-B1-SLOPE2");
print("engine=slimgb");
print("order=block");
print("b1_slope2_loaded_initial_empty="+string(loaded_initial_empty));
print("B1_SLOPE2_BASIS_BEGIN");GW;print("B1_SLOPE2_BASIS_END");
print("Q8_W0_RANKDROP_B1_SLOPE2_PASS");
exit;

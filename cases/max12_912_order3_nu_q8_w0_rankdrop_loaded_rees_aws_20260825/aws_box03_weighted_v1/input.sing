print("WEIGHT_7_BASIS_BEGIN");GW7;print("WEIGHT_7_BASIS_END");
map psi8=S,t^8*W,c,b+1+t*U,b,t*X1,t*X3,t*X5;
ideal J8=psi8(SI);
ideal In8;
for(int i8=1;i8<=size(J8);i8++){q=J8[i8];while(subst(q,t,0)==0){q=q/t;}q0=subst(q,t,0);In8=In8,q0;}

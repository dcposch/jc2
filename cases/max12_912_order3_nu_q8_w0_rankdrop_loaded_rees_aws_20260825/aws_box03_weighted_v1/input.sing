ideal SI=se1,se3,se5,se7,se2,se4;
ring T=(0,c,b),(t,W,U,X1,X3,X5),(dp(6));
option(redSB);
poly q;poly q0;
print("Q8-W0-RANKDROP-WEIGHTED-REES");
print("engine=slimgb");
print("order=block");
map psi1=S,t^1*W,c,b+1+t*U,b,t*X1,t*X3,t*X5;
ideal J1=psi1(SI);
ideal In1;
for(int i1=1;i1<=size(J1);i1++){q=J1[i1];while(subst(q,t,0)==0){q=q/t;}q0=subst(q,t,0);In1=In1,q0;}
ideal LeadLoad1=W*X5*(X3-2*X5);
list LW1=sat(In1,LeadLoad1);ideal CW1=LW1[1];

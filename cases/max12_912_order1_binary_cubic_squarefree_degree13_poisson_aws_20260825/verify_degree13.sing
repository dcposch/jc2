// Original-bracket replay for the squarefree degree-13 recurrence.
ring R=0,
  (x,y,
   a0,a1,a2,b0,b1,b2,b3,b4,
   t0,t1,t2,t3,t4,t5,t6,
   u0,u1,u2,u3,u4,u5,
   v0,v1,v2,v3,v4,z0,z1,z2,z3,
   l0,l1,m0,m1,m2,m3,lam,mu),dp;

proc PB(poly f, poly g)
{
  return(diff(f,x)*diff(g,y)-diff(f,y)*diff(g,x));
}

poly K=x*y*(x-y);
poly A=a0*y2+a1*x*y+a2*x2;
poly BB=b0*y4+b1*x*y3+b2*x2*y2+b3*x3*y+b4*x4;
poly T=t0*y6+t1*x*y5+t2*x2*y4+t3*x3*y3+t4*x4*y2+t5*x5*y+t6*x6;
poly U=u0*y5+u1*x*y4+u2*x2*y3+u3*x3*y2+u4*x4*y+u5*x5;
poly V=v0*y4+v1*x*y3+v2*x2*y2+v3*x3*y+v4*x4;
poly Pthree=z0*y3+z1*x*y2+z2*x2*y+z3*x3;
poly L=l0*y+l1*x;
poly M=m0*y3+m1*x*y2+m2*x2*y+m3*x3;

poly P9=K^3;
poly P8=K^2*A;
poly P7=K*BB;
poly P6=T;
poly P5=U;
poly P4=V;
poly P3=Pthree;
poly Q12=K^4;
poly Q11=(4/3)*K^3*A;
poly Q10=(4/3)*K^2*BB+(2/9)*K^2*A^2;
poly Q9=(4/3)*K*T+(4/9)*K*A*BB-(4/81)*K*A^3+(lam/3)*K^3;
poly Q8=(4/3)*K*U+(4/9)*A*T-(4/27)*A^2*BB
        +(2/9)*BB^2+(5/243)*A^4+(lam/3)*K^2*A;

poly C=BB-(1/3)*A^2;
poly W=T-(1/3)*A*BB+(2/27)*A^3;
poly H=9*W^2-6*A*C*W-2*C^3;
poly N7=(4/3)*K^2*V+(4/9)*K*A*U+(4/9)*C*W
        +(lam/3)*K^2*BB;
poly N6=(4/3)*K^3*Pthree+(4/9)*K^2*A*V+(4/9)*K*C*U
        +(2/81)*H+(lam/3)*K^2*T+mu*K^4;

// Clear the single remaining K denominator from the complete original row.
// [P9,N6/K^2]=3[K,N6], while
// K[P8,N7/K]=[P8,N7]-K*N7*[A,K].
poly Other13=PB(P7,Q8)+PB(P6,Q9)+PB(P5,Q10)+PB(P4,Q11)+PB(P3,Q12);
poly E13cleared=K*(3*PB(K,N6)+Other13)+PB(P8,N7)-K*N7*PB(A,K);
if (E13cleared!=0)
{
  print("FAIL_RATIONAL_DEGREE13_ORIGINAL_ROW"); quit;
}

// Direct polynomial replay on the predicted common intersection C=KL,W=KM.
poly BBc=(1/3)*A^2+K*L;
poly Tc=K*M+(1/3)*A*BBc-(2/27)*A^3;
poly P7c=K*BBc;
poly Q10c=(4/3)*K^2*BBc+(2/9)*K^2*A^2;
poly Q9c=(4/3)*K*Tc+(4/9)*K*A*BBc-(4/81)*K*A^3+(lam/3)*K^3;
poly Q8c=(4/3)*K*U+(4/9)*A*Tc-(4/27)*A^2*BBc
         +(2/9)*BBc^2+(5/243)*A^4+(lam/3)*K^2*A;
poly Q7c=(4/3)*K*V+(4/9)*A*U+(4/9)*K*L*M+(lam/3)*K*BBc;
poly Q6c=(4/3)*K*Pthree+(4/9)*A*V+(4/9)*L*U
         +(2/9)*M^2-(4/27)*A*L*M-(4/81)*K*L^3
         +(lam/3)*Tc+mu*K^2;
poly E13c=PB(P9,Q6c)+PB(P8,Q7c)+PB(P7c,Q8c)+PB(Tc,Q9c)
          +PB(P5,Q10c)+PB(P4,Q11)+PB(P3,Q12);
if (E13c!=0)
{
  print("FAIL_COLLAPSED_DEGREE13_ORIGINAL_ROW"); quit;
}

poly PoleNumerator81=36*K*C*U+2*H;
if (PoleNumerator81-(36*K*C*U+18*W^2-12*A*C*W-4*C^3)!=0)
{
  print("FAIL_POLE_NUMERATOR_FACTOR"); quit;
}

print("RATIONAL_DEGREE13_CLEARED_ORIGINAL_ROW_ZERO");
print("COLLAPSED_DEGREE13_ORIGINAL_ROW_ZERO");
print("DEGREE13_POLE_NUMERATOR_FACTORED");
print("PREDICTED_REDUCED_BASE_DIMENSION 21");
print("FRESH_Z_MU_DIMENSION 5");
print("PREDICTED_REDUCED_FULL_DIMENSION 26");
print("PASS_DEGREE13");
quit;

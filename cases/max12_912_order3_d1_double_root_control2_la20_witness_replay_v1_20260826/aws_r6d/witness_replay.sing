poly E7=(-4/27)*s^66*q1^3+(16/81)*s^66*q1^2*q0+(-8/27)*s^74*q1^2*r2+(-4/81)*s^74*q1^2*r0+(-4/27)*s^66*q1*q0^2+(-4/27)*s^74*q1*q0*r1+(-8/81)*s^82*q1*r2^2+(8/9)*s^52*q1*r2+(-40/81)*s^52*q1*r1+(8/27)*s^52*q1*r0+(-8/81)*s^74*q0^2*r2+(-40/81)*s^52*q0*r2+(8/27)*s^52*q0*r1+(-32/27)*s^60*r2^2+(4/3)*s^60*r2*r1+(-16/27)*s^60*r2*r0+(-8/27)*s^60*r1^2+(4/9)*s^60*r1*r0;
poly E8=-1*s^81*la^20*tau-1*s^80*la^20+(1/243)*s^88*q1^4+(8/81)*s^66*q1^3+(-4/27)*s^66*q1^2*q0+(8/81)*s^74*q1^2*r2+(-8/81)*s^74*q1^2*r1+(8/81)*s^66*q1*q0^2+(-20/81)*s^74*q1*q0*r2+(-4/81)*s^74*q1*q0*r0+(-8/81)*s^82*q1*r2*r1+(-28/27)*s^52*q1*r2+(16/27)*s^52*q1*r1+(-28/81)*s^52*q1*r0+(-4/81)*s^74*q0^2*r1+(-4/81)*s^82*q0*r2^2+(16/27)*s^52*q0*r2+(-28/81)*s^52*q0*r1+(64/81)*s^60*r2^2+(-8/9)*s^60*r2*r1+(4/9)*s^60*r2*r0+(2/9)*s^60*r1^2+(-8/27)*s^60*r1*r0;
poly LT=1*s^4*la-1*s^4*tau^3*rho;
print("AWS_TAG=max12_912_order3_d1_double_root_control2_la20_witness_replay_v1_20260826T024500Z_r6d");
print("EXPECTED_PRODUCER_STDOUT_SHA256=a0611ede0e667d45f569a954fdaa73818f0ebea328212b8c46d4ccb0aa29fe08");
print("ENCODING=LITERAL_NINE_GENERATOR_REES_IDENTITY_AND_TERM_ENUMERATION");

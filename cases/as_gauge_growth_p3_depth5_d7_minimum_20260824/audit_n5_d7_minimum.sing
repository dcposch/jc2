// Independent Singular replay of the p=3,n=5,D=7 bounded survivor.
ring r=(integer,243),(x,y),dp;

poly b=x^5;
poly c=2*x^2*y;
poly d=x*y^2+x^5+2*x^7;
poly e=2*x+x*y+2*x^2+x^4*y+2*x^5;
poly f=y+y^2+2*x*y+y^3+2*x*y^2+x*y^3+x^3*y^2
       +2*x^4*y+x^6*y+x^7;
poly g=x+x^2+2*x*y^2+2*x^2*y+2*x*y^3+x^2*y^2+2*x^2*y^3
       +x^4*y+x^5+2*x^2*y^4+2*x^7;
poly h=y+y^2+2*x*y+y^4+2*x*y^4+x*y^5+2*x^5*y+2*x^6*y;

poly A=x+9*c+27*e+81*g;
poly B=y+3*b+9*d+27*f+81*h;
poly S=1+3*A^2+9*A^4+27*A^6+81*A^8;
poly DA=1-3*A^2;
poly P=A-A^3;
poly Q=B*S;
poly JAB=diff(A,x)*diff(B,y)-diff(A,y)*diff(B,x);
poly JPQ=diff(P,x)*diff(Q,y)-diff(P,y)*diff(Q,x);

poly expectedP=162*x^6*y+135*x^5+54*x^4*y+81*x^4+162*x^3*y+80*x^3
 +162*x^2*y^4+162*x^2*y^3+81*x^2*y^2+180*x^2*y+135*x^2
 +162*x*y^3+162*x*y^2+27*x*y+136*x;
poly expectedQ=81*x^7+216*x^6*y+162*x^5*y+12*x^5+63*x^4*y
 +81*x^3*y^3+81*x^3*y^2+81*x^2*y^3+165*x^2*y
 +81*x*y^5+162*x*y^4+27*x*y^3+63*x*y^2+216*x*y
 +81*y^4+27*y^3+108*y^2+109*y;

if (P-expectedP!=0) { ERROR("P support mismatch"); }
if (Q-expectedQ!=0) { ERROR("Q support mismatch"); }
if (DA*S-1!=0) { ERROR("truncated inverse failure"); }
if (Q*DA-B!=0) { ERROR("gauge orientation failure"); }
if (JAB-1!=0) { ERROR("gauge determinant failure"); }
if (JPQ-1!=0) { ERROR("F determinant failure"); }
if (deg(A)!=7 || deg(B)!=7 || deg(P)!=7 || deg(Q)!=7)
{ ERROR("degree assertion failure"); }

print("AUDIT_PASS p=3 n=5 D=7 modulus=243");
print("degrees A B P Q");
deg(A); deg(B); deg(P); deg(Q);
print("P"); print(P);
print("Q"); print(Q);

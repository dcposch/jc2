// AWS-only exact structural checks for the D1 discriminant-point chart.
// No saturation or slope compiler is contained here.

ring R=0,(z,a,h,A,D,B,L,q,u2,u1,u0,v2,v1,v0,nu),dp;

poly x=z-a;
poly p=-3*a^2;
poly c=2*a^3+h;
poly K=z^3+p*z+c;
poly Kchart=x^2*(x+3*a)+h;
if (K-Kchart!=0) { ERROR("cusp coordinate identity"); }

poly Delta=-4*p^3-27*c^2;
if (Delta+27*h*(4*a^3+h)!=0) { ERROR("discriminant factor"); }
if (subst(-6*a,a,1)+6!=0) { ERROR("chart Jacobian"); }

// Nine*a^2 times the Hermite polynomial with values P(a)=A,
// P'(a)=D, and P(-2a)=B.  This covers all degree-at-most-two directions
// on the unit chart a!=0.
poly Pnum=9*a^2*A+9*a^2*D*x+(B-A+3*a*D)*x^2;
if (subst(Pnum,z,a)-9*a^2*A!=0) { ERROR("Hermite value at double root"); }
if (subst(diff(Pnum,z),z,a)-9*a^2*D!=0) { ERROR("Hermite derivative"); }
if (subst(Pnum,z,-2*a)-9*a^2*B!=0) { ERROR("Hermite simple-root value"); }

// Normalized centre: K0=L^2*U and nilradical generator N=L*U.
poly U=L+3;
poly K0=L^2*U;
poly N=L*U;
if (N^2-K0*U!=0) { ERROR("nilradical square"); }

poly Q1=q*N;
poly R2=q^2/3;
poly Q2=u2*L^2+u1*L+u0;
poly R3=v2*L^2+v1*L+v0;

// 81*K0^2 times the t^(3 beta) coefficient of
// 4 Q R/(9K)-4 Q^3/(81K^2).
poly raw3=36*K0*Q1*R2-4*Q1^3;
if (raw3+4*q^3*K0^2!=0) { ERROR("cubic cancellation"); }

// 243*K0^4 times the complete t^(4 beta) coefficient through binomial
// degree four, with arbitrary next corrections Q2,R3.
poly raw4=
  108*K0^3*(Q1*R3+Q2*R2)
  -36*K0^2*Q1^2*Q2
  +54*K0^2*R2^2
  -36*K0*Q1^2*R2
  +5*Q1^4;
poly H=5*L^2+18*L+15;
poly corrected4=q^4*H+12*K0*(9*q*N*R3-q^2*(L+2*U)*Q2);
if (raw4-K0^2*corrected4!=0) { ERROR("quartic cross multiplication"); }

ideal IK=K0;
ideal GK=std(IK);
if (reduce(corrected4-q^4*H,GK)!=0) { ERROR("quartic residue mod K0"); }
if (subst(H,L,0)-15!=0) { ERROR("double-root residue value"); }
if (diff(H,L)==0) { ERROR("quartic residue accidentally scalar"); }

print("axis_cusp: p=-3*a^2, c=2*a^3+h");
print("Delta=-27*h*(4*a^3+h); Jacobian at (a,h)=(1,0) is -6");
print("Hermite coordinates per normal polynomial: P(a), P'(a), P(-2*a)");
print("K0=L^2*(L+3); nilradical N=L*(L+3); N^2=K0*(L+3)");
print("alpha=2beta control: Q1=q*N, R2=q^2/3, tail_3beta=-4*q^3/81 polynomial");
print("quartic common numerator mod K0=(q^4/243)*(5*L^2+18*L+15)");
print("arbitrary Q2,R3 corrections are multiples of K0 in that numerator");
print("row3 target is also a K0 multiple; row6 subtracts only a scalar");
print("scope: this kills the displayed hidden branch, not all tropical branches");
print("PASS-D1-DOUBLE-ROOT-NEWTON-STRUCTURE-V2");
quit;
